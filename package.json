{
  "name": "anime-black",
  "version": "1.0.0",
  "description": "Anime Black V7",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "vite build && mkdir -p dist && cp index.html server.js rtm.js manifest.json sw.js pwa-192x192.png pwa-512x512.png apple-touch-icon.png icon.svg firebase-applet-config.json dist/ 2>/dev/null || true",
    "lint": "eslint src/ server.js tests/ rtm.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@sentry/browser": "^11.0.0",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "firebase": "10.10.0",
    "p-limit": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}