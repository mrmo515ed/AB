rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Global Helper Primitives & Role-Based Access Control (RBAC)
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-\\\\.:@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedEmail() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'm774545471@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)m774545471@gmail\\\\.com'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'Owner', 'Developer', 'SuperAdministrator', 'Admin'])
      );
    }

    function isMod() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['Moderator', 'SeniorModerator', 'SuperAdministrator'])
      );
    }

    // الأدوار المتميزة التي لا يجوز لأي مستخدم منحها لنفسه
    function isPrivilegedRole(role) {
      return role in ['admin', 'Admin', 'Owner', 'Developer', 'SuperAdministrator', 'Moderator', 'SeniorModerator'];
    }

    // حقول الاقتصاد والامتيازات المحمية — لا يكتبها العميل إطلاقاً (السلطة للسيرفر الموثوق فقط)
    function isProtectedEconomyKey(key) {
      return key in ['coins', 'wallet', 'stars', 'xp', 'xpNext', 'level', 'points', 'reputation',
                     'roles', 'role', 'isVerified', 'premium', 'entitlements', 'balance'];
    }

    // Default Deny Rule for undefined collections
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // System Health & Connection Test
    // ============================================================
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /server_status/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /server_health/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serverHealth/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_status/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_health/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // Users & User Profile Security
    // ------------------------------------------------------------
    // القراءة عامة (ملفات عامة يحتاجها التطبيق) — القيود على الكتابة:
    //  - لا يعدّل أي مستخدم اقتصاد مستخدم آخر (عملات/نجوم/سمعة) إطلاقاً
    //  - لا يكتب المالك نفسه حقول الاقتصاد/الامتيازات المحمية
    //    (السلطة للدوال السحابية الموثوقة عبر Admin SDK فقط)
    //  - حد معروف: Firestore لا يدعم حجب حقل واحد عن القراءة داخل مستند
    //    عام — الحقول الحساسة يجب ألا تُخزَّن هنا أصلاً (راجع تقرير PR2)
    // ============================================================
    match /users/{userId} {
      allow read: if true;

      // إنشاء الملف الذاتي: لا يمكن اختيار دور متميز مطلقاً (سد ثغرة التصعيد)
      allow create: if isOwner(userId) && (
        isAdminEmail() ||
        isAdmin() ||
        !isPrivilegedRole(incoming().get('role', 'Member'))
      );

      // تحديث الملف:
      // 1. الأدمن يحدّث أي شيء
      // 2. المالك يحدّث ملفه — بدون الدور/التوثيق وبدون أي حقل اقتصادي محمي
      // 3. الأقران الموقّعون يحدّثون حقول التفاعل الاجتماعي فقط (بلا اقتصاد)
      allow update: if isSignedIn() && (
        isAdmin() ||
        isAdminEmail() ||
        (isOwner(userId)
          && incoming().get('role', existing().get('role', 'Member')) == existing().get('role', 'Member')
          && incoming().get('isVerified', existing().get('isVerified', false)) == existing().get('isVerified', false)
          && !incoming().diff(existing()).affectedKeys().hasAny(['coins', 'wallet', 'stars', 'xp', 'xpNext', 'level', 'points', 'reputation', 'roles', 'premium', 'entitlements', 'balance'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['followers', 'followers_list', 'followersCount', 'following', 'following_list', 'followingCount', 'views', 'rating', 'updatedAt'])
      );

      allow delete: if isAdmin() || isOwner(userId);

      // بيانات المستخدم الخاصة (أجهزة FCM، مفاتيح، حالات خاصة) — المالك فقط
      match /{allUserData=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Private user state & local sync cache (watch history, private bookmarks)
    match /user_states/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Active login sessions
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // ============================================================
    // Posts & Feed Security
    // ============================================================
    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        incoming().authorId == request.auth.uid ||
        incoming().get('userId', request.auth.uid) == request.auth.uid
      );

      // تفاعلات القراء بمفاتيح التفاعل فقط — التفاعلات ليست اقتصاداً محمياً
      allow update: if isSignedIn() && (
        isAdmin() ||
        isMod() ||
        (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount', 'views', 'shares', 'comments', 'commentsCount', 'reactions', 'savedBy', 'likedUsers', 'lastReaction', 'poll', 'updatedAt'])
      );

      allow delete: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        isMod()
      );
    }

    match /scheduled_posts/{postId} {
      allow read, write: if isSignedIn() && (incoming().authorId == request.auth.uid || existing().authorId == request.auth.uid || isAdmin());
    }

    // Stories (24h ephemeral)
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().authorId == request.auth.uid);
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || existing().authorId == request.auth.uid || isAdmin() || isMod());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().authorId == request.auth.uid || isAdmin() || isMod());
    }

    // Reels (Short clips)
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().authorId == request.auth.uid || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isAdmin() ||
        isMod() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount', 'views', 'comments', 'commentsCount', 'shares', 'likedUsers', 'reactions', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin() || isMod());
    }

    // ============================================================
    // Direct Chats & Messages — الأطراف الفعلية فقط
    // ============================================================
    function isChatParticipant(chatData) {
      return (chatData.participants is list && request.auth.uid in chatData.participants)
        || (chatData.participants is list && chatData.participants.size() == 0); // محادثات قديمة بلا مشاركين موثقين
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (isAdmin() || isChatParticipant(existing()));
      allow create: if isSignedIn() && (isAdmin() || (incoming().participants is list && request.auth.uid in incoming().participants));
      allow update: if isSignedIn() && (isAdmin() || isChatParticipant(existing()));
      allow delete: if isSignedIn() && (isAdmin() || isChatParticipant(existing()));

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isSignedIn() && (isAdmin() || isChatParticipant(parentChat()));
        // إنشاء رسالة: هوية المرسل + عضوية فعلية في المحادثة (كانت العضوية مفقودة)
        allow create: if isSignedIn() && (isAdmin() || (
          (incoming().senderId == request.auth.uid || incoming().sender == request.auth.uid) &&
          isChatParticipant(parentChat())
        ));
        // إيصالات القراءة (st) والمشاركون يحدّثون حالة الرسائل
        allow update: if isSignedIn() && (
          isAdmin() ||
          existing().senderId == request.auth.uid ||
          (isChatParticipant(parentChat()) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['st', 'status', 'read', 'delivered', 'reactions', 'deletedFor', 'updatedAt']))
        );
        allow delete: if isSignedIn() && (isAdmin() || existing().senderId == request.auth.uid || isChatParticipant(parentChat()));
      }
    }

    match /chat_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().fromUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid || isAdmin());
    }

    // ============================================================
    // Groups — الرؤية حسب الخصوصية والعضوية الفعلية (memberUids)
    // ------------------------------------------------------------
    // التطبيق يكتب memberUids (معرفات Firebase الحقيقية) عند الانضمام/
    // المغادرة. المستندات القديمة بلا memberUids تحافظ على سلوكها
    // (قروب عام = قراءة لأي موقع، كتابة الرسائل لأي موقع بهوية صحيحة)
    // حتى ترحيل البيانات — لا كسر للبيانات القائمة.
    // ============================================================
    match /groups/{groupId} {
      function groupDoc() { return resource.data; }
      function isGroupMember() { return isSignedIn() && request.auth.uid in groupDoc().get('memberUids', []); }
      function isGroupOwner() {
        return isSignedIn() && (groupDoc().get('creatorUid', '') == request.auth.uid || groupDoc().get('creatorId', '') == request.auth.uid);
      }
      function isGroupPrivate() { return groupDoc().get('privacy', 'عام') == 'خاص'; }
      function hasMemberUids() { return 'memberUids' in groupDoc(); }

      allow read: if isSignedIn() && (
        isAdmin() || isMod() || !isGroupPrivate() || isGroupMember() || isGroupOwner()
      );

      allow create: if isSignedIn() && (
        incoming().get('creatorUid', incoming().get('creatorId', request.auth.uid)) == request.auth.uid ||
        isAdmin()
      );

      // غير المالك: مفاتيح العضوية والرسالة الأخيرة والنشاط فقط
      allow update: if isSignedIn() && (
        isAdmin() || isMod() ||
        isGroupOwner() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['members', 'memberUids', 'lastMsg', 'lastAt', 'updatedAt', 'online', 'typing'])
      );

      allow delete: if isAdmin() || (isSignedIn() && existing().creatorId == request.auth.uid);

      match /messages/{messageId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function memberOfParent() { return isSignedIn() && request.auth.uid in parentGroup().get('memberUids', []); }
        function parentHasMemberUids() { return 'memberUids' in parentGroup(); }
        function parentIsPrivate() { return parentGroup().get('privacy', 'عام') == 'خاص'; }
        function parentOwner() {
          return isSignedIn() && (parentGroup().get('creatorUid', '') == request.auth.uid || parentGroup().get('creatorId', '') == request.auth.uid);
        }

        // قراءة الرسائل: عام للقروبات العامة، وللأعضاء فقط في الخاصة
        allow read: if isSignedIn() && (
          isAdmin() || isMod() || parentOwner() ||
          (parentIsPrivate() ? (memberOfParent() || !parentHasMemberUids()) : true)
        );

        // كتابة رسالة: هوية صحيحة + (عضو موثق، أو مستند قديم بلا memberUids)
        allow create: if isSignedIn() && (
          (incoming().senderId == request.auth.uid || incoming().sender == request.auth.uid) &&
          (memberOfParent() || !parentHasMemberUids() || parentOwner() || isAdmin())
        );

        allow update, delete: if isSignedIn() && (existing().senderId == request.auth.uid || isAdmin() || isMod());
      }
    }

    // ============================================================
    // Communities & Channels — العضوية حسب memberUids مع تسامح قديم
    // ============================================================
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn();
      // منع الاستيلاء الإداري: لا يعدّل أحد حقول الملكية/الإدارة إلا المشرفين
      allow update: if isSignedIn() && (
        isAdmin() || isMod() ||
        !incoming().diff(existing()).affectedKeys().hasAny(['ownerId', 'owner', 'adminUids', 'admins', 'isVerified', 'verified'])
      );
      allow delete: if isAdmin();

      match /channels/{channelId}/messages/{messageId} {
        function community() {
          return get(/databases/$(database)/documents/communities/$(communityId)).data;
        }
        function communityMember() { return isSignedIn() && request.auth.uid in community().get('memberUids', []); }
        function communityAdmin() {
          return isSignedIn() && (
            community().get('ownerUid', '') == request.auth.uid ||
            community().get('ownerId', '') == request.auth.uid ||
            request.auth.uid in community().get('adminUids', [])
          );
        }
        function communityHasMemberUids() { return 'memberUids' in community(); }
        function communityRestricted() { return community().get('visibility', 'public') == 'restricted' || community().get('privacy', 'عام') == 'خاص'; }

        // القراءة: عامة للمجتمعات العامة، وللأعضاء في المقيدة (تسامح للمستندات القديمة)
        allow read: if isSignedIn() && (
          isAdmin() || isMod() || communityAdmin() ||
          (communityRestricted() ? (communityMember() || !communityHasMemberUids()) : true)
        );

        // الكتابة: عضوية فعلية (أو مستند قديم بلا memberUids) + هوية مرسل صحيحة
        allow create: if isSignedIn() && (
          (incoming().senderId == request.auth.uid || incoming().sender == request.auth.uid) &&
          (communityMember() || !communityHasMemberUids() || communityAdmin() || isAdmin())
        );

        allow update, delete: if isSignedIn() && (existing().senderId == request.auth.uid || isAdmin() || isMod());
      }
    }

    // ============================================================
    // Worlds — مساحات عامة بالتصميم: القراءة لموقّعين،
    // والكتابة بهوية مرسل صحيحة (العوالم المفتوحة مفتوحة للجميع)
    // ============================================================
    match /worlds/{worldId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || isMod() ||
        !incoming().diff(existing()).affectedKeys().hasAny(['ownerId', 'owner', 'adminUids', 'admins', 'isVerified', 'verified'])
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (incoming().senderId == request.auth.uid || incoming().sender == request.auth.uid);
        allow update, delete: if isSignedIn() && (existing().senderId == request.auth.uid || isAdmin() || isMod());
      }
    }

    // ============================================================
    // Notifications & Reports
    // ============================================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.targetUid == request.auth.uid || isAdmin());
      // الإشعار لا يُنشأ إلا بصفتك المُحتِد الفعلي (fromUserId/senderId) أو أدمن — منع انتحال الإشعارات
      allow create: if isSignedIn() && (
        isAdmin() ||
        incoming().get('fromUserId', '') == request.auth.uid ||
        incoming().get('senderId', '') == request.auth.uid ||
        incoming().get('fromUid', '') == request.auth.uid ||
        incoming().get('senderUid', '') == request.auth.uid ||
        incoming().get('authorId', '') == request.auth.uid ||
        incoming().get('userId', '') == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().targetUid == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow read: if isMod() || isAdmin();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isMod() || isAdmin();
    }

    match /broadcasts/{bcId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workspaces/{userId}/thoughts/{thoughtId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Design System, Badges, Economy & Administration
    // ============================================================
    match /app_visual_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /theme_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /published_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /drafts/{draftId} {
      allow read, write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /level_badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /level_mappings/{mappingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badge_assignments/{assignmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /icons/{iconId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /buttons/{btnId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /components/{compId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /page_configs/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /game_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // التطبيق لا يكتب هذه المجموعات من العميل إطلاقاً — الكتابة للإدارة فقط
    match /game_matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /game_leaderboard/{boardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /game_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /game_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /game_admin_logs/{logId} {
      allow read: if isMod() || isAdmin();
      allow write: if isAdmin();
    }

    match /game_anti_cheat_logs/{logId} {
      allow read: if isMod() || isAdmin();
      allow write: if isAdmin();
    }

    // سجلات التدقيق ليست خاضعة لسلطة العميل — أدمن فقط
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // Calls / Sessions — المشاركون الفعليون فقط (Phase 6)
    // ------------------------------------------------------------
    // مستند المكالمة: { callerUid, participants: [uid...], status, ... }
    // ============================================================
    match /calls/{callId} {
      function isCallParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.get('participants', []);
      }
      function isCaller() {
        return isSignedIn() && resource.data.get('callerUid', '') == request.auth.uid;
      }

      allow read: if isSignedIn() && (isCallParticipant() || isCaller() || isAdmin());
      allow create: if isSignedIn() && (
        incoming().participants is list &&
        request.auth.uid in incoming().participants &&
        incoming().get('callerUid', request.auth.uid) == request.auth.uid
      );
      // المشارك يحدّث حالة الجلسة/الإشارة فقط — دون العبث بالمشاركين أو المتصل
      allow update: if isSignedIn() && (isAdmin() || isCaller() ||
        (isCallParticipant() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accepted', 'endedAt', 'answer', 'signal', 'typing', 'lastAt', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (isAdmin() || isCaller());

      // قناة الإشارات: مشاركون فقط، وهوية مرسل صحيحة
      match /signals/{signalId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        function participantOfParent() {
          return isSignedIn() && request.auth.uid in parentCall().get('participants', []);
        }
        allow read: if isSignedIn() && (participantOfParent() || isAdmin());
        allow create: if isSignedIn() && participantOfParent() &&
          (incoming().senderId == request.auth.uid || incoming().get('from', request.auth.uid) == request.auth.uid);
        allow update, delete: if isSignedIn() && (isAdmin() ||
          (existing().senderId == request.auth.uid || existing().get('from', '') == request.auth.uid));
      }
    }

    // ============================================================
    // Economy — السلطة للسيرفر الموثوق فقط (Cloud Functions)
    // ------------------------------------------------------------
    // سجل معاملات الاقتصام ورصيداثه يكتبها Admin SDK حصراً —
    // العميل يقرأ سجله فقط (للعرض)، ولا يكتب ولا يعدّل.
    // ============================================================
    match /economy_transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('fromUid', '') == request.auth.uid ||
        resource.data.get('toUid', '') == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;   // الكتابة من الدوال السحابية (Admin SDK) فقط — تتجاوز القواعد
    }

    // مفاتيح منع الإعادة (idempotency) — يكتبها السيرفر فقط
    match /economy_idempotency/{keyId} {
      allow read: if isSignedIn() && keyId.matches('^' + request.auth.uid + '.*');
      allow write: if false;
    }
  }
}
