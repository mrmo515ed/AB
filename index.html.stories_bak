let S=seed();
function getMyUid(){
  if(S && S.me && S.me.uid && S.me.uid !== "me") return S.me.uid;
  if(S && S.me && S.me.id && S.me.id !== "me") return S.me.id;
  if(window.auth && window.auth.currentUser) return window.auth.currentUser.uid;
  if(S && S.user && S.user.uid && S.user.uid !== "me") return S.user.uid;
  if(S && S.user && S.user.id && S.user.id !== "me") return S.user.id;
  if(!window._myAnonId){
    try{ window._myAnonId = localStorage.getItem("ab_anon_uid"); }catch(e){}
    if(!window._myAnonId){
      window._myAnonId = "u_" + Math.random().toString(36).substring(2, 10);
      try{ localStorage.setItem("ab_anon_uid", window._myAnonId); }catch(e){}
    }
  }
  return window._myAnonId;
}
function isMe(id){
  if(!id) return false;
  if(id === "me") return true;
  const myUid = getMyUid();
  if(myUid && (id === myUid || id === (S.me && S.me.id) || id === (S.me && S.me.uid))) return true;
  if(S.user && (id === S.user.uid || id === S.user.id)) return true;
  if(S.me && S.me.username && typeof id === "string" && id.toLowerCase() === S.me.username.toLowerCase()) return true;
  return false;
}
if(S.me && S.me.id === "me"){
  const myRealId = getMyUid();
  S.me.id = myRealId;
  S.me.uid = myRealId;
}
function safeStr(o){try{const c=new Set();return JSON.stringify(o,(k,v)=>{if(typeof v==='object'&&v!==null){if(c.has(v)||v instanceof Node||v.constructor.name==='DocumentSnapshot'||v.constructor.name.startsWith('Q$'))return;c.add(v)}return v})}catch(e){return"{}"}}
function save(){try{localStorage.setItem(KEY,safeStr(S))}catch(e){console.error("Save error:",e)}}
let _saveTo; function saveDebounced(){ clearTimeout(_saveTo); _saveTo = setTimeout(save, 1000); }
window.addEventListener("beforeunload",()=>{if(_saveTo){clearTimeout(_saveTo);save()}});
function load(){try{const r=localStorage.getItem(KEY);if(r){const p=JSON.parse(r);S=Object.assign(seed(),p);if(S.me){S.me=Object.assign({},seed().me,S.me);}if(S.me&&S.me.id==="me"){const realId=getMyUid();S.me.id=realId;S.me.uid=realId;}return true}}catch(e){}return false}
function reset(){localStorage.removeItem(KEY);S=seed();S.page="splash";render();toast("تمت إعادة تعيين كل البيانات","info")}
function u(id, p){
  // 1. If an embedded author exists on an item and belongs to another member, prefer that snapshot
  if(p && p.author && p.author.id && !isMe(p.author.id)){
    return p.author;
  }
  // 2. If id is empty, "me", or matches current user's UID or username
  if(!id || (id === "me" && (!p || !p.author || isMe(p.author.id))) || isMe(id)){
    return S.me;
  }
  // 3. Search in cloud users cache first
  if(window._cloudUsers && (window._cloudUsers[id] || window._cloudUsers[String(id)])){
    return window._cloudUsers[id] || window._cloudUsers[String(id)];
  }
  // 4. Search in loaded S.users
  const f = (S.users || []).find(x => x && (x.id === id || x.uid === id || (x.username && x.username.toLowerCase() === String(id).toLowerCase())));
  if(f) return f;
  // 5. Fallback to embedded author snapshot if present
  if(p && p.author) return p.author;
  // 6. Deterministic distinct user generation
  S.guests = S.guests || {};
  if(!S.guests[id]){
    let s = 0;
    for(const ch of String(id)) s += ch.charCodeAt(0);
    const cleanId = String(id).replace(/[^a-zA-Z0-9]/g, '');
    S.guests[id] = {
      id: id,
      uid: id,
      name: "عضو أنمي بلاك",
      username: "user_" + (cleanId.slice(0, 6) || "member"),
      role: "Member",
      level: 1 + (s % 30),
      avatar: AV[s % AV.length],
      cover: COVER[s % COVER.length],
      isVerified: false,
      verifiedType: null,
      bio: "عضو في مجتمع أنمي بلاك",
      followers: 12 + (s % 200),
      following: 8 + (s % 100),
      reputation: 50 + (s % 500),
      joined: Date.now() - (s % 180) * 864e5,
      badges: [],
      titles: [],
      equippedTitle: null,
      frame: null,
      avatarFrame: null,
      profileEffect: null,
      coins: 50,
      stars: 5
    };
  }
  return S.guests[id];
}

