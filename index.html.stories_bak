PAGES.notifications=()=>{setNav(true);
  const un=S.notifs.filter(x=>!x.read).length;
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('home')">${I("back")}</button>
    <div class="ttl">الإشعارات<small>${un?un+" جديد":"لا جديد"}</small></div>
    <button class="iconbtn" onclick="openSheet('notifSetSheet')" aria-label="إعدادات الإشعارات">${I("settings")}</button>
    <button class="iconbtn" onclick="S.notifs.forEach(x=>x.read=true);save();render();toast('قُرئت كل الإشعارات ','ok')" aria-label="تعليم الكل">${I("checksq")}</button></div>`);
  const tf=S.notifTab||"all";
  const GR={all:null,react:["like","comment","react","mention"],social:["follow","live","guild"],system:["system","security","admin","event"]};
  const pref=S.notifPrefs||{};
  const list=S.notifs.filter(x=>(pref[x.type]!==false)&&(!GR[tf]||GR[tf].includes(x.type)));
  const days={};list.forEach(x=>{const k=new Date(x.at).toDateString();(days[k]=days[k]||[]).push(x)});
  const icOf=t=>({like:"heart",comment:"msgsq",follow:"usercheck",system:"settings",security:"shield",admin:"shield",event:"calendar",guild:"shield",mention:"at",live:"radio"}[t]||"bell");
  const gOf=t=>({like:"var(--grad-rose)",comment:"var(--grad-cyan)",follow:"var(--grad-purple)",system:"var(--grad-gold)",security:"var(--grad-fire)",admin:"var(--grad-fire)",event:"var(--grad-emerald)",guild:"var(--grad-gold)",mention:"var(--grad-cyan)"}[t]||"var(--grad-cyan)");
  const act=x=>x.type==="follow"?`<button class="btn btn-primary btn-xs" onclick="follow('${x.userId}');(S.notifs||[]).find(y=>y.id==='${x.id}').read=true;save();render()">${S.following.includes(x.userId)?"متابَع":"متابعة"}</button>`
    :x.type==="like"||x.type==="comment"||x.type==="mention"?`<button class="btn btn-sec btn-xs" onclick="go('notifDetail',{id:'${x.id}'})">فتح</button>`
    :x.type==="guild"||x.type==="event"?`<button class="btn btn-sec btn-xs" onclick="go('eventsHub')">عرض</button>`
    :`<button class="btn btn-sec btn-xs" onclick="go('notifDetail',{id:'${x.id}'})">تفاصيل</button>`;
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div class="chiprow" style="padding:9px 12px;border-bottom:1px solid var(--line);flex-shrink:0">${[["all","الكل"],["react","التفاعلات"],["social","اجتماعي"],["system","النظام"]].map(([k,l])=>`<button class="chip ${tf===k?'on':''}" onclick="S.notifTab='${k}';save();render();snd('tap')">${l}</button>`).join("")}</div>
    <div style="flex:1;overflow-y:auto" class="no-sb"><div class="pad" style="padding-top:10px">
      ${Object.keys(days).length?Object.entries(days).map(([k,arr],di)=>`<div class="tiny b mut" style="margin:6px 0 7px">${di===0?"اليوم":di===1?"أمس":new Date(k).toLocaleDateString("ar")}</div>
        <div class="col" style="gap:8px">${arr.map(x=>{const xu=x.userId?u(x.userId):null;return `<div class="card2 row" style="gap:9px;padding:10px;${x.read?"":"border-color:rgba(34,211,238,.45);background:rgba(34,211,238,.06)"}">
          <span class="ico-tile" style="width:36px;height:36px;border-radius:12px;background:${gOf(x.type)};color:#fff">${I(icOf(x.type),"i s")}</span>
          ${xu?`<span style="line-height:0">${av(xu,30)}</span>`:""}
          <span class="g1" style="text-align:right;min-width:0"><span class="xs b" style="display:block;line-height:1.5">${xu?("<b>"+esc(xu.name)+"</b> "):""}${esc(x.text||"")}</span>
          <span class="tiny fnt">${ago(x.at)}</span></span>
          ${act(x)}${x.read?"":`<span style="width:8px;height:8px;border-radius:50%;background:var(--accent);flex-shrink:0"></span>`}</div>`}).join("")}</div>`).join("")
      :emptyState("bell","لا إشعارات في هذا التصنيف","")}
    </div></div></div>`};

PAGES.notifDetail=()=>{
  const n=(S.notifs||[]).find(x=>x.id===S.params.id);if(!n){setNav(false);setHdr(backHdr("الإشعار",""));return emptyState("bell","الإشعار غير موجود","")}
  setNav(false);setHdr(backHdr("تفاصيل الإشعار",ago(n.at)));
  return `<div class="pad col">
    <div class="card" style="padding:16px;text-align:center;background:linear-gradient(135deg,rgba(34,211,238,.1),transparent)">
      <span style="width:64px;height:64px;border-radius:50%;background:var(--grad-fire);display:flex;align-items:center;justify-content:center;margin:0 auto 11px;color:#fff">${I({like:"heart",follow:"usercheck",comment:"msgsq",level:"trophy",live:"radio",coins:"coins"}[n.type]||"bell","xl")}</span>
      <div class="bb" style="font-size:15px">${esc(n.text)}</div>
      <div class="tiny fnt" style="margin-top:5px">${new Date(n.at).toLocaleString("ar")}</div>
    </div>
    <div class="card" style="padding:14px"><div class="b sm" style="margin-bottom:7px">التفاصيل</div><p class="xs mut">${esc(n.body||"لا يوجد وصف إضافي.")}</p></div>
    ${n.userId?`<div class="lstrow" onclick="openProfile('${n.userId}')">${av(u(n.userId),46)}<div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(u(n.userId).name)}</span>${vbadge(u(n.userId))}</div><div class="tiny fnt">@${esc(u(n.userId).username)}</div></div>${I("fwd","i s")}</div>`:""}
    <div class="grid2">
      ${n.type==="follow"?`<button class="btn btn-primary" onclick="follow('${n.userId}')">${I("usercheck","i s")} متابعة بالمثل</button>`:""}
      ${n.type==="comment"||n.type==="like"?`<button class="btn btn-primary" onclick="openComments('${S.posts[0].id}')">${I("msgsq","i s")} عرض المنشور</button>`:""}
      ${n.type==="coins"?`<button class="btn btn-gold" onclick="go('economy')">${I("wallet","i s")} المحفظة</button>`:""}
      ${n.type==="level"?`<button class="btn btn-gold" onclick="go('levels')">${I("award","i s")} الشارات</button>`:""}
      <button class="btn btn-sec" onclick="startChat('${n.userId||"me"}')">${I("chat","i s")} رد</button>
      <button class="btn btn-ghost" onclick="S.notifs=S.notifs.filter(x=>x.id!=='${n.id}');save();back();toast('حُذف الإشعار','info')">${I("trash","i s")} حذف</button>
    </div>
  </div>`;
};

