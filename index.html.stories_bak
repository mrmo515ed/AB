function getSingleCommunityHealthStats(c){
  const isGuild = c.type === "guild";
  const typeLabel = isGuild ? "نقابة حربية" : c.type === "group" ? "مجموعة خاصة" : "مجتمع ومساحة";
  
  // حساب إجمالي المحتوى المرصود
  const liveMsgs = (c.messages || []).length;
  const channelCount = (c.channels || []).length || 1;
  const multiplier = isGuild ? 3.4 : 2.8;
  const totalContent = Math.round(Math.max(140, (c.members || 120) * multiplier + (liveMsgs * 5) + (channelCount * 45)));

  // حساب البلاغات الفعلية والمقدرة
  const actualReports = (S.adminReports || []).filter(r => r.communityId === c.id || (r.detail && r.detail.includes(c.name))).length;
  const baseRate = c.id === "g_recon" ? 0.007 : c.id === "g_strawhat" ? 0.011 : c.id === "c_shonen" ? 0.023 : c.id === "g_jujutsu" ? 0.032 : c.id === "c_seinen" ? 0.005 : 0.014;
  const estimatedReports = Math.round((c.members || 100) * baseRate);
  const reportedCount = Math.max(1, actualReports + estimatedReports);

  // النسبة المئوية للبلاغات ومؤشر السلامة
  const ratioNum = (reportedCount / totalContent) * 100;
  const ratio = ratioNum.toFixed(2);
  const healthScore = Math.max(0, 100 - ratioNum).toFixed(2);

  // الحالة
  let status = { label: "ممتاز (Excellent)", badge: "b-emerald", color: "var(--emerald)", level: "exc" };
  if(ratioNum >= 3.5){
    status = { label: "عالي الخطورة (Attention)", badge: "b-red", color: "var(--rose)", level: "high" };
  } else if(ratioNum >= 2.0){
    status = { label: "متوسط (Moderate)", badge: "b-gold", color: "var(--gold)", level: "med" };
  } else if(ratioNum >= 1.0){
    status = { label: "مستقر (Good)", badge: "b-cyan", color: "var(--cyan)", level: "good" };
  }

  // تفصيل أسباب البلاغات
  const spam = Math.max(1, Math.round(reportedCount * 0.42));
  const harassment = Math.max(1, Math.round(reportedCount * 0.28));
  const toxic = Math.max(1, Math.round(reportedCount * 0.18));
  const spoilers = Math.max(1, reportedCount - (spam + harassment + toxic));

  return {
    id: c.id,
    name: c.name,
    desc: c.desc || "",
    type: c.type || "space",
    typeLabel,
    icon: c.icon || "shield",
    c1: c.c1 || "#1E3A8A",
    c2: c.c2 || "#3B82F6",
    members: c.members || 0,
    online: c.online || 0,
    totalContent,
    reportedCount,
    ratio,
    ratioNum,
    healthScore,
    status,
    breakdown: { spam, harassment, toxic, spoilers },
    autoInterceptionRate: Math.min(96, Math.max(78, Math.round(92 - (ratioNum * 2.5)))),
    avgResponseMin: isGuild ? 11 : 16
  };
}

function getCommunityHealthStats(){
  ensureCommunities();
  return (S.communities || []).map(getSingleCommunityHealthStats);
}

/* مخطط مساحي SVG ديناميكي لمقارنة حركة المحتوى الكلي مقابل البلاغات */
function svgHealthTrendChart(){
  const w = 340, h = 88;
  const days = ["السبت","الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","اليوم"];
  const totalVol = [1240, 1580, 1420, 1890, 2100, 2450, 2890];
  const reportVol = [14, 22, 18, 31, 26, 29, 38];

  const maxTot = Math.max(...totalVol) || 1;
  const maxRep = (Math.max(...reportVol) || 1) * 35; // scale to fit visual comparison

  const ptsTot = totalVol.map((v, i) => [i * (w / (totalVol.length - 1)), h - (v / maxTot) * (h - 18) - 8]);
  const ptsRep = reportVol.map((v, i) => [i * (w / (reportVol.length - 1)), h - ((v * 35) / maxRep) * (h - 22) - 8]);

  const pathTot = ptsTot.map((p, i) => (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
  const areaTot = pathTot + ` L ${w} ${h} L 0 ${h} Z`;

  const pathRep = ptsRep.map((p, i) => (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
  const areaRep = pathRep + ` L ${w} ${h} L 0 ${h} Z`;

  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%;height:${h}px;display:block">
    <defs>
      <linearGradient id="gTot" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#22D3EE" stop-opacity="0.45"/>
        <stop offset="100%" stop-color="#22D3EE" stop-opacity="0.0"/>
      </linearGradient>
      <linearGradient id="gRep" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F43F5E" stop-opacity="0.55"/>
        <stop offset="100%" stop-color="#F43F5E" stop-opacity="0.0"/>
      </linearGradient>
    </defs>
    <!-- مسار إجمالي المحتوى -->
    <path d="${areaTot}" fill="url(#gTot)"/>
    <path d="${pathTot}" fill="none" stroke="#22D3EE" stroke-width="2.2" stroke-linecap="round"/>
    ${ptsTot.map(p => `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="2.8" fill="#22D3EE" stroke="#0F172A" stroke-width="1.5"/>`).join("")}

    <!-- مسار البلاغات المرصودة -->
    <path d="${areaRep}" fill="url(#gRep)"/>
    <path d="${pathRep}" fill="none" stroke="#F43F5E" stroke-width="2.2" stroke-dasharray="3,2" stroke-linecap="round"/>
    ${ptsRep.map(p => `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="2.8" fill="#F43F5E" stroke="#0F172A" stroke-width="1.5"/>`).join("")}
  </svg>
  <div class="rowb tiny fnt" style="margin-top:4px;color:var(--muted)">
    ${days.map(d => `<span>${d}</span>`).join("")}
  </div>`;
}

/* مخطط دائري SVG لتوزيع أسباب البلاغات */
function svgViolationDonut(b){
  const total = (b.spam + b.harassment + b.toxic + b.spoilers) || 1;
  const pSpam = (b.spam / total) * 100;
  const pHar = (b.harassment / total) * 100;
  const pTox = (b.toxic / total) * 100;
  const pSpo = (b.spoilers / total) * 100;

  const circ = 2 * Math.PI * 40; // ~251.32

  const dSpam = (pSpam / 100) * circ;
  const dHar = (pHar / 100) * circ;
  const dTox = (pTox / 100) * circ;
  const dSpo = (pSpo / 100) * circ;

  const offSpam = 0;
  const offHar = -(dSpam);
  const offTox = -(dSpam + dHar);
  const offSpo = -(dSpam + dHar + dTox);

  return `<svg viewBox="0 0 100 100" style="width:90px;height:90px;transform:rotate(-90deg)">
    <circle cx="50" cy="50" r="40" fill="transparent" stroke="var(--surface3)" stroke-width="12"/>
    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#F59E0B" stroke-width="12" stroke-dasharray="${dSpam} ${circ}" stroke-dashoffset="${offSpam}"/>
    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#EF4444" stroke-width="12" stroke-dasharray="${dHar} ${circ}" stroke-dashoffset="${offHar}"/>
    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#A855F7" stroke-width="12" stroke-dasharray="${dTox} ${circ}" stroke-dashoffset="${offTox}"/>
    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#3B82F6" stroke-width="12" stroke-dasharray="${dSpo} ${circ}" stroke-dashoffset="${offSpo}"/>
  </svg>`;
}

/* الرندر الكامل للوحة صحة المحتوى العامة */
function adminHealthDashboard(){
  ensureCommunities();
  const allStats = getCommunityHealthStats();

  const filter = S.adminHealthFilter || "all";
  const sort = S.adminHealthSort || "ratio_desc";
  const time = S.adminHealthTime || "7d";
  const query = (S.adminHealthQ || "").trim().toLowerCase();

  // تصفية الكيانات
  let items = (allStats||[]).slice();
  if(filter === "guild") items = items.filter(x => x.type === "guild");
  else if(filter === "space") items = items.filter(x => x.type !== "guild");
  else if(filter === "risk") items = items.filter(x => x.status.level === "high" || x.status.level === "med");

  if(query){
    items = items.filter(x => x.name.toLowerCase().includes(query) || (x.desc && x.desc.toLowerCase().includes(query)));
  }

  // الترتيب
  if(sort === "ratio_desc") items.sort((a,b) => b.ratioNum - a.ratioNum);
  else if(sort === "health_desc") items.sort((a,b) => b.healthScore - a.healthScore);
  else if(sort === "content_desc") items.sort((a,b) => b.totalContent - a.totalContent);

  // الحسابات التراكمية العامة
  const globalTotalContent = allStats.reduce((acc, x) => acc + x.totalContent, 0);
  const globalReportedContent = allStats.reduce((acc, x) => acc + x.reportedCount, 0);
  const globalRatio = ((globalReportedContent / (globalTotalContent || 1)) * 100).toFixed(2);
  const globalHealthScore = (100 - Number(globalRatio)).toFixed(2);

  const globalBreakdown = {
    spam: allStats.reduce((acc, x) => acc + x.breakdown.spam, 0),
    harassment: allStats.reduce((acc, x) => acc + x.breakdown.harassment, 0),
    toxic: allStats.reduce((acc, x) => acc + x.breakdown.toxic, 0),
    spoilers: allStats.reduce((acc, x) => acc + x.breakdown.spoilers, 0)
  };

  const maxContentItem = Math.max(...allStats.map(x => x.totalContent)) || 1;
  const maxReportItem = Math.max(...allStats.map(x => x.reportedCount)) || 1;

  return `<div class="col" style="gap:14px">
    
    <!-- الترويسة الرئيسية والإجراءات السريعة -->
    <div class="rowb wrap" style="gap:8px">
      <div>
        <div class="row" style="gap:6px">
          <span style="color:var(--accent)">${I("barchart","i s")}</span>
          <div class="b sm">مؤشرات صحة المحتوى العامة (Global Content Health)</div>
        </div>
        <div class="tiny fnt">مراقبة نسبة البلاغات والمخالفات إلى إجمالي المحتوى حسب النقابات والمجتمعات</div>
      </div>
      <div class="row wrap" style="gap:6px">
        <button class="btn btn-emerald btn-xs" onclick="runDeepHealthAudit()">${I("bot","i s")} فحص صحي فوري</button>
        <button class="btn btn-sec btn-xs" onclick="exportHealthAuditReport()">${I("code","i s")} تصدير التقرير (JSON)</button>
      </div>
    </div>

    <!-- بطاقات المؤشرات التنفيذية الشاملة (Executive KPIs) -->
    <div class="grid4" style="gap:8px">
      <div class="card stat" style="padding:10px 6px;border-top:3px solid var(--emerald)">
        <span style="color:var(--emerald)">${I("shield","i s")}</span>
        <b class="mono" style="font-size:15px;color:var(--emerald)">${globalHealthScore}%</b>
        <span>مؤشر السلامة العام</span>
      </div>
      <div class="card stat" style="padding:10px 6px;border-top:3px solid var(--cyan)">
        <span style="color:var(--cyan)">${I("film","i s")}</span>
        <b class="mono" style="font-size:15px">${nfmt(globalTotalContent)}</b>
        <span>إجمالي المحتوى المرصود</span>
      </div>
      <div class="card stat" style="padding:10px 6px;border-top:3px solid var(--rose)">
        <span style="color:var(--rose)">${I("flag","i s")}</span>
        <b class="mono" style="font-size:15px;color:var(--rose)">${globalReportedContent}</b>
        <span>المحتوى المبلّغ عنه</span>
      </div>
      <div class="card stat" style="padding:10px 6px;border-top:3px solid var(--gold)">
        <span style="color:var(--gold)">${I("chart","i s")}</span>
        <b class="mono" style="font-size:15px">${globalRatio}%</b>
        <span>معدل المخالفات العام</span>
      </div>
    </div>

    <!-- لوحة المخططات البيانية التفاعلية المزدوجة -->
    <div class="card" style="padding:13px">
      <div class="rowb" style="margin-bottom:8px">
        <div>
          <div class="b xs">${I("chart","i s")} تدفق المحتوى المرصود مقابل طفرات البلاغات (${time === '7d' ? 'آخر ٧ أيام' : time === '30d' ? 'آخر ٣٠ يوماً' : 'تراكمي'})</div>
          <div class="tiny fnt">المقارنة الزمنية بين المحتوى السليم وبلاغات المخالفات الواردة</div>
        </div>
        <div class="row" style="gap:5px">
          ${[["7d","٧ أيام"],["30d","٣٠ يوماً"],["all","الكل"]].map(([k,l])=>`
            <button class="chip ${time===k?'on':''}" style="font-size:9.5px;padding:2px 7px" onclick="S.adminHealthTime='${k}';save();render();snd('tap')">${l}</button>
          `).join("")}
        </div>
      </div>

      <!-- المخطط المساحي SVG -->
      ${svgHealthTrendChart()}

      <div class="rowb tiny fnt" style="margin-top:10px;padding-top:8px;border-top:1px solid var(--line)">
        <span class="row" style="gap:5px"><i style="width:9px;height:9px;border-radius:2px;background:#22D3EE;display:inline-block"></i> المحتوى الكلي المنشور</span>
        <span class="row" style="gap:5px"><i style="width:9px;height:9px;border-radius:2px;background:#F43F5E;display:inline-block"></i> بلاغات ومخالفات تم رصدها</span>
        <span style="color:var(--emerald)">نسبة التدخل الآلي: <b>89.4%</b></span>
      </div>
    </div>

    <!-- المخطط المقارن للنسب والتوزيع حسب النقابات والمجتمعات (Segmented Dual-Bar Ratio Chart) -->
    <div class="card" style="padding:13px">
      <div class="rowb wrap" style="margin-bottom:10px;gap:6px">
        <div>
          <div class="b xs">${I("barchart","i s")} مقارنة نسب البلاغات إلى المحتوى لكل نقابة ومجتمع</div>
          <div class="tiny fnt">تحليل بصري دقيق يوضح حجم المحتوى الكلي مقابل حجم البلاغات ومؤشر السلامة</div>
        </div>
        <span class="badge b-cyan mono">مرصود: ${allStats.length} كيان نشط</span>
      </div>

      <div class="col" style="gap:12px">
        ${allStats.map(s => {
          const contentWidth = Math.max(8, Math.round((s.totalContent / maxContentItem) * 100));
          const reportWidth = Math.max(5, Math.round((s.reportedCount / maxReportItem) * 100));
          return `
          <div class="card2" style="padding:10px;cursor:pointer" onclick="openCommunityHealthReport('${s.id}')">
            <div class="rowb" style="margin-bottom:6px">
              <div class="row" style="gap:7px">
                <span class="ico-tile" style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,${s.c1},${s.c2});font-size:11px">${I(s.icon,"i s")}</span>
                <span class="b xs">${esc(s.name)}</span>
                <span class="badge ${s.type === 'guild' ? 'b-gold' : 'b-cyan'}" style="font-size:8.5px">${s.type === 'guild' ? 'نقابة' : 'مجتمع'}</span>
              </div>
              <div class="row" style="gap:6px">
                <span class="badge ${s.status.badge}" style="font-size:9.5px">${s.status.label}</span>
                <span class="mono b xs" style="color:${s.ratioNum < 2 ? 'var(--emerald)' : s.ratioNum < 3.5 ? 'var(--gold)' : 'var(--rose)'}">${s.ratio}% بلاغات</span>
              </div>
            </div>

            <!-- شريط المحتوى الكلي -->
            <div class="rowb tiny fnt" style="margin-bottom:2px">
              <span style="color:var(--cyan)">إجمالي المحتوى: ${nfmt(s.totalContent)} عنصر</span>
              <span class="mono">${contentWidth}% من أقصى كثافة</span>
            </div>
            <div class="bar" style="height:6px;background:var(--surface3);border-radius:4px;overflow:hidden;margin-bottom:6px">
              <i style="width:${contentWidth}%;background:linear-gradient(90deg,var(--cyan),#3B82F6);height:100%;display:block"></i>
            </div>

            <!-- شريط البلاغات والمخالفات -->
            <div class="rowb tiny fnt" style="margin-bottom:2px">
              <span style="color:var(--rose)">البلاغات المرصودة: ${s.reportedCount} بلاغ</span>
              <span class="mono" style="color:var(--emerald)">مؤشر النقاء: ${s.healthScore}%</span>
            </div>
            <div class="bar" style="height:6px;background:var(--surface3);border-radius:4px;overflow:hidden">
              <i style="width:${reportWidth}%;background:linear-gradient(90deg,var(--gold),var(--rose));height:100%;display:block"></i>
            </div>
          </div>`;
        }).join("")}
      </div>
    </div>

    <!-- بطاقتان فرعيتان: تصنيف المخالفات + الحرس الذكي -->
    <div class="grid2" style="gap:10px">
      
      <!-- توزيع أسباب البلاغات العام -->
      <div class="card" style="padding:12px">
        <div class="b xs" style="margin-bottom:8px">${I("target","i s")} تصنيف أسباب البلاغات بالمنصة</div>
        <div class="row" style="gap:12px;align-items:center">
          ${svgViolationDonut(globalBreakdown)}
          <div class="g1 col tiny" style="gap:4px">
            <div class="rowb"><span><i style="width:7px;height:7px;border-radius:50%;background:#F59E0B;display:inline-block"></i> سبام وإعلانات</span><b class="mono">${globalBreakdown.spam}</b></div>
            <div class="rowb"><span><i style="width:7px;height:7px;border-radius:50%;background:#EF4444;display:inline-block"></i> تنمّر ومضايقات</span><b class="mono">${globalBreakdown.harassment}</b></div>
            <div class="rowb"><span><i style="width:7px;height:7px;border-radius:50%;background:#A855F7;display:inline-block"></i> محتوى مخالف</span><b class="mono">${globalBreakdown.toxic}</b></div>
            <div class="rowb"><span><i style="width:7px;height:7px;border-radius:50%;background:#3B82F6;display:inline-block"></i> حرق أحداث</span><b class="mono">${globalBreakdown.spoilers}</b></div>
          </div>
        </div>
      </div>

      <!-- حالة الحرس والتدخل التلقائي -->
      <div class="card" style="padding:12px">
        <div class="b xs" style="margin-bottom:6px">${I("bot","i s")} درع الحرس التلقائي (AI Shield)</div>
        <div class="tiny fnt" style="line-height:1.5;margin-bottom:10px">تحليل فوري للمنشورات والدردشات وحجب السلوك العدائي قبل البلاغات اليدوية.</div>
        <div class="grid2" style="gap:6px">
          <div class="card2 center pad-sm">
            <div class="tiny fnt">نسبة الاعتراض التلقائي</div>
            <div class="mono b sm" style="color:var(--emerald)">89.4%</div>
          </div>
          <div class="card2 center pad-sm">
            <div class="tiny fnt">متوسط سرعة الإغلاق</div>
            <div class="mono b sm" style="color:var(--cyan)">14 دقيقة</div>
          </div>
        </div>
        <button class="btn btn-primary btn-xs" style="width:100%;margin-top:8px" onclick="enforceGlobalAIHealthGuard()">${I("shield","i s")} تطبيق التدقيق الصارم للكل</button>
      </div>

    </div>

    <!-- شريط أدوات التصفية والبحث في الكيانات -->
    <div class="card" style="padding:12px">
      <div class="rowb wrap" style="gap:8px;margin-bottom:10px">
        <div class="chiprow">${[
          ["all","جميع الكيانات ("+allStats.length+")"],
          ["guild","النقابات فقط ("+allStats.filter(x=>x.type==='guild').length+")"],
          ["space","المجتمعات والمساحات ("+allStats.filter(x=>x.type!=='guild').length+")"],
          ["risk","الأعلى بلاغات ("+allStats.filter(x=>x.status.level==='high'||x.status.level==='med').length+")"]
        ].map(([k,l])=>`
          <button class="chip ${filter===k?'on':''}" onclick="S.adminHealthFilter='${k}';save();render();snd('tap')">${l}</button>
        `).join("")}</div>

        <div class="row" style="gap:6px">
          <select class="inp tiny" style="padding:3px 8px" onchange="S.adminHealthSort=this.value;save();render()">
            <option value="ratio_desc" ${sort==='ratio_desc'?'selected':''}>الأعلى نسبة بلاغات ↓</option>
            <option value="health_desc" ${sort==='health_desc'?'selected':''}>الأعلى سلامة ونقاء ↑</option>
            <option value="content_desc" ${sort==='content_desc'?'selected':''}>الأكثر كثافة محتوى ↓</option>
          </select>
        </div>
      </div>

      <div class="search-bar" style="margin-bottom:12px">
        ${I("search","i s")}
        <input class="inp" placeholder="ابحث عن نقابة أو مجتمع بالاسم..." value="${esc(S.adminHealthQ||'')}" oninput="S.adminHealthQ=this.value;render()">
        ${S.adminHealthQ?`<button class="iconbtn" onclick="S.adminHealthQ='';render()">${I("x","i s")}</button>`:""}
      </div>

      <!-- قائمة الكيانات المفصلة ببطاقات الحوكمة -->
      <div class="col" style="gap:10px">
        ${items.map(s => {
          const isStrict = !!(S.guildStrictGuards && S.guildStrictGuards[s.id]);
          return `
          <div class="card" style="padding:12px;border-color:${s.status.level === 'high' ? 'rgba(239,68,68,.35)' : 'var(--line)'}">
            <div class="rowb wrap" style="gap:6px">
              <div class="row" style="gap:9px">
                <span class="ico-tile" style="width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,${s.c1},${s.c2});color:#fff">${I(s.icon,"i s")}</span>
                <div class="g1" style="min-width:0;text-align:right">
                  <div class="row" style="gap:6px">
                    <span class="b xs">${esc(s.name)}</span>
                    <span class="badge ${s.status.badge}">${s.status.label}</span>
                    ${isStrict ? `<span class="badge b-purple">حرس صارم ✓</span>` : ''}
                  </div>
                  <div class="tiny fnt">${s.typeLabel} · ${nfmt(s.members)} عضو · ${s.online} متصل</div>
                </div>
              </div>

              <div class="row" style="gap:6px">
                <div class="col" style="text-align:left">
                  <div class="mono b xs" style="color:${s.ratioNum < 2 ? 'var(--emerald)' : 'var(--rose)'}">${s.ratio}% بلاغات</div>
                  <div class="tiny fnt">${s.reportedCount} من ${nfmt(s.totalContent)}</div>
                </div>
              </div>
            </div>

            <!-- مقياس النقاء الصوري -->
            <div style="margin:9px 0 7px">
              <div class="rowb tiny" style="margin-bottom:3px">
                <span class="fnt">مؤشر النقاء: <b class="mono" style="color:var(--emerald)">${s.healthScore}%</b></span>
                <span class="fnt">معدل اعتراض الحرس: <b>${s.autoInterceptionRate}%</b></span>
              </div>
              <div class="bar" style="height:6px;background:var(--surface3);border-radius:4px;overflow:hidden">
                <i style="width:${s.healthScore}%;background:linear-gradient(90deg,var(--cyan),var(--emerald));height:100%;display:block"></i>
              </div>
            </div>

            <!-- شرائح توزيع البلاغات -->
            <div class="chiprow wrap" style="gap:4px;margin-bottom:9px">
              <span class="chip tiny mono" style="font-size:8.5px">سبام: ${s.breakdown.spam}</span>
              <span class="chip tiny mono" style="font-size:8.5px">تنمّر: ${s.breakdown.harassment}</span>
              <span class="chip tiny mono" style="font-size:8.5px">مخالف: ${s.breakdown.toxic}</span>
              <span class="chip tiny mono" style="font-size:8.5px">حرق: ${s.breakdown.spoilers}</span>
            </div>

            <!-- أزرار الإشراف والإدارة المباشرة -->
            <div class="row wrap" style="gap:6px">
              <button class="btn btn-sec btn-xs g1" onclick="openCommunityHealthReport('${s.id}')">${I("barchart","i s")} تقرير مفصل</button>
              <button class="btn btn-sec btn-xs g1" onclick="adminComStrictGuard('${s.id}')">${I("bot","i s")} ${isStrict ? 'إلغاء الحرس' : 'حرس صارم'}</button>
              <button class="btn btn-gold btn-xs" onclick="adminWarnCommunityMods('${s.id}')">${I("bell","i s")} تنبيه الإدارة</button>
              <button class="btn btn-ghost btn-xs" onclick="filterReportsByCommunity('${s.id}')">${I("flag","i s")} البلاغات (${s.reportedCount})</button>
            </div>
          </div>`;
        }).join("") || `<div class="card2 center tiny mut" style="padding:24px 12px;text-align:center">${I("check","l")}<div class="b xs" style="margin-top:6px">لا توجد كيانات مطابقة لخيارات البحث</div></div>`}
      </div>
    </div>

  </div>`;
}

/* إجراءات وحركات لوحة صحة المحتوى */
function openCommunityHealthReport(cid){
  ensureCommunities();
  openSheet('communityHealthDetail', cid);
}

function adminComStrictGuard(cid){
  S.guildStrictGuards = S.guildStrictGuards || {};
  S.guildStrictGuards[cid] = !S.guildStrictGuards[cid];
  const c = (S.communities||[]).find(x => x.id === cid);
  const name = c ? c.name : "الكيان";
  save();
  if(S.guildStrictGuards[cid]){
    toast("تم تفعيل وضع الحرس الذكي الصارم لنقابة "+name,"ok");
    snd("success");
  } else {
    toast("تمت إعادة الحرس للوضع القياسي لنقابة "+name,"info");
  }
  render();
}

function adminWarnCommunityMods(cid){
  ensureCommunities();
  const c = (S.communities||[]).find(x => x.id === cid);
  const name = c ? c.name : "الكيان";
  
  S.notifs = S.notifs || [];
  S.notifs.unshift({
    id: uid(),
    type: "system",
    actorId: "system",
    title: "تنبيه صحة المحتوى للنقابة",
    text: "⚠️ تنبيه إداري رسمي إلى مسؤولي ("+name+"): رُصد ارتفاع في نسبة البلاغات والمخالفات، يرجى مراجعة غرف النقابة وتكثيف الإشراف.",
    createdAt: now(),
    read: false
  });

  save();
  toast("تم إرسال تنبيه رسمي لمشرفي "+name,"ok");
  snd("success");
  render();
}

function filterReportsByCommunity(cid){
  ensureCommunities();
  const c = (S.communities||[]).find(x => x.id === cid);
  const name = c ? c.name : "";
  go("admin", { tab: "moderation" });
  toast("تم الانتقال لطابور البلاغات المخصصة لـ "+name,"info");
}

function runDeepHealthAudit(){
  toast("جاري تشغيل الفحص الصحي العميق لجميع قنوات ونقابات المنصة...","info");
  snd("tap");
  setTimeout(()=>{
    celebrate("اكتمل التدقيق الصحي بنجاح! نسبة سلامة المنصة: 98.4%");
    toast("تم فحص 38,450 عنصر محتوى وتحديث سجلات الحرس بنجاح","ok");
    snd("success");
    render();
  }, 600);
}

function exportHealthAuditReport(){
  ensureCommunities();
  const stats = getCommunityHealthStats();
  const reportObj = {
    platform: "Anime Black Global Content Health",
    generatedAt: new Date().toISOString(),
    auditor: "m774545471@gmail.com",
    metrics: {
      totalMonitoredEntities: stats.length,
      globalHealthScore: "98.42%",
      globalViolationRatio: "1.58%",
      automatedShieldRate: "89.4%"
    },
    entities: stats
  };

  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(reportObj, null, 2));
  const dlAnchorElem = document.createElement('a');
  dlAnchorElem.setAttribute("href", dataStr);
  dlAnchorElem.setAttribute("download", "global_content_health_audit_" + Date.now() + ".json");
  dlAnchorElem.click();

  toast("تم تصدير تقرير صحة المحتوى العام بصيغة JSON بنجاح","ok");
  snd("success");
}

function exportSingleCommunityHealthJSON(cid){
  ensureCommunities();
  const c = (S.communities||[]).find(x => x.id === cid);
  if(!c) return;
  const stats = getSingleCommunityHealthStats(c);
  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(stats, null, 2));
  const dlAnchorElem = document.createElement('a');
  dlAnchorElem.setAttribute("href", dataStr);
  dlAnchorElem.setAttribute("download", "health_audit_" + cid + "_" + Date.now() + ".json");
  dlAnchorElem.click();

  toast("تم تصدير تقرير صحة "+c.name+" بنجاح","ok");
  snd("success");
}

function openAddBadWordModal(){
  openModal("إضافة كلمة للقائمة المحظورة",`
    <div class="col" style="gap:10px">
      <label class="lbl">الكلمة أو العبارة المحظورة</label>
      <input class="inp" id="new_bw_inp" placeholder="اكتب الكلمة لمنع تداولها...">
      <div class="row" style="gap:8px;margin-top:6px">
        <button class="btn btn-primary btn-sm g1" onclick="const v=$('#new_bw_inp').value.trim();if(v){S.badWords=S.badWords||[];if(!S.badWords.includes(v))S.badWords.push(v);save();closeOvl();render();toast('أُضيفت الكلمة: '+v,'ok')}">${I("plus","i s")} إضافة</button>
        <button class="btn btn-sec btn-sm" onclick="closeOvl()">${I("x","i s")} إلغاء</button>
      </div>
    </div>
  `);
}

function removeBadWord(w){
  S.badWords=(S.badWords||[]).filter(x=>x!==w);
  save();render();toast("أُزيلت: "+w,"info");
}

function openAdminAddUserModal(){
  openModal("إضافة عضو جديد للنظام",`
    <div class="col" style="gap:10px">
      <label class="lbl">الاسم الظاهر *</label>
      <input class="inp" id="a_nu_name" placeholder="مثال: أكازا، كاكاشي">
      <label class="lbl">اسم المستخدم الفريد (@) *</label>
      <input class="inp mono" id="a_nu_un" placeholder="akaza_demon">
      <label class="lbl">الرتبة المبدئية</label>
      <select class="inp" id="a_nu_role">
        <option value="عضو">عضو عادي</option>
        <option value="صانع محتوى">صانع محتوى</option>
        <option value="مشرف محتوى">مشرف محتوى</option>
        <option value="مشرف أول">مشرف أول</option>
      </select>
      <div class="row" style="gap:8px;margin-top:6px">
        <button class="btn btn-primary btn-sm g1" onclick="adminCreateUserSubmit()">${I("check","i s")} حفظ العضو</button>
        <button class="btn btn-sec btn-sm" onclick="closeOvl()">${I("x","i s")} إلغاء</button>
      </div>
    </div>
  `);
}

function adminCreateUserSubmit(){
  const nm=($("#a_nu_name")?$("#a_nu_name").value:"").trim();
  const un=($("#a_nu_un")?$("#a_nu_un").value:"").trim().toLowerCase();
  const role=($("#a_nu_role")?$("#a_nu_role").value:"عضو");
  if(!nm || !un){toast("يرجى إدخال الاسم واسم المستخدم","err");return}
  const newU={
    id:"u_"+uid(),
    name:nm,
    username:un,
    role:role,
    avatar:AV[Math.floor(Math.random()*AV.length)],
    level:1,
    coins:200,
    wallet:200,
    isVerified:false,
    joined:now()
  };
  S.users=S.users||[];
  S.users.unshift(newU);
  save();closeOvl();render();
  toast("تمت إضافة العضو: "+nm+" (@"+un+") بنجاح","ok");
  snd("success");
}

function runTerm(){
  const i=$("#termin"),o=$("#termout");if(!i||!o)return;
  const c=i.value.trim();if(!c)return;i.value="";
  let r="";
  if(c==="help"){
    r="الأوامر المتاحة:\n- stats: عرض إحصائيات المنصة اللحظية\n- users list: قائمة الأعضاء والرتب\n- broadcast <msg>: بث رسالة عامة فورية\n- give <@user> <amount>: منح عملات لعضو\n- ban <@user>: حظر عضو\n- unban <@user>: فك حظر عضو\n- verify <@user>: توثيق حساب\n- clear cache: مسح الكاش المؤقت\n- backup: تصدير بيانات JSON\n- health: صحة قواعد البيانات والخوادم\n- rules: قواعد الحماية\n- cls / clear: تنظيف الشاشة";
  } else if(c==="cls"||c==="clear"){
    o.textContent="$ animeblack super-admin shell v25.0\n$ شاشة نظيفة.\n";return;
  } else if(c==="stats"){
    r=`إجمالي المستخدمين: ${(S.users||[]).length + 12480} | المنشورات: ${(S.posts||[]).length + 84200} | البلاغات المعلّقة: ${(S.adminReports||[]).filter(x=>x.status==='pending').length} | المحظورون: ${(S.blocked||[]).length}`;
  } else if(c==="users list"){
    r=(S.users||[]).slice(0,8).map(x=>"• @"+x.username+" ("+x.name+") — LV "+x.level+" — "+x.role).join("\n")||"لا مستخدمين مسجلين";
  } else if(c.startsWith("broadcast ")){
    const msg=c.slice(10).trim();
    quickBroadcast("إشعار الطرفية الإدارية",msg,"announcement");
    r="[SUCCESS] تم بث الإشعار بنجاح: "+msg;
  } else if(c.startsWith("give ")){
    const parts=c.split(" ");
    const amt=parseInt(parts[2]||"100",10);
    r="[SUCCESS] أُضيفت "+amt+" عملة بنجاح";
  } else if(c.startsWith("ban ")){
    r="[BANNED] تم تنفيذ أمر الحظر على: "+c.slice(4);
  } else if(c.startsWith("unban ")){
    r="[UNBANNED] تم فك الحظر عن: "+c.slice(6);
  } else if(c==="clear cache"){
    r="[OK] تم تفريغ الكاش المحلي والذاكرة المؤقتة بنجاح";
  } else if(c==="backup"){
    downloadData();
    r="[OK] تم إنشاء وتنزيل ملف النسخة الاحتياطية JSON";
  } else if(c==="health"){
    r="[HEALTH] Firestore: OK (28ms) | Cloud Run: OK (Port 3000) | Auth: ACTIVE | Gemini: READY";
  } else if(c==="rules"){
    r="[SECURITY] RBAC enforced | Restricted exclusively to m774545471@gmail.com";
  } else {
    r="[ERROR] أمر غير معروف: "+c+" (اكتب help لعرض الأوامر)";
  }
  o.textContent+="$ "+c+"\n"+r+"\n";
  o.scrollTop=o.scrollHeight;
  snd("tap");
}

/* ============================================================
   22) بوابة المطورين + إعدادات المركز + صفحة التحميل
   ============================================================ */
/* ===== المرحلة ١٢: طبقة الأفعال الحقيقية ===== */
function dl(filename,text,mime){try{const bl=new Blob([text],{type:mime||"application/json;charset=utf-8"});const a=document.createElement("a");a.href=URL.createObjectURL(bl);a.download=filename;document.body.appendChild(a);a.click();setTimeout(()=>{try{URL.revokeObjectURL(a.href)}catch(e){}a.remove()},500);return true}catch(e){toast("تعذّر إنشاء الملف: "+e.message,"err");return false}}
function downloadData(){if(dl("animeblack-data.json",JSON.stringify(S,null,1)))toast("تم تنزيل نسخة من بياناتك ","ok")}
function statTap(l,v){if(l==="منشور"){S.profileTab="posts";go("profile",{},false)}else if(l==="نجمة"){S.econTab="stats";go("economy");toast("نجومك في تبويب الإحصائيات ","info")}else{toast(l+": "+v,"info")}}
function shareEvent(t,d){const txt="أنمي بلاك · "+t+" — "+d;try{if(navigator.share){navigator.share({title:t,text:txt}).catch(()=>{});toast("جارٍ المشاركة... ","ok");return}if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(()=>toast("نُسخ نص الفعالية إلى الحافظة ","ok"),()=>toast("انسخ يدوياً: "+txt,"info"));return}}catch(e){}toast("تمت مشاركة الفعالية ","ok")}
function addCal(t,d){const dt=new Date(Date.now()+3*864e5);const stamp=dt.toISOString().replace(/[-:]/g,"").split(".")[0]+"Z";const ics=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//AnimeBlack//AR","BEGIN:VEVENT","UID:"+uid()+"@animeblack","DTSTAMP:"+stamp,"DTSTART:"+dt.toISOString().slice(0,10).replace(/-/g,""),"SUMMARY:"+t,"DESCRIPTION:"+d,"END:VEVENT","END:VCALENDAR"].join("\r\n");if(dl((t||"event").replace(/[\s\/?:*<>|]/g,"-").slice(0,28)+".ics",ics,"text/calendar"))toast("أُضيفت إلى تقويمك (ملف ICS حقيقي) ","ok")}
function replyPre(btn,name){const inp=document.querySelector("#rcinp")||document.querySelector("#cmtinp")||document.querySelector("#chin");if(inp){inp.value="@"+(name||"")+" ";inp.focus();toast("اكتب ردك إلى "+(name||"")+" ","info")}else{toast("رد","info")}}
function fmtMail(){const t=$("#mc_b");if(!t){toast("تم تنسيق النص ","info");return}const s=t.selectionStart||0,e=t.selectionEnd||0,v=t.value||"";if(s===e){t.value=v+"**نص عريض**";t.selectionStart=t.selectionEnd=t.value.length}else{t.value=v.slice(0,s)+"**"+v.slice(s,e)+"**"+v.slice(e);t.selectionStart=s+2;t.selectionEnd=e+2}t.focus();toast("تم تنسيق النص (عريض) ","ok")}
function mailAttach(inp){const f=inp.files&&inp.files[0];if(!f)return;(S.mailAtt=S.mailAtt||[]).push(f.name);save();const n=$("#mattNote");if(n)n.innerHTML="المرفقات: "+S.mailAtt.map(esc).join("، ");toast("أُرفق: "+f.name+" ","ok")}
const /* v5: كانت هذه قيماً وهمية ثابتة تُحقن في قصتك بلا سؤال
   (طوكيو·أكيهابارا / Unravel—Tokyo Ghoul / @reem_otaku / فريرن...).
   بعد v4 صار المستخدم يكتب المحتوى بنفسه؛ أُفرغت القيم لمنع أي تسرب. */
STKDEFS={poll:()=>({t:"poll",q:"",opts:[],votes:[]}),ask:()=>({t:"ask",q:"",answers:[]}),count:()=>({t:"count",label:"",target:0}),loc:()=>({t:"loc",v:""}),music:()=>({t:"music",v:""}),tag:()=>({t:"tag",v:""})};
/* ===== v4: كان addSticker يضيف الملصق فوراً بقيم ثابتة مكتوبة مسبقاً:
   poll → "أي أنمي الأفضل هذا الموسم؟" مع خيارات "فريرن/سولو ليفلينج"
   ask  → "اسألني أي شيء عن الأنمي!"   |  loc → "طوكيو · أكيهابارا"
   music→ "Unravel — Tokyo Ghoul OP"    |  tag → "@reem_otaku"
   بدون أي حقل إدخال — يعمل من نفسه.
   الأصل: S.storyStickers.push(STKDEFS[k]())
   الآن: نافذة إدخال لكل نوع، والمستخدم هو من يكتب المحتوى. ===== */
function addSticker(k){ if(!STKDEFS[k])return; window.__stk=k; openSheet("stkEditSheet"); }
function stkCommit(){
  const k=window.__stk; if(!k)return;
  const val=id=>{const e=document.getElementById(id);return e?(e.value||"").trim():""};
  let o=null;
  if(k==="poll"){
    const q=val("stk_q"), opts=["stk_o1","stk_o2","stk_o3","stk_o4"].map(val).filter(Boolean);
    if(!q){toast("اكتب سؤال الاستطلاع","err");return}
    if(opts.length<2){toast("أضف خيارين على الأقل","err");return}
    o={t:"poll",q,opts,votes:opts.map(()=>0)};
  } else if(k==="ask"){
    const q=val("stk_q"); if(!q){toast("اكتب نص السؤال","err");return}
    o={t:"ask",q,answers:[]};
  } else if(k==="count"){
    const lb=val("stk_q"), d=val("stk_date");
    if(!lb){toast("اكتب عنوان العدّاد","err");return}
    if(!d){toast("اختر التاريخ والوقت","err");return}
    const tgt=new Date(d).getTime();
    if(!tgt||tgt<=Date.now()){toast("اختر وقتاً في المستقبل","err");return}
    o={t:"count",label:lb,target:tgt};
  } else if(k==="loc"){
    const v=val("stk_q"); if(!v){toast("اكتب اسم الموقع","err");return}
    o={t:"loc",v};
  } else if(k==="music"){
    const v=val("stk_q"); if(!v){toast("اكتب اسم المقطع","err");return}
    o={t:"music",v};
  } else if(k==="tag"){
    let v=val("stk_q"); if(!v){toast("اكتب اسم المستخدم","err");return}
    if(v[0]!=="@")v="@"+v; o={t:"tag",v};
  }
  if(!o)return;
  S.storyStickers=S.storyStickers||[]; S.storyStickers.push(o);
  window.__stk=null; save(); closeOvl(); render(); snd("success");
  toast("أُضيف الملصق إلى قصتك ","ok");
}

function delSticker(i){S.storyStickers=(S.storyStickers||[]).filter((_,x)=>x!==i);save();render();toast("حُذف الملصق ","info")}
function saveStoryDraft(){/* v2: كانت saveDraft — دهستها نسخة أخرى فتعطّل حفظ مسودات القصص */(S.storyDrafts=S.storyDrafts||[]).unshift({id:uid(),stickers:(S.storyStickers||[]).slice(),txt:($("#stxt")&&$("#stxt").value)||"",at:now()});S.storyStickers=[];save();render();toast("حُفظت في مسودات القصص ","ok")}
function restoreDraft(id){const d=(S.storyDrafts||[]).find(x=>x.id===id);if(!d)return;S.storyStickers=(d.stickers||[]).slice();S.storyDrafts=S.storyDrafts.filter(x=>x.id!==id);save();render();toast("استُعيدت المسودة ","ok")}
function delStoryDraft(id){/* v2: كانت delDraft — دهستها نسخة أخرى فتعطّل حذف مسودات القصص */S.storyDrafts=(S.storyDrafts||[]).filter(x=>x.id!==id);save();render();toast("حُذفت المسودة ","info")}
function muteStory(sid){S.mutedStories=S.mutedStories||[];const st=(S.stories||[]).find(x=>x.id===sid);const nm=st?u(st.userId).name:"";if(!S.mutedStories.includes(sid))S.mutedStories.push(sid);if(st)st.seen=true;save();render();toast("كُتمت قصة "+nm,"info",()=>{S.mutedStories=(S.mutedStories||[]).filter(x=>x!==sid);if(st)st.seen=false;save();render();toast("أُلغي كتم قصة "+nm,"ok")})}
function stkView(st,sid,ii,k2,sk){
  const base="background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.25);border-radius:14px;padding:10px 12px;color:#fff;backdrop-filter:blur(6px)";
  if(sk.t==="poll"){const tot=(sk.votes||[0,0]).reduce((a,b)=>a+b,0)||1;return `<div style="${base}"><div class="b tiny" style="margin-bottom:7px">${esc(sk.q)}</div>${(sk.opts||[]).map((o,oi)=>{const pc=Math.round(100*(sk.votes[oi]||0)/tot);return `<button onclick="voteStk('${sid}',${ii},${k2},${oi})" style="display:block;width:100%;margin-top:5px;text-align:right;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:10px;padding:7px 10px;font-size:11.5px;font-weight:700;position:relative;overflow:hidden"><span style="position:absolute;inset:0;width:${pc}%;background:var(--grad-fire);opacity:.55"></span><span style="position:relative">${esc(o)} · ${pc}%</span></button>`}).join("")}</div>`}
  if(sk.t==="ask"){return `<div style="${base}"><div class="b tiny" style="margin-bottom:7px">${esc(sk.q)}</div><div class="row" style="gap:6px"><input class="inp g1" id="stkAsk_${ii}_${k2}" placeholder="اكتب سؤالك..." style="background:rgba(0,0,0,.45);border-color:rgba(255,255,255,.3);color:#fff;font-size:11.5px"><button class="btn btn-primary btn-xs" onclick="askStk('${sid}',${ii},${k2})">إرسال</button></div>${(sk.answers||[]).length?`<div class="tiny" style="margin-top:6px;opacity:.9">${(sk.answers||[]).length} إجابة — آخرها: ${esc(sk.answers[((sk&&sk.answers)||[]).length-1])}</div>`:""}</div>`}
  if(sk.t==="count"){const ms=Math.max(0,(sk.target||0)-Date.now());const dd=Math.floor(ms/864e5),hh=Math.floor(ms%864e5/36e5),mm=Math.floor(ms%36e5/6e4);return `<div style="${base}" class="center"><div class="tiny" style="opacity:.85">${esc(sk.label||"عدّاد")}</div><div class="bb mono" style="font-size:19px;margin-top:3px">${dd}ي ${hh}س ${mm}د</div></div>`}
  const icn=sk.t==="loc"?"map":sk.t==="music"?"music":"at";
  return `<div style="${base};display:flex;align-items:center;gap:8px" class="row"><span style="color:#fff">${I(icn,"i s")}</span><span class="b tiny">${esc(sk.v||"")}</span></div>`;
}
function voteStk(sid,ii,k2,oi){const st=(S.stories||[]).find(x=>x.id===sid);const sk=st&&((st.items||[])[ii]||{})&&((st.items||[])[ii]||{}).stickers&&((st.items||[])[ii]||{}).stickers[k2];if(!sk)return;sk.votes=sk.votes||[0,0];sk.votes[oi]=(sk.votes[oi]||0)+1;save();render();toast("سُجل صوتك ","ok")}
function askStk(sid,ii,k2){const inp=$("#stkAsk_"+ii+"_"+k2);const v=(inp&&inp.value||"").trim();if(!v){toast("اكتب سؤالاً أولاً","err");return}const st=(S.stories||[]).find(x=>x.id===sid);const sk=st&&((st.items||[])[ii]||{})&&((st.items||[])[ii]||{}).stickers&&((st.items||[])[ii]||{}).stickers[k2];if(!sk)return;sk.answers=sk.answers||[];sk.answers.push(v);save();render();toast("أُرسل سؤالك ","ok")}
function saveCh(aid,ch){const k=aid+":"+ch;(S.savedCh=S.savedCh||[]);const has=S.savedCh.includes(k);if(has)S.savedCh=S.savedCh.filter(x=>x!==k);else S.savedCh.push(k);save();render();toast(has?"أُزيل الفصل من المحفوظات ":"حُفظ الفصل "+ch+" ","ok")}
function zoomCh(d){S.mangaZoom=Math.min(1.8,Math.max(0.6,Math.round(((S.mangaZoom||1)+d*0.2)*10)/10));save();render();const el=document.querySelector("#page .pad");if(el)el.style.zoom=S.mangaZoom;toast("التكبير: "+Math.round(S.mangaZoom*100)+"%","info")}
function insMention(un){const i=$("#pub_txt");if(i){i.value+=(i.value?" ":"")+"@"+un+" ";S.draftText=i.value;cnt(i,500,"pub_cnt");i.focus()}closeOvl();toast("أُضيف ذكر @"+un+" ","ok")}
function mentionSomeone(){openSheet('mentionSheet')}
function toggleDraftLoc(){const _t=$("#pub_txt");S.draftText=_t?_t.value:(S.draftText||"");
  const steps=["","طوكيو · أكيحابارا"];
  if(S.perms&&S.perms.geo&&String(S.perms.geo).startsWith("ممنوح"))steps.push(String(S.perms.geo).replace("ممنوح ","موقعي الحقيقي "));
  const cur=S.draftLoc||"";const i=steps.indexOf(cur);S.draftLoc=(i>=0)?steps[(i+1)%steps.length]:(cur?"":steps[1]||"");
  save();render();const _t2=$("#pub_txt");if(_t2)_t2.value=S.draftText||"";
  toast(S.draftLoc?"تم إضافة موقع: "+S.draftLoc:"أُزيل الموقع من المنشور ",S.draftLoc?"ok":"info")}
function toggleDraftLock(){const _t=$("#pub_txt");S.draftText=_t?_t.value:(S.draftText||"");S.draftLockComments=!S.draftLockComments;save();render();const _t2=$("#pub_txt");if(_t2)_t2.value=S.draftText||"";toast(S.draftLockComments?"سيُقفل باب التعليقات عند النشر ":"فُتح باب التعليقات ",S.draftLockComments?"ok":"info")}
function saveSchedule(){const inp=$("#schT");const v=(inp&&inp.value)||"";if(!v){toast("اختر التاريخ والوقت أولاً","err");return}const txt=($("#schTxt")&&$("#schTxt").value||"").trim()||(($("#pub_txt")&&$("#pub_txt").value)||"").trim()||"منشور مجدول";(S.scheduledPosts=S.scheduledPosts||[]).push({id:uid(),t:v,txt});save();closeOvl();toast("تم جدولة المنشور ","ok");if(S.page==="create")render()}
function pubScheduled(id){const x=(S.scheduledPosts||[]).find(y=>y.id===id);if(!x)return;S.posts.unshift({id:"p"+uid(),authorId:"me",author:S.me,type:"post",text:x.txt,media:{c1:"#1E1B4B",c2:"#6366F1",emo:"msgsq"},likes:0,liked:false,saved:false,comments:[],shares:0,views:1,createdAt:now(),privacy:"public",tags:[],reactions:[],loc:"",lockC:false});S.scheduledPosts=S.scheduledPosts.filter(y=>y.id!==id);addXP(25,"نشر منشور مجدول");save();closeOvl();go("home",{},false);celebrate("نُشر المنشور المجدول بنجاح ")}
function delScheduled(id){S.scheduledPosts=(S.scheduledPosts||[]).filter(y=>y.id!==id);save();closeOvl();toast("حُذف المنشور المجدول ","info");if(S.page==="create")render()}
function sendAltCode(){S.altCode=String(Math.floor(100000+Math.random()*900000));save();openSheet("altCode");toast("تم إرسال رمز بديل إلى بريدك ","ok")}
function showBackup(){if(!(S.backupCodes&&S.backupCodes.length))S.backupCodes=Array.from({length:10},()=>Math.random().toString(36).slice(2,8).toUpperCase());save();openSheet("backupCodes")}
function copyTxt(x){try{if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(x).then(()=>toast("نُسخ إلى الحافظة ","ok"),()=>toast(x,"info"));return}}catch(e){}toast(x,"info")}
function acceptReq(id){const x=(S.users||[]).find(y=>y.id===id);S.following.push(id);if(x)x.followers++;S.followReqs=(S.followReqs||[]).filter(r=>r.id!==id);save();closeOvl();render();toast("قبلت طلب "+(x?x.name:"")+" ","ok")}
function rejectReq(id){const x=(S.users||[]).find(y=>y.id===id);S.followReqs=(S.followReqs||[]).filter(r=>r.id!==id);save();closeOvl();render();toast("رفضت طلب "+(x?x.name:""),"info")}
function repAtt(kind){(S.repAtt=S.repAtt||[]);if(S.repAtt.includes(kind))S.repAtt=S.repAtt.filter(x=>x!==kind);else S.repAtt.push(kind);save();render();toast(S.repAtt.includes(kind)?"أُرفق: "+kind+" ":"أُزيل المرفق: "+kind,S.repAtt.includes(kind)?"ok":"info")}
function runBot(bid){const bot=(S.bots||[]).find(b=>b.id===bid)||{id:bid,name:"بوت",prefix:"!"};if(/توصيات|rec/i.test(bot.name+(bot.prefix||""))){const fav=(S.me.favs||[]);const recs=(S.wiki.anime||[]).filter(a=>!fav.includes(a.id)).slice(0,3);SHEETS.recBot=()=>sheet(I("bot","i s")+" توصيات "+esc(bot.name),`<div class="tiny fnt" style="margin-bottom:9px">اخترنا لك بناءً على ذوقك ومشاهداتك — نتائج حقيقية من مكتبتك:</div><div class="col">${recs.map(a=>`<button class="lstrow" onclick="closeOvl();go('animeDetail',{id:'${a.id}'})"><span class="ico-tile" style="background:linear-gradient(135deg,${a.c1||"#7F1D1D"},${a.c2||"#EA580C"});color:#fff">${I("star","i s")}</span><span class="g1 b xs" style="text-align:right">${esc(a.n)}<span class="tiny fnt" style="display:block">${esc(a.g||a.genre||"")}</span></span>${I("fwd","i s")}</button>`).join("")}</div>`);openSheet("recBot");toast("شغّل "+bot.name+" — ٣ توصيات ","ok")}else{toast(bot.name+" جاهز — أرسل "+(bot.prefix||"!")+" في أي قناة مجتمع ","ok")}}
function checkUpdates(){S.lastUpdateCheck=now();save();toast("فُحص الآن — أنت على أحدث إصدار (v18.0 إتقان الاستكشاف) ","ok")}
function iosInterest(){S.iosInterest=!S.iosInterest;save();render();toast(S.iosInterest?"سُجّل اهتمامك بنسخة iOS — سنشعرك عند الإطلاق ":"أُلغي تسجيل اهتمامك بـ iOS",S.iosInterest?"ok":"info")}
function adminSearch(){const inp=$("#admq");const q=((inp&&inp.value)||"").trim();if(!q){toast("اكتب اسم مستخدم أو بريداً للبحث","err");return}const hit=(S.users||[]).find(x=>(x.name||"").includes(q)||(x.handle||"").includes(q)||(x.email||"").toLowerCase().includes(q.toLowerCase()));if(hit){go("publicProfile",{id:hit.id});toast("وُجد: "+hit.name+" ","ok")}else{toast("لا نتائج مطابقة لـ «"+q+"»","err")}}
function applyCoverG(i){const c=COVERS[i];if(!c)return;S.me.cover=null;S.me.coverG=[c[0],c[1]];save();render();toast("غلاف «"+c[2]+"» مُطبّق ","ok")}
const COVERS=[["#7F1D1D","#EA580C","نار أكيهابارا"],["#1E1B4B","#6366F1","ليل نيون"],["#0F766E","#4ADE80","غابة سبيريت"],["#581C87","#D946EF","سوسانو بنفسجي"],["#0C4A6E","#38BDF8","محيط ون بيس"],["#111827","#F59E0B","ذهب الساموراي"]];
const DEVDOCS=[["دليل البدء السريع","1) ثبّت المفاتيح في بوابة المطورين (Firebase/Gemini).\n2) window.AnimeBlackAPI هو العقد الموحد:\n   API.auth.login(u,p) → {ok,uid}\n   API.db.get(key) / API.db.set(key,val)\n3) الوضع local يعمل بدون أي إعداد، وبمجرد حفظ مفتاح Firebase ينقلب mode() إلى cloud.\n4) كل الواجهات تقرأ من الحالة S وتحفظ عبر save() — لا تعدّل الواجهات عند الربط."],["مرجع REST API","GET  /api/posts?limit=20        → قائمة المنشورات\nPOST /api/posts {text,media}    → نشر\nGET  /api/users/:id             → ملف شخصي\nPOST /api/follow/:id            → متابعة\nGET  /api/anime?q=              → بحث الموسوعة\nPOST /api/chat/:id {body}       → رسالة\nكل النقاط معكوسة محلياً داخل API.db و API.ai عند عدم وجود سيرفر."],["WebSocket Events","event: message:new   {chatId,from,body,at}\nevent: presence      {userId,online}\nevent: notif         {type,title,body}\nevent: story:view    {storyId,viewerId}\nevent: live:comment  {roomId,from,text}\nالمحاكاة المحلية: البث المباشر والتواجد يعملان بمؤقتات داخلية بنفس شكل الأحداث."],["بناء بوتات المجتمع","أنشئ بوتاً من بوابة المطورين (اسم + بادئة).\nمثال بوت توصيات بالبادئة !rec:\n  onCommand('!rec', (ctx)=>{\n    const picks = recommend(ctx.user);\n    ctx.reply(picks.map(p=>p.name).join('، '));\n  });\nزر التشغيل في قائمة البوتات ينفّذ !rec فعلياً ويعرض ٣ توصيات من مكتبتك."],["Webhooks والإشعارات","POST https://your-hook/animeblack\n  {event:'post.new', payload:{...}}\nأنواع supported: post.new · comment.new · follow · report · ban.appeal · live.start\nالإشعارات داخل التطبيق: Notification.requestPermission() من صفحة الأذونات، والحالة تُقرأ مباشرة من المتصفح."]];
function permLabel(k){const pm=S.perms=S.perms||{};if(k==="notif"){if(typeof Notification==="undefined")return"غير مدعوم";return Notification.permission==="granted"?"ممنوح":Notification.permission==="denied"?"مرفوض":"لم يُطلب"}return pm[k]||"لم يُطلب"}
async function askPerm(k){const pm=S.perms=S.perms||{};try{
  if(k==="notif"){if(typeof Notification==="undefined"){toast("الإشعارات غير مدعومة في هذا المتصفح","err");return}const r=await Notification.requestPermission();pm.notif=r==="granted"?"ممنوح":r==="denied"?"مرفوض":"لم يُطلب";save();render();toast("إذن الإشعارات: "+pm.notif,r==="granted"?"ok":"err");if(r==="granted"){try{new Notification("أنمي بلاك",{body:"إشعار تجريبي حقيقي — الإذن يعمل"})}catch(e){}}return}
  if(k==="geo"){if(!navigator.geolocation){pm.geo="غير مدعوم";save();render();return toast("الموقع غير مدعوم","err")}toast("جارٍ طلب الموقع...","info");navigator.geolocation.getCurrentPosition(pos=>{pm.geo="ممنوح ("+pos.coords.latitude.toFixed(2)+", "+pos.coords.longitude.toFixed(2)+")";save();render();toast("تم الحصول على موقعك الحقيقي ","ok")},err=>{pm.geo="مرفوض";save();render();toast("تعذّر الموقع: "+err.message,"err")},{timeout:9000});return}
  if(k==="cam"||k==="mic"){if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){pm[k]="غير مدعوم";save();render();return toast("غير مدعوم في هذا السياق","err")}toast(k==="cam"?"جارٍ طلب الكاميرا...":"جارٍ طلب الميكروفون...","info");const st=await navigator.mediaDevices.getUserMedia(k==="cam"?{video:true}:{audio:true});st.getTracks().forEach(t=>t.stop());pm[k]="ممنوح (فحص حقيقي ناجح)";save();render();return toast((k==="cam"?"الكاميرا":"الميكروفون")+" تعمل فعلياً ","ok")}
  if(k==="clip"){if(!navigator.clipboard){pm.clip="غير مدعوم";save();render();return toast("الحافظة غير مدعومة هنا","err")}await navigator.clipboard.writeText("AnimeBlack "+Date.now());pm.clip="ممنوح (كتابة ناجحة)";save();render();return toast("اختبار الحافظة نجح — نُسخ نص تجريبي ","ok")}
  if(k==="vib"){if(!("vibrate" in navigator)){pm.vib="غير مدعوم";save();render();return toast("الاهتزاز غير مدعوم","err")}navigator.vibrate(70);pm.vib="ممنوح";save();render();return toast("اهتزازة اختبار أُرسلت ","ok")}
}catch(e){pm[k]="مرفوض ("+String(e.message||e).slice(0,40)+")";save();render();toast("فشل إذن "+k+": "+String(e.message||e).slice(0,60),"err")}}
PAGES.permissions=()=>{setNav(false);setHdr(backHdr("أذونات التطبيق","حقيقية — تُقرأ وتُطلب من المتصفح مباشرة"));
  const rows=[["إشعارات المتصفح","bell","notif","طلب الإذن وإرسال إشعار تجريبي"],["الموقع الجغرافي","map","geo","قراءة إحداثياتك الفعلية عند الموافقة"],["الكاميرا","camera","cam","فحص حقيقي عبر getUserMedia ثم إغلاقها"],["الميكروفون","mic","mic","فحص حقيقي ثم إغلاق التيار"],["الحافظة","copy","clip","كتابة نص تجريبي للتحقق"],["الاهتزاز","zap","vib","اهتزازة اختبار قصيرة"]];
  return `<div class="pad col">
    <div class="card" style="padding:13px"><div class="row" style="gap:10px"><span class="ico-tile" style="background:var(--grad-cyan);color:#fff">${I("shield","i s")}</span><div class="g1"><div class="b sm">لماذا صفحة أذونات؟</div><div class="tiny fnt" style="line-height:1.7">كل إذن هنا يُطلب من متصفحك فعلياً وتُعرض حالته الحقيقية (ممنوح/مرفوض/لم يُطلب). التخزين المحلي يعمل دائماً داخل ملف HTML الواحد.</div></div></div></div>
    ${rows.map(([l,ic,k,d])=>`<div class="card" style="padding:12px"><div class="rowb"><div class="row" style="gap:10px"><span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I(ic,"i s")}</span><div><div class="b xs">${l}</div><div class="tiny fnt">${d}</div></div></div><span class="badge ${permLabel(k)==="ممنوح"||permLabel(k).startsWith("ممنوح")?"b-emerald":permLabel(k)==="مرفوض"?"b-red":"b-gray"}">${esc(permLabel(k))}</span></div><button class="btn btn-sec btn-sm" style="margin-top:9px;width:100%" onclick="askPerm('${k}')">${I("key","i s")} ${permLabel(k)==="لم يُطلب"||permLabel(k)==="غير مدعوم"?"طلب الإذن":"اختبار الآن"}</button></div>`).join("")}
    <div class="card" style="padding:12px"><div class="rowb"><span class="b xs">${I("save","i s")} التخزين المحلي</span><span class="badge b-emerald mono">${(safeStr(S).length/1024).toFixed(1)} KB مستخدمة</span></div><div class="tiny fnt" style="margin-top:6px">بياناتك محفوظة في هذا المتصفح فقط — صدّرها من بوابة المطورين في أي وقت.</div></div>
  </div>`};

PAGES.tour=()=>{setNav(false);setHdr(backHdr("جولة سريعة","تعرّف على المنصة في دقيقة"));
  const steps=[["home","الرئيسية الذكية","خلاصة بتثبيت وكتم وفرز مخصص وشريط قصص",'tab("home")'],["explore","استكشف وبحث","٩ تبويبات بحث حي وسجل بحث محفوظ",'go("search")'],["chat","الرسائل","ملصقات مصممة، خلفيات، وسائط مشتركة وبحث داخل المحادثة",'tab("chat")'],["more","مركز المزيد","شريط الإدارة الأحمر واختصارات قابلة للتخصيص والحفظ",'tab("more")'],["economy","الاقتصاد","١١ إطاراً بينها إطارات الشخصيات، سوق وصناديق حظ",'go("economy")'],["admin","الإدارة الموحدة","٨ تبويبات: إشراف، مستخدمون، محتوى، استئنافات وحرس ذكي",'go("admin")']];
  return `<div class="pad col">${steps.map(([ic,l,d,fn],i)=>`<div class="card" style="padding:13px"><div class="row" style="gap:11px"><span class="ico-tile" style="width:44px;height:44px;border-radius:14px;background:var(--grad-fire);color:#fff">${I(ic,"l")}</span><div class="g1"><div class="b sm">${i+1}. ${l}</div><div class="tiny fnt" style="line-height:1.7">${d}</div></div><button class="btn btn-sec btn-xs" onclick="${fn.replace(/\"/g,'&quot;')}">فتح</button></div></div>`).join("")}
  <button class="btn btn-sec btn-sm" onclick="openSheet('shortcuts')">${I("terminal","i s")} اختصارات لوحة المفاتيح</button>
  <div class="center tiny fnt" style="padding:10px 0 4px">أنمي بلاك — ملف واحد، كل الميزات</div></div>`};
PAGES.devCenter=()=>{setNav(false);setHdr(backHdr("بوابة المطورين و SDK","مفاتيح API والبوتات"));
  return `<div class="pad col">
    <div class="card" style="padding:12px;margin-bottom:12px"><div class="rowb"><div><div class="b sm">محاكاة الشبكة</div><div class="tiny fnt">اختبر طابور عدم الاتصال — الرسائل والمنشورات تُحفظ وتُرسل تلقائياً</div></div>
    <button class="btn btn-sec btn-sm" onclick="S.forceOffline=!S.forceOffline;save();if(S.forceOffline){netbar(false);toast('وضع عدم الاتصال مفعّل','err')}else{flushOffQ()}">${I("wifi","i s")} ${S.forceOffline?"إعادة الاتصال":"قطع الاتصال"}</button></div></div>
    <div class="card" style="padding:12px;margin-bottom:12px"><div class="rowb"><div><div class="b sm">${I("key","i s")} مفاتيح السيرفر (Firebase / Gemini)</div><div class="tiny fnt">الوضع الحالي: <b class="mono">${API.mode()==="cloud"?"سحابي متصل":"محلي بدون سيرفر"}</b> — الصق المفاتيح لتفعيل الطبقة السحابية بدون تعديل الواجهات</div></div></div>
      <div class="col" style="margin-top:9px;gap:7px">
        <input class="inp mono" dir="ltr" id="kf" placeholder="Firebase config / API key" value="${esc((S.apiKeys&&S.apiKeys.firebase)||"")}" style="font-size:11px">
        <input class="inp mono" dir="ltr" id="kg" placeholder="Gemini API key" value="${esc((S.apiKeys&&S.apiKeys.gemini)||"")}" style="font-size:11px">
        <button class="btn btn-primary btn-sm" onclick="S.apiKeys={firebase:($('#kf').value||'').trim(),gemini:($('#kg').value||'').trim()};save();render();toast('حُفظت المفاتيح — الوضع: '+(API.mode()==='cloud'?'سحابي':'محلي'),'ok')">${I("save","i s")} حفظ المفاتيح</button></div></div>
    <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(6,182,212,.1),transparent)">
      <div class="row" style="gap:11px"><span class="ico-tile" style="width:46px;height:46px;border-radius:15px;background:var(--grad-cyan);color:#fff">${I("code","l")}</span>
        <div class="g1"><div class="bb">Developer Center</div><div class="tiny fnt mono">SDK v1.4 · REST + WebSocket</div></div></div>
      <div class="grid3" style="margin-top:11px">${[["key",(S.devKeys||[]).length,"مفتاح"],["bot",(S.bots||[]).length,"بوت"],["chart",nfmt(24800),"استدعاء/يوم"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="rowb"><div class="b sm">${I("key","i s")} مفاتيح API</div>
      <button class="btn btn-cyan btn-xs" onclick="genKey()">${I("plus","i s")} توليد مفتاح</button></div>
      <div class="col" style="margin-top:11px">${(S.devKeys||[]).length?S.devKeys.map((k,i)=>`
        <div class="card2" style="padding:10px"><div class="row" style="gap:8px">
          <span class="badge b-emerald">نشط</span>
          <span class="g1 mono tiny" style="overflow:hidden;text-overflow:ellipsis">${esc(k)}</span>
          <button class="iconbtn" style="width:26px;height:26px" onclick="copyTxt('${k}')">${I("copy","i s")}</button>
          <button class="iconbtn" style="width:26px;height:26px;color:var(--rose)" onclick="S.devKeys.splice(${i},1);save();render();toast('حُذف المفتاح','err')">${I("trash","i s")}</button></div>
          <div class="tiny fnt" style="margin-top:5px">آخر استخدام: ${ago(now()-rnd(1,200)*36e5)} · ${nfmt(rnd(100,9000))} استدعاء</div></div>`).join("")
        :`<div class="tiny fnt center" style="padding:12px">لا مفاتيح — ولّد مفتاحاً جديداً</div>`}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("bot","i s")} بوتات المجتمع</div>
      <div class="col" style="margin-top:11px">${S.bots.map((b,i)=>`<div class="lstrow" style="padding:9px">
        <span class="ico-tile" style="background:var(--grad-purple);color:#fff">${I("bot","i s")}</span>
        <div class="g1"><div class="b xs">${esc(b.name)}</div><div class="tiny fnt mono">البادئة: ${esc(b.prefix)} · متصل </div></div>
        <button class="btn btn-sec btn-xs" onclick="runBot('${b.id}')">${I("play","i s")}</button>
        <button class="btn btn-ghost btn-xs" onclick="S.bots.splice(${i},1);save();render();toast('حُذف البوت','err')">${I("trash","i s")}</button></div>`).join("")}</div>
      <div class="div"></div>
      <div class="grid2"><div><label class="lbl">اسم البوت</label><input class="inp" id="bn" placeholder="بوت التوصيات"></div>
        <div><label class="lbl">البادئة</label><input class="inp mono" id="bp" placeholder="!" value="!"></div></div>
      <button class="btn btn-purple btn-lg" style="margin-top:11px" onclick="createBot()">${I("plus","i s")} إنشاء بوت</button></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("file","i s")} الوثائق والـ SDK</div>
      <div class="col" style="margin-top:10px">${[["دليل البدء السريع","10 دقائق","book"],["مرجع REST API","32 نقطة","code"],["WebSocket Events","18 حدث","radio"],["بناء بوتات المجتمع","مثال كامل","bot"],["Webhooks والإشعارات","6 أنواع","bell"]].map(([t,d,ic],di)=>`
        <button class="lstrow" style="padding:9px" onclick="openSheet('devDoc',${di})"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:var(--surface3);color:var(--cyan)">${I(ic,"i s")}</span>
        <span class="g1" style="text-align:right"><span class="b tiny" style="display:block">${t}</span><span class="tiny fnt">${d}</span></span>${I("fwd","i s")}</button>`).join("")}</div>
      <div class="card2 mono tiny" style="padding:11px;margin-top:11px;background:#000;color:#4ADE80;overflow-x:auto" dir="ltr">
<pre style="margin:0;font-size:10px;line-height:1.7">import { AnimeBlack } from '@animeblack/sdk';

const ab = new AnimeBlack({ key: 'ab_live_key_...' });
const posts = await ab.posts.list({ limit: 10 });
ab.on('message', m => console.log(m.text));</pre></div></div>
    <div class="grid2"><button class="btn btn-cyan" onclick="toast('تم تنزيل SDK ','ok');snd('success')">${I("download","i s")} تنزيل SDK</button>
      <button class="btn btn-sec" onclick="openSheet('sysStatus')">${I("wifi","i s")} حالة النظام</button></div>
  </div>`;
};
function genKey(){const k="ab_live_key_"+Math.random().toString(36).substring(2,10).toUpperCase();S.devKeys.push(k);save();render();toast("تم توليد مفتاح جديد ","ok");celebrate("مفتاح API جديد: "+k)}
function createBot(){const n=($("#bn").value||"").trim();if(!n){toast("اكتب اسم البوت","err");return}
  S.bots.push({id:uid(),name:n,prefix:($("#bp").value||"!").trim()});save();render();celebrate("تم إنشاء البوت: "+n+" ")}
PAGES.hubSettings=()=>{setNav(false);setHdr(backHdr("إعدادات مركز التحكم العام","الحركة والألوان والأمان"));
  return `<div class="pad col">
    <div class="card" style="padding:14px"><div class="b sm">${I("zap","i s")} الحركة والأداء</div>
      <div class="col" style="margin-top:11px">
        ${[["motion","الحركات والانتقالات","تعطيلها يحسّن الأداء"],["motionLevel","مستوى الحركة","full"],["contrast","تباين عالٍ","ألوان أوضح"]].map(([k,l,d])=>`
        <div class="rowb"><div class="g1"><div class="b xs">${l}</div><div class="tiny fnt">${d}</div></div>
        ${k==="motionLevel"?`<div class="chiprow">${["full","متوسط","منخفض","بدون"].map(v=>`<button class="chip ${(S.motionLv||'full')===v?'on':''}" onclick="S.motionLv='${v}';save();render();go('hubSettings');toast('مستوى الحركة: ${v} (محفوظ) ','ok')">${v}</button>`).join("")}</div>`
        :`<span class="sw ${(k==='contrast'?S.contrast:S[k])?'on':''}" onclick="uiToggle('${k}',this)"></span>`}</div>`).join("")}</div></div>
    <div class="card" style="padding:14px;margin-bottom:12px"><div class="b sm">${I("pen","i s")} حجم الخط</div>
      <div class="chiprow" style="margin-top:10px">${[["صغير",0.92],["متوسط",1],["كبير",1.1]].map(([l,v])=>`<button class="chip ${(S.fontScale||1)===v?'on':''}" onclick="S.fontScale=${v};applyFontScale();save();render();toast('حجم الخط: ${l} ','ok')">${l}</button>`).join("")}</div>
      <div class="tiny fnt" style="margin-top:8px">يكبّر كل واجهات المنصة دفعة واحدة — مفيد لذوي البصر الضعيف</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("bell","i s")} الإشعارات</div>
      <div class="col" style="margin-top:11px">${[["إشعارات المنشورات","post"],["إشعارات الرسائل","msg"],["إشعارات البث المباشر","live"],["إشعارات المهام والمكافآت","quest"],["إشعارات المتابعين","follow"],["ملخص أسبوعي بالبريد","week"]].map(([l,k])=>`
        <div class="rowb"><span class="xs b">${l}</span><span class="sw ${(S.notifPrefs||{})[k]?'on':''}" onclick="togNotif('${k}',this)"></span></div>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("volume","i s")} الصوت والاهتزاز</div>
      <div class="col" style="margin-top:11px">
        ${[["sound","أصوات الواجهة","نغمات الضغط والنجاح"],["haptic","الاهتزاز (Haptic)","استجابة لمسية عند الضغط"],["hapticToast","إظهار تنبيه اللمس","فقاعة أسفل الشاشة"]].map(([k,l,d])=>`
        <div class="rowb"><div class="g1"><div class="b xs">${l}</div><div class="tiny fnt">${d}</div></div><span class="sw ${S[k]?'on':''}" onclick="uiToggle('${k}',this)"></span></div>`).join("")}
        <div class="row" style="gap:9px"><span class="xs b g1">مستوى الصوت</span><input type="range" min="0" max="100" value="${S.vol||70}" style="width:120px" oninput="S.vol=this.value;saveDebounced()"></div></div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("cloud","i s")} البيانات والتخزين</div>
      <div class="col" style="margin-top:11px">
        <div class="rowb"><span class="xs b">وقت الجلسة الحالية</span><span class="badge b-gray mono">${Math.floor((S.sessionSec||0)/60)} د</span></div>
        <div class="rowb"><span class="xs b">الكاش المحلي</span><span class="badge b-gray mono">~ ${(safeStr(S).length/1024).toFixed(0)} KB</span></div>
        <div class="rowb"><span class="xs b">وضع عدم الاتصال (يحفظ ويرسل لاحقاً)</span><span class="sw ${S.forceOffline?'on':''}" onclick="toggleForceOffline()"></span></div>
        <div class="rowb"><span class="xs b">لغة الواجهة</span><button class="btn btn-sec btn-xs" onclick="toggleLang()">${I("globe","i s")} ${S.langEn?"English — اضغط للعربية":"العربية — اضغط for English"}</button></div>
        <div class="grid2" style="margin-top:9px"><button class="btn btn-sec btn-sm" onclick="save();toast('تمت المزامنة ','ok')">${I("refresh","i s")} مزامنة</button>
          <button class="btn btn-sec btn-sm" onclick="downloadData()">${I("download","i s")} تصدير</button></div></div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("info","i s")} حول التطبيق</div>
      <div class="col" style="margin-top:10px">${[["الإصدار","1.0.4 (Build 214)"],["المنصة","React 19 + Firebase + Gemini"],["الترخيص","استخدام شخصي"],["المستودع","github.com/mrmo515ed/Black-_anime"]].map(([k,v])=>`
        <div class="rowb"><span class="tiny fnt">${k}</span><span class="xs b mono">${v}</span></div>`).join("")}</div>
      <div class="grid2" style="margin-top:11px"><button class="btn btn-sec btn-sm" onclick="checkUpdates()">${I("refresh","i s")} تحقق من التحديثات</button>
        <button class="btn btn-sec btn-sm" onclick="go('downloadApp')">${I("download","i s")} صفحة التحميل</button></div></div>
    <div class="grid2">
      <button class="btn btn-primary" onclick="go('appearance')">${I("palette","i s")} المظهر</button>
      <button class="btn btn-sec" onclick="go('security')">${I("shield","i s")} الأمان</button>
      <button class="btn btn-sec" onclick="go('privacySettings')">${I("lock","i s")} الخصوصية</button>
      <button class="btn btn-danger" onclick="reset()">${I("refresh","i s")} إعادة تعيين كل البيانات</button></div>
    <button class="btn btn-ghost" onclick="logout()">${I("logout","i s")} تسجيل الخروج</button>
  </div>`;
};
function logout(){
  if(window.auth && window.signOut){
    try{ window.signOut(window.auth); }catch(e){}
  }
  S.user=null;
  S.activeChat=null;
  save();
  go("login",{},false);
  toast("تم تسجيل الخروج بنجاح","info");
}
PAGES.downloadApp=()=>{setNav(false);setHdr(backHdr("تحميل التطبيق","Android APK · PWA · iOS"));
  return `<div class="pad col">
    <div class="card center" style="padding:22px;background:linear-gradient(135deg,rgba(34,211,238,.13),rgba(168,85,247,.07))">
      <img class="logoimg" src="data:image/jpeg;base64," alt="أنمي بلاك" style="width:86px;height:86px;border-radius:26px;margin:0 auto;box-shadow:0 10px 34px rgba(34,211,238,.45)">
      <div class="bb" style="font-size:19px;margin-top:12px">Anime Black</div>
      <div class="tiny fnt">الإصدار 1.0.4 · 27.3 MB · يتطلب Android 6.0+</div>
      <div class="row" style="gap:5px;justify-content:center;margin-top:9px"><span class="badge b-gold"> 4.8</span><span class="badge b-emerald">آمن </span><span class="badge b-cyan">موقّع</span><span class="badge b-gray mono">v1.0.4</span></div>
      ${S.dlProgress!=null?`<div style="margin-top:15px"><div class="bar"><i id="dlbar" style="width:${S.dlProgress}%"></i></div>
        <div class="tiny b mono" style="margin-top:6px">جارٍ التحميل... ${S.dlProgress}%</div></div>`:`
      <button class="btn btn-primary btn-lg" style="margin-top:15px" onclick="startDL()">${I("download","i s")} تحميل APK الآن</button>`}
    </div>
    <div class="grid3">
      ${[["phone","Android","APK أصلي"],["cloud","PWA","تثبيت فوري"],["apple","iOS","متوفر الآن"]].map(([ic,l,d])=>`
        <button class="card2 center" style="padding:15px 6px" onclick="${l==='iOS'?`openSheet('iosInfo')`:l==='PWA'?`openSheet('pwaSheet')`:`startDL()`}">
          <span style="color:var(--accent);display:flex;justify-content:center">${I(ic,"l")}</span>
          <span class="b tiny" style="display:block;margin-top:7px">${l}</span><span class="tiny fnt">${d}</span></button>`).join("")}
    </div>
    <div class="card" style="padding:14px"><div class="b sm">${I("sparkles","i s")} ما الجديد في 1.0.4</div>
      <ul class="xs mut" style="margin:9px 18px 0"><li>نظام النقابات والمهام الأسبوعية</li><li>بث مباشر صوتي ومرئي</li><li>متجر الاقتصاد والإطارات الحية</li><li>تحسين أداء الخلاصة بنسبة ٤٠٪</li><li>إصلاح تسجيل الدخول بـ Google</li></ul></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("shield","i s")} متطلبات الأذونات</div>
      <div class="col" style="margin-top:10px">${[["camera","الكاميرا","للبث المباشر والصور"],["mic","الميكروفون","للغرف الصوتية والرسائل الصوتية"],["bell","الإشعارات","لتنبيهات الرسائل"],["db","التخزين","للعمل دون اتصال"]].map(([ic,l,d])=>`
        <div class="row" style="gap:9px"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:var(--surface3);color:var(--accent)">${I(ic,"i s")}</span>
        <div class="g1"><div class="b tiny">${l}</div><div class="tiny fnt">${d}</div></div><span class="badge b-emerald">مطلوب</span></div>`).join("")}</div></div>
    <div class="card2 center" style="padding:13px"><div class="tiny b">امسح الرمز للتحميل على جوالك</div><div class="qr" style="margin:11px auto"></div>
      <div class="mono tiny fnt">animeblack.app/download</div></div>
  </div>`;
};
function startDL(){
  S.dlProgress=0;render();snd("tap");
  const t=setInterval(()=>{
    S.dlProgress=Math.min(100,S.dlProgress+rnd(4,14));
    const b=$("#dlbar");if(b){b.style.width=S.dlProgress+"%";b.parentNode.nextElementSibling.textContent="جارٍ التحميل... "+S.dlProgress+"%"}
    if(S.dlProgress>=100){clearInterval(t);setTimeout(()=>{S.dlProgress=null;save();celebrate("اكتمل التحميل! ثبّت APK الآن ")},400)}
  },220);
}
PAGES.homeCustomizer=()=>{setNav(false);setHdr(backHdr("تخصيص الصفحة الرئيسية","ترتيب الأقسام والودجات",`<button class="btn btn-primary btn-sm" onclick="saveLayout()">${I("save","i s")} حفظ</button>`));
  S.homeHidden=S.homeHidden||[];
  const IC={stories:"clock",posts:"msgsq",reels:"clapper",news:"sparkles",modbar:"shield",evstrip:"calendar",worlds:"globe",continue:"play"};
  const row=(k,i,vis)=>`<div class="row" style="gap:9px;padding:9px;background:var(--surface2);border-radius:12px">
      ${vis?`<span class="col" style="gap:2px"><button class="iconbtn" style="width:22px;height:18px;border-radius:6px" onclick="moveSec(${i},-1)">${I("chevup","i s")}</button><button class="iconbtn" style="width:22px;height:18px;border-radius:6px" onclick="moveSec(${i},1)">${I("chevdown","i s")}</button></span>`:`<span style="width:22px"></span>`}
      <span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:var(--surface3);color:var(--accent)">${I(IC[k]||"layers","i s")}</span>
      <span class="g1 b xs">${SECLBL[k]||k}</span>
      <span class="sw ${vis?"on":""}" onclick="toggleSec('${k}',this)"></span></div>`;
  const wids=[["clock","الساعة","clock"],["coins","الرصيد","coins"],["quests","المهام اليومية","target"],["stats","الإحصائيات","barchart"],["trend","الرائج","trend"],["events","الفعاليات","calendar"]];
  return `<div class="pad col">
    <div class="card" style="padding:13px"><div class="b sm">${I("layers","i s")} أقسام الرئيسية (بالترتيب)</div>
      <div class="tiny fnt">اسحب الترتيب بالأسهم وأظهر/أخفِ بالمفتاح — يُطبق فوراً</div>
      <div class="col" style="margin-top:11px">${S.sections.home.map((k,i)=>row(k,i,true)).join("")}${S.homeHidden.map(k=>row(k,-1,false)).join("")}</div></div>
    <div class="card" style="padding:13px"><div class="b sm">${I("grid","i s")} الودجات</div>
      <div class="grid2" style="margin-top:11px">${wids.map(([k,l,ic])=>`<button class="card2 center" style="padding:13px 6px;border-color:${S.sections.widgets.includes(k)?"var(--accent)":"var(--line2)"}" onclick="toggleWidget('${k}')">
        <span style="color:${S.sections.widgets.includes(k)?"var(--accent)":"var(--muted)"};display:flex;justify-content:center">${I(ic,"i l")}</span>
        <span class="tiny b" style="display:block;margin-top:6px">${l}</span>
        ${S.sections.widgets.includes(k)?'<span class="badge b-emerald" style="margin-top:4px">مفعّل</span>':'<span class="badge b-gray" style="margin-top:4px">معطّل</span>'}</button>`).join("")}</div></div>
    <div class="card" style="padding:13px"><div class="b sm">${I("max","i s")} حجم البطاقة ونمط العرض</div>
      <div class="lbl" style="margin-top:10px">الحجم</div>
      <div class="chiprow">${[["sm","صغيرة"],["md","متوسطة"],["lg","كبيرة"]].map(([k,l])=>`<button class="chip ${S.cardSize===k?"on":""}" onclick="S.cardSize='${k}';save();render();toast('الحجم: ${l}','ok')">${l}</button>`).join("")}</div>
      <div class="lbl">النمط</div>
      <div class="chiprow">${[["grid","بطاقات","grid"],["list","قراءة مريحة","list"],["compact","مضغوط","layers"]].map(([k,l,ic])=>`<button class="chip ${S.viewType===k?"on":""}" onclick="S.viewType='${k}';save();render();toast('النمط: ${l}','ok')">${I(ic,"i s")} ${l}</button>`).join("")}</div></div>
    <div class="grid2"><button class="btn btn-primary" onclick="saveLayout()">${I("save","i s")} حفظ التخطيط</button>
      <button class="btn btn-ghost" onclick="S.sections.home=['stories','modbar','evstrip','posts','reels','news','worlds','continue'];S.homeHidden=[];S.sections.widgets=['clock','coins','quests','stats'];S.cardSize='md';S.viewType='grid';save();render();toast('أُعيد التخطيط الافتراضي','info')">${I("refresh","i s")} افتراضي</button></div>
  </div>`;
};
function toggleSec(k,el){S.homeHidden=S.homeHidden||[];const h=S.sections.home;const L=SECLBL[k]||k;
  if(h.includes(k)){S.sections.home=h.filter(x=>x!==k);if(!S.homeHidden.includes(k))S.homeHidden.push(k)}else{S.homeHidden=S.homeHidden.filter(x=>x!==k);S.sections.home.push(k)}
  save();render();snd("tap");toast((S.sections.home.includes(k)?"يظهر الآن: ":"أُخفي: ")+L,"info")}
function toggleWidget(k){const w=S.sections.widgets;const L=WIDLBL[k]||k;if(w.includes(k))S.sections.widgets=w.filter(x=>x!==k);else w.push(k);save();render();snd("tap");toast((S.sections.widgets.includes(k)?"ودجت مفعّل: ":"ودجت معطّل: ")+L,"info")}
function moveSec(i,d){const arr=S.sections.home;const j=i+d;if(j<0||j>=arr.length)return;[arr[i],arr[j]]=[arr[j],arr[i]];save();render();snd("tap")}
function saveLayout(){save();toast("تم حفظ تخطيط الرئيسية ","ok");snd("success");setTimeout(()=>go("home"),500)}
const SECLBL={stories:"القصص",posts:"المنشورات",reels:"الريلز",news:"الأخبار",modbar:"شريط المشرف",evstrip:"فعاليات نشطة",worlds:"عوالم الأنمي",continue:"واصل المشاهدة"};
const WIDLBL={clock:"الساعة",coins:"الرصيد",quests:"المهام اليومية",stats:"الإحصائيات",trend:"الرائج",events:"الفعاليات"};
const CATS8=["أكشن","مغامرة","خيال","دراما","كوميدي","رعب","رياضة","موسيقى"];
PAGES.report=()=>{setNav(false);const x=S.params.id==="live"?null:u(S.params.id||'bot');
  setHdr(backHdr("الإبلاغ عن مخالفة",x?"@"+x.username:"محتوى البث"));
  return `<div class="pad col">
    ${x?`<div class="lstrow">${av(x,44)}<div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(x.name)}</span>${vbadge(x)}</div><div class="tiny fnt mono">@${esc(x.username)}</div></div></div>`:""}
    <div class="card" style="padding:14px"><div class="b sm">${I("flag","i s")} سبب الإبلاغ</div>
      <div class="col" style="margin-top:11px">${[["spam","رسائل مزعجة / إعلانات","b-rose"],["harassment","تنمّر أو مضايقة","b-red"],["content","محتوى مخالف (عنفي/إباحي)","b-gold"],["hate","خطاب كراهية","b-red"],["fake","حساب مزيف / انتحال","b-purple"],["scam","احتيال أو نصب","b-rose"],["other","سبب آخر","b-gray"]].map(([k,l,c],i)=>`
        <button class="lstrow" style="padding:10px" onclick="S.reportReason='${k}';$$('#rlist .lstrow').forEach(x=>x.style.borderColor='var(--line)');this.style.borderColor='var(--accent)';toast('السبب: ${l}','info');snd('tap')">
          <span class="badge ${c}">${i+1}</span><span class="g1 b xs" style="text-align:right">${l}</span><span class="tiny fnt">${I("chevdown","i s")}</span></button>`).join("")}</div>
      </div>
    <div class="card" style="padding:14px"><label class="lbl">تفاصيل إضافية (اختياري)</label><textarea class="inp" rows="3" placeholder="اشرح ما حدث بالتفصيل..."></textarea>
      <div class="lbl" style="margin-top:11px">إرفاق دليل</div>
      <div class="grid2"><button class="btn ${(S.repAtt||[]).includes('لقطة شاشة')?'btn-primary':'btn-sec'} btn-sm" onclick="repAtt('لقطة شاشة')">${I("image","i s")} لقطة شاشة${(S.repAtt||[]).includes('لقطة شاشة')?" (مُرفقة)":""}</button>
        <button class="btn ${(S.repAtt||[]).includes('مقطع')?'btn-primary':'btn-sec'} btn-sm" onclick="repAtt('مقطع')">${I("video","i s")} مقطع${(S.repAtt||[]).includes('مقطع')?" (مُرفق)":""}</button></div>${(S.repAtt||[]).length?`<div class="tiny fnt" style="margin-top:8px">المرفقات: ${S.repAtt.map(esc).join("، ")}</div>`:""}</div>
    <button class="rowb card2" style="padding:12px;width:100%" onclick="this.querySelector('.sw').classList.toggle('on');toast(this.querySelector('.sw').classList.contains('on')?'لن يرى المُبلَّغ أنك أبلغت':'بلاغ مجهول','info')"><span class="row b xs">${I("eyeoff","i s")} إبلاغ مجهول</span><span class="sw on"></span></button>
    <button class="btn btn-danger btn-lg" onclick="submitReport()">${I("send","i s")} إرسال البلاغ</button>
    ${x?`<div class="grid2"><button class="btn btn-sec" onclick="blockUser('${x.id}');back()">${I("ban","i s")} حظر</button>
      <button class="btn btn-ghost" onclick="back()">إلغاء</button></div>`:`<button class="btn btn-ghost" onclick="back()">إلغاء</button>`}
  </div>`;
};
function submitReport(){
  if(!S.reportReason){toast("اختر سبب الإبلاغ أولاً","err");snd("error");return}
  const labels={spam:"رسائل مزعجة",harassment:"تنمّر",content:"محتوى مخالف",hate:"خطاب كراهية",fake:"حساب مزيف",scam:"احتيال",other:"أخرى"};
  S.adminReports.unshift({id:"rp"+uid(),by:S.me,target:S.params.id!=="live"?u(S.params.id):null,reason:S.reportReason,detail:"بلاغ من "+S.me.name+" — "+labels[S.reportReason],at:now(),status:"pending",sev:"medium"});
  S.reportReason=null;save();celebrate("شكراً! استلمنا بلاغك وسنراجعه خلال ٢٤ ساعة ");
  setTimeout(()=>go("home"),900);
}

/* ============================================================
   23) النوافذ المنبثقة: أوراق سفلية + نوافذ وسطية
   ============================================================ */
const SHEETS={};
SHEETS.notifications=()=>{closeOvl();go('notifications');};
/* ===== v4: نوافذ جديدة — تُعرّف بعد const SHEETS={} مباشرة ===== */
SHEETS.avatarSrcSheet=()=>sheet(I("user","i s")+" صورة الحساب",`
  <div class="tiny fnt" style="margin-bottom:11px">اختر مصدر الصورة</div>
  <div class="grid2" style="gap:10px">
    <button class="card2 col center" style="gap:9px;padding:20px 10px" onclick="avatarFromGallery()">
      <span class="ico-tile" style="width:52px;height:52px;border-radius:17px;background:var(--grad-cyan);color:#fff">${I("image","l")}</span>
      <span class="b sm">من المعرض</span><span class="tiny mut">اختر صورة محفوظة</span></button>
    <button class="card2 col center" style="gap:9px;padding:20px 10px" onclick="avatarFromCamera()">
      <span class="ico-tile" style="width:52px;height:52px;border-radius:17px;background:var(--grad-fire);color:#fff">${I("camera","l")}</span>
      <span class="b sm">الكاميرا</span><span class="tiny mut">التقط صورة الآن</span></button>
  </div>
  ${S.me.avatar?`<button class="btn btn-ghost" style="width:100%;margin-top:11px" onclick="closeOvl();S.me.avatar=\'\';save();render();toast(\'أُزيلت صورة الحساب\',\'info\')">${I("trash","i s")} إزالة الصورة الحالية</button>`:""}`);
SHEETS.stkEditSheet=()=>{
  const k=window.__stk||"poll";
  const META={poll:["barchart","استطلاع"],ask:["help","صندوق سؤال"],count:["clock","عدّاد تنازلي"],
              loc:["map","موقع"],music:["music","موسيقى"],tag:["at","إشارة لصديق"]}[k]||["barchart","ملصق"];
  let body="";
  if(k==="poll") body=`
    <div class="lbl">سؤال الاستطلاع</div>
    <input class="inp" id="stk_q" placeholder="اكتب سؤالك هنا..." maxlength="90" autofocus>
    <div class="lbl" style="margin-top:11px">الخيارات (٢ إلى ٤)</div>
    <input class="inp" id="stk_o1" placeholder="الخيار الأول" maxlength="40" style="margin-bottom:7px">
    <input class="inp" id="stk_o2" placeholder="الخيار الثاني" maxlength="40" style="margin-bottom:7px">
    <input class="inp" id="stk_o3" placeholder="الخيار الثالث (اختياري)" maxlength="40" style="margin-bottom:7px">
    <input class="inp" id="stk_o4" placeholder="الخيار الرابع (اختياري)" maxlength="40">`;
  else if(k==="ask") body=`
    <div class="lbl">نص صندوق السؤال</div>
    <input class="inp" id="stk_q" placeholder="مثال: اسألني أي شيء" maxlength="90" autofocus>
    <div class="tiny fnt" style="margin-top:7px">سيتمكن متابعوك من إرسال أسئلة تصلك خاصاً</div>`;
  else if(k==="count") body=`
    <div class="lbl">عنوان العدّاد</div>
    <input class="inp" id="stk_q" placeholder="مثال: موعد الحلقة القادمة" maxlength="70" autofocus>
    <div class="lbl" style="margin-top:11px">التاريخ والوقت</div>
    <input class="inp" id="stk_date" type="datetime-local">`;
  else if(k==="loc") body=`
    <div class="lbl">اسم الموقع</div>
    <input class="inp" id="stk_q" placeholder="اكتب اسم المكان" maxlength="60" autofocus>`;
  else if(k==="music") body=`
    <div class="lbl">اسم المقطع الموسيقي</div>
    <input class="inp" id="stk_q" placeholder="مثال: اسم الأغنية — الأنمي" maxlength="70" autofocus>`;
  else if(k==="tag") body=`
    <div class="lbl">اسم المستخدم</div>
    <input class="inp" id="stk_q" placeholder="@username" maxlength="40" autofocus>`;
  return sheet(I(META[0],"i s")+" "+META[1], `<div class="col">${body}
    <button class="btn btn-primary" style="width:100%;margin-top:14px" onclick="stkCommit()">${I("check","i s")} إضافة إلى القصة</button>
    <div class="tiny fnt center" style="margin-top:7px">أنت من يكتب المحتوى — لا شيء جاهز مسبقاً</div></div>`);
};

SHEETS.emojiInsert=()=>sheet(I("sparkles","i s")+" إدراج رمز مصمم",`<div class="tiny mut" style="margin-bottom:9px">رموز SVG أصلية تُدرج مضمّنة داخل نص المنشور — بلا إيموجي</div><div style="display:grid;grid-template-columns:repeat(6,1fr);gap:6px">${STICKERS.map(([ic,l,cl])=>`<button class="card2 center" style="padding:8px 2px;line-height:0" title="${l}" onclick="insToken('${ic}')"><span style="color:${cl};line-height:0;display:flex">${IC(ic,"xl")}</span></button>`).join("")}</div>`);
SHEETS.mentionSheet=()=>sheet(I("at","i s")+" ذكر شخص",`<div class="col">${(S.users||[]).slice(0,8).map(x=>`<button class="lstrow" style="padding:9px" onclick="insMention('${x.username}')">${av(x,34)}<span class="g1 b xs" style="text-align:right">${esc(x.name)} <span class="tiny fnt">@${esc(x.username)}</span></span><span style="color:var(--accent)">${I("at","i s")}</span></button>`).join("")}</div>`);
SHEETS.viewsSheet=(sid)=>{const st=(S.stories||[]).find(x=>x.id===sid);const vs=(st&&st.views)||[];
  const rx=(S.storyReactions&&S.storyReactions[sid])||[];
  return sheet(I("eye","i s")+" مشاهدات القصة ("+vs.length+")",`<div class="col">${vs.length?vs.map(v=>`<div class="rowb" style="padding:8px 2px;border-bottom:1px solid var(--line)"><div class="row" style="gap:9px">${av(v.u?u(v.u):{name:"?",avatar:""},34,true)}<div><div class="b xs">${esc(v.u?u(v.u).name:"مشاهد")}</div><div class="tiny fnt">${ago(v.at||now())}</div></div></div></div>`).join(""):`<div class="tiny fnt center" style="padding:12px">لا مشاهدات بعد</div>`}
  ${rx.length?`<div class="b xs" style="margin-top:11px">التفاعلات (${rx.length})</div><div class="row wrap" style="gap:6px;margin-top:7px">${Object.entries(rx.reduce((a,r)=>{a[r.ic]=(a[r.ic]||0)+1;return a},{})).map(([ic,n])=>`<span class="badge b-gray">${I(ic,"i s")} ${n}</span>`).join("")}</div>`:""}</div>`)};
SHEETS.resultsSheet=(sid)=>{const st=(S.stories||[]).find(x=>x.id===sid);if(!st)return sheet(I("barchart","i s")+" النتائج","<div class='tiny fnt'>القصة غير موجودة</div>");
  const rows=[];st.items.forEach(it=>{(it.stickers||[]).forEach(sk=>{
    if(sk.t==="poll"){const tot=(sk.votes||[]).reduce((a,b)=>a+b,0)||0;rows.push(`<div class="card2" style="padding:11px"><div class="b xs">${esc(sk.q)}</div>${(sk.opts||[]).map((o,oi)=>{const pc=tot?Math.round(100*(sk.votes[oi]||0)/tot):0;return `<div style="margin-top:8px"><div class="rowb tiny"><span>${esc(o)}</span><b class="mono">${pc}% (${sk.votes[oi]||0})</b></div><div style="height:6px;background:var(--surface3);border-radius:99px;margin-top:3px"><i style="display:block;height:100%;width:${pc}%;background:var(--grad-fire);border-radius:99px"></i></div></div>`}).join("")}<div class="tiny fnt" style="margin-top:7px">إجمالي الأصوات: ${tot}</div></div>`)}
    else if(sk.t==="ask"){rows.push(`<div class="card2" style="padding:11px"><div class="b xs">${esc(sk.q)}</div>${(sk.answers||[]).length?`<div class="col" style="margin-top:7px;gap:5px">${(sk.answers||[]).map(a2=>`<div class="tiny fnt" style="background:var(--surface3);border-radius:9px;padding:6px 9px">${esc(a2)}</div>`).join("")}</div>`:`<div class="tiny fnt" style="margin-top:6px">لا إجابات بعد</div>`}</div>`)}
    else if(sk.t==="count"){const ms=Math.max(0,(sk.target||0)-Date.now());rows.push(`<div class="card2 center" style="padding:11px"><div class="tiny fnt">${esc(sk.label||"عدّاد")}</div><div class="bb mono" style="margin-top:4px">${Math.floor(ms/864e5)} يوم ${Math.floor(ms%864e5/36e5)} ساعة</div></div>`)}
  })});
  return sheet(I("barchart","i s")+" نتائج الملصقات",`<div class="col">${rows.length?rows.join(""):`<div class="tiny fnt center" style="padding:12px">لا ملصقات تفاعلية في هذه القصة</div>`}</div>`)};

function openSheet(name,arg){
  if(!SHEETS[name]){toast("نافذة غير موجودة: "+name,"err");return}
  $("#ovl").innerHTML=SHEETS[name](arg);snd("tap");
}
function sheet(title,body,cls=""){return `<div class="ov glass" onclick="if(event.target===this)closeOvl()"><div class="sheet ${cls}" onclick="event.stopPropagation()"><div class="grab"></div>
  <div class="rowb" style="margin-bottom:11px"><div class="bb" style="font-size:14px">${title}</div><button class="iconbtn" onclick="closeOvl()">${I("x","i s")}</button></div>
  <div style="overflow-y:auto;flex:1" class="no-sb">${body}</div></div></div>`}
function modal(title,body,cls=""){return `<div class="ov glass" onclick="if(event.target===this)closeOvl()"><div class="modal ${cls}" onclick="event.stopPropagation()">
  <div class="rowb" style="padding:13px 15px;border-bottom:1px solid var(--line);flex-shrink:0"><div class="bb" style="font-size:14px">${title}</div><button class="iconbtn" onclick="closeOvl()">${I("x","i s")}</button></div>
  <div style="overflow-y:auto;flex:1;padding:15px" class="no-sb">${body}</div></div></div>`}

SHEETS.settingsSheet=()=>sheet(I("settings","i s")+" الإعدادات السريعة",`
  <div class="grid2" style="gap:9px">
    ${[["sun","المظهر","appearance"],["shield","الأمان","security"],["lock","الخصوصية","privacySettings"],["bell","الإشعارات","hubSettings"],
       ["globe","اللغة",null],["palette","الألوان","appearance"],["info","حول التطبيق","hubSettings"],["help","المساعدة",null]].map(([ic,l,p])=>`
      <button class="card2 center" style="padding:14px 6px" onclick="${p?`closeOvl();go('${p}')`:`closeOvl();toast('${l}','info')`}">
        <span style="color:var(--accent);display:flex;justify-content:center">${I(ic,"l")}</span>
        <span class="tiny b" style="display:block;margin-top:6px">${l}</span></button>`).join("")}
  </div>
  <div class="div"></div>
  <div class="col">
    ${[["moon","الوضع الليلي",()=>`setTheme(S.theme==='dark'?'light':'dark')`,"sw "+(S.theme==="dark"?"on":"")],
       ["volume","الأصوات",null,"sw "+(S.sound?"on":""),"'sound'"],
       ["phone","الاهتزاز",null,"sw "+(S.haptic?"on":""),"'haptic'"],
       ["cloud","وضع عدم الاتصال",null,"sw on"]].map(([ic,l,fn,swc,k])=>`
      <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px">
        <div class="row" style="gap:9px"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="xs b">${l}</span></div>
        <span class="${swc}" onclick="${fn?fn():`uiToggle(${k},this)`}"></span></div>`).join("")}
  </div>
  <div class="div"></div>
  <div class="col">
    <button class="lstrow" onclick="closeOvl();go('permissions')"><span class="ico-tile" style="background:var(--grad-gold);color:#fff">${I("shield","i s")}</span><span class="g1 b xs" style="text-align:right">أذونات التطبيق</span>${I("fwd","i s")}</button>
    <button class="lstrow" onclick="closeOvl();go('tour')"><span class="ico-tile" style="background:var(--grad-cyan);color:#fff">${I("help","i s")}</span><span class="g1 b xs" style="text-align:right">جولة سريعة بالمنصة</span>${I("fwd","i s")}</button>
    <button class="lstrow" onclick="closeOvl();go('qrCard')"><span class="ico-tile" style="background:var(--grad-fire);color:#fff">${I("qr","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">بطاقتي الرقمية</span><span class="tiny fnt" style="display:block">امسح وأضف أصدقاء</span></span>${I("fwd","i s")}</button>
    <button class="lstrow" onclick="closeOvl();go('downloadApp')"><span class="ico-tile" style="background:var(--grad-emerald);color:#fff">${I("download","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">تحميل التطبيق</span><span class="tiny fnt" style="display:block">APK و PWA</span></span>${I("fwd","i s")}</button>
    
    <button class="lstrow" onclick="closeOvl();go('devCenter')"><span class="ico-tile" style="background:var(--grad-cyan);color:#fff">${I("code","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">بوابة المطورين</span><span class="tiny fnt" style="display:block">API و Bots</span></span>${I("fwd","i s")}</button>
    <button class="lstrow" onclick="closeOvl();reset()"><span class="ico-tile" style="background:var(--surface3);color:var(--rose)">${I("refresh","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">إعادة تعيين البيانات</span><span class="tiny fnt" style="display:block">يرجع كل شيء للأصل</span></span></button>
    <button class="lstrow" onclick="logout();closeOvl()"><span class="ico-tile" style="background:rgba(244,63,94,.15);color:var(--rose)">${I("logout","i s")}</span><span class="g1" style="text-align:right"><span class="b xs" style="color:var(--rose)">تسجيل الخروج</span></span></button>
  </div>`);

SHEETS.postMenu=(pid)=>{
  const p=(S.posts||[]).find(x=>x.id===pid);const mine=p&&p.authorId==="me";
  return sheet(I("more","i s")+" خيارات المنشور",`<div class="col">
    ${[["eye","عرض المنشور",`closeOvl();go('postView',{pid:'${pid}'})`],
       ["msgsq","التعليقات ("+(p?(p.comments||[]).length:0)+")",`closeOvl();openComments('${pid}')`],
       ["bookmark",p&&p.saved?"إزالة من المحفوظات":"حفظ المنشور",`closeOvl();toggleSave('${pid}')`],
       ["link","نسخ رابط المنشور",`copyTxt('animeblack.app/post/${pid}');closeOvl()`],
       ["pin",p&&p.pinned?"إلغاء تثبيت المنشور":"تثبيت في الأعلى",`closeOvl();togglePostPin('${pid}')`],
       ["bell",p&&p.notify?"إيقاف تنبيهات المنشور":"تفعيل تنبيهات المنشور",`closeOvl();togglePostNotify('${pid}')`],
       ["heart","من أعجب بالمنشور",`closeOvl();openSheet('whoLiked','${pid}')`],
       ["eyeoff","إخفاء المنشور من خلاصتي",`closeOvl();hidePost('${pid}')`],
       ["ban","إخفاء كل منشورات هذا المستخدم",`S.mutedUsers=S.mutedUsers||[];if(!S.mutedUsers.includes('${p?p.authorId:""}'))S.mutedUsers.push('${p?p.authorId:""}');save();closeOvl();render();toast('لن ترى منشورات هذا المستخدم في خلاصتك ','info')`],
       ["flag","الإبلاغ عن المنشور",`closeOvl();S.reportReason=null;go('report',{id:'${p?p.authorId:''}'})`]].map(([ic,l,fn])=>`
      <button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}
    ${mine?`<div class="div"></div>
      <button class="lstrow" style="padding:11px" onclick="closeOvl();startEditPost('${pid}')"><span style="color:var(--cyan)">${I("edit","i s")}</span><span class="g1 b xs" style="text-align:right">تعديل المنشور</span></button>
      <button class="lstrow" style="padding:11px" onclick="closeOvl();togglePostLock('${pid}')"><span style="color:var(--gold)">${I("lock","i s")}</span><span class="g1 b xs" style="text-align:right">${p&&p.lockC?"فتح التعليقات":"قفل التعليقات"}</span></button>
      <button class="lstrow" style="padding:11px" onclick="closeOvl();delPost('${pid}')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف المنشور</span></button>`:""}
  </div>`)};
function togglePostPin(id){const p=(S.posts||[]).find(x=>x.id===id);if(!p)return;p.pinned=!p.pinned;save();render();snd("tap");toast(p.pinned?"ثُبت المنشور في أعلى اليوميات ":"أُلغي تثبيت المنشور ","ok")}
function togglePostNotify(id){const p=(S.posts||[]).find(x=>x.id===id);if(!p)return;p.notify=!p.notify;save();snd("tap");toast(p.notify?"ستصلك تنبيهات التفاعل على هذا المنشور ":"أُوقفت تنبيهات هذا المنشور ","info")}
function togglePostLock(id){const p=(S.posts||[]).find(x=>x.id===id);if(!p)return;p.lockC=!p.lockC;save();render();toast(p.lockC?"قُفلت التعليقات على المنشور ":"فُتحت التعليقات ","ok")}
function hidePost(id){if(!(S.posts||[]).find(x=>x.id===id))return;(S.hidden=S.hidden||[]);if(!S.hidden.includes(id))S.hidden.push(id);save();render();snd("tap");toast("أُخفي المنشور من خلاصتك ","ok",()=>{S.hidden=S.hidden.filter(x=>x!==id);save();render();toast("أُعيد إظهار المنشور ","ok")})}
function startEditPost(id){const p=(S.posts||[]).find(x=>x.id===id);if(!p)return;S.editPostId=id;S.draftText=p.text||"";S.draftTags=(p.tags||[]).slice();save();go('create',{type:'post'},false);setTimeout(()=>{const t=$("#pub_txt");if(t){t.value=p.text||"";cnt(t,500,"pub_cnt")}const tb=$("#tagbox");if(tb&&p.tags)tb.innerHTML=p.tags.map(tagChip).join("");toast("وضع التحرير — عدّل ثم اضغط النشر ","info")},90)}
function applyCustomPriv(){const rows=[...document.querySelectorAll('#ovl .lstrow[data-uid]')];window.__privUsers=rows.filter(r=>{const s=r.querySelector('.sw');return s&&s.classList.contains('on')}).map(r=>r.getAttribute('data-uid'));window.__priv="custom";closeOvl();snd("success");toast("الخصوصية المخصصة: "+window.__privUsers.length+" عضو فقط يمكنهم الرؤية ","ok")}
function shareVia(net,id){const url="animeblack.app/"+(id?"post/"+id:"share");const msg="شاهد هذا على أنمي بلاك: "+url;copyTxt(net==="MAIL"||net==="SMS"||net==="WA"||net==="TG"||net==="X"||net==="IG"||net==="FB"||net==="DC"?msg:url);const p=id?(S.posts||[]).find(x=>x.id===id):null;if(p){p.shares=(p.shares||0)+1;save()}closeOvl();snd("success");toast("جُهّزت المشاركة لـ "+net+" — الصق النص هناك (عدّاد المشاركات +١) ","ok")}

SHEETS.shareSheet=(id)=>sheet(I("share","i s")+" مشاركة",`
  <div class="rowb card2" style="padding:10px;margin-bottom:12px"><span class="mono tiny g1" style="overflow:hidden;text-overflow:ellipsis" dir="ltr">animeblack.app/${id?"post/"+id:"share"}</span>
    <button class="btn btn-primary btn-xs" onclick="copyTxt('animeblack.app/${id?"post/"+id:"share"}')">${I("copy","i s")} نسخ</button></div>
  <div class="lbl">شارك عبر</div>
  <div class="grid4" style="gap:8px">
    ${[["واتساب","WA","#25D366"],["تيليجرام","TG","#229ED9"],["تويتر","X","#000"],["انستغرام","IG","#E1306C"],["فيسبوك","FB","#1877F2"],["ديسكورد","DC","#5865F2"],["بريد","MAIL","#EA4335"],["SMS","SMS","#10B981"]].map(([l,g,c])=>`
      <button class="col center" style="gap:5px;background:none;border:none" onclick="shareVia('${g}',${id?"'"+id+"'":"''"})">
        <span style="width:44px;height:44px;border-radius:14px;background:${c};display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;font-family:ui-monospace,monospace;color:${g==="X"?"#fff":"#0A0A0F"}">${g}</span>
        <span class="tiny" style="font-size:9px;font-weight:700">${l}</span></button>`).join("")}</div>
  <div class="div"></div>
  <div class="col">
    ${[["link","نسخ الرابط",`copyTxt('animeblack.app/${id?"post/"+id:"share"}');closeOvl()`],["qr","عرض رمز QR",`closeOvl();go('qrCard')`],["download","حفظ كصورة"],["at","مشاركة في قصة",`closeOvl();go('createStory')`],["users","إرسال لصديق (بطاقة غنية)",`closeOvl();openSheet('sharePick','${id||""}')`]].map(x=>`
      <button class="lstrow" style="padding:11px" onclick="${x[2]||`toast('${x[1]}','ok');snd('success');closeOvl()`}"><span style="color:var(--accent)">${I(x[0],"i s")}</span><span class="g1 b xs" style="text-align:right">${x[1]}</span></button>`).join("")}
  </div>`);

SHEETS.newChatSheet=()=>sheet(I("edit","i s")+" محادثة جديدة",`
  <div class="row" style="gap:7px;margin-bottom:12px"><div class="row g1" style="gap:7px;background:var(--surface2);border:1px solid var(--line2);border-radius:11px;padding:9px 11px">
    <span style="color:var(--muted)">${I("search","i s")}</span><input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث عن شخص أو نقابة..." value="${esc(S.ncQ||"")}" oninput="S.ncQ=this.value;ncUpd()"></div></div>
  <div class="grid2" style="gap:8px;margin-bottom:12px">
    <button class="btn btn-primary btn-sm" onclick="closeOvl();go('createGroup')">${I("users","i s")} قروب جديد</button>
    <button class="btn btn-sec btn-sm" onclick="closeOvl();go('createGuild')">${I("shield","i s")} نقابة</button>
    <button class="btn btn-sec btn-sm" onclick="closeOvl();go('createWorld')">${I("globe","i s")} عالم</button></div>
  <div class="lbl">جهات الاتصال</div>
  <div class="col" id="nclist">${ncRows()}</div>`);
SHEETS.chatMedia=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid);const ms=(c?c.messages:[]).filter(m=>m.type&&m.type!=="text");
 return sheet(I("image","i s")+" الوسائط المشتركة",`
  <div class="tiny mut" style="margin-bottom:9px">${ms.length} عنصر مشترك في هذه المحادثة</div>
  ${ms.length?`<div class="grid3" style="gap:7px">${ms.map(m=>`<button class="card2 center" style="padding:0;height:86px;line-height:0" onclick="closeOvl();${m.type==="voice"?`playMediaMid('${m.id}')`:`jumpToMsg('${m.id}')`}">${m.type==="sticker"?`<span style="color:var(--accent);line-height:0;display:flex">${IC(m.icon||"star","xl")}</span>`:m.type==="voice"?I("volume","xl"):m.type==="video"?IF("clapper","xl"):IF("image","xl")}</button>`).join("")}</div>`:`<div class="center tiny mut" style="padding:26px 0">لا وسائط مشتركة بعد</div>`}`)};
SHEETS.chatSearch=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid);const q=(S.csQ||"").trim().toLowerCase();
 const ms=q?(c?c.messages:[]).filter(m=>(m.text||"").toLowerCase().includes(q)):[];
 return sheet(I("search","i s")+" بحث في المحادثة",`
  <div class="row" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:12px;padding:9px 11px;margin-bottom:10px">${I("search","i s")}<input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="اكتب للبحث في الرسائل..." value="${esc(S.csQ||"")}" oninput="S.csQ=this.value;csUpd('${cid}')"></div>
  <div class="col" id="csres">${csList(cid,ms)}</div>`)};
function csList(cid,ms){const LB={voice:"رسالة صوتية",image:"صورة",video:"فيديو",sticker:"ملصق",file:"ملف",contact:"جهة اتصال",cpoll:"استطلاع",call:"مكالمة"};return ms.slice(-30).reverse().map(m=>`<button class="lstrow" style="padding:9px" onclick="jumpToMsg('${m.id}')"><span class="tiny fnt g1" style="text-align:right">${esc(m.text||(LB[m.type]||m.type)||"")}</span><span class="tiny mono mut">${hhmm(m.at)}</span></button>`).join("")||`<div class="center tiny mut" style="padding:18px 0">${(S.csQ||"")?"لا نتائج مطابقة":"اكتب للبحث في رسائل المحادثة"}</div>`}
function csUpd(cid){const c=(S.chats||[]).find(x=>x.id===cid);const q=(S.csQ||"").trim().toLowerCase();const e=$("#csres");if(e)e.innerHTML=csList(cid,q?(c?c.messages:[]).filter(m=>(m.text||"").toLowerCase().includes(q)):[])}
SHEETS.devDoc=(i)=>{const d=DEVDOCS[+i||0]||DEVDOCS[0];return sheet(I("code","i s")+" "+d[0],`<div class="card2 mono tiny" dir="ltr" style="padding:12px;white-space:pre-wrap;background:#000;color:#4ADE80;overflow-x:auto;line-height:1.75">${esc(d[1]).replace(/\\n/g,"\n")}</div><div class="grid2" style="margin-top:11px"><button class="btn btn-sec btn-sm" onclick="dl(DEVDOCS[${+i||0}][0]+'.txt',DEVDOCS[${+i||0}][1],'text/plain');toast('نُزّل الدليل ','ok')">${I("download","i s")} تنزيل</button><button class="btn btn-primary btn-sm" onclick="closeOvl();go('devCenter')">${I("code","i s")} بوابة المطورين</button></div>`)};
SHEETS.sysStatus=()=>{const kb=(safeStr(S).length/1024).toFixed(1);const up=typeof performance!=="undefined"?Math.round(performance.now()/1000):0;return sheet(I("wifi","i s")+" حالة النظام",`<div class="col">${[["وضع البيانات",API.mode()==="cloud"?"سحابي (Firebase)":"محلي (بدون سيرفر)"],["حجم الحالة المحفوظة",kb+" KB"],["المنشورات",String((S.posts||[]).length)],["المحادثات",String((S.chats||[]).length)],["المجتمعات",String((S.communities||[]).length)],["آنمي الموسوعة",String((S.wiki.anime||[]).length)],["زمن التشغيل",up+" ثانية"],["دقة الشاشة",(typeof screen!=="undefined"?screen.width+"×"+screen.height:"غير متاحة")],["الذاكرة المتاحة",(typeof navigator!=="undefined"&&navigator.deviceMemory?navigator.deviceMemory+" GB":"غير معلنة")]].map(([k,v])=>`<div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">${k}</span><span class="xs b mono">${esc(v)}</span></div>`).join("")}</div>`) };
SHEETS.secEvent=(i)=>{const l=(S.securityLogs||[])[+i]||null;if(!l)return sheet(I("shield","i s")+" الحدث","<div class='tiny fnt'>لم يعد موجوداً في السجل</div>");return sheet(I("shield","i s")+" تفاصيل الحدث",`<div class="col"><div class="card2" style="padding:12px"><div class="b xs">${esc(l.t||"")}</div><div class="tiny fnt mono" style="margin-top:6px" dir="ltr">${esc(l.ip||"")} · ${ago(l.at||now())}</div><div class="tiny fnt" style="margin-top:6px">الخطورة: ${l.sev==="high"?"عالية":l.sev==="med"?"متوسطة":"منخفضة"}</div><div class="tiny fnt" style="margin-top:3px">الجهاز: ${esc(l.dev||"هذا الجهاز")}</div></div><button class="btn btn-danger btn-sm" onclick="S.securityLogs.splice(${+i},1);save();closeOvl();render();toast('حُذف الحدث من السجل ','ok')">${I("trash","i s")} حذف من السجل</button><button class="btn btn-sec btn-sm" onclick="closeOvl();go('security')">${I("shield","i s")} فتح سجل الأمان كاملاً</button></div>`)};
SHEETS.followRequests=()=>{if(!(S.followReqs&&S.followReqs.length))S.followReqs=S.users.filter(x=>x.id!=="me"&&!S.following.includes(x.id)).slice(0,3).map(x=>({id:x.id,at:now()-864e5}));save();return sheet(I("users","i s")+" طلبات المتابعة",`<div class="col">${S.followReqs.length?S.followReqs.map(r=>{const x=u(r.id);return `<div class="rowb" style="padding:9px 2px;border-bottom:1px solid var(--line)"><div class="row" style="gap:9px">${av(x,38,true)}<div><div class="b xs">${esc(x.name)}</div><div class="tiny fnt">${ago(r.at||now())}</div></div></div><div class="row" style="gap:6px"><button class="btn btn-emerald btn-xs" onclick="acceptReq('${r.id}')">قبول</button><button class="btn btn-sec btn-xs" onclick="rejectReq('${r.id}')">رفض</button></div></div>`}).join(""):`<div class="tiny fnt center" style="padding:14px">لا طلبات معلّقة حالياً</div>`}</div>`)};
SHEETS.schedulePost=()=>sheet(I("clock","i s")+" جدولة المنشور",`<div class="col"><label class="lbl">موعد النشر</label><input class="inp" type="datetime-local" id="schT"><label class="lbl" style="margin-top:9px">نص المنشور المجدول</label><textarea class="inp" id="schTxt" rows="3" placeholder="يُعبأ تلقائياً من المحرر إن تركته فارغاً">${esc(($("#pub_txt")&&$("#pub_txt").value)||"")}</textarea><button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="saveSchedule()">${I("clock","i s")} جدولة الآن</button><div class="div" style="margin:12px 0"></div><div class="b xs">المنشورات المجدولة (${(S.scheduledPosts||[]).length})</div>${(S.scheduledPosts||[]).length?(S.scheduledPosts||[]).map(x=>`<div class="rowb" style="padding:8px 2px;border-bottom:1px solid var(--line)"><div class="g1"><div class="tiny b">${esc(((x&&x.txt)||"").slice(0,40))}</div><div class="tiny fnt mono">${esc(x.t)}</div></div><div class="row" style="gap:6px"><button class="btn btn-emerald btn-xs" onclick="pubScheduled('${x.id}')">انشر</button><button class="btn btn-sec btn-xs" onclick="delScheduled('${x.id}')">حذف</button></div></div>`).join(""):`<div class="tiny fnt">لا شيء مجدول</div>`}</div>`);
SHEETS.altCode=()=>sheet(I("mail","i s")+" الرمز البديل",`<div class="col center"><div class="tiny fnt">أُرسل رمز تحقق بديل إلى بريدك المسجّل — صالح ١٠ دقائق:</div><div class="bb mono" style="font-size:30px;letter-spacing:6px;margin:12px 0;color:var(--accent)">${esc(S.altCode||"------")}</div><div class="grid2"><button class="btn btn-sec btn-sm" onclick="copyTxt(S.altCode||'')">${I("copy","i s")} نسخ الرمز</button><button class="btn btn-primary btn-sm" onclick="closeOvl()">${I("check","i s")} تم</button></div></div>`);
SHEETS.backupCodes=()=>sheet(I("key","i s")+" رموز النسخ الاحتياطي",`<div class="col"><div class="tiny fnt">١٠ رموز تُستخدم مرة واحدة — احفظها في مكان آمن:</div><div class="grid2 mono tiny" style="margin:10px 0;gap:6px">${(S.backupCodes||[]).map((c,i)=>`<div class="card2" style="padding:8px;text-align:center;letter-spacing:1px">${i+1}. ${esc(c)}</div>`).join("")}</div><div class="grid2"><button class="btn btn-sec btn-sm" onclick="copyTxt((S.backupCodes||[]).join('\n'))">${I("copy","i s")} نسخ الكل</button><button class="btn btn-primary btn-sm" onclick="dl('animeblack-backup-codes.txt',(S.backupCodes||[]).join('\n'),'text/plain');toast('نُزّلت الرموز ','ok')">${I("download","i s")} تنزيل</button></div></div>`);
SHEETS.iosInfo=()=>sheet(I("apple","i s")+" تثبيت iOS",`<div class="col center"><div class="tiny b" style="line-height:1.6">لتثبيت التطبيق على الآيفون:</div><ol class="tiny fnt" style="text-align:right;margin:10px 0;line-height:2;padding-right:20px"><li>افتح هذا الموقع في متصفح <b>Safari</b></li><li>اضغط على أيقونة <b>المشاركة</b> في الأسفل</li><li>اختر <b>إضافة إلى الشاشة الرئيسية</b> (Add to Home Screen)</li></ol><button class="btn btn-primary btn-sm" style="margin-top:12px" onclick="closeOvl()">${I("check","i s")} حسناً، فهمت</button></div>`);
SHEETS.chatMenu=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid)||S.chats[0];if(!c)return sheet("القائمة","<div class='tiny fnt'>لا محادثات بعد</div>");const uu=u(c.userId);
  return sheet(I("more","i s")+" "+esc(uu.name),`<div class="col">
    <button class="lstrow" onclick="closeOvl();openProfile('${uu.id}')"><span style="color:var(--accent)">${I("user","i s")}</span><span class="g1 b xs" style="text-align:right">عرض الملف الشخصي</span></button>
    <button class="lstrow" onclick="toggleChatPin('${cid}')"><span style="color:var(--accent)">${I("pin","i s")}</span><span class="g1 b xs" style="text-align:right">${c.pinned?"إلغاء تثبيت المحادثة":"تثبيت المحادثة"}</span></button>
    <button class="lstrow" onclick="toggleChatMute('${cid}')"><span style="color:var(--accent)">${I(c.muted?"volume":"mute","i s")}</span><span class="g1 b xs" style="text-align:right">${c.muted?"إلغاء كتم الإشعارات":"كتم الإشعارات"}</span></button>
    <button class="lstrow" onclick="toggleChatArchive('${cid}')"><span style="color:var(--accent)">${I("archive","i s")}</span><span class="g1 b xs" style="text-align:right">${c.archived?"إخراج من الأرشيف":"أرشفة المحادثة"}</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('chatWallpaper','${cid}')"><span style="color:var(--accent)">${I("palette","i s")}</span><span class="g1 b xs" style="text-align:right">خلفية المحادثة وفقاعاتها</span></button>
    <button class="lstrow" onclick="S.csQ='';closeOvl();openSheet('chatSearch','${cid}')"><span style="color:var(--accent)">${I("search","i s")}</span><span class="g1 b xs" style="text-align:right">بحث داخل الرسائل</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('chatMedia','${cid}')"><span style="color:var(--accent)">${I("image","i s")}</span><span class="g1 b xs" style="text-align:right">الوسائط المشتركة</span></button>
    <button class="lstrow" onclick="clearChatMsgs('${cid}')"><span style="color:var(--gold)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right">مسح الرسائل (مع تراجع)</span></button>
    <button class="lstrow" onclick="closeOvl();go('report',{id:'${uu.id}'})"><span style="color:var(--rose)">${I("flag","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">إبلاغ</span></button>
    <button class="lstrow" onclick="blockUser('${uu.id}');S.chats=S.chats.filter(x=>x.id!=='${cid}');save();closeOvl();go('chat')"><span style="color:var(--rose)">${I("ban","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حظر وحذف المحادثة</span></button>
  </div>`)};
function msgById(mid){for(const c of S.chats){const m=(c.messages||[]).find(x=>x.id===mid);if(m)return m}for(const g of (S.groups||[])){const m=(g.msgs||[]).find(x=>x.id===mid);if(m)return m}for(const w of (S.worlds||[])){const m=(w.msgs||[]).find(x=>x.id===mid);if(m)return m}return null}
function chatOfMid(mid){for(const c of S.chats){if((c.messages||[]).some(x=>x.id===mid))return c}return null}
function toggleReact(mid,ic){
  const m=msgById(mid);if(!m)return;
  m.reacts=m.reacts||[];
  const i=m.reacts.indexOf(ic);
  if(i>=0)m.reacts.splice(i,1);else m.reacts.push(ic);
  save();snd("tap");
  const c=chatOfMid(mid);
  if(c && window.db && window.setDoc && window.doc){
    window.setDoc(window.doc(window.collection(window.db,"chats",c.id,"messages"),mid),{reacts:m.reacts},{merge:true}).catch(e=>console.error(e));
  }
  if(S.page==="chatRoom")render();
}
function pinMsg(mid){const c=chatOfMid(mid);if(!c)return;c.pinnedMsgs=c.pinnedMsgs||[];const i=c.pinnedMsgs.indexOf(mid);if(i>=0){c.pinnedMsgs.splice(i,1);toast("أُلغي تثبيت الرسالة ","info")}else{c.pinnedMsgs.push(mid);toast("ثُبّتت الرسالة أعلى المحادثة ","ok")}save();snd("tap");render()}
function startEditMsg(mid){const m=msgById(mid);if(!m)return;S.editMid=mid;S.replyTo=null;render();const i=$("#minp");if(i){i.value=m.text||"";i.focus()}}
function delMsg(mid){const c=chatOfMid(mid);if(!c)return;const idx=(c.messages||[]).findIndex(x=>x.id===mid);if(idx<0)return;const snap=c.messages[idx];c.messages.splice(idx,1);save();render();toast("حُذفت الرسالة ","info",()=>{c.messages.splice(Math.min(idx,(c.messages||[]).length),0,snap);save();render();toast("استُعيدت الرسالة ","ok")})}
function copyMsg(mid){const m=msgById(mid);const t=m?(m.text||"ملصق"):"";closeOvl();if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(()=>toast("نُسخ نص الرسالة ","ok"),()=>toast("نُسخ نص الرسالة ","info"));else toast("نُسخ نص الرسالة ","info")}
function selBox(mid){const on=(S.selIds||[]).includes(mid);return `<button style="position:absolute;top:6px;inset-inline-start:6px;width:22px;height:22px;border-radius:50%;background:${on?"var(--accent)":"rgba(128,128,128,.3)"};border:1px solid rgba(255,255,255,.35);color:#fff;line-height:0;display:flex;align-items:center;justify-content:center;cursor:pointer" onclick="event.stopPropagation();toggleSel('${mid}')" aria-label="تحديد">${on?I("check","i s"):""}</button>`}
function toggleSel(mid){S.selIds=S.selIds||[];const i=S.selIds.indexOf(mid);if(i>=0)S.selIds.splice(i,1);else S.selIds.push(mid);snd("tap");render()}
function starMsg(mid){const m=msgById(mid);if(!m)return;m.star=!m.star;save();snd("success");toast(m.star?"ُميّزت الرسالة بنجمة ":"أُلغي التمييز ","ok");closeOvl();if(S.page==="chatRoom")render()}
function starSel(){(S.selIds||[]).forEach(id=>{const m=msgById(id);if(m)m.star=true});S.selIds=[];S.selMode=false;save();snd("success");toast("مُيزّت الرسائل المحددة ","ok");render()}
function delSel(){const ids=S.selIds||[];S.chats.forEach(c=>{c.messages.forEach(m=>{if(ids.includes(m.id)&&m.from==="me")m.gone=true})});S.selIds=[];S.selMode=false;save();toast("حُذفت الرسائل المحددة لدي الجميع ","ok");render()}
function delMsgAll(mid){
  const m=msgById(mid);if(!m)return;
  m.gone=true;save();closeOvl();snd("tap");toast("حُذفت لدى الجميع ","ok");
  const c=chatOfMid(mid);
  if(c && window.db && window.setDoc && window.doc){
    window.setDoc(window.doc(window.collection(window.db,"chats",c.id,"messages"),mid),{gone:true},{merge:true}).catch(e=>console.error(e));
  }
  if(S.page==="chatRoom")render();
}
function cycleVanish(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const steps=[0,24,72];const i=steps.indexOf(c.vanish||0);c.vanish=steps[(i+1)%3];save();snd("tap");toast(c.vanish?"الرسائل تختفي بعد "+(c.vanish===24?"٢٤ ساعة":"٣ أيام"):"أُلغي اختفاء الرسائل ",c.vanish?"ok":"info");if(S.page==="chatRoom")render();else if(document.querySelector(".sheet"))openSheet("chatRoomMenu",cid)}
function linkPrev(m){const url=(m.text.match(/https?:\/\/[^\s]+/)||[""])[0];const dom=((url.split("//")[1]||"").split("/")[0]||"رابط").replace(/^www\./,"");const h=strHash(dom+url);const titles=["مقال: أفضل أنمي موسم الخريف","حوار حصري مع مخرج الاستوديو","تقرير: مبيعات المانجا هذا الأسبوع","إعلان رسمي من الاستوديو","مراجعة الحلقة الأخيرة بدون حرق"];const descs=["خلاصة محررة بأهم النقاط مع صور حصرية من العمل.","تفاصيل رسمية وموعد العرض القادم باللغة العربية.","أرقام وتحليلات محدثة حتى هذا الأسبوع."];const g=[["#0C4A6E","#0EA5E9"],["#3B0764","#A855F7"],["#7F1D1D","#EA580C"]][h%3];return `${linkify(m.text)}<div class="card2" style="margin-top:7px;padding:0;overflow:hidden;border-right:3px solid var(--cyan)"><div class="row" style="gap:9px;padding:9px"><span class="ico-tile" style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,${g[0]},${g[1]});color:#fff;flex-shrink:0">${I("link","i l")}</span><span class="g1" style="min-width:0"><span class="xs b" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${titles[h%titles.length]}</span><span class="tiny fnt" style="display:block;margin-top:2px;opacity:.8">${descs[h%descs.length]}</span><span class="tiny mono" style="color:var(--cyan);display:block;margin-top:3px" dir="ltr">${esc(dom)}</span></span></div></div>`}
SHEETS.starredMsgs=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid);const ms=(c?c.messages:[]).filter(m=>m.star);
 return sheet(I("star","i s")+" الرسائل المميزة",`<div class="col">${ms.length?ms.map(m=>`<button class="lstrow" style="padding:9px" onclick="jumpToMsg('${m.id}')"><span style="color:var(--gold)">${I("star","i s")}</span><span class="tiny g1" style="text-align:right">${esc(m.text||m.type||"")}</span><span class="tiny mono mut">${hhmm(m.at)}</span></button>`).join(""):`<div class="center tiny mut" style="padding:22px 0">لا رسائل مميزة — نجّمها من قائمة الرسالة</div>`}</div>`)};
SHEETS.chatStats=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return sheet(I("chart","i s")+" الإحصائيات","<div class='tiny fnt'>لا محادثة</div>");const ms=c.messages;const mine=ms.filter(m=>m.from==="me");const by=t=>ms.filter(m=>m.type===t).length;const days=["الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];const wd=[0,0,0,0,0,0,0];ms.forEach(m=>{wd[new Date(m.at||now()).getDay()]++});const bi=wd.indexOf(Math.max(...wd));
 return sheet(I("chart","i s")+" إحصائيات المحادثة",`<div class="col">${[["إجمالي الرسائل",ms.length],["رسائلك أنت",mine.length+(" ("+Math.round(100*(mine.length/(ms.length||1)))+"%)")],["رسائل الطرف الآخر",ms.length-mine.length],["صور وفيديو",by("image")+by("video")],["رسائل صوتية",by("voice")],["ملصقات",by("sticker")],["ملفات",by("file")],["استطلاعات",by("cpoll")],["مكالمات",by("call")],["رسائل مميزة",ms.filter(m=>m.star).length],["أول رسالة",ms.length?dayLbl(ms[0].at):"—"],["أنشط يوم",ms.length?days[bi]:"—"]].map(([k,v])=>`<div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">${k}</span><span class="xs b mono">${v}</span></div>`).join("")}</div>`)};
function sendFwd(mid,cid){const m=msgById(mid);const c=(S.chats||[]).find(x=>x.id===cid);if(!m||!c)return;const myUid=getMyUid();const cp=Object.assign({},m,{id:uid(),from:"me",senderId:myUid,senderName:S.me.name||"أنا",at:now(),fwd:true,st:1,pending:true,reacts:undefined,quote:undefined});c.messages.push(cp);c.last="مُعاد توجيهها";c.lastAt=now();save();closeOvl();snd("send");go("chatRoom",{id:cid});toast("أُعيد توجيه الرسالة إلى "+u(c.userId).name+" ","ok");syncChatMessage(cid, cp);}
function sendContact(uidv,cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const myUid=getMyUid();const mObj={id:uid(),from:"me",senderId:myUid,senderName:S.me.name||"أنا",type:"contact",uid:uidv,text:"جهة اتصال: "+u(uidv).name,at:now(),st:1,pending:true};c.messages.push(mObj);c.last="جهة اتصال";c.lastAt=now();save();closeOvl();snd("send");render();toast("أُرسلت بطاقة جهة الاتصال ","ok");syncChatMessage(cid, mObj);}
function sendPoll(cid){const q=($("#cpq")&&$("#cpq").value||"").trim();const opts=["#cpo1","#cpo2","#cpo3","#cpo4"].map(s=>($(s)&&$(s).value||"").trim()).filter(Boolean);if(!q||opts.length<2){toast("اكتب سؤالاً وخيارين على الأقل ","err");return}
  if(cid&&String(cid).includes(":")){const [kind,rid]=String(cid).split(":");const o=kind==="group"?(S.groups||[]).find(x=>x.id===rid):(S.worlds||[]).find(x=>x.id===rid);if(!o)return;const mObj={id:uid(),uid:"me",senderId:getMyUid(),senderName:S.me.name||"أنا",type:"cpoll",q,opts,votes:opts.map(()=>0),me:null,text:"استطلاع: "+q,at:now()};o.msgs.push(mObj);save();closeOvl();snd("send");render();toast("أُرسل الاستطلاع إلى الغرفة — اضغط خياراً للتصويت ","ok");if(window.db && window.setDoc && window.doc){const coll = kind==="group" ? "groups" : "worlds";window.setDoc(window.doc(window.collection(window.db,coll,o.id,"messages"),mObj.id),mObj).catch(e=>console.error(e));}return}
  const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const myUid=getMyUid();const mObj={id:uid(),from:"me",senderId:myUid,senderName:S.me.name||"أنا",type:"cpoll",q,opts,votes:opts.map(()=>0),me:null,text:"استطلاع: "+q,at:now(),st:1,pending:true};c.messages.push(mObj);c.last="استطلاع: "+q;c.lastAt=now();save();closeOvl();snd("send");render();toast("أُرسل الاستطلاع — اضغط خيارك للتصويت ","ok");syncChatMessage(cid, mObj);}
function voteChatPoll(mid,oi){const m=msgById(mid);if(!m||m.type!=="cpoll")return;if(m.me!=null){toast("صوتك مسجل بالفعل في هذا الاستطلاع ","info");return}m.votes=m.votes||m.opts.map(()=>0);m.votes[oi]=(m.votes[oi]||0)+1;m.me=oi;save();snd("success");toast("سُجل صوتك ","ok");if(S.page==="chatRoom")render()}
function toggleChatPin(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;c.pinned=!c.pinned;save();closeOvl();render();toast(c.pinned?"ثُبّتت المحادثة أعلى القائمة ":"أُلغي تثبيت المحادثة ","ok")}
function toggleChatMute(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;c.muted=!c.muted;save();closeOvl();render();toast(c.muted?"كُتمت إشعارات المحادثة ":"أُلغي الكتم ","ok")}
function toggleChatArchive(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;c.archived=!c.archived;save();closeOvl();render();toast(c.archived?"أُرشفَت المحادثة — تجدها في رقاقة «مؤرشفة» ":"أُعيدت المحادثة إلى القائمة ","ok")}
function clearChatMsgs(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const snap=(c.messages||[]).slice();c.messages=[];c.last="محادثة جديدة";save();closeOvl();render();toast("مُسحت رسائل المحادثة ","info",()=>{c.messages=snap;save();render();toast("استُعيدت الرسائل ","ok")})}
function jumpToMsg(mid){const c=chatOfMid(mid);if(!c)return;closeOvl();if(S.page!=="chatRoom"||S.params.id!==c.id)go("chatRoom",{id:c.id});setTimeout(()=>{const el=document.getElementById("m_"+mid);if(el){el.scrollIntoView({block:"center",behavior:"smooth"});el.classList.add("msgflash");setTimeout(()=>el.classList.remove("msgflash"),1500)}},240)}
function ncRows(){const q=(S.ncQ||"").toLowerCase();return S.users.filter(x=>!q||x.name.toLowerCase().includes(q)||x.username.toLowerCase().includes(q)).map(x=>`<button class="lstrow" style="padding:10px" onclick="closeOvl();startChat('${x.id}')">${av(x,40)}
    <span class="g1" style="text-align:right"><span class="row" style="gap:4px"><span class="b xs">${esc(x.name)}</span>${vbadge(x)}</span><span class="tiny fnt">${x.online?'<span style="color:var(--emerald)"> متصل</span>':"غير متصل"} · @${esc(x.username)}</span></span>
    <span style="color:var(--accent)">${I("chat","i s")}</span></button>`).join("")||`<div class="center tiny mut" style="padding:14px 0">لا نتائج مطابقة</div>`}
function ncUpd(){const e=$("#nclist");if(e)e.innerHTML=ncRows()}
SHEETS.msgMenu=(mid)=>{const m=msgById(mid);if(!m)return sheet(I("msgsq","i s")+" الرسالة","<div class='tiny fnt'>الرسالة غير موجودة</div>");const me=m.from==="me";const c=chatOfMid(mid);
  const RX=["heart","flame","star","face-laugh","face-sad","face-wow"];
  return sheet(I("msgsq","i s")+" خيارات الرسالة",`<div class="col">
   <div class="row" style="gap:6px;justify-content:center;margin-bottom:9px">${RX.map(ic=>`<button class="iconbtn" style="width:40px;height:40px" onclick="toggleReact('${mid}','${ic}');closeOvl()" aria-label="تفاعل ${ic}">${I(ic,"i l")}</button>`).join("")}</div>
   <button class="lstrow" onclick="closeOvl();S.replyTo='${mid}';render();const i=$('#minp');if(i)i.focus()"><span style="color:var(--accent)">${I("reply","i s")}</span><span class="g1 b xs" style="text-align:right">رد باقتباس</span></button>
   <button class="lstrow" onclick="closeOvl();openSheet('fwdSheet','${mid}')"><span style="color:var(--accent)">${I("fwd","i s")}</span><span class="g1 b xs" style="text-align:right">إعادة توجيه لمحادثة أخرى</span></button>
   ${m.text?`<button class="lstrow" onclick="copyMsg('${mid}')"><span style="color:var(--accent)">${I("copy","i s")}</span><span class="g1 b xs" style="text-align:right">نسخ النص</span></button>`:""}
   ${me&&m.type==="text"?`<button class="lstrow" onclick="closeOvl();startEditMsg('${mid}')"><span style="color:var(--gold)">${I("edit","i s")}</span><span class="g1 b xs" style="text-align:right">تعديل الرسالة</span></button>`:""}
   <button class="lstrow" onclick="starMsg('${mid}')"><span style="color:var(--gold)">${I("star","i s")}</span><span class="g1 b xs" style="text-align:right">${m.star?"إلغاء تمييز الرسالة":"تمييز الرسالة بنجمة"}</span></button>
   ${me?`<button class="lstrow" onclick="delMsgAll('${mid}')"><span style="color:var(--rose)">${I("ban","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف لدى الجميع</span></button>`:""}
   <button class="lstrow" onclick="pinMsg('${mid}')"><span style="color:var(--gold)">${I("pin","i s")}</span><span class="g1 b xs" style="text-align:right">${((c&&c.pinnedMsgs)||[]).includes(mid)?"إلغاء تثبيت الرسالة":"تثبيت أعلى المحادثة"}</span></button>
   <button class="lstrow" onclick="closeOvl();openSheet('msgInfo','${mid}')"><span style="color:var(--accent)">${I("info","i s")}</span><span class="g1 b xs" style="text-align:right">معلومات الرسالة</span></button>
   ${me?`<button class="lstrow" onclick="delMsg('${mid}')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف الرسالة (مع تراجع)</span></button>`:`<button class="lstrow" onclick="closeOvl();go('report',{id:'${(c||{}).userId||""}'})"><span style="color:var(--rose)">${I("flag","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">إبلاغ عن الرسالة</span></button>`}
  </div>`)};
SHEETS.fwdSheetSel=()=>sheet(I("fwd","i s")+" توجيه المحدد إلى",`<div class="col">${S.chats.filter(c=>!c.archived).map(c=>{const uu=u(c.userId);return `<button class="lstrow" style="padding:10px" onclick="sendFwdSel('${c.id}')">${av(uu,38)}<span class="g1 b xs" style="text-align:right">${esc(uu.name)}</span><span class="mono tiny">${(S.selIds||[]).length}</span></button>`}).join("")||"<div class='tiny fnt center' style='padding:12px'>لا محادثات متاحة</div>"}</div>`);
function sendFwdSel(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const myUid=getMyUid();(S.selIds||[]).forEach(mid=>{const m=msgById(mid);if(m){const nmid=uid();const cp=Object.assign({},m,{id:nmid,from:"me",senderId:myUid,senderName:S.me.name||"أنا",at:now(),fwd:true,st:1,pending:true,reacts:undefined,quote:undefined,star:undefined});c.messages.push(cp);syncChatMessage(cid, cp);}});c.last="مُعاد توجيهها ("+(S.selIds||[]).length+")";c.lastAt=now();S.selIds=[];S.selMode=false;save();closeOvl();snd("send");go("chatRoom",{id:cid});toast("وُجّهت الرسائل المحددة ","ok")}
SHEETS.fwdSheet=(mid)=>sheet(I("fwd","i s")+" إعادة التوجيه إلى",`<div class="col">${S.chats.filter(c=>!c.archived).map(c=>{const uu=u(c.userId);return `<button class="lstrow" style="padding:10px" onclick="sendFwd('${mid}','${c.id}')">${av(uu,38)}<span class="g1 b xs" style="text-align:right">${esc(uu.name)}</span><span style="color:var(--accent)">${I("fwd","i s")}</span></button>`}).join("")||"<div class='tiny fnt center' style='padding:12px'>لا محادثات متاحة</div>"}</div>`);
SHEETS.contactSheet=(cid)=>sheet(I("user","i s")+" مشاركة جهة اتصال",`<div class="col">${S.users.map(x=>`<button class="lstrow" style="padding:10px" onclick="sendContact('${x.id}','${cid}')">${av(x,38)}<span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(x.name)}</span><span class="tiny fnt">@${esc(x.username)}</span></span><span style="color:var(--accent)">${I("share","i s")}</span></button>`).join("")}</div>`);
SHEETS.pollSheet=(cid)=>sheet(I("barchart","i s")+" استطلاع داخل المحادثة",`<div class="col"><label class="lbl">سؤال الاستطلاع</label><input class="inp" id="cpq" placeholder="مثال: أي أنمي نشاهده الليلة؟"><label class="lbl" style="margin-top:9px">الخيارات (٢ إلى ٤)</label><input class="inp" id="cpo1" placeholder="الخيار الأول" style="margin-bottom:7px"><input class="inp" id="cpo2" placeholder="الخيار الثاني" style="margin-bottom:7px"><input class="inp" id="cpo3" placeholder="الثالث (اختياري)" style="margin-bottom:7px"><input class="inp" id="cpo4" placeholder="الرابع (اختياري)"><button class="btn btn-primary btn-sm" style="margin-top:11px" onclick="sendPoll('${cid}')">${I("send","i s")} إرسال الاستطلاع</button></div>`);
SHEETS.msgInfo=(mid)=>{const m=msgById(mid);if(!m)return sheet(I("info","i s")+" معلومات","<div class='tiny fnt'>الرسالة غير موجودة</div>");const c=chatOfMid(mid);
  return sheet(I("info","i s")+" معلومات الرسالة",`<div class="col">${[["النوع",{text:"نص",sticker:"ملصق",image:"صورة",video:"فيديو",voice:"صوت",file:"ملف",contact:"جهة اتصال",cpoll:"استطلاع"}[m.type]||m.type||"نص"],["من",m.from==="me"?"أنت":u((c||{}).userId||"").name],["التوقيت",new Date(m.at).toLocaleString("ar")],["الحالة",m.from==="me"?(m.pending?"قيد الإرسال (لا اتصال)":(m.st||1)===3?"مقروءة":(m.st||1)===2?"وصلت":"أُرسلت"):"مستلمة"],["الحجم",(safeStr(m).length/1024).toFixed(1)+" KB"],["المعرّف",m.id]].map(([k,v])=>`<div class="rowb" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">${k}</span><span class="b xs" style="text-align:right">${esc(String(v))}</span></div>`).join("")}</div>`)};
SHEETS.chatRoomMenu=(cid)=>{const c=(S.chats||[]).find(x=>x.id===cid)||S.chats[0];if(!c)return sheet("القائمة","<div class='tiny fnt'>لا محادثات بعد</div>");const uu=u(c.userId);
  return sheet(I("more","i s")+" خيارات المحادثة",`<div class="col">
    <button class="lstrow" onclick="closeOvl();openProfile('${uu.id}')">${av(uu,36)}<span class="g1 b xs" style="text-align:right">الملف الشخصي</span></button>
    <button class="lstrow" onclick="startCall('${cid}','voice')"><span style="color:var(--emerald)">${I("phone","i s")}</span><span class="g1 b xs" style="text-align:right">مكالمة صوتية</span></button>
    <button class="lstrow" onclick="startCall('${cid}','video')"><span style="color:var(--cyan)">${I("video","i s")}</span><span class="g1 b xs" style="text-align:right">مكالمة فيديو</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('chatMenu','${cid}')"><span style="color:var(--accent)">${I("settings","i s")}</span><span class="g1 b xs" style="text-align:right">إعدادات المحادثة</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('chatMedia','${cid}')"><span style="color:var(--accent)">${I("image","i s")}</span><span class="g1 b xs" style="text-align:right">الوسائط المشتركة</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('starredMsgs','${cid}')"><span style="color:var(--gold)">${I("star","i s")}</span><span class="g1 b xs" style="text-align:right">الرسائل المميزة (${(((S.chats||[]).find(x=>x.id==='${cid}')||{}).messages||[]).filter(m=>m.star).length})</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('chatStats','${cid}')"><span style="color:var(--cyan)">${I("chart","i s")}</span><span class="g1 b xs" style="text-align:right">إحصائيات المحادثة</span></button>
    <button class="lstrow" onclick="cycleVanish('${cid}')"><span style="color:var(--emerald)">${I("clock","i s")}</span><span class="g1 b xs" style="text-align:right">الرسائل المختفية: ${{0:"معطلة",24:"٢٤ ساعة",72:"٣ أيام"}[(((S.chats||[]).find(x=>x.id==='${cid}')||{}).vanish)||0]}</span></button>
    <button class="lstrow" onclick="S.selMode=true;S.selIds=[];closeOvl();render();toast('وضع التحديد — اضغط على الرسائل للاختيار ','info')"><span style="color:var(--accent)">${I("check","i s")}</span><span class="g1 b xs" style="text-align:right">تحديد رسائل متعددة</span></button>
  </div>`)};
const BUBBLECOLS=[["flame","لهيب الأوتـاكو","#22D3EE","#EA580C",0],["purple","البنفسجي الإمبراطوري","#9333EA","#4338CA",25],["emerald","الزمرد النادر","#059669","#0F766E",25],["cyan","السايان المشع","#06B6D4","#2563EB",25],["sakura","وردي الساكورا","#EC4899","#E11D48",25],["gold","الذهب الخالص","#EAB308","#D97706",50]];
function bubbleGrad(){const c=(BUBBLECOLS||[]).find(x=>x[0]===S.bubbleCol);return c?`linear-gradient(135deg,${c[2]},${c[3]})`:""}
function buyBubble(id){const c=(BUBBLECOLS||[]).find(x=>x[0]===id);if(!c)return;if(S.bubbleCol===id){S.bubbleCol=null;save();render();return toast("عدت للون الفقاعات الافتراضي ","info")}
  if(c[4]>0){S.me.premiumBubbles=S.me.premiumBubbles||[];if(!S.me.premiumBubbles.includes(id)){if(S.stars<c[4]){toast("تحتاج "+c[4]+" نجمة — عندك "+S.stars,"err");snd("error");return}S.stars-=c[4];S.me.stars=S.stars;S.me.premiumBubbles.push(id);toast("اشتريت «"+c[1]+"» بـ "+c[4]+" نجمة ","ok")}else{toast("«"+c[1]+"» مملوكة — طُبّقت ","ok")}}
  S.bubbleCol=id;save();render()}
function uploadWallpaper(inp,cid){const f=inp.files&&inp.files[0];if(!f)return;const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const rd=new FileReader();rd.onload=()=>{const img=new Image();img.onload=()=>{const max=900,sc=Math.min(1,max/Math.max(img.width,img.height));const cv=document.createElement("canvas");cv.width=Math.round(img.width*sc);cv.height=Math.round(img.height*sc);cv.getContext("2d").drawImage(img,0,0,cv.width,cv.height);try{c.wallpaperImg=cv.toDataURL("image/jpeg",0.72);save();toast("طُبّقت خلفيتك المخصصة ","ok")}catch(e){toast("الصورة كبيرة — جرّب أصغر","err")}render()};img.onerror=()=>toast("تعذّر قراءة الصورة","err");img.src=rd.result};rd.readAsDataURL(f)}
SHEETS.avatarPick=()=>sheet(I("camera","i s")+" الصورة الرمزية",`
  <input type="file" id="avFile" accept="image/*" style="display:none" onchange="avUpload(this)">
  <div class="col">
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('avFile').click()">${I("upload","i s")} رفع صورة حقيقية من الهاتف (كاميرا أمامية)</button>
    <button class="btn btn-sec btn-sm" onclick="S.me.avatar=pick(AV);save();closeOvl();render();toast('صورة عشوائية من المجموعة ','ok')">${I("refresh","i s")} اختيار عشوائي من المجموعة</button>
    <div class="tiny fnt center">تُصغَّر الصورة تلقائياً إلى 256px وتُحفظ داخل ملفك</div>
  </div>`);
function avUpload(inp){const f=inp.files&&inp.files[0];if(!f)return;fileDownscale(f,256,0.82,src=>{if(!src){toast("تعذّر قراءة الصورة","err");return}S.me.avatar=src;save();closeOvl();render();toast("طُبّقت صورتك الحقيقية ","ok")})}
SHEETS.shortcuts=()=>sheet(I("terminal","i s")+" اختصارات لوحة المفاتيح",`<div class="col">${[["1 → 5","التنقل بين التبويبات الخمسة (الرئيسية/استكشف/إنشاء/الرسائل/المزيد)"],["/","فتح البحث"],["N","الإشعارات"],["Esc","إغلاق أي قائمة أو ورقة مفتوحة"],["؟","هذه القائمة"],["نقر مزدوج","إعجاب بأي منشور"],["سحب من الأعلى","تحديث الخلاصة"],["ضغطة طويلة","قائمة سياقية على المنشورات والرسائل"]].map(([k,d])=>`<div class="rowb" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span class="badge b-gray mono" dir="ltr">${esc(k)}</span><span class="g1 tiny fnt" style="text-align:right;margin-inline-start:10px">${d}</span></div>`).join("")}</div>`);
SHEETS.chatWallpaper=(cid)=>sheet(I("palette","i s")+" خلفية المحادثة",`
  <input type="file" id="wpFile" accept="image/*" style="display:none" onchange="uploadWallpaper(this,'${cid}')">
  <div class="grid3">${[["#0A0A0A","#121212"],["#7F1D1D","#EA580C"],["#3B0764","#A855F7"],["#064E3B","#10B981"],["#0C4A6E","#0EA5E9"],["#831843","#DB2777"],["#111827","#374151"],["#1a1206","#F59E0B"],["#000","#22D3EE"]].map(c=>`
    <button style="height:70px;border-radius:13px;background:linear-gradient(135deg,${c[0]},${c[1]});border:2px solid var(--line2)" onclick="(()=>{const c=(S.chats||[]).find(x=>x.id==='${cid}');if(c){c.wallpaper=['${c[0]}','${c[1]}'];save()}snd('success');closeOvl();render();toast('تم تغيير الخلفية ','ok')})()"></button>`).join("")}</div>
  <div class="lbl" style="margin-top:14px">خلفيات جاهزة بأسمائها</div>
  <div class="grid2">${[["طوكيو أكيهابارا ليلاً","#0C0A1E","#22D3EE"],["حديقة الساكورا اليابانية","#831843","#FBCFE8"],["نيون سايبربانك","#06B6D4","#7C3AED"],["غرفة الزن البسيطة","#1C1917","#57534E"]].map(([nm,a2,b2])=>`<button style="height:52px;border-radius:12px;background:linear-gradient(135deg,${a2},${b2});border:2px solid var(--line2)" onclick="(()=>{const c=(S.chats||[]).find(x=>x.id==='${cid}');if(c){c.wallpaper=['${a2}','${b2}'];c.wallpaperImg=null;save()}closeOvl();render();toast('خلفية «${nm}» ','ok')})()"><span class="tiny b" style="color:#fff;text-shadow:0 1px 4px rgba(0,0,0,.7)">${nm}</span></button>`).join("")}</div>
  <div class="lbl" style="margin-top:14px">لون فقاعاتك — بريميوم (${S.stars} نجمة لديك)</div>
  <div class="grid3">${BUBBLECOLS.map(c=>`<button style="border-radius:13px;padding:9px 6px;border:2px solid ${S.bubbleCol===c[0]?"var(--accent)":"var(--line2)"};background:linear-gradient(135deg,${c[2]},${c[3]})" onclick="buyBubble('${c[0]}')"><span class="tiny b" style="color:${c[0]==="gold"?"#111":"#fff"};display:block">${c[1]}</span><span class="tiny" style="color:${c[0]==="gold"?"#111":"#fff"};opacity:.85">${c[4]===0?"مجاني":((S.me.premiumBubbles||[]).includes(c[0])?"مملوكة":c[4]+" نجمة")}</span></button>`).join("")}</div>
  <div class="grid2" style="margin-top:12px"><button class="btn btn-sec" onclick="document.getElementById('wpFile').click()">${I("upload","i s")} خلفية مخصصة (رفع حقيقي)</button>
    <button class="btn btn-ghost" onclick="(()=>{const c=(S.chats||[]).find(x=>x.id==='${cid}');if(c){c.wallpaper=null;c.wallpaperImg=null;save()}closeOvl();render();toast('عادت الخلفية الافتراضية ','info')})()">${I("refresh","i s")} افتراضي</button></div>`);

SHEETS.attachSheet=()=>sheet(I("plus","i s")+" إرفاق",`
  <div class="grid4">${[["image","صورة","var(--grad-cyan)"],["video","فيديو","var(--grad-purple)"],["camera","كاميرا","var(--grad-fire)"],["mic","صوت","var(--grad-emerald)"],
   ["file","ملف","var(--grad-gold)"],["map","موقع","#0F766E"],["user","جهة اتصال","#BE185D"],["barchart","استطلاع","#4338CA","poll"]].map(([ic,l,g,k2])=>`
    <button class="col center" style="gap:6px" onclick="attachToChat('${k2||ic}')">
      <span class="ico-tile" style="width:48px;height:48px;border-radius:16px;background:${g};color:#fff">${I(ic,"l")}</span>
      <span class="tiny b" style="font-size:9.5px">${l}</span></button>`).join("")}</div>`);
function attachToChat(k){
  closeOvl();
  const room=S.page==="groupRoom"?{kind:"group",o:(S.groups||[]).find(x=>x.id===S.params.id)}:S.page==="worldRoom"?{kind:"world",o:(S.worlds||[]).find(x=>x.id===S.params.id)}:null;
  const c=S.activeChat?(S.chats||[]).find(x=>x.id===S.activeChat):(S.page==="chatRoom"?(S.chats||[]).find(x=>x.id===S.params.id):(S.page==="communityChannel"?(()=>{const cm=(S.communities||[]).find(x=>x.id===S.params.id);return cm?(((cm&&cm.channels)||[]).find(x=>x.id===S.params.ch)||null):null})():null));
  if(!c&&!room){toast("افتح محادثة أو غرفة أولاً ","err");return}
  const push=room?(m=>{
    const mid=uid();
    const myUid=getMyUid();
    const item=Object.assign({id:mid,uid:myUid,senderName:S.me.name||"أنا",at:now()},m);
    room.o.msgs.push(Object.assign({id:mid,uid:"me",at:now()},m));
    save();snd("send");render();toast("أُرسل إلى "+(room.kind==="group"?"القروب ":"العالم "),"ok");
    if(window.db && window.setDoc && window.doc){
      const coll = room.kind==="group" ? "groups" : "worlds";
      window.setDoc(window.doc(window.collection(window.db,coll,room.o.id,"messages"),mid),item).catch(e=>console.error(e));
    }
  }):(m=>{
    const mid=uid();
    const myUid=getMyUid();
    const item=Object.assign({id:mid,from:"me",senderId:myUid,senderName:S.me.name||"أنا",at:now(),st:1,pending:true},m);
    c.messages.push(item);c.last=m.text||"وسائط";c.lastAt=now();save();snd("send");render();toast("أُرسل ","ok");
    syncChatMessage(c.id, item);
  });
  const cid=room?(room.kind+":"+room.o.id):c.id;
  if(k==="image"||k==="video"||k==="camera"){
    pickFile(k==="video"?"video/*":"image/*",k==="camera"?"environment":"",f=>{
      if(k==="video"){fileToDataURL(f,4.5*1024*1024,src=>{if(src)push({type:"video",src,text:" فيديو"})});return}
      fileDownscale(f,1280,0.75,src=>{if(src)push({type:"image",src,text:" صورة"});else toast("تعذّر قراءة الصورة ","err")})});
    return}
  if(k==="mic"){const btn=document.getElementById("gmic")||document.getElementById("wmic")||document.getElementById("micbtn");
    if(room){recGenVoice(room.kind,room.o.id,btn||document.body);return}
    if(c&&btn)recVoice(c.id,btn);else toast("سجّل من زر الميكروفون في شريط الكتابة ","info");return}
  if(k==="file"){pickFile("","",f=>fileToDataURL(f,2.5*1024*1024,src=>{if(src)push({type:"file",src,text:" ملف: "+f.name,name:f.name})}));return}
  if(k==="map"){
    if(navigator.geolocation){toast("جارٍ تحديد موقعك الحقيقي... ","info");
      navigator.geolocation.getCurrentPosition(pos=>push({text:" موقعي الحقيقي: "+pos.coords.latitude.toFixed(4)+", "+pos.coords.longitude.toFixed(4)}),()=>{toast("تعذّر تحديد موقعك — فعّل إذن الموقع","err")},{timeout:8000});return}
    toast("خدمة الموقع غير مدعومة في متصفحك","err");return}
  if(k==="user"){if(!c){toast("جهات الاتصال متاحة في المحادثات الخاصة ","info");return}openSheet('contactSheet',c.id);return}
  if(k==="poll"){openSheet('pollSheet',cid);return}
  toast("هذا الخيار غير مدعوم بعد","info");
}

SHEETS.emojiSheet=()=>sheet(I("sparkles","i s")+" ملصقات مصممة",`
  <div class="tiny mut" style="margin-bottom:9px">ملصقات SVG أصلية — اضغط لإرسالها في المحادثة المفتوحة</div>
  <div class="chiprow" style="margin-bottom:9px"><button class="chip ${!S.stickerPack?'on':''}" onclick="S.stickerPack=null;save();openSheet('emojiSheet')">الكل</button>${PACKS.map(pk=>`<button class="chip ${S.stickerPack===pk?'on':''}" onclick="S.stickerPack='${pk}';save();openSheet('emojiSheet')">${pk}</button>`).join("")}</div>
  <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:6px">${STICKERS.filter((_,si)=>!S.stickerPack||PACKS[si%6]===S.stickerPack).map(([ic,l,cl])=>`
    <button class="card2 center" style="padding:8px 2px;line-height:0" title="${l}" onclick="pickSticker('${ic}')"><span style="color:${cl};line-height:0;display:flex">${IC(ic,"xl")}</span></button>`).join("")}</div>`);
const PACKS=["Gojo Smirk","Kurama Chakra","Luffy Smile","Mikasa Scarf","Naruto Rasengan","Zoro Slash"];
const STICKERS=[["face-love","حب","#FF5C8A"],["face-laugh","ضحك","#FFC24A"],["face-rofl","قهقهة","#FBBF24"],["face-wow","انبهار","#A78BFA"],["face-shock","صدمة","#22D3EE"],["face-sad","حزن","#60A5FA"],["face-angry","غضب","#F87171"],["face-cry","بكاء","#7DD3FC"],["face-think","تفكير","#9CA3AF"],["face-plead","رجاء","#F9A8D4"],["face-mind","انفجار","#C084FC"],["heart","قلب","#FF5C8A"],["heartcrack","انكسار","#94A3B8"],["flame","نار","#FB923C"],["fire2","لهب","#F87171"],["sparkles","بريق","#FBBF24"],["star","نجمة","#FDE047"],["crown","تاج","#F59E0B"],["gem","جوهرة","#22D3EE"],["sakura","ساكورا","#F9A8D4"],["snow","ثلج","#67E8F9"],["zap","برق","#FDE047"],["party","احتفال","#F472B6"],["gift","هدية","#34D399"],["trophy","كأس","#FBBF24"],["swords","قتال","#94A3B8"],["gamepad","ألعاب","#818CF8"],["music","موسيقى","#F472B6"],["rocket","انطلاق","#FB923C"],["moon","ليل","#9CA3AF"]];
function pickSticker(ic){
  closeOvl();
  const c=S.activeChat?(S.chats||[]).find(x=>x.id===S.activeChat):null;
  if(!c){toast("افتح محادثة أولاً لإرسال الملصق","info");return}
  const mid=uid();
  const myUid=getMyUid();
  const mObj={id:mid,from:"me",senderId:myUid,senderName:S.me.name||"أنا",type:"sticker",icon:ic,text:"ملصق",at:now(),st:1,pending:true};
  c.messages.push(mObj);
  c.last="ملصق";c.lastAt=now();save();snd("send");
  const b=$("#msgs");if(b){b.insertAdjacentHTML("beforeend",msgBubble(mObj,u(c.userId),c.id));b.scrollTop=b.scrollHeight}
  syncChatMessage(c.id, mObj);
}
SHEETS.coverSheet=()=>{const cv=window.__cv||(window.__cv={img:"",ratio:"169",pos:50});
 return sheet(I("image","i s")+" "+T("محرر الغلاف"),`
  <div class="lbl">${T("نسبة العرض")}</div>
  <div class="chiprow" id="cvr">${[["169","16:9"],["31","3:1"],["45","4:5"]].map(([k,l])=>`<button class="chip ${cv.ratio===k?'on':''}" onclick="cvSet('ratio','${k}')">${l}</button>`).join("")}</div>
  <div class="lbl">${T("موضع الصورة")} — <span class="mono">${cv.pos}%</span></div>
  <input type="range" min="0" max="100" value="${cv.pos}" style="width:100%;accent-color:var(--accent)" oninput="cvSet('pos',this.value)">
  <div class="lbl">${T("اختر غلافاً")}</div>
  <div class="grid2" style="gap:8px">${COVER.map(u=>`<button style="height:62px;border-radius:12px;border:2px solid ${cv.img===u?'var(--accent)':'var(--line2)'};background:url('${u}') center ${cv.pos}%/cover;cursor:pointer" onclick="cvSet('img','${u}')"></button>`).join("")}
    <button style="height:62px;border-radius:12px;border:2px solid ${!cv.img?'var(--accent)':'var(--line2)'};background:linear-gradient(135deg,#7F1D1D,#EA580C);color:#fff;cursor:pointer" onclick="cvSet('img','')">${I("wand","i s")} ${T("تدرج افتراضي")}</button></div>
  <div class="lbl">${T("أو ارفع صورة من جهازك")}</div>
  <input type="file" id="cvFile" accept="image/*" style="display:none" onchange="cvUpload(this)">
  <button class="btn btn-sec btn-sm" onclick="document.getElementById('cvFile').click()">${I("upload","i s")} رفع غلاف حقيقي من الهاتف</button>
  <div class="lbl">${T("معاينة حية")}</div>
  <div id="cvprev" style="border-radius:14px;overflow:hidden;border:1px solid var(--line2);height:110px"></div>
  <button class="btn btn-primary btn-lg" style="margin-top:12px" onclick="cvSave()">${I("save","i s")} ${T("حفظ الغلاف")}</button>
  ${(()=>{setTimeout(cvPrev,40);return ""})()}`)};
function cvUpload(inp){const f=inp.files&&inp.files[0];if(!f)return;fileDownscale(f,1200,0.72,src=>{if(!src){toast("تعذّر قراءة الصورة","err");return}cvSet("img",src);toast("طُبّقت صورتك — احفظ الغلاف ","ok")})}
function cvSet(k,v){const cv=window.__cv||(window.__cv={img:"",ratio:"169",pos:50});cv[k]=v;
  if(k==="ratio"){const cs=document.querySelectorAll("#cvr .chip");["169","31","45"].forEach((r,i)=>{if(cs[i])cs[i].classList.toggle("on",r===v)})}
  snd("tap");cvPrev()}
function cvPrev(){const cv=window.__cv;if(!cv)return;const e=$("#cvprev");if(!e)return;
  const h={"169":110,"31":64,"45":150}[cv.ratio]||110;
  e.style.height=h+"px";
  e.style.background=cv.img?("url('"+cv.img+"') center "+cv.pos+"%/cover"):"linear-gradient(135deg,#7F1D1D,#EA580C)"}
function cvSave(){const cv=window.__cv||{img:"",ratio:"169",pos:50};
  S.me.cover=cv.img||null;S.me.coverRatio=cv.ratio;S.me.coverPos=Number(cv.pos);
  save();closeOvl();render();toast("حُفظ الغلاف","ok");snd("success")}
function insertEmojiTo(e){
  const t=$("#minp")||$("#cmtinp")||$("#pub_txt")||$("#lvmsg")||$("#streply");
  if(t){t.value+=e;t.focus();if(t.id==="pub_txt")cnt(t,500,"pub_cnt")}
  else toast("أدخلت: "+e,"info");
  closeOvl();
}
SHEETS.giftSheet=()=>{const target=S.params_gift||null;
  return sheet(I("gift","i s")+" أهدِ شيئاً",`
  <div class="tiny mut" style="margin-bottom:11px">رصيدك: <b class="mono" style="color:var(--gold)">${nfmt(S.coins)} عملة</b> · ${S.stars} نجمة</div>
  <div class="grid3">${[[50,"sakura","وردة","#F9A8D4"],[150,"flame","لهب","#FB923C"],[300,"star","نجمة","#FBBF24"],[600,"gem","جوهرة","#22D3EE"],[1200,"crown","تاج","#F59E0B"],[3000,"fire2","تنين","#F87171"]].map(([p,e,l,cl])=>`
    <button class="card2 center" style="padding:14px 6px" onclick="sendGift(${p},'${e}','${l}')">
      <span style="color:${cl};line-height:0;display:flex">${IC(e,"xl")}</span><span class="tiny b" style="display:block;margin-top:5px">${l}</span>
      <span class="badge b-gold mono" style="margin-top:4px">${nfmt(p)}</span></button>`).join("")}</div>
  <div class="div"></div>
  <div class="lbl">أو أرسل رسالة مخصصة</div>
  <textarea class="inp" rows="2" id="giftmsg" placeholder="أنت أسطوري! "></textarea>
  <button class="btn btn-gold btn-lg" style="margin-top:11px" onclick="sendGift(100,'gift','هدية')">${I("gift","i s")} إرسال هدية</button>`)};
function sendGift(p,e,l){
  if(S.coins<p){toast("رصيدك غير كافٍ ("+S.coins+"/"+p+")","err");snd("error");return}
  S.coins-=p;S.me.coins=S.coins;save();closeOvl();
  celebrate(`أرسلت ${l} بـ ${p} عملة`);
  addXP(15);render();
}
SHEETS.itemMenu=(id)=>{const i=((S.me&&S.me.inventory)||[]).find(x=>x.id===id);if(!i)return"";
  return sheet(I("gift","i s")+" "+esc(i.n),`<div class="col">
    <button class="lstrow" onclick="closeOvl();equipItem('${id}')"><span style="color:var(--emerald)">${I("check","i s")}</span><span class="g1 b xs" style="text-align:right">تجهيز</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('sellSheet','${id}')"><span style="color:var(--gold)">${I("tag","i s")}</span><span class="g1 b xs" style="text-align:right">عرض للبيع</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('swapSheet','${id}')"><span style="color:var(--purple)">${I("refresh","i s")}</span><span class="g1 b xs" style="text-align:right">مبادلة</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('shareSheet')"><span style="color:var(--cyan)">${I("share","i s")}</span><span class="g1 b xs" style="text-align:right">مشاركة</span></button>
    <button class="lstrow" onclick="S.me.inventory=S.me.inventory.filter(x=>x.id!=='${id}');save();closeOvl();render();toast('حُذف العنصر','err')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف</span></button></div>`)};
SHEETS.sellSheet=(id)=>{const i=((S.me&&S.me.inventory)||[]).find(x=>x.id===id);
  return sheet(I("tag","i s")+" عرض للبيع",`
  ${i?`<div class="lstrow" style="margin-bottom:12px"><span class="ico-tile" style="background:var(--grad-gold);color:#fff">${I(i.ic,"i s")}</span><div class="g1"><div class="b xs">${esc(i.n)}</div><div class="tiny fnt">${i.r}</div></div></div>`:""}
  <label class="lbl">السعر (عملة سوداء)</label><input class="inp mono" id="sellp" type="number" value="500" dir="ltr">
  <div style="height:9px"></div><label class="lbl">نوع البيع</label>
  <div class="chiprow">${[["buy","شراء مباشر",1],["auction","مزاد",0]].map(([k,l,on])=>`<button class="chip ${on?'on':''}" onclick="$$(this.parentNode).forEach(x=>x.classList.remove('on'));this.classList.add('on');window.__sellMode='${k}'">${l}</button>`).join("")}</div>
  <div style="height:9px"></div><label class="lbl">الوصف</label><textarea class="inp" rows="2" placeholder="اشرح حالة العنصر..."></textarea>
  <button class="btn btn-gold btn-lg" style="margin-top:12px" onclick="listItem('${id||""}')">${I("tag","i s")} اعرضه في السوق</button>`)};
function listItem(id){
  const p=parseInt(($("#sellp")||{}).value||"500");
  const i=((S.me&&S.me.inventory)||[]).find(x=>x.id===id);
  S.market.unshift({id:"mk"+uid(),n:i?i.n:"عنصر جديد",seller:S.me,price:p,mode:window.__sellMode||"buy",bids:0,endsAt:window.__sellMode==="auction"?now()+864e5:0,r:i?i.r:"rare"});
  if(i)S.me.inventory=S.me.inventory.filter(x=>x.id!==id);
  save();closeOvl();go("economy",{tab:"marketplace"});celebrate("عُرض العنصر في السوق بـ "+p+" عملة ");
}
SHEETS.swapSheet=(id)=>sheet(I("refresh","i s")+" عرض مبادلة",`
  <div class="lbl">ماذا تطلب بالمقابل؟</div>
  <div class="grid2">${[["إطار نادر","palette"],["شارة ملحمية","award"],["٥٠٠ عملة","coins"],["١٠ نجوم","star"]].map(([l,ic])=>`
    <button class="card2 center" style="padding:13px 6px" onclick="this.style.borderColor='var(--accent)';window.__swapWant='${l}';toast('مطلوب: ${l}','info')"><span style="color:var(--accent);display:flex;justify-content:center">${I(ic,"l")}</span><span class="tiny b" style="display:block;margin-top:6px">${l}</span></button>`).join("")}</div>
  <div class="lbl" style="margin-top:12px">رسالة للبائع</div><textarea class="inp" rows="2" placeholder="أعرض عليك مبادلة عادلة..."></textarea>
  <button class="btn btn-purple btn-lg" style="margin-top:12px" onclick="closeOvl();celebrate('أُرسل عرض المبادلة ')">${I("send","i s")} أرسل العرض</button>`);
SHEETS.backupCodes=()=>modal(I("key","i s")+" رموز النسخ الاحتياطي",`
  <div class="tiny mut" style="margin-bottom:11px">استخدم كل رمز مرة واحدة فقط إذا فقدت جهاز المصادقة.</div>
  <div class="grid2" style="gap:7px">${Array.from({length:10},(_,i)=>`<div class="card2 mono tiny center" style="padding:9px;letter-spacing:1px">${["K7X2","M9Q1","P4L8","R6T3","W2N5","B8C1","D3F7","G5H9","J1K4","Z6X0"][i]}-${rnd(1000,9999)}</div>`).join("")}</div>
  <div class="grid2" style="margin-top:13px"><button class="btn btn-primary" onclick="copyTxt('K7X2-1234 M9Q1-5678 ...');closeOvl()">${I("copy","i s")} نسخ الكل</button>
    <button class="btn btn-sec" onclick="toast('تم توليد ١٠ رموز جديدة ','ok');closeOvl();render()">${I("refresh","i s")} توليد جديد</button></div>`);
SHEETS.statsShare=()=>sheet(I("chart","i s")+" شارك إحصائياتك",`
  <div class="card center" style="padding:16px;background:linear-gradient(135deg,rgba(34,211,238,.14),rgba(168,85,247,.09))">
    <div class="bb grad-txt" style="font-size:17px">بطاقة الأوتاكو</div>
    <div style="margin:11px 0">${av(S.me,66,true)}</div>
    <div class="b sm">${esc(S.me.name)}</div><div class="tiny fnt mono">@${esc(S.me.username)}</div>
    <div class="grid4" style="margin-top:12px">${[["المستوى",S.me.level],["حلقات",nfmt(S.me.episodes)],["ساعات",nfmt(S.me.watchHours)],["سمعة",nfmt(S.me.reputation)]].map(([l,v])=>`
      <div class="card2 stat"><b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div></div>
  <div class="grid2" style="margin-top:12px"><button class="btn btn-primary" onclick="saveOtakuCard()">${I("download","i s")} حفظ صورة</button>
    <button class="btn btn-sec" onclick="closeOvl();openSheet('shareSheet')">${I("share","i s")} مشاركة</button></div>`);
SHEETS.whySheet=()=>modal(I("wand","i s")+" لماذا هذه التوصيات؟",`
  <div class="col">${(S.lastRecs||[]).slice(0,4).map((r,i)=>`<div class="lstrow" style="padding:10px"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:var(--surface3);color:var(--purple)">${I("sparkles","i s")}</span>
    <div class="g1"><div class="tiny b">${esc(r.t)||"محتوى مقترح"}</div><div class="tiny fnt" style="color:var(--accent)">${esc(r.why)}</div></div><span class="badge b-purple mono">${i+1}</span></div>`).join("")||'<div class="tiny fnt">افتح توصيات الذكاء أولاً</div>'}</div>
  <div class="card2" style="padding:12px;margin-top:12px"><div class="b xs">${I("info","i s")} إشاراتك الحقيقية</div><div class="tiny fnt" style="margin-top:5px">سجل المشاهدة: ${(S.me.history||[]).length} عنصر · إعجاباتك: ${S.posts.filter(p=>p.liked).length} · متابَعوك: ${(S.following||[]).length} · المزاج: ${S.aiMood} · بذرة الجولة: ${S.recSeed||0}. بياناتك لا تغادر الجهاز.</div></div>
  <div class="grid2" style="margin-top:12px"><button class="btn btn-primary" onclick="S.aiMood='deep_cuts';save();closeOvl();render();toast('تم التبديل إلى الجواهر المخفية ','ok')">جرّب جواهر مخفية</button>
    <button class="btn btn-ghost" onclick="closeOvl()">إغلاق</button></div>`);
SHEETS.filterSheet=()=>{const ff=S.ff=S.ff||{types:[],cats:[],from:"all",dup:false,spoiler:true,sens:false,rep:false};
 return sheet(I("filter","i s")+" تصفية الخلاصة",`
  <div class="lbl">نوع المحتوى</div>
  <div class="chiprow wrap">${[["text","منشورات نصية"],["photo","صور"],["video","فيديو"],["poll","استطلاعات"]].map(([k,l])=>`<button class="chip ${ff.types.includes(k)?"on":""}" onclick="ffT('types','${k}')">${l}</button>`).join("")}</div>
  <div class="lbl" style="margin-top:11px">التصنيفات</div>
  <div class="chiprow wrap">${CATS8.map(c=>`<button class="chip ${ff.cats.includes(c)?"on":""}" onclick="ffT('cats','${c}')">${c}</button>`).join("")}</div>
  <div class="lbl" style="margin-top:11px">من</div>
  <div class="chiprow wrap">${[["all","الجميع"],["follow","المتابَعون"],["guild","النقابات"],["verif","الموثّقون"]].map(([k,l])=>`<button class="chip ${ff.from===k?"on":""}" onclick="ffFrom('${k}')">${l}</button>`).join("")}</div>
  <div class="div"></div>
  <div class="col">${[["dup","إخفاء المحتوى المكرر"],["spoiler","تمويه السبويلر حتى الطلب"],["sens","تصفية الكلمات الحساسة"],["rep","ترتيب حسب السمعة"]].map(([k,l])=>`<div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px"><span class="xs b">${l}</span><span class="sw ${ff[k]?"on":""}" onclick="ffO('${k}')"></span></div>`).join("")}</div>
  <div class="grid2" style="margin-top:13px"><button class="btn btn-primary" onclick="closeOvl();render();snd('success');toast('طُبّقت التصفية على الخلاصة ','ok')">${I("check","i s")} تطبيق (${ffCount()})</button>
    <button class="btn btn-ghost" onclick="ffReset();openSheet('filterSheet')">${I("refresh","i s")} إعادة الضبط</button></div>`)};
SHEETS.feelingSheet=()=>sheet(I("flame","i s")+" بماذا تشعر؟",`
  <div class="grid4" style="gap:8px">${[["flame","متحمس","#FB923C"],["face-love","مبهور","#F472B6"],["face-cry","متأثر","#7DD3FC"],["face-mind","مصدوم","#C084FC"],["moon","متعب","#9CA3AF"],["zap","متحمز","#FDE047"],["heart","أوتاكو","#FF5C8A"],["crown","فخور","#F59E0B"],["clapper","مشاهد","#A78BFA"],["book","قارئ","#60A5FA"],["star","لاعب","#FBBF24"],["sakura","حالم","#F9A8D4"]].map(([ic,l,cl])=>`
    <button class="card2 center" style="padding:12px 4px" onclick="closeOvl();S.draftFeeling='${l}';save();render();const _ft=$('#pub_txt');if(_ft)_ft.value=S.draftText||'';toast('سيظهر المنشور بشعور: ${l} ','ok')"><span style="color:${cl};line-height:0;display:flex">${IC(ic,"xl")}</span><span class="tiny b" style="display:block;margin-top:4px">${l}</span></button>`).join("")}</div>`);
SHEETS.privacySheet=()=>sheet(I("lock","i s")+" خصوصية مخصصة",`
  <div class="lbl">اختر من يرى هذا المنشور</div>
  <div class="col">${S.users.map(x=>`<button class="lstrow" style="padding:10px" data-uid="${x.id}" onclick="this.querySelector('.sw').classList.toggle('on');snd('tap')">${av(x,36)}
    <span class="g1" style="text-align:right"><span class="b xs">${esc(x.name)}</span><span class="tiny fnt" style="display:block">@${esc(x.username)}</span></span>
    <span class="sw on"></span></button>`).join("")}</div>
  <div class="grid2" style="margin-top:13px"><button class="btn btn-primary" onclick="applyCustomPriv()">${I("check","i s")} تطبيق</button>
    <button class="btn btn-ghost" onclick="closeOvl()">إلغاء</button></div>`);
SHEETS.draftSheet=()=>{const ds=S.postDrafts||[];const sch=S.scheduledPosts||[];
 return sheet(I("save","i s")+" المسودات والمجدول",`<div class="col">
  <div class="b xs">${I("file","i s")} مسودات المنشورات (${ds.length})</div>
  ${ds.length?ds.map(d=>`<div class="rowb" style="padding:9px 2px;border-bottom:1px solid var(--line)"><button class="g1" style="text-align:right;background:none;border:none" onclick="restoreDraft2('${d.id}')"><span class="b xs" style="display:block">${esc((d.txt||"مسودة بلا نص").slice(0,46))}</span><span class="tiny fnt">${ago(d.at)} · ${(d.tags||[]).length} وسم · ${d.priv==="public"?"الجميع":d.priv}</span></button><button class="btn btn-sec btn-xs" onclick="delStoryDraft('${d.id}')" aria-label="حذف المسودة">${I("trash","i s")}</button></div>`).join(""):`<div class="tiny fnt center" style="padding:10px">لا مسودات محفوظة بعد — احفظها من زر «حفظ مسودة»</div>`}
  ${ds.length?`<button class="btn btn-ghost btn-xs" style="margin-top:9px" onclick="S.postDrafts=[];save();openSheet('draftSheet');toast('مُسحت كل المسودات ','info')">${I("trash","i s")} مسح كل المسودات</button>`:""}
  <div class="div" style="margin:12px 0"></div>
  <div class="b xs">${I("clock","i s")} المنشورات المجدولة (${sch.length})</div>
  ${sch.length?sch.map(x=>`<div class="row" style="gap:6px;padding:8px 2px;border-bottom:1px solid var(--line)"><span class="g1 tiny" style="text-align:right">${esc((x.txt||"منشور مجدول").slice(0,40))}</span><button class="btn btn-primary btn-xs" onclick="pubScheduled('${x.id}')">نشر الآن</button><button class="btn btn-sec btn-xs" onclick="S.scheduledPosts=(S.scheduledPosts||[]).filter(y=>y.id!=='${x.id}');save();openSheet('draftSheet');toast('أُلغيت الجدولة ','info')">إلغاء</button></div>`).join(""):`<div class="tiny fnt center" style="padding:8px">لا منشورات مجدولة</div>`}
 </div>`)};
function restoreDraft2(id){const d=(S.postDrafts||[]).find(x=>x.id===id);if(!d)return;S.postDrafts=(S.postDrafts||[]).filter(x=>x.id!==id);S.draftTags=(d.tags||[]).slice();save();closeOvl();go('create',{type:'post'},false);setTimeout(()=>{const t=$("#pub_txt");if(t){t.value=d.txt||"";cnt(t,500,"pub_cnt")}const tb=$("#tagbox");if(tb&&d.tags)tb.innerHTML=d.tags.map(tagChip).join("");window.__priv=d.priv||"public";toast("استُعيدت المسودة — أكمل وانشر ","ok")},90)}
function delDraft(id){S.postDrafts=(S.postDrafts||[]).filter(x=>x.id!==id);save();openSheet('draftSheet');toast("حُذفت المسودة ","info")}
SHEETS.pwaSheet=()=>modal(I("cloud","i s")+" تثبيت كتطبيق ويب",`
  <div class="center"><img class="logoimg" src="data:image/jpeg;base64," alt="أنمي بلاك" style="width:76px;height:76px;border-radius:24px;box-shadow:0 8px 26px rgba(34,211,238,.4)">
    <div class="bb" style="margin-top:11px">Anime Black PWA</div><div class="tiny fnt">يعمل دون اتصال · إشعارات فورية · بدون متجر</div></div>
  <div class="col" style="margin-top:14px">${[["download","تثبيت فوري بدون متجر"],["cloud","يعمل دون اتصال بالكامل"],["bell","إشعارات Push حقيقية"],["zap","يستهلك مساحة أقل بـ ٧٠٪"]].map(([ic,l])=>`
    <div class="row" style="gap:9px"><span style="color:var(--emerald)">${I("check","i s")}</span><span class="xs b">${l}</span></div>`).join("")}</div>
  <button class="btn btn-primary btn-lg" style="margin-top:14px" onclick="S.installed=true;save();closeOvl();celebrate('تم تثبيت التطبيق على جهازك ')">${I("download","i s")} تثبيت الآن</button>
  <div class="card2" style="padding:11px;margin-top:11px"><div class="b tiny">${I("info","i s")} خطوات يدوية</div><ol class="tiny fnt" style="margin:6px 18px 0"><li>اضغط قائمة المتصفح ⋮</li><li>اختر «إضافة إلى الشاشة الرئيسية»</li><li>أكّد التثبيت</li></ol></div>`);
SHEETS.hubCustomize=()=>sheet(I("settings","i s")+" تخصيص الاختصارات",`
  <div class="tiny mut" style="margin-bottom:11px">رتّب وأظهر/أخفِ الاختصارات السريعة (١٠ متاحة)</div>
  <div class="col">${SHORTCUTS.map(([id,l,ic,g],i)=>`
    <div class="row" style="gap:9px;padding:9px;background:var(--surface2);border-radius:12px">
      <span class="col" style="gap:2px"><button class="iconbtn" style="width:22px;height:18px;border-radius:6px" onclick="hubMove('${id}',-1)">${I("chevup","i s")}</button><button class="iconbtn" style="width:22px;height:18px;border-radius:6px" onclick="hubMove('${id}',1)">${I("chevdown","i s")}</button></span>
      <span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:${g};color:#fff">${I(ic,"i s")}</span>
      <span class="g1 b xs">${l}</span><span class="sw ${(S.hubHidden||[]).includes(id)?'':'on'}" onclick="hubToggle('${id}')"></span></div>`).join("")}</div>
  <button class="btn btn-primary btn-lg" style="margin-top:13px" onclick="closeOvl();toast('حُفظ التخصيص ','ok');snd('success')">${I("save","i s")} حفظ</button>`);
SHEETS.animeMenu=(id)=>{const a=((S.wiki&&S.wiki.anime)||[]).find(x=>x.id===id);
  return sheet(I("film","i s")+" "+esc(a?a.n:""),`<div class="col">
    ${[["heart","أضف إلى المفضلة",`toggleFavAnime('${id}');closeOvl()`],["check","أضف لقائمة المتابعة",`trackAnime('${id}',null);closeOvl();toast('أُضيف لقائمتك ','ok')`],
       ["clock","ذكرني بالحلقة القادمة",`toast('سنذكّرك كل خميس ','ok');closeOvl()`],["star","قيّم العمل",`closeOvl();openSheet('rateSheet','${id}')`],
       ["msgsq","ناقش في المجتمع",`closeOvl();go('create',{type:'post'})`],["share","مشاركة",`closeOvl();openSheet('shareSheet')`],
       ["flag","الإبلاغ عن معلومات خاطئة",`toast('شكراً! سنراجع المعلومات','ok');closeOvl()`]].map(([ic,l,fn])=>`
      <button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}</div>`)};
SHEETS.rateSheet=(id)=>sheet(I("star","i s")+" قيّم العمل",`
  <div class="center row" style="justify-content:center;gap:7px;margin:14px 0">${[1,2,3,4,5].map(i=>`
    <button style="font-size:34px;filter:${i<=4?'none':'grayscale(1) opacity(.4)'}" onclick="rateIt(${i})"></button>`).join("")}</div>
  <div class="tiny fnt center" id="ratetxt">اختر من ١ إلى ٥</div>
  <div class="lbl" style="margin-top:14px">مراجعتك (اختياري)</div><textarea class="inp" rows="3" placeholder="ما رأيك بالعمل؟ بدون سبويلر..."></textarea>
  <button class="btn btn-gold btn-lg" style="margin-top:12px" onclick="closeOvl();celebrate('شكراً! نُشرت مراجعتك ')">${I("send","i s")} أرسل التقييم</button>`);
function rateIt(n){$$("#ovl button[style*='font-size:34px']").forEach((b,i)=>b.style.filter=i<n?"none":"grayscale(1) opacity(.4)");$("#ratetxt").textContent=n+" من ٥ — "+["سيئ","ضعيف","جيد","ممتاز","تحفة!"][n-1];snd("tap")}
SHEETS.reelMenu=(id)=>sheet(I("clapper","i s")+" خيارات الريلز",`<div class="col">
  ${[["download","تنزيل الريلز",`toast('جارٍ التنزيل ','ok');closeOvl()`],["link","نسخ الرابط",`copyTxt('animeblack.app/reel/${id||''}');closeOvl()`],
     ["music","استخدم هذا الصوت",`toast('فتح محرر الريلز بالصوت ','ok');closeOvl();go('create',{type:'reel'})`],
     ["eyeoff","لست مهتماً",`S.reels=S.reels.filter(x=>x.id!=='${id}');save();closeOvl();back();toast('لن نعرضه مجدداً','info')`],
     ["flag","إبلاغ",`closeOvl();go('report',{id:'${id}'})`]].map(([ic,l,fn])=>`
    <button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}</div>`);
SHEETS.storyMenu=(sid)=>{const st=(S.stories||[]).find(x=>x.id===sid);if(!st)return sheet(I("clock","i s")+" القصة","<div class='tiny fnt'>القصة غير موجودة</div>");
  const mine=st.userId==="me";const ii=S.params.i||0;
  const rows=mine?[["eye","مشاهدات القصة ("+((st.views||[]).length)+")",`openSheet('viewsSheet','${sid}')`],
    ["barchart","نتائج الملصقات والتفاعلات",`openSheet('resultsSheet','${sid}')`],
    ["download","حفظ القصة كصورة PNG حقيقية",`saveStoryPNG('${sid}',${ii})`],
    ["star","إضافة إلى أبرز اللحظات",`addHighlight('${sid}',${ii})`],
    ["trash","حذف عنصر القصة هذا",`delStoryItem('${sid}',${ii})`]]
  :[["share","مشاركة القصة",`closeOvl();openSheet('shareSheet')`],
    ["link","نسخ رابط القصة",`copyTxt('animeblack.app/story/${sid}');closeOvl()`],
    ["eyeoff","كتم قصص هذا المستخدم",`muteStory('${sid}')`],
    ["flag","إبلاغ عن القصة",`closeOvl();go('report',{id:'${sid}'})`]];
  return sheet(I("clock","i s")+" خيارات القصة",`<div class="col">${rows.map(([ic,l,fn])=>`<button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}</div>`)};
SHEETS.pubProfileMenu=(id)=>{const x=u(id);const mine=id==="me";
  return sheet(I("user","i s")+" "+esc(x.name),`<div class="col">
    ${mine?`<button class="lstrow" onclick="closeOvl();go('editProfile')"><span style="color:var(--accent)">${I("edit","i s")}</span><span class="g1 b xs" style="text-align:right">تعديل الملف الشخصي</span></button>
      <button class="lstrow" onclick="closeOvl();go('qrCard')"><span style="color:var(--accent)">${I("qr","i s")}</span><span class="g1 b xs" style="text-align:right">بطاقتي الرقمية</span></button>`:`
      <button class="lstrow" onclick="closeOvl();startChat('${id}')"><span style="color:var(--emerald)">${I("chat","i s")}</span><span class="g1 b xs" style="text-align:right">مراسلة</span></button>
      <button class="lstrow" onclick="follow('${id}');closeOvl()"><span style="color:var(--accent)">${I("usercheck","i s")}</span><span class="g1 b xs" style="text-align:right">${S.following.includes(id)?"إلغاء المتابعة":"متابعة"}</span></button>
      <button class="lstrow" onclick="closeOvl();openSheet('giftSheet')"><span style="color:var(--gold)">${I("gift","i s")}</span><span class="g1 b xs" style="text-align:right">إرسال هدية</span></button>
      <button class="lstrow" onclick="closeOvl();openSheet('shareProfile','${id}')"><span style="color:var(--cyan)">${I("share","i s")}</span><span class="g1 b xs" style="text-align:right">مشاركة الملف</span></button>`}
    <button class="lstrow" onclick="copyTxt('animeblack.app/@${x.username}');closeOvl();toast('نُسخ رابط الملف ','ok')"><span style="color:var(--accent)">${I("link","i s")}</span><span class="g1 b xs" style="text-align:right">نسخ رابط الملف</span></button>
    ${!mine?`<button class="lstrow" onclick="closeOvl();go('report',{id:'${id}'})"><span style="color:var(--rose)">${I("flag","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">إبلاغ</span></button>
      <button class="lstrow" onclick="blockUser('${id}');closeOvl();back()"><span style="color:var(--rose)">${I("ban","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حظر</span></button>`:""}
  </div>`)};
function toggleLinked(k,l){S.me.linked=Object.assign({google:true,email:true,apple:false,phone:false},S.me.linked||{});S.me.linked[k]=!S.me.linked[k];save();render();toast((S.me.linked[k]?"تم ربط ":"أُلغي ربط ")+l+" ",S.me.linked[k]?"ok":"info");snd("tap")}
function showAppLock(){if($("#applock"))return;const d=document.createElement("div");d.id="applock";d.style.cssText="position:fixed;inset:0;z-index:999;background:rgba(5,5,8,.97);display:flex;align-items:center;justify-content:center";d.innerHTML=`<div class="col center" style="gap:12px;padding:30px"><span style="color:var(--accent);line-height:0">${I("lock","xxl")}</span><div class="bb" style="color:#fff">أنمي بلاك مقفل</div><div class="tiny fnt" style="color:rgba(255,255,255,.6)">أدخل رمز PIN للمتابعة</div><input id="pininp" class="inp mono center" type="password" inputmode="numeric" maxlength="4" style="width:150px;letter-spacing:8px;font-size:22px"><button class="btn btn-primary" onclick="tryUnlock()">${I("unlock","i s")} فتح</button>${(S.appLock||{}).fp?`<button class="btn btn-ghost btn-sm" onclick="unlockFP()">${I("fingerprint","i s")} فتح بالبصمة</button>`:""}</div>`;document.body.appendChild(d);const i=$("#pininp");if(i)i.onkeydown=e=>{if(e.key==="Enter")tryUnlock()}}
function tryUnlock(){const i=$("#pininp");const v=i?i.value:"";if(v===String(S.appPin)){const d=$("#applock");if(d)d.remove();snd("success");toast("فُتح القفل ","ok")}else{snd("error");toast("رمز خاطئ ","err");if(i)i.value=""}}
function unlockFP(){const d=$("#applock");if(d)d.remove();snd("success");toast("فُتح بالبصمة ","ok")}
function appLockToggle(k){S.appLock=Object.assign({fp:false,pin:false,hide:false,alert:false},S.appLock||{});
  if(k==="pin"){if(!S.appLock.pin){openSheet("pinSheet");return}S.appLock.pin=false;S.appPin=null;save();toast("أُلغي قفل PIN ","info");render();return}
  S.appLock[k]=!S.appLock[k];save();snd("tap");toast((({fp:"قفل البصمة",hide:"إخفاء المقفلة",alert:"تنبيه الدخول"})[k]||k)+": "+(S.appLock[k]?"مفعّل":"معطّل"),"info");render()}
SHEETS.pinSheet=()=>sheet(I("lock","i s")+" قفل التطبيق برمز PIN",`<div class="col"><div class="tiny fnt">رمز من ٤ أرقام يُطلب عند كل فتح للتطبيق</div>
  ${S.appPin?`<div class="rowb" style="margin:8px 0"><span class="xs b">الحالة</span><span class="badge b-emerald">مفعّل</span></div>`:""}
  <label class="lbl">الرمز ${S.appPin?"الجديد":""}</label><input class="inp mono" id="pin1" type="password" inputmode="numeric" maxlength="4" placeholder="••••" dir="ltr">
  <label class="lbl" style="margin-top:8px">تأكيد الرمز</label><input class="inp mono" id="pin2" type="password" inputmode="numeric" maxlength="4" placeholder="••••" dir="ltr">
  <button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="setAppPin()">${I("check","i s")} حفظ الرمز وتفعيل القفل</button>
  ${S.appPin?`<button class="btn btn-danger btn-sm" style="margin-top:7px" onclick="S.appPin=null;S.appLock=Object.assign(S.appLock||{},{pin:false});save();closeOvl();toast('أُلغي قفل PIN ','info');render()">${I("trash","i s")} إلغاء القفل</button>`:""}</div>`);
function setAppPin(){const a=($("#pin1")||{}).value||"",b2=($("#pin2")||{}).value||"";if(!/^\d{4}$/.test(a)){toast("الرمز ٤ أرقام بالضبط ","err");return}if(a!==b2){toast("التأكيد غير مطابق ","err");return}S.appPin=a;S.appLock=Object.assign(S.appLock||{},{pin:true});save();closeOvl();celebrate("فُعّل قفل PIN — سيُطلب الرمز عند كل فتح ");if(S.page==="security")render()}
function setList(){const q=(S.setQ||"").trim();const idx=[];HUB_GROUPS.forEach(g=>g.items.forEach(it=>idx.push([it[1],it[0],"hub"])));SHORTCUTS.forEach(sc=>idx.push([sc[1],sc[0],"sc"]));[["hubSettings","إعدادات مركز التحكم"],["security","الأمان والتوثيق"],["privacySettings","الخصوصية"],["appearance","المظهر"],["economy","متجر الاقتصاد"],["activity","المهام والفعاليات"],["devCenter","بوابة المطورين"],["admin","الإدارة أنمي بلاك"],["permissions","أذونات التطبيق"],["twofa","المصادقة الثنائية"],["qrCard","بطاقتي الرقمية"],["gmail","بريد Gmail"]].forEach(r=>idx.push([r[1],r[0],"go"]));
  const list=q?idx.filter(x=>x[0].includes(q)):idx.slice(0,12);
  return list.length?list.map(([l,id,kind])=>{const fn=kind==="hub"?"hubGo('"+id+"')":kind==="sc"?"hubShortcut('"+id+"')":"go('"+id+"')";return `<button class="lstrow" style="padding:9px" onclick="closeOvl();${fn}"><span style="color:var(--accent)">${I("fwd","i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`}).join(""):`<div class="center tiny mut" style="padding:14px 0">لا نتائج مطابقة</div>`}
SHEETS.searchSheet=()=>sheet(I("search","i s")+" بحث في الإعدادات",`<div class="row" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:12px;padding:9px 11px;margin-bottom:10px">${I("search","i s")}<input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث عن أي إعداد أو صفحة..." value="${esc(S.setQ||"")}" oninput="S.setQ=this.value;const e=$('#setres');if(e)e.innerHTML=setList()"></div><div class="col" id="setres">${setList()}</div>`);
function saveCardSVG(){const m=S.me;const uri="ANIMEBLACK://USER/"+m.username.toUpperCase();let cells="";for(let y=0;y<21;y++)for(let x=0;x<21;x++){if(strHash(m.username+"q"+x+"_"+y)%3===0)cells+=`<rect x="${x*8}" y="${y*8}" width="8" height="8" fill="#0A0A0F"/>`}
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="420" height="560" viewBox="0 0 420 560"><rect width="420" height="560" rx="26" fill="#121212"/><rect x="20" y="20" width="380" height="520" rx="20" fill="#1B1B1F"/><text x="210" y="70" text-anchor="middle" fill="#FF7A00" font-size="26" font-weight="800" font-family="sans-serif">${esc(m.name)}</text><text x="210" y="98" text-anchor="middle" fill="#9CA3AF" font-size="15" font-family="monospace">@${esc(m.username)}</text><rect x="110" y="130" width="200" height="200" fill="#fff"/><g transform="translate(116,136)">${cells}</g><text x="210" y="370" text-anchor="middle" fill="#E5E7EB" font-size="13" font-family="monospace">${esc(uri)}</text><text x="210" y="510" text-anchor="middle" fill="#6B7280" font-size="12" font-family="sans-serif">Anime Black v25.0</text></svg>`;
  if(dl("animeblack-card.svg",svg,"image/svg+xml")){toast("حُفظت بطاقتك كصورة SVG حقيقية ","ok");snd("success")}else toast("تعذّر الحفظ ","err")}
SHEETS.roomMsgMenu=(mid)=>{const m=msgById(mid);if(!m)return sheet("الرسالة","<div class='tiny fnt'>غير موجودة</div>");
  const isGroup=S.page==="groupRoom";const room=isGroup?(S.groups||[]).find(x=>x.id===S.params.id):(S.worlds||[]).find(x=>x.id===S.params.id);
  const amI=room?(isGroup?(room.admins||[]).includes("me")||room.owner==="me":room.owner==="me"):false;
  return sheet(I("msgsq","i s")+" خيارات الرسالة",`<div class="col">
    <button class="lstrow" style="padding:11px" onclick="closeOvl();${isGroup?`S.gReply={g:'${(room||{}).id}',m:'${mid}'}`:`S.wReply={w:'${(room||{}).id}',m:'${mid}'}`};render()"><span style="color:var(--accent)">${I("reply","i s")}</span><span class="g1 b xs" style="text-align:right">رد</span></button>
    <button class="lstrow" style="padding:11px" onclick="closeOvl();try{navigator.clipboard&&navigator.clipboard.writeText(${JSON.stringify(String(m.text||'')).replace(/"/g,'&quot;')})}catch(e){};toast('نُسخ النص ','ok')"><span style="color:var(--cyan)">${I("copy","i s")}</span><span class="g1 b xs" style="text-align:right">نسخ النص</span></button>
    ${amI?`<button class="lstrow" style="padding:11px" onclick="roomPinMsg('${mid}')"><span style="color:var(--gold)">${I("pin","i s")}</span><span class="g1 b xs" style="text-align:right">تثبيت أعلى الغرفة</span></button>`:""}
    ${m.uid==="me"||amI?`<button class="lstrow" style="padding:11px" onclick="roomDelMsg('${mid}')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف الرسالة</span></button>`:""}
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('msgInfo','${mid}')"><span style="color:var(--muted)">${I("info","i s")}</span><span class="g1 b xs" style="text-align:right">معلومات الرسالة</span></button></div>`)};
function roomPinMsg(mid){const m=msgById(mid);if(!m)return;const isGroup=S.page==="groupRoom";const room=isGroup?(S.groups||[]).find(x=>x.id===S.params.id):(S.worlds||[]).find(x=>x.id===S.params.id);if(!room)return;room.pinned=m.text||"وسائط مثبتة";save();closeOvl();render();toast("ثُبّتت الرسالة أعلى الغرفة ","ok")}
function roomDelMsg(mid){const isGroup=S.page==="groupRoom";const room=isGroup?(S.groups||[]).find(x=>x.id===S.params.id):(S.worlds||[]).find(x=>x.id===S.params.id);if(!room)return;room.msgs=room.msgs.filter(x=>x.id!==mid);save();closeOvl();render();toast("حُذفت الرسالة ","info")}
SHEETS.groupAnnounce=(id)=>sheet(I("shield","i s")+" إعلان القروب",`<div class="col"><div class="tiny fnt mut">يظهر كشريط رسمي أعلى رسائل القروب لكل الأعضاء</div><textarea class="inp" id="ga_t" rows="2" placeholder="نص الإعلان...">${esc((((S.groups||[]).find(x=>x.id===id)||{}).announce||{}).text||"")}</textarea><button class="btn btn-primary btn-sm" style="margin-top:9px" onclick="gaPublish('${id}')">${I("send","i s")} نشر الإعلان</button>${((S.groups||[]).find(x=>x.id===id)||{}).announce?`<button class="btn btn-sec btn-sm" style="margin-top:7px" onclick="const g=(S.groups||[]).find(x=>x.id==='${id}');g.announce=null;save();closeOvl();render();toast('أُلغي الإعلان ','info')">${I("trash","i s")} إلغاء الإعلان الحالي</button>`:""}</div>`);
function gaPublish(id){const g=(S.groups||[]).find(x=>x.id===id);const t=($("#ga_t")||{}).value||"";if(!t.trim()){toast("اكتب نص الإعلان ","err");return}g.announce={text:t.trim(),at:now()};save();closeOvl();render();toast("نُشر الإعلان أعلى القروب ","ok");snd("success")}
SHEETS.groupMenu=(id)=>{const g=(S.groups||[]).find(x=>x.id===id);if(!g)return sheet("القائمة","<div class='tiny fnt'>لا قروب</div>");const amI=g.admins.includes("me")||g.owner==="me";
  return sheet(I(g.icon,"i s")+" "+esc(g.name),`<div class="col">
    ${amI?`<label class="lbl">اسم القروب</label><div class="row" style="gap:7px"><input class="inp g1" id="gr_n" value="${esc(g.name)}"><button class="btn btn-sec btn-xs" onclick="groupRename('${g.id}')">${I("check","i s")}</button></div>
    <label class="lbl" style="margin-top:8px">الوصف</label><div class="row" style="gap:7px"><input class="inp g1" id="gr_d" value="${esc(g.desc)}"><button class="btn btn-sec btn-xs" onclick="groupDesc('${g.id}')">${I("check","i s")}</button></div>
    <div class="rowb" style="margin-top:10px"><span class="xs b">${I("alert","i s")} وضع الإعلانات (مشرفون فقط)</span><span class="sw ${g.announce?'on':''}" onclick="groupToggle('${g.id}','announce')"></span></div>
    <div class="rowb"><span class="xs b">${I("pin","i s")} تثبيت آخر رسالة</span><span class="sw ${g.pinned?'on':''}" onclick="groupToggle('${g.id}','pinned')"></span></div>
    <div class="rowb"><span class="xs b">${I("lock","i s")} قروب خاص</span><span class="sw ${g.privacy==='خاص'?'on':''}" onclick="groupToggle('${g.id}','privacy')"></span></div>`:`<div class="tiny fnt mut">أنت عضو — خيارات العضو فقط</div>`}
    <div class="rowb"><span class="xs b">${I("mute","i s")} كتم القروب</span><span class="sw ${g.muted?'on':''}" onclick="groupToggle('${g.id}','muted')"></span></div>
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('groupMembers','${g.id}')"><span style="color:var(--accent)">${I("users","i s")}</span><span class="g1 b xs" style="text-align:right">الأعضاء (${(g.members||[]).length})</span></button>
    ${amI?`<button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('groupAnnounce','${g.id}')"><span style="color:var(--gold)">${I("shield","i s")}</span><span class="g1 b xs" style="text-align:right">إعلان رسمي للقروب</span></button>`:""}
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('groupAdd','${g.id}')"><span style="color:var(--accent)">${I("usercheck","i s")}</span><span class="g1 b xs" style="text-align:right">دعوة أعضاء</span></button>
    ${amI?`<button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('joinReqSheet','group|${g.id}')"><span style="color:var(--gold)">${I("inbox","i s")}</span><span class="g1 b xs" style="text-align:right">طلبات الانضمام ${(S.joinReqs||[]).filter(r=>r.kind==="group"&&r.id===g.id&&r.uid!=="me").length?`<span class="badge b-red mono">${(S.joinReqs||[]).filter(r=>r.kind==="group"&&r.id===g.id&&r.uid!=="me").length}</span>`:""}</span></button>`:""}
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('shareProfile')"><span style="color:var(--accent)">${I("share","i s")}</span><span class="g1 b xs" style="text-align:right">مشاركة القروب</span></button>
    ${g.owner==="me"?`<button class="lstrow" style="padding:11px" onclick="deleteGroup('${g.id}')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف القروب</span></button>`:`<button class="lstrow" style="padding:11px" onclick="leaveGroup('${g.id}')"><span style="color:var(--rose)">${I("logout","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">مغادرة القروب</span></button>`}
  </div>`)};SHEETS.groupMembers=(id)=>{const g=(S.groups||[]).find(x=>x.id===id);if(!g)return sheet("الأعضاء","");const amI=g.admins.includes("me")||g.owner==="me";
  return sheet(I("users","i s")+" أعضاء "+esc(g.name),`<div class="col">${g.members.map(mid=>{const mu=mid==="me"?S.me:u(mid);return `<div class="row" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span>${av(mu,32)}</span>
    <div class="g1"><div class="b xs">${mid==="me"?"أنت":esc(mu.name)} ${g.owner===mid?`<span class="badge b-gold">المالك</span>`:g.admins.includes(mid)?`<span class="badge b-cyan">مشرف</span>`:""}</div><div class="tiny fnt">${esc(mu.role||"عضو")}</div></div>
    ${amI&&mid!=="me"&&g.owner!==mid?`<div class="row" style="gap:5px"><button class="btn btn-sec btn-xs" onclick="groupPromote('${g.id}','${mid}')">${g.admins.includes(mid)?I("usercheck","i s")+" تنزيل":I("crown","i s")+" ترقية"}</button><button class="btn btn-sec btn-xs" onclick="groupKick('${g.id}','${mid}')">${I("x","i s")} إزالة</button></div>`:""}</div>`}).join("")}
    <button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="closeOvl();openSheet('groupAdd','${g.id}')">${I("usercheck","i s")} دعوة أعضاء</button></div>`)};SHEETS.groupAdd=(id)=>{const g=(S.groups||[]).find(x=>x.id===id)||S.groups[0];if(!g)return sheet("دعوة","<div class='tiny fnt'>لا قروبات</div>");const cand=S.users.filter(x=>!g.members.includes(x.id));
  return sheet(I("usercheck","i s")+" دعوة إلى "+esc(g.name),`<div class="col">${cand.map(x=>`<div class="row" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span>${av(x,32)}</span>
    <div class="g1"><div class="b xs">${esc(x.name)}</div><div class="tiny fnt">${esc(x.role)}</div></div>
    <button class="btn btn-primary btn-xs" onclick="groupInvite('${g.id}','${x.id}')">${I("plus","i s")} دعوة</button></div>`).join("")||`<div class="tiny fnt mut">كل المستخدمين أعضاء بالفعل</div>`}</div>`)};SHEETS.worldRules=(id)=>{const w=(S.worlds||[]).find(x=>x.id===id);if(!w)return sheet("القوانين","");
  return sheet(I("info","i s")+" قوانين "+esc(w.name),`<div class="col">
    <ol class="xs mut" style="margin:0 18px">${(w.rules||[]).map(r=>`<li style="margin-bottom:7px">${esc(r)}</li>`).join("")||"<li>لا قوانين معلنة</li>"}</ol>
    ${w.owner==="me"?`<div class="row" style="gap:7px;margin-top:8px"><input class="inp g1" id="wr_n" placeholder="أضف قانوناً جديداً"><button class="btn btn-sec btn-xs" onclick="worldAddRule('${w.id}')">${I("plus","i s")}</button></div>`:`<div class="tiny fnt" style="margin-top:8px">المخالفة تعرضك للطرد من العالم</div>`}</div>`)};SHEETS.worldMenu=(id)=>{const w=(S.worlds||[]).find(x=>x.id===id);if(!w)return sheet("القائمة","");
  return sheet(I(w.icon,"i s")+" "+esc(w.name),`<div class="col">
    <div class="rowb"><span class="xs b">${I("users","i s")} الأعضاء</span><span class="badge b-gray mono">${nfmt(w.members)}</span></div>
    <div class="rowb"><span class="xs b">${I("zap","i s")} متصلون الآن</span><span class="badge b-emerald mono">${w.online}</span></div>
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('worldRules','${w.id}')"><span style="color:var(--accent)">${I("info","i s")}</span><span class="g1 b xs" style="text-align:right">قوانين العالم</span></button>
    <button class="lstrow" style="padding:11px" onclick="closeOvl();openSheet('shareProfile')"><span style="color:var(--accent)">${I("share","i s")}</span><span class="g1 b xs" style="text-align:right">مشاركة العالم</span></button>
    <button class="lstrow" style="padding:11px" onclick="worldPin('${w.id}')"><span style="color:var(--gold)">${I("pin","i s")}</span><span class="g1 b xs" style="text-align:right">${w.pinned?"إلغاء تثبيت الإعلان":"تثبيت آخر رسالة إعلاناً"}</span></button>
    ${w.owner==="me"?`<button class="lstrow" style="padding:11px" onclick="worldToggleFeat('${w.id}')"><span style="color:var(--gold)">${I("star","i s")}</span><span class="g1 b xs" style="text-align:right">${w.feat?"إلغاء تمييز العالم":"تمييز العالم"}</span></button>
    <button class="lstrow" style="padding:11px" onclick="deleteWorld('${w.id}')"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف العالم</span></button>`
    :w.joined?`<button class="lstrow" style="padding:11px" onclick="leaveWorld('${w.id}')"><span style="color:var(--rose)">${I("logout","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">مغادرة العالم</span></button>`
    :`<button class="lstrow" style="padding:11px" onclick="closeOvl();joinWorld('${w.id}')"><span style="color:var(--accent)">${I("plus","i s")}</span><span class="g1 b xs" style="text-align:right">انضمام للعالم</span></button>`}
  </div>`)};SHEETS.guildRoles=(id)=>{const c=(S.communities||[]).find(x=>x.id===id);if(!c)return sheet("الرتب","");const leader=["المؤسس","قائد"].includes(c.rank)||c.rank==="المؤسس";
  const R=["عضو","مقاتل","ضابط","قائد فرقة"];
  return sheet(I("crown","i s")+" رتب "+esc(c.name),`<div class="col">
    ${!leader?`<div class="tiny fnt mut" style="margin-bottom:8px">رتبتك الحالية: ${esc(c.rank)} — إدارة الرتب للقائد فقط (وضع العرض)</div>`:""}
    ${(S.users||[]).slice(0,6).map(x=>{const cur=(c.roles||{})[x.id]||"عضو";const ci=R.indexOf(cur);return `<div class="row" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span>${av(x,32)}</span>
      <div class="g1"><div class="b xs">${esc(x.name)}</div><div class="tiny fnt">رتبته: <b>${esc(cur)}</b></div></div>
      <button class="btn btn-sec btn-xs" ${!leader||ci<=0?"disabled":""} onclick="setGuildRole('${c.id}','${x.id}',-1)">${I("chevdown","i s")}</button>
      <button class="btn btn-sec btn-xs" ${!leader||ci>=R.length-1?"disabled":""} onclick="setGuildRole('${c.id}','${x.id}',1)">${I("chevup","i s")}</button></div>`}).join("")}
  </div>`)};
function seedEvents(){return []}
function old_seedEvents(){return []}
SHEETS.notifSetSheet=()=>sheet(I("bell","i s")+" تفضيلات الإشعارات",`<div class="col">
  <div class="tiny fnt mut">أوقف أي نوع ليختفي من المركز ولا يُحسب جديداً</div>
  ${[["like","الإعجابات"],["comment","التعليقات"],["follow","المتابعون الجدد"],["mention","الإشارات"],["guild","النقابات"],["event","الفعاليات"],["system","تنبيهات النظام"],["security","الأمان"]].map(([k,l])=>`<div class="rowb"><span class="xs b">${l}</span><span class="sw ${(S.notifPrefs||{})[k]!==false?'on':''}" onclick="togNotifPref('${k}')"></span></div>`).join("")}
  <button class="btn btn-sec btn-sm" style="margin-top:10px" onclick="S.notifPrefs={};save();openSheet('notifSetSheet');toast('أُعيدت التفضيلات ','info')">${I("refresh","i s")} استعادة الكل</button></div>`);
function togNotifPref(k){S.notifPrefs=S.notifPrefs||{};const cur=(S.notifPrefs[k]!==false);S.notifPrefs[k]=!cur;save();snd("tap");openSheet("notifSetSheet")}
function claimLevel(lv){S.lvlClaimed=S.lvlClaimed||[];if(S.lvlClaimed.includes(lv)||S.me.level<lv)return;S.lvlClaimed.push(lv);addCoins(lv*100,"مكافأة مستوى "+lv);save();render();celebrate("مكافأة المستوى "+lv+" وصلت! ")}
function canMod(){return !!(S.me.eventMod||S.me.role==="admin"||S.me.email==="m774545471@gmail.com")}
function evStatus(ev){if(ev.winners&&ev.winners.length)return "ended";return now()>ev.endsAt?"ended":"active"}
PAGES.reels=()=>{S.activeTab="reels";setNav(true);S.reelSeen=S.reelSeen||[];S.reels.forEach(r=>{if(!S.reelSeen.includes(r.id)){S.reelSeen.push(r.id);r.views=(r.views||0)+1}});save();setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%"><div class="ttl">الريلز<small>REELS</small></div><span class="g1"></span><button class="iconbtn" onclick="go('createReelStudio')">${I("plus")}</button></div>`);
  const RL=S.reels.filter(r=>(S.reelTab||"all")==="mine"?r.authorId==="me":(S.reelTab||"all")==="saved"?(S.me.savedReels||[]).includes(r.id):true);
  return `<div style="height:100%;display:flex;flex-direction:column">
    <div class="row" style="gap:6px;padding:8px 12px;flex-shrink:0">${[["all","الكل","grid"],["mine","ريلااتي","user"],["saved","محفوظاتي","bookmark"]].map(([k,l,ic])=>`<button class="chip ${(S.reelTab||"all")===k?"on":""}" onclick="S.reelTab='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}<span class="g1"></span><button class="btn btn-primary btn-xs" onclick="go('createReelStudio')">${I("clapper","i s")} ريل جديد</button></div>
    <div style="flex:1;overflow-y:auto;scroll-snap-type:y mandatory" class="no-sb" id="reelbox">${(!RL.length&&!(S.reels||[]).length)?`<div style="height:100%;display:flex;align-items:center;justify-content:center;padding:24px">${emptyState("clapper","لا توجد ريلز بعد","كن أول من ينشر ريل — اضغط «ريل جديد» في الأعلى واختر فيديو من معرضك")}</div>`:""}
    ${(RL.length?RL:S.reels).map(r=>{const au=u(r.authorId);return `<div style="height:100%;scroll-snap-align:start;position:relative;background:#000;display:flex;align-items:center;justify-content:center">
      ${r.video?`<video src="${r.video}" muted autoplay loop playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;${fxStyle(r.fx)}" oncanplay="this.playbackRate=${r.speed||1}"></video>`:r.cover?`<img src="${r.cover}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;${fxStyle(r.fx)}" alt="">`:`<div class="art-bg" style="--c1:${r.c1};--c2:${r.c2};position:absolute;inset:0;display:flex;align-items:center;justify-content:center;${fxStyle(r.fx)}">${I(r.emo||"clapper","xxl")}</div>`}
      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.85),transparent 45%)"></div>
      <div style="position:absolute;bottom:16px;right:14px;left:70px;z-index:2">
        <div class="row" style="gap:8px"><button onclick="openProfile('${au.id}')">${av(au,34,true)}</button><span class="b xs" style="color:#fff">${esc(au.name)}</span>${vbadge(au)}
          <button class="btn btn-glass btn-xs" onclick="follow('${au.id}')">${S.following.includes(au.id)?"متابَع":"متابعة"}</button></div>
        <div class="xs" style="color:#fff;margin-top:8px;line-height:1.6">${esc(r.text||"")}</div>
        <div class="row" style="gap:6px;margin-top:8px"><span style="color:#fff;line-height:0">${I("music","i s")}</span><span class="tiny" style="color:rgba(255,255,255,.8)">${esc(r.music||"صوت أصلي — "+au.name)}</span>${r.speed&&r.speed!==1?`<span class="badge b-gray mono">${r.speed}x</span>`:""}${r.fx&&r.fx!=="بدون"?`<span class="badge b-purple">${esc(r.fx)}</span>`:""}</div></div>
      <div style="position:absolute;bottom:20px;left:12px;z-index:2;display:flex;flex-direction:column;gap:14px;align-items:center">
        <button class="col center" style="gap:3px;background:none;border:none;color:#fff" onclick="toggleLikeReel('${r.id}')">${I("heart",r.liked?"i l":"i l")}<span class="tiny mono">${nfmt((r.likes||0)+(r.liked?1:0))}</span></button>
        <button class="col center" style="gap:3px;background:none;border:none;color:#fff" onclick="openSheet('reelComments','${r.id}')">${I("msgsq","i l")}<span class="tiny mono">${(r.comments||[]).length}</span></button>
        <button class="col center" style="gap:3px;background:none;border:none;color:#fff" onclick="openSheet('shareSheet','${r.id}')">${I("share","i l")}</button>
        <button class="col center" style="gap:3px;background:none;border:none;color:${(S.me.savedReels||[]).includes(r.id)?"var(--gold)":"#fff"}" onclick="saveReel('${r.id}')">${I("bookmark","i l")}</button>
        <span class="col center" style="gap:3px;color:#fff">${I("eye","i l")}<span class="tiny mono">${nfmt(r.views||0)}</span></span></div>
      <button class="iconbtn" style="position:absolute;top:12px;left:12px;z-index:2;background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="S.reelMute=!S.reelMute;render();toast(S.reelMute?'صامت ':'الصوت شغال ','info')">${I(S.reelMute?"mute":"volume","i s")}</button>
    </div>`}).join("")}
  </div></div>`};
function toggleLikeReel(id){const r=(S.reels||[]).find(x=>x.id===id);r.liked=!r.liked;save();snd("tap");render()}
function saveReel(id){S.me.savedReels=S.me.savedReels||[];if(S.me.savedReels.includes(id))S.me.savedReels=S.me.savedReels.filter(x=>x!==id);else{S.me.savedReels.push(id);toast("حُفظ الريل ","ok")}save();render()}
SHEETS.reelComments=(id)=>{const r=(S.reels||[]).find(x=>x.id===id)||S.reels[0]||{id:"r0"};const rid=r.id||id||"";r.comments=r.comments||[];
  return sheet(I("msgsq","i s")+" تعليقات الريل",`<div class="col">${r.comments.map(c=>{const cu=u(c.uid);return `<div class="row" style="gap:8px;padding:7px 2px;border-bottom:1px solid var(--line)"><span>${av(cu,28)}</span><div class="g1"><div class="tiny b">${esc(cu.name)}</div><div class="xs">${esc(c.text)}</div></div></div>`}).join("")||`<div class="tiny fnt mut">لا تعليقات</div>`}
    <div class="row" style="gap:7px;margin-top:9px"><input class="inp g1" id="rc_t" placeholder="أضف تعليقاً..."><button class="btn btn-primary btn-xs" onclick="reelComment('${rid}')">${I("send","i s")}</button></div></div>`)};
function reelComment(id){const r=(S.reels||[]).find(x=>x.id===id);const v=($("#rc_t")||{}).value||"";if(!v.trim())return;r.comments=r.comments||[];r.comments.push({uid:"me",text:v.trim(),at:now()});save();snd("send");openSheet("reelComments",id)}
PAGES.eventsHub=()=>{setNav(false);setHdr(backHdr("الفعاليات والمسابقات",S.events.filter(e=>evStatus(e)==="active").length+" نشطة",canMod()?`<button class="btn btn-gold btn-sm" onclick="go('createEvent')">${I("plus","i s")} فعالية</button>`:""));
  const f=S.evF||"active";
  return `<div class="pad col">
    <div class="chiprow">${[["active","نشطة"],["ended","منتهية"],["all","الكل"]].map(([k,l])=>`<button class="chip ${f===k?'on':''}" onclick="S.evF='${k}';save();render();snd('tap')">${l}</button>`).join("")}</div>
    ${S.events.filter(ev=>f==="all"||evStatus(ev)===f).map(ev=>{const st=evStatus(ev);const dd=Math.max(0,Math.ceil((ev.endsAt-now())/864e5));
      return `<button class="card" style="padding:0;overflow:hidden;text-align:right" onclick="go('eventDetail',{id:'${ev.id}'})">
        <div class="art-bg" style="--c1:${ev.c1};--c2:${ev.c2};height:88px;display:flex;align-items:center;justify-content:center;position:relative">${I(ev.icon,"xl")}
          <span class="badge ${st==="active"?"b-emerald":"b-gray"}" style="position:absolute;top:8px;right:8px">${st==="active"?"نشطة":"منتهية"}</span>
          <span class="badge b-gold" style="position:absolute;bottom:8px;right:8px">${ev.tag}</span></div>
        <div style="padding:11px"><div class="b sm">${esc(ev.title)}</div><div class="tiny fnt" style="margin-top:4px">${esc(ev.desc)}</div>
        <div class="row" style="gap:8px;margin-top:9px"><span class="badge b-gray mono">${I("users","i s")} ${(ev.participants||[]).length}</span><span class="badge b-gray mono">${I("heart","i s")} ${ev.likes}</span><span class="badge b-gray mono">${I("msgsq","i s")} ${(ev.comments||[]).length}</span><span class="g1"></span><span class="badge ${st==="active"?"b-gold":"b-purple"} mono">${st==="active"?dd+" يوم متبقية":"عرض الفائزين"}</span></div></div></button>`}).join("")||emptyState("calendar","لا فعاليات","")}</div>`};
PAGES.eventDetail=()=>{const ev=(S.events||[]).find(x=>x.id===S.params.id);if(!ev){setNav(false);setHdr(backHdr("الفعالية",""));return emptyState("calendar","الفعالية غير موجودة","")}
  setNav(false);const st=evStatus(ev);const joined=ev.participants.some(p=>p.uid==="me");
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%"><button class="iconbtn" onclick="go('eventsHub')">${I("back")}</button>
    <div class="g1"><div class="b sm">${esc(ev.title)}</div><div class="tiny fnt">${ev.tag} · ${st==="active"?"نشطة":"منتهية"}</div></div>
    <button class="iconbtn" onclick="openSheet('shareSheet','${ev.id}')">${I("share")}</button></div>`);
  const dd=ev.endsAt-now();const hrs=Math.max(0,Math.floor(dd/36e5));
  return `<div class="pad col">
    <div class="${ev.cover?"":"art-bg"}" style="${ev.cover?`background:url('${ev.cover}') center/cover no-repeat;`:`--c1:${ev.c1};--c2:${ev.c2};`}height:130px;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative">${ev.cover?"":I(ev.icon,"xxl")}
      <span class="badge b-gold" style="position:absolute;top:10px;right:10px">${ev.tag}</span>
      ${st==="active"?`<span class="badge b-emerald mono" style="position:absolute;bottom:10px;left:10px" id="evcd">${hrs} س متبقية</span>`:`<span class="badge b-gray" style="position:absolute;bottom:10px;left:10px">انتهت</span>`}</div>
    <div class="card" style="padding:13px;margin-top:11px"><div class="b sm">${esc(ev.title)}</div><div class="xs mut" style="margin-top:6px;line-height:1.7">${esc(ev.desc)}</div>
      <div class="grid4" style="margin-top:11px">${[["users",(ev.participants||[]).length,"مشارك"],["heart",ev.likes,"إعجاب"],["msgsq",(ev.comments||[]).length,"تعليق"],["coins",ev.prizes.reduce((a,p)=>a+(p.amt||0),0),"جوائز"]].map(([ic,v,l])=>`<div class="stat">${I(ic,"i s")}<b class="mono">${nfmt(v)}</b><span>${l}</span></div>`).join("")}</div></div>
    ${st==="active"?`<div class="card" style="padding:12px"><div class="rowb"><span class="xs b">${I("clock","i s")} تنتهي بعد</span><span class="badge b-gold mono">${Math.floor(hrs/24)} ي ${hrs%24} س</span></div>
      <div class="row" style="gap:8px;margin-top:10px">${joined?`<button class="btn btn-emerald btn-sm g1" onclick="S.evCtx='${ev.id}';save();go('createPost')">${I("pen","i s")} شارك بمنشور</button>`:`<button class="btn btn-primary btn-sm g1" onclick="joinEvent('${ev.id}')">${I("plus","i s")} شارك الآن</button>`}
        <button class="btn btn-sec btn-sm" onclick="likeEvent('${ev.id}')">${I("heart","i s")} ${ev.likes}</button>
        <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet','${ev.id}')">${I("share","i s")}</button></div></div>`:""}
    <div class="card" style="padding:13px"><div class="b sm">${I("list","i s")} شروط الفعالية</div>
      <ol class="xs mut" style="margin:8px 18px 0">${(ev.rules||[]).map(r=>`<li style="margin-bottom:6px">${esc(r)}</li>`).join("")}</ol></div>
    <div class="card" style="padding:13px"><div class="b sm">${I("trophy","i s")} الجوائز</div>
      <div class="col" style="margin-top:8px">${ev.prizes.map((pz,i)=>`<div class="rowb" style="padding:6px 2px;border-bottom:1px solid var(--line)"><span class="xs b">${i===1?"المركز الثاني":i===2?"المركز الثالث":"المركز الأول"} </span><span class="badge ${pz.t==="coins"?"b-gold":pz.t==="stars"?"b-purple":"b-cyan"} mono">${pz.t==="coins"?nfmt(pz.amt)+" عملة":pz.t==="stars"?pz.amt+" نجمة":pz.amt}</span></div>`).join("")}</div></div>
    <div class="card" style="padding:13px"><div class="rowb"><span class="b sm">${I("users","i s")} المشاركون (${(ev.participants||[]).length})</span>${canMod()&&st==="active"?`<button class="btn btn-gold btn-xs" onclick="openSheet('pickWinners','${ev.id}')">${I("crown","i s")} تعيين الفائزين</button>`:""}</div>
      <div class="row" style="gap:6px;flex-wrap:wrap;margin-top:9px">${ev.participants.map(p=>{const pu=u(p.uid);return `<button style="background:none;border:none;line-height:0" onclick="openProfile('${p.uid}')">${av(pu,34)}</button>`}).join("")||`<span class="tiny fnt mut">لا مشاركين بعد</span>`}</div></div>
    ${st==="ended"?`<div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(245,158,11,.14),transparent)">
      <div class="b sm">${I("trophy","i s")} الفائزون والمراكز</div>
      <div class="col" style="margin-top:10px">${(ev.winners||[]).map(w=>{const wu=u(w.uid);return `<div class="row" style="gap:9px"><span class="badge ${w.place===1?"b-gold":w.place===2?"b-gray":"b-gray"} mono" style="width:26px;justify-content:center">${w.place}</span><span>${av(wu,32)}</span><div class="g1"><div class="b xs">${esc(wu.name)}</div><div class="tiny fnt">${w.place===1?"المركز الأول وجائزة كبرى":w.place===2?"المركز الثاني":"المركز الثالث"}</div></div><span style="color:var(--gold);line-height:0">${I("award","i l")}</span></div>`}).join("")||`<div class="tiny fnt mut">لم تُعيَّن النتائج بعد</div>`}</div></div>`:""}
    <div class="card" style="padding:13px"><div class="b sm">${I("msgsq","i s")} تعليقات الفعالية</div>
      <div class="col" style="margin-top:8px">${(ev.comments||[]).map(c=>{const cu=u(c.uid);return `<div class="row" style="gap:8px;padding:7px 2px;border-bottom:1px solid var(--line)"><span>${av(cu,28)}</span><div class="g1"><div class="tiny b">${esc(cu.name)} <span class="tiny fnt mut">${ago(c.at)}</span></div><div class="xs">${esc(c.text)}</div></div></div>`}).join("")||`<div class="tiny fnt mut">لا تعليقات</div>`}
      <div class="row" style="gap:7px;margin-top:9px"><input class="inp g1" id="evc_t" placeholder="علّق على الفعالية..."><button class="btn btn-primary btn-xs" onclick="evComment('${ev.id}')">${I("send","i s")}</button></div></div></div>`};
function joinEvent(id){const ev=(S.events||[]).find(x=>x.id===id);if(!ev)return;
  if(ev.participants.some(p=>p.uid==="me")){S.evCtx=id;save();go("createPost");return}
  ev.participants.push({uid:"me"});save();celebrate("انضممت للفعالية — اكتب منشور المشاركة ");snd("success");S.evCtx=id;setTimeout(()=>go("createPost"),450);render()}
function likeEvent(id){const ev=(S.events||[]).find(x=>x.id===id);ev.liked=!ev.liked;ev.likes+=ev.liked?1:-1;save();snd("tap");render()}
function evComment(id){const ev=(S.events||[]).find(x=>x.id===id);const v=($("#evc_t")||{}).value||"";if(!v.trim())return;ev.comments=ev.comments||[];ev.comments.push({uid:"me",text:v.trim(),at:now()});save();snd("send");render()}
SHEETS.pickWinners=(id)=>{const ev=(S.events||[]).find(x=>x.id===id)||(S.events||[]).find(e=>evStatus(e)==="active")||S.events[0]||{id:"",title:"—",participants:[]};
  return sheet(I("crown","i s")+" تعيين الفائزين — "+esc(ev.title),`<div class="col">
    <div class="tiny fnt mut">اختر حتى ٣ مشاركين بالترتيب، ثم اعتمد النتيجة لتُصرف الجوائز وتُنهى الفعالية</div>
    ${ev.participants.map((p,i)=>{const pu=u(p.uid);return `<div class="row" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span>${av(pu,32)}</span><div class="g1 b xs">${esc(pu.name)}</div>
      ${[1,2,3].map(pl=>`<button class="btn btn-xs ${(S.__wp||[])[pl-1]===p.uid?"btn-gold":"btn-sec"}" style="width:30px" onclick="S.__wp=S.__wp||[];S.__wp[${pl-1}]='${p.uid}';openSheet('pickWinners','${id}')">${pl}</button>`).join("")}</div>`}).join("")}
    <button class="btn btn-gold btn-sm" style="margin-top:10px" onclick="commitWinners('${id}')">${I("trophy","i s")} اعتماد النتيجة وإنهاء الفعالية</button></div>`)};
function commitWinners(id){const ev=(S.events||[]).find(x=>x.id===id);const wp=(S.__wp||[]).filter(Boolean);if(!wp.length){toast("اختر فائزاً واحداً على الأقل ","err");return}
  ev.winners=(wp||[]).slice(0,3).map((uidv,i)=>({uid:uidv,place:i+1}));
  ev.winners.forEach((w,i)=>{const pz=ev.prizes[i];if(pz&&pz.t==="coins")addCoinsTo(w.uid,pz.amt,"جائزة فعالية "+ev.title)});
  S.__wp=[];save();closeOvl();celebrate("أُعلنت النتائج وصُرفت الجوائز ");render()}
function addCoinsTo(uidv,amt,reason){if(uidv==="me"){addCoins(amt,reason);return}const x=u(uidv);if(x)x.wallet=(x.wallet||0)+amt}
PAGES.createEvent=()=>{if(!canMod()){setNav(false);setHdr(backHdr("مرفوض",""));return emptyState("shield","صلاحية مشرف الفعاليات مطلوبة","")}
  setNav(false);setHdr(backHdr("إنشاء فعالية","صلاحيات المشرف فقط"));
  const cols=[["#7F1D1D","#EA580C"],["#14532D","#4ADE80"],["#312E81","#818CF8"],["#0C4A6E","#0EA5E9"],["#831843","#DB2777"]];
  return `<div class="pad col">
    <label class="lbl">عنوان الفعالية *</label><input class="inp" id="ce_t" placeholder="مثال: مسابقة أفضل رسم">
    <label class="lbl" style="margin-top:9px">غلاف الفعالية (صورة من جهازك)</label>
    <input type="file" id="ceCovIn" accept="image/*" style="display:none" onchange="ceCov(this)">
    ${S.ceCover?`<div style="position:relative"><img src="${S.ceCover}" style="width:100%;height:110px;object-fit:cover;border-radius:14px;display:block" alt=""><button class="iconbtn" style="position:absolute;top:6px;inset-inline-start:6px;background:rgba(0,0,0,.65);color:#fff;border:none" onclick="S.ceCover=null;save();render()">${I("x","i s")}</button><span class="badge b-emerald" style="position:absolute;bottom:6px;inset-inline-start:6px">غلاف مرفوع</span></div>`
    :`<button class="card2 center" style="padding:14px;border-style:dashed;cursor:pointer" onclick="document.getElementById('ceCovIn').click()"><span style="color:var(--accent);line-height:0">${I("image","i l")}</span><span class="tiny b" style="display:block;margin-top:6px">تحميل غلاف من الهاتف</span></button>`}
    <label class="lbl" style="margin-top:9px">الوصف</label><input class="inp" id="ce_d" placeholder="فكرة الفعالية بطريقة جذابة">
    <div class="row" style="gap:8px;margin-top:9px"><div class="g1"><label class="lbl">هاشتاغ الفعالية</label><input class="inp mono" id="ce_tag" placeholder="#مسابقة_الرسم" dir="rtl"></div>
    <div class="g1"><label class="lbl">المدة (أيام)</label><input class="inp mono" id="ce_days" type="number" min="1" max="60" value="7"></div></div>
    <label class="lbl" style="margin-top:9px">شروط الفعالية (سطر لكل شرط)</label><textarea class="inp" id="ce_rules" rows="3">عمل أصلي&#10;وسم الفعالية إلزامي&#10;مشاركة واحدة لكل عضو</textarea>
    <label class="lbl" style="margin-top:9px">غلاف الفعالية</label>
    <div class="chiprow">${cols.map((c2,i)=>`<button class="chip ${(S.ceCol||0)===i?'on':''}" style="padding:6px 16px;background:linear-gradient(135deg,${c2[0]},${c2[1]});color:#fff" onclick="S.ceCol=${i};render()">${I("image","i s")}</button>`).join("")}
      ${["calendar","trophy","swords","gift","tv","palette"].map(ic=>`<button class="chip ${(S.ceIcon||"calendar")===ic?'on':''}" onclick="S.ceIcon='${ic}';render()">${I(ic,"i s")}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">جائزة المركز الأول (عملات كوين بلاك)</label><input class="inp mono" id="ce_p1" type="number" min="0" value="1000">
    <label class="lbl" style="margin-top:9px">جائزة المركز الثاني</label><input class="inp mono" id="ce_p2" type="number" min="0" value="400">
    <button class="btn btn-gold btn-lg" style="margin-top:14px" onclick="publishEvent()">${I("calendar","i s")} نشر الفعالية</button>
  </div>`};
function ceCov(inp){const f=inp.files&&inp.files[0];if(!f)return;fileDownscale(f,1280,0.8,src=>{if(src){S.ceCover=src;save();render();snd("success");toast("رُفع غلاف الفعالية ","ok")}});inp.value=""}
function publishEvent(){const t=($("#ce_t")||{}).value||"";if(t.trim().length<4){toast("عنوان الفعالية مطلوب ","err");snd("error");return}
  const cols=[["#7F1D1D","#EA580C"],["#14532D","#4ADE80"],["#312E81","#818CF8"],["#0C4A6E","#0EA5E9"],["#831843","#DB2777"]][S.ceCol||0];
  const days=Math.max(1,Math.min(60,parseInt((($("#ce_days")||{}).value)||"7",10)||7));
  const rules=(($("#ce_rules")||{}).value||"").split("\n").map(x=>x.trim()).filter(Boolean);
  const p1=parseInt((($("#ce_p1")||{}).value)||"0",10)||0,p2=parseInt((($("#ce_p2")||{}).value)||"0",10)||0;
  const ev={id:"ev"+uid(),title:t.trim(),desc:(($("#ce_d")||{}).value||"فعالية مجتمعية جديدة").trim(),icon:S.ceIcon||"calendar",c1:cols[0],c2:cols[1],tag:(($("#ce_tag")||{}).value||"#فعالية_أنمي_بلاك").trim(),rules:rules.length?rules:["شروط الإدارة العامة"],endsAt:now()+days*864e5,prizes:[{t:"coins",amt:p1},{t:"coins",amt:p2}],owner:"me",mod:"me",participants:[],likes:0,comments:[],winners:null,cover:S.ceCover||""};S.ceCover=null;
  S.events.unshift(ev);save();celebrate("نُشرت الفعالية — تظهر للأعضاء في المزيد والرئيسية ");go("eventDetail",{id:ev.id})}
PAGES.createNews=()=>{if(!canMod()){setNav(false);setHdr(backHdr("مرفوض",""));return emptyState("shield","صلاحية الإدارة مطلوبة","")}
  setNav(false);setHdr(backHdr("نشر خبر رسمي","الإدارة فقط"));
  return `<div class="pad col">
    <label class="lbl">عنوان الخبر *</label><input class="inp" id="cn_t" placeholder="مثال: إعلان الموسم الجديد">
    <label class="lbl" style="margin-top:9px">نص الخبر</label><textarea class="inp" id="cn_b" rows="5" placeholder="تفاصيل الخبر الرسمي..."></textarea>
    <label class="lbl" style="margin-top:9px">التصنيف</label>
    <div class="chiprow">${["إعلان","تحديث","شراكة","تحذير"].map(t=>`<button class="chip ${(S.cnTag||"إعلان")===t?'on':''}" onclick="S.cnTag='${t}';render()">${t}</button>`).join("")}</div>
    <button class="btn btn-primary btn-lg" style="margin-top:14px" onclick="publishNews()">${I("sparkles","i s")} نشر الخبر</button></div>`};
function publishNews(){const t=($("#cn_t")||{}).value||"";const b=($("#cn_b")||{}).value||"";if(t.trim().length<4||b.trim().length<10){toast("العنوان والنص مطلوبان ","err");snd("error");return}
  S.wiki.news=S.wiki.news||[];S.wiki.news.unshift({id:"nw"+uid(),title:t.trim(),body:b.trim(),tag:S.cnTag||"إعلان",at:now(),official:true});
  S.posts.unshift({id:"p"+uid(),authorId:"me",text:t.trim(),type:"news",createdAt:now(),likes:0,comments:[],media:{c1:"#7F1D1D",c2:"#EA580C",emo:"sparkles"}});
  save();celebrate("نُشر الخبر الرسمي ");go("home")}
function noteOf(x){if(!x||!x.note||!x.note.text)return null;if(now()-x.note.at>864e5)return null;return x.note}
function notesRow(){const mine=noteOf(S.me);
  return `<div class="stories" style="margin-bottom:8px">
    <div class="story" onclick="openSheet('setNoteSheet')"><div class="ring ${mine?"":"mine"}" style="position:relative">${av(S.me,58,true)}
      <span style="position:absolute;bottom:0;left:0;width:17px;height:17px;border-radius:50%;background:${mine?"var(--emerald)":"var(--accent)"};border:2px solid var(--bg);color:#fff;display:flex;align-items:center;justify-content:center;line-height:0">${mine?I("check","i s"):`<b style="font-size:11px">+</b>`}</span></div>
      <span>${mine?"ملاحظتك":"أضف ملاحظة"}</span></div>
    ${(S.users||[]).slice(0,7).map(x=>{const nt=noteOf(x);if(!nt)return "";return `<div class="story" onclick="openSheet('viewNote','${x.id}')">
      <div class="ring" style="position:relative"><img class="avatar" src="${x.avatar}" width="58" height="58" onerror="this.style.background='var(--grad-purple)'">
      <span class="note-bub">${esc(((nt&&nt.text)||"").slice(0,44))}</span></div>
      <span>${esc(x.name.split(" ")[0])}</span></div>`}).join("")}
  </div>`}
SHEETS.setNoteSheet=()=>sheet(I("edit","i s")+" ملاحظتك (نمط انستغرام)",`<div class="col"><div class="tiny fnt">نص قصير يظهر أعلى صورتك في الدردشة لمدة ٢٤ ساعة، والردود تصلك خاصاً</div>
  ${noteOf(S.me)?`<div class="rowb card2" style="padding:9px;margin:6px 0"><span class="tiny b g1">${esc(S.me.note.text)}</span><span class="tiny fnt">${ago(S.me.note.at)}</span></div>`:""}
  <label class="lbl">نص الملاحظة</label><input class="inp" id="nt_t" maxlength="60" value="${esc((S.me.note||{}).text||"")}" placeholder="مثال: أشاهد فريرن الآن">
  <div class="chiprow" style="margin-top:8px">${["مشاهد ليلي","مزاج هادئ","أذاكر","وضع الطيران","حماس كامل"].map(t=>`<button class="chip" onclick="const i=$('#nt_t');if(i){i.value='${t}';snd('tap')}">${t}</button>`).join("")}</div>
  <div class="grid2" style="margin-top:10px"><button class="btn btn-primary btn-sm" onclick="setMyNote()">${I("check","i s")} نشر الملاحظة</button>
  <button class="btn btn-ghost btn-sm" onclick="S.me.note=null;save();closeOvl();render();toast('حُذفت ملاحظتك ','info')">${I("trash","i s")} حذف</button></div></div>`);
function setMyNote(){const v=($("#nt_t")||{}).value||"";if(!v.trim()){toast("اكتب نص الملاحظة ","err");snd("error");return}S.me.note={text:v.trim(),at:now()};save();closeOvl();render();celebrate("نُشرت ملاحظتك — تختفي بعد ٢٤ ساعة ")}
SHEETS.viewNote=(id)=>{const x=u(id);const nt=noteOf(x);if(!nt)return sheet("ملاحظة","<div class='tiny fnt'>لا ملاحظة نشطة</div>");
  return sheet(I("edit","i s")+" ملاحظة "+esc(x.name),`<div class="col center" style="gap:10px"><span>${av(x,64,true)}</span>
    <div class="card2" style="padding:14px;width:100%;text-align:center"><div class="b sm">${esc(nt.text)}</div><div class="tiny fnt" style="margin-top:6px">${ago(nt.at)} · تختفي بعد ٢٤ ساعة</div></div>
    <div class="row" style="gap:7px;width:100%"><input class="inp g1" id="nr_t" placeholder="رد على الملاحظة..."><button class="btn btn-primary btn-sm" onclick="replyNote('${x.id}')">${I("send","i s")}</button></div>
    <button class="btn btn-ghost btn-xs" onclick="closeOvl();openProfile('${x.id}')">${I("user","i s")} عرض الملف</button></div>`)};
function replyNote(uidv){const v=($("#nr_t")||{}).value||"";if(!v.trim()){toast("اكتب الرد ","err");return}closeOvl();const c0=(S.chats||[]).find(x=>x.userId===uidv);if(c0){c0.messages.push({id:uid(),from:"me",text:"رداً على ملاحظتك: "+v.trim(),at:now()});c0.last="رد على ملاحظة";c0.lastAt=now();save();openChat(c0.id);snd("send")}else startChat(uidv)}
SHEETS.reqSheet=()=>sheet(I("usercheck","i s")+" طلبات المراسلة",`<div class="col">
  ${(S.chatReqs||[]).length?`<div class="tiny fnt mut" style="margin-bottom:6px">هؤلاء الأعضاء يريدون مراسلتك — اقبل أو احظر</div>`:""}
  ${(S.chatReqs||[]).map(r=>{const x=u(r.uid);return `<div class="row" style="padding:9px 2px;border-bottom:1px solid var(--line)"><span>${av(x,36)}</span>
    <div class="g1"><div class="b xs">${esc(x.name)} ${vbadge(x)}</div><div class="tiny fnt">${ago(r.at)} · ${x.followers?nfmt(x.followers):"0"} متابع</div></div>
    <button class="btn btn-primary btn-xs" onclick="acceptChatReq('${r.uid}')">${I("check","i s")} قبول</button>
    <button class="btn btn-danger btn-xs" onclick="blockChatReq('${r.uid}')">${I("ban","i s")} حظر</button></div>`}).join("")||`<div class="empty">${I("usercheck","l")}<div class="xs b">لا طلبات معلّقة</div><div class="tiny fnt">أي عضو جديد يريد مراسلتك سيظهر هنا</div></div>`}
  ${(S.outReqs||[]).length?`<div class="lbl" style="margin-top:10px">طلباتك المرسلة</div>${S.outReqs.map(id2=>{const x=u(id2);return `<div class="rowb" style="padding:7px 2px"><span class="tiny b g1">${esc(x.name)}</span><span class="badge b-gold">قيد المراجعة</span></div>`}).join("")}`:""}</div>`);
function acceptChatReq(uidv){S.chatReqs=(S.chatReqs||[]).filter(r=>r.uid!==uidv);const x=u(uidv);startChat(uidv);const c=(S.chats||[]).find(cc=>cc.userId===uidv);if(c&&!(c.messages||[]).length)c.messages.push({id:uid(),from:"them",text:"شكراً لقبول طلبي ",at:now()});save();closeOvl();toast("قبلت طلب "+x.name+" ","ok");snd("success");render()}
function blockChatReq(uidv){S.chatReqs=(S.chatReqs||[]).filter(r=>r.uid!==uidv);if(!S.blocked.includes(uidv))S.blocked.push(uidv);save();closeOvl();toast("حُظر المستخدم ولن يستطيع مراسلتك ","err");snd("error");openSheet("reqSheet")}
SHEETS.joinReqSheet=(key)=>{const [kind,id]=String(key).split("|");const rs=(S.joinReqs||[]).filter(r=>r.kind===kind&&r.id===id&&r.uid!=="me");
  const nm=kind==="group"?((S.groups||[]).find(g=>g.id===id)||{}).name:((S.communities||[]).find(c=>c.id===id)||{}).name;
  return sheet(I("inbox","i s")+" طلبات انضمام — "+esc(nm||""),`<div class="col">
    ${rs.map(r=>{const x=u(r.uid);return `<div class="row" style="padding:9px 2px;border-bottom:1px solid var(--line)"><span>${av(x,36)}</span>
      <div class="g1"><div class="b xs">${esc(x.name)}</div><div class="tiny fnt">${esc(x.role)} · ${ago(r.at)}</div></div>
      <button class="btn btn-primary btn-xs" onclick="approveJoin('${kind}','${id}','${r.uid}')">${I("check","i s")} قبول</button>
      <button class="btn btn-sec btn-xs" onclick="denyJoin('${kind}','${id}','${r.uid}')">${I("x","i s")} رفض</button></div>`}).join("")||`<div class="empty">${I("inbox","l")}<div class="xs b">لا طلبات انضمام</div><div class="tiny fnt">الطلبات الواردة من الأعضاء تظهر هنا للمشرفين</div></div>`}
    ${(S.joinReqs||[]).some(r=>r.uid==="me")?`<div class="lbl" style="margin-top:10px">طلباتك</div>${(S.joinReqs||[]).filter(r=>r.uid==="me").map(r=>`<div class="rowb" style="padding:7px 2px"><span class="tiny b g1">${r.kind==="group"?"قروب":"نقابة"}: ${esc((r.kind==="group"?((S.groups||[]).find(g=>g.id===r.id)||{}).name:((S.communities||[]).find(c=>c.id===r.id)||{}).name)||"")}</span><span class="badge b-gold">معلّق</span></div>`).join("")}`:""}</div>`)};
function approveJoin(kind,id,uidv){S.joinReqs=(S.joinReqs||[]).filter(r=>!(r.kind===kind&&r.id===id&&r.uid===uidv));
  if(kind==="group"){const g=(S.groups||[]).find(x=>x.id===id);if(g&&!g.members.includes(uidv))g.members.push(uidv)}
  else{const c=(S.communities||[]).find(x=>x.id===id);if(c){c.joined=true;/* v2: كان c.joined=c.joined (إسناد فارغ لا يسجل الانضمام) */c.members++}}
  save();toast("قُبل طلب "+u(uidv).name+" ","ok");snd("success");openSheet("joinReqSheet",kind+"|"+id)}
function denyJoin(kind,id,uidv){S.joinReqs=(S.joinReqs||[]).filter(r=>!(r.kind===kind&&r.id===id&&r.uid===uidv));save();toast("رُفض الطلب ","info");openSheet("joinReqSheet",kind+"|"+id)}
function stSize(d){S.storyTxtSize=Math.max(11,Math.min(30,(S.storyTxtSize||16)+d));save();render();snd("tap")}
function roomMsgBody(m,me){
  /* v5: نوع "contact" لم يكن مدعوماً في الغرف فكان يظهر نصاً */
  if(m.type==="contact")return `<div class="card2 row" style="gap:8px;padding:8px 10px">${I("user","i s")}<span class="tiny b">${esc(m.name||"جهة اتصال")}</span></div>`;
  if(m.type==="share")return shareCardHTML(m,me);
  if(m.type==="image")return `<img src="${m.src}" style="max-width:100%;border-radius:12px;display:block" alt="">`;
  if(m.type==="video")return `<video controls playsinline src="${m.src}" style="max-width:100%;border-radius:12px;display:block"></video>`;
  if(m.type==="voice")return `<div class="row" style="gap:7px"><span style="color:var(--emerald);line-height:0">${I("mic","i s")}</span><audio controls src="${m.src}" style="height:34px;max-width:160px"></audio><span class="tiny mono">${m.dur||0}ث</span></div>`;
  if(m.type==="file")return `<div class="row" style="gap:9px;min-width:180px"><span class="ico-tile" style="width:38px;height:38px;border-radius:12px;background:${me?'rgba(0,0,0,.25)':'var(--surface3)'};color:${me?'#fff':'var(--gold)'}">${I("file","i l")}</span><span class="g1" style="min-width:0"><span class="b xs" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc((m.name||"ملف").slice(0,28))}</span><span class="tiny fnt" style="opacity:.75">مرفق محفوظ داخل الغرفة</span></span>${m.src?`<a class="btn btn-sec btn-xs" href="${m.src}" download="${esc(m.name||"file")}" onclick="event.stopPropagation()">${I("download","i s")}</a>`:""}</div>`;
  if(m.type==="sticker")return `<span style="line-height:0;display:flex">${IC(m.icon||"heart","xl")}</span>`;
  if(m.type==="cpoll")return roomPollBox(m,me);
  return linkify(m.text||"");
}
function roomPollBox(m,me){const tot=(m.votes||[]).reduce((a,b)=>a+b,0)||1;
  return `<div class="col" style="gap:6px;min-width:190px"><div class="xs b">${esc(m.q)}</div>${(m.opts||[]).map((o,i)=>{const pct=Math.round(((m.votes||[])[i]||0)/tot*100);const mine=m.me===i;return `<button class="row" style="position:relative;overflow:hidden;background:${me?'rgba(0,0,0,.18)':'var(--surface2)'};border:1px solid ${mine?'var(--accent)':'var(--line2)'};border-radius:10px;padding:7px 10px" onclick="voteChatPoll('${m.id}',${i})"><i style="position:absolute;inset:0;width:${m.me!=null?pct:0}%;background:rgba(34,211,238,.22)"></i><span class="g1 xs b" style="position:relative;text-align:right">${esc(o)}</span>${m.me!=null?`<span class="badge b-gray mono" style="position:relative">${pct}%</span>`:""}</button>`}).join("")}<div class="tiny fnt center">${nfmt(tot- (m.me!=null?1:0) )>=0?nfmt((m.votes||[]).reduce((a,b)=>a+b,0)):"0"} صوت${m.me==null?" · اضغط للتصويت":""}</div></div>`}
function ctxPush(){
  if(S.page==="groupRoom"){const g=(S.groups||[]).find(x=>x.id===S.params.id);return g?(m=>{g.msgs.push(Object.assign({id:uid(),uid:"me",at:now()},m));save();snd("send");render();toast("أُرسل إلى القروب ","ok")}):null}
  if(S.page==="worldRoom"){const w=(S.worlds||[]).find(x=>x.id===S.params.id);return w?(m=>{w.msgs.push(Object.assign({id:uid(),uid:"me",at:now()},m));save();snd("send");render();toast("أُرسل إلى العالم ","ok")}):null}
  const c=S.activeChat?(S.chats||[]).find(x=>x.id===S.activeChat):(S.page==="chatRoom"?(S.chats||[]).find(x=>x.id===S.params.id):null);
  return c?(m=>{c.messages.push(Object.assign({id:uid(),from:"me",at:now()},m));c.last=m.text||"وسائط";c.lastAt=now();save();snd("send");render();toast("أُرسل ","ok")}):null}
function recGenVoice(kind,id,btn){
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){toast("المتصفح لا يدعم التسجيل ","err");return}
  if(window.__rec){clearInterval(window.__rec.iv);window.__rec.st.stop();window.__rec=null;btn.innerHTML=I("mic");toast("أُلغي التسجيل ","info");return}
  navigator.mediaDevices.getUserMedia({audio:true}).then(st=>{const mr=new MediaRecorder(st);const ch=[];mr.ondataavailable=e=>ch.push(e.data);mr.onstop=()=>{st.getTracks().forEach(t=>t.stop());const bl=new Blob(ch,{type:"audio/webm"});const fr=new FileReader();fr.onload=()=>{const push=ctxPush();if(push)push({type:"voice",src:fr.result,dur:window.__rec?window.__rec.sec:0,text:" رسالة صوتية"});else toast("افتح محادثة أولاً ","err");window.__rec=null};fr.readAsDataURL(bl)};mr.start();let sec=0;const iv=setInterval(()=>{sec++;btn.innerHTML=`<span class="mono tiny">${sec}</span>`},1000);window.__rec={st:mr,iv,sec:0};btn.innerHTML=I("stop","i s");toast("جارٍ التسجيل — اضغط للإيقاف والإرسال ","ok");const tick=setInterval(()=>{if(window.__rec)window.__rec.sec=sec;else clearInterval(tick)},250)}).catch(()=>toast("رُفض إذن الميكروفون ","err"))}
SHEETS.sharePick=(id)=>{const rows=S.chats.filter(c=>!c.archived).map(c=>["chat",c.id,u(c.userId).name,u(c.userId)]).concat(S.groups.filter(g=>g.joined).map(g=>["group",g.id,g.name,null,g])).concat(S.worlds.filter(w=>w.joined).map(w=>["world",w.id,w.name,null,w]));
  return sheet(I("users","i s")+" إرسال إلى",`<div class="col">${rows.map(r=>{const [k,rid,nm,uu,gw]=r;return `<button class="lstrow" style="padding:10px" onclick="sendShareTo('post','${id||""}','${k}','${rid}')">${uu?`<span>${av(uu,32)}</span>`:`<span class="ico-tile" style="background:linear-gradient(135deg,${(gw||{}).c1||"#334155"},${(gw||{}).c2||"#64748B"});color:#fff">${I(k==="group"?"users":"globe","i l")}</span>`}<span class="g1 b xs" style="text-align:right">${esc(nm)}</span>${I("send","i s")}</button>`}).join("")||`<div class="tiny fnt mut">لا وجهات متاحة</div>`}</div>`)};
function sendShareTo(kind,ref,k,rid){const p=(S.posts||[]).find(x=>x.id===ref);if(!p){toast("المنشور غير موجود ","err");return}
  const m={type:"share",kind:kind,ref:ref,text:"شارك منشوراً معك"};
  if(k==="chat"){const c=(S.chats||[]).find(x=>x.id===rid);if(!c)return;c.messages.push(Object.assign({id:uid(),from:"me",at:now()},m));c.last="منشور مشترك";c.lastAt=now()}
  else if(k==="group"){const g=(S.groups||[]).find(x=>x.id===rid);if(!g)return;g.msgs.push(Object.assign({id:uid(),uid:"me",at:now()},m))}
  else{const w=(S.worlds||[]).find(x=>x.id===rid);if(!w)return;w.msgs.push(Object.assign({id:uid(),uid:"me",at:now()},m))}
  save();closeOvl();snd("send");toast("أُرسلت بطاقة المنشور ","ok");if(k==="chat")go("chatRoom",{id:rid});else if(k==="group")go("groupRoom",{id:rid});else go("worldRoom",{id:rid})}
function togNotif(k,el){S.notifPrefs=S.notifPrefs||{post:true,msg:true,live:true,quest:true,follow:false,week:true};S.notifPrefs[k]=!S.notifPrefs[k];if(el)el.classList.toggle("on");save();snd("tap");toast("الإشعارات: "+(S.notifPrefs[k]?"مفعّلة":"معطّلة")+" (محفوظ)","info")}
function toggleForceOffline(){S.forceOffline=!S.forceOffline;save();if(S.forceOffline){netbar(false);toast("وضع عدم الاتصال مفعّل — كل شيء يُحفظ ويرسل لاحقاً ","err")}else{netbar(true);flushOffQ();toast("عاد الاتصال وأُرسل المعلق ","ok")}if(S.page==="hubSettings")render()}
function backupJSON(){return safeStr(S)}
function exportBackup(){dl("animeblack-backup-v20.json",backupJSON(),"application/json");toast("نُزّل ملف النسخة الاحتياطية الكامل ","ok");snd("success")}
function copyBackup(){copyTxt(backupJSON().slice(0,2000));toast("نُسخت أول ٢٠٠٠ حرف — للاستخدام السريع ","ok")}
function importBackupData(txt){try{const o=JSON.parse(txt);if(!o||!o.me||!Array.isArray(o.posts))throw 0;Object.keys(o).forEach(k=>{S[k]=o[k]});save();closeOvl();render();celebrate("استُعيدت النسخة الاحتياطية بنجاح ");return true}catch(e){toast("ملف غير صالح — تأكد أنه ملف نسخة أنمي بلاك ","err");return false}}
function importBackupFile(inp){const f=inp.files&&inp.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>importBackupData(rd.result);rd.readAsText(f)}
function storageRows(){const kb=x=>(JSON.stringify(x).length/1024).toFixed(1);return [["المنشورات والتعليقات",S.posts,kb(S.posts)],["المحادثات والرسائل",S.chats,kb(S.chats)],["الموسوعة",S.wiki,kb(S.wiki)],["المجتمعات",S.communities||[],kb(S.communities||[])],["الريلز والقصص",[S.reels,S.stories],kb([S.reels,S.stories])]]}
function clearStore(k){const before=safeStr(S).length;
  if(k==="drafts"){S.postDrafts=[];S.scheduledPosts=[];S.chatDrafts={}}
  else if(k==="hidden"){S.hidden=[];S.chats.forEach(c=>c.messages.forEach(m=>{if(m.gone)m.gone=false}))}
  else if(k==="history"){S.me.history=[];S.searchHist=[];S.wiki.anime.forEach(a=>{if(a.ep_seen)a.ep_seen=0})}
  else if(k==="walls"){S.chats.forEach(c=>{c.wallpaperImg=null});S.storyImg=null}
  else if(k==="search"){S.searchHist=[];S.csQ=""}
  save();const freed=Math.max(0,Math.round((before-safeStr(S).length)/1024));openSheet("storageSheet");toast("حُرّر ~ "+freed+" KB ","ok");snd("success")}
SHEETS.storageSheet=()=>sheet(I("db","i s")+" مدير التخزين والكاش",`<div class="col">
  <div class="rowb" style="padding:8px 2px;border-bottom:1px solid var(--line)"><span class="xs b">إجمالي الحالة المحفوظة</span><span class="badge b-cyan mono">${(safeStr(S).length/1024).toFixed(0)} KB</span></div>
  ${storageRows().map(([l,,v])=>`<div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">${l}</span><span class="xs b mono">${v} KB</span></div>`).join("")}
  <div class="lbl" style="margin-top:11px">تفريغ انتقائي (آمن وقابل للعكس بالنسخ الاحتياطي)</div>
  ${[["drafts","المسودات والمجدول","file"],["hidden","المخفي والمحذوف لدي الجميع","eyeoff"],["history","سجل المشاهدة والبحث","clock"],["walls","صور الخلفيات المرفوعة","palette"],["search","سجل البحث فقط","search"]].map(([k,l,ic])=>`<button class="lstrow" onclick="clearStore('${k}')"><span style="color:var(--rose)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">تفريغ: ${l}</span>${I("trash","i s")}</button>`).join("")}
</div>`);
SHEETS.backupSheet=()=>sheet(I("cloud","i s")+" نسخ احتياطي واستعادة",`<input type="file" id="bkFile" accept="application/json" style="display:none" onchange="importBackupFile(this)">
  <div class="col"><div class="card2" style="padding:11px"><div class="rowb"><span class="xs b">حجم بياناتك الحالية</span><span class="badge b-cyan mono">${(safeStr(S).length/1024).toFixed(0)} KB</span></div><div class="tiny fnt" style="margin-top:5px">يشمل: منشورات، محادثات، مجتمعات، موسوعة، اقتصاد، إعدادات — كل شيء.</div></div>
  <button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="exportBackup()">${I("download","i s")} تنزيل نسخة احتياطية كاملة (JSON)</button>
  <button class="btn btn-sec btn-sm" onclick="document.getElementById('bkFile').click()">${I("upload","i s")} استعادة من ملف نسخة</button>
  <button class="btn btn-ghost btn-sm" onclick="copyBackup()">${I("copy","i s")} نسخ مقتطف للنص</button>
  <div class="tiny fnt center" style="margin-top:8px">الاستعادة تستبدل الحالة الحالية بالكامل — صدّر نسخة أولاً إن أردت حفظها</div></div>`);
const CHANGELOG=[["٢٥٫٠","إتقان النشر والمجتمعات","استوديوهات نشر مخصصة (نص بصيغة غنية/ألبوم صور/استطلاع/فيديو/ريلز بمؤثرات)، غرف القروبات والعوالم بمرفقات واستطلاعات وتثبيت وإعلانات رسمية، ترقية أعضاء، غلاف فعالية من الهاتف، مشاركة الفعالية بمنشور مموج، حذف الغرف الصوتية",""],
["٢٤٫٠","إتقان القروبات والنقابات والعوالم والفعاليات","ريلز بتبويب سفلي، ملاحظات انستغرام، طلبات مراسلة وانضمام، فعاليات بجوائز وفائزين، أخبار إدارية، إشعارات بتفضيلات",""],["٢٣٫٠","القروبات والنقابات والعوالم","صفحات إنشاء مخصصة بعملات ومستويات، خزائن ومهام ورتب، إلغاء البث"],["٢٢٫٠","إتقان المزيد ٢","قفل PIN حقيقي، ربط حسابات، بحث إعدادات، عدّاد جلسة"],["٢١٫٠","إتقان المزيد","نسخ احتياطي واستعادة، مدير تخزين، دعم ودعوات"],["٢٠٫٠","إتقان الدردشة","مسودات لكل محادثة، رسائل مختفية، تمييز وتحديد متعدد، إحصائيات، معاينة روابط، قنوات محفوظة، سجل مكالمات"],["١٩٫٠","إتقان إنشاء المنشور","خيارات نشر متخصصة لكل نوع، معاينة قبل النشر، مسودات بوسوم دائمة"],["١٨٫٠","إتقان الاستكشاف","محرك توصيات بأسباب مفسرة، بحث شامل بعدّادات وفرز وسوم وصوت"],["١٧٫٠","إتقان الشاشة الرئيسية","أقسام قابلة للترتيب والإخفاء، ودجات حية، تخصيص البطاقات"],["١٦٫٠","إتقان كل التفاصيل","تفعيل شامل للأزرار والأوراق والتصميم المتجاوب"],["١٥٫٠","بروفايل احترافي","تحليلات وألقاب وإطارات وبطاقة رقمية"],["١٤٫٠","دردشات وقصص برو","مكالمات ومسجلات حقيقية وملصقات SVG"]];
SHEETS.changelogSheet=()=>sheet(I("list","i s")+" سجل التغييرات",`<div class="col">${CHANGELOG.map(([v,t,d])=>`<div class="card2" style="padding:11px"><div class="rowb"><span class="b xs" style="color:var(--accent)">الإصدار ${v}</span><span class="badge b-gray mono">أنمي بلاك</span></div><div class="xs b" style="margin-top:4px">${t}</div><div class="tiny fnt" style="margin-top:3px;line-height:1.6">${d}</div></div>`).join("")}</div>`);
const FAQ=[["كيف أنشر منشوراً متخصصاً؟","من زر + الأوسط اختر النوع: لكل نوع حقوله (فعالية، خبر، ريلز، إعلان، يونيفرس...) ومعاينة قبل النشر"],["أين مسوداتي؟","في شاشة الإنشاء زر «مسوداتي»، وفي الدردشة كل محادثة تحفظ مسودتها تلقائياً"],["كيف أفعّل الرسائل المختفية؟","من قائمة غرفة الدردشة ← الرسائل المختفية ← اختر ٢٤ ساعة أو ٣ أيام"],["كيف أستعيد نسختي الاحتياطية؟","المزيد ← نسخ احتياطي ← استعادة من ملف"],["لماذا لا يعمل التسجيل الصوتي؟","امنح إذن الميكروفون من المتصفح ثم أعد الضغط — التسجيل حقيقي عبر MediaRecorder"],["كيف أغيّر الخلفية والفقاعات؟","قائمة غرفة الدردشة ← خلفية المحادثة وفقاعاتها"],["أين الإدارة؟","الشريط الأحمر أعلى شاشة المزيد «الإدارة أنمي بلاك»"],["كيف أكسب عملات ونجوم؟","المهام اليومية في النشاط، النشر، المكافأة اليومية من الرئيسية"]];
SHEETS.helpSheet=()=>{const q=(S.faqQ||"").trim();const list=FAQ.filter(([a,b])=>!q||a.includes(q)||b.includes(q));
 return sheet(I("help","i s")+" مركز المساعدة",`<div class="row" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:12px;padding:9px 11px;margin-bottom:10px">${I("search","i s")}<input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث في الأسئلة..." value="${esc(S.faqQ||"")}" oninput="S.faqQ=this.value;const e=$('#faqres');if(e)e.innerHTML=faqList()"></div><div class="col" id="faqres">${faqList()}</div><button class="btn btn-sec btn-sm" style="margin-top:10px" onclick="openSheet('supportSheet')">${I("headphones","i s")} لم تجد جوابك؟ افتح تذكرة</button></div>`)};
function faqList(){const q=(S.faqQ||"").trim();const list=FAQ.filter(([a,b])=>!q||a.includes(q)||b.includes(q));return list.length?list.map(([a,b])=>`<div class="card2" style="padding:10px;margin-bottom:7px"><div class="xs b">${I("help","i s")} ${a}</div><div class="tiny fnt" style="margin-top:4px;line-height:1.6">${b}</div></div>`).join(""):`<div class="center tiny mut" style="padding:16px 0">لا نتائج — جرّب كلمة أخرى أو افتح تذكرة</div>`}
SHEETS.supportSheet=()=>sheet(I("headphones","i s")+" الدعم الفني",`<div class="col"><label class="lbl">نوع الطلب</label><div class="chiprow">${["مشكلة تقنية","اقتراح ميزة","مشكلة حساب","أخرى"].map((x,i)=>`<button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(c=>c.classList.remove('on'));this.classList.add('on');window.__tkCat='${x}'">${x}</button>`).join("")}</div>
  <label class="lbl" style="margin-top:9px">وصف المشكلة</label><textarea class="inp" id="tkTxt" rows="3" placeholder="اشرح بالتفصيل ماذا حدث..."></textarea>
  <button class="btn btn-primary btn-sm" style="margin-top:9px" onclick="submitTicket()">${I("send","i s")} إرسال التذكرة</button>
  <div class="div" style="margin:11px 0"></div><div class="b xs">تذاكري (${(S.tickets||[]).length})</div>
  ${(S.tickets||[]).length?(S.tickets||[]).map(t=>`<div class="card2" style="padding:10px;margin-top:7px"><div class="rowb"><span class="tiny b">${esc(t.cat)} · #${t.id.slice(0,4)}</span><span class="badge ${t.status==="answered"?"b-emerald":"b-gold"}">${t.status==="answered"?"تم الرد":"قيد المعالجة"}</span></div><div class="tiny fnt" style="margin-top:4px">${esc(((t&&t.txt)||"").slice(0,80))}</div>${t.reply?`<div class="tiny" style="margin-top:6px;color:var(--emerald);line-height:1.6">${I("headphones","i s")} ${esc(t.reply)}</div>`:""}</div>`).join(""):`<div class="tiny fnt center" style="padding:10px">لا تذاكر بعد</div>`}</div>`);
function submitTicket(){const t=($("#tkTxt")&&$("#tkTxt").value||"").trim();if(!t){toast("اشرح المشكلة أولاً ","err");return}(S.tickets=S.tickets||[]).unshift({id:uid(),cat:window.__tkCat||"مشكلة تقنية",txt:t,at:now(),status:"open"});save();snd("success");toast("أُرسلت تذكرتك — سيصلك رد قريباً ","ok");openSheet("supportSheet");
  setTimeout(()=>{const x=(S.tickets||[])[0];if(x&&x.status==="open"){x.status="answered";x.reply="استلمنا طلبك وعملنا على فحصه — الفريق سيعالجها خلال ٢٤ ساعة، وشكراً لصبرك ";save();if(document.querySelector(".sheet"))openSheet("supportSheet")}},3500)}
SHEETS.inviteSheet=()=>{const code="AB-"+String(strHash(S.me.username)%9999).padStart(4,"0");
 return sheet(I("gift","i s")+" دعوة الأصدقاء",`<div class="col center"><div class="tiny fnt">كود الإحالة الدائم الخاص بك</div><div class="bb mono" style="font-size:26px;letter-spacing:3px;color:var(--accent);margin:9px 0" dir="ltr">${code}</div>
  <div class="grid2"><button class="btn btn-sec btn-sm" onclick="copyTxt('${code}');toast('نُسخ الكود ','ok')">${I("copy","i s")} نسخ</button><button class="btn btn-primary btn-sm" onclick="sendInvite()">${I("users","i s")} محاكاة انضمام صديق</button></div>
  <div class="card2" style="padding:10px;margin-top:11px;width:100%"><div class="rowb"><span class="xs b">أصدقاء انضموا بكودك</span><span class="badge b-emerald mono">${S.invites||0} / 3</span></div><div class="rowb" style="margin-top:5px"><span class="xs b">مكافأة كل صديق</span><span class="badge b-gold mono">+50 عملة</span></div></div>
  <div class="tiny fnt" style="margin-top:8px">حتى ٣ مكافآت تجريبية لكل حساب</div></div>`)};
function sendInvite(){if((S.invites||0)>=3){toast("وصلت الحد الأقصى للمكافآت (٣) ","info");return}S.invites=(S.invites||0)+1;addCoins(50,"دعوة صديق");save();celebrate("انضم صديقك! +50 عملة ");openSheet("inviteSheet")}
SHEETS.rateSheet=()=>sheet(I("star","i s")+" قيّم أنمي بلاك",`<div class="col center"><div class="tiny fnt">تقييمك يُحفظ في ملفك ويُكافأ مرة واحدة (+20 عملة)</div>
  <div class="row" style="gap:9px;justify-content:center;margin:13px 0">${[1,2,3,4,5].map(i=>`<button style="line-height:0;background:none;border:none;cursor:pointer;color:${i<=(S.myRating||0)?"var(--gold)":"var(--faint)"}" onclick="setRate(${i})" aria-label="${i} نجوم">${I("star","xl")}</button>`).join("")}</div>
  <div class="xs b">${S.myRating?("تقييمك الحالي: "+S.myRating+" من ٥"):"لم تقيّم بعد"}</div>
  <div class="tiny fnt mut" style="margin-top:7px">متوسط تقييم المجتمع: 4.8 من 5 (${hcount("rate")} تقييماً)</div></div>`);
function setRate(i){const first=!S.myRating;S.myRating=i;save();snd("success");if(first){addCoins(20,"تقييم التطبيق");celebrate("شكراً لتقييمك! +20 عملة ")}else toast("حُدّث تقييمك إلى "+i+" ","ok");openSheet("rateSheet")}
SHEETS.myActivitySheet=()=>{const days=["الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];const wd=[0,0,0,0,0,0,0];S.posts.filter(p=>p.authorId==="me").forEach(p=>wd[new Date(p.createdAt||now()).getDay()]++);
 const msgs=S.chats.reduce((a,c)=>a+c.messages.filter(m=>m.from==="me").length,0);const mx=Math.max(1,...wd);
 return sheet(I("chart","i s")+" ملخص نشاطي",`<div class="col">
  <div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">وقت جلستك الحالية</span><span class="xs b mono">${Math.floor((S.sessionSec||0)/60)} د ${String((S.sessionSec||0)%60).padStart(2,"0")} ث</span></div>
  <div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">منشوراتك</span><span class="xs b mono">${S.posts.filter(p=>p.authorId==="me").length}</span></div>
  <div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">رسائلك المرسلة</span><span class="xs b mono">${msgs}</span></div>
  <div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">تعليقاتك</span><span class="xs b mono">${S.posts.reduce((a,p)=>a+p.comments.filter(c=>c.userId==="me").length,0)}</span></div>
  <div class="rowb" style="padding:7px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt">مجتمعاتك</span><span class="xs b mono">${(S.communities||[]).filter(c=>c.joined).length}</span></div>
  <div class="lbl" style="margin-top:10px">نشاط النشر أسبوعياً</div>
  <div class="row" style="gap:5px;align-items:flex-end;height:74px">${wd.map((v,i)=>`<div class="g1 center" style="gap:3px"><div style="width:100%;height:${Math.round(6+v/mx*52)}px;border-radius:6px;background:${v===mx?"var(--accent)":"var(--surface3)"}"></div><span class="tiny fnt" style="font-size:8px">${days[i].slice(0,3)}</span></div>`).join("")}</div></div>`)};
SHEETS.aboutSheet=()=>sheet(I("info","i s")+" عن أنمي بلاك",`<div class="col center">
  <div class="bb" style="font-size:17px">أنمي بلاك · الإصدار ٢٥٫٠</div>
  <div class="tiny fnt" style="margin-top:4px;line-height:1.7">منصة أوتاكو عربية كاملة في ملف HTML واحد — بلا سيرفر، بلا إيموجي، أيقونات SVG أصلية، وكل الأنظمة تعمل محلياً.</div>
  <div class="grid2 mono tiny" style="gap:6px;margin:11px 0;width:100%">${[["منشورات",(S.posts||[]).length],["محادثات",(S.chats||[]).length],["مجتمعات",(S.communities||[]).length],["أنمي الموسوعة",(S.wiki.anime||[]).length],["ريلز",(S.reels||[]).length],["قصص",(S.stories||[]).length]].map(([k,v])=>`<div class="card2" style="padding:7px"><span class="tiny fnt">${k}</span><span class="xs b mono" style="display:block">${v}</span></div>`).join("")}</div>
  <div class="grid2"><button class="btn btn-sec btn-sm" onclick="openSheet('changelogSheet')">${I("list","i s")} السجل</button><button class="btn btn-sec btn-sm" onclick="openSheet('helpSheet')">${I("help","i s")} المساعدة</button></div>
  <button class="btn btn-ghost btn-sm" style="margin-top:8px" onclick="openSheet('backupSheet')">${I("cloud","i s")} نسخ احتياطي</button></div>`);
SHEETS.accountSwitcherSheet=()=>{
  ensureAccounts();
  const curId = S.me.id || (S.me.uid || "me");
  const curEmail = (S.me.email || "").toLowerCase();
  return sheet(I("users","i s")+" تبديل الحسابات (مثل إنستغرام وتلغرام)",`<div class="col" style="gap:11px">
    <div class="rowb">
      <span class="tiny fnt">الحسابات المسجلة والنشطة على جهازك (${(S.savedAccounts||[]).length})</span>
      <span class="badge b-cyan" style="font-size:9.5px">تبديل فوري بلمسة واحدة</span>
    </div>
    <div class="col" style="gap:8px;max-height:300px;overflow-y:auto;padding-left:2px">
      ${S.savedAccounts.map(acc=>{
        const isCur = (acc.id === curId || acc.uid === curId || (curEmail && (acc.email||"").toLowerCase() === curEmail));
        return `<div class="card2 row" style="gap:10px;padding:10px;border-color:${isCur?'var(--accent)':'var(--line2)'};background:${isCur?'rgba(34,211,238,.09)':'var(--surface2)'};border-radius:14px;transition:all .18s ease">
          <div style="position:relative;line-height:0;cursor:pointer" onclick="${isCur?'':'switchSavedAccount(\''+acc.id+'\')'}">
            ${av(acc,46,true)}
            ${isCur?`<span style="position:absolute;bottom:0;right:0;width:13px;height:13px;border-radius:50%;background:var(--emerald);border:2px solid var(--surface)"></span>`:""}
          </div>
          <div class="g1" style="min-width:0;text-align:right;cursor:pointer" onclick="${isCur?'':'switchSavedAccount(\''+acc.id+'\')'}">
            <div class="row" style="gap:5px;flex-wrap:wrap">
              <span class="b xs">${esc(acc.name)}</span>
              ${isCur?`<span class="badge b-emerald" style="font-size:9.5px">${I("check","i s")} الحساب النشط</span>`:''}
              ${vbadge(acc)}
              <span class="badge b-gold" style="font-size:8.5px">مستوى ${acc.level||1}</span>
            </div>
            <div class="tiny fnt mono" dir="ltr" style="overflow:hidden;text-overflow:ellipsis">@${esc(acc.username)} ${acc.email?('· '+esc(acc.email)):''}</div>
          </div>
          <div class="row" style="gap:4px">
            ${!isCur?`<button class="btn btn-primary btn-xs" onclick="switchSavedAccount('${acc.id}')">${I("refresh","i s")} تبديل</button>`:`<span style="color:var(--emerald);padding-inline:6px;line-height:0">${I("check")}</span>`}
            ${(S.savedAccounts||[]).length > 1 ? `<button class="iconbtn" style="width:28px;height:28px;color:var(--rose)" onclick="event.stopPropagation();removeSavedAccount('${acc.id}')" title="إزالة من هذا الجهاز">${I("trash","i s")}</button>` : ''}
          </div>
        </div>`;
      }).join("")}
    </div>
    <div class="div" style="margin:4px 0"></div>
    <div class="grid2" style="gap:7px">
      <button class="btn btn-sec btn-sm" style="justify-content:center;gap:6px;border-color:rgba(34,211,238,.35);background:rgba(34,211,238,.08);color:var(--accent)" onclick="openSheet('quickAltModal')">
        ${I("zap","i s")} حساب بديل فوري (Alt)
      </button>
      <button class="btn btn-primary btn-sm" style="justify-content:center;gap:6px" onclick="openSheet('addAccountModal')">
        ${I("plus","i s")} إضافة بريد / تسجيل دخول
      </button>
    </div>
  </div>`);
};

SHEETS.quickAltModal=()=>{
  return modal(I("zap","i s")+" إنشاء حساب بديل فوري (Alt Profile)",`
    <div class="col" style="gap:11px;text-align:right">
      <div class="tiny fnt">أنشئ حساباً بديلاً أو شخصية ثانوية فوراً دون الحاجة لكلمات مرور، للتبديل والتجربة بلمسة واحدة:</div>
      
      <label class="lbl" style="margin-bottom:-4px">الاسم الظاهر</label>
      <input class="inp" id="alt_name" type="text" placeholder="مثال: ليفاي، كيلوا، أوتاكو أسطوري..." value="شخصية أوتاكو ${(S.savedAccounts||[]).length + 1}">
      
      <label class="lbl" style="margin-bottom:-4px">اسم المستخدم (Username)</label>
      <input class="inp mono" id="alt_uname" type="text" placeholder="username" dir="ltr" value="alt_${Math.random().toString(36).substring(2, 7)}">
      
      <div class="row" style="gap:8px;margin-top:4px">
        <button class="btn btn-primary btn-lg g1" onclick="createQuickAltAccount($('#alt_name').value, $('#alt_uname').value)">
          ${I("check","i s")} إنشاء وتبديل فوراً
        </button>
        <button class="btn btn-sec btn-lg" onclick="openSheet('accountSwitcherSheet')">
          ${I("back","i s")} رجوع
        </button>
      </div>
    </div>
  `);
};

SHEETS.addAccountModal=()=>{
  return modal(I("userplus","i s")+" إضافة حساب جديد أو تسجيل دخول",`
    <div class="col" style="gap:11px;text-align:right">
      <div class="tiny fnt">أدخل البريد الإلكتروني وكلمة المرور للـتسجيل أو الدخول بحسابك الآخر، وسيُحفظ تلقائياً في قائمة التبديل السريع:</div>
      
      <label class="lbl" style="margin-bottom:-4px">البريد الإلكتروني للـحساب</label>
      <div class="row" style="gap:7px">
        <span class="badge b-gray">${I("mail","i s")}</span>
        <input class="inp g1 mono" id="add_acc_e" type="email" placeholder="user@example.com">
      </div>
      
      <label class="lbl" style="margin-bottom:-4px">كلمة المرور</label>
      <div class="row" style="gap:7px">
        <span class="badge b-gray">${I("lock","i s")}</span>
        <input class="inp g1" id="add_acc_p" type="password" placeholder="••••••••" onkeydown="if(event.key==='Enter')submitAddAccount('login')">
      </div>
      
      <div class="grid2" style="gap:8px;margin-top:6px">
        <button class="btn btn-primary btn-lg" onclick="submitAddAccount('login')">
          ${I("logout","i s")} تسجيل الدخول
        </button>
        <button class="btn btn-sec btn-lg" onclick="submitAddAccount('register')">
          ${I("userplus","i s")} إنشاء حساب جديد
        </button>
      </div>
      
      <div class="row" style="gap:10px;margin:6px 0">
        <div class="g1 div" style="margin:0"></div>
        <span class="tiny fnt" style="opacity:.8">أو</span>
        <div class="g1 div" style="margin:0"></div>
      </div>
      
      <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;gap:8px" onclick="submitAddAccount('google')">
        ${I("globe","i s")} إضافة بواسطة Google
      </button>
      
      <button class="btn btn-sec btn-sm" style="width:100%;margin-top:4px" onclick="openSheet('accountSwitcherSheet')">
        ${I("back","i s")} العودة لقائمة الحسابات
      </button>
    </div>
  `);
};
SHEETS.shareProfile=(id)=>{const x=u(id||"me");
  return modal(I("share","i s")+" مشاركة ملف "+esc(x.name),`
  <div class="rowb card2" style="padding:10px;margin-bottom:12px"><span class="mono tiny g1" dir="ltr" style="overflow:hidden;text-overflow:ellipsis">animeblack.app/@${x.username}</span>
    <button class="btn btn-primary btn-xs" onclick="copyTxt('animeblack.app/@${x.username}')">${I("copy","i s")}</button></div>
  <div class="grid4" style="gap:8px">${[["واتساب","WA","#25D366"],["تيليجرام","TG","#229ED9"],["تويتر","X","#000"],["انستغرام","IG","#E1306C"]].map(([l,g2,c])=>`
    <button class="col center" style="gap:5px;background:none;border:none" onclick="shareProfileVia('${g2}','${x.id}')"><span style="width:42px;height:42px;border-radius:13px;background:${c};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;font-family:ui-monospace,monospace;color:${g2==="X"?"#fff":"#0A0A0F"}">${g2}</span><span class="tiny" style="font-size:9px;font-weight:700">${l}</span></button>`).join("")}</div>
  <button class="btn btn-sec btn-lg" style="margin-top:13px" onclick="closeOvl();go('qrCard')">${I("qr","i s")} عرض بطاقة QR</button>`)};
SHEETS.communityHealthDetail=(id)=>{
  ensureCommunities();
  const c = (S.communities||[]).find(x=>x.id===id) || S.communities[0];
  if(!c) return sheet("تقرير صحة المجتمع", "<div class='tiny fnt pad'>المجتمع غير متوفر</div>");
  const stats = getSingleCommunityHealthStats(c);
  const isStrict = !!(S.guildStrictGuards && S.guildStrictGuards[c.id]);

  return sheet(I("barchart","i s")+" تقرير صحة المحتوى: "+esc(c.name),`
  <div class="col" style="gap:12px">
    <div class="card2 row" style="gap:10px;padding:12px">
      <span class="ico-tile" style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,${c.c1||'#1E3A8A'},${c.c2||'#3B82F6'})">${I(c.icon||"shield","i l")}</span>
      <div class="g1" style="min-width:0;text-align:right">
        <div class="row" style="gap:6px">
          <span class="b sm">${esc(c.name)}</span>
          <span class="badge ${stats.status.badge}">${stats.status.label}</span>
        </div>
        <div class="tiny fnt">${stats.typeLabel} · ${nfmt(c.members||0)} عضو · ${c.online||0} متصل حالياً</div>
      </div>
    </div>

    <!-- بطاقات القياس الدقيقة -->
    <div class="grid3" style="gap:8px">
      <div class="card stat" style="padding:9px 6px">
        <span style="color:var(--accent)">${I("msgsq","i s")}</span>
        <b class="mono" style="font-size:13px">${nfmt(stats.totalContent)}</b>
        <span>إجمالي المحتوى</span>
      </div>
      <div class="card stat" style="padding:9px 6px">
        <span style="color:var(--rose)">${I("flag","i s")}</span>
        <b class="mono" style="font-size:13px">${stats.reportedCount}</b>
        <span>المحتوى المبلّغ</span>
      </div>
      <div class="card stat" style="padding:9px 6px">
        <span style="color:${stats.ratio < 2 ? 'var(--emerald)' : 'var(--gold)'}">${I("chart","i s")}</span>
        <b class="mono" style="font-size:13px">${stats.ratio}%</b>
        <span>نسبة البلاغات</span>
      </div>
    </div>

    <!-- مؤشر النقاء والسلامة -->
    <div class="card" style="padding:12px">
      <div class="rowb" style="margin-bottom:6px">
        <div class="b xs">${I("shield","i s")} مؤشر النقاء ومكافحة المخالفات</div>
        <span class="b xs mono" style="color:var(--emerald)">${stats.healthScore}% سلامة</span>
      </div>
      <div class="bar" style="height:8px;background:var(--surface3);border-radius:6px;overflow:hidden">
        <i style="width:${stats.healthScore}%;background:linear-gradient(90deg,var(--cyan),var(--emerald));height:100%;display:block"></i>
      </div>
      <div class="rowb tiny fnt" style="margin-top:6px">
        <span>معدل اعتراض الحرس الذكي: <b>${stats.autoInterceptionRate}%</b></span>
        <span>متوسط سرعة الإغلاق: <b>${stats.avgResponseMin} دقيقة</b></span>
      </div>
    </div>

    <!-- توزيع أسباب البلاغات داخل الكيان -->
    <div class="card" style="padding:12px">
      <div class="b xs" style="margin-bottom:8px">${I("list","i s")} تفصيل البلاغات المرصودة</div>
      <div class="col" style="gap:7px">
        <div class="rowb tiny">
          <span>رسائل مزعجة وإعلانات (Spam)</span>
          <span class="mono b">${stats.breakdown.spam} (${Math.round((stats.breakdown.spam/(stats.reportedCount||1))*100)}%)</span>
        </div>
        <div class="bar" style="height:4px;background:var(--surface3)"><i style="width:${Math.round((stats.breakdown.spam/(stats.reportedCount||1))*100)}%;background:var(--gold);height:100%;display:block"></i></div>

        <div class="rowb tiny">
          <span>تنمّر وسلوك مسيء (Harassment)</span>
          <span class="mono b">${stats.breakdown.harassment} (${Math.round((stats.breakdown.harassment/(stats.reportedCount||1))*100)}%)</span>
        </div>
        <div class="bar" style="height:4px;background:var(--surface3)"><i style="width:${Math.round((stats.breakdown.harassment/(stats.reportedCount||1))*100)}%;background:var(--rose);height:100%;display:block"></i></div>

        <div class="rowb tiny">
          <span>محتوى غير لائق / مخالف (Toxic)</span>
          <span class="mono b">${stats.breakdown.toxic} (${Math.round((stats.breakdown.toxic/(stats.reportedCount||1))*100)}%)</span>
        </div>
        <div class="bar" style="height:4px;background:var(--surface3)"><i style="width:${Math.round((stats.breakdown.toxic/(stats.reportedCount||1))*100)}%;background:#A855F7;height:100%;display:block"></i></div>

        <div class="rowb tiny">
          <span>حرق أحداث وتضليل (Spoilers)</span>
          <span class="mono b">${stats.breakdown.spoilers} (${Math.round((stats.breakdown.spoilers/(stats.reportedCount||1))*100)}%)</span>
        </div>
        <div class="bar" style="height:4px;background:var(--surface3)"><i style="width:${Math.round((stats.breakdown.spoilers/(stats.reportedCount||1))*100)}%;background:var(--cyan);height:100%;display:block"></i></div>
      </div>
    </div>

    <!-- إجراءات الإشراف والحوكمة -->
    <div class="grid2" style="gap:7px">
      <button class="btn btn-primary btn-sm" onclick="adminComStrictGuard('${c.id}')">
        ${I("bot","i s")} ${isStrict ? "تعطيل الحرس الصارم" : "تفعيل الحرس الصارم"}
      </button>
      <button class="btn btn-gold btn-sm" onclick="adminWarnCommunityMods('${c.id}')">
        ${I("bell","i s")} تنبيه إدارة الكيان
      </button>
      <button class="btn btn-sec btn-sm" onclick="closeOvl();filterReportsByCommunity('${c.id}')">
        ${I("shield","i s")} مراجعة طابور البلاغات
      </button>
      <button class="btn btn-sec btn-sm" onclick="exportSingleCommunityHealthJSON('${c.id}')">
        ${I("code","i s")} تصدير تقرير التدقيق
      </button>
    </div>
  </div>`);
};
SHEETS.communityMenu=(id)=>{const c=(S.communities||[]).find(x=>x.id===id)||S.communities[0];if(!c)return sheet("القائمة","<div class='tiny fnt'>لا مجتمعات بعد</div>");
  return sheet(I(ICONS.includes(c.icon)?c.icon:"users","i s")+" "+esc(c.name),`<div class="col">
    ${[["info","معلومات المجتمع",`closeOvl();go('communityDetail',{id:'${id}',sub:'about'})`],["users","الأعضاء",`closeOvl();go('communityDetail',{id:'${id}',sub:'members'})`],
       ["bell","تفعيل الإشعارات",`toast('ستصلك إشعارات ${c.name} ','ok');closeOvl()`],["pin","تثبيت في الأعلى",`c.pinned=!c.pinned;save();closeOvl();toast(c.pinned?'ثُبّت المجتمع ':'أُلغي التثبيت','ok')`],
       ["crown","إدارة الرتب",`closeOvl();openSheet('guildRoles','${id}')`],...(c.type==="guild"?[["wallet","خزينة النقابة",`closeOvl();go('communityDetail',{id:'${id}',sub:'treasury'})`],["inbox","طلبات الانضمام",`closeOvl();openSheet('joinReqSheet','guild|${id}')`]]:[]),
       ["usercheck","دعوة أصدقاء",`closeOvl();openSheet('newChatSheet')`],["share","مشاركة",`closeOvl();openSheet('shareSheet')`],
       ["flag","إبلاغ",`closeOvl();go('report',{id:''})`]].map(([ic,l,fn])=>`
      <button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}
    ${c.joined?`<button class="lstrow" onclick="c.joined=false;save();closeOvl();render();toast('غادرت ${c.name}','info')"><span style="color:var(--rose)">${I("logout","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">مغادرة المجتمع</span></button>`:""}
  </div>`)};
SHEETS.adminUserMenu=(id)=>{const x=u(id);
  const ranks=["TraineeModerator","Moderator","SeniorModerator","SectionManager","Administrator","SuperAdministrator","Developer","Owner","Member"];
  return sheet(I("shield","i s")+" إدارة "+esc(x.name),`
  <div class="lstrow" style="margin-bottom:12px">${av(x,44)}<div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(x.name)}</span>${vbadge(x)}</div><div class="tiny fnt mono">@${esc(x.username)} · LV ${x.level}</div></div></div>
  <div class="lbl">الرتبة</div>
  <div class="chiprow wrap">${ranks.map(r=>`<button class="chip mono ${x.role===r?'on':''}" style="font-size:9px" onclick="x.role='${r}';(S.users||[]).find(y=>y.id==='${id}').role='${r}';save();closeOvl();render();toast('الرتبة: ${r}','ok')">${r}</button>`).join("")}</div>
  <div class="div"></div>
  <div class="grid2" style="gap:7px">
    <button class="btn btn-gold btn-xs" onclick="(S.users||[]).find(y=>y.id==='${id}').isVerified=!x.isVerified;save();closeOvl();render();toast('تغيير حالة التوثيق','ok')">${I("check","i s")} ${x.isVerified?"إلغاء التوثيق":"توثيق الحساب"}</button>
    <button class="btn btn-sec btn-xs" onclick="closeOvl();toast('أُرسل تنبيه للمستخدم ','ok')">${I("bell","i s")} إرسال تنبيه</button>
    <button class="btn btn-sec btn-xs" onclick="closeOvl();toast('كتم ٢٤ ساعة ','ok')">${I("mute","i s")} كتم ٢٤ ساعة</button>
    <button class="btn btn-sec btn-xs" onclick="closeOvl();toast('كتم دائم','ok')">${I("ban","i s")} كتم دائم</button>
    <button class="btn btn-gold btn-xs" onclick="(S.users||[]).find(y=>y.id==='${id}').coins+=500;save();closeOvl();render();toast('مُنح ٥٠٠ عملة ','ok')">${I("coins","i s")} منح عملات</button>
    <button class="btn btn-danger btn-xs" onclick="S.blocked.push('${id}');save();closeOvl();render();toast('تم حظر المستخدم ','err')">${I("trash","i s")} حظر نهائي</button>
  </div>`)};
SHEETS.mailCompose=(id)=>{const to=S.mailReplyTo||(S.emails||[]).find(e=>e.id===id);
  return sheet(I("edit","i s")+" رسالة جديدة",`
  <label class="lbl">إلى</label><input class="inp mono" id="mc_to" value="${to?esc(to.addr):""}" dir="ltr" placeholder="name@mail.com">
  <div style="height:9px"></div><label class="lbl">نسخة / نسخة مخفية</label>
  <div class="row" style="gap:7px"><input class="inp g1 mono" dir="ltr" placeholder="CC"><input class="inp g1 mono" dir="ltr" placeholder="BCC"></div>
  <div style="height:9px"></div><label class="lbl">الموضوع</label><input class="inp" id="mc_s" value="${to?"رد: "+esc(to.subj):""}" placeholder="موضوع الرسالة">
  <div style="height:9px"></div><label class="lbl">النص</label><textarea class="inp" id="mc_b" rows="6" placeholder="اكتب رسالتك...">${to?"\n\n---\n"+((to&&to.body)||"").slice(0,60):""}</textarea>
  <input type="file" id="mfile" style="display:none" onchange="mailAttach(this)">
  <div class="row" style="gap:7px;margin-top:11px"><button class="btn btn-sec btn-sm g1" onclick="document.getElementById('mfile').click()">${I("link","i s")} إرفاق${(S.mailAtt&&S.mailAtt.length)?" ("+S.mailAtt.length+")":""}</button>
    <button class="btn btn-sec btn-sm g1" onclick="fmtMail()">${I("edit","i s")} تنسيق</button></div>
  <div class="tiny fnt" id="mattNote" style="margin-top:6px">${(S.mailAtt&&S.mailAtt.length)?"المرفقات: "+S.mailAtt.map(esc).join("، "):""}</div>
  <div class="grid2" style="margin-top:9px"><button class="btn btn-primary" onclick="sendMail()">${I("send","i s")} إرسال</button>
    <button class="btn btn-ghost" onclick="saveDraft()">${I("save","i s")} حفظ مسودة</button></div>`)};
function sendMail(){
  const to=($("#mc_to")||{}).value||"",s=($("#mc_s")||{}).value||"(بدون موضوع)",b=($("#mc_b")||{}).value||"";
  if(!/^[^@]+@[^@]+\.[^@]+$/.test(to.trim())){toast("بريد المستلم غير صحيح","err");snd("error");return}
  S.emails.unshift({id:"e"+uid(),folder:"sent",from:"أنا",addr:S.me.email,subj:s,prev:(b||"").slice(0,60),body:b,at:now(),read:true,starred:false,attach:0,to});
  S.mailReplyTo=null;save();closeOvl();toast("أُرسلت الرسالة ","ok");snd("send");render();
}
function saveDraft(){
  const s=($("#mc_s")||{}).value||"(مسودة)",b=($("#mc_b")||{}).value||"";
  S.emails.unshift({id:"e"+uid(),folder:"drafts",from:"أنا",addr:S.me.email,subj:s,prev:(b||"").slice(0,60),body:b,at:now(),read:true,starred:false,attach:0});
  save();closeOvl();toast("حُفظت المسودة ","ok");render();
}
SHEETS.mailMenu=(id)=>sheet(I("mail","i s")+" خيارات البريد",`<div class="col">
  ${[["edit","إنشاء رسالة",`closeOvl();openSheet('mailCompose')`],["refresh","تحديث",`toast('تم التحديث ','ok');closeOvl();render()`],
     ["check","تعليم الكل كمقروء",`S.emails.forEach(e=>e.read=true);save();closeOvl();render();toast('تم التعليم ','ok')`],
     ["archive","أرشفة الكل",`toast('أُرشفت الرسائل ','ok');closeOvl()`],
     ["ban","حظر المرسلين المزعجين",`S.emails=S.emails.filter(e=>e.folder!=='spam');save();closeOvl();render();toast('حُذفت الرسائل المزعجة','ok')`],
     ["trash","إفراغ المهملات",`S.emails=S.emails.filter(e=>e.folder!=='trash');save();closeOvl();render();toast('أُفرغت المهملات','info')`],
     ["settings","إعدادات البريد",`closeOvl();go('hubSettings')`]].map(([ic,l,fn])=>`
    <button class="lstrow" style="padding:11px" onclick="${fn}"><span style="color:var(--accent)">${I(ic,"i s")}</span><span class="g1 b xs" style="text-align:right">${l}</span></button>`).join("")}
  ${id?`<div class="div"></div>
    <button class="lstrow" onclick="closeOvl();replyMail('${id}')"><span style="color:var(--cyan)">${I("reply","i s")}</span><span class="g1 b xs" style="text-align:right">رد</span></button>
    <button class="lstrow" onclick="closeOvl();openSheet('mailCompose','${id}')"><span style="color:var(--cyan)">${I("fwd2","i s")}</span><span class="g1 b xs" style="text-align:right">إعادة توجيه</span></button>
    <button class="lstrow" onclick="moveMail('${id}','trash');closeOvl()"><span style="color:var(--rose)">${I("trash","i s")}</span><span class="g1 b xs" style="text-align:right;color:var(--rose)">حذف</span></button>`:""}
</div>`);
SHEETS.firestoreSheet=()=>modal(I("db","i s")+" قواعد Firestore",`
  <div class="tiny mut" style="margin-bottom:10px">firestore.rules — يتحكم بصلاحيات القراءة والكتابة</div>
  <div class="card2 mono tiny" style="padding:12px;background:#000;color:#4ADE80;overflow-x:auto;max-height:280px;overflow-y:auto" dir="ltr"><pre style="margin:0;font-size:10px;line-height:1.75">rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /posts/{pid} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete:
        if request.auth.uid == resource.data.authorId;
    }
    match /chats/{cid}/messages/{mid} {
      allow read, write:
        if request.auth.uid in resource.data.members;
    }
  }
}</pre></div>
  <div class="grid2" style="margin-top:13px"><button class="btn btn-primary" onclick="toast('تم نشر القواعد ','ok');snd('success');closeOvl()">${I("upload","i s")} نشر القواعد</button>
    <button class="btn btn-sec" onclick="copyTxt('rules_version = 2; ...');closeOvl()">${I("copy","i s")} نسخ</button></div>
  <div class="col" style="margin-top:13px">${[["users","١٢٬٤٨٠ مستند"],["posts","٨٤٬٢٠٠ مستند"],["chats","١٬٢٤٠ مستند"],["communities","٣٢٠ مستند"]].map(([c,n])=>`
    <div class="rowb" style="padding:8px 11px;background:var(--surface2);border-radius:11px"><span class="mono xs b">${c}</span><span class="tiny fnt">${n}</span></div>`).join("")}</div>`);

/* ============================================================
   24) الإقلاع (Boot)
   ============================================================ */
function render(){
  const fn=PAGES[S.page];
  if(!fn){$("#page").innerHTML=emptyState("alert","صفحة غير معروفة: "+S.page,"");return}
  try{$("#page").innerHTML=fn()}catch(e){$("#page").innerHTML=`<div class="pad"><div class="card" style="padding:14px;border-color:rgba(244,63,94,.4)">
    <div class="b sm" style="color:var(--rose)">${I("alert","i s")} خطأ في عرض الصفحة: ${esc(S.page)}</div>
    <div class="mono tiny" style="margin-top:8px;color:var(--muted);white-space:pre-wrap">${esc(e.message)}</div>
    <button class="btn btn-primary btn-sm" style="margin-top:11px" onclick="go('home')">العودة للرئيسية</button></div></div>`;console.error(e)}
  ariaPass();
  const fab=$("#homeFab");
  if(fab) fab.style.display=(S.page==="home")?"flex":"none";
  if(S.page==="storyViewer"){const _sd=S.params.sid;const _st=(S.stories||[]).find(x=>x.id===_sd);if(_st)startST(_sd,S.params.i||0,(S.stories||[]).findIndex(x=>x.id===_sd),_(st.items||[]).length)}else if(window.__stA){clearTimeout(window.__stT);window.__stA=null;window.__stRem=null}
  if(S.page==="forgot"&&S.recoveryStep==="otp")startRcTimer();
}
const AVFRAMES=[["none","بدون إطار"],["red-dragon","التنين الأحمر"],["purple-susanoo","السوسانو الأرجواني"],["neon-cyberspace","السايبر المضيء"],["cherry-blossom","أزهار الساكورا"]];
const EFFECTS=[["none","بدون تأثير"],["sharingan","الشارينغان الدوارة"],["ki-aura","هالة التشاكرا"],["sakura-leaves","تساقط الساكورا"],["glitch","تشويش رقمي"],["fire-sparks","جمرات متطايرة"],["lightning","صعقات البرق"]];
const CARDS=[
 {id:"cd1",n:"بطاقة لوفي المحرك الخامس (المستيقظ)",emo:"flag",r:"legendary",p:2500,d:"البطاقة التذكارية المستيقظة لزعيم قراصنة القبعة القشية."},
 {id:"cd2",n:"بطاقة زورو: مهارة السيوف الثلاثة",emo:"swords",r:"epic",p:1400,d:"شارة تجميلية نادرة تُظهر أسلوب القتال الثلاثي."},
 {id:"cd3",n:"بطاقة هانتر أسطورية نادرة",emo:"target",r:"legendary",p:2200,d:"أندر بطاقات الموسم الثالث، قابلة لجمع السلسلة بالكامل."},
 {id:"cd4",n:"بطاقة الأوتـاكو الذهبية",emo:"trophy",r:"epic",p:1200,d:"شارة النجم الذهبي للأوتاكو المخضرمين."},
 {id:"cd5",n:"بطاقة إصدار محدود للفرقة الأولى #40",emo:"shield",r:"rare",p:800,d:"بطاقة إصدار محدود للفرقة الأولى، رقم الإصدار #40."},
 {id:"cd6",n:"بطاقة مونكي دي لوفي (القصوى)",emo:"crown",r:"epic",p:1500,d:"نسخة قصوى من بطل ون بيس بحالة قتالية كاملة."},
 {id:"cd7",n:"بطاقة نادرة: لوفي السوبر سايا",emo:"zap",r:"rare",p:900,d:"دمج أسطوري بين عوالم الشونين في بطاقة واحدة."},
 {id:"cd8",n:"بطاقة فنية لفعالية الفجر",emo:"sparkles",r:"legendary",p:2600,d:"بطاقة فنية نادرة للغاية أُنتجت خصيصاً لفعاليات الفجر."}];
const RBAC_ROLES=[["مالك المنصة","crown","gold"],["مدير النظام","settings","purple"],["مدير رئيسي","shield","purple"],["مدير قسم","users","cyan"],["مشرف أول","checksq","cyan"],["مشرف","check","blue"],["متدرب إشراف","clock","gray"],["محرر أخبار","edit","gold"],["مترجم متطوع فائق السرعة","fwd","emerald"],["منظم فعاليات","calendar","rose"],["مطور النظام","code","emerald"],["عضو مميز","star","gold"],["عضو عادي","user","gray"]];
const VERIF_TYPES=[["غير موثق","user","gray"],["توثيق عادي","check","blue"],["توثيق رسمي للمنصة","shield","gold"],["توثيق إدارة","crown","purple"],["توثيق مشرف","checksq","cyan"],["توثيق مطور","code","emerald"],["توثيق فريق الأخبار","sparkles","gold"],["توثيق صانع محتوى","clapper","rose"],["توثيق شخصيات معروفة","star","purple"],["توثيق منظم فعاليات","calendar","cyan"]];
let mvZ=100,mvSi=2,mvQi=2;const MV_SP=[0.5,0.75,1,1.25,1.5,2],MV_Q=["480p","720p","1080p","4K"];
function openMedia(c1,c2,emo,title,seed){const img=seed?artBg(seed):"";mvZ=100;mvSi=2;mvQi=2;const v=$("#mview");v.classList.remove("hidden");
 v.innerHTML=`<div class="row" style="padding:10px 12px;gap:8px"><button class="iconbtn" onclick="closeMedia()">${I("x")}</button>
  <div class="g1 b xs" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(title||"عارض الوسائط")}</div>
  <button class="iconbtn" onclick="mvZoom(-25)">${I("zoomout")}</button><span class="badge b-gray mono" id="mvz">100%</span><button class="iconbtn" onclick="mvZoom(25)">${I("zoomin")}</button></div>
  <div style="flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden"><div id="mvstage" style="transition:transform .18s">
   <div class="art-bg" style="--c1:${c1};--c2:${c2};width:min(82vw,430px);height:min(56vh,540px);border-radius:20px;position:relative;display:flex;align-items:center;justify-content:center;color:#fff;${img?`background-image:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.5)),url('${img}');background-size:cover;background-position:center;`:""}">${img?"":(ICONS.includes(emo)?IF(emo,"xxl"):esc(emo||""))}</div></div></div>
  <div class="row" style="padding:10px 12px;gap:7px;justify-content:center">
   <button class="btn btn-sec btn-xs" onclick="mvSpeed()">${I("clock","i s")} السرعة <span class="mono" id="mvs">1x</span></button>
   <button class="btn btn-sec btn-xs" onclick="mvQuality()">${I("film","i s")} الجودة <span class="mono" id="mvq">1080p</span></button>
   <button class="btn btn-sec btn-xs" onclick="mvDownload()">${I("download","i s")} تنزيل</button></div>`;snd("tap")}
function mvDownload(){try{const stage=$("#mvstage");const bg=stage&&stage.querySelector(".art-bg");const title=(($("#mview .b.xs")||{}).textContent)||"وسائط";const cv=document.createElement("canvas");cv.width=720;cv.height=900;const g=cv.getContext("2d");const cs=getComputedStyle(bg||document.body);const bi=bg?bg.style.backgroundImage:"";const m=bi&&bi.match(/url\((["']?)(data:[^"')]+)\1\)/);if(m){const im=new Image();im.onload=()=>{g.drawImage(im,0,0,720,900);fin()};im.onerror=()=>{grad();fin()};im.src=m[2]}else{grad();fin()}
 function grad(){const gr=g.createLinearGradient(0,0,720,900);gr.addColorStop(0,"#1E1B4B");gr.addColorStop(1,"#7F1D1D");g.fillStyle=gr;g.fillRect(0,0,720,900);g.fillStyle="#fff";g.textAlign="center";g.font="bold 34px sans-serif";g.fillText(String(title).slice(0,40),360,450)}
 function fin(){g.fillStyle="rgba(0,0,0,.55)";g.fillRect(0,820,720,80);g.fillStyle="#fff";g.font="22px sans-serif";g.textAlign="center";g.fillText("أنمي بلاك — "+new Date().toLocaleDateString("ar"),360,868);const a=document.createElement("a");a.href=cv.toDataURL("image/png");a.download="animeblack-media.png";document.body.appendChild(a);a.click();a.remove();toast("نُزّلت الوسائط كصورة PNG حقيقية ","ok")}
}catch(e){toast("تعذّر التنزيل: "+String(e.message||e).slice(0,50),"err")}}
function closeMedia(){$("#mview").classList.add("hidden");$("#mview").innerHTML=""}
function mvZoom(d){mvZ=Math.max(50,Math.min(300,mvZ+d));const s=$("#mvstage");if(s)s.style.transform="scale("+(mvZ/100)+")";const z=$("#mvz");if(z)z.textContent=mvZ+"%"}
function mvSpeed(){mvSi=(mvSi+1)%MV_SP.length;const e=$("#mvs");if(e)e.textContent=MV_SP[mvSi]+"x";toast("سرعة التشغيل: "+MV_SP[mvSi]+"x","info")}
function mvQuality(){mvQi=(mvQi+1)%MV_Q.length;const e=$("#mvq");if(e)e.textContent=MV_Q[mvQi];toast("جودة العرض: "+MV_Q[mvQi],"info")}
function setAvatarFrame(id){S.me.avatarFrame=id;save();render();toast("إطار الأفاتار: "+((AVFRAMES||[]).find(f=>f[0]===id)||[])[1]+" ","ok");snd("success")}
function setProfileEffect(id){S.me.profileEffect=id;save();render();toast("مؤثر الملف: "+((EFFECTS||[]).find(f=>f[0]===id)||[])[1]+" ","ok");snd("success");if(id!=="none")celebrate("تم تفعيل المؤثر الحي ")}
function fxOverlay(){const id=S.me.profileEffect;if(!id||id==="none")return "";
 const parts=(id==="sakura-leaves"||id==="fire-sparks")?Array.from({length:16},(_,i)=>`<i style="left:${(i*6.3+2)%100}%;animation-duration:${6+(i%6)}s;animation-delay:${-i*1.7}s"></i>`).join(""):"";
 return `<div class="fxov fx-${id}">${parts}</div>`}
function visualIdentityCard(){const m=S.me;
 return `<div class="card" style="padding:14px">
  <div class="rowb"><div class="b sm">${I("sparkles","i s")} الهوية البصرية</div><span class="badge b-purple">مباشر</span></div>
  <div class="tiny fnt" style="margin-top:2px">إطارات الأفاتار والمؤثرات الحية لملفك الشخصي</div>
  <div class="row center" style="justify-content:center;margin:12px 0 4px;position:relative">${fxOverlay()}<div style="position:relative;z-index:7">${av(m,72,true)}</div></div>
  <div class="secttl" style="margin-top:8px"><h3>إطار الأفاتار</h3></div>
  <div class="chiprow">${AVFRAMES.map(([id,l],i)=>`<button class="chip ${(m.avatarFrame||"none")===id?"on":""}" onclick="setAvatarFrame('${id}')">${l}</button>`).join("")}</div>
  <div class="secttl"><h3>مؤثر الملف الشخصي</h3></div>
  <div class="chiprow">${EFFECTS.map(([id,l])=>`<button class="chip ${(m.profileEffect||"none")===id?"on":""}" onclick="setProfileEffect('${id}')">${l}</button>`).join("")}</div></div>`}
function toggleFS(){
  try{
    if(document.fullscreenElement){document.exitFullscreen();toast("خرجت من ملء الشاشة","info")}
    else{document.documentElement.requestFullscreen();toast("ملء الشاشة مفعّل ","ok")}
  }catch(e){toast("متصفحك لا يدعم ملء الشاشة","err")}
  snd("tap");
}
const RAR={legendary:"أسطوري",epic:"ملحمي",rare:"نادر",common:"شائع"};
function BDG(ic,r,size){return `<span class="bdg bdg-${r}" ${size?`style="width:${size}px;height:${Math.round(size*1.14)}px"`:""}>${I(ic)}</span>`}
function buyCard(id){const cd=(CARDS||[]).find(c=>c.id===id);if(!cd)return;
 if(S.me.ownedCards.includes(id)){toast("البطاقة مملوكة بالفعل","info");return}
 if(S.coins<cd.p){toast("رصيدك لا يكفي: تحتاج "+nfmt(cd.p-S.coins)+" عملة إضافية","err");snd("error");return}
 S.coins-=cd.p;S.me.ownedCards.push(id);save();render();celebrate("حصلت على: "+cd.n+" ");snd("success")}
SHEETS.whoLiked=(pid)=>{const p=(S.posts||[]).find(x=>x.id===pid)||(S.posts||[])[0];
 if(!p)return sheet("التفاعلات","<div class='tiny fnt center' style='padding:16px'>لا توجد تفاعلات بعد</div>");
 const rs=Object.entries(p.reacts||{});
 return `<div class="sheet pad" style="padding-bottom:18px">
  <div class="rowb"><div class="b sm">${I("heart","i s")} من تفاعل مع المنشور</div><button class="hbox" onclick="closeOvl()">${I("x")}</button></div>
  <div class="tiny fnt" style="margin:3px 0 10px">${Object.values(p.reacts||{}).reduce((a,b)=>a+b,0)} تفاعل · ${rs.length} نوع</div>
  <div class="col">${rs.map(([k,c])=>{const R=(REACTS||[]).find(r=>r[0]===k)||[k,"star",k,"var(--acc)"];
    return `<div class="rowb"><span class="row" style="gap:8px"><span style="color:${R[3]};line-height:0;display:flex">${IC(R[1],"i")}</span><span class="xs">${R[2]}</span></span>
    <span class="row" style="gap:6px">${(S.users||[]).slice(0,Math.min(3,c)).map(u2=>`<span style="line-height:0">${av(u2,22)}</span>`).join("")}<span class="badge b-gray mono">${c}</span></span></div>`}).join("")||'<div class="tiny mut">لا تفاعلات بعد</div>'}</div>
  <div class="secttl" style="margin-top:12px"><h3>آخر المتفاعلين</h3></div>
  <div class="col">${(S.users||[]).slice(0,5).map(u2=>`<div class="lstrow"><button onclick="closeOvl();openProfile('${u2.id}')" style="line-height:0">${av(u2,38)}</button>
   <div class="g1"><div class="b xs">${esc(u2.name)}</div><div class="tiny fnt">@${esc(u2.username)}</div></div>
   <button class="btn btn-sec btn-xs" onclick="closeOvl();openProfile('${u2.id}')">ملفه</button></div>`).join("")}</div></div>`};
SHEETS.createBottom=()=>`<div class="sheet pad" style="padding-bottom:20px">
  <div class="rowb"><div class="b sm">${I("plus","i s")} ${S.langEn?"Create":"إنشاء محتوى"}</div><button class="hbox" onclick="closeOvl()">${I("x")}</button></div>
  <div class="tiny fnt" style="margin:3px 0 12px">${S.langEn?"Choose content type":"اختر نوع المحتوى الذي تريد نشره"}</div>
  <div class="grid2">${CREATE_TYPES.map(([t,lb,ic,g,d])=>`<button class="card2" style="padding:12px;text-align:right" onclick="closeOvl();${createRoute(t)}">
    <span class="ico-tile" style="background:${g};color:#fff">${I(ic,"i s")}</span>
    <div class="b xs" style="margin-top:7px">${lb}</div><div class="tiny fnt" style="margin-top:2px">${d}</div></button>`).join("")}</div>
  <div class="secttl" style="margin:15px 0 8px"><h3>${I("users","i s")} إنشاء مجتمعات</h3><span class="tiny fnt">قروبات ونقابات وعوالم بصفحات مخصصة</span></div>
  <div class="grid3">${[["users","قروب دردشة","var(--grad-fire)","go('createGroup')"],["shield","نقابة","var(--grad-gold)","go('createGuild')"],["globe","عالم","var(--grad-purple)","go('createWorld')"]].map(([ic,l,g,oc])=>`<button class="card2 center" style="padding:13px 6px" onclick="closeOvl();${oc}"><span class="ico-tile" style="background:${g};color:#fff;margin:0 auto">${I(ic,"i l")}</span><span class="tiny b" style="display:block;margin-top:7px">${l}</span><span class="tiny fnt" style="display:block;margin-top:2px">صفحة إنشاء مخصصة</span></button>`).join("")}</div></div>`;
function boot(){
  const had=load();
  S.events=S.events||seedEvents();
  document.body.className=S.theme==="light"?"light":"";
  if(S.themeAcc&&S.themeAcc!=="fire")applyTheme(S.themeAcc);
  applyFontScale();
  setInterval(()=>{S.sessionSec=(S.sessionSec||0)+1;if(S.sessionSec%30===0)save()},1000);
  if(window.matchMedia){const mq=window.matchMedia("(prefers-color-scheme: light)");const autoRe=()=>{if(S.theme==="auto")setTheme("auto")};if(mq.addEventListener)mq.addEventListener("change",autoRe)}
  if((S.appLock||{}).pin&&S.appPin)showAppLock();
  let swX=null,swEl=null;
  document.addEventListener("pointerdown",e=>{const m=e.target.closest?e.target.closest(".msg[data-mid]"):null;if(!m)return;swX=e.clientX;swEl=m},{passive:true});
  document.addEventListener("pointerup",e=>{if(swX==null||!swEl){swX=null;return}const dx=e.clientX-swX;const mid=swEl.getAttribute("data-mid");const ctx=swEl.getAttribute("data-ctx")||"chat";swX=null;swEl=null;if(dx<70||!mid)return;
    if(ctx==="group"){const gid=S.params.id;S.gReply={g:gid,m:mid};render();snd("tap");toast("اسحب للرد: أُرفق الاقتباس ","info");return}
    if(ctx==="world"){S.wReply={w:S.params.id,m:mid};render();snd("tap");return}
    S.replyTo=mid;render();snd("tap");toast("رد باقتباس ","info")},{passive:true});
  const sp=$("#splash");
  setTimeout(()=>{if(sp){sp.style.opacity="0";setTimeout(()=>sp.remove(),520)}},had?700:2000);
  S.page=had&&S.user?"home":"splash";
  render();
  save();
  // اختصارات لوحة المفاتيح
  document.addEventListener("keydown",e=>{
    if(e.target.tagName==="INPUT"||e.target.tagName==="TEXTAREA")return;
    const k=e.key;
    if(k==="Escape"){if($("#ovl").innerHTML)closeOvl();else if((S.history||[]).length)back()}
    if(!S.user)return;
    if(k==="1")tab('home');if(k==="2")tab("explore");if(k==="3")tab("create");
    if(k==="4")tab('chat');if(k==="5")tab('more');if(k==="6")go("profile",{},false);
    if(k==="/"){e.preventDefault();go('search')}
    if(k==="n"){e.preventDefault();openSheet("notifications")}
  });
  console.log("%cAnime Black UI v2.0","background:linear-gradient(135deg,#FF7A00,#E60000);color:#fff;padding:6px 14px;border-radius:8px;font-weight:900");
  if(!S.v25seen){setTimeout(()=>{toast("أنمي بلاك الإصدار ٢٥٫٠: استوديوهات نشر مخصصة لكل نوع، غرف بكامل المرفقات والاستطلاعات والإعلانات، وغلاف فعالية من هاتفك ","ok",4200);S.v25seen=true;save()},2600)}
  console.log("الصفحات المتاحة:",Object.keys(PAGES).join(", "));
}
boot();
</script>

<script>
/* v7 — كاشف صفوف التمرير الأفقي.
   المشكلة: الصف كان يُقطع بالسكين عند حافة الشاشة فيبدو مكسوراً.
   الحل: وسم كل صف يتجاوز أفقياً بـ.v7edge فيأخذ هامشاً وتلاشياً متدرجاً.
   لا يمس المحتوى ولا الحالة — يضيف/يزيل اسم كلاس فقط. */
(function(){
  try{
    var TAG = "v7edge", timer = null, first = true;
    function scan(){
      try{
        var list = document.querySelectorAll(
          ".chiprow,.stories,.hscroll,.tabs,.segrow,.notesrow,.no-sb,.row,.seg,ul,nav > div");
        for (var i = 0; i < list.length; i++){
          var e = list[i];
          if (e.id === "page" || e.id === "reelbox") continue;
          var cs = getComputedStyle(e);
          var hx = /auto|scroll/.test(cs.overflowX) && e.scrollWidth  > e.clientWidth  + 4;
          var vy = /auto|scroll/.test(cs.overflowY) && e.scrollHeight > e.clientHeight + 4;
          if (hx && !vy) e.classList.add(TAG); else e.classList.remove(TAG);
        }
      }catch(_){}
    }
    function queue(){
      if (first){ first = false; scan(); return; }
      if (timer) clearTimeout(timer);
      timer = setTimeout(scan, 220);
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", queue);
    else queue();
    window.addEventListener("load", queue);
    window.addEventListener("resize", queue);
    window.addEventListener("orientationchange", queue);
    try{
      new MutationObserver(queue)
        .observe(document.documentElement, {childList:true, subtree:true});
    }catch(_){}
  }catch(_){}
})();
</script>
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-app.js";
  import { getFirestore, doc, setDoc, getDoc, getDocFromServer, collection, query, where, getDocs, onSnapshot, deleteDoc, enableIndexedDbPersistence } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-firestore.js";
  import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, updateProfile } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-auth.js";
  
  window.doc = doc;
  window.setDoc = setDoc;
  window.getDoc = getDoc;
  window.collection = collection;
  window.query = query;
  window.where = where;
  window.getDocs = getDocs;
  window.onSnapshot = onSnapshot;
  window.deleteDoc = deleteDoc;
  window.GoogleAuthProvider = GoogleAuthProvider;
  window.signInWithPopup = signInWithPopup;
  window.signInWithEmailAndPassword = signInWithEmailAndPassword;
  window.createUserWithEmailAndPassword = createUserWithEmailAndPassword;
  window.updateProfile = updateProfile;
  window.signOut = signOut;
  window.onAuthStateChanged = onAuthStateChanged;


  const firebaseConfig = {
    projectId: "booming-rigging-gn50x",
    appId: "1:914243738562:web:a37e6e84561648b9e4945b",
    apiKey: "AIzaSyA-ogGsp39UsQ72M_PwDx4n89ETlROqqGc",
    authDomain: "booming-rigging-gn50x.firebaseapp.com",
    storageBucket: "booming-rigging-gn50x.firebasestorage.app",
    messagingSenderId: "914243738562"
  };

  const app = initializeApp(firebaseConfig);
  window.db = getFirestore(app, "ai-studio-51245802-6d4e-4feb-bd11-43162af66618");
  enableIndexedDbPersistence(window.db).catch(e => console.warn("Firestore Persistence:", e));
  window.auth = getAuth(app);
  
  // Connection validation as per skill specification
  async function testConnection() {
    try {
      await getDocFromServer(doc(window.db, 'test', 'connection'));
    } catch (error) {
      if(error instanceof Error && error.message.includes('the client is offline')) {
        console.error("Please check your Firebase configuration.");
      }
    }
  }
  testConnection();

  console.log("🔥 Firebase initialized and connected successfully");

  
  // Real-time Cloud Sync for Posts (Accessible to everyone!)
  window._cloudPosts = [];
  const postsQuery = window.query(window.collection(window.db, 'posts'));
  window.onSnapshot(postsQuery, (snap) => {
    const livePosts = snap.docs.map(d => Object.assign(d.data(), { pending: d.metadata.hasPendingWrites })).filter(p => p && p.id);
    if (livePosts.length > 0) {
      const postMap = {};
      
      livePosts.forEach(p => { postMap[p.id] = Object.assign(postMap[p.id] || {}, p); });
      const merged = Object.values(postMap);
      merged.sort((a, b) => (b.createdAt || b.at || 0) - (a.createdAt || a.at || 0));
      S.posts = merged;
      window._cloudPosts = livePosts;
      save();
      if (!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        if (['home', 'explore', 'profile', 'postDetail', 'comments'].includes(S.page)) render();
      }
    }
  }, (e) => console.error("Firestore posts sync:", e));

  // Real-time Cloud Sync for Stories
  const storiesQuery = window.query(window.collection(window.db, 'stories'));
  window.onSnapshot(storiesQuery, (snap) => {
    const liveStories = snap.docs.map(d => d.data()).filter(s => s && s.id);
    if (liveStories.length > 0) {
      const storyMap = {};
      (S.stories || []).forEach(s => { if (s && s.id) storyMap[s.id] = s; });
      liveStories.forEach(s => { storyMap[s.id] = Object.assign(storyMap[s.id] || {}, s); });
      const merged = Object.values(storyMap);
      merged.sort((a, b) => (b.createdAt || b.at || 0) - (a.createdAt || a.at || 0));
      S.stories = merged;
      save();
      if (!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        if (S.page === 'home') render();
      }
    }
  }, (e) => console.error("Firestore stories sync:", e));

  // Real-time Cloud Sync for Reels
  const reelsQuery = window.query(window.collection(window.db, 'reels'));
  window.onSnapshot(reelsQuery, (snap) => {
    const liveReels = snap.docs.map(d => d.data()).filter(r => r && r.id);
    if (liveReels.length > 0) {
      const reelMap = {};
      (S.reels || []).forEach(r => { if (r && r.id) reelMap[r.id] = r; });
      liveReels.forEach(r => { reelMap[r.id] = Object.assign(reelMap[r.id] || {}, r); });
      const merged = Object.values(reelMap);
      merged.sort((a, b) => (b.createdAt || b.at || 0) - (a.createdAt || a.at || 0));
      S.reels = merged;
      save();
      if (!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        if (S.page === 'reels' || S.page === 'home') render();
      }
    }
  }, (e) => console.error("Firestore reels sync:", e));

  // Real-time Cloud Sync for Direct & Group Chats
  const chatsQuery = window.query(window.collection(window.db, 'chats'));
  window.onSnapshot(chatsQuery, (snap) => {
    const myUid = getMyUid();
    let changed = false;
    snap.docChanges().forEach(change => {
      const cd = change.doc.data();
      if(!cd || !cd.id) return;
      const isParticipant = !cd.participants || (cd.participants||[]).length === 0 || cd.participants.includes(myUid) || cd.participants.includes(S.me.id) || cd.participants.includes("me") || cd.id.includes(myUid);
      if(!isParticipant) return;
      
      if (change.type === "removed") {
        S.chats = (S.chats || []).filter(c => c.id !== cd.id);
        changed = true;
        return;
      }
      let localChat = (S.chats||[]).find(c => c.id === cd.id);
      if(!localChat){
        let otherUid = (cd.participants || []).find(p => p !== myUid) || cd.userId || "user_friend";
        localChat = {
          id: cd.id,
          userId: otherUid,
          type: cd.type || "private",
          unread: (cd.lastSenderId && cd.lastSenderId !== myUid) ? 1 : 0,
          last: cd.last || "محادثة جديدة",
          lastAt: cd.lastAt || cd.updatedAt || now(),
          pinned: false,
          muted: false,
          messages: []
        };
        S.chats.unshift(localChat);
        changed = true;
      } else {
        if(localChat.last !== cd.last || localChat.lastAt !== cd.lastAt){
          localChat.last = cd.last || localChat.last;
          localChat.lastAt = cd.lastAt || localChat.lastAt;
          if(cd.lastSenderId && cd.lastSenderId !== myUid && S.activeChat !== localChat.id){
            if(change.type === "modified"){
              localChat.unread = (localChat.unread || 0) + 1;
              snd("notif");
              toast("رسالة جديدة من " + (u(localChat.userId).name || "صديق") + ": " + localChat.last, "info");
            }
          }
          changed = true;
        }
      }
    });
    if(changed){
      save();
      if(!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        if(S.page === 'chat') render();
      }
    }
  }, (e) => console.error("Firestore chats sync:", e));

  // Real-time Cloud Sync for Communities & Guilds
  const communitiesQuery = window.query(window.collection(window.db, 'communities'));
  window.onSnapshot(communitiesQuery, (snap) => {
    const liveComms = snap.docs.map(d => d.data()).filter(c => c && c.id);
    if(liveComms.length > 0){
      const commMap = {};
      (S.communities || []).forEach(c => { if(c && c.id) commMap[c.id] = c; });
      liveComms.forEach(c => { commMap[c.id] = Object.assign(commMap[c.id] || {}, c); });
      S.communities = Object.values(commMap);
      save();
      if(!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        if (['explore', 'communityDetail', 'communityChannel', 'admin'].includes(S.page)) render();
      }
    }
  }, (e) => console.error("Firestore communities sync:", e));

  // Real-time Cloud Sync for Users (All registered users!)
  const usersQuery = window.query(window.collection(window.db, 'users'));
  window.onSnapshot(usersQuery, (snap) => {
    snap.docs.forEach(d => {
      const ud = d.data();
      if(ud && ud.id){
        window._cloudUsers[ud.id] = ud;
      }
    });
    const userMap = {};
    (S.users || []).forEach(u => { if(u && u.id) userMap[u.id] = u; });
    Object.values(window._cloudUsers).forEach(cu => {
      if(cu && cu.id) userMap[cu.id] = Object.assign(userMap[cu.id] || {}, cu);
    });
    S.users = Object.values(userMap);
    if (window.auth && window.auth.currentUser && window._cloudUsers[window.auth.currentUser.uid]) {
      const freshMe = window._cloudUsers[window.auth.currentUser.uid];
      S.me = Object.assign(S.me || {}, freshMe);
      S.user = S.me;
      ensureAccounts();
    }
    save();
    if(!document.activeElement || (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
      if(['profile', 'publicProfile', 'followers', 'communityDetail', 'chat'].includes(S.page)) render();
    }
  }, (e) => console.error("Firestore users sync:", e));

  // Real-time Cloud Sync for Official Broadcasts
  const bcQuery = window.query(window.collection(window.db, 'broadcasts'));
  window.onSnapshot(bcQuery, (snap) => {
    const liveBc = snap.docs.map(d => d.data());
    liveBc.sort((a, b) => (b.at || 0) - (a.at || 0));
    S.broadcasts = liveBc;
    save();
    if (S.page === 'admin') render();
  }, (e) => console.error("Firestore broadcasts sync:", e));

  // Global auth state listener
  window._cloudUsers = window._cloudUsers || {};
  window.onAuthStateChanged(window.auth, (user) => {
    if (user) {
      // User is signed in.
      // Fetch or Create user profile
      const userRef = window.doc(window.db, "users", user.uid);
      window.getDoc(userRef).then(docSnap => {
        let userData;
        let isNew = false;
        if (docSnap.exists()) {
          userData = docSnap.data();
          userData.id = user.uid;
          userData.uid = user.uid;
        } else {
          isNew = true;
          const defaultUsername = (user.email ? user.email.split('@')[0] : 'user_' + ((user&&user.uid)||"otaku").slice(0,6)).replace(/[^a-zA-Z0-9_]/g, '').toLowerCase() || ('otaku_' + ((user&&user.uid)||"otaku").slice(0,5));
          userData = {
            id: user.uid,
            uid: user.uid,
            name: user.displayName || 'أوتاكو جديد',
            username: defaultUsername,
            email: user.email || '',
            avatar: user.photoURL || AV[0],
            bio: 'عضو جديد في مجتمع أنمي بلاك',
            role: user.email === 'm774545471@gmail.com' ? "admin" : "Member",
            level: 1,
            followers: 0,
            following: 0,
            reputation: 15,
            coins: 150,
            stars: 10,
            joined: Date.now(),
            badges: ["badge_rookie"],
            titles: [],
            equippedTitle: null,
            ownedCards: [],
            avatarFrame: null,
            profileEffect: null,
            history: [],
            saved: [],
            following_list: [],
            profileCompleted: false
          };
          window.setDoc(userRef, userData).catch(e => console.error("Create user doc error:", e));
        }
        
        S.user = userData;
        S.me = Object.assign(S.me || {}, userData);
        S.me.id = user.uid;
        S.me.uid = user.uid;
        ensureAccounts();
        save();
        
        // If profile is not completed yet, direct them to complete profile details
        if (!userData.profileCompleted) {
          go('completeProfile', {}, false);
        } else if (S.page === 'login' || S.page === 'signup' || S.page === 'completeProfile' || S.page === 'splash') {
          toast("أهلاً بعودتك يا " + (userData.name || 'أوتاكو'), "ok");
          go('home', {}, false);
        } else {
          render();
        }
      }).catch(e => {
        console.error("Fetch user error:", e);
        // Fallback for offline mode
        let localUser = window._cloudUsers[user.uid] || (S.users || []).find(u => u.id === user.uid);
        if(!localUser && S.me && S.me.id === user.uid) localUser = S.me;
        if(!localUser && S.savedAccounts) localUser = S.savedAccounts.find(a => a.id === user.uid);
        
        if (localUser) {
          S.user = localUser;
          S.me = Object.assign(S.me || {}, localUser);
          S.me.id = user.uid;
          S.me.uid = user.uid;
        } else {
          S.user = { id: user.uid, uid: user.uid, name: user.displayName || 'أوتاكو (أوفلاين)', username: 'offline', email: user.email || '' };
          S.me = Object.assign(S.me || {}, S.user);
        }
        ensureAccounts();
        save();
        
        if (S.page === 'login' || S.page === 'signup' || S.page === 'completeProfile' || S.page === 'splash') {
          toast("أنت تتصفح بدون إنترنت (أوفلاين)", "info");
          go('home', {}, false);
        } else {
          render();
        }
      });

      if (!window._usersSub) {
        const uq = window.query(window.collection(window.db, 'users'));
        window._usersSub = window.onSnapshot(uq, (snap) => {
          snap.docs.forEach(d => {
            window._cloudUsers[d.id] = d.data();
          });
          S.users = Object.values(window._cloudUsers);
          render();
        }, (e) => console.error(e));
      }

    } else {
      S.user = null;
      if (['workspace', 'create', 'editProfile', 'completeProfile'].includes(S.page)) {
        go('login', {}, false);
      }
      if (window._usersSub) {
        window._usersSub();
        window._usersSub = null;
      }
      render();
    }
  });

</script>
</body>
</html>
