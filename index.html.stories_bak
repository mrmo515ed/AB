function ensureAccounts(){
  S.savedAccounts = S.savedAccounts || [];
  if(!S.me) return;
  const curId = S.me.id || (S.me.uid || "me");
  const curEmail = (S.me.email || "").toLowerCase();
  const curSnapshot = {
    id: curId,
    uid: curId,
    name: S.me.name || "أوتاكو أنمي بلاك",
    username: S.me.username || "otaku",
    email: S.me.email || "",
    avatar: S.me.avatar || AV[0],
    role: S.me.role || "Member",
    level: S.me.level || 1,
    xp: S.me.xp || 0,
    xpNext: S.me.xpNext || 100,
    coins: S.coins != null ? S.coins : (S.me.coins || 100),
    stars: S.stars != null ? S.stars : (S.me.stars || 5),
    reputation: S.me.reputation || 0,
    followers: S.me.followers || 0,
    following: S.me.following || 0,
    bio: S.me.bio || "",
    joined: S.me.joined || now(),
    equippedTitle: S.me.equippedTitle || null,
    isVerified: S.me.isVerified || false,
    badges: S.me.badges || [],
    profileCompleted: true
  };
  const idx = (S.savedAccounts||[]).findIndex(a => (a.id === curId || a.uid === curId || (curEmail && (a.email||"").toLowerCase() === curEmail)));
  if(idx >= 0){
    S.savedAccounts[idx] = Object.assign({}, S.savedAccounts[idx], curSnapshot);
  } else {
    S.savedAccounts.unshift(curSnapshot);
  }
}

function openAccountSwitcher(){
  ensureAccounts();
  openSheet('accountSwitcherSheet');
}

function switchSavedAccount(accIdOrEmail){
  ensureAccounts();
  const target = (S.savedAccounts||[]).find(a => a.id === accIdOrEmail || a.uid === accIdOrEmail || (a.email && a.email.toLowerCase() === String(accIdOrEmail).toLowerCase()) || a.username === accIdOrEmail);
  if(!target){
    toast("الحساب غير متواجد في القائمة المحفوظة", "err");
    return;
  }
  closeOvl();
  performSwitch(target);
}

function removeSavedAccount(accIdOrEmail){
  ensureAccounts();
  const targetIdx = (S.savedAccounts||[]).findIndex(a => a.id === accIdOrEmail || a.uid === accIdOrEmail || (a.email && a.email.toLowerCase() === String(accIdOrEmail).toLowerCase()));
  if(targetIdx < 0) return;
  const removed = S.savedAccounts[targetIdx];
  const curId = S.me.id || (S.me.uid || "me");
  const isCur = (removed.id === curId || removed.uid === curId);
  S.savedAccounts.splice(targetIdx, 1);
  save();
  toast("تمت إزالة الحساب (" + (removed.name || removed.email) + ") من هذا الجهاز", "info");
  if(isCur){
    if((S.savedAccounts||[]).length > 0){
      performSwitch(S.savedAccounts[0]);
    } else {
      doLogout();
    }
  } else {
    openSheet('accountSwitcherSheet');
  }
}

function createQuickAltAccount(customName, customUsername, customRole, customAvatar){
  const altUid = "alt_" + uid();
  const name = (customName || "").trim() || ("شخصية أوتاكو " + ((S.savedAccounts||[]).length + 1));
  const uname = ((customUsername || "").trim() || ("alt_" + Math.random().toString(36).substring(2, 7))).replace(/[^a-zA-Z0-9_]/g, "").toLowerCase();
  const newAcc = {
    id: altUid,
    uid: altUid,
    name: name,
    username: uname,
    email: "",
    avatar: customAvatar || AV[((S.savedAccounts||[]).length) % AV.length],
    role: customRole || "Member",
    level: 1,
    xp: 0,
    xpNext: 100,
    coins: 300,
    stars: 15,
    reputation: 30,
    followers: 0,
    following: 0,
    bio: "حساب بديل إضافي نشط في مجتمع أنمي بلاك ⚡",
    joined: now(),
    equippedTitle: null,
    isVerified: false,
    badges: ["badge_rookie"],
    profileCompleted: true
  };
  ensureAccounts();
  S.savedAccounts.push(newAcc);
  save();
  closeOvl();
  performSwitch(newAcc);
  toast("تم إنشاء الحساب والتبديل إليه بنجاح!", "ok");
}

function switchAccountFast(){
  openAccountSwitcher();
}

function performSwitch(acc){
  ensureAccounts();
  const accId = acc.id || acc.uid;
  S.activeAccountId = accId;
  S.me = Object.assign({}, seed().me, acc, { badges: acc.badges || [], saved: acc.saved || [], inventory: acc.inventory || [], history: acc.history || [], watching: acc.watching || [], favAnime: acc.favAnime || [], favChars: acc.favChars || [], quests: acc.quests || [], titles: acc.titles || [] });
  S.user = Object.assign({}, S.me);
  S.coins = (acc.coins != null) ? acc.coins : (S.me.coins || 100);
  S.stars = (acc.stars != null) ? acc.stars : (S.me.stars || 5);
  S.me.coins = S.coins;
  S.me.stars = S.stars;
  
  // If Firestore is connected and account has real UID, fetch latest from Firestore in background
  if(window.db && window.doc && window.getDoc && acc.uid && acc.uid !== "me" && !acc.uid.startsWith("alt_")){
    window.getDoc(window.doc(window.db, "users", acc.uid)).then(snap => {
      if(snap && snap.exists()){
        const fresh = snap.data();
        fresh.id = acc.uid;
        fresh.uid = acc.uid;
        S.me = Object.assign(S.me, fresh);
        S.user = S.me;
        ensureAccounts();
        save();
        render();
      }
    }).catch(e => console.warn("Switch fetch warning:", e));
  }
  
  ensureAccounts();
  save();
  toast("تم التبديل بنجاح إلى: " + S.me.name + " (@" + S.me.username + ")", "ok");
  snd("success");
  haptic("تبديل الحساب");
  celebrate("مرحباً بك في حسابك: " + S.me.name);
  render();
}

function submitAddAccount(kind){
  const e = ($("#add_acc_e") ? $("#add_acc_e").value : "").trim();
  const pw = ($("#add_acc_p") ? $("#add_acc_p").value : "");
  if(kind === 'google'){
    if(!window.auth || !window.signInWithPopup){
      toast("خدمة تسجيل الدخول غير جاهزة بعد", "err");
      return;
    }
    const provider = new window.GoogleAuthProvider();
    toast("جارٍ فتح نافذة Google...", "info");
    window.signInWithPopup(window.auth, provider).then(result => {
      const u = result.user;
      toast("تمت إضافة وتسجيل حساب Google بنجاح", "ok");
      closeOvl();
    }).catch(err => {
      toast("فشل الدخول بجوجل: " + (err.message || err.code), "err");
    });
    return;
  }
  
  if(!e || !e.includes("@")){
    toast("يرجى إدخال بريد إلكتروني صالح", "err");
    return;
  }
  if(!pw || pw.length < 6){
    toast("يرجى إدخال كلمة المرور (6 أحرف على الأقل)", "err");
    return;
  }
  
  toast("جارٍ التحقق وإضافة الحساب...", "info");
  if(kind === 'register'){
    if(window.auth && window.createUserWithEmailAndPassword){
      window.createUserWithEmailAndPassword(window.auth, e, pw).then(cred => {
        const u = cred.user;
        const defaultUname = e.split("@")[0].replace(/[^a-zA-Z0-9_]/g, "").toLowerCase() || ("otaku_" + ((u&&u.uid)||"otaku").slice(0,5));
        const newAcc = {
          id: u.uid,
          uid: u.uid,
          name: "أوتاكو جديد",
          username: defaultUname,
          email: e,
          avatar: AV[0],
          role: e === "m774545471@gmail.com" ? "admin" : "Member",
          level: 1,
          coins: 200,
          stars: 10,
          followers: 0,
          following: 0,
          reputation: 20,
          bio: "عضو جديد في مجتمع أنمي بلاك ⚡",
          joined: now(),
          profileCompleted: true
        };
        if(window.db && window.setDoc && window.doc){
          window.setDoc(window.doc(window.db, "users", u.uid), newAcc, {merge: true}).catch(err=>console.error(err));
        }
        ensureAccounts();
        S.savedAccounts.unshift(newAcc);
        closeOvl();
        performSwitch(newAcc);
        toast("تم إنشاء وإضافة الحساب الجديد بنجاح!", "ok");
      }).catch(err => {
        console.error(err);
        if(err.code === 'auth/email-already-in-use'){
          toast("هذا البريد مسجل مسبقاً! جرب الضغط على 'تسجيل الدخول'", "err");
        } else {
          toast("فشل إنشاء الحساب: " + (err.message || err.code), "err");
        }
      });
    }
    return;
  }
  
  // Login flow
  if(window.auth && window.signInWithEmailAndPassword){
    window.signInWithEmailAndPassword(window.auth, e, pw).then(cred => {
      const u = cred.user;
      if(window.db && window.getDoc && window.doc){
        window.getDoc(window.doc(window.db, "users", u.uid)).then(snap => {
          let userDoc = snap && snap.exists() ? snap.data() : null;
          if(!userDoc){
            const defaultUname = e.split("@")[0].replace(/[^a-zA-Z0-9_]/g, "").toLowerCase() || ("otaku_" + ((u&&u.uid)||"otaku").slice(0,5));
            userDoc = {
              id: u.uid,
              uid: u.uid,
              name: u.displayName || "أوتاكو",
              username: defaultUname,
              email: e,
              avatar: u.photoURL || AV[0],
              role: e === "m774545471@gmail.com" ? "admin" : "Member",
              level: 1,
              coins: 150,
              stars: 5,
              followers: 0,
              following: 0,
              reputation: 15,
              bio: "مرحباً بكم في حسابي في أنمي بلاك",
              joined: now(),
              profileCompleted: true
            };
            window.setDoc(window.doc(window.db, "users", u.uid), userDoc, {merge: true}).catch(err=>console.error(err));
          }
          ensureAccounts();
          const existingIdx = (S.savedAccounts||[]).findIndex(a => a.id === u.uid || (a.email && a.email.toLowerCase() === e.toLowerCase()));
          if(existingIdx >= 0){
            S.savedAccounts[existingIdx] = Object.assign({}, S.savedAccounts[existingIdx], userDoc);
          } else {
            S.savedAccounts.unshift(userDoc);
          }
          closeOvl();
          performSwitch(userDoc);
          toast("تم تسجيل الدخول وإضافة الحساب بنجاح!", "ok");
        }).catch(err => {
          console.error("Login getDoc fallback:", err);
          let userDoc = window._cloudUsers[u.uid] || (S.users || []).find(x => x.id === u.uid);
          if(!userDoc && S.me && S.me.id === u.uid) userDoc = S.me;
          if(!userDoc && S.savedAccounts) userDoc = S.savedAccounts.find(a => a.id === u.uid);
          
          if (!userDoc) {
             const defaultUname = e.split("@")[0].replace(/[^a-zA-Z0-9_]/g, "").toLowerCase() || ("otaku_" + ((u&&u.uid)||"otaku").slice(0,5));
             userDoc = { id: u.uid, uid: u.uid, name: u.displayName || "أوتاكو (أوفلاين)", username: defaultUname, email: e, avatar: u.photoURL || AV[0], profileCompleted: true };
          }
          ensureAccounts();
          const existingIdx = (S.savedAccounts||[]).findIndex(a => a.id === u.uid || (a.email && a.email.toLowerCase() === e.toLowerCase()));
          if(existingIdx >= 0){
            S.savedAccounts[existingIdx] = Object.assign({}, S.savedAccounts[existingIdx], userDoc);
          } else {
            S.savedAccounts.unshift(userDoc);
          }
          closeOvl();
          performSwitch(userDoc);
          toast("تم تسجيل الدخول (وضع الأوفلاين)", "info");
        });
      } else {
        closeOvl();
      }
    }).catch(err => {
      console.error(err);
      let msg = "فشل الدخول: ";
      if(err.code === 'auth/invalid-credential' || err.code === 'auth/wrong-password' || err.code === 'auth/user-not-found'){
        msg = "البريد الإلكتروني أو كلمة المرور غير صحيحة";
      } else {
        msg += (err.message || err.code);
      }
      toast(msg, "err");
    });
  }
}

PAGES.more=()=>{
  S.activeTab="more";const m=S.me;
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('home')">${I("back")}</button>
    <div class="ttl">مركز المزيد الذكي<small>SMART MORE HUB · v25.0</small></div>
    ${coinChip()}${starChip()}</div>`);
  setNav(true);
  const isAdmin = isPlatformAdmin();
  return `<div class="pad" style="padding-top:0">
    <div style="height:118px;border-radius:0 0 22px 22px;margin:0 -14px 0;position:relative;background:linear-gradient(135deg,#7F1D1D,#EA580C 55%,#FF7A00);overflow:hidden">
      <div style="position:absolute;inset:0;opacity:.16;background-image:radial-gradient(circle at 20% 30%,#fff 0 2px,transparent 2px),radial-gradient(circle at 70% 60%,#fff 0 2px,transparent 2px);background-size:34px 34px"></div>
      <div class="row" style="gap:7px;position:absolute;top:11px;left:11px;right:11px;z-index:3">
        <button class="btn btn-glass btn-xs" onclick="go('qrCard')">${I("qr","i s")} بطاقتي</button>
        <button class="btn btn-glass btn-xs" onclick="go('editProfile')">${I("edit","i s")} تعديل</button>
        <span class="g1"></span>
        <button class="btn btn-glass btn-xs" onclick="openSheet('shareProfile')">${I("share","i s")}</button>
      </div>
    </div>
    <div style="margin-top:-40px;position:relative;z-index:4">
      <div class="card" style="padding:13px;box-shadow:0 12px 30px rgba(0,0,0,.35);cursor:pointer;border-color:rgba(255,255,255,.14);transition:transform .18s,border-color .18s" onclick="go('profile')">
        <div class="rowb" style="margin-bottom:9px">
          <div class="row" style="gap:5px" onclick="event.stopPropagation();go('profile')">
            <span class="tiny fnt" style="color:var(--muted)">بطاقة ملفك الشخصي</span>
            <span class="badge b-cyan" style="font-size:9.5px">عرض الملف</span>
          </div>
          <button class="btn btn-sec btn-xs" style="gap:5px;border-color:rgba(34,211,238,.45);background:rgba(34,211,238,.12);color:var(--accent);font-weight:800;padding:4px 10px;border-radius:10px" onclick="event.stopPropagation();switchAccountFast()" title="تبديل الحسابات فـوراً">
            ${I("refresh","i s")} <span>تبديل الحسابات</span>
          </button>
        </div>
        <div class="row" style="gap:12px">
          <span style="position:relative;line-height:0" onclick="event.stopPropagation();go('profile')"><span style="padding:3px;border-radius:50%;background:var(--grad-fire);display:inline-flex">${av(m,72,true)}</span>
            <span style="position:absolute;bottom:4px;left:4px;width:14px;height:14px;border-radius:50%;background:var(--emerald);border:2.5px solid var(--surface)"></span></span>
          <div class="g1" style="min-width:0" onclick="event.stopPropagation();go('profile')">
            <div class="row" style="gap:5px;flex-wrap:wrap"><span class="bb" style="font-size:17px">${esc(m.name)}</span>${vbadge(m)}${lvlBadge(m)}</div>
            <div class="tiny fnt mono" style="margin-top:3px" dir="ltr">@${esc(m.username)}</div>
            <div class="row" style="gap:5px;margin-top:6px;flex-wrap:wrap"><span class="badge b-cyan">${esc(m.role)}</span>${m.equippedTitle?`<span class="badge b-gold">${I("crown","i s")} ${esc(m.equippedTitle)}</span>`:""}<span class="badge b-gray">${I("clock","i s")} عضو منذ ${Math.floor((now()-m.joined)/864e5)} يوم</span></div>
          </div>
          <span style="color:var(--accent);line-height:0;padding-inline-start:4px" onclick="event.stopPropagation();go('profile')">${I("fwd","i s")}</span>
        </div>
        <div class="row" style="gap:8px;margin-top:11px" onclick="event.stopPropagation();go('profile')"><span class="tiny fnt">مستوى ${m.level}</span><div class="bar g1" style="height:6px"><i style="width:${Math.min(100,(m.xp/m.xpNext)*100)}%;background:var(--grad-fire)"></i></div><span class="tiny fnt mono">${m.xp}/${m.xpNext} XP</span></div>
        <div class="grid4" style="margin-top:11px" onclick="event.stopPropagation()">
          ${[["flame",nfmt(m.reputation),"سمعة","levels"],["users",nfmt(m.followers),"متابع","followers"],["coins",nfmt(S.coins),"عملة","economy"],["star",S.stars,"نجمة","economy"]].map(([ic,v,l,g])=>`
          <button class="card2 stat" style="padding:9px 4px" onclick="go('${g}')"><span style="color:var(--accent);line-height:0">${I(ic,"i s")}</span><b class="mono">${v}</b><span>${l}</span></button>`).join("")}
        </div>
      </div>
    </div>
    ${isPlatformAdmin() ? `
    <button onclick="go('admin')" style="display:flex;align-items:center;gap:10px;width:100%;margin:13px 0 2px;padding:13px 14px;border-radius:15px;background:linear-gradient(135deg,#7F1D1D,#E60000 60%,#22D3EE);border:1px solid rgba(255,255,255,.22);color:#fff;box-shadow:0 10px 26px rgba(230,0,0,.35);cursor:pointer;text-align:right">
      <span style="display:flex;width:40px;height:40px;border-radius:13px;background:rgba(0,0,0,.3);align-items:center;justify-content:center;line-height:0">${I("shield","l")}</span>
      <span class="g1" style="text-align:right"><span class="b sm" style="display:block;letter-spacing:.3px">الإدارة المركزية أنمي بلاك (المدير الأساسي)</span><span class="tiny" style="color:#FECACA;display:block;line-height:1.5">لوحة التحكم، البلاغات، إدارة الأعضاء، الرتب، الرصيد، والبث العام — مخصصة لـ m774545471@gmail.com</span></span>
      <span style="line-height:0">${I("fwd","l")}</span></button>
    ` : ''}
    <div class="secttl"><h3>${I("zap","i s")} الاختصارات السريعة</h3><button class="more" onclick="openSheet('hubCustomize')">${I("settings","i s")} تخصيص</button></div>
    <div class="grid5">${hubList().map(([id,l,ic,g])=>`
      <button class="col center" style="gap:5px" onclick="hubShortcut('${id}')">
        <span class="ico-tile" style="width:46px;height:46px;border-radius:15px;background:${g};box-shadow:0 4px 14px rgba(0,0,0,.35)">${I(ic,"i s")}</span>
        <span class="tiny" style="font-size:9.5px;font-weight:700;line-height:1.25;color:var(--muted)">${l}</span></button>`).join("")}</div>

    <div class="secttl"><h3>${I("grid","i s")} أقسام المركز</h3></div>
    <div class="grid2">${HUB_CATS.filter(c=>isAdmin||!["developers"].includes(c[0])).map(([id,l,ic])=>`
      <button class="card2 row" style="gap:9px;padding:11px" onclick="hubCat('${id}')">
        <span class="ico-tile" style="width:34px;height:34px;border-radius:11px;background:var(--surface3);color:var(--accent)">${I(ic,"i s")}</span>
        <span class="g1" style="text-align:right"><span class="b tiny" style="display:block">${l}</span><span class="tiny fnt">فتح القسم</span></span>${I("fwd","i s")}</button>`).join("")}</div>

    ${HUB_GROUPS.map(g=>`
      <div class="secttl"><h3>${I(g.ic,"i s")} ${g.t}</h3><span class="badge b-gray mono">${(g.items||[]).length}</span></div>
      <div class="col">${g.items.map(([id,l,d,ic])=>`
        <button class="lstrow" onclick="hubGo('${id}')">
          <span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I(ic,"i s")}</span>
          <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${l}</span><span class="tiny fnt" style="display:block;line-height:1.4">${d}</span></span>
          ${I("fwd","i s")}</button>`).join("")}</div>`).join("")}

    <div class="secttl"><h3>${I("download","i s")} التطبيق والأنظمة</h3></div>
    <div class="col">
      
      <button class="lstrow" onclick="go('eventsHub')"><span class="ico-tile" style="background:var(--grad-emerald);color:#fff">${I("calendar","i s")}</span>
        <span class="g1" style="text-align:right"><span class="b xs">الفعاليات والمسابقات</span><span class="tiny fnt">نشطة ومنتهية وجوائزها وفائزوها</span></span><span class="badge b-gold mono">${S.events.filter(e=>evStatus(e)==="active").length}</span>${I("fwd","i s")}</button>
      <button class="lstrow" onclick="openSheet('searchSheet')"><span class="ico-tile" style="background:var(--grad-purple);color:#fff">${I("search","i s")}</span>
        <span class="g1" style="text-align:right"><span class="b xs">بحث في الإعدادات والصفحات</span><span class="tiny fnt">كل خيار في المنصة بكلمة واحدة</span></span>${I("fwd","i s")}</button>
      <button class="lstrow" onclick="openSheet('pwaSheet')"><span class="ico-tile" style="background:var(--grad-cyan);color:#fff">${I("cloud","i s")}</span>
        <span class="g1" style="text-align:right"><span class="b xs">تثبيت كتطبيق ويب (PWA)</span><span class="tiny fnt">يعمل دون اتصال · ${S.installed?"مثبّت ":"غير مثبّت"}</span></span>${I("download","i s")}</button>
      <button class="lstrow" onclick="go('hubSettings')"><span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("settings","i s")}</span>
        <span class="g1" style="text-align:right"><span class="b xs">إعدادات مركز التحكم</span><span class="tiny fnt">الحركة، التباين، الأصوات</span></span>${I("fwd","i s")}</button>
    </div>
    <div class="center tiny fnt" style="padding:18px 0 6px">More Hub v20.0 · أنمي بلاك — كل زر هنا مفعّل ومتحقق منه </div>
  </div>`;
};
function hubList(){const order=S.hubOrder||[];const hidden=S.hubHidden||[];
  return SHORTCUTS.filter(s=>!hidden.includes(s[0])).slice().sort((a,b)=>{const ia=order.indexOf(a[0]),ib=order.indexOf(b[0]);return (ia<0?999:ia)-(ib<0?999:ib)})}
function hubToggle(id){S.hubHidden=(S.hubHidden||[]).includes(id)?S.hubHidden.filter(x=>x!==id):(S.hubHidden||[]).concat(id);save();render();openSheet("hubCustomize");toast((S.hubHidden||[]).includes(id)?"أُخفي الاختصار":"أُظهر الاختصار","ok")}
function hubMove(id,d){S.hubOrder=(S.hubOrder&&(S.hubOrder||[]).length)?S.hubOrder:SHORTCUTS.map(s=>s[0]);
  const i=S.hubOrder.indexOf(id),j=i+d;if(i<0||j<0||j>=(S.hubOrder||[]).length)return;S.hubOrder.splice(i,1);S.hubOrder.splice(j,0,id);save();render();openSheet("hubCustomize");snd("tap")}
function hubShortcut(id){
  const map={gmail:"gmail",anime:"animeWiki",manga:"animeWiki",characters:"animeWiki",quotes:"animeWiki",explanations:"animeWiki",news:"animeWiki",videos:"animeWiki",favs:"favorites",stats:"otakuStats"};
  const p=map[id];const cat={anime:"anime",manga:"manga",characters:"chars",quotes:"quotes",explanations:"lore",news:"news",videos:"videos"}[id];
  go(p,cat?{cat}:{})
}
function hubCat(id){
  const map={profile:"profile",account:"accountCard",appearance:"appearance",community:"communityHub",anime_universe:"animeWiki",economy:"economy",activity:"activity",admin:"admin",developers:"devCenter",settings:"hubSettings"};
  go(map[id]||"more");
}
function hubGo(id){
  const map={otaku_stats:"otakuStats",my_favs:"favorites","saved-articles":"savedArticles",history:"watchHistory","last-watched":"lastWatched",
   "my-posts":"myPosts","my-hidden-posts":"hiddenPosts","my-archived-posts":"archivedPosts","my-replies":"myReplies","my-followers":"followers",
   "my-groups":"myGroups","my-channels":"myChannels","edit-profile":"editProfile",account_security:"security",privacy:"privacySettings",
   gmail_suite:"gmail",appearance_settings:"appearance",economy_store:"economy",activity_quests:"activity",dev_tools:"devCenter",hub_settings:"hubSettings",
   backup:"__sh",storage:"__sh",changelog:"__sh",help:"__sh",support:"__sh",invite:"__sh",rate:"__sh",about:"__sh",my_activity:"__sh"};
  const SHM={backup:"backupSheet",storage:"storageSheet",changelog:"changelogSheet",help:"helpSheet",support:"supportSheet",invite:"inviteSheet",rate:"rateSheet",about:"aboutSheet",my_activity:"myActivitySheet"};
  if(SHM[id]){openSheet(SHM[id]);return}
  const p=map[id];
  if(id==="my-followers")go("followers",{type:"followers",id:"me"});
  else go(p||"more");
}

/* ============================================================
   13) موسوعة الأنمي (Wiki): أنمي، مانجا، شخصيات، اقتباسات، شروحات، أخبار، فيديو
   ============================================================ */
PAGES.animeWiki=()=>{
  const cat=S.params.cat||"anime";setNav(false);
  const tabs=[["anime","أنمي","film"],["manga","مانجا","book"],["chars","شخصيات","star"],["quotes","اقتباسات","quote"],["lore","شروحات","help"],["news","أخبار","sparkles"],["videos","فيديو","clapper"]];
  setHdr(backHdr("موسوعة الأنمي والويكي","قاعدة بيانات الأوتاكو",`<button class="iconbtn" onclick="S.searchQ='';go('search')">${I("search")}</button>`));
  let body="";
  if(cat==="anime"){
    body=`<div class="chiprow">${["الكل","شونين (أكشن ومغامرات)","سينين (نفسي وعميق)","شوجو ورومانسية (دراما)","إيسيكاي (عوالم خيالية)","سايبربانك وخيال علمي","شريحة من الحياة وكوميديا","أكشن","مغامرة","خيال","دراما","كوميدي","مستمر","مكتمل","الأعلى تقييماً"].map((g,i)=>`<button class="chip ${i===0?'on':''}" onclick="filterWiki(this,'anime','${g}')">${g}</button>`).join("")}</div>
    <div class="col">${S.wiki.anime.map(a=>animeRow(a)).join("")}</div>`;
  } else if(cat==="manga"){
    body=`<div class="chiprow">${["الكل","مستمر","متوقف","مكتمل","الأعلى تقييماً"].map((g,i)=>`<button class="chip ${i===0?'on':''}" onclick="filterWiki(this,'manga','${g}')">${g}</button>`).join("")}</div>
    <div class="col">${S.wiki.manga.map(a=>mangaRow(a)).join("")}</div>`;
  } else if(cat==="chars"){
    body=`<div class="chiprow">${["الكل","الأكثر شعبية","الأقوى","حسب الأنمي"].map((g,i)=>`<button class="chip ${i===0?'on':''}" onclick="filterWiki(this,'chars','${g}')">${g}</button>`).join("")}</div>
    <div class="col">${S.wiki.chars.map(c=>charRow(c)).join("")}</div>`;
  } else if(cat==="quotes"){
    body=`<div class="chiprow">${["الكل","الأكثر إعجاباً","حسب الأنمي","حسب الشخصية"].map((g,i)=>`<button class="chip ${i===0?'on':''}" onclick="this.parentNode.querySelectorAll('.chip').forEach(x=>x.classList.remove('on'));this.classList.add('on');toast('ترتيب: ${g}','info')">${g}</button>`).join("")}</div>
    <div class="col">${S.wiki.quotes.map((q,qi)=>`<div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(168,85,247,.08),transparent)">
      <div class="row" style="gap:9px;align-items:flex-start"><span class="ico-tile" style="background:var(--grad-purple);color:#fff;flex-shrink:0">${I("quote","i s")}</span>
        <div class="g1"><p class="sm b" style="line-height:1.7">«${esc(q.t)}»</p>
        <div class="tiny fnt" style="margin-top:6px">— ${esc(q.by)} · ${esc(q.a)}</div></div></div>
      <div class="row" style="gap:7px;margin-top:11px">
        <button class="btn btn-sec btn-xs ${q.liked?'btn-rose':''}" onclick="toggleQuoteLike(${qi})">${IF("heart","i s")} <span class="mono">${nfmt(q.l)}</span></button>
        <button class="btn btn-sec btn-xs" onclick="copyTxt('${esc(q.t).replace(/'/g,"")}')">${I("copy","i s")} نسخ</button>
        <button class="btn btn-sec btn-xs" onclick="openSheet('shareSheet')">${I("share","i s")} مشاركة</button>
        <button class="btn btn-sec btn-xs" onclick="go('createStory');S.storyEmo='msgsq';save()">${I("clock","i s")} قصة</button></div></div>`).join("")}</div>
    <button class="btn btn-purple btn-lg" style="margin-top:12px" onclick="toast('اقتباس عشوائي: «'+'القوة لا تأتي من الجسد بل من الإرادة'+'» ','ok');snd('success')">${I("wand","i s")} اقتباس عشوائي بالذكاء الاصطناعي</button>`;
  } else if(cat==="lore"){
    body=`<div class="col">${S.wiki.lore.map(l=>`<button class="lstrow" onclick="go('loreDetail',{id:'${l.id}'})">
      <span class="ico-tile" style="background:var(--grad-emerald);color:#fff">${I("help","i s")}</span>
      <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(l.t)}</span><span class="tiny fnt" style="display:block">${esc(l.d)}</span>
      <span class="tiny fnt">${I("clock","i s")} مدة القراءة ${l.r}</span></span>${I("fwd","i s")}</button>`).join("")}</div>`;
  } else if(cat==="news"){
    body=`<div class="col">${S.wiki.news.map(n=>`<button class="lstrow" onclick="go('newsDetail',{id:'${n.id}'})">
      <span class="ico-tile" style="width:56px;height:56px;border-radius:13px;background:linear-gradient(135deg,${n.c1},${n.c2});">${I(n.emo,"i l")}</span>
      <span class="g1" style="text-align:right"><span class="row" style="gap:5px"><span class="b xs">${esc(n.t)}</span>${n.hot?'<span class="badge b-red"> ساخن</span>':""}</span>
      <span class="tiny fnt" style="display:block;margin-top:2px">${esc(n.d)}</span><span class="tiny fnt">${ago(n.at)}</span></span>${I("fwd","i s")}</button>`).join("")}</div>`;
  } else {
    body=`<div class="col">${S.wiki.videos.map(v=>`<button class="lstrow" onclick="go('videoDetail',{id:'${v.id}'})">
      <span class="ico-tile" style="width:64px;height:46px;border-radius:11px;background:linear-gradient(135deg,${v.c1},${v.c2});font-size:19px;position:relative">${I(v.emo,"xl")}
        <span class="badge b-gray mono" style="position:absolute;bottom:3px;left:3px;font-size:9.5px">${v.dur}</span></span>
      <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(v.t)}</span><span class="tiny fnt">${nfmt(v.v)} مشاهدة · ${v.dur}</span></span>${I("play","i s")}</button>`).join("")}</div>`;
  }
  return `<div class="pad">${body}</div>`;
};
function filterWiki(el,list,g){
  el.parentNode.querySelectorAll(".chip").forEach(x=>x.classList.remove("on"));el.classList.add("on");
  const arr=g==="الأعلى تقييماً"?S.wiki[list].slice().sort((a,b)=>b.rating-a.rating)
   :g==="الأكثر شعبية"?S.wiki[list].slice().sort((a,b)=>(b.likes||0)-(a.likes||0))
   :g==="الأقوى"?S.wiki[list].slice().sort((a,b)=>(b.power||0)-(a.power||0))
   :S.wiki[list].filter(x=>g==="الكل"||(x.genres||[]).includes(g)||x.status===g);
  const box=el.closest(".pad");const old=box.querySelector(".col");
  const fn=list==="anime"?animeRow:list==="manga"?mangaRow:charRow;
  if(old)old.innerHTML=arr.length?arr.map(fn).join(""):`<div class="empty">${I("search","l")}<div class="xs b">لا نتائج في «${g}»</div></div>`;
  snd("tap");toast("تصفية: "+g+" ("+arr.length+")","info");
}
PAGES.animeDetail=()=>{
  const a=((S.wiki&&S.wiki.anime)||[]).find(x=>x.id===S.params.id);if(!a){setNav(false);setHdr(backHdr("العمل",""));return emptyState("film","غير موجود","")}
  setNav(false);setHdr(backHdr(a.n,a.en,`<button class="iconbtn" onclick="openSheet('animeMenu','${a.id}')">${I("more")}</button>`));
  const fav=S.me.favAnime.includes(a.id);
  return `<div>
    <div class="art-bg" style="--c1:${a.c1};--c2:${a.c2};height:186px;display:flex;align-items:center;justify-content:center;font-size:76px;position:relative;${bgImg(a)}">
      ${I(a.emo,"xl")}<button class="iconbtn" style="position:absolute;background:rgba(0,0,0,.55);color:#fff;border-color:rgba(255,255,255,.25);width:54px;height:54px;border-radius:50%" onclick="togglePlay(this)">${I("play","l")}</button>
      <span class="badge b-red" style="position:absolute;top:11px;right:11px">${I("star","i s")} ${a.rating}</span></div>
    <div class="pad col">
      <div><div class="bb" style="font-size:19px">${esc(a.n)}</div><div class="tiny fnt mono">${esc(a.en)} · ${a.y} · ${esc(a.studio)}</div>
        <div class="row wrap" style="gap:5px;margin-top:8px">${a.genres.map(g=>`<span class="badge b-cyan">${g}</span>`).join("")}<span class="badge ${a.status==='مستمر'?'b-emerald':'b-gray'}">${a.status}</span><span class="badge b-gold mono">${a.ep} حلقة</span></div></div>
      <div class="grid4">${[["star",a.rating,"التقييم"],["eye",nfmt(rnd(80,900))+"K","مشاهدة"],["heart",nfmt(rnd(20,300))+"K","مفضلة"],["msgsq",nfmt(rnd(2,40))+"K","نقاش"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
      <div class="row wrap" style="gap:7px">
        <button class="btn ${fav?'btn-rose':'btn-primary'} btn-sm" onclick="toggleFavAnime('${a.id}')">${IF("heart","i s")} ${fav?"في المفضلة":"أضف للمفضلة"}</button>
        <button class="btn btn-sec btn-sm" onclick="trackAnime('${a.id}',this)">${I("check","i s")} أتابعه</button>
        <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet')">${I("share","i s")} مشاركة</button>
        <button class="btn btn-sec btn-sm" onclick="go('worlds')">${I("globe","i s")} مشاهدة جماعية</button>
      </div>
      <div class="card" style="padding:13px"><div class="b sm">${I("file","i s")} القصة</div><p class="xs mut" style="margin-top:7px;line-height:1.8">${esc(a.desc)}</p>
        <button class="btn btn-ghost btn-xs" style="margin-top:9px" onclick="toast('ملخص بالذكاء الاصطناعي: عمل ملحمي يستحق المشاهدة ','ok');snd('success')">${I("wand","i s")} لخّص بالذكاء الاصطناعي</button></div>
      <div class="secttl"><h3>${I("list","i s")} قائمة الحلقات</h3><span class="badge b-gray mono">${a.ep}</span></div>
      <div class="col">${Array.from({length:Math.min(8,a.ep)},(_,i)=>{const n=i+1;const w=S.me.history.some(h=>h.a===a.id&&h.e===n);
        return `<button class="lstrow" onclick="watchEp('${a.id}',${n},this)">
          <span class="ico-tile" style="width:44px;height:34px;border-radius:9px;background:linear-gradient(135deg,${a.c1},${a.c2});font-size:11px;font-weight:900;color:#fff">${n}</span>
          <span class="g1" style="text-align:right"><span class="b tiny" style="display:block">الحلقة ${n} — ${esc(["البداية","القرار","المواجهة","الخسارة","النهوض","الحقيقة","المعركة","النهاية"][i])}</span>
          <span class="tiny fnt">24 دقيقة ${w?'· <b style="color:var(--emerald)">شاهدتها </b>':""}</span></span>${I(w?"check":"play","i s")}</button>`}).join("")}</div>
      <div class="secttl"><h3>${I("star","i s")} الشخصيات</h3><button class="more" onclick="go('animeWiki',{cat:'chars'})">الكل</button></div>
      <div class="row wrap" style="gap:8px">${((S.wiki&&S.wiki.chars)||[]).slice(0,4).map(c=>`<button class="card2 center" style="padding:9px 12px" onclick="go('charDetail',{id:'${c.id}'})"><span>${I(c.emo,"i l")}</span><span class="tiny b" style="display:block">${esc(c.n)}</span></button>`).join("")}</div>
      <div class="secttl"><h3>${I("msgsq","i s")} نقاش المجتمع</h3><button class="more" onclick="go('create',{type:'post'})">أضف رأيك</button></div>
      <div class="col">${(S.posts||[]).slice(0,2).map(p=>postCard(p)).join("")}</div>
    </div></div>`;
};
function toggleFavAnime(id){const f=S.me.favAnime;if(f.includes(id)){S.me.favAnime=f.filter(x=>x!==id);toast("أُزيل من المفضلة","info")}else{f.push(id);toast("أُضيف إلى المفضلة ","ok");addXP(5)}snd("tap");save();render()}
function trackAnime(id,el){el.classList.toggle("btn-emerald");const on=el.classList.contains("btn-emerald");el.innerHTML=on?I("check","i s")+" في قائمتي ":I("check","i s")+" أتابعه";toast(on?"أُضيف إلى قائمة المتابعة ":"أُزيل من القائمة","ok");snd("success");save()}
function toggleNewsLike(id){S.newsLikes=S.newsLikes||[];if(S.newsLikes.includes(id))S.newsLikes=S.newsLikes.filter(x=>x!==id);else S.newsLikes.push(id);save();render();snd("tap");toast(S.newsLikes.includes(id)?"أعجبك الخبر ":"أُزيل إعجابك ","ok")}
function scanSuccess(){closeOvl();const xs=S.users.filter(y=>y.id!=="me"&&!S.following.includes(y.id));const x=xs.length?pick(xs):pick(S.users);if(!S.following.includes(x.id))follow(x.id);snd("success");toast("مسح ناجح: أضفت @"+x.username+" من البطاقة ","ok");setTimeout(()=>go('publicProfile',{id:x.id}),500)}
function exportMyData(){const mine=S.posts.filter(p=>p.authorId==="me");const cmts=[];S.posts.forEach(p=>p.comments.forEach(cc=>{if(cc.userId==="me")cmts.push({post:p.id,text:cc.text,at:cc.createdAt})}));const ok=dl("animeblack-my-data.json",JSON.stringify({exportedAt:new Date().toISOString(),profile:{name:S.me.name,username:S.me.username,bio:S.me.bio,level:S.me.level,reputation:S.me.reputation,joined:S.me.joined},posts:mine.map(p=>({id:p.id,text:p.text,type:p.type,likes:p.likes,views:p.views,at:p.createdAt})),comments:cmts,stories:((S.stories||[]).find(s=>s.userId==="me")||{items:[]}).items.length,following:S.following,followers:S.me.followers,coins:S.coins,savedPosts:S.me.saved,savedItems:S.savedItems||[],history:(S.me.history||[]).slice(0,50)},null,2));toast(ok?"صُدّرت بياناتك الكاملة كملف JSON ":"تعذّر التصدير ",ok?"ok":"err")}
function approvePost(pid){(S.approved=S.approved||[]);if(!S.approved.includes(pid))S.approved.push(pid);save();render();snd("tap");toast("تمت الموافقة على المحتوى وبقي منشوراً ","ok")}
function toggleReelSave(rid){const r=(S.reels||[]).find(x=>x.id===rid);if(!r)return;r.saved=!r.saved;save();render();snd("tap");toast(r.saved?"حُفظ الريلز في محفوظاتك ":"أُزيل الريلز من محفوظاتك ","ok")}
function toggleChPin(cid,chid){const c=(S.communities||[]).find(x=>x.id===cid);const ch=c&&((c&&c.channels)||[]).find(x=>x.id===chid);if(!ch)return;ch.pinned=!ch.pinned;save();render();toast(ch.pinned?"ثُبّتت القناة في قائمتك ":"أُلغي تثبيت القناة ","ok")}
function toggleChMute(cid,chid){const c=(S.communities||[]).find(x=>x.id===cid);const ch=c&&((c&&c.channels)||[]).find(x=>x.id===chid);if(!ch)return;ch.muted=!ch.muted;save();render();toast(ch.muted?"كُتمت إشعارات القناة ":"أُعيدت إشعارات القناة ","ok")}
function toggleSaveArticle(id,title,type){S.savedItems=S.savedItems||[];const ex=S.savedItems.find(x=>x.id===id);if(ex){S.savedItems=S.savedItems.filter(x=>x.id!==id);toast("أُزيل من المحفوظات ","info")}else{S.savedItems.unshift({id,title:title||"",type:type||"news",at:now()});toast("حُفظ في «المقالات والمحفوظات» ","ok")}save();render()}
function clearHistory(){const snap=(S.me.history||[]).slice();if(!snap.length){toast("السجل فارغ ","info");return}S.me.history=[];S.__histSeeded=1;save();render();toast("مُسح سجل المشاهدة ","err",()=>{S.me.history=snap;save();render();toast("استُعيد السجل ","ok")})}
function histGo(x){if(!x)return;if(x.a)go('animeDetail',{id:x.a});else if(x.type==="story"&&x.sid)go('storyViewer',{sid:x.sid});else toast("العنصر لم يعد متاحاً ","info")}
function pickReelMusic(id){const r=(S.reels||[]).find(x=>x.id===id);if(!r)return;S.reelMusic=r.music;save();render();snd("success");toast("تم اختيار صوت: "+r.music+" ","ok")}
function toggleCharLike(id){const c=((S.wiki&&S.wiki.chars)||[]).find(x=>x.id===id);if(!c)return;c.liked=!c.liked;c.likes+=c.liked?1:-1;save();render();snd("tap")}
function toggleQuoteLike(i){const q=S.wiki.quotes[i];if(!q)return;q.liked=!q.liked;q.l+=q.liked?1:-1;save();render();snd("tap")}
function watchEp(aid,n,el){const a=((S.wiki&&S.wiki.anime)||[]).find(x=>x.id===aid);S.me.history.unshift({a:aid,e:n,t:a.n,at:now()});S.me.episodes++;addXP(20,"مشاهدة حلقة");questProgress("q3");toast("تشغيل الحلقة "+n+" من "+a.n+" ","ok");snd("success");save();render()}
PAGES.mangaDetail=()=>{
  const a=((S.wiki&&S.wiki.manga)||[]).find(x=>x.id===S.params.id);if(!a){setNav(false);setHdr(backHdr("المانجا",""));return emptyState("book","غير موجود","")}
  setNav(false);setHdr(backHdr(a.n,a.en));
  return `<div><div class="art-bg" style="--c1:${a.c1};--c2:${a.c2};height:170px;display:flex;align-items:center;justify-content:center;color:#fff;${bgImg(a)}">${IF(a.emo,"xxl")}</div>
  <div class="pad col">
    <div><div class="bb" style="font-size:19px">${esc(a.n)}</div><div class="tiny fnt mono">${esc(a.en)} · ${a.ch} فصل</div>
      <div class="row wrap" style="gap:5px;margin-top:7px"><span class="badge b-gold">${I("star","i s")} ${a.rating}</span><span class="badge b-gray">${a.status}</span></div></div>
    <p class="xs mut" style="line-height:1.8">${esc(a.desc)}</p>
    <div class="row wrap" style="gap:7px"><button class="btn btn-primary btn-sm" onclick="toast('فتح القارئ... ','ok');go('mangaReader',{id:'${a.id}'})">${I("book","i s")} اقرأ الآن</button>
      <button class="btn btn-sec btn-sm" onclick="trackAnime('${a.id}',this)">${I("bookmark","i s")} ضعه في قائمتي</button>
      <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet')">${I("share","i s")}</button></div>
    <div class="secttl"><h3>${I("list","i s")} الفصول</h3></div>
    <div class="col">${Array.from({length:8},(_,i)=>{const n=a.ch-i;return `<button class="lstrow" onclick="go('mangaReader',{id:'${a.id}',ch:${n}})">
      <span class="ico-tile" style="background:var(--surface3);color:var(--accent);font-weight:900;font-size:11px">${n}</span>
      <span class="g1" style="text-align:right"><span class="b tiny" style="display:block">الفصل ${n}</span><span class="tiny fnt">${ago(now()-i*864e5)} · ${rnd(18,42)} صفحة</span></span>${I("book","i s")}</button>`}).join("")}</div>
  </div></div>`;
};
PAGES.mangaReader=()=>{
  const a=((S.wiki&&S.wiki.manga)||[]).find(x=>x.id===S.params.id)||S.wiki.manga[0];const ch=S.params.ch||a.ch;setNav(false);
  setHdr(backHdr("الفصل "+ch,a.n,`<button class="iconbtn" onclick="toast('وضع القراءة الليلي ','info');document.body.classList.toggle('light')">${I("moon")}</button>`));
  return `<div class="pad col">
    ${Array.from({length:6},(_,i)=>`<div class="art-bg" style="--c1:${a.c1};--c2:${a.c2};aspect-ratio:3/4;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:44px;position:relative">${I(a.emo,"xl")}
      <span class="badge b-gray mono" style="position:absolute;bottom:9px;left:9px">صفحة ${i+1} / ٤٢</span></div>`).join("")}
    <div class="row" style="gap:8px"><button class="btn btn-sec g1" onclick="S.params.ch=Math.max(1,(S.params.ch||${a.ch})-1);render();toast('الفصل '+S.params.ch,'info')">السابق</button>
      <button class="btn btn-primary g1" onclick="S.params.ch=Math.min(${a.ch},(S.params.ch||${a.ch})+1);render();toast('الفصل '+S.params.ch,'ok')">التالي</button></div>
    <div class="row wrap" style="gap:7px;justify-content:center">
      <button class="chip ${(S.savedCh||[]).includes(a.id+':'+ch)?'on':''}" onclick="saveCh('${a.id}',${ch})">${I("bookmark","i s")} ${(S.savedCh||[]).includes(a.id+':'+ch)?'محفوظ':'حفظ'}</button>
      <button class="chip" onclick="zoomCh(1)">${I("zoomin","i s")} تكبير</button>
      <button class="chip" onclick="zoomCh(-1)">${I("zoomout","i s")} تصغير</button>
      <button class="chip" onclick="go('create',{type:'post'})">${I("msgsq","i s")} ناقش الفصل</button></div>
  </div>`;
};
PAGES.charDetail=()=>{
  const c=((S.wiki&&S.wiki.chars)||[]).find(x=>x.id===S.params.id);if(!c){setNav(false);setHdr(backHdr("الشخصية",""));return emptyState("star","غير موجود","")}
  setNav(false);setHdr(backHdr(c.n,c.anime));
  return `<div><div class="art-bg" style="--c1:${c.c1};--c2:${c.c2};height:200px;display:flex;align-items:center;justify-content:center;color:#fff">${IF(c.emo,"xxl")}</div>
  <div class="pad col">
    <div><div class="bb" style="font-size:19px">${esc(c.n)}</div><div class="tiny fnt">${esc(c.anime)} · ${esc(c.role)}</div></div>
    <div class="card2" style="padding:12px"><div class="rowb tiny b"><span>مستوى القوة</span><span class="mono" style="color:var(--accent)">${c.power}/100</span></div>
      <div class="bar" style="margin-top:6px"><i style="width:${c.power}%"></i></div>
      <div class="grid3" style="margin-top:11px">${[["السرعة",rnd(70,99)],["الذكاء",rnd(70,99)],["التحمل",rnd(70,99)]].map(([l,v])=>`<div class="center"><div class="bar" style="height:4px"><i style="width:${v}%"></i></div><div class="tiny fnt" style="margin-top:4px">${l} ${v}</div></div>`).join("")}</div></div>
    <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(168,85,247,.08),transparent)"><span style="color:var(--purple)">${I("quote","i s")}</span>
      <p class="sm b" style="margin-top:6px;line-height:1.7">«${esc(c.quote)}»</p></div>
    <div class="row wrap" style="gap:7px">
      <button class="btn ${c.liked?'btn-rose':'btn-primary'} btn-sm" onclick="toggleCharLike('${c.id}')">${IF("heart","i s")} ${nfmt(c.likes)}</button>
      <button class="btn btn-sec btn-sm" onclick="go('animeWiki',{cat:'quotes'})">${I("quote","i s")} اقتباساته</button>
      <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet')">${I("share","i s")} مشاركة</button></div>
    <div class="secttl"><h3>${I("film","i s")} يظهر في</h3></div>
    <div class="col">${((S.wiki&&S.wiki.anime)||[]).slice(0,2).map(a=>animeRow(a)).join("")}</div>
  </div></div>`;
};
PAGES.loreDetail=()=>{const l=((S.wiki&&S.wiki.lore)||[]).find(x=>x.id===S.params.id);if(!l){setNav(false);setHdr(backHdr("العالم",""));return emptyState("help","غير موجود","")}
  setNav(false);setHdr(backHdr(l.t,"مدة القراءة "+l.r));
  return `<div class="pad col"><div class="art-bg" style="--c1:#064E3B;--c2:#10B981;height:140px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:52px"></div>
    <p class="sm" style="line-height:1.9">${esc(l.d)}</p>
    <p class="xs mut" style="line-height:1.9">في هذا الشرح نستعرض بالتفصيل كل ما يتعلق بالموضوع، مع أمثلة من الحلقات والفصول، وتحليل للمنطق الداخلي للعالم. ننصح بقراءته بعد إنهاء العمل لتجنب السبويلر.</p>
    <div class="card2" style="padding:12px"><div class="b xs">${I("alert","i s")} تحذير سبويلر</div><div class="tiny fnt" style="margin-top:4px">يحتوي على تفاصيل حاسمة من القصة.</div></div>
    <div class="row wrap" style="gap:7px"><button class="btn btn-primary btn-sm" onclick="toast('حُفظ في المقالات المحفوظة ','ok');S.me.saved.push('${l.id}');save()">${I("bookmark","i s")} حفظ</button>
      <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet')">${I("share","i s")} مشاركة</button>
      <button class="btn btn-sec btn-sm" onclick="go('create',{type:'post'})">${I("msgsq","i s")} ناقش</button></div></div>`;
};
PAGES.newsDetail=()=>{const n=((S.wiki&&S.wiki.news)||[]).find(x=>x.id===S.params.id);if(!n){setNav(false);setHdr(backHdr("الخبر",""));return emptyState("sparkles","غير موجود","")}
  setNav(false);setHdr(backHdr("خبر","أنمي بلاك · الأخبار"));
  return `<div class="pad col"><div class="art-bg" style="--c1:${n.c1};--c2:${n.c2};height:150px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff">${IF(n.emo,"xxl")}</div>
    <div><div class="bb" style="font-size:17px;line-height:1.5">${esc(n.t)}</div><div class="tiny fnt" style="margin-top:6px">${ago(n.at)} · فريق أخبار أنمي بلاك ${n.hot?'· <b style="color:var(--rose)"> ساخن</b>':""}</div></div>
    <p class="sm" style="line-height:1.9">${esc(n.d)}</p>
    <p class="xs mut" style="line-height:1.9">بحسب المصادر الرسمية، يأتي هذا الإعلان ضمن خطة الاستوديو لتوسيع العمل خلال العام القادم، مع الحفاظ على نفس فريق الإنتاج الذي نال إشادة واسعة.</p>
    <div class="grid3">${[["eye",nfmt(rnd(4,90))+"K","قراءة"],["heart",nfmt(rnd(1,20))+"K","إعجاب"],["msgsq",nfmt(rnd(50,900)),"تعليق"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
      <button class="btn ${(S.newsLikes||[]).includes(S.params.id)?'btn-rose':'btn-primary'} btn-sm" onclick="toggleNewsLike(S.params.id)">${I("heart","i s")} ${(S.newsLikes||[]).includes(S.params.id)?"أعجبني":"أعجبني الخبر"}</button>
      <button class="btn btn-sec btn-sm" onclick="toggleSaveArticle('${S.params.id||(S.wiki.news&&S.wiki.news[0].id)||'n1'}',(S.wiki.news&&((S.wiki&&S.wiki.news)||[]).find(x=>x.id===(S.params.id||'n1'))||{t:'خبر'}).t,'news');snd('success')">${I("bookmark","i s")} ${(S.savedItems||[]).some(x=>x.id===(S.params.id||'n1'))?"محفوظ":"حفظ"}</button>
      <button class="btn btn-sec btn-sm" onclick="openSheet('shareSheet')">${I("share","i s")} مشاركة</button>
      <button class="btn btn-sec btn-sm" onclick="go('create',{type:'post'})">${I("msgsq","i s")} ناقش الخبر</button></div>
    <div class="secttl"><h3>${I("sparkles","i s")} أخبار مشابهة</h3></div>
    <div class="col">${S.wiki.news.filter(x=>x.id!==n.id).map(x=>`<button class="lstrow" onclick="go('newsDetail',{id:'${x.id}'})"><span class="ico-tile" style="background:linear-gradient(135deg,${x.c1},${x.c2})">${I(x.emo,"xl")}</span><span class="g1" style="text-align:right"><span class="b tiny" style="display:block">${esc(x.t)}</span><span class="tiny fnt">${ago(x.at)}</span></span>${I("fwd","i s")}</button>`).join("")}</div></div>`;
};
PAGES.newsView=PAGES.newsDetail;
PAGES.user=PAGES.publicProfile;
PAGES.videoDetail=()=>{const v=((S.wiki&&S.wiki.videos)||[]).find(x=>x.id===S.params.id);if(!v){setNav(false);setHdr(backHdr("الفيديو",""));return emptyState("film","غير موجود","")}
  setNav(false);setHdr(backHdr("مشغّل الفيديو",v.dur));
  return `<div style="height:100%;display:flex;flex-direction:column">
    <div class="art-bg" style="--c1:${v.c1};--c2:${v.c2};aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;position:relative;color:#fff">${IF(v.emo,"xxl")}
      <button class="iconbtn" style="position:absolute;width:62px;height:62px;border-radius:50%;background:rgba(0,0,0,.6);color:#fff;border-color:rgba(255,255,255,.3)" onclick="togglePlay(this)">${I("play","xl")}</button>
      <div style="position:absolute;bottom:0;left:0;right:0;padding:9px;background:linear-gradient(to top,rgba(0,0,0,.85),transparent)">
        <div class="bar" style="height:4px;background:rgba(255,255,255,.25)"><i style="width:34%"></i></div>
        <div class="rowb tiny" style="color:#fff;margin-top:5px"><span class="mono">06:14</span>
          <span class="row" style="gap:9px"><button onclick="toast('جودة: 1080p','info')">${I("settings","i s")}</button><button onclick="toggleFS()">${I("max","i s")}</button><span class="mono">${v.dur}</span></span></div></div></div>
    <div class="pad col" style="flex:1;overflow-y:auto">
      <div class="bb" style="font-size:15px">${esc(v.t)}</div>
      <div class="row" style="gap:9px"><span class="tiny fnt">${nfmt(v.v)} مشاهدة · ${v.dur}</span><span class="g1"></span>
        <button class="chip" onclick="this.classList.toggle('on');toast('أعجبك الفيديو ','ok')">${I("thumbup","i s")} ${nfmt(rnd(2,90))}K</button>
        <button class="chip" onclick="openSheet('shareSheet')">${I("share","i s")}</button>
        <button class="chip ${(S.savedItems||[]).some(x=>x.id===v.id)?'on':''}" onclick="toggleSaveArticle('${v.id}','${esc(v.t).replace(/'/g,"")}','video')">${I("bookmark","i s")}</button></div>
      <div class="card2" style="padding:11px"><div class="row" style="gap:9px">${av(u('bot'),36)}<div class="g1"><div class="b xs">قناة أنمي بلاك الرسمية</div><div class="tiny fnt">${nfmt(420000)} مشترك</div></div>
        <button class="btn btn-primary btn-xs" onclick="this.classList.toggle('btn-sec');this.textContent=this.classList.contains('btn-sec')?'مشترك ':'اشتراك'">اشتراك</button></div></div>
      <div class="secttl"><h3>${I("msgsq","i s")} التعليقات</h3></div>
      <div class="col">${[{n:"ليفاي",t:"أفضل تجميع شفته "},{n:"ريم",t:"الجودة خيالية، شكراً!"},{n:"زورو",t:"الحركة في الدقيقة ٦ أسطورية"}].map(c=>`
        <div class="cmt">${av({avatar:pick(AV),frame:null},30)}<div class="g1"><div class="row" style="gap:5px"><span class="b tiny">${c.n}</span><span class="tiny fnt">${ago(now()-rnd(1,40)*36e5)}</span></div><div class="xs">${c.t}</div>
        <div class="row" style="gap:11px;margin-top:4px"><button class="tiny b mut" onclick="this.style.color='var(--rose)';toast('إعجاب ','ok');snd('tap')">${IF("heart","i s")}</button><button class="tiny b mut" onclick="openSheet('whoLiked','${typeof p!=="undefined"?p.id:(typeof v!=="undefined"?v.id:"")}')">${rnd(3,200)} تفاعل</button><button class="tiny b mut" onclick="replyPre(this,'${c.n}')">رد</button></div></div></div>`).join("")}</div>
    </div></div>`;
};

/* ============================================================
   14) مكتبتي الخاصة: إحصائيات، مفضلة، سجل، منشوراتي
   ============================================================ */
PAGES.otakuStats=()=>{
  const m=S.me;setNav(false);setHdr(backHdr("إحصائيات الأوتاكو الشاملة","تحليل كامل لرحلتك",`<button class="iconbtn" onclick="openSheet('statsShare')">${I("share")}</button>`));
  const tot=m.watchHours;updateAchievements();
  const acts=[];{const dd=new Date();dd.setHours(0,0,0,0);const bb=dd.getTime();for(let i=29;i>=0;i--){const s0=bb-i*864e5;acts.push(S.posts.filter(p=>p.createdAt>=s0&&p.createdAt<s0+864e5).length+S.posts.reduce((a2,p)=>a2+p.comments.filter(c=>c.createdAt>=s0&&c.createdAt<s0+864e5).length,0))}}
  const rankPct=Math.max(10,Math.min(97,Math.round((S.users.filter(y=>(y.reputation||0)<(m.reputation||0)).length/(((S.users||[]).length||1)))*100)));
  return `<div class="pad col">
    <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(34,211,238,.12),rgba(168,85,247,.07))">
      <div class="row" style="gap:11px"><span class="ico-tile" style="width:48px;height:48px;border-radius:15px;background:var(--grad-fire);color:#fff">${I("barchart","l")}</span>
        <div class="g1"><div class="bb" style="font-size:17px">${nfmt(tot)} ساعة مشاهدة</div><div class="tiny fnt">ما يعادل ${Math.round(tot/24)} يوم متواصل · ${nfmt(m.episodes)} حلقة</div></div></div>
      <div class="grid4" style="margin-top:13px">
        ${[["film",nfmt(m.episodes),"حلقة"],["book",nfmt(m.mangaChapters),"فصل مانجا"],["clock",nfmt(Math.round(tot/m.episodes*60))+"د","متوسط"],["trend",nfmt(m.reputation),"سمعة"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    </div>
    <div class="grid2" style="margin-bottom:4px"><button class="btn btn-sec btn-xs" onclick="go('watchHistory')">${I("clock","i s")} سجل المشاهدة الكامل</button><button class="btn btn-sec btn-xs" onclick="go('lastWatched')">${I("play","i s")} آخر ما شاهدته</button></div>
    <div class="secttl"><h3>${I("chart","i s")} نشاطك خلال ٣٠ يوماً</h3></div>
    <div class="card" style="padding:13px"><div class="tiny fnt" style="margin-bottom:4px">منشوراتك وتعليقاتك اليومية (بيانات حقيقية)</div>${svgChart(acts)}</div>
    <div class="secttl"><h3>${I("palette","i s")} توزيع التصنيفات</h3></div>
    <div class="card" style="padding:13px"><div class="col">${Object.entries(m.genres).map(([g,v],i)=>`
      <div><div class="rowb tiny b"><span>${g}</span><span class="mono" style="color:${["#22D3EE","#F59E0B","#A855F7","#06B6D4","#10B981"][i]}">${v}%</span></div>
      <div class="bar" style="margin-top:4px"><i style="width:${v}%;background:${["#22D3EE","#F59E0B","#A855F7","#06B6D4","#10B981"][i]}"></i></div></div>`).join("")}</div></div>
    <div class="secttl"><h3>${I("film","i s")} الاستوديوهات المفضلة</h3></div>
    <div class="card" style="padding:13px"><div class="col">${Object.entries(m.studios).map(([s,v])=>`
      <div class="row" style="gap:9px"><span class="badge b-gray mono" style="width:38px;justify-content:center">${v}</span>
        <div class="g1"><div class="tiny b">${s}</div><div class="bar" style="height:4px;margin-top:3px"><i style="width:${v*2}%"></i></div></div></div>`).join("")}</div></div>
    <div class="secttl"><h3>${I("trophy","i s")} إنجازات الأوتاكو</h3></div>
    <div class="grid3">${S.achievements.map(a=>`<div class="card2 center" style="padding:12px 6px;opacity:${a.got?1:.4}">
      <span style="width:40px;height:40px;border-radius:50%;background:${a.got?'var(--grad-gold)':'var(--surface3)'};display:flex;align-items:center;justify-content:center;margin:0 auto 6px;color:#fff">${I(a.ic,"i s")}</span>
      <div class="tiny b">${a.n}</div></div>`).join("")}</div>
    <div class="secttl"><h3>${I("globe","i s")} مقارنتك بالمجتمع</h3></div>
    <div class="card" style="padding:13px"><div class="col">${[["أعلى من "+rankPct+"٪ من الأعضاء في ساعات المشاهدة",rankPct],["أعلى من "+Math.max(5,rankPct-14)+"٪ في عدد المانجا المقروء",Math.max(5,rankPct-14)],["أعلى من "+Math.max(3,rankPct-26)+"٪ في السمعة المجتمعية",Math.max(3,rankPct-26)]].map(([t,v])=>`<div><div class="tiny b">${t}</div><div class="bar" style="margin-top:5px"><i style="width:${v}%"></i></div></div>`).join("")}</div></div>
    <div class="grid2"><button class="btn btn-primary" onclick="openSheet('statsShare')">${I("share","i s")} شارك إحصائياتك</button>
      <button class="btn btn-sec" onclick="exportStats()">${I("download","i s")} تصدير</button>
  </div>`;
};
PAGES.favorites=()=>{
  const t=S.params.tab||"anime";setNav(false);setHdr(backHdr("المفضلة والألقاب","كل ما اقتنيته"));
  const tabs=[["anime","أنمي","film"],["chars","شخصيات","star"],["manga","مانجا","book"],["quotes","اقتباسات","quote"],["titles","ألقاب","crown"],["frames","إطارات","palette"]];
  return `<div class="pad">
    <div class="tabs" style="margin-bottom:12px">${tabs.map(([k,l,ic])=>`<button class="${t===k?'on':''}" onclick="go('favorites',{tab:'${k}'},false);snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    ${t==="anime"?`<div class="col">${S.wiki.anime.filter(a=>S.me.favAnime.includes(a.id)).map(a=>animeRow(a)).join("")||`<div class="col">${((S.wiki&&S.wiki.anime)||[]).slice(0,3).map(a=>animeRow(a)).join("")}</div><div class="tiny fnt center" style="margin-top:8px">(مفضلتك فارغة — هذه مقترحات)</div>`}</div>`:""}
    ${t==="chars"?`<div class="col">${S.wiki.chars.filter(c=>S.me.favChars.includes(c.id)).map(c=>charRow(c)).join("")||((S.wiki&&S.wiki.chars)||[]).slice(0,3).map(c=>charRow(c)).join("")}</div>`:""}
    ${t==="manga"?`<div class="col">${S.wiki.manga.map(a=>mangaRow(a)).join("")}</div>`:""}
    ${t==="quotes"?`<div class="col">${S.wiki.quotes.map(q=>`<div class="card2" style="padding:12px"><p class="xs b">«${esc(q.t)}»</p><div class="tiny fnt" style="margin-top:5px">— ${esc(q.by)}</div></div>`).join("")}</div>`:""}
    ${t==="titles"?`<div class="col">${S.me.titles.map(tt=>`<div class="lstrow"><span class="ico-tile" style="background:var(--grad-gold);color:#fff">${I("crown","i s")}</span>
      <div class="g1"><div class="b xs">${tt}</div><div class="tiny fnt">${S.me.equippedTitle===tt?"مُجهّز حالياً":"متاح للتجهيز"}</div></div>
      <button class="btn ${S.me.equippedTitle===tt?'btn-emerald':'btn-primary'} btn-xs" onclick="S.me.equippedTitle='${tt}';save();render();toast('تم تجهيز «${tt}» ','ok')">${S.me.equippedTitle===tt?" مُجهّز":"تجهيز"}</button></div>`).join("")}
      <button class="btn btn-gold" onclick="go('economy')">${I("coins","i s")} اشترِ ألقاباً جديدة</button></div>`:""}
    ${t==="frames"?`<div class="grid2">${S.frames.map(f=>`<div class="card2 center" style="padding:14px">
      <span class="frame ${f.cls}" style="width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto">${av({...S.me,frame:null},50)}</span>
      <div class="b xs" style="margin-top:9px">${f.n}</div>
      <span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[f.r]}" style="margin-top:4px">${S.ownedFrames.includes(f.id)?"مملوك ":nfmt(f.p)+" عملة"}</span>
      <button class="btn btn-primary btn-xs" style="margin-top:8px;width:100%" onclick="${S.ownedFrames.includes(f.id)?`S.me.frame='${f.id}';save();render();toast('إطار ${f.n} مُفعّل','ok')`:`buyFrame('${f.id}')`}">${S.ownedFrames.includes(f.id)?"تفعيل":"شراء"}</button></div>`).join("")}</div>`:""}
  </div>`;
};
function buyFrame(id){const f=(S.frames||[]).find(x=>x.id===id);if(S.coins<f.p){toast("رصيدك غير كافٍ ("+S.coins+"/"+f.p+")","err");snd("error");return}
  S.coins-=f.p;S.me.coins=S.coins;S.ownedFrames.push(id);S.me.frame=id;save();celebrate("اشتريت إطار «"+f.n+"» ")}
PAGES.savedArticles=()=>{setNav(false);setHdr(backHdr("المقالات والمحفوظات",((S.me&&S.me.saved?S.me.saved.length:0)+(S.savedItems||[]).length)+" عنصر"));
  const sf=S.savF||"all";
  let ps=S.posts.filter(p=>S.me.saved.includes(p.id));if(sf==="post")ps=ps.filter(p=>p.type==="post");else if(sf==="news")ps=ps.filter(p=>p.type==="news");else if(sf==="reel")ps=ps.filter(p=>p.type==="reel");else if(sf==="item")ps=[];
  return `<div class="pad col">
    <div class="chiprow">${[["all","الكل"],["post","منشورات"],["news","أخبار"],["reel","ريلز"],["item","عناصر محفوظة"]].map(([k,l])=>`<button class="chip ${(S.savF||"all")===k?'on':''}" onclick="S.savF='${k}';save();render();snd('tap')">${l}</button>`).join("")}</div>
    ${sf==="all"||sf==="item"?`<div class="secttl"><h3>${I("bookmark","i s")} عناصر محفوظة من الموسوعة والأخبار (${(S.savedItems||[]).length})</h3></div>`+(S.savedItems||[]).length?`<div class="col">${(S.savedItems||[]).map((it,ii)=>`<div class="lstrow"><span class="ico-tile" style="background:${it.type==="anime"?"var(--grad-purple)":"var(--grad-cyan)"};color:#fff">${I(it.type==="anime"?"film":"inbox","i s")}</span><span class="g1 b xs" style="text-align:right">${esc(it.title)}</span><button class="btn btn-sec btn-xs" onclick="${it.type==="anime"?`go('animeDetail',{id:'${it.id}'})`:it.type==="video"?`go('videoDetail',{id:'${it.id}'})`:`go('newsView',{id:'${it.id}'})`}">فتح</button><button class="btn btn-ghost btn-xs" onclick="toggleSaveArticle('${it.id}')">${I("trash","i s")}</button></div>`).join("")}</div>`:`<div class="tiny fnt" style="padding:6px">لا عناصر محفوظة من الموسوعة</div>`:""}
    ${ps.length?ps.map(p=>postCard(p)).join(""):`${sf==="item"?"":`<div class="tiny fnt center" style="padding:10px">لا منشورات محفوظة — احفظها من زر الحفظ في البطاقة</div>`}`}
    ${S.wiki.lore.map(l=>`<button class="lstrow" onclick="go('loreDetail',{id:'${l.id}'})"><span class="ico-tile" style="background:var(--grad-emerald);color:#fff">${I("help","i s")}</span>
      <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(l.t)}</span><span class="tiny fnt">شرح · ${l.r}</span></span>${I("fwd","i s")}</button>`).join("")}
    ${!ps.length&&!S.wiki.lore.length?emptyState("bookmark","لا مقالات محفوظة",""):''}
  </div>`;
};
PAGES.watchHistory=()=>{setNav(false);setHdr(backHdr("سجل المشاهدة الكامل",((S.me&&S.me.history)||[]).length+" عنصر",`<button class="btn btn-sec btn-sm" onclick="clearHistory()">${I("trash","i s")} مسح</button>`));
  if(!((S.me&&S.me.history)||[]).length&&!S.__histSeeded){S.me.history=[{a:"a1",e:87,t:"هجوم العمالقة",at:now()-36e5},{a:"a2",e:47,t:"جوجوتسو كايسن",at:now()-864e5},{a:"a3",e:1119,t:"ون بيس",at:now()}];S.__histSeeded=1;save()}
  const raw=S.me.history;
  const _hb=Date.now();const h=raw.map((x,idx)=>({x,idx})).filter(o=>{const x=o.x;const f=S.histF||"all";if(f==="all"||!x.at)return true;const d=_hb-x.at;return f==="day"?d<864e5:f==="week"?d<7*864e5:d<30*864e5});
  return `<div class="pad col">
    <div class="chiprow">${["الكل","اليوم","هذا الأسبوع","هذا الشهر"].map((g,i)=>`<button class="chip ${(S.histF||"all")===["all","day","week","month"][i]?'on':''}" onclick="S.histF=['all','day','week','month'][${i}];save();render();snd('tap')">${g}</button>`).join("")}</div>
    ${h.map(({x,idx},i)=>{const a=((S.wiki&&S.wiki.anime)||[]).find(y=>y.id===x.a)||{c1:"#7F1D1D",c2:"#EA580C",emo:"clapper",n:x.t};
      return `<div class="lstrow" role="button" tabindex="0" onclick="histGo(S.me.history[${idx}])">
      <span class="ico-tile" style="width:52px;height:38px;border-radius:10px;background:linear-gradient(135deg,${a.c1},${a.c2});">${I(x.type==="story"?"clock":a.emo,"i l")}</span>
      <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(x.t||a.n)}${x.e?" — الحلقة "+x.e:""}</span><span class="tiny fnt">${x.at?ago(x.at):"قبل "+i+" يوم"} · ${x.type==="story"?"قصة قصيرة":"24 دقيقة"}</span></span>
      <button class="iconbtn" style="width:28px;height:28px" onclick="event.stopPropagation();histGo(S.me.history[${idx}])">${I("refresh","i s")}</button>
      <button class="iconbtn" style="width:28px;height:28px" onclick="event.stopPropagation();S.me.history.splice(${idx},1);save();render();toast('أُزيل من السجل','info')">${I("x","i s")}</button></div>`}).join("")}
    ${!h.length?emptyState("clock","السجل فارغ بعد التصفية","غيّر الفترة أو شاهد حلقة جديدة لتظهر هنا"):""}
  </div>`;
};
PAGES.lastWatched=()=>{setNav(false);setHdr(backHdr("آخر ما شاهدته والتقدم","متابعة الحلقات"));
  return `<div class="pad col">
    ${S.me.watching.map((w,i)=>{const pct=Math.round(w.e/w.t*100);const a=S.wiki.anime[i]||{c1:"#7F1D1D",c2:"#EA580C",emo:"clapper"};
      return `<div class="card" style="padding:13px">
      <div class="row" style="gap:11px">
        <span class="ico-tile" style="width:56px;height:70px;border-radius:11px;background:linear-gradient(135deg,${a.c1},${a.c2});">${I(a.emo,"i l")}</span>
        <div class="g1"><div class="b sm">${esc(w.n)}</div><div class="tiny fnt">الموسم ${w.s} · الحلقة ${w.e} من ${w.t}</div>
          <div class="bar" style="margin-top:7px"><i style="width:${pct}%"></i></div>
          <div class="rowb" style="margin-top:5px"><span class="tiny b mono" style="color:var(--accent)">${pct}%</span><span class="tiny fnt">${w.t-w.e} حلقة متبقية</span></div></div></div>
      <div class="row" style="gap:7px;margin-top:11px">
        <button class="btn btn-primary btn-xs g1" onclick="nextEp(${i},this)">${I("play","i s")} الحلقة التالية (${w.e+1})</button>
        <button class="btn btn-sec btn-xs" onclick="markDone(${i})">${I("check","i s")} أنهيت</button>
        <button class="btn btn-sec btn-xs" onclick="go('worlds')">${I("globe","i s")} جماعي</button></div></div>`}).join("")}
    <button class="btn btn-sec" onclick="go('animeWiki')">${I("plus","i s")} أضف أنمي لقائمة المتابعة</button>
  </div>`;
};
function nextEp(i,el){const w=S.me.watching[i];w.e=Math.min(w.t,w.e+1);S.me.episodes++;addXP(20,"حلقة جديدة");save();render();toast("تشغيل الحلقة "+w.e+" من "+w.n+" ","ok")}
function markDone(i){const w=S.me.watching[i];w.e=w.t;addCoins(50,"إكمال عمل");save();render();celebrate("أنهيت "+w.n+" بالكامل ")}
function myPostsPage(kind){
  setNav(false);
  const ttl={posts:"منشوراتي الشخصية",hidden:"المنشورات المخفية",archived:"منشوراتي المؤرشفة",replies:"سجل الردود والتعليقات"}[kind];
  const icn={posts:"msgsq",hidden:"eyeoff",archived:"archive",replies:"chat"}[kind];
  let ps=S.posts.filter(p=>p.authorId==="me");
  const hid=(S.hidden||[]),arc=(S.archived||[]);
  if(kind==="hidden")ps=ps.filter(p=>hid.includes(p.id));else if(kind==="archived")ps=ps.filter(p=>arc.includes(p.id));else ps=ps.filter(p=>!hid.includes(p.id)&&!arc.includes(p.id));
  setHdr(backHdr(ttl,ps.length+" عنصر",`<button class="iconbtn" onclick="go('create')">${I("plus")}</button>`));
  if(kind==="replies"){
    const cs=[];S.posts.forEach(p=>p.comments.forEach(c=>{if(c.userId==="me")cs.push({p,c})}));
    const all=cs;if(!all.length)return `<div class="pad">`+emptyState("chat","لا ردود بعد","علّق على المنشورات لتظهر ردودك هنا")+`</div>`;
    return `<div class="pad col">${all.map(({p,c})=>`<div class="card" style="padding:12px">
      <div class="tiny fnt" style="margin-bottom:7px">رداً على منشور <b style="color:var(--accent)">${esc(u(p.authorId).name)}</b> · ${ago(c.createdAt)}</div>
      <div class="xs" style="padding:9px;border-right:2.5px solid var(--accent);background:var(--surface2);border-radius:0 9px 9px 0">${esc(c.text)}</div>
      <div class="row" style="gap:9px;margin-top:9px"><span class="tiny mut">${IF("heart","i s")} ${c.likes}</span><span class="g1"></span>
        <button class="btn btn-sec btn-xs" onclick="openComments('${p.id}')">${I("fwd","i s")} للمنشور</button>
        <button class="btn btn-ghost btn-xs" onclick="delComment('${p.id}','${c.id}')">${I("trash","i s")}</button></div></div>`).join("")}</div>`;
  }
  return `<div class="pad col">
    <div class="chiprow">${[["posts","منشوراتي","msgsq"],["hidden","المخفية","eyeoff"],["archived","المؤرشفة","archive"],["replies","ردودي","chat"]].map(([k,l,i2])=>`<button class="chip ${kind===k?'on':''}" onclick="go('${k==='posts'?'myPosts':k==='hidden'?'hiddenPosts':k==='archived'?'archivedPosts':'myReplies'}')">${I(i2,"i s")} ${l}</button>`).join("")}</div>
    ${kind==="hidden"?`<div class="card2" style="padding:11px"><div class="row b xs">${I("eyeoff","i s")} أرشيف خاص</div><div class="tiny fnt" style="margin-top:3px">هذه المنشورات غير مرئية للعامة. يمكنك إعادة إظهارها في أي وقت.</div></div>`:""}
    ${kind==="archived"?`<div class="card2" style="padding:11px"><div class="row b xs">${I("archive","i s")} مستودع مغلق</div><div class="tiny fnt" style="margin-top:3px">منشورات قديمة ومغلقة — التعليقات معطّلة.</div></div>`:""}
    ${ps.length?ps.map(p=>`<div style="position:relative">${postCard(p)}
      <div class="row" style="gap:6px;margin:-6px 0 12px">
        ${kind==="posts"?`<button class="btn btn-sec btn-xs" onclick="hidePost('${p.id}')">${I("eyeoff","i s")} إخفاء</button><button class="btn btn-sec btn-xs" onclick="archivePost('${p.id}')">${I("archive","i s")} أرشفة</button>`:""}
        ${kind==="hidden"?`<button class="btn btn-emerald btn-xs" onclick="unhidePost('${p.id}')">${I("eye","i s")} إظهار</button>`:""}
        ${kind==="archived"?`<button class="btn btn-emerald btn-xs" onclick="unarchivePost('${p.id}')">${I("archive","i s")} إلغاء الأرشفة</button>`:""}
        <button class="btn btn-sec btn-xs" onclick="startEditPost('${p.id}')">${I("edit","i s")} تعديل</button>
        <button class="btn btn-danger btn-xs" onclick="delPost('${p.id}')">${I("trash","i s")} حذف</button></div></div>`).join(""):emptyState(icn,"لا "+(kind==="posts"?"منشورات":kind==="hidden"?"منشورات مخفية":kind==="archived"?"منشورات مؤرشفة":"ردود"),"ابدأ بالنشر من الزر +")}
  </div>`;
}
PAGES.myPosts=()=>myPostsPage("posts");
PAGES.hiddenPosts=()=>myPostsPage("hidden");
PAGES.archivedPosts=()=>myPostsPage("archived");
PAGES.myReplies=()=>myPostsPage("replies");
function delPost(id){const idx=(S.posts||[]).findIndex(p=>p.id===id);if(idx<0)return;const snap=S.posts[idx];S.posts.splice(idx,1);S.me.saved=S.me.saved.filter(x=>x!==id);save();render();snd("error");if(window.db&&window.deleteDoc&&window.doc){window.deleteDoc(window.doc(window.db,"posts",id)).catch(e=>console.error(e))}toast("حُذف المنشور ","err",()=>{S.posts.splice(Math.min(idx,(S.posts||[]).length),0,snap);save();render();if(window.db&&window.setDoc&&window.doc){window.setDoc(window.doc(window.db,"posts",id),snap).catch(e=>console.error(e))}toast("استُعيد المنشور ","ok")})}
PAGES.myGroups=()=>{setNav(false);setHdr(backHdr("النقابات والمجموعات",S.communities.filter(c=>c.joined).length+" منضم إليها"));
  return `<div class="pad col">
    <div class="grid3">${[["shield",S.communities.filter(c=>c.joined&&c.type==="guild").length,"نقابة"],["users",S.communities.filter(c=>c.joined&&c.type==="group").length,"مجموعة"],["globe",S.communities.filter(c=>c.joined&&c.type!=="guild"&&c.type!=="group").length,"أخرى"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    ${S.communities.filter(c=>c.joined).map(c=>communityRow(c)).join("")||emptyState("shield","لست منضماً لأي نقابة","استكشف النقابات من تبويب الدردشة")}
    <div class="secttl"><h3>${I("sparkles","i s")} نقابات مقترحة</h3></div>
    ${S.communities.filter(c=>!c.joined).map(c=>communityRow(c)).join("")}
    <div class="secttl"><h3>${I("users","i s")} مجموعاتي (قروبات)</h3><button class="more" onclick="go('groups')">الكل</button></div>
    ${S.groups.filter(g=>g.joined).map(g=>`<button class="lstrow" onclick="go('groupRoom',{id:'${g.id}'})"><span class="ico-tile" style="background:linear-gradient(135deg,${g.c1},${g.c2});color:#fff">${I(g.icon,"i l")}</span><span class="g1" style="text-align:right"><span class="b xs">${esc(g.name)}</span><span class="tiny fnt">${(g.members||[]).length} أعضاء · ${esc(g.privacy)}</span></span>${I("fwd","i s")}</button>`).join("")||`<div class="tiny fnt mut" style="padding:6px 0">لا قروبات بعد</div>`}
    <div class="secttl"><h3>${I("globe","i s")} عوالمي</h3><button class="more" onclick="go('worlds')">الكل</button></div>
    ${S.worlds.filter(w=>w.joined).map(w=>`<button class="lstrow" onclick="go('worldRoom',{id:'${w.id}'})"><span class="ico-tile" style="background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"i l")}</span><span class="g1" style="text-align:right"><span class="b xs">${esc(w.name)}</span><span class="tiny fnt">${esc(w.theme)} · ${nfmt(w.members)} عضو</span></span>${I("fwd","i s")}</button>`).join("")||`<div class="tiny fnt mut" style="padding:6px 0">لا عوالم منضم إليها</div>`}
    <div class="grid3" style="margin-top:6px">
      <button class="btn btn-gold btn-sm" onclick="go('createGuild')">${I("plus","i s")} نقابة</button>
      <button class="btn btn-primary btn-sm" onclick="go('createGroup')">${I("plus","i s")} قروب</button>
      <button class="btn btn-sec btn-sm" onclick="go('createWorld')">${I("plus","i s")} عالم</button></div>
  </div>`;
};
PAGES.myChannels=()=>{setNav(false);setHdr(backHdr("قنوات الدردشة الحالية","كل القنوات المنضم إليها"));
  const chs=[];S.communities.filter(c=>c.joined).forEach(c=>c.channels.forEach(ch=>chs.push({c,ch})));
  const cf=S.chF||"all";const list=chs.filter(({ch})=>cf==="all"||(cf==="un"?(ch.unread||0)>0:cf==="pin"?!!ch.pinned:!!ch.muted));
  return `<div class="pad col">
    <div class="chiprow">${[["all","الكل"],["un","غير مقروءة"],["pin","مثبّتة"],["mute","صامتة"]].map(([k,l])=>`<button class="chip ${(S.chF||"all")===k?'on':''}" onclick="S.chF='${k}';save();render();snd('tap')">${l}</button>`).join("")}</div>
    ${list.length?list.map(({c,ch})=>`<button class="lstrow" onclick="go('communityChannel',{id:'${c.id}',ch:'${ch.id}'})">
      <span class="ico-tile" style="background:linear-gradient(135deg,${c.c1},${c.c2});color:#fff">${I("hash","i s")}</span>
      <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(ch.name)}</span><span class="tiny fnt">${esc(c.name)} · ${esc(ch.topic)}</span></span>
      ${ch.unread?`<span class="badge b-red mono">${ch.unread}</span>`:""}${I("fwd","i s")}</button>`).join(""):emptyState("globe","لا قنوات","انضم لمجتمع أولاً")}
    ${S.communities.filter(c=>c.type==="channel").map(c=>communityRow(c)).join("")}
  </div>`;
};

/* ============================================================
   15) الهوية والأمان: البطاقة، الأمان، الخصوصية
   ============================================================ */
const CARDFONTS=[["Inter Sans","system-ui,-apple-system,'Segoe UI',sans-serif"],["Playfair Display","Georgia,'Times New Roman',serif"],["JetBrains Mono","'Courier New',monospace"],["Space Grotesk","'Trebuchet MS',Tahoma,sans-serif"]];
const CARDSTYLES=[["default","كلاسيك أنمي بلاك","#7F1D1D","#EA580C",16],["cyber","Cyber futuristic","#0F172A","#06B6D4",12],["organic","Organic rounded","#365314","#84CC16",26],["manga","Manga Cloud","#831843","#F472B6",20]];
function cardTh(){const st=(CARDSTYLES||[]).find(x=>x[0]===(S.cardStyle||"default"))||CARDSTYLES[0];const fo=(CARDFONTS||[]).find(x=>x[0]===(S.cardFont||"Inter Sans"))||CARDFONTS[0];return{c1:st[2],c2:st[3],rad:st[4],ff:fo[1],name:st[1]}}
function setCardStyle(id){S.cardStyle=id;save();const st=(CARDSTYLES||[]).find(x=>x[0]===id);render();toast("نمط البطاقة: "+(st?st[1]:id)+" ","ok")}
function setCardFont(nm){S.cardFont=nm;save();render();toast("خط البطاقة: "+nm+" ","ok")}
PAGES.accountCard=()=>{
  const m=S.me;setNav(false);const t=S.cardTab||"card";
  setHdr(backHdr("الحساب والبطاقة الرقمية","هويتك في أنمي بلاك",`<button class="iconbtn" onclick="go('qrCard')">${I("qr")}</button>`));
  return `<div class="pad col">
    <div class="tabs">${[["card","البطاقة","user"],["levels","المستويات","award"],["privacy","الخصوصية","lock"],["verification","التوثيق","check"],["security","الأمان","shield"],["activity","النشاط","clock"]].map(([k,l,ic])=>`
      <button class="${t===k?'on':''}" onclick="go('accountCard',{t:'${k}'},false);S.cardTab='${k}';${k==='privacy'?"go('privacySettings')":k==='security'?"go('security')":k==='levels'?"go('levels')":"save();render()"}">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    ${t==="card"?`
    ${(()=>{const th=cardTh();return `<div class="card" style="padding:0;overflow:hidden;border-radius:${th.rad}px;border-color:${th.c2}55;font-family:${th.ff};box-shadow:0 8px 34px ${th.c2}2e">
      <div class="art-bg" style="--c1:${th.c1};--c2:${th.c2};height:88px;position:relative;border-radius:${th.rad}px ${th.rad}px 0 0">`})()}
        <span class="badge b-gold" style="position:absolute;top:9px;right:11px">${I("crown","i s")} بطاقة أوتاكو</span>
        <span class="badge b-gray mono" style="position:absolute;top:9px;left:11px">#${m.id.toUpperCase().slice(0,6)}</span></div>
      <div style="padding:0 14px 15px;margin-top:-32px">
        <div class="row" style="gap:11px">${av(m,72,true)}
          <div class="g1" style="margin-top:26px"><div class="row" style="gap:5px"><span class="bb">${esc(m.name)}</span>${vbadge(m)}</div>
          <div class="tiny fnt mono">@${esc(m.username)}</div></div></div>
        <div class="grid4" style="margin-top:13px">
          ${[["flame",m.level,"المستوى"],["trend",nfmt(m.reputation),"سمعة"],["coins",nfmt(S.coins),"عملة"],["star",S.stars,"نجمة"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
        <div class="card2" style="padding:10px;margin-top:11px"><div class="rowb tiny b"><span>XP للمستوى ${m.level+1}</span><span class="mono" style="color:var(--accent)">${nfmt(m.xp)}/${nfmt(m.xpNext)}</span></div>
          <div class="bar" style="margin-top:5px"><i style="width:${Math.min(100,m.xp/m.xpNext*100)}%"></i></div></div>
        <div class="row wrap" style="gap:6px;margin-top:11px"><span class="pill">${I("shield","i s")} ${esc(m.role)}</span>${m.equippedTitle?`<span class="pill">${I("crown","i s")} ${esc(m.equippedTitle)}</span>`:""}<span class="pill">${I("calendar","i s")} ${new Date(m.joined).toLocaleDateString("ar")}</span></div>
        <div class="grid2" style="margin-top:12px">
          <button class="btn btn-primary btn-sm" onclick="go('qrCard')">${I("qr","i s")} بطاقة QR</button>
          <button class="btn btn-sec btn-sm" onclick="openSheet('shareProfile')">${I("share","i s")} مشاركة</button></div>
      </div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("info","i s")} معلومات الحساب</div>
      <div class="col" style="margin-top:10px">${[["mail","البريد",m.email,"تغيير"],["phone","الجوال",m.phone,"تحقق"],["user","اسم المستخدم","@"+m.username,"تعديل"],["clock","تاريخ الانضمام",new Date(m.joined).toLocaleDateString("ar"),""]].map(([ic,l,v,act])=>`
        <div class="rowb"><div class="row" style="gap:9px"><span style="color:var(--muted)">${I(ic,"i s")}</span><div><div class="tiny fnt">${l}</div><div class="xs b mono">${esc(v)}</div></div></div>
        ${act?`<button class="btn btn-sec btn-xs" onclick="${l==='البريد'?"go('emailChange')":l==='الجوال'?"go('phoneVerify')":"go('editProfile')"}">${act}</button>`:""}</div>`).join("")}</div></div>
    <div class="grid2">
      <button class="btn btn-sec" onclick="go('security')">${I("shield","i s")} الأمان</button>
      <button class="btn btn-sec" onclick="go('privacySettings')">${I("lock","i s")} الخصوصية</button>
      <button class="btn btn-sec" onclick="exportMyData()">${I("download","i s")} تصدير بياناتي</button>
      <button class="btn btn-danger" onclick="go('deleteAccount')">${I("trash","i s")} حذف الحساب</button></div>
    `:`<div class="card2 center" style="padding:26px">${I("chevdown","xl")}<div class="xs b" style="margin-top:8px">اختر تبويباً من الأعلى</div></div>`}
  </div>`;
};
PAGES.qrCard=()=>{const m=S.me;setNav(false);setHdr(backHdr("بطاقتي الرقمية","امسحها لإضافة صديق"));
  return `<div class="pad col center">
    <div class="card" style="padding:20px;background:linear-gradient(135deg,rgba(34,211,238,.1),transparent)">
      <div style="position:relative">${av(m,84,true)}</div>
      <div class="bb" style="margin-top:11px">${esc(m.name)}</div><div class="tiny fnt mono">@${esc(m.username)}</div>
      ${S.me.privacy.whoSeesLevel!=="nobody"?`<div class="row" style="gap:5px;justify-content:center;margin:8px 0">${lvlBadge(m)}${roleBadge(m)}${m.equippedTitle?`<span class="badge b-gold">${esc(m.equippedTitle)}</span>`:""}</div>`:`<div class="tiny fnt center" style="margin:8px 0">الرتبة مخفية خصوصياً</div>`}
      <div class="qr" style="margin:14px auto"></div>
      <div class="mono tiny fnt" style="letter-spacing:1px">ANIMEBLACK://USER/${m.username.toUpperCase()}</div>
      <div class="grid2" style="margin-top:15px">
        <button class="btn btn-primary btn-sm" onclick="copyTxt('ANIMEBLACK://USER/${m.username.toUpperCase()}')">${I("copy","i s")} نسخ الرابط</button>
        <button class="btn btn-sec btn-sm" onclick="openSheet('shareProfile')">${I("share","i s")} مشاركة</button>
        <button class="btn btn-sec btn-sm" onclick="saveCardSVG()">${I("download","i s")} حفظ البطاقة SVG</button>
        <button class="btn btn-sec btn-sm" onclick="scanQR()">${I("camera","i s")} امسح بطاقة</button></div>
    </div>
    <div class="card2" style="padding:12px;text-align:right"><div class="b xs">${I("info","i s")} كيف تستخدمها؟</div>
      <ul class="tiny mut" style="margin:7px 18px 0"><li>اعرض بطاقتك لصديقك ليمسحها</li><li>امسح بطاقات الآخرين لإضافتهم</li><li>شارك الرابط في أي منصة</li></ul></div>
  </div>`;
};
function scanQR(){
  $("#ovl").innerHTML=`<div class="ov glass" onclick="if(event.target===this)closeOvl()">
    <div class="modal center" style="padding:22px">
      <div style="width:190px;height:190px;margin:0 auto;border-radius:18px;background:#000;position:relative;overflow:hidden;border:3px solid var(--accent)">
        <div class="scan" style="position:absolute;top:14px;left:12px;right:12px"></div>
        <div style="position:absolute;inset:14px;display:flex;align-items:center;justify-content:center;color:var(--muted)">${I("camera","xl")}</div></div>
      <div class="bb" style="margin-top:14px">جارٍ المسح...</div>
      <div class="tiny fnt">وجّه الكاميرا نحو بطاقة QR</div>
      <div class="grid2" style="margin-top:15px"><button class="btn btn-primary" onclick="scanSuccess()">مسح بطاقة</button>
        <button class="btn btn-ghost" onclick="closeOvl()">إلغاء</button></div>
    </div></div>`;
}
function closeOvl(){$("#ovl").innerHTML=""}
PAGES.security=()=>{
  const m=S.me;setNav(false);setHdr(backHdr("إعدادات الأمان والتوثيق","المصادقة الثنائية والجلسات"));
  return `<div class="pad col">
    <div class="card" style="padding:14px">
      <div class="rowb"><div class="row" style="gap:10px"><span class="ico-tile" style="background:${S.twoFactorStep==='verified'?'var(--grad-emerald)':'var(--grad-fire)'};color:#fff">${I("shield","i s")}</span>
        <div><div class="b sm">المصادقة الثنائية 2FA</div><div class="tiny fnt">${S.twoFactorStep==="verified"?"مفعّلة ":"غير مفعّلة — ننصح بتفعيلها"}</div></div></div>
        <span class="sw ${S.twoFactorStep==='verified'?'on':''}" onclick="toggle2FA(this)"></span></div>
      ${S.twoFactorStep!=="verified"?`<button class="btn btn-primary btn-lg" style="margin-top:12px" onclick="go('twofa')">${I("qr","i s")} تفعيل الآن</button>`:`
        <div class="chiprow" style="margin-top:12px">${[["authenticator","تطبيق مصادقة","phone"],["email","البريد","mail"],["sms","رسالة SMS","msgsq"]].map(([k,l,ic])=>`
          <button class="chip ${m.security.twoFactorType===k?'on':''}" onclick="S.me.security.twoFactorType='${k}';save();render();toast('طريقة 2FA: ${l}','ok')">${I(ic,"i s")} ${l}</button>`).join("")}</div>
        <div class="grid2" style="margin-top:9px"><button class="btn btn-sec btn-sm" onclick="openSheet('backupCodes')">${I("key","i s")} رموز احتياطية</button>
          <button class="btn btn-sec btn-sm" onclick="go('twofa')">${I("refresh","i s")} إعادة الضبط</button></div>`}
    </div>
    <div class="card" style="padding:14px"><div class="b sm">${I("key","i s")} كلمة المرور</div>
      <div class="tiny fnt" style="margin-top:4px">آخر تغيير: قبل ${Math.max(1,Math.round((now()-(S.pwdChangedAt||(now()-45*864e5)))/864e5))} يوماً · قوية جداً</div>
      <div class="grid2" style="margin-top:11px"><button class="btn btn-sec btn-sm" onclick="S.recoveryStep='new_password';go('forgot')">${I("edit","i s")} تغيير</button>
        <button class="btn btn-sec btn-sm" onclick="S.recoveryStep='input';go('forgot')">${I("help","i s")} استعادة</button></div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("link","i s")} الحسابات المرتبطة</div>
      <div class="col" style="margin-top:10px">${[["google","Google","var(--grad-cyan)"],["apple","Apple","var(--surface3)"],["email","البريد الإلكتروني","var(--grad-fire)"],["phone","رقم الجوال","var(--grad-emerald)"]].map(([k,l,g])=>{
        const linked=!!(Object.assign({google:true,email:true,apple:false,phone:false},S.me.linked||{}))[k];
        return `<div class="rowb"><div class="row" style="gap:9px"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:${g};color:#fff">${I(k==="email"?"mail":k==="phone"?"phone":"globe","i s")}</span>
          <div><div class="b xs">${l}</div><div class="tiny fnt">${linked?"مرتبط ":"غير مرتبط"}</div></div></div>
          <button class="btn ${linked?'btn-ghost':'btn-primary'} btn-xs" onclick="toggleLinked('${k}','${l}')">${linked?"إلغاء":"ربط"}</button></div>`}).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="rowb"><div class="b sm">${I("phone","i s")} الجلسات النشطة</div><button class="tiny b" style="color:var(--rose)" onclick="S.me.security.sessions=['هذا الجهاز'];save();render();toast('تم إنهاء كل الجلسات الأخرى','ok')">إنهاء الكل</button></div>
      <div class="col" style="margin-top:10px">${m.security.sessions.map((s,i)=>`<div class="rowb">
        <div class="row" style="gap:9px"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:var(--surface3);color:var(--accent)">${I(i===0?"phone":"screen","i s")}</span>
        <div><div class="b xs">${esc(s)}</div><div class="tiny fnt">${i===0?"الجلسة الحالية":"آخر نشاط "+ago(now()-(1+strHash(s)%9)*864e5)} · IP 10.0.0.${i+4}</div></div></div>
        ${i===0?`<span class="badge b-emerald">حالية</span>`:`<button class="btn btn-ghost btn-xs" onclick="S.me.security.sessions.splice(${i},1);save();render();toast('أُنهِيت الجلسة','info')">${I("logout","i s")}</button>`}</div>`).join("")}</div></div>
    <button class="lstrow card2" style="padding:11px;margin-bottom:12px" onclick="go('permissions')"><span class="ico-tile" style="background:var(--grad-gold);color:#fff">${I("key","i s")}</span><span class="g1 b xs" style="text-align:right">أذونات التطبيق الحقيقية<span class="tiny fnt" style="display:block">إشعارات · موقع · كاميرا · حافظة</span></span>${I("fwd","i s")}</button>
    <div class="card" style="padding:14px"><div class="b sm">${I("alert","i s")} سجل الأمان</div>
      <div class="col" style="margin-top:10px">${S.securityLogs.map((l,li)=>`<div class="rowb">
        <div class="row" style="gap:8px"><span class="badge b-${l.sev==='high'?'red':l.sev==='med'?'gold':'gray'}">${l.sev==='high'?"عالي":l.sev==='med'?"متوسط":"منخفض"}</span>
        <div><div class="tiny b">${esc(l.t)}</div><div class="tiny fnt mono">${esc(l.ip)} · ${ago(l.at)}</div></div></div>
        <button class="btn btn-ghost btn-xs" onclick="openSheet('secEvent',${li})">${I("info","i s")}</button></div>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("lock","i s")} قفل التطبيق</div>
      <div class="col" style="margin-top:10px">
        ${[["fp","قفل ببصمة الإصبع"],["pin","قفل برمز PIN"],["hide","إخفاء المحادثات المقفلة"],["alert","تنبيه عند دخول جديد"]].map(([k,l])=>`
        <div class="rowb"><span class="xs b">${l}</span><span class="sw ${(S.appLock||{})[k]?'on':''}" onclick="appLockToggle('${k}')"></span></div>`).join("")}</div></div>
    <button class="btn btn-danger" onclick="go('deleteAccount')">${I("trash","i s")} حذف الحساب نهائياً</button>
  </div>`;
};
function toggle2FA(el){
  if(S.twoFactorStep==="verified"){S.twoFactorStep="idle";el.classList.remove("on");toast("تم تعطيل المصادقة الثنائية","info");save();render();return}
  go("twofa");
}
PAGES.emailChange=()=>{setNav(false);setHdr(backHdr("تغيير البريد الإلكتروني","يتطلب تأكيداً"));
  return `<div class="pad col">
    <div class="card" style="padding:14px"><div class="lbl">البريد الحالي</div><input class="inp mono" value="${esc(S.me.email)}" disabled style="opacity:.6">
      <div style="height:11px"></div><div class="lbl">البريد الجديد</div><input class="inp mono" id="ne" placeholder="new@mail.com" dir="ltr">
      <div style="height:11px"></div><div class="lbl">كلمة المرور للتأكيد</div><input class="inp" type="password" placeholder="••••••••"></div>
    <button class="btn btn-primary btn-lg" onclick="const v=$('#ne').value;if(!/^[^@]+@[^@]+\.[^@]+$/.test(v)){toast('بريد غير صحيح','err');return}S.emailStep='sent';save();render();toast('أرسلنا رابط التأكيد ','ok');snd('success')">إرسال رابط التأكيد</button>
    ${S.emailStep==="sent"?`<div class="card2 center" style="padding:16px"><div style="font-size:38px"></div><div class="b sm" style="margin-top:7px">تحقق من بريدك</div>
      <div class="tiny fnt" style="margin:5px 0 12px">أرسلنا رابط تأكيد إلى <b class="mono">${esc($("#ne")?$("#ne").value:"البريد الجديد")}</b></div>
      <div class="grid2"><button class="btn btn-emerald" onclick="S.emailStep='verified';save();render();celebrate('تم تأكيد البريد الجديد ')">لقد أكدت </button>
        <button class="btn btn-sec" onclick="flushOffQ();toast('أُعيد إرسال الرسائل المعلّقة ','ok')">${I("refresh","i s")} إعادة</button></div></div>`:""}
  </div>`;
};
PAGES.phoneVerify=()=>{setNav(false);setHdr(backHdr("التحقق من رقم الجوال",S.phoneStep==="verified"?"موثّق ":"غير موثّق"));
  return `<div class="pad col">
    <div class="card" style="padding:14px;text-align:center">
      <span style="width:62px;height:62px;border-radius:50%;background:${S.phoneStep==='verified'?'rgba(16,185,129,.15)':'rgba(245,158,11,.15)'};display:flex;align-items:center;justify-content:center;margin:0 auto 11px;color:${S.phoneStep==='verified'?'var(--emerald)':'var(--gold)'}">${I(S.phoneStep==="verified"?"check":"phone","xl")}</span>
      <div class="bb">${S.phoneStep==="verified"?"رقمك موثّق":"رقمك غير موثّق"}</div>
      <div class="tiny fnt mono" style="margin-top:4px" dir="ltr">${esc(S.me.phone)}</div></div>
    ${S.phoneStep!=="verified"?`
      <div class="card" style="padding:14px"><div class="lbl">أدخل رقم جوالك</div>
        <input class="inp mono" id="ph" value="${esc(S.me.phone)}" dir="ltr">
        <button class="btn btn-primary btn-lg" style="margin-top:12px" onclick="S.phoneStep='otp';save();render();toast('أرسلنا رمز تحقق بالرسائل ','ok');snd('success')">إرسال رمز التحقق</button></div>`
     :S.phoneStep==="otp"?`
      <div class="card" style="padding:14px"><div class="tiny mut center">الرمز التجريبي: <b class="mono" style="color:var(--accent)">${S.otpCode}</b></div>
        <div class="row" style="gap:6px;justify-content:center;margin-top:11px" id="otpbox">${[0,1,2,3,4,5].map(i=>`<input class="inp mono center" maxlength="1" style="width:42px;padding:11px 0;font-size:19px;font-weight:900" data-i="${i}" oninput="otpNext(this)" onkeydown="otpBack(event,this)">`).join("")}</div>
        <button class="btn btn-primary btn-lg" style="margin-top:13px" onclick="if(otpVal()===S.otpCode){S.phoneStep='verified';save();render();celebrate('تم توثيق رقمك ')}else{toast('رمز خاطئ','err');snd('error')}">تحقق</button></div>`
     :`<div class="grid2"><button class="btn btn-sec" onclick="S.phoneStep='unverified';save();render()">${I("edit","i s")} تغيير الرقم</button>
        <button class="btn btn-danger" onclick="S.phoneStep='unverified';save();render();toast('أُلغي توثيق الرقم','info')">إلغاء التوثيق</button></div>`}
    <div class="card2" style="padding:12px"><div class="b xs">${I("info","i s")} لماذا نوثّق الرقم؟</div>
      <ul class="tiny mut" style="margin:7px 18px 0"><li>استعادة الحساب عند فقدان كلمة المرور</li><li>تفعيل المصادقة الثنائية عبر SMS</li><li>الحصول على شارة التوثيق</li></ul></div>
  </div>`;
};
PAGES.privacySettings=()=>{
  const m=S.me;setNav(false);setHdr(backHdr("إعدادات الخصوصية","من يرى بياناتك"));
  const opts=[["whoSeesCoins","من يرى رصيد العملات",[["everyone","الجميع"],["friends","الأصدقاء"],["nobody","أنا فقط"]],"coins"],
   ["whoSeesLevel","من يرى مستواي ورتبتي",[["everyone","الجميع"],["friends","الأصدقاء"],["nobody","أنا فقط"]],"award"],
   ["whoSeesActivity","من يرى نشاطي",[["everyone","الجميع"],["friends","الأصدقاء"],["nobody","أنا فقط"]],"clock"],
   ["allowDM","من يستطيع مراسلتي",[["everyone","الجميع"],["followers","المتابعون"],["friends","الأصدقاء"],["nobody","لا أحد"]],"chat"]];
  return `<div class="pad col">
    <div class="card" style="padding:14px"><div class="b sm">${I("lock","i s")} الحساب</div>
      <div class="col" style="margin-top:11px">
        ${[["privateAccount","حساب خاص","لا يرى منشوراتك إلا من توافق عليه"],["showOnline","إظهار حالتي المتصلة","يظهر للآخرين أنك متصل الآن"]].map(([k,l,d])=>`
        <div class="rowb"><div class="g1"><div class="b xs">${l}</div><div class="tiny fnt">${d}</div></div><span class="sw ${m.privacy[k]?'on':''}" onclick="privToggle('${k}','${l}',this)"></span></div>`).join("")}</div></div>
    ${opts.map(([k,l,vs,ic])=>`<div class="card" style="padding:14px"><div class="row b sm" style="gap:8px">${I(ic,"i s")} ${l}</div>
      <div class="chiprow wrap" style="margin-top:10px">${vs.map(([v,lb])=>`<button class="chip ${m.privacy[k]===v?'on':''}" onclick="S.me.privacy.${k}='${v}';save();render();toast('${l}: ${lb}','ok');snd('tap')">${I(v==='nobody'?'eyeoff':v==='friends'?'users':'globe',"i s")} ${lb}</button>`).join("")}</div></div>`).join("")}
    <div class="card" style="padding:14px"><div class="b sm">${I("ban","i s")} الحظر والقيود</div>
      <div class="col" style="margin-top:10px">${(S.blocked||[]).length?S.blocked.map(b=>`<div class="rowb"><div class="row" style="gap:8px">${av(u(b),30)}<div class="b xs">${esc(u(b).name)}</div></div>
        <button class="btn btn-ghost btn-xs" onclick="S.blocked=S.blocked.filter(x=>x!=='${b}');save();render();toast('أُلغي الحظر','info')">إلغاء الحظر</button></div>`).join(""):`<div class="tiny fnt center" style="padding:10px">لم تحظر أحداً</div>`}
        <button class="btn btn-sec btn-sm" onclick="go('search')">${I("plus","i s")} حظر مستخدم</button></div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("eye","i s")} من رأى ملفي الشخصي</div>
      <div class="col" style="margin-top:10px">${(S.users||[]).slice(0,4).map(x=>`<div class="lstrow" style="padding:8px" onclick="openProfile('${x.id}')">${av(x,34)}
        <div class="g1"><div class="b tiny">${esc(x.name)}</div><div class="tiny fnt">${ago(now()-(1+strHash(x.id+"v")%70)*36e5)}</div></div>${I("fwd","i s")}</div>`).join("")}</div></div>
    <div class="grid2"><button class="btn btn-sec" onclick="exportMyData()">${I("download","i s")} تصدير بياناتي</button>
      <button class="btn btn-ghost" onclick="go('privacyPolicy')">${I("file","i s")} سياسة الخصوصية</button></div>
  </div>`;
};
PAGES.deleteAccount=()=>{setNav(false);setHdr(backHdr("حذف الحساب","لا يمكن التراجع بعد ٣٠ يوماً"));
  return `<div class="pad col">
    <div class="card" style="padding:16px;text-align:center;border-color:rgba(244,63,94,.4);background:linear-gradient(135deg,rgba(244,63,94,.1),transparent)">
      <span style="width:64px;height:64px;border-radius:50%;background:rgba(244,63,94,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 11px;color:var(--rose)">${I("alert","xl")}</span>
      <div class="bb" style="font-size:16px;color:var(--rose)">تحذير: إجراء نهائي</div>
      <p class="xs mut" style="margin-top:7px">حذف حسابك سيزيل كل منشوراتك ومحادثاتك وعملاتك وشاراتك. لديك ٣٠ يوماً للتراجع قبل الحذف النهائي.</p>
      ${S.deletionDaysLeft?`<div class="badge b-rose" style="margin-top:11px;font-size:11px;padding:6px 12px">الحذف مجدول بعد ${S.deletionDaysLeft} يوماً</div>
        <button class="btn btn-emerald btn-lg" style="margin-top:12px" onclick="S.deletionDaysLeft=null;save();render();celebrate('تم إلغاء حذف الحساب ')">${I("check","i s")} تراجع عن الحذف</button>`:""}</div>
    <div class="card" style="padding:14px"><div class="b sm">ماذا سيُحذف؟</div>
      <div class="col" style="margin-top:9px">${[["msgsq",S.posts.filter(p=>p.authorId==="me").length+" منشور"],["chat",(S.chats||[]).length+" محادثة"],["coins",nfmt(S.coins)+" عملة سوداء"],["award",S.achievements.filter(a=>a.got).length+" إنجاز"],["shield",S.communities.filter(c=>c.joined).length+" نقابة"]].map(([ic,v])=>`
        <div class="row" style="gap:9px"><span style="color:var(--rose)">${I(ic,"i s")}</span><span class="xs b">${v}</span></div>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("help","i s")} بدائل بدلاً من الحذف</div>
      <div class="col" style="margin-top:9px">
        <button class="lstrow" style="padding:9px" onclick="S.me.privacy.privateAccount=true;save();toast('تم تحويل حسابك إلى خاص ','ok')"><span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("lock","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">اجعل حسابك خاصاً</span><span class="tiny fnt" style="display:block">يختفي محتواك دون حذفه</span></span></button>
        <button class="lstrow" style="padding:9px" onclick="go('hubSettings')"><span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("bell","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">أوقف الإشعارات مؤقتاً</span><span class="tiny fnt" style="display:block">استرح من التنبيهات</span></span></button>
        <button class="lstrow" style="padding:9px" onclick="downloadData()"><span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("download","i s")}</span><span class="g1" style="text-align:right"><span class="b xs">نزّل بياناتك</span><span class="tiny fnt" style="display:block">احتفظ بنسخة قبل الحذف</span></span></button></div></div>
    <label class="lbl">اكتب «احذف حسابي» للتأكيد</label><input class="inp" id="dacc" placeholder="احذف حسابي">
    <button class="btn btn-danger btn-lg" onclick="if($('#dacc').value.trim()!=='احذف حسابي'){toast('اكتب نص التأكيد بالضبط','err');return}S.deletionDaysLeft=30;save();render();toast('جُدول الحذف بعد ٣٠ يوماً — يمكنك التراجع','err');snd('error')">تأكيد الحذف</button>
    <button class="btn btn-ghost" onclick="back()">إلغاء</button>
  </div>`;
};
function privToggle(k,l,el){S.me.privacy[k]=!S.me.privacy[k];el.classList.toggle("on");save();snd("tap");toast(l+": "+(S.me.privacy[k]?"مفعّل":"معطّل"),"info")}

/* ============================================================
   16) المظهر + المهام والفعاليات + المستويات والشارات
   ============================================================ */
const THEMES=[
 ["fire","لهب قرمزي","#22D3EE","#FF7A00","#E60000"],
 ["cosmic","نيون كوني","#A855F7","#06B6D4","#7C3AED"],
 ["sakura","أزهار الكرز","#EC4899","#FDA4AF","#DB2777"],
 ["emerald","زمردي","#10B981","#34D399","#059669"],
 ["gold","ذهبي ملكي","#F59E0B","#FDE68A","#EA580C"],
 ["ocean","محيطي","#3B82F6","#0EA5E9","#1D4ED8"]
];
function applyTheme(id){
  const t=(THEMES||[]).find(x=>x[0]===id)||THEMES[0];S.themeAcc=t[0];
  document.documentElement.style.setProperty("--accent",t[2]);
  document.documentElement.style.setProperty("--accent2",t[3]);
  document.documentElement.style.setProperty("--accent3",t[4]);
  document.documentElement.style.setProperty("--grad-fire",`linear-gradient(135deg,${t[3]} 0%,${t[2]} 50%,${t[4]} 100%)`);
  save();
}
PAGES.appearance=()=>{setNav(false);setHdr(backHdr("المظهر","الوضع والألوان والخطوط"));
  return `<div class="pad col">
    <div class="card" style="padding:14px"><div class="b sm">${I("sun","i s")} الوضع</div>
      <div class="grid3" style="margin-top:11px">
        ${[["dark","ليلي","moon"],["light","نهاري","sun"],["auto","تلقائي","refresh"]].map(([k,l,ic])=>`
        <button class="card2 center" style="padding:14px 6px;border-color:${S.theme===k?'var(--accent)':'var(--line2)'}" onclick="setTheme('${k}')">
          <span style="color:${S.theme===k?'var(--accent)':'var(--muted)'};display:flex;justify-content:center">${I(ic,"l")}</span>
          <span class="tiny b" style="display:block;margin-top:6px">${l}</span>
          ${S.theme===k?'<span class="badge b-emerald" style="margin-top:4px">مفعّل </span>':""}</button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("palette","i s")} لون التمييز</div>
      <div class="grid3" style="margin-top:11px;gap:8px">${THEMES.map(([id,l,c1,c2,c3])=>`
        <button class="center" style="padding:9px 4px;border-radius:13px;border:2px solid ${S.themeAcc===id?'#fff':'var(--line2)'};background:var(--surface2)" onclick="applyTheme('${id}');render();toast('اللون: ${l}','ok');snd('success')">
          <span style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,${c2},${c1},${c3});display:block;margin:0 auto;box-shadow:0 4px 14px ${c1}55"></span>
          <span class="tiny b" style="display:block;margin-top:6px">${l}</span></button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("eye","i s")} سهولة القراءة</div>
      <div class="col" style="margin-top:11px">
        ${[["contrast","تباين عالٍ","ألوان أوضح للنصوص"],["motion","الحركات والانتقالات","تأثيرات التنقل والظهور"],["hapticToast","تنبيه اللمس","إظهار رسالة عند كل لمسة"],["sound","الأصوات","نغمات الضغط والنجاح"]].map(([k,l,d])=>`
        <div class="rowb"><div class="g1"><div class="b xs">${l}</div><div class="tiny fnt">${d}</div></div>
          <span class="sw ${(k==='contrast'?S.contrast:S[k])?'on':''}" onclick="uiToggle('${k}',this)"></span></div>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("max","i s")} حجم البطاقات</div>
      <div class="chiprow wrap" style="margin-top:10px">${[["sm","صغيرة"],["md","متوسطة"],["lg","كبيرة"]].map(([k,l])=>`
        <button class="chip ${S.cardSize===k?'on':''}" onclick="S.cardSize='${k}';save();render();toast('حجم البطاقات: ${l}','ok')">${l}</button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("grid","i s")} نمط العرض</div>
      <div class="chiprow wrap" style="margin-top:10px">${[["grid","شبكة","grid"],["list","قائمة","list"],["compact","مضغوط","layers"]].map(([k,l,ic])=>`
        <button class="chip ${S.viewType===k?'on':''}" onclick="S.viewType='${k}';save();render();toast('نمط العرض: ${l}','ok')">${I(ic,"i s")} ${l}</button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("globe","i s")} اللغة والاتجاه</div>
      <div class="chiprow wrap" style="margin-top:10px">
        <button class="chip ${S.lang==='ar'?'on':''}" onclick="S.lang='ar';document.documentElement.lang='ar';document.documentElement.dir='rtl';save();render();toast('اللغة: العربية','ok')">العربية (RTL)</button>
        <button class="chip ${S.lang==='en'?'on':''}" onclick="S.lang='en';document.documentElement.lang='en';document.documentElement.dir='ltr';save();render();toast('Language: English','ok')">English (LTR)</button></div></div>
    <button class="btn btn-ghost" onclick="S.theme='dark';S.themeAcc='fire';S.cardSize='md';S.viewType='grid';S.contrast=false;document.body.className='';applyTheme('fire');save();render();toast('أُعيد ضبط المظهر','info')">${I("refresh","i s")} إعادة ضبط المظهر</button>
  </div>`;
};
function setTheme(k){
  if(k==="auto"){k=window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";toast("تلقائي: "+(k==="light"?"نهاري":"ليلي"),"info")}
  S.theme=k;document.body.className=k==="light"?"light":"";save();render();snd("success");
}
function uiToggle(k,el){
  if(k==="contrast"){S.contrast=!S.contrast;document.documentElement.style.filter=S.contrast?"contrast(1.18) saturate(1.1)":"";if(el)el.classList.toggle("on");save();toast("التباين: "+(S.contrast?"عالٍ":"عادي"),"info");return}
  S[k]=!S[k];if(el)el.classList.toggle("on");save();snd("tap");
  toast(({sound:"الأصوات",hapticToast:"تنبيه اللمس",motion:"الحركات",haptic:"الاهتزاز"})[k]+": "+(S[k]?"مفعّل":"معطّل"),"info");
}
PAGES.activity=()=>{setNav(false);const m=S.me;setHdr(backHdr("المهام والفعاليات ونظام الرتب","اكسب XP وعملات"));
  const dailyDone=m.quests.filter(q=>q.p>=q.max).length;
  return `<div class="pad col">
    <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(245,158,11,.13),transparent)">
      <div class="rowb"><div><div class="bb" style="font-size:16px">المهام اليومية</div><div class="tiny fnt">${dailyDone} من ${((m&&m.quests)||[]).length} مكتملة · تنتهي خلال ${24-new Date().getHours()} ساعة</div></div>
        <span class="ico-tile" style="width:46px;height:46px;border-radius:15px;background:var(--grad-gold);color:#fff">${I("target","l")}</span></div>
      <div class="bar" style="margin-top:11px"><i style="width:${dailyDone/((m&&m.quests)||[]).length*100}%;background:var(--grad-gold)"></i></div>
      <div class="col" style="margin-top:12px">${m.quests.map(q=>`
        <div class="row" style="gap:9px"><span class="ico-tile" style="width:32px;height:32px;border-radius:10px;background:${q.p>=q.max?'var(--grad-emerald)':'var(--surface3)'};color:${q.p>=q.max?'#fff':'var(--gold)'}">${I(q.p>=q.max?"check":q.ic,"i s")}</span>
          <div class="g1"><div class="tiny b">${esc(q.t)}</div><div class="bar" style="height:4px;margin-top:4px"><i style="width:${q.p/q.max*100}%"></i></div></div>
          <span class="badge b-gold mono">+${q.r}</span>
          <button class="btn ${q.p>=q.max?'btn-emerald':'btn-sec'} btn-xs" onclick="${q.p>=q.max?`claimQuest('${q.id}')`:`simulateQuest('${q.id}')`}">${q.p>=q.max?"استلم":"نفّذ"}</button></div>`).join("")}</div>
      <button class="btn btn-gold btn-lg" style="margin-top:12px" onclick="claimAll()">استلم كل المكافآت (${m.quests.filter(q=>q.p>=q.max).reduce((a,q)=>a+q.r,0)} عملة)</button>
    </div>
    <div class="secttl"><h3>${I("calendar","i s")} فعاليات قادمة</h3>${canMod()?`<button class="more" onclick="go('createEvent')">أنشئ فعالية</button>`:`<button class="more" onclick="go('eventsHub')">الكل</button>`}</div>
    <div class="col">${[["مهرجان الأنمي الصيفي","١٥ سبتمبر · جوائز ٥٠٠٠ عملة","gift"],["تحدي الرسم الأسبوعي","ينتهي الجمعة · ٨٨ مشارك","palette"],["ليلة مشاهدة جماعية","الخميس ٩ مساءً · ٤٢ مهتم","tv"],["بطولة النقابات","٢٠ سبتمبر · ١٢ نقابة","swords"]].map(([t,d,ic])=>`
      <div class="card" style="padding:12px"><div class="row" style="gap:10px">
        <span class="ico-tile" style="background:var(--grad-purple);color:#fff">${I(ic,"i s")}</span>
        <div class="g1"><div class="b xs">${t}</div><div class="tiny fnt">${d}</div></div></div>
        <div class="row" style="gap:7px;margin-top:10px">
          <button class="btn btn-primary btn-xs g1" onclick="eventBtn(this)">اهتمام</button>
          <button class="btn btn-sec btn-xs" onclick="shareEvent('${t}','${d}')">${I("share","i s")}</button>
          <button class="btn btn-sec btn-xs" onclick="addCal('${t}','${d}')">${I("calendar","i s")}</button></div></div>`).join("")}</div>
    <div class="secttl"><h3>${I("trend","i s")} نظام الرتب</h3><button class="more" onclick="go('levels')">الشارات</button></div>
    <div class="card" style="padding:14px">
      <div class="rowb"><div><div class="b sm">رتبتك الحالية: <span class="grad-txt">محارب</span></div><div class="tiny fnt">سمعة ${nfmt(m.reputation)} · المستوى ${m.level}</div></div>
        <span style="font-size:30px"></span></div>
      <div class="col" style="margin-top:12px">${S.levels.map(l=>{const got=m.level>=l.l;const cur=m.level>=l.l&&(S.levels.find(x=>x.l>m.level)||{l:999}).l>l.l;
        return `<div class="row" style="gap:10px;opacity:${got?1:.45}">
        ${BDG(l.ic,got?"legendary":"locked",36)}
        <div class="g1"><div class="row" style="gap:5px"><span class="b xs">${l.n}</span><span class="badge b-gray mono">LV ${l.l}</span>${cur?'<span class="badge b-red">أنت هنا</span>':""}</div>
          <div class="tiny fnt">${nfmt(l.xp)} XP مطلوبة</div></div>
        ${got?`<span style="color:var(--emerald)">${I("check","i s")}</span>`:`<span style="color:var(--faint)">${I("lock","i s")}</span>`}</div>`}).join("")}</div></div>
    <div class="secttl"><h3>${I("clock","i s")} سجل النشاط</h3></div>
    <div class="card" style="padding:13px"><div class="col">${S.activityLogs.map(l=>`
      <div class="rowb"><div class="row" style="gap:8px"><span style="color:var(--accent)">${I("chevup","i s")}</span><div><div class="tiny b">${esc(l.t)}</div><div class="tiny fnt mono">${esc(l.ip)} · ${ago(l.at)}</div></div></div></div>`).join("")}</div></div>
  </div>`;
};
function simulateQuest(id){const q=((S.me&&S.me.quests)||[]).find(x=>x.id===id);questProgress(id,1);toast("تقدّم في: "+q.t+" ("+q.p+"/"+q.max+")","info");render()}
function claimQuest(id){const q=((S.me&&S.me.quests)||[]).find(x=>x.id===id);if(q.claimed){toast("استلمتها مسبقاً","info");return}q.claimed=true;addCoins(q.r,"مكافأة: "+q.t);celebrate("استلمت "+q.r+" عملة ");save();render()}
function claimAll(){let t=0;S.me.quests.forEach(q=>{if(q.p>=q.max&&!q.claimed){q.claimed=true;t+=q.r}});if(!t){toast("لا مكافآت جاهزة للاستلام","info");return}addCoins(t);celebrate("استلمت "+t+" عملة من كل المهام ")}
PAGES.levels=()=>{const m=S.me;setNav(false);setHdr(backHdr("المستويات والشارات والألقاب",m.level+" مستوى · "+(S.badgesList||[]).length+" شارة"));
  const t=S.params.tab||"badges";
  return `<div class="pad">
    <div class="tabs" style="margin-bottom:12px">${[["badges","الشارات","award"],["titles","الألقاب","crown"],["levels","المستويات","trend"],["passport","جواز الأوتاكو","map"]].map(([k,l,ic])=>`
      <button class="${t===k?'on':''}" onclick="go('levels',{tab:'${k}'},false)">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    <div class="card" style="padding:13px;margin-bottom:12px;background:linear-gradient(135deg,rgba(255,122,0,.1),transparent)">
      <div class="rowb"><div><div class="b sm">${I("trend","i s")} مسار المستوى والجوائز</div><div class="tiny fnt">كل ٥ مستويات مكافأة تُستلم مرة واحدة</div></div><span class="badge b-gold mono">مستوى ${m.level}</span></div>
      <div class="col" style="margin-top:10px">${[5,10,15,20,25,30].map(lv=>{const got=m.level>=lv;const cl=(S.lvlClaimed||[]).includes(lv);return `<div class="row" style="gap:9px"><span class="ico-tile" style="width:30px;height:30px;border-radius:10px;background:${got?"var(--grad-fire)":"var(--surface3)"};color:${got?"#fff":"var(--muted)"}">${I("award","i s")}</span>
        <div class="g1"><div class="tiny b">مستوى ${lv}</div><div class="tiny fnt">${lv*100} عملة + إطار حصري</div></div>
        ${got?`<button class="btn ${cl?"btn-sec":"btn-primary"} btn-xs" ${cl?"disabled":""} onclick="claimLevel(${lv})">${cl?"مُستلم":"استلام"}</button>`:`<span class="badge b-gray mono">مقفل</span>`}</div>`}).join("")}</div></div>
    ${t==="badges"?`<div class="grid2">${S.badgesList.map(b=>{const got=m.badges.includes(b.id);
      return `<div class="card center" style="padding:16px 10px;opacity:${got?1:.45};border-color:${got?'rgba(255,122,0,.4)':'var(--line)'}">
        ${BDG(b.ic,got?b.r:"locked",64)}
        <div class="b sm" style="margin-top:10px">${b.n}</div><div class="tiny fnt">${b.d}</div>
        <span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[b.r]}" style="margin-top:7px">${{legendary:'أسطوري',epic:'ملحمي',rare:'نادر',common:'شائع'}[b.r]}</span>
        <button class="btn ${got?'btn-sec':'btn-primary'} btn-xs" style="margin-top:9px;width:100%" onclick="${got?`equipBadge('${b.id}')`:`toast('مقفلة — ${b.d}','err');snd('error')`}">${got?"تجهيز":`${I("lock","i s")} مقفلة`}</button></div>`}).join("")}</div>`:""}
    ${t==="titles"?`<div class="col">${[...m.titles,"أسطورة الشونين","ملك القراصنة","نينجا الظل","قائد النقابة"].map((tt,i)=>{const own=i<((m&&m.titles)||[]).length;
      return `<div class="lstrow"><span class="ico-tile" style="background:${own?'var(--grad-gold)':'var(--surface3)'};color:#fff">${I("crown","i s")}</span>
        <div class="g1"><div class="b xs">${tt}</div><div class="tiny fnt">${own?(m.equippedTitle===tt?"مُجهّز حالياً":"مملوك"):"متاح في المتجر بـ "+(500+i*200)+" عملة"}</div></div>
        <button class="btn ${own?(m.equippedTitle===tt?'btn-emerald':'btn-primary'):'btn-gold'} btn-xs" onclick="${own?`equipTitle('${tt}')`:`buyTitle('${tt}',${500+i*200})`}">${own?(m.equippedTitle===tt?" مُجهّز":"تجهيز"):"شراء"}</button></div>`}).join("")}</div>`:""}
    ${t==="levels"?`<div class="col">
      <div class="card" style="padding:14px"><div class="rowb"><div><div class="bb grad-txt" style="font-size:22px">المستوى ${m.level}</div><div class="tiny fnt">${nfmt(m.xp)} / ${nfmt(m.xpNext)} XP للمستوى التالي</div></div><span style="font-size:34px"></span></div>
        <div class="bar" style="height:9px;margin-top:11px"><i style="width:${Math.min(100,m.xp/m.xpNext*100)}%"></i></div>
        <div class="grid3" style="margin-top:12px">${[["flame",nfmt(m.reputation),"سمعة"],["award",S.badgesList.filter(b=>m.badges.includes(b.id)).length,"شارة"],["trophy",S.achievements.filter(a=>a.got).length,"إنجاز"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div></div>
      ${S.levels.map(l=>`<div class="lstrow" style="opacity:${m.level>=l.l?1:.5}">
        ${BDG(l.ic,m.level>=l.l?"legendary":"locked",38)}
        <div class="g1"><div class="row" style="gap:5px"><span class="b xs">${l.n}</span><span class="badge b-gray mono">LV ${l.l}</span></div><div class="tiny fnt">${nfmt(l.xp)} XP · مكافآت: إطارات وألقاب حصرية</div></div>
        ${m.level>=l.l?`<span class="badge b-emerald">مفتوح </span>`:`<span class="badge b-gray">مقفل</span>`}</div>`).join("")}
      <div class="card2" style="padding:12px"><div class="b xs">${I("zap","i s")} كيف تكسب XP؟</div>
        <div class="col" style="margin-top:8px">${[["نشر منشور",25],["تعليق",8],["مشاهدة حلقة",20],["متابعة شخص",10],["إكمال مهمة",50],["بدء بث",100]].map(([a,x])=>`
          <div class="rowb"><span class="tiny b">${a}</span><span class="badge b-gold mono">+${x} XP</span></div>`).join("")}</div></div></div>`:""}
    ${t==="passport"?`<div class="col">
      <div class="card" style="padding:16px;background:linear-gradient(135deg,#1a1206,#2a1a08);border-color:rgba(245,158,11,.35)">
        <div class="rowb"><div><div class="tiny fnt mono">OTAKU PASSPORT</div><div class="bb" style="font-size:15px;color:#FBBF24">جواز الأوتاكو</div></div><span style="font-size:28px"></span></div>
        <div class="div" style="background:rgba(245,158,11,.25)"></div>
        <div class="row" style="gap:11px">${av(m,56,true)}<div class="g1"><div class="b sm" style="color:#FBBF24">${esc(m.name)}</div><div class="tiny fnt mono">@${esc(m.username)} · No. ${m.id.toUpperCase().slice(0,8)}</div></div></div>
        <div class="grid3" style="margin-top:13px">${[["الرتبة","محارب"],["الدولة","أنمي لاند"],["الإصدار","2025"]].map(([k,v])=>`<div><div class="tiny fnt">${k}</div><div class="xs b" style="color:#FBBF24">${v}</div></div>`).join("")}</div>
        <div class="div" style="background:rgba(245,158,11,.25)"></div>
        <div class="b xs" style="color:#FBBF24">الأختام المجمعة (${(S.passport||[]).length}/5)</div>
        <div class="chiprow wrap" style="margin-top:9px">${[["recon"," فيلق الاستطلاع"],["samurai"," الساموراي"],["akatsuki_guild"," الأكاتسكي"],["mappa"," MAPPA"],["otaku_king"," ملك الأوتاكو"]].map(([id,l])=>`
          <span class="chip ${S.passport.includes(id)?'on':''}" ${S.passport.includes(id)?'':'style="opacity:.4"'}>${l}</span>`).join("")}</div>
        <button class="btn btn-gold btn-lg" style="margin-top:13px" onclick="collectStamp()">${I("award","i s")} اجمع ختماً جديداً</button></div>
      <div class="card2" style="padding:12px"><div class="b xs">ما هو جواز الأوتاكو؟</div><div class="tiny fnt" style="margin-top:5px">نظام تجميع أختام من الأنشطة المختلفة — كل ختم يفتح مكافآت حصرية.</div></div></div>`:""}
  </div>`;
};
function equipBadge(id){const b=(S.badgesList||[]).find(x=>x.id===id);if(!S.me.badges.includes(id))S.me.badges.push(id);toast("تم تجهيز شارة «"+b.n+"» ","ok");celebrate("شارة مجهزة: "+b.n);save();render()}
function equipTitle(t){S.me.equippedTitle=t;if(!S.me.titles.includes(t))S.me.titles.push(t);save();render();toast("اللقب المجهّز: "+t+" ","ok");snd("success")}
function buyTitle(t,p){if(S.coins<p){toast("رصيدك غير كافٍ ("+S.coins+"/"+p+")","err");snd("error");go('economy');return}S.coins-=p;S.me.coins=S.coins;S.me.titles.push(t);S.me.equippedTitle=t;save();celebrate("اشتريت لقب «"+t+"» ")}
function collectStamp(){const all=["recon","samurai","akatsuki_guild","mappa","otaku_king"];const nxt=all.find(x=>!S.passport.includes(x));if(!nxt){toast("جمعت كل الأختام ","ok");return}S.passport.push(nxt);save();celebrate("ختم جديد في جوازك: "+nxt+" ");render()}

/* ============================================================
   17) الاقتصاد: المتجر، السوق، الحقيبة، الاشتراكات، الإحصاءات
   ============================================================ */
PAGES.economy=()=>{
  const t=S.params.tab||S.econTab||"store";S.econTab=t;setNav(false);
  setHdr(backHdr("متجر الاقتصاد والإطارات",nfmt(S.coins)+" عملة · "+S.stars+" نجمة",`${coinChip()} ${starChip()}`));
  const tabs=[["store","المتجر","coins"],["marketplace","السوق","globe"],["inventory","الحقيبة","gift"],["theme","المظاهر","palette"],["subs","الاشتراكات","crown"],["stats","الإحصاءات","chart"]];
  return `<div class="pad">
    <div class="card" style="padding:13px;margin-bottom:12px;background:linear-gradient(135deg,rgba(245,158,11,.12),rgba(168,85,247,.07))">
      <div class="row" style="gap:11px"><span class="ico-tile" style="width:46px;height:46px;border-radius:15px;background:var(--grad-gold);color:#fff">${I("wallet","l")}</span>
        <div class="g1"><div class="bb mono" style="font-size:18px">${nfmt(S.coins)} <span class="tiny fnt">عملة سوداء</span></div>
        <div class="tiny fnt">${S.stars} نجمة مشعة · اشتراك ${S.plus?"Plus ":"مجاني"}</div></div>
        <button class="btn btn-gold btn-sm" onclick="go('economy',{tab:'store'})">${I("plus","i s")} اشحن</button></div>
      <div class="grid4" style="margin-top:11px">${[["gift","صندوق حظ",1],["globe","السوق",(S.market||[]).length],["trophy","ألقاب",((S.me&&S.me.titles)||[]).length],["palette","إطارات",(S.ownedFrames||[]).length]].map(([ic,l,v])=>`
        <button class="card2 stat" onclick="go('economy',{tab:'${l==='صندوق حظ'?'store':l==='السوق'?'marketplace':l==='ألقاب'?'theme':'inventory'}'})">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></button>`).join("")}</div>
    </div>
    <div class="tabs" style="margin-bottom:12px">${tabs.map(([k,l,ic])=>`<button class="${t===k?'on':''}" onclick="go('economy',{tab:'${k}'},false);snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    ${econTab(t)}
  </div>`;
};
function econTab(t){
  if(t==="store")return `<div class="col">
    <div class="secttl"><h3>${I("coins","i s")} شحن العملات</h3></div>
    <div class="grid2">${S.storeItems.filter(i=>i.type==="coins"||i.type==="plus"||i.type==="stars").map(i=>`
      <div class="card" style="padding:13px;text-align:center;position:relative;border-color:${i.best?'rgba(245,158,11,.5)':'var(--line)'}">
        ${i.best?'<span class="badge b-gold" style="position:absolute;top:8px;left:8px">الأفضل قيمة</span>':""}
        <span class="ico-tile" style="width:48px;height:48px;border-radius:16px;background:var(--grad-gold);color:#fff;margin:0 auto">${I(i.ic,"l")}</span>
        <div class="b sm" style="margin-top:9px">${i.n}</div><div class="tiny fnt mono">${i.p}</div>
        <button class="btn btn-gold btn-xs" style="margin-top:9px;width:100%" onclick="buyItem('${i.id}')">شراء</button></div>`).join("")}</div>
    <div class="secttl"><h3>${I("gift","i s")} صناديق الحظ</h3></div>
    ${S.storeItems.filter(i=>i.type==="chest").map(i=>`<div class="card" style="padding:13px">
      <div class="row" style="gap:11px"><span class="ico-tile" style="width:46px;height:46px;background:var(--grad-purple);color:#fff;color:var(--gold);line-height:0;display:flex">${I("gift","i l")}</span>
        <div class="g1"><div class="b sm">${i.n}</div><div class="tiny fnt">فرصة للحصول على إطار أسطوري · ٣٥٪ شارة نادرة · ٣٠٪ عملات</div></div>
        <button class="btn btn-purple btn-sm" onclick="buyItem('${i.id}')">${i.p}</button></div>
      <div class="row wrap" style="gap:5px;margin-top:9px">${["أسطوري ٥٪","ملحمي ١٥٪","نادر ٣٥٪","عادي ٤٥٪"].map((r,i2)=>`<span class="badge ${['b-gold','b-purple','b-cyan','b-gray'][i2]}">${r}</span>`).join("")}</div></div>`).join("")}
    <div class="secttl"><h3>${I("plussq","i s")} بطاقات الأنمي</h3><span class="badge b-gold mono">${((S.me&&S.me.ownedCards)||[]).length}/${CARDS.length}</span></div>
    <div class="grid2">${CARDS.map(cd=>`<div class="card" style="padding:12px;text-align:center">
      <div style="display:flex;justify-content:center">${BDG(cd.emo,cd.r,46)}</div>
      <div class="b xs" style="margin-top:6px;line-height:1.4">${cd.n}</div>
      <div class="tiny fnt" style="margin-top:3px">${cd.d}</div>
      <span class="badge b-${{legendary:"gold",epic:"purple",rare:"cyan"}[cd.r]}" style="margin-top:6px">${RAR[cd.r]}</span>
      ${S.me.ownedCards.includes(cd.id)?`<div class="badge b-emerald" style="margin-top:6px">مملوكة </div>`:`<button class="btn btn-gold btn-xs" style="margin-top:7px;width:100%" onclick="buyCard('${cd.id}')">${nfmt(cd.p)} عملة</button>`}
    </div>`).join("")}</div>
    <div class="secttl"><h3>${I("award","i s")} الشارات والألقاب</h3></div>
    <div class="grid2">${S.storeItems.filter(i=>i.type==="badge"||i.type==="title"||i.type==="cover").map(i=>`
      <div class="card2 center" style="padding:13px"><span class="ico-tile" style="width:42px;height:42px;border-radius:14px;background:var(--grad-fire);color:#fff;margin:0 auto">${I(i.ic,"i s")}</span>
        <div class="b tiny" style="margin-top:8px">${i.n}</div><div class="tiny fnt mono">${i.p}</div>
        <button class="btn btn-primary btn-xs" style="margin-top:8px;width:100%" onclick="buyItem('${i.id}')">شراء</button></div>`).join("")}</div>
    <div class="secttl"><h3>${I("palette","i s")} الإطارات الحية</h3></div>
    <div class="grid2">${S.frames.map(f=>`<div class="card2 center" style="padding:13px">
      <span class="frame ${f.cls}" style="width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto">${av({...S.me,frame:null},46)}</span>
      <div class="b tiny" style="margin-top:8px">${f.n}</div><div class="tiny fnt">${f.desc}</div>
      <span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[f.r]}" style="margin-top:5px">${f.r}</span>
      <button class="btn ${S.ownedFrames.includes(f.id)?'btn-emerald':'btn-gold'} btn-xs" style="margin-top:8px;width:100%" onclick="${S.ownedFrames.includes(f.id)?`S.me.frame='${f.id}';save();render();toast('إطار ${f.n} مُفعّل','ok')`:`buyFrame('${f.id}')`}">${S.ownedFrames.includes(f.id)?"تفعيل ":nfmt(f.p)+" عملة"}</button></div>`).join("")}</div></div>`;
  if(t==="marketplace")return `<div class="col">
    <div class="chiprow">${[["all","الكل"],["auction","مزادات"],["swap","مبادلات"],["buy","شراء مباشر"]].map(([k,l],i)=>`<button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(x=>x.classList.remove('on'));this.classList.add('on');toast('تصفية: ${l}','info')">${l}</button>`).join("")}</div>
    ${S.market.map(m=>`<div class="card" style="padding:13px">
      <div class="row" style="gap:11px">
        <span class="ico-tile" style="width:48px;height:48px;border-radius:15px;background:${{legendary:'var(--grad-gold)',epic:'var(--grad-purple)',rare:'var(--grad-cyan)'}[m.r]};color:#fff">${I("star","l")}</span>
        <div class="g1"><div class="row" style="gap:5px"><span class="b sm">${esc(m.n)}</span><span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan'}[m.r]}">${m.r}</span></div>
          <div class="tiny fnt">البائع: ${esc(m.seller.name)} · ${m.mode==="auction"?nfmt(m.bids)+" مزايدة":m.mode==="swap"?"مبادلة":"شراء مباشر"}</div></div>
        <div class="center"><div class="bb mono" style="color:var(--gold)">${nfmt(m.price)}</div><div class="tiny fnt">عملة</div></div></div>
      ${m.mode==="auction"?`<div class="rowb tiny" style="margin-top:9px"><span class="fnt">${I("clock","i s")} ينتهي ${ago(m.endsAt-now()+864e5*2).replace("الآن","")}</span><span class="bar g1" style="margin:0 9px"><i style="width:${rnd(20,85)}%"></i></span></div>`:""}
      <div class="row" style="gap:7px;margin-top:11px">
        ${m.mode==="auction"?`<button class="btn btn-gold btn-xs g1" onclick="bid('${m.id}')">${I("trend","i s")} زاود +50</button>`:""}
        ${m.mode==="swap"?`<button class="btn btn-purple btn-xs g1" onclick="swap('${m.id}')">${I("refresh","i s")} اعرض مبادلة</button>`:""}
        ${m.mode==="buy"?`<button class="btn btn-primary btn-xs g1" onclick="buyMarket('${m.id}')">${I("coins","i s")} اشترِ الآن</button>`:""}
        <button class="btn btn-sec btn-xs" onclick="openProfile('${m.seller.id}')">${I("user","i s")} البائع</button>
        <button class="btn btn-ghost btn-xs" onclick="reportUser('${m.seller.id}')">${I("flag","i s")}</button></div></div>`).join("")}
    <button class="btn btn-primary btn-lg" onclick="openSheet('sellSheet')">${I("plus","i s")} اعرض غرضاً للبيع</button></div>`;
  if(t==="inventory")return `<div class="col">
    <div class="chiprow">${["الكل","إطارات","شارات","ألقاب","صناديق"].map((g,i)=>`<button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(x=>x.classList.remove('on'));this.classList.add('on');toast('تصفية: ${g}','info')">${g}</button>`).join("")}</div>
    ${((S.me&&S.me.inventory)||[]).length?S.me.inventory.map(i=>`<div class="lstrow">
      <span class="ico-tile" style="background:${{legendary:'var(--grad-gold)',epic:'var(--grad-purple)',rare:'var(--grad-cyan)',common:'var(--surface3)'}[i.r]};color:#fff">${I(i.ic,"i s")}</span>
      <div class="g1"><div class="row" style="gap:5px"><span class="b xs">${i.n}</span><span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[i.r]}">${i.r}</span></div>
        <div class="tiny fnt">النوع: ${i.type}</div></div>
      <button class="btn btn-primary btn-xs" onclick="equipItem('${i.id}')">تجهيز</button>
      <button class="btn btn-sec btn-xs" onclick="openSheet('itemMenu','${i.id}')">${I("more","i s")}</button>
      <button class="btn btn-ghost btn-xs" onclick="openSheet('sellSheet','${i.id}')">${I("tag","i s")}</button></div>`).join(""):emptyState("gift","حقيبتك فارغة","اشترِ من المتجر أو افتح صناديق الحظ")}
    <div class="grid2"><button class="btn btn-gold" onclick="go('economy',{tab:'store'})">${I("coins","i s")} المتجر</button>
      <button class="btn btn-sec" onclick="go('economy',{tab:'marketplace'})">${I("globe","i s")} السوق</button></div></div>`;
  if(t==="theme")return `<div class="col">
    <div class="card" style="padding:14px;margin-bottom:12px"><div class="b sm">${I("pen","i s")} نمط البطاقة الرقمية</div>
      <div class="grid2" style="margin-top:10px;gap:8px">${CARDSTYLES.map(st=>`<button class="card2 center" style="padding:10px 6px;border-color:${(S.cardStyle||"default")===st[0]?"var(--accent)":"var(--line2)"}" onclick="setCardStyle('${st[0]}')"><span style="display:block;width:100%;height:26px;border-radius:${st[4]}px;background:linear-gradient(135deg,${st[2]},${st[3]})"></span><span class="tiny b" style="margin-top:6px;display:block">${st[1]}</span></button>`).join("")}</div>
      <div class="tiny fnt" style="margin-top:8px">يُطبَّق فوراً على بطاقتك في «الحساب والبطاقة الرقمية» — أنماط الأصل: Cyber futuristic · Organic rounded · Manga Cloud</div></div>
    <div class="card" style="padding:14px;margin-bottom:12px"><div class="b sm">${I("code","i s")} خط البطاقة</div>
      <div class="chiprow" style="margin-top:9px">${CARDFONTS.map(f=>`<button class="chip ${(S.cardFont||"Inter Sans")===f[0]?"on":""}" style="font-family:${f[1]}" onclick="setCardFont('${f[0]}')">${f[0]}</button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("palette","i s")} سمات التطبيق</div>
      <div class="grid2" style="margin-top:11px;gap:9px">${THEMES.map(([id,l,c1,c2,c3])=>`
        <button class="card2" style="padding:12px;border-color:${S.themeAcc===id?'var(--accent)':'var(--line2)'};text-align:center" onclick="applyTheme('${id}');render();toast('سمة ${l} مُطبّقة','ok')">
          <span style="width:100%;height:34px;border-radius:9px;background:linear-gradient(135deg,${c2},${c1},${c3});display:block"></span>
          <span class="tiny b" style="display:block;margin-top:7px">${l}</span>
          ${S.themeAcc===id?'<span class="badge b-emerald" style="margin-top:4px">مفعّلة </span>':'<span class="badge b-gray" style="margin-top:4px">مجانية</span>'}</button>`).join("")}</div></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("image","i s")} خلفيات البروفايل</div>
      <div class="grid3" style="margin-top:11px">${[["#7F1D1D","#EA580C"],["#3B0764","#A855F7"],["#064E3B","#10B981"],["#0C4A6E","#0EA5E9"],["#831843","#DB2777"],["#111827","#374151"]].map(c=>`
        <button style="height:56px;border-radius:12px;background:linear-gradient(135deg,${c[0]},${c[1]});border:2px solid var(--line2)" onclick="S.me.cover='${c}';save();toast('تم تغيير الخلفية ','ok');snd('success')"></button>`).join("")}</div>
      <button class="btn btn-sec btn-sm" style="margin-top:11px;width:100%" onclick="changeCover()">${I("refresh","i s")} خلفية عشوائية</button></div>
    <div class="card" style="padding:14px"><div class="b sm">${I("flame","i s")} تأثيرات حية</div>
      <div class="col" style="margin-top:11px">${[["sharingan","شارينغان","",300],["ki-aura","هالة الكي","",450],["sakura-leaves","أوراق الساكورا","",250],["glitch","خلل رقمي","",600],["fire-sparks","شرر اللهب","",380]].map(([id,l,e,p])=>`
        <div class="rowb"><div class="row" style="gap:9px"><span style="font-size:21px">${e}</span><div><div class="b xs">${l}</div><div class="tiny fnt">تأثير متحرك على ملفك</div></div></div>
        <button class="btn btn-gold btn-xs" onclick="if(S.coins<${p}){toast('رصيدك غير كافٍ','err');snd('error');return}S.coins-=${p};S.me.coins=S.coins;S.me.effect='${id}';save();celebrate('فعّلت تأثير ${l} ${e}')">${nfmt(p)} عملة</button></div>`).join("")}</div></div></div>`;
  if(t==="subs")return `<div class="col">
    ${[["free","المجاني",0,["كل الميزات الأساسية","٣ صناديق حظ شهرياً","إعلانات محدودة"],false],
       ["plus","AnimeBlack Plus",7.99,["بدون إعلانات نهائياً","إطار Plus حصري متحرك","١٠ صناديق حظ شهرياً","شارة Plus بنفسجية","أولوية في الدعم","تحليلات متقدمة"],!!S.plus],
       ["elite","Elite Otaku",19.99,["كل مزايا Plus","إطار ذهبي أسطوري","٣٠ صندوق شهرياً","دخول مبكر للميزات","دعم VIP فوري","لقب Elite حصري"],false]].map(([id,n,p,f,cur])=>`
      <div class="card" style="padding:15px;border-color:${id==='plus'?'rgba(168,85,247,.5)':'var(--line)'};background:${id==='plus'?'linear-gradient(135deg,rgba(168,85,247,.09),transparent)':'none'}">
        ${id==="plus"?'<span class="badge b-purple">الأكثر شيوعاً</span>':""}
        <div class="rowb" style="margin-top:8px"><div class="bb" style="font-size:16px">${n}</div>
          <div class="center"><div class="bb mono grad-txt" style="font-size:19px">${p?`$${p}`:"مجاني"}</div>${p?'<div class="tiny fnt">شهرياً</div>':""}</div></div>
        <div class="col" style="margin-top:11px">${f.map(x=>`<div class="row" style="gap:7px"><span style="color:var(--emerald)">${I("check","i s")}</span><span class="xs">${x}</span></div>`).join("")}</div>
        <button class="btn ${cur?'btn-emerald':id==='plus'?'btn-purple':'btn-sec'} btn-lg" style="margin-top:12px" onclick="${cur?`toast('مشترك حالياً ','ok')`:`subscribe('${id}',${p})`}">${cur?"مشترك ":"اشترك الآن"}</button></div>`).join("")}
    <div class="card2" style="padding:12px"><div class="b xs">${I("info","i s")} عن الاشتراكات</div><div class="tiny fnt" style="margin-top:5px">يمكنك الإلغاء في أي وقت. الاشتراك يتجدد تلقائياً. (محاكاة — لا دفع حقيقي في هذه النسخة)</div></div>
  </div>`;
  return `<div class="col">
    <div class="grid2">${[["coins",nfmt(S.coins),"إجمالي العملات"],["star",S.stars,"النجوم"],["trend",nfmt(1240),"أرباح هذا الشهر"],["gift",nfmt(340),"مصاريف"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    <div class="card" style="padding:13px"><div class="b sm">${I("chart","i s")} حركة الرصيد (٣٠ يوم)</div>${svgChart([220,280,240,340,310,420,390,510,470,580,540,660,610,720])}</div>
    <div class="card" style="padding:13px"><div class="b sm">${I("clock","i s")} آخر العمليات</div>
      <div class="col" style="margin-top:10px">${[["مكافأة مهمة يومية",120,"in"],["شراء إطار ذهبي",-1200,"out"],["هدية من @reem_otaku",250,"in"],["فتح صندوق حظ",-220,"out"],["مكافأة ترقية",500,"in"]].map(([t,v,k])=>`
        <div class="rowb"><div class="row" style="gap:8px"><span class="ico-tile" style="width:28px;height:28px;border-radius:9px;background:${k==='in'?'rgba(16,185,129,.15)':'rgba(244,63,94,.15)'};color:${k==='in'?'var(--emerald)':'var(--rose)'}">${I(k==='in'?"download":"upload","i s")}</span>
        <div><div class="tiny b">${t}</div><div class="tiny fnt">${ago(now()-rnd(1,200)*36e5)}</div></div></div>
        <span class="b sm mono" style="color:${k==='in'?'var(--emerald)':'var(--rose)'}">${v>0?"+":""}${nfmt(v)}</span></div>`).join("")}</div></div>
    <div class="grid2"><button class="btn btn-gold" onclick="addCoins(500,'مكافأة تجريبية')">${I("gift","i s")} +٥٠٠ عملة (تجربة)</button>
      <button class="btn btn-sec" onclick="toast('تم تصدير كشف الحساب ','ok')">${I("download","i s")} كشف حساب</button></div>
  </div>`;
}
function buyItem(id){
  const i=(S.storeItems||[]).find(x=>x.id===id);if(!i)return;
  if(i.cur==="USD"){toast("شراء "+i.n+" بـ "+i.p+" (محاكاة دفع) ","ok");snd("success");if(i.type==="coins")addCoins(i.value||(i.n.includes("٥٠٠")?500:1200),"شحن");if(i.type==="plus")subscribe("plus",7.99);if(i.type==="subs")subscribe(i.id==="s0"?"free":i.id==="s3b"?"ultimate":"premium",parseFloat(i.p)||0);if(i.type==="stars")addStars(i.value||100,"شحن");return}
  const price=parseInt(i.p);
  if(S.coins<price){toast("رصيدك غير كافٍ — تحتاج "+price+" وعندك "+S.coins,"err");snd("error");return}
  S.coins-=price;S.me.coins=S.coins;
  if(i.type==="chest"){const r=Math.random();const got=r<.05?{n:"إطار التنين الأسطوري",type:"frame",r:"legendary",ic:"flame"}:r<.2?{n:"شارة ملحمية",type:"badge",r:"epic",ic:"award"}:{n:(i.id==="chest_b"?"١٠٠ عملة":"٢٥٠ عملة"),type:"coins",r:"rare",ic:"coins",amt:i.id==="chest_b"?100:250};
    if(got.type==="coins")addCoins(got.amt||250);else S.me.inventory.push({id:uid(),...got});
    celebrate(" فتحت الصندوق وحصلت على: "+got.n)}
  else if(i.type==="badge"){S.me.badges.push("badge_elite");celebrate("حصلت على شارة النخبة ")}
  else if(i.type==="stars"){addStars(i.value||100,"شراء نجوم");celebrate("استلمت "+(i.value||100)+" نجمة ")}
  else if(i.type==="title"){S.me.titles.push(i.n);S.me.equippedTitle=i.n;celebrate("اشتريت لقب «"+i.n+"» ")}
  else{S.me.inventory.push({id:uid(),n:i.n,type:i.type,r:"rare",ic:i.ic});toast("اشتريت "+i.n+" ","ok");celebrate("شراء ناجح: "+i.n)}
  save();render();
}
function subscribe(id,p){S.plus=id!=="free";S.plusName=id==="plus"?"AnimeBlack Plus":"Elite Otaku";save();celebrate("اشتركت في "+(id==="plus"?"AnimeBlack Plus":"Elite Otaku")+" ");render()}
function bid(id){const m=(S.market||[]).find(x=>x.id===id);if(S.coins<m.price+50){toast("رصيدك لا يكفي للمزايدة","err");snd("error");return}m.price+=50;m.bids++;toast("زاودت بـ "+nfmt(m.price)+" عملة ","ok");snd("success");save();render()}
function swap(id){const m=(S.market||[]).find(x=>x.id===id);openSheet("swapSheet",id);toast("عرضت مبادلة على "+m.seller.name,"ok")}
function buyMarket(id){const m=(S.market||[]).find(x=>x.id===id);if(S.coins<m.price){toast("رصيدك غير كافٍ","err");snd("error");return}S.coins-=m.price;S.me.coins=S.coins;S.me.inventory.push({id:uid(),n:m.n,type:"frame",r:m.r,ic:"star"});S.market=S.market.filter(x=>x.id!==id);save();celebrate("اشتريت «"+m.n+"» من السوق ")}

/* ============================================================
   18) نظام Gmail المتكامل
   ============================================================ */
const MAIL_FOLDERS=[["inbox","الواردة","inbox"],["starred","المميزة","star"],["sent","الصادرة","send"],["drafts","المسودات","file"],["spam","المزعجة","ban"],["trash","المهملات","trash"]];
PAGES.gmail=()=>{
  let f=S.params.folder||S.mailFolder||"inbox";if(!MAIL_FOLDERS.some(x=>x[0]===f))f="inbox";S.mailFolder=f;setNav(false);
  const list=S.emails.filter(e=>f==="starred"?e.starred:e.folder===f);
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('more')">${I("back")}</button>
    <div class="ttl">بريد Gmail<small>${esc(S.me.email)}</small></div>
    <button class="iconbtn" onclick="openSheet('mailCompose')">${I("edit")}</button>
    <button class="iconbtn" onclick="openSheet('mailMenu')">${I("more")}</button></div>`);
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div style="padding:9px 12px;border-bottom:1px solid var(--line);flex-shrink:0">
      <button class="btn btn-primary btn-sm" style="width:100%" onclick="openSheet('mailCompose')">${I("edit","i s")} إنشاء رسالة</button>
      <div class="chiprow" style="margin-top:9px">${MAIL_FOLDERS.map(([k,l,ic])=>{const n=S.emails.filter(e=>k==="starred"?e.starred:e.folder===k).length;
        return `<button class="chip ${f===k?'on':''}" onclick="go('gmail',{folder:'${k}'},false);snd('tap')">${I(ic,"i s")} ${l}${n?` <span class="badge ${f===k?'b-gray':'b-red'} mono">${n}</span>`:""}</button>`}).join("")}</div>
      <div class="row" style="gap:7px"><div class="row g1" style="gap:7px;background:var(--surface2);border:1px solid var(--line2);border-radius:11px;padding:7px 11px">
        <span style="color:var(--muted)">${I("search","i s")}</span><input class="g1" style="background:none;border:none;font-size:12px" placeholder="ابحث في البريد..." id="mailq" oninput="filterMail(this.value)"></div>
        <button class="iconbtn" onclick="toast('تم تحديث البريد ','ok');snd('success')">${I("refresh")}</button></div>
    </div>
    <div style="flex:1;overflow-y:auto" class="no-sb" id="maillist">
      ${list.length?list.map(e=>mailRow(e)).join(""):emptyState("inbox","لا رسائل في «"+(MAIL_FOLDERS||[]).find(x=>x[0]===f)[1]+"»","")}
    </div>
  </div>`;
};
function mailRow(e){
  return `<div class="lstrow" id="mr_${e.id}" role="button" tabindex="0" style="border-radius:0;border-left:none;border-right:none;border-top:none;padding:12px 13px;${e.read?'':'background:rgba(34,211,238,.05)'}" onclick="openMail('${e.id}')">
    <span class="ico-tile" style="width:38px;height:38px;border-radius:50%;background:${e.folder==='spam'?'rgba(244,63,94,.15)':'var(--grad-fire)'};color:${e.folder==='spam'?'var(--rose)':'#fff'};font-size:12px;font-weight:900">${esc(e.from[0])}</span>
    <span class="g1" style="text-align:right;min-width:0">
      <span class="rowb"><span class="${e.read?'b xs mut':'bb xs'}">${esc(e.from)}</span><span class="tiny fnt">${ago(e.at)}</span></span>
      <span class="${e.read?'tiny mut':'xs b'}" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(e.subj)}</span>
      <span class="tiny fnt" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(e.prev)}</span>
    </span>
    <span class="col" style="gap:5px;align-items:center;flex-shrink:0">
      <button class="iconbtn" style="width:26px;height:26px;background:none;border:none;color:${e.starred?'var(--gold)':'var(--faint)'}" onclick="event.stopPropagation();toggleStar('${e.id}')">${IF("star","i s")}</button>
      ${e.attach?`<span class="tiny fnt">${I("link","i s")} ${e.attach}</span>`:""}
      ${!e.read?'<span style="width:7px;height:7px;border-radius:50%;background:var(--accent)"></span>':""}
    </span></div>`;
}
function filterMail(q){q=q.toLowerCase();S.emails.forEach(e=>{const el=$("#mr_"+e.id);if(el)el.style.display=(!q||(e.subj+e.from+e.body).toLowerCase().includes(q))?"flex":"none"})}
function toggleStar(id){const e=(S.emails||[]).find(x=>x.id===id);e.starred=!e.starred;save();toast(e.starred?"أُضيفت للرسائل المميّزة ":"أُزيلت من المميّزة","info");snd("tap");render()}
function openMail(id){const e=(S.emails||[]).find(x=>x.id===id);if(!e)return;e.read=true;save();go("mailView",{id})}
PAGES.mailView=()=>{
  const e=(S.emails||[]).find(x=>x.id===S.params.id);if(!e){setNav(false);setHdr(backHdr("الرسالة",""));return emptyState("mail","الرسالة غير موجودة","")}
  setNav(false);setHdr(backHdr("الرسالة",e.folder==="inbox"?"الوارد":e.folder,`
    <button class="iconbtn" onclick="toggleStar('${e.id}')">${IF("star","i s")}</button>
    <button class="iconbtn" onclick="openSheet('mailMenu','${e.id}')">${I("more")}</button>`));
  return `<div class="pad col">
    <div class="bb" style="font-size:16px;line-height:1.5">${esc(e.subj)} ${e.starred?`<span style="color:var(--gold)">${IF("star","i s")}</span>`:""}</div>
    <div class="row" style="gap:10px">
      <span class="ico-tile" style="width:40px;height:40px;border-radius:50%;background:var(--grad-fire);color:#fff;font-weight:900">${esc(e.from[0])}</span>
      <div class="g1"><div class="b xs">${esc(e.from)}</div><div class="tiny fnt mono" dir="ltr">${esc(e.addr)}</div>
        <div class="tiny fnt">إلى: ${esc(S.me.email)} · ${new Date(e.at).toLocaleString("ar")}</div></div>
      <button class="iconbtn" onclick="replyMail('${e.id}')">${I("reply","i s")}</button>
    </div>
    ${e.folder==="spam"?`<div class="card2" style="padding:11px;border-color:rgba(244,63,94,.4);background:rgba(244,63,94,.07)">
      <div class="row b xs" style="color:var(--rose)">${I("alert","i s")} رسالة مشبوهة</div><div class="tiny fnt" style="margin-top:4px">قد تحتوي على روابط ضارة. لا تضغط على أي رابط.</div></div>`:""}
    <div class="card" style="padding:15px;white-space:pre-wrap;font-size:13px;line-height:1.9">${esc(e.body)}</div>
    ${e.attach?`<div class="secttl"><h3>${I("link","i s")} المرفقات (${e.attach})</h3></div>
      <div class="col">${Array.from({length:e.attach},(_,i)=>`<div class="lstrow" role="button" tabindex="0" onclick="toast('تنزيل المرفق ${i+1}... ','ok');snd('success')">
        <span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("file","i s")}</span>
        <span class="g1" style="text-align:right"><span class="b xs" style="display:block">attachment_${i+1}.${i?"pdf":"png"}</span><span class="tiny fnt mono">${rnd(80,2400)} KB</span></span>${I("download","i s")}</div>`).join("")}</div>`:""}
    <div class="grid2" style="margin-top:4px">
      <button class="btn btn-primary" onclick="replyMail('${e.id}')">${I("reply","i s")} رد</button>
      <button class="btn btn-sec" onclick="toast('إعادة توجيه...','info');openSheet('mailCompose','${e.id}')">${I("fwd2","i s")} إعادة توجيه</button>
      <button class="btn btn-sec" onclick="moveMail('${e.id}','trash')">${I("trash","i s")} حذف</button>
      <button class="btn btn-sec" onclick="moveMail('${e.id}','spam')">${I("ban","i s")} إبلاغ كإزعاج</button>
      <button class="btn btn-ghost" onclick="markMailUnread('${e.id}')">${I("mail","i s")} تعليم كغير مقروءة</button>
      <button class="btn btn-ghost" onclick="openSheet('mailMenu','${e.id}')">${I("more","i s")} المزيد</button></div>
  </div>`;
};
function markMailUnread(id){const e=(S.emails||[]).find(x=>x.id===id);if(e){e.read=false;save();toast("تم تعليم الرسالة كغير مقروءة ","info");back()}}
function replyMail(id){const e=(S.emails||[]).find(x=>x.id===id);S.mailReplyTo=e;openSheet("mailCompose",id)}
function moveMail(id,to){const e=(S.emails||[]).find(x=>x.id===id);e.folder=to;save();back();toast({trash:"نُقلت إلى المهملات ",spam:"أُبلغ عنها كإزعاج ",inbox:"أُعيدت إلى الوارد ",archive:"أُرشفت "}[to]||"نُقلت","ok")}


/* ============================================================
   19ب) القروبات والنقابات والعوالم — صفحات وأنظمة مخصصة
   ============================================================ */
const CREATE_COST={group:{coins:300,lvl:5},guild:{coins:1500,lvl:10},world:{coins:800,lvl:8}};
function costCard(kind){const c=CREATE_COST[kind];const okC=S.coins>=c.coins,okL=S.me.level>=c.lvl;
  return `<div class="card" style="padding:12px;margin-bottom:12px;background:linear-gradient(135deg,rgba(245,158,11,.1),transparent)">
    <div class="rowb"><span class="xs b">${I("coins","i s")} تكلفة الإنشاء</span><span class="badge ${okC?'b-emerald':'b-red'} mono">${nfmt(c.coins)} عملة · رصيدك ${nfmt(S.coins)}</span></div>
    <div class="rowb" style="margin-top:6px"><span class="xs b">${I("trend","i s")} المستوى المطلوب</span><span class="badge ${okL?'b-emerald':'b-red'} mono">مستوى ${c.lvl} · أنت ${S.me.level}</span></div></div>`}
function gateCreate(kind){const c=CREATE_COST[kind];
  if(S.me.level<c.lvl){toast("يتطلب المستوى "+c.lvl+" — أنت حالياً "+S.me.level+" ","err");snd("error");return false}
  if(S.coins<c.coins){toast("رصيدك لا يكفي: تحتاج "+c.coins+" عملة ","err");snd("error");go("economy");return false}
  return true}
function groupRow(g){const last=g.msgs[(g.msgs||[]).length-1];
  return `<button class="lstrow" onclick="go('groupRoom',{id:'${g.id}'})">
    <span class="ico-tile" style="background:linear-gradient(135deg,${g.c1},${g.c2});color:#fff">${I(g.icon,"i l")}</span>
    <span class="g1" style="text-align:right;min-width:0"><span class="row" style="gap:5px"><span class="b xs">${esc(g.name)}</span>${g.announce?`<span class="badge b-gold">إعلانات</span>`:""}${g.muted?`<span class="badge b-gray">${I("mute","i s")}</span>`:""}</span>
    <span class="tiny fnt" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${last?esc(u(last.uid).name.split(" ")[0]+": "+last.text):esc(g.desc)}</span></span>
    <span class="tiny fnt mono">${(g.members||[]).length}</span>${I("fwd","i s")}</button>`}
function worldRow(w){return `<button class="lstrow" onclick="go('worldRoom',{id:'${w.id}'})">
    <span class="ico-tile" style="background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"i l")}</span>
    <span class="g1" style="text-align:right"><span class="row" style="gap:5px"><span class="b xs">${esc(w.name)}</span>${w.joined?`<span class="badge b-emerald">منضم</span>`:""}${w.feat?`<span class="badge b-gold">مميز</span>`:""}</span>
    <span class="tiny fnt">${esc(w.theme)} · ${nfmt(w.members)} عضو · ${w.online} متصل</span></span>${I("fwd","i s")}</button>`}
PAGES.groups=()=>{setNav(false);setHdr(backHdr("قروبات الدردشة",S.groups.filter(g=>g.joined).length+" قروب فعال",`<button class="btn btn-primary btn-sm" onclick="go('createGroup')">${I("plus","i s")} قروب</button>`));
  return `<div class="pad col">
    <div class="grid3">${[["users",S.groups.filter(g=>g.joined).length,"منضم"],["crown",S.groups.filter(g=>g.owner==="me").length,"أملكها"],["msgsq",S.groups.reduce((a,g)=>a+(g.msgs||[]).length,0),"رسالة"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    <div class="secttl"><h3>${I("users","i s")} قروباتي</h3></div>
    ${S.groups.filter(g=>g.joined).map(g=>groupRow(g)).join("")||emptyState("users","لا قروبات بعد","أنشئ قروبك الأول من الزر بالأعلى")}
    <div class="secttl"><h3>${I("globe","i s")} قروبات مقترحة</h3></div>
    ${S.groups.filter(g=>!g.joined).map(g=>groupRow(g)).join("")}
  </div>`};
PAGES.groupRoom=()=>{const g=(S.groups||[]).find(x=>x.id===S.params.id);if(!g){setNav(false);setHdr(backHdr("القروب",""));return emptyState("users","القروب غير موجود","")}
  setNav(false);
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%">
    <button class="iconbtn" onclick="go('groups')">${I("back")}</button>
    <span class="ico-tile" style="width:30px;height:30px;border-radius:10px;background:linear-gradient(135deg,${g.c1},${g.c2});color:#fff">${I(g.icon,"i l")}</span>
    <div class="g1" style="min-width:0"><div class="b sm" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(g.name)}</div><div class="tiny fnt">${(g.members||[]).length} أعضاء · ${esc(g.privacy)}</div></div>
    <button class="iconbtn" onclick="openSheet('groupMembers','${g.id}')" aria-label="الأعضاء">${I("users")}</button>
    <button class="iconbtn" onclick="openSheet('groupMenu','${g.id}')" aria-label="خيارات">${I("more")}</button></div>`);
  if(!g.joined)return `<div class="pad col center" style="gap:12px"><span class="ico-tile" style="width:64px;height:64px;border-radius:20px;background:linear-gradient(135deg,${g.c1},${g.c2});color:#fff">${I(g.icon,"xl")}</span>
    <div class="bb">${esc(g.name)}</div><div class="xs mut center">${esc(g.desc)}</div>
    <button class="btn btn-primary" onclick="joinGroup('${g.id}')">${I("plus","i s")} انضم للقروب</button></div>`;
  return `<div style="display:flex;flex-direction:column;height:100%">
    ${g.announce?`<div style="padding:6px 12px;border-bottom:1px solid var(--line);flex-shrink:0"><span class="tiny fnt" style="color:var(--gold)">${I("alert","i s")} وضع الإعلانات مفعل: يكتب المشرفون فقط</span></div>`:""}
    ${g.announce?`<div class="row" style="gap:8px;padding:9px 12px;background:linear-gradient(135deg,rgba(250,204,21,.14),transparent);border-bottom:1px solid var(--line);flex-shrink:0"><span class="ico-tile" style="width:30px;height:30px;border-radius:10px;background:var(--grad-gold);color:#fff">${I("shield","i s")}</span><div class="g1"><div class="tiny b" style="color:var(--gold)">إعلان رسمي · ${ago(g.announce.at)}</div><div class="xs" style="margin-top:2px">${esc(g.announce.text)}</div></div></div>`:""}
    ${g.pinned?`<div class="row" style="gap:7px;padding:7px 12px;background:rgba(250,204,21,.08);border-bottom:1px solid var(--line);flex-shrink:0"><span style="color:var(--gold);line-height:0">${I("pin","i s")}</span><span class="tiny g1" style="text-align:right">مثبت: ${esc(String(g.pinned).slice(0,60))}</span><button class="iconbtn" style="width:24px;height:24px" onclick="(S.groups||[]).find(x=>x.id==='${g.id}').pinned=null;save();render()">${I("x","i s")}</button></div>`:""}
    <div class="chatbody no-sb" id="gbody">${g.msgs.map(m=>{const me=m.uid==="me";const mu=me?S.me:u(m.uid);return `<div class="msg ${me?"me":"them"}" data-mid="${m.id}" data-ctx="group" oncontextmenu="event.preventDefault();openSheet('roomMsgMenu','${m.id}')" style="max-width:88%"><div class="row" style="gap:5px;margin-bottom:3px">${av(mu,18)}<span class="tiny b" style="color:${me?"#fff":"var(--accent)"}">${me?"أنت":esc(mu.name)}</span>${g.admins.includes(m.uid)?`<span class="badge b-gold">مشرف</span>`:""}</div>${roomMsgBody(m,me)}<span class="tm">${hhmm(m.at)}</span></div>`}).join("")||`<div class="empty">${I("msgsq","l")}<div class="xs b">لا رسائل بعد</div><div class="tiny fnt">ابدأ الحديث في ${esc(g.name)}</div></div>`}</div>
    ${S.gReply&&S.gReply.g===g.id?`<div class="row" style="gap:8px;padding:6px 12px;background:var(--surface2);border-top:1px solid var(--line);flex-shrink:0"><span style="color:var(--accent)">${I("reply","i s")}</span><span class="tiny g1" style="text-align:right">رد على: ${esc(((g.msgs||[]).find(x=>x.id===S.gReply.m)||{}).text||"وسائط").slice(0,50)}</span><button class="iconbtn" style="width:26px;height:26px" onclick="S.gReply=null;render()">${I("x","i s")}</button></div>`:""}
    <div class="composer"><button class="iconbtn" onclick="openSheet('attachSheet')" aria-label="إرفاق">${I("plus")}</button>
      <button class="iconbtn" id="gmic" onclick="recGenVoice('group','${g.id}',this)" aria-label="تسجيل صوتي">${I("mic")}</button>
      <textarea id="gin" rows="1" placeholder="رسالة إلى ${esc(g.name)}" oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px'" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendGroupMsg('${g.id}')}"></textarea>
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendGroupMsg('${g.id}')" aria-label="إرسال">${I("send","i s")}</button></div>
  </div>`};
function joinGroup(id){const g=(S.groups||[]).find(x=>x.id===id);
  if(g.privacy==="خاص"&&g.owner!=="me"){S.joinReqs=S.joinReqs||[];if(!S.joinReqs.some(r=>r.kind==="group"&&r.id===id&&r.uid==="me")){S.joinReqs.push({kind:"group",id:id,uid:"me",at:now()});save();toast("قروب خاص: أُرسل طلب انضمام للمشرفين ","info");snd("send")}else toast("طلبك قيد المراجعة ","info");render();return}
  g.joined=true;if(!g.members.includes("me"))g.members.push("me");celebrate("انضممت إلى "+g.name+" ");save();render()}
function sendGroupMsg(id){const g=(S.groups||[]).find(x=>x.id===id);const i=$("#gin");if(!g||!i)return;const t=(i.value||"").trim();if(!t)return;
  if(g.announce&&!g.admins.includes("me")){toast("قروب إعلانات: الكتابة للمشرفين فقط ","err");snd("error");return}
  i.value="";i.style.height="auto";g.msgs.push({id:uid(),uid:"me",text:t,at:now()});save();snd("send");questProgress("q4");
  const b=$("#gbody");if(b){b.insertAdjacentHTML("beforeend",`<div class="msg me" data-ctx="group" style="max-width:88%"><div class="row" style="gap:5px;margin-bottom:3px">${av(S.me,18)}<span class="tiny b" style="color:#fff">أنت</span></div>${linkify(t)}<span class="tm">${hhmm(now())}</span></div>`);b.scrollTop=b.scrollHeight}
  /* v3: عُطّل رد آلي وهمي كان يظهر تلقائياً بعد إرسالك رسالة في غرفة القروب.
   الأصل محفوظ هنا كاملاً ولم يُحذف:
   setTimeout(()=>{if(S.page!=="groupRoom"||S.params.id!==id)return;const mem=g.members.filter(x=>x!=="me");if(!mem.length)return;const r=mem[strHash(t)%mem.length];const reps=["وصلني ","+1","مين يجيب تفاصيل أكثر؟","أتفق معك تماماً"];g.msgs.push({id:uid(),uid:r,text:reps[strHash(t+"r")%reps.length],at:now()});save();render()},2400)
*/void 0}

function groupRename(id){const g=(S.groups||[]).find(x=>x.id===id);const v=($("#gr_n")||{}).value||"";if(!v.trim()){toast("الاسم مطلوب ","err");return}g.name=v.trim();save();closeOvl();render();toast("تم تحديث الاسم ","ok")}
function groupDesc(id){const g=(S.groups||[]).find(x=>x.id===id);g.desc=(($("#gr_d")||{}).value||g.desc).trim();save();closeOvl();render();toast("تم تحديث الوصف ","ok")}
function groupToggle(id,k){const g=(S.groups||[]).find(x=>x.id===id);
  if(k==="privacy"){g.privacy=g.privacy==="خاص"?"عام":"خاص";toast(g.privacy==="خاص"?"أصبح القروب خاصاً ":"أصبح القروب عاماً ","info")}
  else if(k==="pinned"){g.pinned=g.pinned?null:(g.msgs[(g.msgs||[]).length-1]||{}).text||null;toast(g.pinned?"ثُبّتت آخر رسالة ":"أُلغي التثبيت ","info")}
  else{g[k]=!g[k];toast((({muted:"الكتم",announce:"وضع الإعلانات"})[k]||k)+": "+(g[k]?"مفعّل":"معطّل"),"info")}
  save();snd("tap");closeOvl();render()}


function groupPromote(gid,mid){const g=(S.groups||[]).find(x=>x.id===gid);if(!g)return;if(g.admins.includes(mid))g.admins=g.admins.filter(x=>x!==mid);else g.admins.push(mid);save();snd("tap");toast(g.admins.includes(mid)?"تمت الترقية إلى مشرف ":"أُزيلت صلاحية الإشراف ","info");openSheet("groupMembers",gid)}
function groupInvite(gid,uid2){const g=(S.groups||[]).find(x=>x.id===gid);if(g.members.includes(uid2))return;g.members.push(uid2);save();closeOvl();toast("انضم "+u(uid2).name+" إلى القروب ","ok");snd("success");openSheet("groupMembers",gid)}
function groupKick(gid,uid2){const g=(S.groups||[]).find(x=>x.id===gid);g.members=g.members.filter(m=>m!==uid2);g.admins=g.admins.filter(m=>m!==uid2);save();toast("أُزيل "+u(uid2).name+" من القروب ","info");closeOvl();render()}
function leaveCommunity(id){const c=(S.communities||[]).find(x=>x.id===id);if(!c)return;if(!confirm("مغادرة "+c.name+"؟"))return;c.joined=false;c.rank="—";save();render();toast("غادرت المجتمع ","info")}
function leaveGroup(id){const g=(S.groups||[]).find(x=>x.id===id);if(!confirm("مغادرة "+g.name+"؟"))return;g.joined=false;g.members=g.members.filter(m=>m!=="me");save();closeOvl();go("groups");toast("غادرت القروب ","info")}
function deleteGroup(id){const g=(S.groups||[]).find(x=>x.id===id);if(!confirm("حذف "+g.name+" نهائياً؟"))return;S.groups=S.groups.filter(x=>x.id!==id);save();closeOvl();go("groups");toast("حُذف القروب ","err")}
PAGES.createGroup=()=>{setNav(false);setHdr(backHdr("إنشاء قروب دردشة","صفحة مخصصة — ليست من خيارات المنشور"));
  const icons=["users","msgsq","heart","star","flame","gamepad","book","music"];
  return `<div class="pad col">
    ${costCard("group")}
    <label class="lbl">اسم القروب *</label><input class="inp" id="cg_n" placeholder="مثال: شلة الأنمي الليلية">
    <label class="lbl" style="margin-top:9px">الوصف</label><input class="inp" id="cg_d" placeholder="وصف قصير يظهر للأعضاء">
    <label class="lbl" style="margin-top:9px">الأيقونة</label>
    <div class="chiprow">${icons.map(ic=>`<button class="chip ${(S.cgIcon||"users")===ic?'on':''}" onclick="S.cgIcon='${ic}';render()">${I(ic,"i s")}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">الخصوصية</label>
    <div class="chiprow">${["خاص","عام"].map(p=>`<button class="chip ${(S.cgPriv||"خاص")===p?'on':''}" onclick="S.cgPriv='${p}';render()">${p==="خاص"?I("lock","i s"):I("globe","i s")} ${p}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">أعضاء مؤسسون</label>
    <div class="chiprow">${(S.users||[]).slice(0,8).map(x=>`<button class="chip ${(S.cgMem||[]).includes(x.id)?'on':''}" onclick="S.cgMem=S.cgMem||[];S.cgMem.includes('${x.id}')?S.cgMem=S.cgMem.filter(i=>i!=='${x.id}'):S.cgMem.push('${x.id}');render()">${av(x,18)} ${esc(x.name.split(" ")[0])}</button>`).join("")}</div>
    <button class="btn btn-primary btn-lg" style="margin-top:14px" onclick="submitGroup()">${I("users","i s")} إنشاء القروب (${CREATE_COST.group.coins} عملة)</button>
  </div>`};
function submitGroup(){const nm=($("#cg_n")||{}).value||"";if(nm.trim().length<3){toast("اسم القروب ٣ أحرف على الأقل ","err");snd("error");return}
  if(!gateCreate("group"))return;addCoins(-CREATE_COST.group.coins,"تكلفة إنشاء قروب");
  const g={id:"gr"+uid(),name:nm.trim(),desc:(($("#cg_d")||{}).value||"قروب جديد في أنمي بلاك").trim(),icon:S.cgIcon||"users",c1:"#0E7490",c2:"#22D3EE",privacy:S.cgPriv||"خاص",members:["me"].concat(S.cgMem||[]),admins:["me"],muted:false,announce:false,pinned:null,joined:true,owner:"me",msgs:[{id:uid(),uid:"me",text:"أنشأت القروب — أهلاً بالجميع ",at:now()}]};
  S.groups.unshift(g);S.cgMem=[];save();celebrate("أنشأت قروب "+g.name+"!");
  if(window.auth&&window.auth.currentUser&&window.db){
    window.setDoc(window.doc(window.db,"groups",g.id),g).catch(e=>console.error(e));
  }
  go("groupRoom",{id:g.id})}
PAGES.createGuild=()=>{setNav(false);setHdr(backHdr("إنشاء نقابة","صفحة مخصصة — رتب ومهام وخزينة"));
  const cols=[["#7F1D1D","#EA580C"],["#312E81","#818CF8"],["#14532D","#4ADE80"],["#6D28D9","#A78BFA"],["#0C4A6E","#0EA5E9"],["#9D174D","#F472B6"]];
  return `<div class="pad col">
    ${costCard("guild")}
    <label class="lbl">اسم النقابة *</label><input class="inp" id="cu_n" placeholder="مثال: نقابة الساموراي السوداء">
    <div class="row" style="gap:8px;margin-top:9px"><div class="g1"><label class="lbl">وسم النقابة (٣ أحرف)</label><input class="inp mono" id="cu_t" maxlength="3" placeholder="SAM" dir="ltr"></div>
    <div class="g1"><label class="lbl">التخصص</label><div class="chiprow">${["قتال","استكشاف","فن","ترجمة"].map(f=>`<button class="chip ${(S.cuFocus||"قتال")===f?'on':''}" onclick="S.cuFocus='${f}';render()">${f}</button>`).join("")}</div></div></div>
    <label class="lbl" style="margin-top:9px">الوصف</label><input class="inp" id="cu_d" placeholder="رسالة النقابة وأهدافها">
    <label class="lbl" style="margin-top:9px">شعار النقابة (لونان)</label>
    <div class="chiprow">${cols.map((c2,i)=>`<button class="chip ${(S.cuCol||0)===i?'on':''}" style="padding:6px 14px;background:linear-gradient(135deg,${c2[0]},${c2[1]});color:#fff" onclick="S.cuCol=${i};render()">${I("shield","i s")}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">طريقة الانضمام</label>
    <div class="chiprow">${["مفتوح","بالطلب"].map(p=>`<button class="chip ${(S.cuJoin||"مفتوح")===p?'on':''}" onclick="S.cuJoin='${p}';render()">${p}</button>`).join("")}</div>
    <button class="btn btn-gold btn-lg" style="margin-top:14px" onclick="submitGuild()">${I("shield","i s")} تأسيس النقابة (${CREATE_COST.guild.coins} عملة)</button>
  </div>`};
function submitGuild(){const nm=($("#cu_n")||{}).value||"";if(nm.trim().length<3){toast("اسم النقابة ٣ أحرف على الأقل ","err");snd("error");return}
  if(!gateCreate("guild"))return;addCoins(-CREATE_COST.guild.coins,"تكلفة تأسيس نقابة");
  const cols=[["#7F1D1D","#EA580C"],["#312E81","#818CF8"],["#14532D","#4ADE80"],["#6D28D9","#A78BFA"],["#0C4A6E","#0EA5E9"],["#9D174D","#F472B6"]][S.cuCol||0];
  const c={id:"g"+uid(),name:nm.trim(),type:"guild",members:1,online:1,icon:"shield",c1:cols[0],c2:cols[1],desc:(($("#cu_d")||{}).value||"نقابة جديدة تسعى للمجد").trim(),rank:"المؤسس",joined:true,unlocked:true,tag:(($("#cu_t")||{}).value||"NEW").toUpperCase(),focus:S.cuFocus||"قتال",joinMode:S.cuJoin||"مفتوح",treasury:0,tlog:[{amt:0,at:now(),by:"تأسيس"}],channels:[{id:uid(),name:"الدردشة العامة",unread:0,topic:"نقاش النقابة"},{id:uid(),name:"الإعلانات",unread:0,topic:"قرارات القائد"}],messages:[{id:uid(),from:"me",text:"تأسست النقابة — مرحباً بأول الأعضاء ",at:now()}]};
  S.communities.unshift(c);save();celebrate("تأسست نقابة "+c.name+"!");
  if(window.auth&&window.auth.currentUser&&window.db){
    window.setDoc(window.doc(window.db,"communities",c.id),c).catch(e=>console.error(e));
  }
  go("communityDetail",{id:c.id})}
PAGES.createWorld=()=>{setNav(false);setHdr(backHdr("إنشاء عالم","صفحة مخصصة — عالم بأنظمة وقوانين ودردشة"));
  const cols=[["#0C4A6E","#0EA5E9"],["#3F2D12","#B45309"],["#312E81","#818CF8"],["#14532D","#4ADE80"],["#9D174D","#F472B6"],["#111827","#6B7280"]];
  return `<div class="pad col">
    ${costCard("world")}
    <label class="lbl">اسم العالم *</label><input class="inp" id="cw_n" placeholder="مثال: عالم ون بلاك">
    <label class="lbl" style="margin-top:9px">الوصف</label><input class="inp" id="cw_d" placeholder="أجواء العالم وقصته">
    <label class="lbl" style="margin-top:9px">التصنيف</label>
    <div class="chiprow">${["مغامرة","ملحمي","خيال","نينجا","مدرسي","رياضي"].map(t=>`<button class="chip ${(S.cwTheme||"مغامرة")===t?'on':''}" onclick="S.cwTheme='${t}';render()">${t}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">الأيقونة</label>
    <div class="chiprow">${["globe","wave","swords","wand","sakura","zap","gem","map"].map(ic=>`<button class="chip ${(S.cwIcon||"globe")===ic?'on':''}" onclick="S.cwIcon='${ic}';render()">${I(ic,"i s")}</button>`).join("")}</div>
    <label class="lbl" style="margin-top:9px">قوانين العالم (سطر لكل قانون)</label><textarea class="inp" id="cw_r" rows="3" placeholder="احترام الأعضاء&#10;لا حرق للأحداث">احترام جميع الأعضاء&#10;لا حرق لأحداث الأنمي</textarea>
    <label class="lbl" style="margin-top:9px">ألوان العالم</label>
    <div class="chiprow">${cols.map((c2,i)=>`<button class="chip ${(S.cwCol||0)===i?'on':''}" style="padding:6px 14px;background:linear-gradient(135deg,${c2[0]},${c2[1]});color:#fff" onclick="S.cwCol=${i};render()">${I("palette","i s")}</button>`).join("")}</div>
    <button class="btn btn-primary btn-lg" style="margin-top:14px" onclick="submitWorld()">${I("globe","i s")} إنشاء العالم (${CREATE_COST.world.coins} عملة)</button>
  </div>`};
function submitWorld(){const nm=($("#cw_n")||{}).value||"";if(nm.trim().length<3){toast("اسم العالم ٣ أحرف على الأقل ","err");snd("error");return}
  if(!gateCreate("world"))return;addCoins(-CREATE_COST.world.coins,"تكلفة إنشاء عالم");
  const cols=[["#0C4A6E","#0EA5E9"],["#3F2D12","#B45309"],["#312E81","#818CF8"],["#14532D","#4ADE80"],["#9D174D","#F472B6"],["#111827","#6B7280"]][S.cwCol||0];
  const rules=(($("#cw_r")||{}).value||"").split("\n").map(x=>x.trim()).filter(Boolean);
  const w={id:"w"+uid(),name:nm.trim(),desc:(($("#cw_d")||{}).value||"عالم جديد في أنمي بلاك").trim(),icon:S.cwIcon||"globe",c1:cols[0],c2:cols[1],theme:S.cwTheme||"مغامرة",members:1,online:1,joined:true,owner:"me",rules:rules.length?rules:["احترام جميع الأعضاء"],msgs:[{id:uid(),uid:"me",text:"افتتح العالم — أهلاً بالمستكشفين ",at:now()}]};
  S.worlds.unshift(w);save();celebrate("أنشأت عالم "+w.name+"!");go("worldRoom",{id:w.id})}
PAGES.worlds=()=>{setNav(false);setHdr(backHdr("عوالم الأنمي",S.worlds.filter(w=>w.joined).length+" منضم إليها",`<button class="btn btn-primary btn-sm" onclick="go('createWorld')">${I("plus","i s")} عالم</button>`));
  const f=S.wFilter||"all";
  return `<div class="pad col">
    <div class="grid3">${[["globe",(S.worlds||[]).length,"عالم"],["users",S.worlds.reduce((a,w)=>a+w.members,0),"عضو"],["zap",S.worlds.reduce((a,w)=>a+w.online,0),"متصل"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${nfmt(v)}</b><span>${l}</span></div>`).join("")}</div>
    <div class="chiprow">${[["all","الكل"],["joined","عوالمي"],["open","قابل للانضمام"]].map(([k,l])=>`<button class="chip ${f===k?'on':''}" onclick="S.wFilter='${k}';save();render();snd('tap')">${l}</button>`).join("")}</div>
    ${S.worlds.filter(w=>f==="all"||(f==="joined"?w.joined:!w.joined&&!w.closed)).map(w=>worldRow(w)).join("")||emptyState("globe","لا عوالم هنا","أنشئ عالمك من الزر بالأعلى")}
  </div>`};
PAGES.worldRoom=()=>{const w=(S.worlds||[]).find(x=>x.id===S.params.id);if(!w){setNav(false);setHdr(backHdr("العالم",""));return emptyState("globe","العالم غير موجود","")}
  setNav(false);
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%">
    <button class="iconbtn" onclick="go('worlds')">${I("back")}</button>
    <span class="ico-tile" style="width:30px;height:30px;border-radius:10px;background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"i l")}</span>
    <div class="g1" style="min-width:0"><div class="b sm">${esc(w.name)}</div><div class="tiny fnt">${esc(w.theme)} · ${w.online} متصل الآن</div></div>
    <button class="iconbtn" onclick="openSheet('worldRules','${w.id}')" aria-label="القوانين">${I("info")}</button>
    <button class="iconbtn" onclick="openSheet('worldMenu','${w.id}')" aria-label="خيارات">${I("more")}</button></div>`);
  if(w.closed)return `<div class="pad">${emptyState("lock","العالم مغلق إدارياً","راجع الإدارة")}</div>`;
  if(!w.joined)return `<div class="pad col center" style="gap:12px"><span class="ico-tile" style="width:64px;height:64px;border-radius:20px;background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"xl")}</span>
    <div class="bb">${esc(w.name)}</div><div class="xs mut center">${esc(w.desc)}</div>
    <div class="tiny fnt">${nfmt(w.members)} عضو · قوانين: ${(w.rules||[]).length}</div>
    <button class="btn btn-primary" onclick="joinWorld('${w.id}')">${I("plus","i s")} انضم للعالم</button></div>`;
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div style="padding:7px 12px;background:linear-gradient(135deg,${w.c1}22,transparent);border-bottom:1px solid var(--line);flex-shrink:0"><div class="row" style="gap:7px"><span style="color:var(--accent)">${I(w.icon,"i s")}</span><span class="tiny fnt g1">${esc(w.desc)}</span><button class="btn btn-ghost btn-xs" onclick="openSheet('worldRules','${w.id}')">القوانين</button></div></div>
    ${w.pinned?`<div class="row" style="gap:7px;padding:7px 12px;background:rgba(250,204,21,.08);border-bottom:1px solid var(--line);flex-shrink:0"><span style="color:var(--gold);line-height:0">${I("pin","i s")}</span><span class="tiny g1" style="text-align:right">مثبت: ${esc(String(w.pinned).slice(0,60))}</span><button class="iconbtn" style="width:24px;height:24px" onclick="(S.worlds||[]).find(x=>x.id==='${w.id}').pinned=null;save();render()">${I("x","i s")}</button></div>`:""}
    <div class="chatbody no-sb" id="wbody">${w.msgs.map(m=>{const me=m.uid==="me";const mu=me?S.me:u(m.uid);return `<div class="msg ${me?"me":"them"}" data-mid="${m.id}" data-ctx="world" oncontextmenu="event.preventDefault();openSheet('roomMsgMenu','${m.id}')" style="max-width:88%"><div class="row" style="gap:5px;margin-bottom:3px">${av(mu,18)}<span class="tiny b" style="color:${me?"#fff":"var(--accent)"}">${me?"أنت":esc(mu.name)}</span>${w.owner===m.uid?`<span class="badge b-gold">مالك العالم</span>`:""}</div>${roomMsgBody(m,me)}<span class="tm">${hhmm(m.at)}</span></div>`}).join("")||`<div class="empty">${I("globe","l")}<div class="xs b">العالم هادئ</div><div class="tiny fnt">كن أول من يتحدث في ${esc(w.name)}</div></div>`}</div>
    ${S.wReply&&S.wReply.w===w.id?`<div class="row" style="gap:8px;padding:6px 12px;background:var(--surface2);border-top:1px solid var(--line);flex-shrink:0"><span style="color:var(--accent)">${I("reply","i s")}</span><span class="tiny g1" style="text-align:right">رد على: ${esc(((w.msgs||[]).find(x=>x.id===S.wReply.m)||{}).text||"وسائط").slice(0,50)}</span><button class="iconbtn" style="width:26px;height:26px" onclick="S.wReply=null;render()">${I("x","i s")}</button></div>`:""}
    <div class="composer"><button class="iconbtn" onclick="openSheet('attachSheet')" aria-label="إرفاق">${I("plus")}</button>
      <button class="iconbtn" id="wmic" onclick="recGenVoice('world','${w.id}',this)" aria-label="تسجيل صوتي">${I("mic")}</button>
      <textarea id="win" rows="1" placeholder="رسالة في ${esc(w.name)}" oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px'" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendWorldMsg('${w.id}')}"></textarea>
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendWorldMsg('${w.id}')" aria-label="إرسال">${I("send","i s")}</button></div>
  </div>`};
function joinWorld(id){const w=(S.worlds||[]).find(x=>x.id===id);w.joined=true;w.members++;celebrate("انضممت إلى "+w.name+" ");save();render()}
function worldPin(id){const w=(S.worlds||[]).find(x=>x.id===id);if(!w)return;w.pinned=w.pinned?null:((w.msgs[w.msgs.length-1]||{}).text||"إعلان العالم");save();closeOvl();render();toast(w.pinned?"ثُبّت الإعلان أعلى العالم ":"أُلغي التثبيت ","info")}
function leaveWorld(id){const w=(S.worlds||[]).find(x=>x.id===id);if(!confirm("مغادرة "+w.name+"؟"))return;w.joined=false;w.members=Math.max(0,w.members-1);save();closeOvl();go("worlds");toast("غادرت العالم ","info")}
function sendWorldMsg(id){const w=(S.worlds||[]).find(x=>x.id===id);const i=$("#win");if(!w||!i)return;const t=(i.value||"").trim();if(!t)return;i.value="";i.style.height="auto";
  w.msgs.push({id:uid(),uid:"me",text:t,at:now()});save();snd("send");questProgress("q4");
  const b=$("#wbody");if(b){b.insertAdjacentHTML("beforeend",`<div class="msg me" data-ctx="world" style="max-width:88%"><div class="row" style="gap:5px;margin-bottom:3px">${av(S.me,18)}<span class="tiny b" style="color:#fff">أنت</span></div>${linkify(t)}<span class="tm">${hhmm(now())}</span></div>`);b.scrollTop=b.scrollHeight}
  /* v3: عُطّل رد آلي وهمي كان يظهر تلقائياً بعد إرسالك رسالة في غرفة العالم.
   الأصل محفوظ هنا كاملاً ولم يُحذف:
   setTimeout(()=>{if(S.page!=="worldRoom"||S.params.id!==id)return;const r=(S.users||[]).length?S.users[strHash(t+"w")%(S.users||[]).length]:u('bot');const reps=["أجواء العالم اليوم رائعة ","من للمهمة القادمة؟","+1","سأجهز الفريق"];w.msgs.push({id:uid(),uid:r.id,text:reps[strHash(t)%reps.length],at:now()});save();render()},2400)
*/void 0}

function worldAddRule(id){const w=(S.worlds||[]).find(x=>x.id===id);const v=($("#wr_n")||{}).value||"";if(!v.trim()){toast("اكتب القانون أولاً ","err");return}w.rules=w.rules||[];w.rules.push(v.trim());save();toast("أُضيف القانون ","ok");openSheet("worldRules",id)}

function worldToggleFeat(id){const w=(S.worlds||[]).find(x=>x.id===id);w.feat=!w.feat;save();closeOvl();toast(w.feat?"مُيّز العالم ":"أُلغي التمييز ","ok");render()}
function deleteWorld(id){const w=(S.worlds||[]).find(x=>x.id===id);if(!confirm("حذف عالم "+w.name+" نهائياً؟"))return;S.worlds=S.worlds.filter(x=>x.id!==id);save();closeOvl();go("worlds");toast("حُذف العالم ","err")}
function claimGuildQuest(cid,qi,m,r){const p=Math.min(m,strHash(cid+"q"+qi)%(m+1));S.gqDone=S.gqDone||{};
  if(S.gqDone[cid+qi]){toast("استلمت مكافأة هذه المهمة سابقاً ","info");return}
  if(p<m){toast("المهمة غير مكتملة: "+p+"/"+m+" ","err");snd("error");return}
  S.gqDone[cid+qi]=1;addCoins(r,"مهمة نقابية مكتملة");addXP(40,"نشاط نقابي");save();render();celebrate("مهمة نقابية مكتملة!")}
function guildDonate(cid,amt){const c=(S.communities||[]).find(x=>x.id===cid);if(S.coins<amt){toast("رصيدك لا يكفي للتبرع ","err");snd("error");return}
  addCoins(-amt,"تبرع لخزينة "+c.name);c.treasury=(c.treasury||0)+amt;c.tlog=c.tlog||[];c.tlog.unshift({amt:amt,at:now(),by:S.me.name});save();render();toast("شكراً! أُضيف "+amt+" للخزينة ","ok")}

function setGuildRole(cid,uid2,d){const c=(S.communities||[]).find(x=>x.id===cid);const R=["عضو","مقاتل","ضابط","قائد فرقة"];c.roles=c.roles||{};const cur=c.roles[uid2]||"عضو";const ni=Math.max(0,Math.min(R.length-1,R.indexOf(cur)+d));c.roles[uid2]=R[ni];save();toast("رتبة "+u(uid2).name+": "+R[ni]+" ","ok");snd("tap");openSheet("guildRoles",cid)}
/* ============================================================
   20) مركز المجتمع والنقابات (Hub)
   ============================================================ */
PAGES.communityHub=()=>{setNav(false);setHdr(backHdr("المجتمع والنقابات",(S.communities||[]).length+" مجتمع",`<button class="iconbtn" onclick="go('createGuild')">${I("plus")}</button>`));
  return `<div class="pad col">
    <div class="grid3">${[["shield",S.communities.filter(c=>c.type==="guild").length,"نقابة"],["users",S.communities.filter(c=>c.type==="group").length,"مجموعة"],["tv",S.communities.filter(c=>c.type==="channel").length,"قناة"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    <div class="grid3" style="margin-bottom:12px">
      <button class="btn btn-primary btn-sm" onclick="go('createGroup')">${I("users","i s")} قروب</button>
      <button class="btn btn-gold btn-sm" onclick="go('createGuild')">${I("shield","i s")} نقابة</button>
      <button class="btn btn-sec btn-sm" onclick="go('createWorld')">${I("globe","i s")} عالم</button></div>
    <div class="card" style="padding:13px;background:linear-gradient(135deg,rgba(245,158,11,.11),transparent)">
      <div class="b sm">${I("crown","i s")} نقابات النخبة</div><div class="tiny fnt">انضم لنقابة وارتقِ في الرتب</div>
      <div class="col" style="margin-top:10px">${S.communities.filter(c=>c.type==="guild").map(c=>communityRow(c)).join("")}</div></div>
    <div class="secttl"><h3>${I("users","i s")} كل المجتمعات</h3><button class="more" onclick="go('chat');S.chatMode='communities';render()">فتح الدردشة</button></div>
    ${S.communities.map(c=>communityRow(c)).join("")}
    <div class="secttl"><h3>${I("globe","i s")} عوالم أنمي بلاك</h3><button class="more" onclick="go('worlds')">الكل</button></div>
    ${S.worlds.map(w=>`<button class="lstrow" onclick="go('worldRoom',{id:'${w.id}'})">
      <span class="ico-tile" style="background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"i l")}</span>
      <span class="g1" style="text-align:right"><span class="row" style="gap:5px"><span class="b xs">${esc(w.name)}</span>${w.joined?`<span class="badge b-emerald">منضم</span>`:""}</span><span class="tiny fnt">${esc(w.theme)} · ${nfmt(w.members)} عضو · ${w.online} متصل</span></span>${I("fwd","i s")}</button>`).join("")}
  </div>`;
};

/* ============================================================
   21) لوحة التحكم الإدارية المركزية (مخصصة للمدير الأساسي فقط)
   ============================================================ */
PAGES.admin=()=>{
  if(!isPlatformAdmin()){
    setNav(true);
    setHdr(backHdr("تم رفض الوصول","لوحة الإدارة"));
    return `<div class="pad center col" style="padding-top:70px;gap:15px">
      <div style="width:78px;height:78px;border-radius:50%;background:rgba(239,68,68,.14);border:2px solid rgba(239,68,68,.4);display:flex;align-items:center;justify-content:center;color:var(--rose)">${I("shield","xl")}</div>
      <div class="bb sm" style="color:var(--rose);font-size:18px">تم رفض صلاحية الوصول</div>
      <div class="tiny fnt mut" style="max-width:340px;line-height:1.7;text-align:center">لوحة الإدارة المركزية لأنمي بلاك محمية ومخصصة حصرياً للمدير الأساسي للنظام: <b dir="ltr" class="mono" style="color:var(--accent);display:block;margin-top:4px">m774545471@gmail.com</b></div>
      <div class="card2" style="padding:10px 14px;max-width:340px;width:100%;text-align:center">
        <span class="tiny fnt">حسابك الحالي: </span><b class="tiny mono">${esc((S.me&&S.me.email)||S.me.username||'غير مسجل')}</b>
      </div>
      <button class="btn btn-primary btn-sm" style="margin-top:6px;gap:6px" onclick="go('home')">${I("home","i s")} العودة للرئيسية</button>
    </div>`;
  }

  const t=S.params.tab||S.adminTab||"moderation";S.adminTab=t;setNav(false);
  ensureCommunities();
  setHdr(backHdr("الإدارة المركزية — أنمي بلاك","لوحة التحكم والمراقبة العامة",`<span class="badge b-red" style="font-weight:900;letter-spacing:1px">${I("shield","i s")} SUPER ADMIN</span>`));

  const pendingReports=(S.adminReports||[]).filter(r=>r.status==="pending").length;
  const totalUsersCount=(S.users||[]).length + 12480;
  const totalPostsCount=(S.posts||[]).length + 84200;
  const blockedCount=(S.blocked||[]).length;

  return `<div class="pad">
    <!-- رأس لوحة الإدارة الاحترافية -->
    <div style="display:flex;align-items:center;gap:11px;padding:13px 15px;border-radius:16px;background:linear-gradient(135deg,#7F1D1D 0%,#B91C1C 45%,#E60000 85%,#22D3EE 100%);color:#fff;margin:0 0 13px;box-shadow:0 10px 28px rgba(230,0,0,.35);border:1px solid rgba(255,255,255,.2)">
      <span style="display:flex;width:44px;height:44px;border-radius:13px;background:rgba(0,0,0,.35);align-items:center;justify-content:center;line-height:0">${I("shield","l")}</span>
      <div class="g1" style="min-width:0;text-align:right">
        <div class="bb sm" style="letter-spacing:.4px">لوحة الإدارة العليا · SUPER CONTROL</div>
        <div class="tiny mono" style="color:#FECACA;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">الحساب المعتمد: m774545471@gmail.com (صلاحية كاملة)</div>
      </div>
      <span class="badge b-gold mono" style="font-weight:900;padding:4px 8px;font-size:10px">ROOT</span>
    </div>

    <!-- بطاقة الحالة اللحظية والإحصائيات الحية -->
    <div class="card" style="padding:14px;margin-bottom:12px;background:linear-gradient(135deg,rgba(230,0,0,.12),rgba(34,211,238,.05));border-color:rgba(230,0,0,.32)">
      <div class="rowb" style="margin-bottom:10px">
        <div class="row" style="gap:9px">
          <span class="ico-tile" style="width:38px;height:38px;border-radius:12px;background:var(--grad-fire);color:#fff">${I("terminal","i s")}</span>
          <div>
            <div class="bb xs">مؤشرات النظام الحية · Live Telemetry</div>
            <div class="tiny fnt mono" style="color:var(--emerald);display:flex;align-items:center;gap:5px">
              <span style="width:7px;height:7px;border-radius:50%;background:var(--emerald);display:inline-block"></span> متصل بـ Firestore السحابي · زمن الاستجابة 28ms
            </div>
          </div>
        </div>
        <div class="row" style="gap:6px">
          <button class="btn btn-sec btn-xs" onclick="toast('تم تحديث البيانات اللحظية بنجاح ','ok');snd('success');render()" title="تحديث">${I("refresh","i s")} تحديث</button>
          <button class="btn btn-sec btn-xs" onclick="openAdminBroadcastModal()" title="إشعار عام" style="border-color:var(--accent);color:var(--accent)">${I("bell","i s")} بث عام</button>
        </div>
      </div>

      <div class="grid4">
        <div class="card2 stat" style="padding:9px 5px"><span style="color:var(--accent);line-height:0">${I("users","i s")}</span><b class="mono" style="font-size:13px">${nfmt(totalUsersCount)}</b><span>مستخدم</span></div>
        <div class="card2 stat" style="padding:9px 5px"><span style="color:var(--gold);line-height:0">${I("msgsq","i s")}</span><b class="mono" style="font-size:13px">${nfmt(totalPostsCount)}</b><span>منشور</span></div>
        <div class="card2 stat" style="padding:9px 5px"><span style="color:var(--rose);line-height:0">${I("flag","i s")}</span><b class="mono" style="font-size:13px">${pendingReports}</b><span>بلاغ معلّق</span></div>
        <div class="card2 stat" style="padding:9px 5px"><span style="color:var(--muted);line-height:0">${I("ban","i s")}</span><b class="mono" style="font-size:13px">${blockedCount}</b><span>محظور</span></div>
      </div>
    </div>

    <!-- التبويبات الإدارية الشاملة -->
    <div class="tabs" style="margin-bottom:13px;overflow-x:auto;white-space:nowrap;padding-bottom:2px">
      ${[
        ["moderation","الإشراف والبلاغات","shield",pendingReports],
        ["health","صحة المحتوى العامة (Health)","barchart",0],
        ["users","المستخدمون والرتب","users",0],
        ["content","المحتوى والمجتمعات","film",0],
        ["broadcast","البث والتنبيهات","bell",0],
        ["economy","الاقتصاد والمتجر","coins",0],
        ["guard","الحرس الذكي","bot",0],
        ["analytics","التحليلات الحية","chart",0],
        ["tools","الأدوات والطرفية","terminal",0]
      ].map(([k,l,ic,badge])=>`
        <button class="${t===k?'on':''}" onclick="go('admin',{tab:'${k}'},false);snd('tap')" style="gap:6px;flex:none;position:relative">
          ${I(ic,"i s")} <span>${l}</span>
          ${badge?`<span class="badge b-red mono" style="font-size:9px;padding:1px 5px;margin-inline-start:4px">${badge}</span>`:""}
        </button>
      `).join("")}
    </div>

    <!-- جسم التبويب المختار -->
    ${adminTab(t)}
  </div>`;
};

function adminUList(){
  const q=(S.adminUQ||"").trim().toLowerCase();
  const filter=(S.adminUFilter||"all");
  let list=S.users||[];

  if(filter==="verified") list=list.filter(x=>x.isVerified||x.verified);
  else if(filter==="banned") list=list.filter(x=>(S.blocked||[]).includes(x.id)||(S.blocked||[]).includes(x.uid));
  else if(filter==="staff") list=list.filter(x=>["مشرف محتوى","مشرف أول","مدير نظام","admin","Administrator","SuperAdministrator"].includes(x.role));

  if(q){
    list=list.filter(x=>(x.name+x.username+(x.email||"")).toLowerCase().includes(q));
  }

  if(!list.length){
    return `<div class="card2 center tiny mut" style="padding:24px 12px;text-align:center">
      ${I("users","l")}<div class="b xs" style="margin-top:6px">لا مستخدمين مطابقين للبحث</div>
      <div class="tiny fnt">جرّب تغيير كلمة البحث أو مرشح التصفية</div>
    </div>`;
  }

  return list.map(x=>{
    const isBanned=(S.blocked||[]).includes(x.id)||(S.blocked||[]).includes(x.uid);
    return `<div class="card2" style="padding:11px;margin-bottom:8px;border-color:${isBanned?'rgba(239,68,68,.35)':'var(--line)'}">
      <div class="row" style="gap:10px">
        <span style="position:relative;line-height:0">${av(x,42,true)}</span>
        <div class="g1" style="min-width:0;text-align:right">
          <div class="row" style="gap:5px;flex-wrap:wrap">
            <span class="b xs">${esc(x.name)}</span>
            ${vbadge(x)}
            <span class="badge b-cyan" style="font-size:9.5px">${esc(x.role||"عضو")}</span>
            ${isBanned?`<span class="badge b-red">محظور</span>`:""}
          </div>
          <div class="tiny fnt mono" style="margin-top:2px" dir="ltr">@${esc(x.username)} · LV ${x.level||1} · ${nfmt(x.wallet||x.coins||0)} عملة</div>
        </div>
      </div>
      <div class="row wrap" style="gap:6px;margin-top:9px;border-top:1px solid var(--line);padding-top:8px">
        <button class="btn btn-sec btn-xs" onclick="adminRole('${x.id}')" title="ترقية الرتبة">${I("shield","i s")} الرتبة: ${esc(x.role||"عضو")}</button>
        <button class="btn ${x.isVerified||x.verified?'btn-gold':'btn-ghost'} btn-xs" onclick="adminVerify('${x.id}')" title="تبديل التوثيق">${I("check","i s")} ${x.isVerified||x.verified?'إلغاء التوثيق':'توثيق'}</button>
        <button class="btn btn-sec btn-xs" onclick="adminGrantCoins('${x.id}',500)" title="منح عملات">${I("coins","i s")} +500 عملة</button>
        <button class="btn ${isBanned?'btn-emerald':'btn-danger'} btn-xs" onclick="adminBanToggle('${x.id}')">${I("ban","i s")} ${isBanned?'فك الحظر':'حظر'}</button>
        <button class="btn btn-ghost btn-xs" onclick="openProfile('${x.id}')">${I("user","i s")} عرض الملف</button>
      </div>
    </div>`;
  }).join("");
}

function adminUUpd(){const e=$("#adminUList");if(e)e.innerHTML=adminUList()}

function adminRole(id){
  const x=u(id);if(!x)return;
  const rs=["عضو","صانع محتوى","مشرف محتوى","مشرف أول","نائب مدير","مدير نظام"];
  const curIdx=rs.indexOf(x.role);
  x.role=rs[(curIdx+1)%rs.length];
  save();render();
  if(window.db && window.setDoc && window.doc && x.id){
    window.setDoc(window.doc(window.db, "users", x.id), { role: x.role, updatedAt: now() }, {merge: true}).catch(e=>console.error(e));
  }
  toast("رتبة "+x.name+" حُدّثت إلى: "+x.role,"ok");
  snd("success");
}

function adminVerify(id){
  const x=u(id);if(!x)return;
  x.isVerified=!x.isVerified;
  x.verified=x.isVerified;
  if(x.isVerified && !x.verifiedType) x.verifiedType="official";
  save();render();
  if(window.db && window.setDoc && window.doc && x.id){
    window.setDoc(window.doc(window.db, "users", x.id), {
      isVerified: x.isVerified,
      verified: x.isVerified,
      verifiedType: x.isVerified ? (x.verifiedType || "official") : null,
      updatedAt: now()
    }, {merge: true}).catch(e=>console.error(e));
  }
  toast(x.isVerified?"تم توثيق حساب "+x.name+" بشارة التوثيق":"أُزيلت شارة التوثيق عن "+x.name,"ok");
  snd("success");
}

function adminGrantCoins(id,amt){
  const x=u(id);if(!x)return;
  x.coins=(x.coins||0)+amt;
  x.wallet=(x.wallet||0)+amt;
  save();render();
  if(window.db && window.setDoc && window.doc && x.id){
    window.setDoc(window.doc(window.db, "users", x.id), {
      coins: x.coins,
      wallet: x.wallet,
      updatedAt: now()
    }, {merge: true}).catch(e=>console.error(e));
  }
  toast("أُضيفت "+amt+" عملة بنجاح لحساب "+x.name,"ok");
  snd("success");
}

function adminBanToggle(id){
  S.blocked=S.blocked||[];
  const isB=S.blocked.includes(id);
  const targetUser=u(id);
  if(isB){
    S.blocked=S.blocked.filter(x=>x!==id);
    if(targetUser) targetUser.isBanned = false;
    toast("تم فك الحظر عن "+(targetUser?targetUser.name:id),"ok");
  } else {
    S.blocked.push(id);
    if(targetUser) targetUser.isBanned = true;
    toast("تم حظر "+(targetUser?targetUser.name:id)+" من المنصة","err");
  }
  save();render();
  if(window.db && window.setDoc && window.doc && id){
    window.setDoc(window.doc(window.db, "users", id), {
      isBanned: !isB,
      updatedAt: now()
    }, {merge: true}).catch(e=>console.error(e));
  }
}

function adminContent(k,act,id){
  if(k==="posts"){
    if(act==="del"){
      S.posts=S.posts.filter(x=>x.id!==id);
      if(window.db && window.deleteDoc && window.doc){
        window.deleteDoc(window.doc(window.db, "posts", id)).catch(e=>console.error(e));
      }
      toast("حُذف المنشور إدارياً من النظام وقاعدة البيانات","err");
    }
    else{
      const p=(S.posts||[]).find(x=>x.id===id);
      if(p){
        p.pinned=!p.pinned;
        if(window.db && window.setDoc && window.doc){
          window.setDoc(window.doc(window.db, "posts", id), { pinned: p.pinned }, {merge: true}).catch(e=>console.error(e));
        }
        toast(p.pinned?"ثُبّت المنشور في قمة المنصة":"أُلغي تثبيت المنشور","ok");
      }
    }
  } else if(k==="reels"){
    if(act==="del"){
      S.reels=S.reels.filter(x=>x.id!==id);
      if(window.db && window.deleteDoc && window.doc){
        window.deleteDoc(window.doc(window.db, "reels", id)).catch(e=>console.error(e));
      }
      toast("حُذف الريل إدارياً","err");
    }
  } else if(k==="stories"){
    if(act==="del"){
      S.stories=S.stories.filter(x=>x.id!==id);
      if(window.db && window.deleteDoc && window.doc){
        window.deleteDoc(window.doc(window.db, "stories", id)).catch(e=>console.error(e));
      }
      toast("حُذفت القصة إدارياً","err");
    }
  }
  save();render();
}

function adminCom(id,act){
  const c=(S.communities||[]).find(x=>x.id===id);if(!c)return;
  if(act==="close"){
    c.closed=!c.closed;
    toast(c.closed?"أُغلق المجتمع مؤقتاً بأمر الإدارة":"أُعيد فتح المجتمع للأعضاء","err");
  } else {
    c.featured=!c.featured;
    toast(c.featured?"تم تمييز المجتمع في صدارة الاستكشاف":"أُزيل تمييز المجتمع","ok");
  }
  save();render();
}

function adminWorld(id,act){
  const w=(S.worlds||[]).find(x=>x.id===id);if(!w)return;
  if(act==="feat"){
    w.feat=!w.feat;toast(w.feat?"مُيّز العالم في الاستكشاف":"أُلغي التمييز","ok");
  } else {
    w.closed=!w.closed;toast(w.closed?"أُغلق العالم إدارياً":"أُعيد فتح العالم","err");
  }
  save();render();
}

function resolveAppeal(id,ok){
  S.appeals=(S.appeals||[]).map(a=>a.id===id?Object.assign(a,{status:ok?"approved":"rejected"}):a);
  save();render();
  toast(ok?"قُبل الاستئناف ورُفع الإجراء":"رُفض الاستئناف وأُبقي الإجراء",ok?"ok":"err");
}

function openAdminBroadcastModal(){
  openModal("بث إشعار عام للمنصة",`
    <div class="col" style="gap:10px">
      <div class="tiny fnt">سيصل هذا التنبيه لجميع مستخدمي المنصة مباشرةً كإشعار رسمي من الإدارة:</div>
      <label class="lbl">نوع الإشعار</label>
      <div class="chiprow" id="admBcType">
        <button class="chip on" onclick="$$(this.parentNode).forEach(b=>b.classList.remove('on'));this.classList.add('on');window.__bcType='announcement'">${I("bell","i s")} إعلان إداري</button>
        <button class="chip" onclick="$$(this.parentNode).forEach(b=>b.classList.remove('on'));this.classList.add('on');window.__bcType='maintenance'">${I("tool","i s")} صيانة مجدولة</button>
        <button class="chip" onclick="$$(this.parentNode).forEach(b=>b.classList.remove('on'));this.classList.add('on');window.__bcType='event'">${I("calendar","i s")} مسابقة وفعالية</button>
        <button class="chip" onclick="$$(this.parentNode).forEach(b=>b.classList.remove('on'));this.classList.add('on');window.__bcType='reward'">${I("gift","i s")} مكافأة وهدية</button>
      </div>
      <label class="lbl">عنوان الإشعار *</label>
      <input class="inp" id="bc_title" placeholder="مثال: تحديث أمني جديد، فعالية نهاية الأسبوع">
      <label class="lbl">نص الرسالة *</label>
      <textarea class="inp" id="bc_msg" rows="3" placeholder="اكتب نص الإعلان الموجه لجميع الأعضاء..."></textarea>
      <div class="row" style="gap:8px;margin-top:6px">
        <button class="btn btn-primary btn-sm g1" onclick="sendAdminBroadcast()">${I("send","i s")} إرسال البث الآن</button>
        <button class="btn btn-sec btn-sm" onclick="closeOvl()">${I("x","i s")} إلغاء</button>
      </div>
    </div>
  `);
}

function sendAdminBroadcast(){
  const t=($("#bc_title")?$("#bc_title").value:"").trim();
  const m=($("#bc_msg")?$("#bc_msg").value:"").trim();
  const type=window.__bcType||"announcement";
  if(!t || !m){toast("يرجى ملء العنوان ونص الإشعار","err");return}
  
  S.broadcasts=S.broadcasts||[];
  const bcId="bc_"+uid();
  const bcItem={id:bcId,title:t,message:m,type,at:now(),by:S.me.email||"m774545471@gmail.com"};
  S.broadcasts.unshift(bcItem);

  const notifObj={
    id:uid(),
    type:"system",
    actorId:"system",
    title:t,
    text:"📢 إعلان رسمي من الإدارة: "+t+" — "+m,
    createdAt:now(),
    read:false
  };
  S.notifs=S.notifs||[];
  S.notifs.unshift(notifObj);

  if(window.db && window.setDoc && window.doc){
    window.setDoc(window.doc(window.db,"notifications",notifObj.id),notifObj).catch(e=>console.error(e));
    window.setDoc(window.doc(window.db,"broadcasts",bcId),bcItem).catch(e=>console.error(e));
  }

  save();closeOvl();
  toast("تم بث الإشعار بنجاح لجميع مستخدمي المنصة وتزامنه سحابياً ","ok");
  snd("success");
  celebrate("تم إرسال الإشعار العام بنجاح!");
  render();
}

function adminTab(t){
  if(t==="health"){
    return adminHealthDashboard();
  }

  if(t==="moderation"){
    const pending=(S.adminReports||[]).filter(r=>r.status==="pending");
    const resolved=(S.adminReports||[]).filter(r=>r.status!=="pending");
    return `<div class="col" style="gap:12px">
      <div class="rowb">
        <div>
          <div class="b sm">${I("flag","i s")} طابور البلاغات ومراجعة المخالفات</div>
          <div class="tiny fnt">${pending.length} بلاغ معلّق يحتاج اتخاذ قرار</div>
        </div>
        <div class="row" style="gap:6px">
          <button class="btn btn-sec btn-xs" onclick="addMockReport()">${I("plus","i s")} إنشاء بلاغ تجريبي</button>
          <button class="btn btn-emerald btn-xs" onclick="S.adminReports.forEach(r=>r.status='resolved');save();render();toast('تمت تسوية جميع البلاغات ','ok')">${I("check","i s")} حل الكل</button>
        </div>
      </div>

      <div class="chiprow">${[
        ["all","الكل ("+(S.adminReports||[]).length+")"],
        ["pending","معلّق ("+pending.length+")"],
        ["resolved","تمت المعالجة ("+resolved.length+")"]
      ].map(([k,l])=>`
        <button class="chip ${(S.adminRepFilter||'pending')===k?'on':''}" onclick="S.adminRepFilter='${k}';save();render();snd('tap')">${l}</button>
      `).join("")}</div>

      <div class="col" style="gap:10px">
        ${((S.adminReports||[]).filter(r=>(S.adminRepFilter||'pending')==='all'?true:(S.adminRepFilter||'pending')==='pending'?r.status==='pending':r.status!=='pending')).map(r=>{
          const isPending=r.status==="pending";
          const reasonMap={spam:["رسائل مزعجة","b-rose"],harassment:["تنمّر ومضايقة","b-red"],content:["محتوى غير لائق","b-gold"],other:["أخرى","b-gray"]}[r.reason]||["مخالفة","b-gold"];
          return `<div class="card" style="padding:13px;border-color:${isPending?'rgba(245,158,11,.4)':'var(--line)'};background:${isPending?'rgba(245,158,11,.03)':'var(--surface)'}">
            <div class="rowb">
              <div class="row" style="gap:6px">
                <span class="badge ${reasonMap[1]}">${reasonMap[0]}</span>
                <span class="badge ${r.sev==='high'?'b-red':r.sev==='med'?'b-gold':'b-gray'}">خطورة: ${r.sev==='high'?'عالية':r.sev==='med'?'متوسطة':'منخفضة'}</span>
                ${isPending?`<span class="badge b-gold">بانتظار القرار</span>`:`<span class="badge b-emerald">تمت التسوية ✓</span>`}
              </div>
              <span class="tiny fnt mono">${ago(r.at)}</span>
            </div>
            
            <div class="xs" style="margin:9px 0 6px;line-height:1.6">${esc(r.detail||"تفاصيل البلاغ غير محددة")}</div>
            
            <div class="card2 row" style="gap:9px;padding:8px 10px;margin-bottom:10px">
              ${r.target?`${av(r.target,34)}<div class="g1" style="min-width:0;text-align:right"><div class="b tiny">${esc(r.target.name)}</div><div class="tiny fnt mono">@${esc(r.target.username)}</div></div><button class="btn btn-ghost btn-xs" onclick="openProfile('${r.target.id}')">ملف المشكو</button>`:`<div class="tiny fnt g1">محتوى عام غير مرتبط بمستخدم محدد</div>`}
            </div>

            ${isPending?`
            <div class="grid3" style="gap:6px">
              <button class="btn btn-emerald btn-xs" onclick="resolveReport('${r.id}','dismiss')">${I("check","i s")} تجاهل البلاغ</button>
              <button class="btn btn-gold btn-xs" onclick="resolveReport('${r.id}','warn')">${I("alert","i s")} إرسال تحذير</button>
              <button class="btn btn-danger btn-xs" onclick="resolveReport('${r.id}','ban')">${I("ban","i s")} حظر الحساب</button>
            </div>
            <div class="row" style="gap:6px;margin-top:6px">
              <button class="btn btn-sec btn-xs g1" onclick="resolveReport('${r.id}','delete')">${I("trash","i s")} حذف المحتوى المخالف</button>
              <button class="btn btn-sec btn-xs g1" onclick="resolveReport('${r.id}','mute')">${I("mic","i s")} كتم ٢٤ ساعة</button>
            </div>
            `:`
            <div class="rowb tiny fnt" style="padding-top:6px;border-top:1px solid var(--line)">
              <span style="color:var(--emerald)">${I("check","i s")} عولج بواسطة المدير الأساسي</span>
              <button class="btn btn-ghost btn-xs" onclick="const rep=(S.adminReports||[]).find(x=>x.id==='${r.id}');if(rep){rep.status='pending';save();render();toast('أُعيد البلاغ لطابور الانتظار','info')}">إعادة فتح</button>
            </div>
            `}
          </div>`;
        }).join("")||`<div class="card2 center tiny mut" style="padding:24px 12px;text-align:center">${I("check","l")}<div class="b xs" style="margin-top:6px">لا توجد بلاغات في هذا التبويب</div></div>`}
      </div>
    </div>`;
  }

  if(t==="users"){
    return `<div class="col" style="gap:12px">
      <div class="rowb">
        <div>
          <div class="b sm">${I("users","i s")} إدارة المستخدمين والرتب والتوثيق</div>
          <div class="tiny fnt">تحكم مباشر بصلاحيات ورتب وأرصدة جميع الأعضاء</div>
        </div>
        <button class="btn btn-primary btn-xs" onclick="openAdminAddUserModal()">${I("plus","i s")} إضافة عضو</button>
      </div>

      <div class="row" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:12px;padding:9px 12px">
        <span style="color:var(--accent);line-height:0">${I("search","i s")}</span>
        <input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث بالاسم، اسم المستخدم، البريد، أو الرتبة..." value="${esc(S.adminUQ||"")}" oninput="S.adminUQ=this.value;adminUUpd()">
        ${S.adminUQ?`<button class="iconbtn" onclick="S.adminUQ='';adminUUpd();snd('tap')">${I("x","i s")}</button>`:''}
      </div>

      <div class="chiprow">
        ${[["all","الكل"],["staff","طاقم الإدارة"],["verified","الموثقون"],["banned","المحظورون"]].map(([k,l])=>`
          <button class="chip ${(S.adminUFilter||'all')===k?'on':''}" onclick="S.adminUFilter='${k}';save();render();snd('tap')">${l}</button>
        `).join("")}
      </div>

      <div class="col" id="adminUList">${adminUList()}</div>
    </div>`;
  }

  if(t==="content"){
    return `<div class="col" style="gap:12px">
      <div class="b sm">${I("film","i s")} مراقبة طوابير المحتوى والمجتمعات</div>
      <div class="chiprow">${[["posts","المنشورات ("+(S.posts||[]).length+")"],["reels","الريلز ("+(S.reels||[]).length+")"],["stories","القصص ("+(S.stories||[]).length+")"],["communities","المجتمعات ("+(S.communities||[]).length+")"]].map(([k,l])=>`
        <button class="chip ${(S.adminContTab||'posts')===k?'on':''}" onclick="S.adminContTab='${k}';save();render();snd('tap')">${l}</button>
      `).join("")}</div>

      ${(S.adminContTab||'posts')==='posts'?`
        <div class="col" style="gap:8px">
          ${(S.posts||[]).slice(0,10).map(p=>{
            const author=u(p.authorId);
            return `<div class="card" style="padding:12px">
              <div class="rowb">
                <div class="row" style="gap:8px">${av(author,32)}
                  <div><div class="b xs">${esc(author.name)}</div><div class="tiny fnt">${ago(p.createdAt)}</div></div>
                </div>
                ${p.pinned?`<span class="badge b-gold">${I("pin","i s")} مثبت</span>`:''}
              </div>
              <div class="xs" style="margin:8px 0;line-height:1.5">${esc((p.text||"").slice(0,140))}</div>
              <div class="row" style="gap:6px;border-top:1px solid var(--line);padding-top:8px">
                <button class="btn btn-sec btn-xs" onclick="adminContent('posts','pin','${p.id}')">${I("pin","i s")} ${p.pinned?'إلغاء التثبيت':'تثبيت بالقمة'}</button>
                <button class="btn btn-danger btn-xs" onclick="adminContent('posts','del','${p.id}')">${I("trash","i s")} حذف المنشور</button>
                <span class="g1"></span>
                <button class="btn btn-ghost btn-xs" onclick="openComments('${p.id}')">${I("msgsq","i s")} التعليقات</button>
              </div>
            </div>`;
          }).join("")}
        </div>
      `:(S.adminContTab==='reels')?`
        <div class="col" style="gap:8px">
          ${(S.reels||[]).slice(0,8).map(r=>{
            const author=u(r.authorId);
            return `<div class="card2 rowb" style="padding:10px">
              <div class="row" style="gap:8px">${av(author,32)}
                <div><div class="b xs">${esc(r.caption||"فيديو ريل")}</div><div class="tiny fnt">${nfmt(r.views||0)} مشاهدة · ${ago(r.createdAt)}</div></div>
              </div>
              <button class="btn btn-danger btn-xs" onclick="adminContent('reels','del','${r.id}')">${I("trash","i s")} حذف</button>
            </div>`;
          }).join("")}
        </div>
      `:(S.adminContTab==='stories')?`
        <div class="col" style="gap:8px">
          ${(S.stories||[]).slice(0,8).map(st=>{
            const author=u(st.userId);
            return `<div class="card2 rowb" style="padding:10px">
              <div class="row" style="gap:8px">${av(author,32)}
                <div><div class="b xs">قصة ${esc(author.name)}</div><div class="tiny fnt">${ago(st.createdAt)}</div></div>
              </div>
              <button class="btn btn-danger btn-xs" onclick="adminContent('stories','del','${st.id}')">${I("trash","i s")} حذف</button>
            </div>`;
          }).join("")}
        </div>
      `:`
        <div class="col" style="gap:8px">
          ${S.communities.map(c=>`
            <div class="card2 rowb" style="padding:11px">
              <div class="row" style="gap:9px">
                <span class="ico-tile" style="background:linear-gradient(135deg,${c.c1||'#7F1D1D'},${c.c2||'#EA580C'});color:#fff">${I(c.icon||'users','i s')}</span>
                <div>
                  <div class="row" style="gap:5px"><span class="b xs">${esc(c.name)}</span>${c.featured?`<span class="badge b-gold">مميز</span>`:''}${c.closed?`<span class="badge b-red">مغلق</span>`:''}</div>
                  <div class="tiny fnt">${nfmt(c.members||0)} عضو · ${esc(c.type==='guild'?'نقابة':'مجتمع')}</div>
                </div>
              </div>
              <div class="row" style="gap:5px">
                <button class="btn btn-gold btn-xs" onclick="adminCom('${c.id}','feat')">${c.featured?'إلغاء التمييز':'تمييز'}</button>
                <button class="btn btn-sec btn-xs" onclick="adminCom('${c.id}','close')">${c.closed?'فتح':'إغلاق'}</button>
              </div>
            </div>
          `).join("")}
        </div>
      `}
    </div>`;
  }

  if(t==="broadcast"){
    const bcs=S.broadcasts||[];
    return `<div class="col" style="gap:12px">
      <div class="rowb">
        <div>
          <div class="b sm">${I("bell","i s")} نظام البث والإعلانات العامة</div>
          <div class="tiny fnt">إرسال إشعارات جماعية لكافة المستخدمين والتنبيهات العاجلة</div>
        </div>
        <button class="btn btn-primary btn-sm" onclick="openAdminBroadcastModal()">${I("plus","i s")} بث إعلان جديد</button>
      </div>

      <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(34,211,238,.08),transparent)">
        <div class="bb xs" style="color:var(--accent)">قالب البث السريع الفوري</div>
        <div class="tiny fnt" style="margin:4px 0 10px">اختر مناسبة لإرسال إشعار فوري لجميع المستخدمين بنقرة واحدة:</div>
        <div class="grid2">
          <button class="btn btn-sec btn-sm" onclick="quickBroadcast('مكافأة دخول أسبوعية!','تم إيداع 200 عملة مجانية في حساب كل عضو نشط اليوم','reward')">${I("gift","i s")} مكافأة 200 عملة للجميع</button>
          <button class="btn btn-sec btn-sm" onclick="quickBroadcast('بطولة النقابات الكبرى','تبدأ التصفيات الرسمية مساء الجمعة — جهزوا فرقكم!','event')">${I("swords","i s")} إعلان بطولة النقابات</button>
          <button class="btn btn-sec btn-sm" onclick="quickBroadcast('تحديث النظام v25.0','تم تحديث التطبيق وإضافة مميزات الأمان والسرعة الجديدة','announcement')">${I("sparkles","i s")} إعلان تحديث التطبيق</button>
          <button class="btn btn-sec btn-sm" onclick="quickBroadcast('صيانة دورية خفيفة','ستتم ترقية سيرفرات الدردشة لمدة 10 دقائق الليلة','maintenance')">${I("tool","i s")} تنبيه صيانة 10 دقائق</button>
        </div>
      </div>

      <div class="secttl"><h3>${I("list","i s")} سجل الإعلانات المبثوثة (${bcs.length})</h3></div>
      <div class="col" style="gap:8px">
        ${bcs.map(b=>`
          <div class="card2" style="padding:11px">
            <div class="rowb">
              <div class="row" style="gap:6px">
                <span class="badge b-cyan">${esc(b.type||"إعلان")}</span>
                <span class="b xs">${esc(b.title)}</span>
              </div>
              <span class="tiny fnt mono">${ago(b.at)}</span>
            </div>
            <div class="tiny fnt" style="margin:6px 0;line-height:1.5">${esc(b.message)}</div>
            <div class="rowb" style="border-top:1px solid var(--line);padding-top:6px;margin-top:6px">
              <span class="tiny mut">بواسطة: ${esc(b.by)}</span>
              <button class="btn btn-ghost btn-xs" onclick="S.broadcasts=S.broadcasts.filter(x=>x.id!=='${b.id}');save();render();toast('حُذف من السجل','info')">${I("trash","i s")} حذف</button>
            </div>
          </div>
        `).join("")||`<div class="card2 center tiny mut" style="padding:20px">لا توجد إعلانات سابقة مسجلة</div>`}
      </div>
    </div>`;
  }

  if(t==="economy"){
    return `<div class="col" style="gap:12px">
      <div class="grid2">
        ${[
          ["coins",nfmt(1480000),"عملات متداولة بالمنصة"],
          ["trend",nfmt(84200),"عمليات شراء متجر"],
          ["gift",nfmt(3420),"صناديق حظ مفتوحة"],
          ["shield","100%","معدل استقرار الاقتصاد"]
        ].map(([ic,v,l])=>`
          <div class="card2 stat" style="padding:11px"><span style="color:var(--accent);line-height:0">${I(ic,"i s")}</span><b class="mono" style="font-size:16px">${v}</b><span>${l}</span></div>
        `).join("")}
      </div>

      <div class="card" style="padding:13px">
        <div class="rowb">
          <div class="b sm">${I("zap","i s")} أدوات التحكم الاقتصادي السريع</div>
          <span class="badge b-gold">المدير الأساسي</span>
        </div>
        <div class="grid2" style="margin-top:10px;gap:8px">
          <button class="btn btn-gold btn-sm" onclick="addCoins(5000,'منحة الإدارة العليا');addStars(100,'منحة الإدارة العليا');toast('أُضيفت 5000 عملة و100 نجمة لحسابك!','ok');snd('success')">${I("coins","i s")} منح نفسي 5000 عملة و 100 نجمة</button>
          <button class="btn btn-sec btn-sm" onclick="airdropCoinsToAll(300)">${I("gift","i s")} توزيع 300 عملة لكل الأعضاء (Airdrop)</button>
          <button class="btn btn-sec btn-sm" onclick="toast('تمت إعادة ضبط وتوازن تضخم المتجر بنجاح','ok');snd('success')">${I("refresh","i s")} موازنة التضخم المالي</button>
          <button class="btn btn-danger btn-sm" onclick="toast('تم تجميد الصفقات المشبوهة مؤقتاً','err')">${I("ban","i s")} تجميد التحويلات المشبوهة</button>
        </div>
      </div>

      <div class="card" style="padding:13px">
        <div class="b sm">${I("tag","i s")} أسعار عناصر المتجر الرسمية</div>
        <div class="tiny fnt" style="margin-bottom:10px">تعديل فوري لقيمة وأسعار باقات المتجر:</div>
        <div class="col" style="gap:8px">
          ${(S.storeItems||[]).slice(0,6).map(item=>`
            <div class="rowb card2" style="padding:8px 10px">
              <div class="row" style="gap:8px"><span style="color:var(--accent);line-height:0">${I(item.ic||"tag","i s")}</span><span class="xs b">${esc(item.n)}</span></div>
              <div class="row" style="gap:6px">
                <input class="inp mono" style="width:85px;padding:4px 8px;font-size:11px" value="${esc(item.p)}" id="sip_${item.id}">
                <button class="btn btn-sec btn-xs" onclick="const v=$('#sip_${item.id}').value;item.p=v;save();toast('حُفظ سعر '+('${esc(item.n)}'),'ok');snd('success')">حفظ</button>
              </div>
            </div>
          `).join("")}
        </div>
      </div>
    </div>`;
  }

  if(t==="guard"){
    return `<div class="col" style="gap:12px">
      <div class="card" style="padding:14px">
        <div class="rowb">
          <div>
            <div class="b sm">${I("bot","i s")} الحرس الذكي الآلي (AI Guardian)</div>
            <div class="tiny fnt">فحص السبام والكلمات المحظورة والحسابات الوهمية تلقائياً</div>
          </div>
          <span class="sw ${S.guardOn!==false?'on':''}" onclick="S.guardOn=S.guardOn===false?true:false;save();render();toast(S.guardOn?'تم تفعيل الحرس الذكي':'تم إيقاف الحرس الذكي','ok')"></span>
        </div>
        <div class="lbl" style="margin-top:12px">درجة الحساسية الآلية للفلترة</div>
        <div class="grid3">
          ${[["lenient","متساهل (50%)"],["balanced","متوازن (75%)"],["strict","صارم (95%)"]].map(([k,l])=>`
            <button class="chip ${(S.guardSensitivity||'balanced')===k?'on':''}" style="justify-content:center" onclick="S.guardSensitivity='${k}';save();render();toast('حساسية الحرس: ${l}','ok')">${l}</button>
          `).join("")}
        </div>
      </div>

      <div class="card" style="padding:13px">
        <div class="rowb">
          <div class="b sm">${I("filter","i s")} الكلمات المحظورة (Blacklist)</div>
          <button class="btn btn-sec btn-xs" onclick="openAddBadWordModal()">${I("plus","i s")} إضافة كلمة</button>
        </div>
        <div class="chiprow wrap" style="margin-top:9px">
          ${(S.badWords||["spam","hack","شتيمة_1","شتيمة_2","bot_net"]).map(w=>`
            <span class="chip mono" style="font-size:10px;gap:5px">${w} <button style="background:none;border:none;cursor:pointer;color:var(--rose);line-height:0" onclick="removeBadWord('${w}')">${I("x","i s")}</button></span>
          `).join("")}
        </div>
      </div>

      <div class="card" style="padding:13px">
        <div class="b sm">${I("fingerprint","i s")} رادار الحسابات الوهمية والمشبوهة</div>
        <div class="tiny fnt" style="margin-bottom:8px">رصد محاولات إنشاء حسابات متطابقة بالبصمة:</div>
        <div class="col" style="gap:7px">
          ${[["@spam_shadow_99","تكرار رسائل 98%","high"],["@bot_relay_4","بصمة متطابقة 92%","high"],["@alt_fake_11","حساب مشبوه 74%","med"]].map(([uName,desc,sev])=>`
            <div class="rowb card2" style="padding:8px 10px">
              <span class="tiny mono b g1" style="text-align:right">${uName} — <span class="fnt" style="color:var(--${sev==='high'?'rose':'gold'})">${desc}</span></span>
              <button class="btn btn-danger btn-xs" onclick="toast('تم حظر '+('${uName}'),'err');S.blocked=S.blocked||[];S.blocked.push('${uName}');save();render()">${I("ban","i s")} حظر</button>
            </div>
          `).join("")}
        </div>
      </div>
    </div>`;
  }

  if(t==="analytics"){
    return `<div class="col" style="gap:12px">
      <div class="grid2">
        ${[
          ["users",nfmt(totalUsersCount),"إجمالي الأعضاء"],
          ["usercheck","684","متصل الآن"],
          ["trend","+24.6%","معدل النمو الأسبوعي"],
          ["clock","38د","متوسط الجلسة اليومية"]
        ].map(([ic,v,l])=>`
          <div class="card2 stat" style="padding:11px"><span style="color:var(--accent);line-height:0">${I(ic,"i s")}</span><b class="mono" style="font-size:16px">${v}</b><span>${l}</span></div>
        `).join("")}
      </div>

      <div class="card" style="padding:14px">
        <div class="b sm">${I("chart","i s")} تفاعل المستخدمين النشطين (آخر ١٢ أسبوعاً)</div>
        <div style="margin-top:10px">${svgChart([820,940,1100,980,1240,1380,1520,1440,1680,1740,1890,2010])}</div>
      </div>

      <div class="card" style="padding:13px">
        <div class="b sm">${I("globe","i s")} التوزيع الجغرافي للأعضاء</div>
        <div class="col" style="margin-top:10px;gap:8px">
          ${[["السعودية",34],["مصر",22],["اليمن",19],["العراق",12],["المغرب",8],["أخرى",5]].map(([c,v])=>`
            <div>
              <div class="rowb tiny b"><span>${c}</span><span class="mono">${v}%</span></div>
              <div class="bar" style="height:5px;margin-top:4px"><i style="width:${v*2.8}%;background:var(--grad-fire)"></i></div>
            </div>
          `).join("")}
        </div>
      </div>

      <div class="card" style="padding:13px">
        <div class="b sm">${I("db","i s")} مراقبة وتوافر خدمات النظام السحابية</div>
        <div class="col" style="margin-top:10px;gap:7px">
          ${[
            ["Google Firestore Database","متصل 100%","emerald",99],
            ["Firebase Authentication","مؤمّن 100%","emerald",100],
            ["Cloud Run Edge Reverse Proxy","متصل Port 3000","emerald",100],
            ["Gemini AI Integration Engine","جاهز ونشط","emerald",98],
            ["Cloud Media & Static Storage","متصل 100%","emerald",94]
          ].map(([svc,st,col,pct])=>`
            <div class="rowb card2" style="padding:8px 10px">
              <div class="row" style="gap:7px"><span class="badge b-${col}">${st}</span><span class="xs b">${svc}</span></div>
              <span class="tiny mono fnt">${pct}%</span>
            </div>
          `).join("")}
        </div>
      </div>
    </div>`;
  }

  // default: t === "tools"
  return `<div class="col" style="gap:12px">
    <div class="card" style="padding:14px">
      <div class="rowb">
        <div class="b sm">${I("terminal","i s")} طرفية الإدارة المتقدمة (Super CLI)</div>
        <span class="badge b-emerald mono">CLI READY</span>
      </div>
      <div class="mono tiny" style="background:#05050A;color:#4ADE80;padding:12px;border-radius:12px;margin-top:10px;min-height:120px;overflow-y:auto;max-height:200px;line-height:1.7;border:1px solid rgba(74,222,128,.2)" id="termout">$ animeblack super-admin shell v25.0
$ مصرح لـ: m774545471@gmail.com
$ جميع الصلاحيات الجذرية متاحة. اكتب help لعرض الأوامر.</div>
      <div class="row" style="gap:7px;margin-top:9px">
        <span class="mono b" style="color:var(--accent);font-size:16px">$</span>
        <input class="inp g1 mono" id="termin" placeholder="اكتب أمراً هنا مثل help أو stats..." dir="ltr" onkeydown="if(event.key==='Enter')runTerm()">
        <button class="btn btn-primary btn-sm" onclick="runTerm()">${I("terminal","i s")} تنفيذ</button>
      </div>
      <div class="chiprow wrap" style="margin-top:9px">
        ${["help","stats","users list","broadcast سلام للجميع","give @user 500","backup","clear cache","health","rules"].map(c=>`
          <button class="chip mono" style="font-size:9px" onclick="(()=>{const _t=document.getElementById('termin');if(_t)_t.value='${c}'})();runTerm()">${c}</button>
        `).join("")}
      </div>
    </div>

    <div class="grid2">
      <button class="btn btn-sec" onclick="downloadData()">${I("download","i s")} تنزيل نسخة JSON احتياطية</button>
      <button class="btn btn-sec" onclick="openAdminBroadcastModal()">${I("bell","i s")} بث إشعار عام</button>
      <button class="btn btn-sec" onclick="go('devCenter')">${I("code","i s")} بوابة المطورين و Bots</button>
      <button class="btn btn-sec" onclick="openSheet('firestoreSheet')">${I("db","i s")} فحص قواعد Firestore</button>
      <button class="btn btn-danger" onclick="toast('تم مسح الكاش المؤقت للنظام ','ok');snd('success')">${I("trash","i s")} مسح الكاش المؤقت</button>
      <button class="btn btn-ghost" onclick="toast('تم فحص سجل التدقيق الأمني: 0 ثغرات','ok');snd('success')">${I("shield","i s")} فحص التدقيق الأمني</button>
    </div>

    <div class="card2" style="padding:12px">
      <div class="b xs" style="margin-bottom:6px">${I("shield","i s")} رتب ومستويات RBAC الإدارية</div>
      <div class="chiprow wrap">
        ${["SuperAdministrator (m774545471@gmail.com)","Administrator","SeniorModerator","ContentModerator","TraineeModerator"].map(r=>`<span class="chip mono" style="font-size:9.5px">${r}</span>`).join("")}
      </div>
    </div>
  </div>`;
}

function resolveReport(id,act){
  const r=(S.adminReports||[]).find(x=>x.id===id);
  if(r) r.status="resolved";
  if(act==="ban" && r && r.target){
    S.blocked=S.blocked||[];
    if(!S.blocked.includes(r.target.id)) S.blocked.push(r.target.id);
  } else if(act==="warn" && r && r.target){
    S.notifs=S.notifs||[];
    S.notifs.unshift({
      id:uid(),
      type:"system",
      actorId:"system",
      text:"⚠️ تحذير رسمي من الإدارة: تم رصد مخالفة في حسابك بناءً على بلاغ، يرجى الالتزام بالقوانين.",
      createdAt:now(),
      read:false
    });
  }
  const msg={dismiss:"تم تجاهل البلاغ وإغلاقه",warn:"أُرسل تحذير رسمي للمستخدم",ban:"تم حظر المستخدم بنجاح",delete:"حُذف المحتوى المخالف إدارياً",mute:"تم كتم المستخدم ٢٤ ساعة"}[act]||"تمت معالجة البلاغ";
  toast(msg,act==="ban"||act==="delete"?"err":"ok");
  snd("success");save();render();
}

function addMockReport(){
  S.adminReports=S.adminReports||[];
  const sampleTarget=S.users && S.users[0] ? S.users[0] : {id:"u_test",name:"مستخدم مخالف",username:"spammer_otaku",level:2};
  S.adminReports.unshift({
    id:"rep_"+uid(),
    reason:"spam",
    sev:"med",
    detail:"نشر روابط وإعلانات متكررة في غرف الدردشة بدون إذن",
    target:sampleTarget,
    by:{id:"me",name:"المبلّغ"},
    at:now(),
    status:"pending"
  });
  save();render();
  toast("تمت إضافة بلاغ تجريبي جديد لقائمة الفحص","ok");
}

function quickBroadcast(title,msg,type){
  window.__bcType=type;
  S.broadcasts=S.broadcasts||[];
  const bcId="bc_"+uid();
  const bcItem={id:bcId,title,message:msg,type,at:now(),by:"m774545471@gmail.com"};
  S.broadcasts.unshift(bcItem);

  const notifObj={
    id:uid(),
    type:"system",
    actorId:"system",
    title,
    text:"📢 "+title+": "+msg,
    createdAt:now(),
    read:false
  };
  S.notifs=S.notifs||[];
  S.notifs.unshift(notifObj);

  if(window.db && window.setDoc && window.doc){
    window.setDoc(window.doc(window.db,"notifications",notifObj.id),notifObj).catch(e=>console.error(e));
    window.setDoc(window.doc(window.db,"broadcasts",bcId),bcItem).catch(e=>console.error(e));
  }

  save();toast("تم البث وتزامنه بنجاح!","ok");snd("success");celebrate(title);render();
}

function airdropCoinsToAll(amt){
  (S.users||[]).forEach(usr=>{
    usr.coins=(usr.coins||0)+amt;
    usr.wallet=(usr.wallet||0)+amt;
    if(window.db && window.setDoc && window.doc && usr.id){
      window.setDoc(window.doc(window.db,"users",usr.id),{coins:usr.coins,wallet:usr.wallet,updatedAt:now()},{merge:true}).catch(e=>console.error(e));
    }
  });
  addCoins(amt,"إسقاط جوي جماعي");
  save();celebrate("أُسقطت "+amt+" عملة لكل الأعضاء وتزامنت سحابياً!");
  snd("success");render();
}

