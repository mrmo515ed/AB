function T(ar){return S.langEn?(TT[ar]||ar):ar}
var ctxTimer=null;
function closeCtx(){document.querySelectorAll(".ctxmenu").forEach(m=>m.remove())}
function showCtx(el,x,y){
  const spec=(el.getAttribute("data-ctx")||"").split(":");const kind=spec[0],id=spec.slice(1).join(":");
  closeCtx();
  window.__ctxTxt=(el.innerText||"").trim().slice(0,200);
  const items=[["copy","نسخ النص","ctxCopy()",0]];
  if(kind==="post")items.push(["bookmark2","حفظ","ctxAct('save','"+id+"')",0],["share","مشاركة","closeCtx();openSheet('shareSheet')",0],["eyeoff","إخفاء","ctxAct('hide','"+id+"')",0],["flag","إبلاغ","closeCtx();go('report',{id:'"+id+"'})",1]);
  else if(kind==="msg"){closeCtx();openSheet('msgMenu',id);return}
  else if(kind==="cmt")items.push(["reply","رد","closeCtx();var i=$('#cmtinp');if(i){i.focus()}",0],["trash","حذف","ctxAct('delcmt','"+id+"')",1],["flag","إبلاغ","closeCtx();go('report')",1]);
  const d=document.createElement("div");d.className="ctxmenu";
  d.style.left=Math.max(8,Math.min(x||120,innerWidth-190))+"px";
  d.style.top=Math.max(8,Math.min(y||200,innerHeight-items.length*42-20))+"px";
  d.innerHTML=items.map(([ic,l,fn,dg])=>`<button class="${dg?'danger':''}" onclick="${fn}">${I(ic,"i s")}<span>${T(l)}</span></button>`).join("");
  document.body.appendChild(d);snd("tap");
  setTimeout(()=>document.addEventListener("click",closeCtx,{once:true}),20);
}
function ctxCopy(){const t=window.__ctxTxt||"";closeCtx();
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(()=>toast("نُسخ النص","ok"),()=>toast("تعذّر النسخ","err"))}
  else toast("نُسخ النص","info")}
function ctxAct(a,id){closeCtx();
  if(a==="save"){toast("حُفظ في مفضلتك","ok");snd("success")}
  else if(a==="hide"){S.hidden=S.hidden||[];S.hidden.push(id);save();render();toast("أُخفي المنشور","ok")}
  else if(a==="mute"){toast("تم كتم هذا العضو","ok");snd("success")}
  else if(a==="delcmt"){const e=document.getElementById("cm_"+id);if(e){e.style.transition="opacity .25s";e.style.opacity="0";setTimeout(()=>{e.remove();toast("حُذف التعليق","ok")},260)}else toast("حُذف التعليق","ok")}
}
if(typeof document!=="undefined"&&document.addEventListener){
  document.addEventListener("contextmenu",function(e){const t=e.target.closest?e.target.closest("[data-ctx]"):null;if(!t)return;e.preventDefault();showCtx(t,e.clientX,e.clientY)});
  document.addEventListener("touchstart",function(e){const t=e.target.closest?e.target.closest("[data-ctx]"):null;if(!t)return;if(e.target.closest("button,a,input,textarea,.chip,.act,.iconbtn"))return;const tc=e.touches[0]||{};ctxTimer=setTimeout(()=>{showCtx(t,tc.clientX,tc.clientY);if(navigator.vibrate)navigator.vibrate(25)},520)},{passive:true});
  ["touchend","touchmove","touchcancel"].forEach(ev=>document.addEventListener(ev,()=>clearTimeout(ctxTimer),{passive:true}));
  document.addEventListener("keydown",e=>{
    if(e.key==="Escape"){closeCtx();closeOvl();return}
    const tg=e.target;if(!S.user||(tg&&(tg.tagName==="INPUT"||tg.tagName==="TEXTAREA"||tg.isContentEditable))||e.metaKey||e.ctrlKey||e.altKey)return;
    const k=e.key;
    if(k>="1"&&k<="5"){tab(["home","explore","create","chat","more"][+k-1]);e.preventDefault()}
    else if(k==="?"||(e.code==="Slash"&&e.shiftKey)){e.preventDefault();openSheet("shortcuts")}
    else if(e.code==="Slash"){e.preventDefault();go("search")}
    else if(k==="n"||k==="N"){e.preventDefault();go("notifications")}
  });
}
const API={
  config:()=>({firebase:(S.apiKeys&&S.apiKeys.firebase)||"",gemini:(S.apiKeys&&S.apiKeys.gemini)||""}),
  mode:()=>((S.apiKeys&&S.apiKeys.firebase)?"cloud":"local"),
  auth:{login:(u,p)=>Promise.resolve({ok:true,uid:"me",mode:API.mode()}),logout:()=>Promise.resolve({ok:true})},
  db:{get:k=>Promise.resolve(S[k]),set:(k,v)=>Promise.resolve((S[k]=v,save(),{ok:true}))},
  ai:{suggest:q=>Promise.resolve("بناءً على ذوقك: فريرن وما بعد النهاية، وهجوم العمالقة")}};
if(typeof window!=="undefined")window.AnimeBlackAPI=API;
function netOk(){return (typeof navigator==="undefined"||typeof navigator.onLine==="undefined"||navigator.onLine)&&!S.forceOffline}
function netbar(show){let e=$("#netbar");if(!e){e=document.createElement("div");e.id="netbar";document.body.appendChild(e)}
  e.innerHTML=I("wifi","i s")+"<span>"+T("لا يوجد اتصال — ستُحفظ الإجراءات وتُرسل تلقائياً")+"</span>";e.style.display=show?"none":"flex"}

function syncPostToCloud(p){
  if(!p || !p.id) return;
  p.pending = true;
  delete p.failed;
  S.pendingPosts = S.pendingPosts || [];
  if (!S.pendingPosts.some(x => x && x.id === p.id)) {
    S.pendingPosts.push({ id: p.id, post: p, at: now() });
  }
  save();
  if(window.db && window.setDoc && window.doc){
    try {
      const curUid = (window.auth && window.auth.currentUser) ? window.auth.currentUser.uid : (S.me.id || "me");
      const dbp = Object.assign({}, p, {
        authorId: curUid,
        author: {
          id: curUid,
          name: S.me.name || "أوتاكو",
          username: S.me.username || "otaku",
          avatar: S.me.avatar || AV[0],
          isVerified: !!S.me.isVerified,
          role: S.me.role || "Member",
          level: S.me.level || 1
        },
        media: p.media || null,
        pending: false
      });
      window.setDoc(window.doc(window.db, "posts", p.id), dbp)
        .then(() => {
          p.pending = false;
          delete p.failed;
          S.pendingPosts = (S.pendingPosts || []).filter(x => x && x.id !== p.id);
          save();
          const pendEl = document.getElementById("pend_" + p.id);
          if(pendEl) pendEl.remove();
        })
        .catch(err => {
          console.warn("Post sync pending latency/offline:", err);
          p.pending = true;
          p.failed = true;
          save();
          const pendEl = document.getElementById("pend_" + p.id);
          if(pendEl) pendEl.outerHTML = `<button class="badge b-red tiny" style="padding:1px 6px;gap:3px;font-size:10px;cursor:pointer" id="pend_${p.id}" onclick="retryPendingPost('${p.id}')">${I("refresh","i s")} إعادة المحاولة</button>`;
        });
    } catch(err) {
      p.pending = true;
      p.failed = true;
      save();
    }
  }
}

function retryPendingPost(pid){
  const p = (S.posts || []).find(x => x.id === pid);
  if(!p) return;
  toast("جارٍ إعادة محاولة نشر المنشور...", "info");
  syncPostToCloud(p);
  if(['home', 'explore', 'profile', 'postDetail'].includes(S.page)) render();
}

function syncChatMessage(cid, msgObj){
  if(!cid || !msgObj || !msgObj.id) return;
  msgObj.pending = true;
  msgObj.st = msgObj.st || 1;
  delete msgObj.failed;
  S.pendingMsgs = S.pendingMsgs || [];
  if(!S.pendingMsgs.some(x => x && x.mid === msgObj.id)){
    S.pendingMsgs.push({ cid, mid: msgObj.id, msg: msgObj, at: now() });
  }
  save();
  if(window.db && window.setDoc && window.doc){
    try {
      const myUid = getMyUid();
      const cloudMsg = Object.assign({}, msgObj, {
        senderId: msgObj.senderId || myUid,
        senderName: msgObj.senderName || S.me.name || "أنا",
        pending: false,
        st: 2
      });
      window.setDoc(window.doc(window.collection(window.db, "chats", cid, "messages"), msgObj.id), cloudMsg)
        .then(() => {
          msgObj.pending = false;
          msgObj.st = 2;
          delete msgObj.failed;
          S.pendingMsgs = (S.pendingMsgs || []).filter(x => x && x.mid !== msgObj.id);
          save();
          const mEl = document.getElementById("m_" + msgObj.id);
          if(mEl){
            const tmEl = mEl.querySelector(".tm");
            if(tmEl) tmEl.innerHTML = metaHTML(msgObj);
          }
          const otherUid = (S.chats || []).find(x => x.id === cid)?.userId || "user_friend";
          window.setDoc(window.doc(window.db, "chats", cid), {
            id: cid,
            participants: [myUid, otherUid].filter(Boolean),
            last: msgObj.type === "sticker" ? "ملصق" : (msgObj.text || "رسالة"),
            lastAt: msgObj.at || now(),
            lastSenderId: myUid,
            updatedAt: now()
          }, { merge: true }).catch(e => console.warn(e));
        })
        .catch(err => {
          console.warn("Message sync pending latency/offline:", err);
          msgObj.pending = true;
          msgObj.failed = true;
          save();
          const mEl = document.getElementById("m_" + msgObj.id);
          if(mEl){
            const tmEl = mEl.querySelector(".tm");
            if(tmEl) tmEl.innerHTML = metaHTML(msgObj);
          }
        });
    } catch(err) {
      msgObj.pending = true;
      msgObj.failed = true;
      save();
    }
  }
}

function retryPendingMsg(cid, mid){
  const chatCid = cid || S.activeChat || (S.params && S.params.id);
  const c = (S.chats || []).find(x => x.id === chatCid);
  if(!c) return;
  const m = (c.messages || []).find(x => x.id === mid);
  if(!m) return;
  toast("جارٍ إعادة إرسال الرسالة...", "info");
  syncChatMessage(chatCid, m);
  const mEl = document.getElementById("m_" + mid);
  if(mEl){
    const tmEl = mEl.querySelector(".tm");
    if(tmEl) tmEl.innerHTML = metaHTML(m);
  }
}

function flushOffQ(){
  if(!netOk()) return;
  let n = 0;
  if(S.pendingPosts && S.pendingPosts.length > 0){
    const pList = S.pendingPosts.slice();
    pList.forEach(item => {
      const p = (S.posts || []).find(x => x.id === item.id) || item.post;
      if(p && (p.pending || p.failed)){ syncPostToCloud(p); n++; }
    });
  }
  if(S.pendingMsgs && S.pendingMsgs.length > 0){
    const mList = S.pendingMsgs.slice();
    mList.forEach(item => {
      const c = (S.chats || []).find(x => x.id === item.cid);
      const m = c ? (c.messages || []).find(x => x.id === item.mid) : item.msg;
      if(c && m && (m.pending || m.failed)){ syncChatMessage(item.cid, m); n++; }
    });
  }
  const q = S.offQ || [];
  if(q.length > 0){
    S.offQ = [];
    q.forEach(e => {
      if(e.t === "msg"){
        const c = (S.chats || []).find(x => x.id === e.cid);
        if(c){
          const m = (c.messages || []).find(x => x.id === e.mid);
          if(m){ syncChatMessage(e.cid, m); n++; }
        }
      } else if(e.t === "post" && e.txt){
        publishNow(e.type || "post");
        n++;
      }
    });
  }
  netbar(true);
  save();
  if(n > 0){
    toast("تمت مزامنة " + n + " من العناصر المعلّقة مع السحابة", "ok");
    snd("success");
    if(['home', 'explore', 'chatRoom'].includes(S.page)) render();
  }
}

if(typeof window!=="undefined"&&window.addEventListener){
  window.addEventListener("offline",()=>{netbar(false);toast("انقطع الاتصال — تم تفعيل الحفظ المحلي الفوري","err")});
  window.addEventListener("online",()=>{flushOffQ()});
  setInterval(()=>{ if(netOk()) flushOffQ(); }, 14000);
}
const ARIA={home:"الرئيسية",compass:"استكشف",plus:"إنشاء",chat:"الرسائل",more:"المزيد",bell:"الإشعارات",mail:"بريد Gmail",back:"رجوع",x:"إغلاق",search:"بحث",settings:"إعدادات",shield:"الإدارة",heart:"إعجاب",msgsq:"تعليق",share:"مشاركة",bookmark:"حفظ",phone:"مكالمة",video:"مكالمة فيديو",phoneoff:"إنهاء المكالمة",mic:"الميكروفون",mute:"كتم",camera:"كاميرا",gift:"هدية",send:"إرسال",play:"تشغيل",pause:"إيقاف مؤقت",zoomin:"تكبير",zoomout:"تصغير",qr:"بطاقتي",edit:"تعديل",trash:"حذف",flag:"إبلاغ",eyeoff:"إخفاء",pin:"تثبيت",copy:"نسخ",link:"رابط",download:"تحميل",upload:"رفع",refresh:"تحديث",filter:"تصفية",globe:"اللغة",sun:"وضع نهاري",moon:"وضع ليلي",user:"الملف الشخصي",users:"الأعضاء",lock:"خاص",unlock:"عام",check:"تأكيد",alert:"تنبيه",info:"معلومات",help:"مساعدة",logout:"خروج",key:"مفتاح",code:"المطورون",terminal:"طرفية",bot:"بوت",wand:"تأثيرات",star:"نجمة",crown:"تاج",trophy:"كأس",coins:"عملات",wallet:"محفظة",tag:"سعر",save:"حفظ",archive:"أرشيف",folder:"مجلد",clock:"الوقت",calendar:"تقويم",chart:"إحصاءات",barchart:"مخطط",trend:"رائج",zap:"سريع",flame:"رائع",snow:"بارد",sakura:"ساكورا",gem:"جوهرة",gamepad:"ألعاب",music:"موسيقى",film:"فيديو",clapper:"ريل",book:"مانجا",map:"خريطة",wifi:"الشبكة",cloud:"سحابة",screen:"شاشة",radio:"بث",volume:"مكبر",headphones:"صوت",at:"إشارة",hash:"هاشتاق",reply:"رد",fwd:"تمرير",fwd2:"إعادة إرسال",pen:"كتابة",quote:"اقتباس",layers:"أقسام",grid:"شبكة",list:"قائمة",inbox:"وارد",pen:"قلم",eye:"مشاهدة",eyeoff:"إخفاء",fingerprint:"بصمة",max:"ملء الشاشة",logout:"خروج",qr:"رمز",camera:"صورة",image:"صورة",video:"فيديو",file:"ملف",gift:"هدية",award:"وسام",target:"هدف",chart:"تحليلات",wifi:"اتصال",volume:"صوت",mute:"كتم الصوت",screen:"مشاركة شاشة",wand:"سحر",rocket:"انطلاق",grid:"شبكة",list:"قائمة",inbox:"صندوق",folder:"مجلد",reply:"رد",fwd:"تحويل",fwd2:"إعادة",swords:"قتال",fire2:"لهب",bookmark2:"مفضلة"};
function ariaPass(){document.querySelectorAll("button:not([aria-label])").forEach(b=>{const t=(b.textContent||"").trim();if(t)return;const u=b.querySelector("use");if(!u)return;const ic=(u.getAttribute("href")||"").slice(3);if(ARIA[ic])b.setAttribute("aria-label",ARIA[ic])})}
function coverBlock(){
  const h={"169":150,"31":104,"45":196}[String(S.me.coverRatio||"169")]||150;
  const pos=(S.me.coverPos==null?50:S.me.coverPos);
  const img=S.me.cover?("background:url('"+S.me.cover+"') center "+pos+"%/cover;"):S.me.coverG?("background:linear-gradient(135deg,"+S.me.coverG[0]+","+S.me.coverG[1]+");"):"";
  return `<div class="art-bg" style="--c1:#7F1D1D;--c2:#EA580C;height:${h}px;position:relative;${img}">`;
}
function backHdr(title,sub,actions=""){
  title=T(title);sub=T(sub);
  return `<div style="display:flex;align-items:center;gap:9px">
    <button class="hbox" onclick="back()">${I("back")}</button>
    <div class="g1"><div class="b" style="font-size:14px;line-height:1.25">${title}</div>${sub?`<div class="tiny fnt">${sub}</div>`:""}</div>
    ${actions}</div>`;
}
function setHdr(html){$("#hdr").innerHTML=html;$("#hdr").style.display=html?"flex":"none"}
function setNav(on){
  const fab=$("#homeFab");
  if(!on){
    $("#nav").style.display="none";
    if(fab)fab.style.display="none";
    return;
  }
  $("#nav").style.display="flex";
  const L=(ar,en)=>S.langEn?en:ar;
  const items=[["home","home",L("الرئيسية","Home")],["explore","compass",L("استكشف","Explore")],["reels","clapper",L("الريلز","Reels")],["chat","chat",L("الرسائل","Chats")],["more","more",L("المزيد","More")]];
  $("#nav").innerHTML=items.map(([k,ic,lb])=>`
    <button class="${S.activeTab===k?"on":""}" onclick="tab('${k}')" ${k==="home"?`onpointerdown="navLPStart(event)" onpointerup="navLPEnd()" onpointerleave="navLPEnd()"`:""}>
      ${k==="home"&&S.hasNewPosts?`<span class="ping"></span>`:""}
      ${I(ic)}
      <span class="ndot"></span>
      <span>${lb}</span>
    </button>`).join("");
  if(fab){
    fab.style.display=(S.page==="home")?"flex":"none";
  }
}
let __lp=null;
function navLPStart(e){__lp=setTimeout(()=>{__lp="shown";
  const t=document.createElement("div");t.id="navtip";
  t.innerHTML=`<span style="font-size:10px;letter-spacing:2px;color:#22D3EE;font-weight:900">${S.langEn?"UNREAD":"غير مقروء"}</span><span class="mono b xs" style="background:#222;border:1px solid #333;padding:2px 9px;border-radius:8px">${unreadTotal()}</span>`;
  document.body.appendChild(t);haptic("غير مقروء: "+unreadTotal());
  setTimeout(()=>{const x=$("#navtip");if(x)x.remove()},2200);
},520)}
function navLPEnd(){if(__lp&&__lp!=="shown")clearTimeout(__lp);__lp=null}
function unreadTotal(){
  return S.chats.reduce((a,c)=>a+(c.unread||0),0)+S.communities.reduce((a,c)=>a+c.channels.reduce((x,ch)=>x+(ch.unread||0),0),0)+S.notifs.filter(n=>!n.read).length;
}
function addCoins(n,reason){S.coins+=n;S.me.coins=S.coins;if(reason)toast((n>0?"+":"")+n+" عملة سوداء · "+reason,"ok");snd("coin");save()}
function addStars(n,reason){S.stars+=n;S.me.stars=S.stars;if(reason)toast((n>0?"+":"")+n+" نجمة مشعة · "+reason,"ok");snd("coin");save()}
function addXP(n,reason){S.me.xp+=n;if(S.me.xp>=S.me.xpNext){S.me.level++;S.me.xp-=S.me.xpNext;S.me.xpNext=Math.round(S.me.xpNext*1.25);celebrate(" ترقيت إلى المستوى "+S.me.level+"!")}else if(reason)toast("+"+n+" XP · "+reason,"ok");snd("success");save()}
function questProgress(qid,n=1){const q=((S.me&&S.me.quests)||[]).find(x=>x.id===qid);if(!q||q.p>=q.max)return;if(q.p<q.max){q.p=Math.min(q.max,q.p+n);if(q.p>=q.max){addCoins(q.r,"مهمة مكتملة: "+q.t);celebrate(" مهمة مكتملة: "+q.t)}}save()}
function follow(id){
  const tu=u(id);
  if(S.following.includes(id)){
    S.following=S.following.filter(x=>x!==id);
    tu.followers=Math.max(0,(tu.followers||1)-1);
    toast("ألغيت متابعة "+tu.name,"info");
  } else {
    S.following.push(id);
    tu.followers=(tu.followers||0)+1;
    addXP(10);
    toast("تتابع الآن "+tu.name+" ","ok");
  }
  snd("tap");save();render();
  if(window.auth&&window.auth.currentUser&&window.db){
    const myUid=window.auth.currentUser.uid;
    window.setDoc(window.doc(window.db,"users",myUid),{following_list:S.following,following:(S.following||[]).length},{merge:true}).catch(e=>console.error(e));
    if(id!=="me"&&id!==myUid){
      window.setDoc(window.doc(window.db,"users",id),{followers:tu.followers},{merge:true}).catch(e=>console.error(e));
    }
  }
}
function unblockUser(id){S.blocked=(S.blocked||[]).filter(x=>x!==id);save();render();toast("أُلغي حظر "+u(id).name+" — يمكنك مراسلته مجدداً ","ok")}
function blockUser(id){const had=!S.blocked.includes(id);if(had)S.blocked.push(id);toast("تم حظر "+u(id).name,"err",had?()=>{S.blocked=S.blocked.filter(x=>x!==id);save();render();toast("أُلغي الحظر ","ok")}:null);save();render()}
function openProfile(id){
  if(!id || isMe(id)){
    go("profile");
  } else {
    go("publicProfile",{id});
  }
}
function openComments(pid){go("comments",{pid})}
function openNotif(id){const n=(S.notifs||[]).find(x=>x.id===id);if(!n)return;n.read=true;save();go("notifDetail",{id})}
function markAllRead(){S.notifs.forEach(n=>n.read=true);save();toast("تم تعليم كل الإشعارات كمقروءة","ok");render()}
function reportUser(id){go("report",{id})}

/* ============================================================
   3) صفحة: شاشة التحميل (Splash)
   ============================================================ */
PAGES.splash=()=>{
  setHdr("");setNav(false);
  const steps=["جاري تحميل الأنظمة...","تهيئة Firestore المحلي...","تحميل واجهة الأوتاكو...","جاهز "];
  clearInterval(window.__splashT);let i=0;window.__splashT=setInterval(()=>{i++;const e=$("#splashtxt");if(e)e.textContent=steps[Math.min(i,steps.length-1)];if(i>=steps.length){clearInterval(window.__splashT);setTimeout(()=>{if(S.page!=="splash")return;S.user?go("home",{},false):go("login",{},false)},450)}},420);
  return `<div class="pad" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:14px;text-align:center">
    <img class="logoimg" src="data:image/jpeg;base64," alt="أنمي بلاك" style="width:92px;height:92px;border-radius:28px;box-shadow:0 0 50px rgba(34,211,238,.5)">
    <div><div class="bb grad-txt" style="font-size:22px;letter-spacing:2px">ANIME BLACK</div><div class="tiny mut">منصة التواصل الفاخرة لعشاق الأنمي والمانجا</div></div>
    <div style="width:160px" class="bar"><i style="animation:load 1.9s ease forwards"></i></div>
    <div class="tiny fnt mono" id="splashtxt">جاري تحميل الأنظمة...</div>
    <div class="tiny mono" style="opacity:.55;margin-top:6px">الإصدار ٢٥٫٠ · إتقان النشر والمجتمعات · استوديوهات نشر لكل نوع، غرف كاملة الميزات، فعاليات بأغلفة ومشاركات مموجة</div>
    <button class="btn btn-ghost btn-sm" style="margin-top:18px" onclick="clearInterval(window.__splashT);go('${S.user?'home':'login'}',{},false)">تخطي ${I("fwd","i s")}</button>
  </div>`;
};

/* ============================================================
   4) صفحات الدخول والتسجيل (Login / Signup / Recovery / OTP / 2FA)
   ============================================================ */
function authShell(inner,foot){
  setHdr("");setNav(false);
  return `<div class="pad" style="min-height:100%;display:flex;flex-direction:column;justify-content:center;gap:16px;background:radial-gradient(circle at 50% 0%,rgba(34,211,238,.13),transparent 60%)">
    <div class="center" style="animation:zoom .35s">
      <img class="logoimg" src="data:image/jpeg;base64," alt="أنمي بلاك" style="width:74px;height:74px;border-radius:23px;margin:0 auto 10px;box-shadow:0 8px 30px rgba(34,211,238,.45)">
      <div class="bb" style="font-size:19px;letter-spacing:1.5px">ANIME <span class="grad-txt">BLACK</span></div>
      <div class="tiny mut">أنمي بلاك · شبكة الأوتاكو الشاملة</div>
    </div>
    ${inner}${foot||""}
  </div>`;
}
function doLogin(kind){
  if(kind === 'google') {
    if(!window.auth || !window.signInWithPopup) {
      toast("خدمة تسجيل الدخول غير جاهزة بعد، يرجى الانتظار ثوانٍ", "err");
      return;
    }
    const provider = new window.GoogleAuthProvider();
    toast("جارٍ فتح نافذة Google...", "info");
    window.signInWithPopup(window.auth, provider).then((result) => {
      const user = result.user;
      toast("تم الدخول بنجاح بحساب Google", "ok");
      snd("success");
      haptic("تسجيل دخول ناجح");
      // onAuthStateChanged manages profile fetch and routing
    }).catch((error) => {
      console.error("Google Auth error:", error);
      toast("فشل الدخول بجوجل: " + (error.message || error.code || "خطأ غير معروف"), "err");
    });
    return;
  }
  
  if(kind === 'email' || kind === 'password') {
    const e = ($("#li_u") ? $("#li_u").value : "").trim();
    const pw = ($("#li_p") ? $("#li_p").value : "");
    if(!e){
      toast("يرجى إدخال البريد الإلكتروني", "err");
      return;
    }
    if(!pw || pw.length < 6){
      toast("يرجى إدخال كلمة المرور (6 أحرف على الأقل)", "err");
      return;
    }
    if(!window.auth || !window.signInWithEmailAndPassword){
      toast("خدمة المصادقة قيد التحميل... يرجى المحاولة بعد لحظات", "err");
      return;
    }
    toast("جارٍ التحقق من بيانات الدخول...", "info");
    window.signInWithEmailAndPassword(window.auth, e, pw).then((cred) => {
      toast("تم تسجيل الدخول بنجاح", "ok");
      snd("success");
      haptic("تسجيل دخول ناجح");
      // onAuthStateChanged takes over
    }).catch((error) => {
      console.error("Email login error:", error);
      let msg = "فشل تسجيل الدخول: ";
      if(error.code === 'auth/invalid-credential' || error.code === 'auth/wrong-password' || error.code === 'auth/user-not-found'){
        msg = "البريد الإلكتروني أو كلمة المرور غير صحيحة";
      } else if(error.code === 'auth/invalid-email'){
        msg = "صيغة البريد الإلكتروني غير صالحة";
      } else {
        msg += (error.message || error.code);
      }
      toast(msg, "err");
    });
    return;
  }
}

PAGES.login=()=>authShell(`
  <div class="card" style="padding:18px">
    <div class="tabs" style="margin-bottom:16px">
      <button class="on" style="flex:1" onclick="go('login')">تسجيل الدخول</button>
      <button style="flex:1" onclick="go('signup')">حساب جديد</button>
    </div>

    <label class="lbl">البريد الإلكتروني</label>
    <div class="row" style="gap:7px">
      <span class="badge b-gray">${I("mail","i s")}</span>
      <input class="inp g1 mono" id="li_u" type="email" placeholder="name@example.com" value="">
    </div>
    <div style="height:12px"></div>

    <label class="lbl">كلمة المرور</label>
    <div class="row" style="gap:7px">
      <input class="inp g1" id="li_p" type="password" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin('email')">
      <button class="iconbtn" onclick="const i=$('#li_p');i.type=i.type==='password'?'text':'password';this.innerHTML=I(i.type==='password'?'eye':'eyeoff');toast(i.type==='password'?'إخفاء':'إظهار','info')">${I("eye")}</button>
    </div>

    <div class="rowb" style="margin:12px 0">
      <button class="row xs b" style="gap:6px;color:var(--muted)" onclick="this.querySelector('.sw').classList.toggle('on');S.remember=!S.remember;save()"><span class="sw on"></span>تذكّرني</button>
      <button class="xs b" style="color:var(--accent)" onclick="go('forgot')">نسيت كلمة المرور؟</button>
    </div>

    <button class="btn btn-primary btn-lg" onclick="doLogin('email')">
      ${I("logout","i s")} تسجيل الدخول بالبريد
    </button>

    <div class="row" style="gap:10px;margin:16px 0">
      <div class="g1 div" style="margin:0"></div>
      <span class="tiny fnt" style="opacity:.8">أو</span>
      <div class="g1 div" style="margin:0"></div>
    </div>

    <button class="btn btn-sec btn-lg" style="width:100%;justify-content:center;gap:9px;border-color:rgba(255,255,255,.18)" onclick="doLogin('google')">
      ${I("globe","i s")} الدخول السريع بحساب Google
    </button>
  </div>

  <div class="card2" style="padding:12px;text-align:center">
    <div class="tiny mut">ليس لديك حساب بعد؟ <button class="b" style="color:var(--accent)" onclick="go('signup')">أنشئ حساب أوتاكو جديد</button></div>
  </div>

  <div class="row wrap center" style="justify-content:center;gap:7px">
    <button class="chip" onclick="S.lang=S.lang==='ar'?'en':'ar';save();toast('اللغة: '+(S.lang==='ar'?'العربية':'English'),'info');render()">${I("globe","i s")} ${S.lang==="ar"?"العربية":"English"}</button>
    <button class="chip" onclick="S.theme=S.theme==='dark'?'light':'dark';document.body.className=S.theme==='light'?'light':'';save();render()">${I(S.theme==="dark"?"moon":"sun","i s")} ${S.theme==="dark"?"ليلي":"نهاري"}</button>
    <button class="chip" onclick="go('downloadApp')">${I("download","i s")} حمّل التطبيق</button>
  </div>`);

PAGES.signup=()=>authShell(`
  <div class="card" style="padding:18px">
    <div class="tabs" style="margin-bottom:16px">
      <button style="flex:1" onclick="go('login')">تسجيل الدخول</button>
      <button class="on" style="flex:1" onclick="go('signup')">حساب جديد</button>
    </div>

    <label class="lbl">البريد الإلكتروني *</label>
    <div class="row" style="gap:7px">
      <span class="badge b-gray">${I("mail","i s")}</span>
      <input class="inp g1 mono" id="su_e" type="email" placeholder="you@example.com">
    </div>
    <div style="height:12px"></div>

    <label class="lbl">كلمة المرور *</label>
    <div class="row" style="gap:7px">
      <input class="inp g1" id="su_pw" type="password" placeholder="٦ أحرف على الأقل" oninput="pwStrength(this.value)">
      <button class="iconbtn" onclick="const i=$('#su_pw');i.type=i.type==='password'?'text':'password';this.innerHTML=I(i.type==='password'?'eye':'eyeoff')">${I("eye")}</button>
    </div>
    <div class="bar" style="margin-top:7px"><i id="pw_bar" style="width:0%;background:var(--rose)"></i></div>
    <div class="tiny fnt" id="pw_txt" style="margin-top:4px">قوة كلمة المرور: —</div>
    <div style="height:12px"></div>

    <label class="lbl">تأكيد كلمة المرور *</label>
    <input class="inp" id="su_pw2" type="password" placeholder="أعد كتابة كلمة المرور">
    <div style="height:14px"></div>

    <button class="row xs" style="gap:7px;color:var(--muted)" onclick="const s=this.querySelector('.sw');s.classList.toggle('on');S.tos=s.classList.contains('on')">
      <span class="sw on"></span>أوافق على <b style="color:var(--accent)" onclick="event.stopPropagation();go('terms')">شروط الاستخدام</b> و<b style="color:var(--accent)" onclick="event.stopPropagation();go('privacyPolicy')">سياسة الخصوصية</b>
    </button>
    <div style="height:15px"></div>

    <button class="btn btn-primary btn-lg" onclick="signupNow()">
      ${I("sparkles","i s")} إنشاء الحساب ومتابعة إكمال الملف الشخصي
    </button>

    <div class="row" style="gap:10px;margin:16px 0">
      <div class="g1 div" style="margin:0"></div>
      <span class="tiny fnt" style="opacity:.8">أو</span>
      <div class="g1 div" style="margin:0"></div>
    </div>

    <button class="btn btn-sec btn-lg" style="width:100%;justify-content:center;gap:9px;border-color:rgba(255,255,255,.18)" onclick="doLogin('google')">
      ${I("globe","i s")} التسجيل السريع بحساب Google
    </button>
  </div>

  <div class="card2" style="padding:12px;text-align:center">
    <div class="tiny mut">لديك حساب بالفعل؟ <button class="b" style="color:var(--accent)" onclick="go('login')">تسجيل الدخول</button></div>
  </div>`);

function checkUsername(v){
  const e=$("#un_chk") || $("#cp_un_chk");if(!e)return;v=v.trim().toLowerCase();
  const taken=["kaido_dark","reem_otaku","admin","owner","root"];
  const reserved=["animeblack","support","team","official"];
  if(!v){e.textContent="";e.className="tiny";return}
  if(v.length<3){e.textContent=" قصير جداً (٣ أحرف على الأقل)";e.style.color="var(--rose)"}
  else if(!/^[a-z0-9_.]+$/.test(v)){e.textContent=" أحرف غير مسموحة (a-z 0-9 _ .)";e.style.color="var(--rose)"}
  else if(taken.includes(v) || (S.users||[]).some(u=>u&&u.id!==S.me.id&&u.uid!==S.me.id&&u.username&&u.username.toLowerCase()===v)){e.textContent=" اسم المستخدم مأخوذ بالفعل";e.style.color="var(--rose)"}
  else if(reserved.includes(v)){e.textContent=" اسم محجوز للإدارة";e.style.color="var(--gold)"}
  else{e.textContent=" اسم المستخدم متاح ومميز ✓";e.style.color="var(--emerald)"}
}

function pwStrength(v){
  const b=$("#pw_bar"),t=$("#pw_txt");if(!b)return;
  let s=0;if(v.length>=6)s++;if(v.length>=8)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
  const L=[["ضعيفة جداً","var(--rose)",15],["ضعيفة","var(--rose)",35],["متوسطة","var(--gold)",60],["قوية","var(--emerald)",82],["قوية جداً","var(--emerald)",100]][Math.min(s,4)];
  b.style.width=L[2]+"%";b.style.background=L[1];t.textContent="قوة كلمة المرور: "+L[0];t.style.color=L[1];
}

function signupNow(){
  const e = ($("#su_e") ? $("#su_e").value : "").trim();
  const pw = ($("#su_pw") ? $("#su_pw").value : "");
  const pw2 = ($("#su_pw2") ? $("#su_pw2").value : "");
  if(!e || !/^[^@]+@[^@]+\.[^@]+$/.test(e)){toast("يرجى إدخال بريد إلكتروني صالح","err");return}
  if(!pw || pw.length < 6){toast("كلمة المرور يجب ألا تقل عن 6 أحرف","err");return}
  if(pw !== pw2){toast("كلمتا المرور غير متطابقتين","err");return}
  if(S.tos === false){toast("يجب الموافقة على شروط الاستخدام","err");return}
  
  if(!window.auth || !window.createUserWithEmailAndPassword){
    toast("خدمة التسجيل قيد التحميل... انتظر ثوانٍ وأعد المحاولة","err");
    return;
  }
  
  toast("جارٍ إنشاء الحساب الجديد...","info");
  window.createUserWithEmailAndPassword(window.auth, e, pw).then((cred) => {
    celebrate("تم إنشاء حسابك بنجاح! أكمل بيانات ملفك الآن");
    snd("success");
    // onAuthStateChanged will detect new user with profileCompleted: false and route to completeProfile
  }).catch((error) => {
    console.error("Signup error:", error);
    let msg = "فشل إنشاء الحساب: ";
    if(error.code === 'auth/email-already-in-use'){
      msg = "هذا البريد مسجل مسبقاً، يمكنك تسجيل الدخول به";
    } else if(error.code === 'auth/weak-password'){
      msg = "كلمة المرور ضعيفة (6 أحرف كحد أدنى)";
    } else {
      msg += (error.message || error.code);
    }
    toast(msg, "err");
  });
}

PAGES.completeProfile=()=>{
  setHdr("");setNav(false);
  window.__chosenCompleteAvatar = window.__chosenCompleteAvatar || S.me.avatar || AV[0];
  const curAv = window.__chosenCompleteAvatar;
  const initialName = (S.me.name && S.me.name !== 'عضو أنمي بلاك' && S.me.name !== 'أوتاكو جديد' && S.me.name !== 'مستخدم Google') ? S.me.name : '';
  const initialUn = (S.me.username && !S.me.username.startsWith('user_')) ? S.me.username : ((S.me.email||'').split('@')[0] || '').replace(/[^a-zA-Z0-9_]/g, '').toLowerCase();

  return `<div class="pad" style="min-height:100%;display:flex;flex-direction:column;justify-content:center;gap:14px;background:radial-gradient(circle at 50% 0%,rgba(34,211,238,.16),transparent 60%)">
    <div class="card" style="padding:18px">
      <div class="center" style="margin-bottom:14px">
        <div class="badge b-gold" style="margin-bottom:6px">خطوة أخيرة هامة ✨</div>
        <div class="bb" style="font-size:18px">إكمال ملفك الشخصي</div>
        <div class="tiny fnt" style="margin-top:2px">حدّد هويتك الرقمية واسمك ليميزك أعضاء أنمي بلاك في المجتمع</div>
      </div>

      <div class="col center" style="gap:8px;margin-bottom:14px">
        <div style="position:relative">
          <img id="cp_av_img" src="${curAv}" style="width:84px;height:84px;border-radius:50%;object-fit:cover;border:3px solid var(--accent);box-shadow:0 6px 20px rgba(34,211,238,.35)">
          <button class="iconbtn" style="position:absolute;bottom:0;left:0;width:28px;height:28px;background:var(--grad-fire);color:#fff;border:none" onclick="openSheet('avatarPick')">${I("camera","i s")}</button>
        </div>
        <div class="tiny fnt">اختر صورة أو انقر على أحد النماذج:</div>
        <div class="row" style="gap:7px;overflow-x:auto;max-width:100%;padding:4px">
          ${AV.slice(0, 6).map((a, i) => `
            <button onclick="window.__chosenCompleteAvatar='${a}';$('#cp_av_img').src='${a}';snd('tap')" style="background:none;border:none;padding:0;cursor:pointer">
              <img src="${a}" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid ${curAv===a?'var(--accent)':'transparent'}">
            </button>
          `).join("")}
        </div>
      </div>

      <label class="lbl">الاسم الظاهر في الحساب *</label>
      <input class="inp" id="cp_name" placeholder="مثال: ليفاي أكرمان، سارة، ملك القراصنة" value="${esc(initialName)}">
      <div style="height:11px"></div>

      <label class="lbl">اسم المستخدم المعرّف الفريد في التطبيق (بالإنجليزية) *</label>
      <div class="row" style="gap:7px">
        <span class="badge b-gray mono">@</span>
        <input class="inp g1 mono" id="cp_username" placeholder="otaku_hero" value="${esc(initialUn)}" oninput="checkUsername(this.value)">
      </div>
      <div class="tiny" id="cp_un_chk" style="margin-top:4px"></div>
      <div style="height:11px"></div>

      <label class="lbl">النبذة التعريفية (Bio)</label>
      <textarea class="inp" id="cp_bio" rows="2" placeholder="اكتب سطراً عن شخصيتك أو اقتباسك المفضل...">${esc(S.me.bio && S.me.bio !== 'عضو جديد في مجتمع أنمي بلاك' ? S.me.bio : 'عاشق للأنمي والمناقشات الأسطورية ⚔️')}</textarea>
      <div style="height:11px"></div>

      <label class="lbl">أنميك المفضل</label>
      <input class="inp" id="cp_fav" placeholder="مثال: ون بيس، هجوم العمالقة، بليتش..." value="${esc(S.me.favAnimeName||'ون بيس')}">
      <div style="height:13px"></div>

      <div class="lbl">تصنيفاتك المفضلة (اختر ما يعجبك)</div>
      <div class="chiprow wrap" id="cp_interests">
        ${["أكشن","شونين","مغامرة","خيال","دراما","كوميديا","غموض","سينين","إيسيكاي","رومانسية"].map((g,i)=>`<button class="chip ${i<3?'on':''}" onclick="this.classList.toggle('on');snd('tap')">${g}</button>`).join("")}
      </div>
      <div style="height:16px"></div>

      <button class="btn btn-primary btn-lg" style="width:100%" onclick="saveCompletedProfile()">
        ${I("check","i s")} حفظ الملف الشخصي وبدء الاستخدام (+200 عملة)
      </button>
    </div>
  </div>`;
};

function saveCompletedProfile(){
  const n = ($("#cp_name") ? $("#cp_name").value : "").trim();
  const un = ($("#cp_username") ? $("#cp_username").value : "").trim().toLowerCase();
  const bio = ($("#cp_bio") ? $("#cp_bio").value : "").trim();
  const fav = ($("#cp_fav") ? $("#cp_fav").value : "").trim();
  const avatar = window.__chosenCompleteAvatar || S.me.avatar || AV[0];

  if(!n || n.length < 2){
    toast("يرجى إدخال اسمك الظاهر (حرفان على الأقل)", "err");
    return;
  }
  if(!un || un.length < 3 || !/^[a-z0-9_.]+$/.test(un)){
    toast("اسم المستخدم يجب أن يكون بالإنجليزية (أحرف وأرقام و _ فقط، 3 أحرف على الأقل)", "err");
    return;
  }

  // Check username uniqueness
  const conflict = (S.users || []).find(x => x && x.id !== S.me.id && x.uid !== S.me.id && x.username && x.username.toLowerCase() === un);
  if(conflict){
    toast("اسم المستخدم @" + un + " محجوز لعضو آخر، يرجى اختيار اسم فريد", "err");
    return;
  }

  const selectedInterests = [];
  $$("#cp_interests .chip.on").forEach(b => selectedInterests.push(b.textContent.trim()));

  const myUid = getMyUid();
  S.me.name = n;
  S.me.username = un;
  S.me.avatar = avatar;
  S.me.bio = bio || "عضو في مجتمع أنمي بلاك";
  S.me.favAnimeName = fav || "ون بيس";
  S.me.interests = selectedInterests;
  S.me.profileCompleted = true;
  S.user = { ...S.me };

  if(window.auth && window.auth.currentUser && window.db){
    const uid = window.auth.currentUser.uid;
    const upd = {
      id: uid,
      uid: uid,
      name: n,
      username: un,
      avatar: avatar,
      bio: S.me.bio,
      favAnimeName: S.me.favAnimeName,
      interests: selectedInterests,
      profileCompleted: true,
      updatedAt: Date.now()
    };
    window.setDoc(window.doc(window.db, "users", uid), upd, {merge: true}).catch(e => console.error("Update profile error:", e));
  }

  save();
  addCoins(200, "مكافأة إكمال الملف الشخصي");
  celebrate("تم إكمال ملفك الشخصي بنجاح يا " + n);
  snd("success");
  haptic("حفظ ناجح");
  setTimeout(() => go("home", {}, false), 800);
}
PAGES.forgot=()=>authShell(`
  <div class="card" style="padding:16px">
    ${backHdr("استعادة كلمة المرور","٤ خطوات: بريد ← رمز ← كلمة جديدة ← تم")}
    <div class="div"></div>
    ${S.recoveryStep==="input"?`
      <div class="row" style="gap:9px;margin-bottom:12px">
        <button class="chip ${S.recoveryVia!=='phone'?'on':''}" onclick="S.recoveryVia='email';render()">${I("mail","i s")} بريد</button>
        <button class="chip ${S.recoveryVia==='phone'?'on':''}" onclick="S.recoveryVia='phone';render()">${I("phone","i s")} جوال</button>
        <button class="chip" onclick="S.recoveryVia='username';render()">${I("user","i s")} اسم مستخدم</button>
      </div>
      <label class="lbl">${S.recoveryVia==="phone"?"رقم الجوال":"البريد الإلكتروني"}</label>
      <input class="inp" id="rc_v" value="${esc(S.me.email)}" ${S.recoveryVia==="phone"?'dir="ltr" placeholder="+967..."':""}>
      <div style="height:13px"></div>
      <button class="btn btn-primary btn-lg" onclick="S.recoveryStep='otp';save();render();toast('أرسلنا رمز التحقق ','ok');snd('success')">إرسال رمز التحقق ${I("send","i s")}</button>
    `:S.recoveryStep==="otp"?`
      <div class="tiny mut center" style="margin-bottom:11px">أدخل الرمز المكوّن من ٦ أرقام<br><span class="mono b" style="color:var(--accent)">الرمز التجريبي: ${S.otpCode}</span></div>
      <div class="row" style="gap:6px;justify-content:center" id="otpbox">
        ${[0,1,2,3,4,5].map(i=>`<input class="inp mono center" maxlength="1" style="width:42px;padding:11px 0;font-size:19px;font-weight:900" data-i="${i}" oninput="otpNext(this)" onkeydown="otpBack(event,this)">`).join("")}
      </div>
      <div class="rowb tiny" style="margin:13px 0"><span class="fnt" id="rc_timer">إعادة الإرسال بعد 0:30</span><button class="b" style="color:var(--accent)" onclick="toast('تم إعادة إرسال الرمز','ok');snd('notif')">إعادة الإرسال</button></div>
      <button class="btn btn-primary btn-lg" onclick="verifyOtp()">${I("check","i s")} تحقق من الرمز</button>
    `:S.recoveryStep==="new_password"?`
      <label class="lbl">كلمة المرور الجديدة</label><input class="inp" id="np1" type="password" oninput="pwStrength2(this.value)">
      <div class="bar" style="margin-top:7px"><i id="pw_bar" style="width:0%"></i></div><div class="tiny fnt" id="pw_txt">قوة كلمة المرور: —</div>
      <div style="height:9px"></div>
      <label class="lbl">تأكيد كلمة المرور</label><input class="inp" id="np2" type="password">
      <div class="card2" style="padding:10px;margin:12px 0">
        <div class="tiny b mut" style="margin-bottom:6px">كلمات مرور سابقة لا يمكن استخدامها:</div>
        <div class="mono tiny fnt">oldpassword123 · anotherold456</div>
      </div>
      <button class="btn btn-primary btn-lg" onclick="const a=$('#np1').value,b=$('#np2').value;if(a.length<8){toast('٨ أحرف على الأقل','err');return}if(a!==b){toast('كلمتا المرور غير متطابقتين','err');return}if(['oldpassword123','anotherold456'].includes(a)){toast('لا يمكن استخدام كلمة مرور سابقة','err');return}S.recoveryStep='done';save();render();celebrate('تم تغيير كلمة المرور بنجاح')">حفظ كلمة المرور الجديدة</button>
    `:`
      <div class="center" style="padding:16px 0">
        <div style="width:76px;height:76px;border-radius:50%;background:rgba(16,185,129,.14);border:1px solid rgba(16,185,129,.4);display:flex;align-items:center;justify-content:center;margin:0 auto 13px;color:var(--emerald)">${I("check","xl")}</div>
        <div class="bb" style="font-size:16px">تمّت الاستعادة بنجاح!</div>
        <div class="tiny mut" style="margin:7px 0 15px">يمكنك الآن الدخول بكلمة المرور الجديدة</div>
        <button class="btn btn-primary btn-lg" onclick="S.recoveryStep='input';save();go('login')">العودة لتسجيل الدخول</button>
      </div>`}
  </div>
  <button class="btn btn-ghost btn-sm" style="align-self:center" onclick="S.recoveryStep='input';go('login')">${I("back","i s")} رجوع</button>`);
function pwStrength2(v){const b=$("#pw_bar"),t=$("#pw_txt");if(!b)return;let s=0;if(v.length>=8)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;const L=[["ضعيفة جداً","var(--rose)",15],["ضعيفة","var(--rose)",35],["متوسطة","var(--gold)",60],["قوية","var(--emerald)",82],["قوية جداً","var(--emerald)",100]][s];b.style.width=L[2]+"%";b.style.background=L[1];t.textContent="قوة كلمة المرور: "+L[0];t.style.color=L[1]}
function otpNext(el){if(el.value&&el.dataset.i<5)$$('#otpbox input')[+el.dataset.i+1].focus()}
function otpBack(e,el){if(e.key==="Backspace"&&!el.value&&el.dataset.i>0)$$('#otpbox input')[+el.dataset.i-1].focus()}
function otpVal(){return $$("#otpbox input").map(i=>i.value).join("")}
function verifyOtp(){const v=otpVal();if(v.length<6){toast("أدخل ٦ أرقام","err");return}if(v!==S.otpCode){toast("الرمز غير صحيح","err");snd("error");return}S.recoveryStep="new_password";save();render();toast("تم التحقق ","ok")}
let rcT=null;function startRcTimer(){clearInterval(rcT);let s=30;rcT=setInterval(()=>{const e=$("#rc_timer");if(!e){clearInterval(rcT);return}e.textContent="إعادة الإرسال بعد 0:"+String(s).padStart(2,"0");if(--s<0){e.textContent="يمكنك الإرسال الآن";clearInterval(rcT)}},1000)}

PAGES.twofa=()=>authShell(`
  <div class="card" style="padding:16px">
    ${backHdr("المصادقة الثنائية 2FA","أدخل الرمز من تطبيق المصادقة")}
    <div class="div"></div>
    <div class="center" style="padding:8px 0 14px">
      <div class="qr" style="margin-bottom:11px"></div>
      <div class="tiny b">امسح الرمز بتطبيق المصادقة</div>
      <div class="mono tiny fnt" style="margin-top:4px">الرمز السري: JBSW Y3DP EHPK 3PXP</div>
      <button class="btn btn-sec btn-xs" style="margin-top:8px" onclick="copyTxt('JBSWY3DPEHPK3PXP')">${I("copy","i s")} نسخ الرمز</button>
    </div>
    <label class="lbl">رمز التحقق (٦ أرقام)</label>
    <div class="row" style="gap:6px;justify-content:center" id="otpbox">
      ${[0,1,2,3,4,5].map(i=>`<input class="inp mono center" maxlength="1" style="width:42px;padding:11px 0;font-size:19px;font-weight:900" data-i="${i}" oninput="otpNext(this)" onkeydown="otpBack(event,this)">`).join("")}
    </div>
    <div class="tiny fnt center" style="margin:10px 0">الرمز التجريبي: <b class="mono" style="color:var(--accent)">${S.otpCode}</b></div>
    <button class="btn btn-primary btn-lg" onclick="if(otpVal()===S.otpCode){celebrate('تم التحقق مرحباً بك');doLogin('2fa')}else{toast('الرمز غير صحيح','err');snd('error')}">${I("shield","i s")} تحقّق وادخل</button>
    <div class="grid2" style="margin-top:11px">
      <button class="btn btn-sec btn-sm" onclick="sendAltCode()">${I("mail","i s")} رمز بديل بالبريد</button>
      <button class="btn btn-sec btn-sm" onclick="showBackup()">${I("key","i s")} رموز احتياطية</button>
    </div>
  </div>`);
function copyTxt(t){try{navigator.clipboard.writeText(t);toast("تم النسخ: "+t,"ok")}catch(e){toast("تعذّر النسخ","err")}}

PAGES.terms=()=>{setHdr(backHdr("شروط الاستخدام","آخر تحديث: ٢٠٢٥/٠٩"));setNav(false);return `<div class="pad col">
  <div class="card" style="padding:15px"><div class="b sm grad-txt">١. قبول الشروط</div><p class="xs mut" style="margin-top:7px">باستخدامك منصة «أنمي بلاك» فإنك توافق على هذه الشروط بالكامل. إذا لم توافق على أي بند، يرجى التوقف عن استخدام المنصة.</p></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">٢. الحساب والأهلية</div><p class="xs mut" style="margin-top:7px">يجب أن يكون عمرك ١٣ سنة على الأقل. أنت مسؤول عن حماية بيانات دخولك وعن كل نشاط يحدث تحت حسابك.</p></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">٣. المحتوى المقبول</div><p class="xs mut" style="margin-top:7px">يُمنع نشر محتوى مسيء، عنيف، إباحي، أو ينتهك حقوق الملكية الفكرية للأنمي والمانجا. الإدارة تملك حق الحذف والإيقاف دون إشعار مسبق.</p></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">٤. العملة الافتراضية</div><p class="xs mut" style="margin-top:7px">«العملة السوداء» و«النجوم المشعة» عناصر افتراضية داخل التطبيق فقط، لا تملك قيمة نقدية حقيقية ولا يمكن استردادها.</p></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">٥. الملكية الفكرية</div><p class="xs mut" style="margin-top:7px">كل الشعارات والصور العائدة لأنميات معينة هي ملك لأصحابها. المنصة للاستخدام الترفيهي والمجتمعي فقط.</p></div>
  <button class="btn btn-primary" onclick="back()">${I("check","i s")} فهمت وأوافق</button></div>`};
PAGES.privacyPolicy=()=>{setHdr(backHdr("سياسة الخصوصية","كيف نتعامل مع بياناتك"));setNav(false);return `<div class="pad col">
  <div class="card" style="padding:15px"><div class="b sm grad-txt">البيانات التي نجمعها</div><ul class="xs mut" style="margin:8px 18px 0"><li>بيانات الحساب (اسم، بريد، صورة)</li><li>نشاطك داخل المنصة (منشورات، تفاعلات)</li><li>معلومات الجهاز لإحصاءات الأمان</li></ul></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">التخزين</div><p class="xs mut" style="margin-top:7px">تُخزّن البيانات في Firebase Firestore مع كاش محلي على جهازك للعمل دون اتصال.</p></div>
  <div class="card" style="padding:15px"><div class="b sm grad-txt">حقوقك</div><p class="xs mut" style="margin-top:7px">يمكنك تصدير بياناتك أو حذف حسابك نهائياً من إعدادات الأمان. الحذف يستغرق ٣٠ يوماً قابلة للإلغاء.</p></div>
  <button class="btn btn-primary" onclick="back()">${I("check","i s")} إغلاق</button></div>`};

/* ============================================================
   5) الهيكل الرئيسي: الهيدر + الرئيسية (Home Feed)
   ============================================================ */
const REACTS=[["like","thumbup","إعجاب","#5B8CFF"],["love","heart","حب","#FF5C8A"],["laugh","face-laugh","ضحك","#FFC24A"],["rofl","face-rofl","ضحك شديد","#FBBF24"],["wow","face-wow","انبهار","#A78BFA"],["surprise","party","مفاجأة","#F472B6"],["shock","face-shock","صدمة","#22D3EE"],["sad","face-sad","حزن","#60A5FA"],["broken","heartcrack","قلب مكسور","#94A3B8"],["angry","face-angry","غضب","#F87171"],["clap","volume","تصفيق","#2DD4BF"],["fire","flame","رهيب","#FB923C"],["hundred","award","ممتاز","#FBBF24"],["mind","face-mind","عقل انفجر","#C084FC"],["cold","snow","رهيب جدًا","#67E8F9"],["plead","face-plead","مؤثر","#F9A8D4"],["cry","face-cry","بكاء","#7DD3FC"],["think","face-think","تفكير","#9CA3AF"],["bored","moon","ممل","#9CA3AF"],["zap","zap","أسطوري","#FDE047"]];
function mainHdr(){
  const L=(ar,en)=>S.langEn?en:ar;
  return `<div style="display:flex;align-items:center;justify-content:space-between;width:100%;gap:8px">
    <div class="row" style="gap:8px;min-width:0">
      
      <div class="row" style="gap:8px;min-width:0">
        <span class="logoring"><img class="logoimg" src="data:image/jpeg;base64," alt="" style="width:100%;height:100%;border-radius:10px"></span>
        <span class="apptitle">${L("أنمي بلاك","ANIME BLACK")}</span>
      </div>
    </div>
    <div class="row" style="gap:7px;flex-shrink:0">
      <button class="hbox" style="gap:5px;display:flex" onclick="toggleLang()">${I("globe")}<span style="font-size:10px;font-weight:700">${S.langEn?"عربي":"English"}</span></button>
      <button class="hbox" onclick="go('gmail')" title="${L("بريد Gmail المتكامل","Gmail Suite")}">${I("mail")}</button>
      <button class="hbox" style="position:relative" onclick="go('notifications')" title="${L("الإشعارات","Notifications")}">${I("bell")}${S.notifs.some(x=>!x.read)?`<span class="bdot"></span>`:""}</button>
      <button class="sparkav" onclick="go('profile')" title="${L("ملفي","My Profile")}">${av(S.me,26)}</button>
    </div></div>`;
}
function toggleLang(){S.langEn=!S.langEn;save();render();toast(S.langEn?"Language: English (interface)":"اللغة: العربية (أساسية)","info");snd("tap")}
setInterval(()=>{const e=$("#jst");if(e)e.textContent=new Date().toLocaleTimeString("en-GB",{hour12:false})+" JST"},1000);

function pkind(p){return p.type==="poll"?"poll":(p.type==="video"||(p.media&&p.media.kind==="video"))?"video":p.media?"photo":"text"}
function sensTxt(t){if(!(S.ff||{}).sens)return t||"";return (t||"").replace(/(غبي|لعنة|حقير|أحمق)/g,"***")}
function homeFeed(){const ff=S.ff||{};let combined = [];
  if (window._cloudPosts) {
    const local = S.posts.filter(p => !(window._cloudPosts||[]).find(cp => cp.id === p.id));
    combined = [...window._cloudPosts, ...local].sort((a,b) => b.createdAt - a.createdAt);
  } else {
    combined = (S.posts||[]).slice();
  }
  let f=combined.filter(p=>!(S.mutedUsers||[]).includes(p.authorId)&&!(S.hidden||[]).includes(p.id));
  const hsq=(S.homeSearchQ||"").trim().toLowerCase();
  if(hsq) f=f.filter(p=>((p.text||"")+" "+(p.tags||[]).join(" ")).toLowerCase().includes(hsq));
  if(ff.from==="follow")f=f.filter(p=>p.authorId==="me"||(S.following||[]).includes(p.authorId));
  if(ff.from==="verif")f=f.filter(p=>(u(p.authorId)||{}).verified);
  if(ff.from==="guild")f=f.filter(p=>S.communities.some(c=>(c.ownerId||c.owner||"")===p.authorId));
  const T=ff.types||[];if(T.length)f=f.filter(p=>T.includes(pkind(p)));
  const C=ff.cats||[];if(C.length)f=f.filter(p=>C.includes(p.cat));
  if(ff.dup){const seen={};f=f.filter(p=>{const k=(p.text||"").slice(0,25);if(seen[k])return false;seen[k]=1;return true})}
  return f.sort((a,b)=>{if((!!a.pinned)!==(!!b.pinned))return a.pinned?-1:1;
    if(ff.rep)return (u(b.authorId).reputation||0)-(u(a.authorId).reputation||0);
    if(S.feedSort==="latest")return b.createdAt-a.createdAt;
    if(S.feedSort==="reputation")return (u(b.authorId).reputation||0)-(u(a.authorId).reputation||0);
    return (b.likes*2+b.views/100)-(a.likes*2+a.views/100)})}
function ffCount(){const ff=S.ff||{};return (ff.types||[]).length+(ff.cats||[]).length+((ff.from&&ff.from!=="all")?1:0)+["dup","spoiler","sens","rep"].filter(k=>ff[k]).length}
function ffReset(){S.ff={types:[],cats:[],from:"all",dup:false,spoiler:true,sens:false,rep:false};save();render();toast("أُعيدت التصفية ","info")}
function ffT(kind,v){const ff=S.ff;const a=ff[kind]||[];if(a.includes(v))ff[kind]=a.filter(x=>x!==v);else a.push(v)||0,ff[kind]=a;save();openSheet("filterSheet")}
function ffFrom(k){S.ff.from=k;save();openSheet("filterSheet")}
function ffO(k){S.ff[k]=!S.ff[k];save();openSheet("filterSheet")}
function mh(){return S.cardSize==="sm"?"260px":S.cardSize==="lg"?"600px":"440px"}
function canClaim(){return S.lastClaim!==new Date().toDateString()}
function claimDaily(){if(!canClaim()){toast("استلمت مكافأة اليوم — عد غداً ","info");snd("tap");return}S.coins+=50;S.lastClaim=new Date().toDateString();try{addXP(20,"مكافأة يومية")}catch(e){}save();render();snd("success");toast("+50 عملة: مكافأة اليوم ","ok")}
function claimQuestIdx(i){const q=(S.me.quests||[])[i];if(!q||q.p<q.max||q.claimed)return;q.claimed=1;S.coins+=q.r||30;save();render();snd("success");toast("جائزة المهمة: +"+(q.r||30)+" عملة ","ok")}
function startHomeClock(){if(window.__hclk)clearInterval(window.__hclk);let miss=0;const tick=()=>{const el=document.getElementById("hclock");if(!el){miss++;if(miss>6){clearInterval(window.__hclk);window.__hclk=null}return}miss=0;const d=new Date();el.textContent=d.toLocaleTimeString("en-GB");const g=document.getElementById("hgreet");if(g){const h=d.getHours();g.textContent=h<12?"صباح النشاط يا بطل":h<17?"مساء الإبداع يا أوتاكو":"ليلة مشاهدة مثالية"}const dt=document.getElementById("hdate");if(dt)dt.textContent=["الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"][d.getDay()]+" "+d.getDate()+"/"+(d.getMonth()+1)};setTimeout(tick,80);window.__hclk=setInterval(tick,500);document.addEventListener("visibilitychange",()=>{if(!document.hidden)tick()})}
function storyLP(e,sid){window.__lpFired=0;const t=setTimeout(()=>{window.__lpFired=1;openSheet("storyMenu",sid)},520);const cl=()=>clearTimeout(t);e.target.addEventListener("pointerup",cl,{once:true});e.target.addEventListener("pointerleave",cl,{once:true});e.target.addEventListener("pointercancel",cl,{once:true})}
const FEED_POOL=[["أنهيت ماراثون هجوم العمالقة كاملاً — تحليل كامل بالداخل",["#هجوم_العمالقة"]],["تعاون رسمي جديد بين مابا وويت لمشروع ٢٠٢٧",["#أخبار_الأنمي"]],["سؤال النقاش: أفضل افتتاحية هذا الموسم؟ صوتوا بالتعليقات",["#نقاش"]],["كوزبلاي جديد من معرض الأنمي — تقييمكم يهمني",["#كوزبلاي"]],["ترتيب الأسبوع: جوجوتسو يتصدر المشاهدات عالمياً",["#جوجوتسو_كايسن"]]];
function fetchNewPosts(){const b=document.getElementById("feedRefresh");if(b){b.disabled=true;b.textContent="جارٍ التحديث..."}setTimeout(()=>{
    /* ===== v5: كان هنا مولّد منشورات وهمية =====
       عند كل ضغطة تحديث كان يخترع 1-2 منشور من FEED_POOL بمؤلف عشوائي
       وعدد إعجابات ومشاهدات عشوائية، ويقول لك "وصل N منشور جديد".
       محتوى غير حقيقي بالكامل. عُطّل — والأصل محفوظ أدناه:
       const nn=1+Math.floor(Math.random()*2); ... S.posts.unshift({...likes:rnd(1,40),views:rnd(50,400)...})
    */
    if(b){b.disabled=false;b.textContent="تحديث"}
    render(); toast("لا منشورات جديدة","info");
    const pg=document.querySelector("#page");if(pg)pg.scrollTo({top:0,behavior:"smooth"})
  },400)}

PAGES.workspace=()=>{
  setNav(true);
  const user = window.auth && window.auth.currentUser;
  
  if (!user) {
    setHdr(backHdr("مساحة العمل الخاصة", "تسجيل الدخول مطلوب"));
    return `<div class="pad col center" style="margin-top:40px;gap:12px;text-align:center">
      <div style="font-size:48px">🔒</div>
      <h2 class="ttl">المساحة الخاصة</h2>
      <p class="mut">تحتاج إلى تسجيل الدخول لحفظ أفكارك والوصول إلى مساحة العمل.</p>
      <button class="btn btn-primary btn-lg" onclick="go('login')">${I("user","i s")} تسجيل الدخول</button>
    </div>`;
  }
  
  setHdr(backHdr("مساحة العمل الخاصة", "أفكارك محفوظة سحابياً بأمان"));
  
  // Real-time listener setup (only if not already running for this session)
  if (!window._workspaceListenerActive) {
    window._workspaceListenerActive = true;
    window._thoughts = [];
    const q = window.query(window.collection(window.db, 'workspaces', user.uid, 'thoughts'));
    window.onSnapshot(q, (snap) => {
      window._thoughts = snap.docs.map(d => ({id: d.id, ...d.data()})).sort((a,b) => b.createdAt - a.createdAt);
      if(S.page === 'workspace') render(); // Re-render page
    }, (err) => {
      console.error(err);
      toast("فشل جلب الأفكار: " + err.message, "err");
    });
  }

  const thoughtsHtml = (window._thoughts || []).map(t => `
    <div class="card" style="padding:12px;margin-bottom:8px">
      <div class="mut tiny" style="margin-bottom:4px">${new Date(t.createdAt).toLocaleString("ar")}</div>
      <div class="text" style="white-space:pre-wrap">${esc(t.text)}</div>
      <div class="row" style="margin-top:8px;justify-content:flex-end">
        <button class="btn btn-glass btn-xs" style="color:var(--rose)" onclick="deleteThought('${t.id}')">${I("trash","i s")} حذف</button>
      </div>
    </div>
  `).join("");

  return `<div class="pad col">
    <div class="card" style="padding:12px;margin-bottom:16px;background:var(--surface2)">
      <div class="row" style="gap:8px;margin-bottom:8px">
        ${av({avatar: user.photoURL}, 32)}
        <div class="g1">
          <div class="b xs">أهلاً، ${esc(user.displayName || 'مستخدم')}</div>
          <div class="tiny mut">هذه مساحتك الخاصة والمشفرة</div>
        </div>
        <button class="iconbtn" onclick="logoutWorkspace()" style="color:var(--rose)">${I("logout","i s")}</button>
      </div>
      <textarea class="inp" id="ws_txt" rows="3" placeholder="ماذا يدور في ذهنك اليوم؟..."></textarea>
      <div class="row" style="margin-top:8px;justify-content:flex-end">
        <button class="btn btn-primary" onclick="addThought()">${I("plus","i s")} حفظ الفكرة</button>
      </div>
    </div>
    
    <div class="b xs" style="margin-bottom:8px">الأفكار المحفوظة (${window._thoughts ? window._thoughts.length : 0})</div>
    <div id="thoughtsList">
      ${(window._thoughts && window._thoughts.length > 0) ? thoughtsHtml : '<div class="mut center pad">لا توجد أفكار محفوظة بعد</div>'}
    </div>
  </div>`;
};

window.addThought = async () => {
  const txt = $('#ws_txt').value.trim();
  if(!txt) return toast("لا يمكن حفظ فكرة فارغة", "err");
  const user = window.auth.currentUser;
  if(!user) return toast("غير مصرح", "err");
  
  toast("جارٍ الحفظ...", "info");
  try {
    const docRef = window.doc(window.collection(window.db, 'workspaces', user.uid, 'thoughts'));
    await window.setDoc(docRef, {
      text: txt,
      createdAt: Date.now()
    });
    toast("تم حفظ الفكرة بنجاح", "ok");
    snd("success");
    $('#ws_txt').value = '';
  } catch(e) {
    toast("خطأ: " + e.message, "err");
  }
};

window.deleteThought = async (tid) => {
  if(!confirm("هل أنت متأكد من حذف هذه الفكرة؟")) return;
  const user = window.auth.currentUser;
  if(!user) return;
  try {
    const docRef = window.doc(window.db, 'workspaces', user.uid, 'thoughts', tid);
    await window.deleteDoc(docRef); 
    toast("تم حذف الفكرة", "info");
  } catch(e) {
    toast("خطأ: " + e.message, "err");
  }
};

window.logoutWorkspace = async () => {
  if(!window.auth) return;
  await window.auth.signOut();
  window._workspaceListenerActive = false;
  window._thoughts = [];
  toast("تم تسجيل الخروج", "info");
  go("login");
};


PAGES.home=()=>{
  S.activeTab="home";setHdr(mainHdr());setNav(true);
  if(!S.homeHidden){S.homeHidden=[];["modbar","evstrip","worlds","continue"].forEach(k=>{if(!(S.sections.home||[]).includes(k))S.sections.home.push(k)})}
  S.ff=S.ff||{types:[],cats:[],from:"all",dup:false,spoiler:true,sens:false,rep:false};
  S.events = S.events || [];
  const feed=homeFeed();startHomeClock();
  const wq=S.sections.widgets||[];const W=[];
  if(wq.includes("clock")||wq.includes("coins"))W.push(`<div class="grid2" style="margin-bottom:12px">
    ${wq.includes("clock")?`<div class="card2" style="padding:12px"><div class="rowb"><div><div class="bb mono" style="font-size:19px" id="hclock">--:--:--</div><div class="tiny fnt" id="hdate"></div></div><span class="ico-tile" style="width:36px;height:36px;border-radius:11px;background:var(--grad-cyan);color:#fff">${I("clock","i s")}</span></div><div class="tiny b" style="margin-top:7px;color:var(--accent)" id="hgreet"></div></div>`:"<span></span>"}
    ${wq.includes("coins")?`<div class="card2" style="padding:12px"><div class="rowb"><div><div class="bb mono" style="font-size:16px;color:#F59E0B">${nfmt(S.coins)} عملة</div><div class="tiny fnt">${S.stars} نجمة · مستوى ${S.me.level}</div></div><span class="ico-tile" style="width:36px;height:36px;border-radius:11px;background:var(--grad-fire);color:#fff">${I("coins","i s")}</span></div><button class="btn ${canClaim()?"btn-primary":"btn-sec"} btn-xs" style="margin-top:8px;width:100%" onclick="claimDaily()">${I("gift","i s")} ${canClaim()?"مكافأة اليوم +٥٠":"استلمت اليوم"}</button></div>`:"<span></span>"}
  </div>`);
  if(wq.includes("quests"))W.push(`<div class="card" style="padding:12px;margin-bottom:12px;background:linear-gradient(135deg,rgba(34,211,238,.09),rgba(168,85,247,.06))">
    <div class="rowb"><div class="row b sm">${I("target","i s")} مهامك اليومية</div><button class="tiny b" style="color:var(--accent)" onclick="go('activity')">عرض الكل</button></div>
    <div style="margin-top:9px" class="col">${(S.me.quests||[]).slice(0,3).map((q,qi)=>`<div class="row" style="gap:9px">
      <span class="ico-tile" style="width:28px;height:28px;border-radius:9px;background:var(--surface3);color:var(--accent)">${I(q.ic,"i s")}</span>
      <div class="g1"><div class="tiny b">${esc(q.t)}</div><div class="bar" style="height:4px;margin-top:3px"><i style="width:${Math.min(100,q.p/q.max*100)}%"></i></div></div>
      ${q.p>=q.max?(q.claimed?`<span class="badge b-gray">تم الاستلام</span>`:`<button class="btn btn-primary btn-xs" onclick="claimQuestIdx(${qi})">${I("gift","i s")} +${q.r||30}</button>`):`<span class="badge b-gold mono">${q.p}/${q.max}</span>`}
    </div>`).join("")}</div></div>`);
  if(wq.includes("stats"))W.push(`<div class="grid4" style="margin-bottom:12px">${[["flame","var(--accent)",S.me.level,"المستوى","go('levels')"],["coins","#F59E0B",nfmt(S.coins),"عملة","go('economy')"],["star","#A855F7",S.stars,"نجمة","go('economy')"],["eye","#06B6D4",nfmt(S.me.followers),"متابع","go('followers',{type:'followers'})"]].map(([ic,c,v,l,oc])=>`<button class="card2 stat" onclick="${oc}"><span style="color:${c};display:flex;justify-content:center;margin-bottom:3px">${I(ic,"i s")}</span><b class="mono">${v}</b><span>${l}</span></button>`).join("")}</div>`);
  if(wq.includes("trend")){const tc={};S.posts.forEach(p=>(p.tags||[]).forEach(t=>{const x=tagx(t);tc[x]=(tc[x]||0)+1}));const top=Object.keys(tc).sort((a,b)=>tc[b]-tc[a]).slice(0,5);
    W.push(`<div class="card" style="padding:12px;margin-bottom:12px"><div class="rowb"><div class="row b sm">${I("trend","i s")} الرائج الآن</div><button class="tiny b" style="color:var(--accent)" onclick="go('explore')">استكشف</button></div><div class="chiprow wrap" style="margin-top:9px">${top.map(t=>`<button class="chip" onclick="S.searchQ='${t}';save();go('search')">#${t} <span class="mono tiny fnt">${tc[t]}</span></button>`).join("")}</div></div>`)}
  if(wq.includes("events"))W.push(`<div class="card" style="padding:12px;margin-bottom:12px"><div class="rowb"><div class="row b sm">${I("calendar","i s")} فعاليات قادمة</div><button class="tiny b" style="color:var(--accent)" onclick="go('activity')">الكل</button></div><div class="col" style="margin-top:9px">${S.events.filter(ev=>evStatus(ev)==="active").map(ev=>{const dd=Math.max(0,Math.ceil((ev.endsAt-now())/864e5));return `<button class="rowb" style="padding:8px;background:var(--surface2);border-radius:11px;border:none;width:100%" onclick="go('eventDetail',{id:'${ev.id}'})"><span class="row" style="gap:8px"><span class="ico-tile" style="width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,${ev.c1},${ev.c2});color:#fff">${I(ev.icon,"i s")}</span><span class="g1 b xs" style="text-align:right">${esc(ev.title)}</span></span><span class="badge b-gold mono">${dd} يوم</span></button>`}).join("")}</div></div>`);
  const WIDGETS=W.join("");
  const SEC={
    stories:()=>{const mine=(S.stories||[]).find(ss=>ss.userId==="me");return `<div class="stories">
      <div class="story" onclick="${mine?`go('storyViewer',{i:0,sid:'${mine.id}'})`:"go('createStory')"}">
        <div class="ring ${mine?"":"mine"}">${mine?`<img class="avatar" src="${S.me.avatar||""}" width="60" height="60" onerror="this.style.background='var(--grad-fire)'">`:`<div class="ph" style="display:flex;align-items:center;justify-content:center;background:var(--surface2);font-size:20px;color:var(--accent)">+</div>`}</div>
        <span>${mine?"قصتي":"أضف قصة"}</span></div>
      ${S.stories.filter(ss=>ss.userId!=="me").map(ss=>{const uu=u(ss.userId);return `<div class="story" onclick="if(window.__lpFired){window.__lpFired=0;return}go('storyViewer',{i:0,sid:'${ss.id}'})" oncontextmenu="event.preventDefault();openSheet('storyMenu','${ss.id}')" onpointerdown="storyLP(event,'${ss.id}')">
        <div class="ring ${ss.seen?"seen":""}"><img class="avatar" src="${uu.avatar}" width="60" height="60" onerror="this.style.background='var(--grad-fire)'"></div>
        <span>${esc(uu.name)}</span></div>`}).join("")}
    </div>
    <div class="chiprow" style="margin:10px 0 4px">${[["msgsq","منشور","go('createPost')"],["clock","قصة","go('createStory')"],["clapper","ريل","go('createReelStudio')"],["users","قروب","go('createGroup')"],["chart","استطلاع","go('createPollPro')"]].map(([ic,l,oc])=>`<button class="chip" onclick="${oc}">${I(ic,"i s")} ${l}</button>`).join("")}</div>`},
    modbar:()=>canMod()?`<div class="row" style="gap:8px;margin:2px 0 10px">
      <button class="btn btn-gold btn-sm g1" onclick="go('createEvent')">${I("calendar","i s")} إنشاء فعالية</button>
      <button class="btn btn-sec btn-sm g1" onclick="go('createNews')">${I("sparkles","i s")} نشر خبر</button>
      <span class="badge b-red" style="align-self:center">${I("shield","i s")} مشرف</span></div>`:``,
    evstrip:()=>`<div class="secttl"><h3>${I("calendar","i s")} فعاليات نشطة</h3><button class="more" onclick="go('eventsHub')">الكل ${I("fwd","i s")}</button></div>
      <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:6px" class="no-sb">
      ${S.events.filter(ev=>evStatus(ev)==="active").slice(0,4).map(ev=>`<button class="card2" style="min-width:170px;padding:0;overflow:hidden;text-align:right" onclick="go('eventDetail',{id:'${ev.id}'})">
        <div class="art-bg" style="--c1:${ev.c1};--c2:${ev.c2};height:64px;display:flex;align-items:center;justify-content:center;position:relative">${I(ev.icon,"xl")}
          <span class="badge b-gold" style="position:absolute;top:6px;right:6px">${ev.tag}</span></div>
        <div style="padding:8px"><div class="tiny b" style="line-height:1.35">${esc(ev.title)}</div><div class="tiny fnt">${(ev.participants||[]).length} مشارك · جوائز ${nfmt(ev.prizes[0]?ev.prizes[0].amt:0)}</div></div></button>`).join("")||`<div class="tiny fnt mut">لا فعاليات نشطة حالياً</div>`}
      </div>`,
    posts:()=>`<div class="row g1" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:13px;padding:9px 12px;margin-bottom:8px">
      <span style="color:var(--muted)">${I("search","i s")}</span>
      <input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="بحث في المنشورات (كلمات أو #هاشتاق)..." value="${esc(S.homeSearchQ||'')}" oninput="S.homeSearchQ=this.value;homeSearchLive()" id="hsq">
      ${S.homeSearchQ?`<button onclick="S.homeSearchQ='';save();render()" style="color:var(--muted)">${I("x","i s")}</button>`:""}
    </div><div class="chiprow">
      ${[["ai","توصيات الذكاء","sparkles"],["latest","الأحدث","clock"],["reputation","حسب السمعة","trend"]].map(([k,l,ic])=>`<button class="chip ${S.feedSort===k?"on":""}" onclick="S.feedSort='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}
      <button class="chip" onclick="go('homeCustomizer')">${I("layers","i s")} تخصيص</button>
      <button class="chip ${ffCount()?"on":""}" onclick="openSheet('filterSheet')">${I("filter","i s")} تصفية${ffCount()?" ("+ffCount()+")":""}</button>
      ${ffCount()?`<button class="chip" onclick="ffReset()">${I("x","i s")} إلغاء</button>`:""}
    </div>
    ${WIDGETS}
    ${feed.length?feed.map(p=>postCard(p)).join(""):emptyState("msgsq","لا منشورات تطابق التصفية","غيّر التصفية أو تابع المزيد من الأوتاكو")}`,
    reels:()=>`<div class="secttl"><h3>${I("film","i s")} ريلز ساخنة <span class="badge b-red">LIVE</span></h3><button class="more" onclick="go('explore');S.discoveryMode='reels';render()">الكل ${I("fwd","i s")}</button></div>
      <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:6px" class="no-sb">${(S.reels||[]).slice(0,4).map(r=>reelCard(r,148)).join("")}</div>`,
    news:()=>`<div class="secttl"><h3>${I("sparkles","i s")} أخبار ساخنة</h3><button class="more" onclick="go('animeWiki',{cat:'news'})">الكل ${I("fwd","i s")}</button></div>
      <div class="col">${((S.wiki&&S.wiki.news)||[]).slice(0,2).map(nn=>`<button class="lstrow" onclick="go('newsDetail',{id:'${nn.id}'})">
        <span class="ico-tile" style="background:linear-gradient(135deg,${nn.c1},${nn.c2});">${I(nn.emo,"i l")}</span>
        <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(nn.t)}</span><span class="tiny fnt">${ago(nn.at)} ${nn.hot?'· <b style="color:var(--rose)"> ساخن</b>':""}</span></span>${I("fwd","i s")}</button>`).join("")}</div>`,
    worlds:()=>`<div class="secttl"><h3>${I("globe","i s")} عوالم الأنمي</h3><button class="more" onclick="go('worlds')">استكشف ${I("fwd","i s")}</button></div>
      <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:6px" class="no-sb">
        <button class="card2" style="min-width:126px;padding:14px 10px;text-align:center;border-style:dashed" onclick="go('createWorld')"><span style="color:var(--accent);display:flex;justify-content:center">${I("globe","xl")}</span><span class="tiny b" style="display:block;margin-top:7px">أنشئ عالمك</span></button>
        ${(S.worlds||[]).slice(0,4).map(w=>`<button class="card2" style="min-width:158px;padding:10px;text-align:right" onclick="go('worldRoom',{id:'${w.id}'})">
          <div class="row" style="gap:7px"><span class="ico-tile" style="width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,${w.c1},${w.c2});color:#fff">${I(w.icon,"i s")}</span><span class="tiny fnt mono">${I("users","i s")} ${nfmt(w.members)}</span></div>
          <div class="b xs" style="margin-top:7px;line-height:1.5">${esc(w.name)}</div>
          <div class="tiny fnt" style="margin-top:5px">${esc(w.theme)} · ${w.online} متصل</div></button>`).join("")}
      </div>`,
    continue:()=>(S.me.watching||[]).length?`<div class="secttl"><h3>${I("play","i s")} واصل المشاهدة</h3><button class="more" onclick="go('lastWatched')">الكل ${I("fwd","i s")}</button></div>
      <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:6px" class="no-sb">${(S.me.watching||[]).slice(0,5).map((w,i)=>{const a=S.wiki.anime[i]||{c1:"#7F1D1D",c2:"#EA580C",emo:"clapper"};const pct=Math.round(w.e/w.t*100);return `<button class="card2" style="min-width:150px;padding:9px;text-align:right" onclick="go('animeDetail',{id:'${(S.wiki.anime[i]||{id:"a1"}).id}'})">
        <div style="height:74px;border-radius:10px;overflow:hidden;position:relative">${art(a.c1,a.c2,a.emo,artBg(w.n))}</div>
        <div class="tiny b" style="margin-top:6px">${esc(w.n)}</div><div class="bar" style="height:4px;margin-top:4px"><i style="width:${pct}%"></i></div><div class="tiny fnt" style="margin-top:3px">الحلقة ${w.e} من ${w.t}</div></button>`}).join("")}</div>`:""
  };
  return `<div class="pad" style="padding-top:9px">${(S.sections.home||[]).map(k=>SEC[k]?SEC[k]():"").join("")}
    <div class="center" style="padding:22px 0 8px">
      <button class="btn btn-ghost btn-sm" id="feedRefresh" onclick="fetchNewPosts()">${I("refresh","i s")} تحديث الخلاصة</button>
      <div class="tiny fnt" style="margin-top:9px">وصلت للنهاية — أنمي بلاك</div>
    </div></div>`;
};
S.feedSort="ai";

function postCard(p){
  const au=u(p.authorId, p);
  const media=p.media?(p.media.imgs&&p.media.imgs.length>1?albumGrid(p):`<div class="ph" onclick="openMedia('${p.media.c1}','${p.media.c2}','${p.media.emo}','منشور: '+${JSON.stringify((p.text||'').slice(0,40)).replace(/"/g,"&quot;")},'${p.id}')" style="cursor:pointer;max-height:${mh()};overflow:hidden">${p.media.src?(p.media.kind==="video"?`<video src="${p.media.src}" controls style="width:100%;max-height:${mh()};display:block;background:#000"></video>`:`<img src="${p.media.src}" alt="" style="width:100%;max-height:${mh()};object-fit:cover;display:block">`):art(p.media.c1,p.media.c2,p.media.emo,artBg(p.id))}
      ${p.type==="video"?`<button class="iconbtn" style="position:absolute;background:rgba(0,0,0,.6);color:#fff;border-color:rgba(255,255,255,.25);width:52px;height:52px;border-radius:50%;z-index:2" onclick="event.stopPropagation();togglePlay(this,'${p.id}')">${I("play","l")}</button>`:""}
      ${p.type==="news"?`<span class="badge b-red" style="position:absolute;top:9px;right:9px;z-index:2">${I("sparkles","i s")} خبر رسمي</span>`:""}
    </div>`):"";
  return `<article class="post ${S.viewType==="list"?"post-list":S.viewType==="compact"?"post-compact":""} ${p.eventId?"evwave":""}" id="post_${p.id}" data-ctx="post:${p.id}" ondblclick="dblLike('${p.id}',event)">
    ${p.eventId?`<div class="row" style="gap:6px;padding:8px 12px 0"><span class="badge b-gold">${I("calendar","i s")} ${esc(((S.events||[]).find(e=>e.id===p.eventId)||{}).title||"فعالية")}</span><span class="tiny fnt" style="color:var(--gold)">مشاركة فعالية</span></div>`:""}
    <div class="row" style="padding:10px 11px;gap:9px">
      <button onclick="openProfile('${au.id}')" style="flex-shrink:0">${av(au,40,true)}</button>
      <div class="g1" style="min-width:0">
        <div class="row" style="gap:5px;flex-wrap:wrap">
          <button class="b sm" onclick="openProfile('${au.id}')">${esc(au.name)}</button>${vbadge(au)}${lvlBadge(au)}
          ${au.online?'<span style="width:7px;height:7px;border-radius:50%;background:var(--emerald);box-shadow:0 0 7px var(--emerald)"></span>':""}
        </div>
        <div class="tiny fnt">@${esc(au.username)} · ${ago(p.createdAt)}${p.edited?" · عُدّل":""}${p.feeling?" · يشعر بـ "+esc(p.feeling):""} · ${I(p.privacy==="public"?"globe":"lock","i s")}${p.pending && !p.failed ? ` · <span class="badge b-cyan tiny" style="padding:1px 6px;gap:3px;font-size:10px;vertical-align:middle" id="pend_${p.id}">${I("clock","i s")} جاري النشر...</span>` : p.failed ? ` · <button class="badge b-red tiny" style="padding:1px 6px;gap:3px;font-size:10px;vertical-align:middle;cursor:pointer" id="pend_${p.id}" onclick="event.stopPropagation();retryPendingPost('${p.id}')">${I("refresh","i s")} إعادة المحاولة</button>` : ""}</div>
      </div>
      <button class="iconbtn" style="width:30px;height:30px;background:transparent;border:none" onclick="openSheet('postMenu','${p.id}')">${I("more")}</button>
    </div>
    ${p.text?`<div class="sm" style="padding:0 12px 10px;white-space:pre-wrap">${(p.spoiler&&(S.ff||{}).spoiler&&!p.spRev)?`<span style="filter:blur(8px);user-select:none;display:block">${richText(sensTxt(p.text))}</span><button class="btn btn-sec btn-xs" style="margin-top:6px" onclick="event.stopPropagation();const _p=(S.posts||[]).find(x=>x.id==='${p.id}');if(_p)_p.spRev=1;render()">${I("eye","i s")} كشف السبويلر</button>`:richText(sensTxt(p.text))}</div>`:""}${p.newsMeta?`<div class="tiny fnt" style="padding:0 12px 8px;color:var(--accent)">${I("shield","i s")} المصدر: ${esc(p.newsMeta.src)} · ${esc(p.newsMeta.cat)}${p.newsMeta.verified?" · موثّق":""}</div>`:""}${p.loc?`<div class="tiny fnt" style="padding:0 12px 8px;color:var(--accent)">${I("map","i s")} ${esc(p.loc)}</div>`:""}${p.lockC?`<div class="tiny fnt" style="padding:0 12px 8px">${I("lock","i s")} التعليقات مقفلة</div>`:""}
    ${p.tags&&(p.tags||[]).length?`<div class="row wrap" style="gap:5px;padding:0 12px 9px">${p.tags.map(t=>`<button class="badge b-cyan" onclick="S.searchQ='${esc2tag(t)}';go('search')">#${esc(tagx(t))}</button>`).join("")}</div>`:""}
    ${p.type==="poll"?pollBox(p):""}
    ${p.event?`<div class="card2" style="margin:0 12px 9px;padding:10px"><div class="rowb" style="border:none;padding:0"><span class="b tiny">${I("calendar","i s")} فعالية ${esc(p.event.d)} · ${esc(p.event.t)}</span><span class="badge b-gold">قادمة</span></div>${p.event.loc?`<div class="tiny mut" style="margin-top:4px">${I("map","i s")} ${esc(p.event.loc)}</div>`:""}</div>`:""}
    ${media}
    <div class="row" style="gap:11px;padding:7px 12px 0">
      <button class="tiny mut b" style="background:none;border:none;padding:0" onclick="openSheet('whoLiked','${p.id}')">${nfmt(p.likes)} إعجاب</button>
      <span class="tiny fnt">${(p.comments||[]).length} تعليق</span>
      <span class="tiny fnt">${nfmt(p.shares||0)} مشاركة</span>
      <span class="tiny fnt g1" style="text-align:left">${nfmt(p.views)} مشاهدة</span>
    </div>
    <div class="acts" style="position:relative">
      <button class="act ${p.liked?'on liked':''}" id="like_${p.id}" onclick="toggleLike('${p.id}')" oncontextmenu="event.preventDefault();showReacts('${p.id}',this)" onmousedown="pressStart('${p.id}',this,event)" onmouseup="pressEnd()" ontouchstart="pressStart('${p.id}',this,event)" ontouchend="pressEnd()">
        ${IF(p.liked?"heart":"heart","i s")} <span>${p.liked?T("أعجبني"):T("إعجاب")}</span>
      </button>
      <button class="act" onclick="openComments('${p.id}')">${I("msgsq","i s")} ${T("تعليق")}</button>
      <button class="act" onclick="openSheet('shareSheet','${p.id}')">${I("share","i s")} مشاركة</button>
      <button class="act ${p.saved?'on':''}" onclick="toggleSave('${p.id}')">${I(p.saved?"bookmark":"bookmark","i s")} ${p.saved?"محفوظ":"حفظ"}</button>
      <button class="act" style="flex:0 0 40px" onclick="openSheet('postMenu','${p.id}')">${I("more","i s")}</button>
      <div id="reacts_${p.id}"></div>
    </div>
  </article>`;
}
let pressT=null;
function pressStart(pid,el,ev){pressT=setTimeout(()=>{showReacts(pid,el);if(navigator.vibrate)navigator.vibrate(20)},480)}
function pressEnd(){clearTimeout(pressT)}
function showReacts(pid,el){
  const box=$("#reacts_"+pid);if(!box)return;
  if(box.innerHTML){box.innerHTML="";return}
  box.innerHTML=`<div class="react-pop">${REACTS.map(([k,ic,l,c])=>`<button title="${l}" style="color:${c}" onclick="setReact('${pid}','${k}')">${IC(ic,"i")}</button>`).join("")}</div>`;
  setTimeout(()=>{if(box)box.innerHTML=""},3600);
}
function setReact(pid,k){
  const p=(S.posts||[]).find(x=>x.id===pid);if(!p)return;
  p.reaction=k;p.liked=true;p.likes++;
  const R=(REACTS||[]).find(r=>r[0]===k)||[k,"star",k,"var(--acc)"];
  const box=$("#reacts_"+pid);if(box)box.innerHTML="";
  toast("تفاعلت: "+R[2],"ok");snd("success");haptic("تفاعل "+R[2]);save();render();
}
function toggleLike(pid){
  const p=(S.posts||[]).find(x=>x.id===pid) || (window._cloudPosts && (window._cloudPosts||[]).find(x=>x.id===pid));
  if(!p)return;
  p.liked=!p.liked;p.likes+=p.liked?1:-1;
  if(p.liked){burst($("#like_"+pid));addXP(2)}
  snd("tap");haptic(p.liked?"إعجاب ":"إلغاء الإعجاب");save();render();
  if(window.auth && window.auth.currentUser) {
    try {
      window.setDoc(window.doc(window.db, 'posts', pid), {likes: p.likes}, {merge: true}).catch(e=>console.error(e));
    } catch(err) {}
  }
}
function dblLike(pid,ev){const p=(S.posts||[]).find(x=>x.id===pid);if(!p)return;bigHeart(ev?ev.clientX:0,ev?ev.clientY:0);if(!p.liked){toggleLike(pid)}else{snd("tap");haptic("أعجبك مسبقاً ")}}
function bigHeart(x,y){if(!S.motion||!x)return;const d=document.createElement("div");d.style.cssText=`position:fixed;left:${x-40}px;top:${y-40}px;width:80px;height:80px;z-index:999;pointer-events:none;animation:hb .75s ease-out forwards`;d.innerHTML='<svg viewBox="0 0 24 24" width="80" height="80" fill="#F43F5E" stroke="#fff" stroke-width="1"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.4 2.6 4.5 6.3 4.5c2.2 0 4.1 1.2 5.7 3.3 1.6-2.1 3.5-3.3 5.7-3.3 3.7 0 5.9 3.9 4.3 7.2C19.5 16.3 12 21 12 21z"/></svg>';document.body.appendChild(d);setTimeout(()=>d.remove(),800)}
function applyFontScale(){try{document.documentElement.style.zoom=(S.fontScale||1)}catch(e){}}
let ptrY=null,ptrOn=false;
document.addEventListener("touchstart",e=>{const pg=$("#page");ptrY=(S.page==="home"&&pg&&pg.scrollTop<=4&&e.touches[0].clientY)||null;ptrOn=false},{passive:true});
document.addEventListener("touchmove",e=>{if(ptrY==null)return;const d=e.touches[0].clientY-ptrY;const el=$("#ptr");if(!el)return;if(d>52){ptrOn=true;el.style.top=Math.min(d-52,58)+"px";el.style.opacity="1"}else if(ptrOn&&d<20){ptrOn=false;el.style.top="-46px";el.style.opacity="0"}},{passive:true});
document.addEventListener("touchend",()=>{if(ptrOn){const el=$("#ptr");if(el){el.style.top="-46px";el.style.opacity="0"}ptrOn=false;render();toast("تم تحديث الخلاصة ","ok")}ptrY=null},{passive:true});
function burst(el){if(!el||!S.motion)return;const r=el.getBoundingClientRect();for(let i=0;i<9;i++){const d=document.createElement("i");d.className="cf";d.style.cssText=`position:fixed;left:${r.left+r.width/2}px;top:${r.top+8}px;width:6px;height:9px;background:${pick(["#F43F5E","#22D3EE","#F59E0B"])};z-index:999;animation:fall .8s ease-out forwards;transform:translate(${rnd(-40,40)}px,${rnd(-50,-10)}px)`;document.body.appendChild(d);setTimeout(()=>d.remove(),900)}}
function toggleSave(pid){const p=(S.posts||[]).find(x=>x.id===pid);if(!p)return;p.saved=!p.saved;if(p.saved){S.me.saved.push(pid);toast("حُفظ في مفضلتك ","ok");questProgress("q3")}else{S.me.saved=S.me.saved.filter(x=>x!==pid);toast("أُزيل من المحفوظات","info")}snd("tap");save();render()}
function togglePlay(btn,pid){
  const on=btn.dataset.on==="1";btn.dataset.on=on?"0":"1";
  btn.innerHTML=I(on?"play":"pause","l");
  toast(on?"إيقاف مؤقت ":"تشغيل ","info");snd("tap");
}
function richText(t){if(!t)return"";let s=esc(t);
  s=s.split("\n").map(L=>{const q=L.startsWith("&gt; ")?L.slice(5):L.startsWith("» ")?L.slice(2):null;return q===null?L:`<span style="display:block;border-right:3px solid var(--accent);padding-right:9px;color:var(--muted);margin:3px 0">${q}</span>`}).join("\n");
  s=s.replace(/\*\*([^*\n]+)\*\*/g,"<b>$1</b>");
  s=s.replace(/_([^_\n]+)_/g,"<i>$1</i>");
  s=s.replace(/`([^`\n]+)`/g,'<span class="mono" style="background:var(--surface3);border-radius:5px;padding:0 4px">$1</span>');
  s=s.replace(/\[\[([a-z0-9-]+)\]\]/gi,(m,ic)=>ICONS.includes(ic)?`<span style="vertical-align:-4px;display:inline-block;line-height:0">${I(ic,"i s")}</span>`:m);
  s=s.replace(/#([\w\u0600-\u06FF_]+)/g,'<button class="badge b-cyan" style="vertical-align:middle" onclick="S.searchQ=\'$1\';go(\'search\')">#$1</button>');
  s=s.replace(/@([a-zA-Z0-9_]+)/g,'<b style="color:var(--accent)">@$1</b>');
  s=s.replace(/(https?:\/\/[^\s<]+)/g,'<a dir="ltr" style="color:var(--cyan)" href="$1">$1</a>');
  return s}
function albumGrid(p){const L=p.media.layout||"grid";const imgs=p.media.imgs;
  if(L==="single")return `<div class="ph" style="max-height:${mh()};overflow:hidden"><img src="${imgs[0]}" alt="" style="width:100%;max-height:${mh()};object-fit:cover;display:block"></div>`;
  if(L==="strip")return `<div class="row no-sb" style="gap:7px;overflow-x:auto;padding:2px 12px 8px">${imgs.map((src,i)=>`<img src="${src}" alt="" style="height:170px;border-radius:14px;object-fit:cover;flex-shrink:0">`).join("")}</div>`;
  return `<div style="display:grid;grid-template-columns:repeat(${imgs.length>3?2:imgs.length},1fr);gap:4px;padding:2px 12px 8px">${imgs.slice(0,6).map((src,i)=>`<div style="position:relative"><img src="${src}" alt="" style="width:100%;height:150px;object-fit:cover;border-radius:12px;display:block">${i===5&&imgs.length>6?`<span class="badge b-gray mono" style="position:absolute;inset:0;margin:auto;width:max-content;height:max-content">+${imgs.length-6}</span>`:""}</div>`).join("")}</div>`}
function pollBox(p){
  const tot=p.poll.options.reduce((a,o)=>a+o.v,0)||1;
  return `<div style="padding:2px 12px 12px" class="col">
    ${p.poll.options.map(o=>{const pct=Math.round(o.v/tot*100);const mine=p.poll.voted===o.id;
      return `<button class="card2" style="padding:0;overflow:hidden;position:relative;text-align:right" onclick="votePoll('${p.id}','${o.id}')">
        ${p.poll.voted?`<i style="position:absolute;inset:0;width:${pct}%;background:${mine?'rgba(34,211,238,.22)':'var(--surface3)'};transition:width .5s"></i>`:""}
        <span class="rowb" style="padding:9px 12px;position:relative">
          <span class="row xs b" style="gap:6px">${mine?I("check","i s"):""} ${esc(o.t)}</span>
          ${p.poll.voted?`<span class="badge ${mine?'b-red':'b-gray'} mono">${pct}% · ${nfmt(o.v)}</span>`:""}
        </span></button>`}).join("")}
    <div class="tiny fnt center">${nfmt(tot)} صوت ${p.poll.once?"· صوت واحد لكل عضو":""} ${p.poll.end&&Date.now()>p.poll.end?"· انتهى التصويت":p.poll.voted?"":"· اضغط للتصويت"}</div>
  </div>`;
}
function votePoll(pid,oid){
  const p=(S.posts||[]).find(x=>x.id===pid);if(!p)return;
  if(p.poll.end&&Date.now()>p.poll.end){toast("انتهى وقت التصويت في هذا الاستطلاع ","info");snd("error");return}
  if(p.poll.voted!=null){toast("صوّت مسبقاً — النتائج معروضة في المنشور ","info");return}
  p.poll.voted=oid;((p.poll&&p.poll.options)||[]).find(o=>o.id===oid).v++;
  addXP(5,"التصويت في استطلاع");snd("success");haptic("تم التصويت");save();render();
  if(window.auth&&window.auth.currentUser&&window.db){
    window.setDoc(window.doc(window.db,"posts",pid),{poll:p.poll},{merge:true}).catch(e=>console.error(e));
  }
}

/* ---- بطاقة ريلز ---- */
function reelCard(r,w=170){
  const uu=u(r.userId);
  return `<div class="reel" style="width:${w}px;flex-shrink:0;cursor:pointer" onclick="go('reelView',{id:'${r.id}'})">
    ${art(r.c1,r.c2,r.emo)}
    <div class="side">
      <button onclick="event.stopPropagation();reelLike('${r.id}',this)">${IF("heart","l")}<span>${nfmt(r.likes)}</span></button>
      <button onclick="event.stopPropagation();go('reelView',{id:'${r.id}',c:1})">${I("msgsq","l")}<span>${nfmt(r.cmts)}</span></button>
      <button onclick="event.stopPropagation();openSheet('shareSheet','${r.id}')">${I("share","l")}<span>${nfmt(r.shares)}</span></button>
    </div>
    <div class="info">
      <div class="row" style="gap:6px;margin-bottom:5px">${av(uu,24)}<span class="xs b">${esc(uu.name)}</span>${vbadge(uu)}</div>
      <div class="tiny" style="margin-bottom:4px">${esc(r.cap)}</div>
      <div class="tiny row" style="gap:4px;opacity:.8">${I("music","i s")}<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.music)}</span></div>
    </div>
  </div>`;
}
function reelLike(rid,el){const r=(S.reels||[]).find(x=>x.id===rid);if(!r)return;r.liked=!r.liked;r.likes+=r.liked?1:-1;el.style.color=r.liked?"#F43F5E":"#fff";el.querySelector("span").textContent=nfmt(r.likes);snd("tap");haptic(r.liked?"إعجاب":"إلغاء");save();if(window.auth&&window.auth.currentUser&&window.db){window.setDoc(window.doc(window.db,"reels",rid),{likes:r.likes},{merge:true}).catch(e=>console.error(e));}}

/* ============================================================
   6) الاستكشاف: توصيات الذكاء + البحث
   ============================================================ */
PAGES.explore=()=>{
  S.activeTab="explore";
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="hbox" onclick="back()">${I("back")}</button>
    <div class="ttl">الاستكشاف<small>DISCOVER</small></div>
    ${coinChip()}</div>`);
  setNav(true);
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div style="display:flex;gap:7px;padding:9px;border-bottom:1px solid var(--line);flex-shrink:0">
      <button class="g1 btn ${S.exploreSub==='ai'?'btn-primary':'btn-sec'} btn-sm" onclick="S.exploreSub='ai';save();render();snd('tap')">${I("sparkles","i s")} توصيات الذكاء الاصطناعي</button>
      <button class="g1 btn ${S.exploreSub==='search'?'btn-primary':'btn-sec'} btn-sm" onclick="S.exploreSub='search';save();render();snd('tap')">${I("search","i s")} البحث والاستكشاف</button>
    </div>
    <div style="flex:1;overflow-y:auto" class="no-sb">
      ${S.exploreSub==="ai"?aiFeed():searchPage()}
    </div>
  </div>`;
};
function strHash(x){let h=0;const t=String(x);for(let i=0;i<t.length;i++)h+=t.charCodeAt(i);return h}
function hcount(t){return 2+strHash(t)%398}
function buildAff(){const a={names:{},genres:{},authors:{}};
  (S.me.history||[]).forEach(h=>{const an=((S.wiki&&S.wiki.anime)||[]).find(x=>x.id===h.a);if(an){a.names[an.n]=(a.names[an.n]||0)+2;(an.genres||[]).forEach(g=>{const g2=g.replace(/\s*\(.*\)/,"");a.genres[g2]=(a.genres[g2]||0)+1})}});
  S.posts.forEach(p=>{if(p.liked)(p.tags||[]).forEach(t=>{const x=tagx(t);a.names[x]=(a.names[x]||0)+2})});
  (S.following||[]).forEach(id=>{a.authors[id]=3});
  return a}
function whyFor(p,A){const tags=(p.tags||[]).map(t=>tagx(t));
  const hit=tags.find(x=>A.names[x]);if(hit)return "لأن ذوقك يرتبط بـ #"+hit+" (سجل مشاهداتك وإعجاباتك)";
  if(A.authors[p.authorId])return "من صانع تتابعه وتتفاعل معه";
  if(S.aiMood==="trending"&&p.likes>200)return "رائج الآن: "+nfmt(p.likes)+" إعجاب و"+nfmt(p.views)+" مشاهدة";
  if(S.aiMood==="deep_cuts"&&p.likes<150)return "جوهرة مخفية: تفاعل قليل لكنه مطابق لذوقك";
  const g=(Object.keys(A.genres)||[])[0];if(g)return "يقارب تصنيفاً تحبه: "+g;
  return "يناسب مزاج التوصية الحالي"}
function recList(mode){const A=buildAff();const seed=S.recSeed||0;const out=[];
  if(mode==="reels"){S.reels.forEach(r=>{let sc=(strHash(r.id+":"+seed)%10)/10;const an=((S.wiki&&S.wiki.anime)||[]).find(x=>(r.cap||"").includes(x.n));if(an&&A.names[an.n])sc+=A.names[an.n];if(S.aiMood==="trending")sc+=r.likes/20000;if(S.aiMood==="deep_cuts")sc+=r.likes<5000?2:0;out.push({item:r,s:sc,why:an&&A.names[an.n]?"لأنك شاهدت "+an.n:S.aiMood==="trending"?"ريلز رائج الآن":"مختار لذوقك"})});return out.sort((a,b)=>b.s-a.s)}
  if(mode==="creators"){S.users.filter(x=>!S.following.includes(x.id)).forEach(x=>{let sc=(strHash(x.id+":"+seed)%10)/10+x.followers/900000+(x.verified?2:0);const bio=x.bio||"";Object.keys(A.genres).forEach(g=>{if(bio.includes(g))sc+=2});out.push({item:x,s:sc,why:Object.keys(A.genres).find(g=>bio.includes(g))?"يصنع محتوى تصنيف تحبه":"صانع موثوق يناسب ذوقك"})});return out.sort((a,b)=>b.s-a.s)}
  S.posts.forEach(p=>{let sc=(strHash(p.id+":"+seed)%10)/10;(p.tags||[]).forEach(t=>{const x=tagx(t);if(A.names[x])sc+=A.names[x]});if(A.authors[p.authorId])sc+=3;if(p.liked)sc-=4;if(S.aiMood==="trending")sc+=(p.likes+p.views/60)/400;if(S.aiMood==="deep_cuts")sc+=p.likes<150?3:-(p.likes/500);out.push({item:p,s:sc,why:whyFor(p,A)})});
  return out.sort((a,b)=>b.s-a.s)}
function refreshRecs(){S.recSeed=(S.recSeed||0)+1;save();render();snd("success");toast("تم تحديث توصياتك ","ok")}
function voiceSearch(){const R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){toast("التعرف الصوتي غير مدعوم في متصفحك ","info");return}try{const r=new R();r.lang="ar-SA";r.onresult=e=>{const t=e.results[0][0].transcript;S.searchQ=t;save();render();toast("سمعت: "+t,"ok")};r.onerror=()=>toast("تعذّر التعرف الصوتي ","err");r.start();toast("استمع... قل اسم أنمي أو شخصية ","info")}catch(e){toast("التعرف الصوتي غير متاح ","err")}}
function aiFeed(){
  const moods=[["balanced","متوازن","target"],["trending","الرائج","flame"],["deep_cuts","جواهر مخفية","gem"]];
  const modes=[["posts","منشورات","msgsq"],["reels","ريلز","film"],["creators","صنّاع","users"]];
  const mode=S.discoveryMode==="reels"?"reels":S.discoveryMode==="creators"?"creators":"posts";
  const recs=recList(mode).slice(0,mode==="posts"?4:8);
  S.lastRecs=recs.map(r=>({t:(r.item.text||r.item.cap||r.item.n||r.item.name||"").slice(0,44),why:r.why}));
  return `<div class="pad" style="padding-top:11px">
    <div class="card" style="padding:13px;margin-bottom:12px;background:linear-gradient(135deg,rgba(34,211,238,.12),rgba(168,85,247,.09));border-color:rgba(34,211,238,.25)">
      <div class="row" style="gap:9px"><span class="ico-tile" style="background:var(--grad-fire)">${I("sparkles","i s")}</span>
        <div class="g1"><div class="b sm">محرك التوصيات الذكي</div><div class="tiny fnt">يحّلل ذوقك من ${(S.me.history||[]).length} عنصر مشاهدة و${S.posts.filter(p=>p.liked).length} إعجاب و${(S.following||[]).length} متابعة</div></div>
        <button class="iconbtn" onclick="refreshRecs()">${I("refresh")}</button>
      </div>
      <div class="div"></div>
      <div class="lbl">مزاج التوصية</div>
      <div class="chiprow">${moods.map(([k,l,e])=>`<button class="chip ${S.aiMood===k?"on":""}" onclick="S.aiMood='${k}';save();render();snd('tap');toast('المزاج: ${l}','info')">${I(e,"i s")} ${l}</button>`).join("")}</div>
      <div class="lbl">نوع المحتوى</div>
      <div class="chiprow">${modes.map(([k,l,ic])=>`<button class="chip ${S.discoveryMode===k?"on":""}" onclick="S.discoveryMode='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    </div>
    ${mode==="posts"?`
      <div class="secttl"><h3>${I("sparkles","i s")} مختارة لك <span class="badge b-purple">AI ${S.aiMood==="trending"?"· رائج":S.aiMood==="deep_cuts"?"· جواهر":"· متوازن"}</span></h3></div>
      ${recs.map(r=>postCard(r.item)).join("")}
      <div class="card2" style="padding:12px;text-align:center"><div class="tiny mut">لماذا هذه التوصيات؟</div>
        <button class="btn btn-ghost btn-xs" style="margin-top:7px" onclick="openSheet('whySheet')">${I("info","i s")} اشرح لي السبب</button></div>
    `:mode==="reels"?`
      <div class="secttl"><h3>${I("film","i s")} ريلز قد تعجبك</h3></div>
      <div class="grid2">${recs.map(r=>reelCard(r.item,"100%")).join("")}</div>
    `:`
      <div class="secttl"><h3>${I("users","i s")} صنّاع مقترحون للمتابعة</h3></div>
      <div class="col">${recs.map(r=>{const x=r.item;return `<div class="lstrow"><button onclick="openProfile('${x.id}')">${av(x,44)}</button>
          <div class="g1" style="min-width:0"><div class="row" style="gap:4px"><button class="b xs" onclick="openProfile('${x.id}')">${esc(x.name)}</button>${vbadge(x)}${lvlBadge(x)}</div>
            <div class="tiny fnt">@${esc(x.username)} · ${nfmt(x.followers)} متابع · ${esc(r.why)}</div></div>
          <button class="btn btn-primary btn-xs" onclick="follow('${x.id}')">متابعة</button>
        </div>`}).join("")}</div>
    `}
    <div class="center" style="padding:16px 0"><button class="btn btn-ghost btn-sm" onclick="refreshRecs()">${I("refresh","i s")} حمّل توصيات أخرى</button></div>
  </div>`;
}
function searchCommit(){const q=(S.searchQ||"").trim();if(q.length>1){S.searchHistory=[q,...(S.searchHistory||[]).filter(x=>x!==q)].slice(0,8);save();render()}}
function searchPage(){
  const q=(S.searchQ||"").trim().toLowerCase();
  const tabs=[["all","الكل","grid"],["users","أشخاص","users"],["posts","منشورات","msgsq"],["anime","أنمي","film"],["manga","مانجا","book"],["chars","شخصيات","star"],["communities","مجتمعات","users"],["hashtags","هاشتاقات","hash"],["reels","ريلز","clapper"]];
  const fu=q?S.users.filter(x=>(x.name+x.username+x.bio).toLowerCase().includes(q)):S.users;
  const allPosts = window._cloudPosts ? [...window._cloudPosts, ...S.posts.filter(p => !(window._cloudPosts||[]).find(cp => cp.id === p.id))].sort((a,b)=>b.createdAt-a.createdAt) : S.posts.slice();
  const fp0=q?allPosts.filter(p=>((p.text||"")+" "+(p.tags||[]).join(" ")).toLowerCase().includes(q)):allPosts.slice(0,3);
  const fp=(S.searchSort==="likes"?(fp0||[]).slice().sort((a,b)=>b.likes-a.likes):(fp0||[]).slice().sort((a,b)=>b.createdAt-a.createdAt));
  const fa=q?S.wiki.anime.filter(a=>(a.n+a.en+a.studio).toLowerCase().includes(q)):((S.wiki&&S.wiki.anime)||[]).slice(0,3);
  const fm=q?S.wiki.manga.filter(a=>(a.n+a.en).toLowerCase().includes(q)):((S.wiki&&S.wiki.manga)||[]).slice(0,2);
  const fc=q?S.wiki.chars.filter(a=>(a.n+a.anime).toLowerCase().includes(q)):((S.wiki&&S.wiki.chars)||[]).slice(0,3);
  const fg=q?S.communities.filter(a=>(a.name+a.desc).toLowerCase().includes(q)):(S.communities||[]).slice(0,3);
  const fr=q?S.reels.filter(r=>((r.cap||"")+(r.music||"")+(u(r.userId).name)).toLowerCase().includes(q)):S.reels;
  const tagC={};S.posts.forEach(p=>(p.tags||[]).forEach(t=>{const x=tagx(t);tagC[x]=(tagC[x]||0)+1}));
  let tags=Object.keys(tagC).sort((a,b)=>tagC[b]-tagC[a]);if(q)tags=tags.filter(x=>x.toLowerCase().includes(q));
  S.searchSort=S.searchSort||"latest";
  const t=S.searchTab||"all";
  const show=k=>t==="all"||t===k;
  const total=fu.length+fp.length+fa.length+fm.length+fc.length+fg.length+fr.length+tags.length;
  return `<div class="pad" style="padding-top:11px">
    <div class="row" style="gap:8px;margin-bottom:11px">
      <div class="row g1" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:13px;padding:9px 12px">
        <span style="color:var(--muted)">${I("search","i s")}</span>
        <input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث عن أنمي، أشخاص، منشورات، مجتمعات..." value="${esc(S.searchQ)}" oninput="S.searchQ=this.value;searchLive()" onchange="searchCommit()" id="sq">
        ${S.searchQ?`<button onclick="S.searchQ='';save();render()" style="color:var(--muted)">${I("x","i s")}</button>`:""}
      </div>
      <button class="iconbtn" onclick="voiceSearch()" title="بحث صوتي">${I("mic")}</button>
      <button class="iconbtn" onclick="go('search')">${I("fwd")}</button>
    </div>
    ${q?`<div class="tiny fnt" style="margin:-4px 0 9px">${I("info","i s")} ${total} نتيجة لـ «${esc(S.searchQ)}»</div>`:""}
    ${!q&&(S.searchHistory||[]).length?`<div class="chiprow" style="margin-bottom:8px">${S.searchHistory.map(hh=>`<button class="chip" onclick="S.searchQ='${esc(hh)}';save();render()">${I("clock","i s")} ${esc(hh)}</button>`).join("")}<button class="chip" onclick="S.searchHistory=[];save();render();toast('مُسح سجل البحث ','info')">${I("trash","i s")}</button></div>`:""}
    <div class="chiprow">
      ${q?`<button class="chip" onclick="S.searchQ='';save();render()">${I("x","i s")} مسح</button>`:""}
      ${tabs.map(([k,l,ic])=>`<button class="chip ${t===k?"on":""}" onclick="S.searchTab='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}
    </div>
    ${t==="posts"?`<div class="chiprow" style="margin-top:6px">${[["latest","الأحدث","clock"],["likes","الأكثر إعجاباً","heart"]].map(([k,l,ic])=>`<button class="chip ${S.searchSort===k?"on":""}" onclick="S.searchSort='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>`:""}
    ${!q&&t==="all"?`<div class="secttl"><h3>${I("trend","i s")} الأكثر بحثاً اليوم</h3></div>
      <div class="chiprow wrap">${["هجوم العمالقة","جوجوتسو كايسن","فريـرن","ون بيس ١١٢٠","قاتل الشياطين","ليفاي","MAPPA","#أنمي_بلاك"].map((x,i)=>`<button class="chip" onclick="S.searchQ='${x}';save();searchCommit()"><span class="mono b" style="color:var(--accent)">${i+1}</span> ${x} <span class="mono tiny fnt">${hcount(x)}K</span></button>`).join("")}</div>`:""}
    ${show("users")&&fu.length?`<div class="secttl"><h3>${I("users","i s")} أشخاص ${q?`<span class="tiny fnt">(${fu.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='users';render()">الكل</button>`:""}</div>
      <div class="col">${(fu||[]).slice(0,t==="all"?3:50).map(x=>`<div class="lstrow"><button onclick="openProfile('${x.id}')">${av(x,42)}</button>
        <div class="g1" style="min-width:0"><div class="row" style="gap:4px"><button class="b xs" onclick="openProfile('${x.id}')">${esc(x.name)}</button>${vbadge(x)}</div><div class="tiny fnt">@${esc(x.username)} · ${nfmt(x.followers)} متابع</div></div>
        <button class="btn ${S.following.includes(x.id)?"btn-sec":"btn-primary"} btn-xs" onclick="follow('${x.id}')">${S.following.includes(x.id)?"يتابع":"متابعة"}</button></div>`).join("")}</div>`:""}
    ${show("anime")&&fa.length?`<div class="secttl"><h3>${I("film","i s")} أنمي ${q?`<span class="tiny fnt">(${fa.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='anime';render()">الكل</button>`:""}</div>
      <div class="col">${(fa||[]).slice(0,t==="all"?3:50).map(a=>animeRow(a)).join("")}</div>`:""}
    ${show("manga")&&fm.length?`<div class="secttl"><h3>${I("book","i s")} مانجا ${q?`<span class="tiny fnt">(${fm.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='manga';render()">الكل</button>`:""}</div>
      <div class="col">${(fm||[]).slice(0,t==="all"?2:50).map(a=>mangaRow(a)).join("")}</div>`:""}
    ${show("chars")&&fc.length?`<div class="secttl"><h3>${I("star","i s")} شخصيات ${q?`<span class="tiny fnt">(${fc.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='chars';render()">الكل</button>`:""}</div>
      <div class="col">${(fc||[]).slice(0,t==="all"?3:50).map(c=>charRow(c)).join("")}</div>`:""}
    ${show("communities")&&fg.length?`<div class="secttl"><h3>${I("users","i s")} مجتمعات ونقابات ${q?`<span class="tiny fnt">(${fg.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='communities';render()">الكل</button>`:""}</div>
      <div class="col">${(fg||[]).slice(0,t==="all"?3:50).map(c=>`<div class="lstrow" onclick="go('communityDetail',{id:'${c.id}'})">
        <span class="ico-tile" style="background:linear-gradient(135deg,${c.c1},${c.c2});">${I(c.icon,"i l")}</span>
        <div class="g1" style="min-width:0"><div class="b xs">${esc(c.name)}</div><div class="tiny fnt">${nfmt(c.members)} عضو · ${c.online} متصل</div></div>${I("fwd","i s")}</div>`).join("")}</div>`:""}
    ${show("posts")&&fp.length?`<div class="secttl"><h3>${I("msgsq","i s")} منشورات ${q?`<span class="tiny fnt">(${fp.length})`:""}</h3>${t==="all"?`<button class="more" onclick="S.searchTab='posts';render()">الكل</button>`:""}</div>
      ${(fp||[]).slice(0,t==="all"?3:50).map(p=>postCard(p)).join("")}`:""}
    ${show("hashtags")?`<div class="secttl"><h3>${I("hash","i s")} هاشتاقات ${q?"مطابقة":"رائجة"}</h3></div>
      <div class="chiprow wrap">${(tags||[]).slice(0,10).map(hh=>`<button class="chip" onclick="S.searchQ='${hh}';save();searchCommit()">#${hh}<span class="mono tiny fnt">${tagC[hh]}</span></button>`).join("")||`<span class="tiny fnt">لا هاشتاقات مطابقة</span>`}</div>`:""}
    ${show("reels")?`<div class="secttl"><h3>${I("clapper","i s")} ريلز ${q?`<span class="tiny fnt">(${fr.length})`:""}</h3></div>${fr.length?`<div class="grid2">${(fr||[]).slice(0,t==="all"?4:20).map(r=>reelCard(r,"100%")).join("")}</div>`:`<div class="tiny fnt" style="padding:6px">لا ريلز مطابقة</div>`}`:""}
    ${q&&!total?emptyState("search","لا نتائج لـ «"+S.searchQ+"»","جرّب كلمات أخرى أو تبويباً مختلفاً"):""}
  </div>`;
}
let hslT=null;function homeSearchLive(){clearTimeout(hslT);hslT=setTimeout(()=>{const v=document.getElementById("hsq").value;render();const n=document.getElementById("hsq");if(n){n.focus();n.setSelectionRange(v.length,v.length)}},200)}
let slT=null;function searchLive(){clearTimeout(slT);slT=setTimeout(()=>{const v=$("#sq").value,sc=$("#sq").selectionStart;render();const n=$("#sq");if(n){n.focus();n.setSelectionRange(v.length,v.length)}},320)}
PAGES.search=()=>{S.activeTab="explore";S.exploreSub="search";setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%"><button class="iconbtn" onclick="go('explore')">${I("back")}</button><div class="ttl">البحث<small>SEARCH</small></div></div>`);setNav(true);return `<div style="height:100%;overflow-y:auto" class="no-sb">${searchPage()}</div>`};

function animeRow(a){return `<button class="lstrow" onclick="go('animeDetail',{id:'${a.id}'})">
  ${tileImg(a,48,62,10)}
  <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(a.n)}</span>
   <span class="tiny fnt mono" style="display:block">${esc(a.en)} · ${a.y} · ${a.ep} حلقة</span>
   <span class="row" style="gap:4px;margin-top:3px"><span class="badge b-gold">${I("star","i s")} ${a.rating}</span><span class="badge ${a.status==='مستمر'?'b-emerald':'b-gray'}">${a.status}</span></span></span>
  ${I("fwd","i s")}</button>`}
function mangaRow(a){return `<button class="lstrow" onclick="go('mangaDetail',{id:'${a.id}'})">
  ${tileImg(a,48,62,10)}
  <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(a.n)}</span>
   <span class="tiny fnt mono" style="display:block">${esc(a.en)} · ${a.ch} فصل</span>
   <span class="row" style="gap:4px;margin-top:3px"><span class="badge b-gold">${I("star","i s")} ${a.rating}</span><span class="badge b-gray">${a.status}</span></span></span>
  ${I("fwd","i s")}</button>`}
function charRow(c){return `<button class="lstrow" onclick="go('charDetail',{id:'${c.id}'})">
  <span class="ico-tile" style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,${c.c1},${c.c2});">${I(c.emo,"i l")}</span>
  <span class="g1" style="text-align:right"><span class="b xs" style="display:block">${esc(c.n)}</span>
   <span class="tiny fnt" style="display:block">${esc(c.anime)} · ${esc(c.role)}</span>
   <span class="row" style="gap:5px;margin-top:3px"><span class="badge b-red">قوة ${c.power}</span><span class="tiny fnt">${IF("heart","i s")} ${nfmt(c.likes)}</span></span></span>
  ${I("fwd","i s")}</button>`}

/* ============================================================
   7) عرض المنشور + التعليقات + الريلز
   ============================================================ */
PAGES.postView=()=>{
  const p=(S.posts||[]).find(x=>x.id===S.params.pid);if(!p){setNav(false);setHdr(backHdr("المنشور",""));return emptyState("alert","المنشور غير موجود","")}
  const au=u(p.authorId, p);(S.viewedPosts=S.viewedPosts||[]);if(!S.viewedPosts.includes(p.id)){S.viewedPosts.push(p.id);p.views++}
  setHdr(backHdr("منشور "+au.name,"@"+au.username,`<button class="iconbtn" onclick="openSheet('postMenu','${p.id}')">${I("more")}</button>`));setNav(true);
  return `<div class="pad">${postCard(p)}
    <div class="secttl"><h3>${I("msgsq","i s")} التعليقات (${(p.comments||[]).length})</h3><button class="more" onclick="openComments('${p.id}')">كل التعليقات</button></div>
    <div class="card" style="padding:12px">${commentList(p)}</div>
    <div class="secttl"><h3>${I("sparkles","i s")} منشورات ذات صلة</h3></div>
    ${S.posts.filter(x=>x.id!==p.id).slice(0,2).map(x=>postCard(x)).join("")}
  </div>`;
};
function commentList(p){
  if(!(p.comments||[]).length)return `<div class="empty" style="padding:20px">${I("msgsq","l")}<div class="xs b">لا تعليقات بعد</div><div class="tiny fnt">كن أول من يعلّق</div></div>`;
  return (p.comments||[]).slice().sort((a,b)=>S.cmtSort==="old"?a.createdAt-b.createdAt:b.createdAt-a.createdAt).map(c=>{const cu=u(c.userId);return `
    <div class="cmt" id="cm_${c.id}" data-ctx="cmt:${c.id}">
      <button onclick="openProfile('${cu.id}')">${av(cu,32)}</button>
      <div class="g1" style="min-width:0">
        <div class="row" style="gap:5px"><button class="b tiny" onclick="openProfile('${cu.id}')">${esc(cu.name)}</button>${vbadge(cu)}<span class="tiny fnt">${ago(c.createdAt)}</span></div>
        <div class="xs" style="margin-top:2px">${richText(c.text)}</div>
        <div class="row" style="gap:12px;margin-top:5px">
          <button class="tiny b ${c.liked?'':''}" style="color:${c.liked?'var(--rose)':'var(--muted)'}" onclick="likeComment('${p.id}','${c.id}')">${IF("heart","i s")} ${c.likes}</button>
          <button class="tiny b mut" onclick="replyTo('${esc(cu.name)}')">${I("reply","i s")} رد</button>
          <button class="tiny b mut" onclick="toast('تم نسخ نص التعليق','ok');copyTxt(\`${esc(c.text).replace(/`/g,"'")}\`)">${I("copy","i s")} نسخ</button>
          <button class="tiny b mut" onclick="reportUser('${cu.id}')">${I("flag","i s")} إبلاغ</button>
          ${(c.userId==="me"||p.authorId==="me")?`<button class="tiny b mut" onclick="delComment('${p.id}','${c.id}')">${I("trash","i s")} حذف</button>`:""}
        </div>
      </div>
    </div>`}).join("");
}
function delComment(pid,cid){const p=(S.posts||[]).find(x=>x.id===pid);if(!p)return;const ci=(p.comments||[]).findIndex(x=>x.id===cid);if(ci<0)return;const snap=p.comments[ci];p.comments.splice(ci,1);save();render();snd("error");toast("حُذف التعليق ","err",()=>{const q=(S.posts||[]).find(x=>x.id===pid);if(!q)return;q.comments.splice(Math.min(ci,(q.comments||[]).length),0,snap);save();render();toast("استُعيد التعليق ","ok")})}
function likeComment(pid,cid){const p=(S.posts||[]).find(x=>x.id===pid);const c=(p.comments||[]).find(x=>x.id===cid);c.liked=!c.liked;c.likes+=c.liked?1:-1;snd("tap");save();render()}
function replyTo(name){const i=$("#cmtinp");if(i){i.value="@"+name+" ";i.focus();toast("رد على "+name,"info")}}
PAGES.comments=()=>{
  const p=(S.posts||[]).find(x=>x.id===S.params.pid);if(!p){setNav(false);setHdr(backHdr("التعليقات",""));return emptyState("alert","غير موجود","")}
  const au=u(p.authorId, p);
  setHdr(backHdr("التعليقات",(p.lockC?"مقفلة · ":"")+(p.comments||[]).length+" تعليق",`<button class="iconbtn" onclick="sortComments()">${I("filter")}</button>`));setNav(true);
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div style="flex:1;overflow-y:auto;padding:13px" class="no-sb">
      <div class="card2" style="padding:11px;margin-bottom:12px">
        <div class="row" style="gap:8px">${av(au,30)}<div class="g1"><div class="b tiny">${esc(au.name)}</div><div class="tiny fnt">${ago(p.createdAt)}</div></div></div>
        ${p.text?`<div class="xs" style="margin-top:7px">${esc(p.text)}</div>`:""}
      </div>
      ${commentList(p)}
    </div>
    <div class="composer">
      <button class="iconbtn" onclick="openSheet('emojiSheet')">${I("heart","i s")}</button>
      <textarea id="cmtinp" ${p.lockC?"disabled":""} rows="1" placeholder="اكتب تعليقاً... (كن محترماً)" oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px'"></textarea>
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="addComment('${p.id}')">${I("send","i s")}</button>
    </div>
  </div>`;
};
function sortComments(){S.cmtSort=S.cmtSort==="new"?"old":"new";snd("tap");render();toast(S.cmtSort==="new"?"ترتيب: الأحدث أولاً ":"ترتيب: الأقدم أولاً ","info")}
function addComment(pid){const _lp=(S.posts||[]).find(x=>x.id===pid);if(_lp&&_lp.lockC){toast("التعليقات مقفلة من قبل الناشر","err");snd("error");return}
  const i=$("#cmtinp");const t=(i.value||"").trim();
  if(!t){toast("اكتب تعليقاً أولاً","err");return}
  const p=(S.posts||[]).find(x=>x.id===pid);
  const newComment = {id:uid(),userId:window.auth && window.auth.currentUser ? window.auth.currentUser.uid : "me",text:t,likes:0,createdAt:now()};
  p.comments.push(newComment);
  i.value="";addXP(8,"تعليق جديد");questProgress("q2");snd("send");haptic("تم إرسال التعليق");save();render();
  if(window.auth && window.auth.currentUser) {
    try {
      window.setDoc(window.doc(window.db, 'posts', pid), {comments: p.comments}, {merge: true}).catch(e=>console.error(e));
    } catch(e) {}
  }
}
PAGES.reelView=()=>{
  const r=(S.reels||[]).find(x=>x.id===S.params.id);if(!r){setNav(false);setHdr(backHdr("الريلز",""));return emptyState("film","الريلز غير موجود","")}
  const uu=u(r.userId);
  setHdr("");setNav(false);
  return `<div style="height:100%;position:relative;background:#000;display:flex;flex-direction:column">
    <div style="position:absolute;inset:0">${art(r.c1,r.c2,r.emo,artBg(r.id))}</div>
    <div style="position:absolute;top:0;left:0;right:0;padding:12px;display:flex;gap:9px;align-items:center;background:linear-gradient(to bottom,rgba(0,0,0,.7),transparent);z-index:3">
      <button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="back()">${I("back")}</button>
      <div class="g1"><div class="tiny b" style="color:#fff">ريلز</div><div class="tiny" style="color:rgba(255,255,255,.6)">${nfmt(r.likes)} إعجاب</div></div>
      <button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="openSheet('reelMenu','${r.id}')">${I("more")}</button>
    </div>
    <button style="position:absolute;inset:0;z-index:2" onclick="toggleReelPlay(this)" id="reelplay"></button>
    <div style="position:absolute;bottom:0;left:0;right:0;padding:14px;z-index:3;background:linear-gradient(to top,rgba(0,0,0,.85),transparent)">
      <div class="row" style="gap:9px;margin-bottom:9px">
        <button onclick="openProfile('${uu.id}')">${av(uu,38,true)}</button>
        <div class="g1"><div class="row" style="gap:4px"><span class="b xs" style="color:#fff">${esc(uu.name)}</span>${vbadge(uu)}</div><div class="tiny" style="color:rgba(255,255,255,.6)">@${esc(uu.username)}</div></div>
        <button class="btn btn-primary btn-sm" onclick="follow('${uu.id}')">${S.following.includes(uu.id)?"يتابع":"متابعة"}</button>
      </div>
      <div class="xs" style="color:#fff;margin-bottom:6px">${esc(r.cap)}</div>
      <div class="row" style="gap:6px"><span class="badge b-gray">${I("music","i s")} ${esc(r.music)}</span><button class="badge ${S.reelMusic===r.music?'b-emerald':'b-red'}" onclick="pickReelMusic('${r.id}')">${I("save","i s")} ${S.reelMusic===r.music?"الصوت مُختار":"استخدم الصوت"}</button></div>
    </div>
    <div style="position:absolute;left:11px;bottom:110px;display:flex;flex-direction:column;gap:15px;z-index:4">
      <button class="col center" style="gap:2px;color:#fff" onclick="reelLike('${r.id}',this);this.style.color=this.style.color==='rgb(244, 63, 94)'?'#fff':'#F43F5E'">${IF("heart","l")}<span class="tiny b">${nfmt(r.likes)}</span></button>
      <button class="col center" style="gap:2px;color:#fff" onclick="openSheet('reelComments','${r.id}')">${I("msgsq","l")}<span class="tiny b">${nfmt(r.cmts)}</span></button>
      <button class="col center" style="gap:2px;color:#fff" onclick="openSheet('shareSheet','${r.id}')">${I("share","l")}<span class="tiny b">${nfmt(r.shares)}</span></button>
      <button class="col center" style="gap:2px;color:${r.saved?'var(--gold)':'#fff'}" onclick="toggleReelSave('${r.id}')">${IF(r.saved?"bookmark":"bookmark","l")}<span class="tiny b">${r.saved?"محفوظ":"حفظ"}</span></button>
      <button class="col center" style="gap:2px;color:#fff" onclick="openSheet('reelMenu','${r.id}')">${I("more","l")}<span class="tiny b">أخرى</span></button>
    </div>
  </div>`;
};
function toggleReelPlay(el){el.innerHTML=el.dataset.p==="1"?"":`<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center"><div style="width:64px;height:64px;border-radius:50%;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;color:#fff">${I(el.dataset.p==="1"?"play":"pause","xl")}</div></div>`;el.dataset.p=el.dataset.p==="1"?"0":"1";setTimeout(()=>{if(el)el.innerHTML=""},700);snd("tap")}

/* ============================================================
   8) الإنشاء: ورقة الإنشاء + الناشر الشامل + القصص
   ============================================================ */
const CREATE_TYPES=[
 ["post","منشور جديد","msgsq","var(--grad-fire)","اكتب ما يدور في ذهنك، أضف صوراً ووسوم"],
 ["poll","استطلاع رأي","barchart","var(--grad-cyan)","اسأل المجتمع وصوّت على الخيارات"],
 ["story","قصة تفاعلية","clock","var(--grad-rose)","قصة تختفي بعد ٢٤ ساعة مع ملصقات"],
 ["reel","فيديو ريلز","clapper","var(--grad-purple)","فيديو عمودي قصير مع موسيقى"],
 ["video","منشور فيديو","film","var(--grad-emerald)","فيديو بعنوان ووصف يُبث داخل الخلاصة"],
 ["channel","قناة إعلان","tv","var(--grad-fire)","قناة للبث الأحادي والإعلانات"],
 ["announcement","إعلان رسمي","shield","var(--grad-purple)","إعلان رسمي موثّق للمنصة أو المجتمع"]
];
PAGES.create=()=>{
  S.activeTab="create";
  const t=S.params.type||"post";
  const C=(CREATE_TYPES||[]).find(x=>x[0]===t)||CREATE_TYPES[0];
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('home')">${I("x")}</button>
    <div class="ttl">إنشاء ${C[1]}<small>${t.toUpperCase()}</small></div>
    <button class="iconbtn" onclick="openSheet('draftSheet')">${I("save")}</button></div>`);
  setNav(true);
  return `<div class="pad">
    <div class="chiprow">
      ${CREATE_TYPES.filter(x=>x[0]!=="live").map(([k,l,ic])=>`<button class="chip ${t===k?'on':''}" onclick="${createRoute(k)};snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}
      <button class="chip" onclick="go('createGroup')">${I("users","i s")} قروب</button>
      <button class="chip" onclick="go('createGuild')">${I("shield","i s")} نقابة</button>
      <button class="chip" onclick="go('createWorld')">${I("globe","i s")} عالم</button>
    </div>

    <div class="card" style="padding:13px;background:linear-gradient(135deg,rgba(34,211,238,.07),transparent)">
      <div class="row" style="gap:9px;margin-bottom:11px">${av(S.me,38,true)}
        <div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(S.me.name)}</span>${lvlBadge(S.me)}</div>
        <div class="tiny fnt">ينشر كـ <b style="color:var(--accent)">${esc(S.me.role)}</b> · ${S.me.equippedTitle?"لقب: "+esc(S.me.equippedTitle):"بدون لقب"}</div></div>
        <button class="btn btn-sec btn-xs" onclick="go('editProfile')">${I("edit","i s")} هويتي</button>
      </div>
      <textarea class="inp" id="pub_txt" rows="4" placeholder="${t==='poll'?'اكتب سؤال الاستطلاع...':t==='news'?'عنوان الخبر الرسمي...':'ماذا تريد أن تشاركه مع مجتمع الأوتاكو؟'}" style="min-height:96px;font-size:13.5px" oninput="cnt(this,500,'pub_cnt');S.draftText=this.value" value="${esc(S.draftText||"")}"></textarea>
      <div class="rowb tiny" style="margin-top:5px"><span class="fnt" id="pub_cnt">0 / 500</span>
        <span class="row" style="gap:6px">
          <button class="chip btn-xs" onclick="insertEmoji()">${IF("heart","i s")} رموز</button>
          <button class="chip btn-xs" onclick="aiText()">${I("wand","i s")} اكتب بالذكاء الاصطناعي</button>
        </span></div>

      <div class="div"></div>
      <div class="lbl">الوسائط</div>
      <div class="grid4">
        ${[["image","صورة","var(--grad-cyan)"],["video","فيديو","var(--grad-purple)"],["music","صوت","var(--grad-emerald)"],["file","ملف","var(--grad-gold)"]].map(([k,l,g])=>`
          <button class="card2 center" style="padding:11px 4px;cursor:pointer" onclick="attachMedia('${k}',this)">
            <span style="width:32px;height:32px;border-radius:11px;background:${g};display:flex;align-items:center;justify-content:center;color:#fff;margin:0 auto 5px">${I(k,"i s")}</span>
            <span class="tiny b">${l}</span></button>`).join("")}
      </div>
      <div id="attbox" class="col" style="margin-top:9px"></div>

      ${t==="poll"?`<div class="div"></div><div class="lbl">خيارات الاستطلاع</div>
        <div class="col" id="pollopts">${[1,2].map(i=>`<div class="row" style="gap:7px"><span class="badge b-gray mono">${i}</span><input class="inp g1" placeholder="الخيار ${i}"></div>`).join("")}</div>
        <div class="row" style="gap:7px;margin-top:8px">
          <button class="btn btn-sec btn-xs" onclick="addPollOpt()">${I("plus","i s")} إضافة خيار</button>
          <button class="btn btn-sec btn-xs ${S.draftPollHrs&&S.draftPollHrs!==24?'on':''}" onclick="cyclePollHrs()">${I("clock","i s")} مدة ${S.draftPollHrs||24} ساعة</button>
          <button class="btn btn-sec btn-xs ${S.draftPollOnce?'on':''}" onclick="togglePollOnce()">${I("lock","i s")} صوت واحد ${S.draftPollOnce?"(مفعّل)":""}</button>
        </div>`:""}

      ${t==="event"?`<div class="div"></div><div class="lbl">تفاصيل الفعالية</div>
        <div class="row" style="gap:7px"><input class="inp g1" type="date" id="evD"><input class="inp" type="time" id="evT" value="21:00" style="width:110px"></div>
        <div style="height:8px"></div><input class="inp" id="evLoc" placeholder="المكان أو الرابط (دردشة صوتية/غرفة عالم)"...>
        <div class="chiprow" style="margin-top:8px">${["مشاهدة جماعية","مسابقة رسم","لقاء نقابات"].map(x=>`<button class="chip" onclick="const e=$('#evLoc');if(e){e.value='${x}';snd('tap')}">${x}</button>`).join("")}</div>`:""}
      ${t==="news"?`<div class="div"></div><div class="lbl">تفاصيل الخبر الرسمي</div>
        <input class="inp" id="nwSrc" placeholder="المصدر (استوديو، موقع رسمي...)">
        <div style="height:8px"></div>
        <div class="chiprow">${["إصدار","استوديو","مهرجان","تعاون","ترتيب"].map((x,i)=>`<button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(c=>c.classList.remove('on'));this.classList.add('on');window.__nwCat='${x}'">${x}</button>`).join("")}</div>
        <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:8px"><span class="xs b">${I("shield","i s")} خبر موثّق بختم المنصة</span><span class="sw ${S.draftVerified?'on':''}" onclick="S.draftVerified=!S.draftVerified;this.classList.toggle('on');snd('tap')"></span></div>`:""}
      ${t==="reel"?`<div class="div"></div><div class="lbl">موسيقى الريلز</div>
        <div class="chiprow">${[...new Set(S.reels.map(r=>r.music))].slice(0,6).map(m=>`<button class="chip ${S.draftReelMusic===m?'on':''}" onclick="S.draftReelMusic='${esc(m)}';save();render();restoreCreateTxt();snd('tap')">${I("music","i s")} ${esc(m).slice(0,18)}</button>`).join("")}</div>
        <div class="lbl">غلاف الريلز</div>
        <div class="chiprow">${[["swords","#7F1D1D","#EA580C"],["sakura","#831843","#F472B6"],["zap","#3B0764","#A855F7"],["wave","#0C4A6E","#0EA5E9"]].map(([e,c1,c2])=>`<button style="width:44px;height:44px;border-radius:13px;background:linear-gradient(135deg,${c1},${c2});border:2px solid ${S.draftReelEmo===e?'#fff':'transparent'};color:#fff;display:flex;align-items:center;justify-content:center" onclick="S.draftReelEmo='${e}';save();render();restoreCreateTxt();snd('tap')">${I(e,"i s")}</button>`).join("")}</div>`:""}
      ${t==="announcement"?`<div class="div"></div><div class="lbl">خيارات الإعلان الرسمي</div>
        <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px"><span class="xs b">${I("shield","i s")} ختم رسمي موثّق</span><span class="sw ${S.draftOfficial!==false?'on':''}" onclick="S.draftOfficial=!(S.draftOfficial!==false);this.classList.toggle('on');snd('tap')"></span></div>
        <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:7px"><span class="xs b">${I("pin","i s")} تثبيت أعلى الرئيسية</span><span class="sw ${S.draftPin?'on':''}" onclick="S.draftPin=!S.draftPin;this.classList.toggle('on');snd('tap')"></span></div>`:""}
      ${t==="universe"?`<div class="div"></div><div class="lbl">بيانات الأنمي يونيفرس</div>
        <label class="lbl">اسم العالم/الأنمي</label><input class="inp" id="uniName" placeholder="مثال: أساطير الشرق الأسود">
        <label class="lbl" style="margin-top:8px">الاستوديو</label><input class="inp" id="uniStudio" placeholder="MAPPA / Wit / عمل أصلي...">
        <label class="lbl" style="margin-top:8px">التصنيفات</label>
        <div class="chiprow wrap">${CATS8.map(c=>`<button class="chip" onclick="this.classList.toggle('on');snd('tap')">${c}</button>`).join("")}</div>`:""}
      ${t==="post"?`<div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:10px"><span class="xs b">${I("eyeoff","i s")} وسم سبويلر (يُموّى لمن فعّل الحماية)</span><span class="sw ${S.draftSpoiler?'on':''}" onclick="toggleDraftSpoiler()"></span></div>`:""}

      ${["group","channel","guild"].includes(t)?`<div class="div"></div>
        <label class="lbl">اسم ${t==='guild'?'النقابة':t==='space'?'المجتمع':t==='channel'?'القناة':'المجموعة'}</label><input class="inp" id="pub_name" placeholder="مثال: نقابة الساموراي السوداء">
        <div style="height:9px"></div>
        <label class="lbl">الوصف</label><textarea class="inp" rows="2" placeholder="اشرح الهدف والقوانين..."></textarea>
        <div style="height:9px"></div>
        <label class="lbl">الأيقونة</label>
        <div class="chiprow">${["swords","flame","sakura","crown","clapper","book","gamepad","palette","moon","rocket"].map(e=>`<button class="chip" onclick="$$('#emojiPick .chip').forEach(c=>c.classList.remove('on'));this.classList.add('on');window.__pickEm='${e}'" id="emojiPick">${I(e,"i s")}</button>`).join("")}</div>`:""}

      <div class="div"></div>
      <div class="lbl">من يمكنه الرؤية؟</div>
      <div class="chiprow">
        ${[["public","globe","الجميع"],["friends","users","الأصدقاء"],["followers","usercheck","المتابعون"],["custom","lock","مخصص"]].map(([k,ic,l],i)=>`
          <button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(c=>c.classList.remove('on'));this.classList.add('on');window.__priv='${k}';${k==='custom'?"openSheet('privacySheet')":""}">${I(ic,"i s")} ${l}</button>`).join("")}
      </div>

      <div class="div"></div>
      <div class="row wrap" style="gap:7px">
        <button class="chip" onclick="addTag()">${I("hash","i s")} وسم</button>
        <button class="chip" onclick="closeOvl();openSheet('mentionSheet')">${I("at","i s")} ذكر شخص</button>
        <button class="chip ${S.draftLoc?'on':''}" onclick="toggleDraftLoc()">${I("map","i s")} موقع</button>
        <button class="chip ${S.draftFeeling?'on':''}" onclick="openSheet('feelingSheet')">${I("flame","i s")} شعور${S.draftFeeling?": "+esc(S.draftFeeling):""}</button>
        <button class="chip" onclick="openSheet('schedulePost')">${I("clock","i s")} جدولة</button>
        <button class="chip ${S.draftLockComments?'on':''}" onclick="toggleDraftLock()">${I("lock","i s")} قفل التعليقات</button>
      </div>
      <div id="tagbox" class="row wrap" style="gap:5px;margin-top:8px">${(S.draftTags||[]).map(tagChip).join("")}</div>
      <div class="row" style="gap:6px;margin-top:7px"><input class="inp g1" id="taginp" placeholder="أضف وسماً واضغط إدخال (# اختياري)..." onkeydown="if(event.key==='Enter'){event.preventDefault();addTag()}"><button class="btn btn-sec btn-xs" onclick="addTag()">${I("plus","i s")} وسم</button></div>
    </div>

    <div style="height:12px"></div>
    <div class="grid2" style="margin-bottom:9px"><button class="btn btn-sec" onclick="previewPost('${t}')">${I("eye","i s")} معاينة قبل النشر</button><button class="btn btn-sec" onclick="openSheet('draftSheet')">${I("file","i s")} مسوداتي (${(S.postDrafts||[]).length})</button></div>
    <button class="btn btn-primary btn-lg" onclick="publishNow('${t}')">${I("send","i s")} نشر الآن</button>
    <div class="grid2" style="margin-top:9px">
      <button class="btn btn-sec" onclick="savePostDraft()">${I("save","i s")} حفظ مسودة</button>
      <button class="btn btn-ghost" onclick="go('home')">${I("x","i s")} إلغاء</button>
    </div>
    <div class="tiny fnt center" style="margin-top:11px">بالنشر فأنت توافق على <b style="color:var(--accent)" onclick="go('terms')">شروط المجتمع</b></div>
  </div>`;
};
function cnt(el,max,id){const e=document.getElementById(id);if(e)e.textContent=el.value.length+" / "+max;if(el.value.length>max){el.value=el.value.slice(0,max);toast("تجاوزت الحد الأقصى","err")}}
function fileDownscale(file,maxW,q,cb){try{const rd=new FileReader();rd.onload=()=>{const img=new Image();img.onload=()=>{const sc=Math.min(1,maxW/Math.max(img.width,img.height));const cv=document.createElement("canvas");cv.width=Math.max(1,Math.round(img.width*sc));cv.height=Math.max(1,Math.round(img.height*sc));cv.getContext("2d").drawImage(img,0,0,cv.width,cv.height);cb(cv.toDataURL("image/jpeg",q||0.75))};img.onerror=()=>cb(null);img.src=rd.result};rd.onerror=()=>cb(null);rd.readAsDataURL(file)}catch(e){cb(null)}}
function pickFile(accept,capture,cb){const i=document.createElement("input");i.type="file";i.accept=accept||"";if(capture)i.setAttribute("capture",capture);i.style.display="none";document.body.appendChild(i);i.onchange=()=>{const f=i.files&&i.files[0];setTimeout(()=>i.remove(),100);if(f)cb(f)};i.click()}
function fileToDataURL(f,max,cb){if(max&&f.size>max){toast("الملف أكبر من الحد المسموح للحفظ المحلي","err");cb(null);return}const rd=new FileReader();rd.onload=()=>cb(rd.result);rd.onerror=()=>cb(null);rd.readAsDataURL(f)}

/* ══════════ v5: إرفاق الوسائط في محرر النشر ══════════
   الحالة السابقة: محرر النشر لم يحتوِ أي زر إرفاق ولا حقل ملف إطلاقاً،
   رغم أن publishNow() تقرأ window.__att. أي: السباكة موجودة والواجهة مفقودة.
   الآن: شريط إرفاق كامل (صور متعددة / فيديو / ملف) مع معاينة وحذف. */
window.__att = window.__att || [];

function attBar(){
  const a = window.__att || [];
  return `<div class="card" style="padding:11px;margin-top:10px">
    <div class="rowb" style="margin-bottom:9px">
      <span class="lbl" style="margin:0">${I("plus","i s")} إرفاق وسائط</span>
      ${a.length?`<button class="tiny b mut" onclick="attClearAll()">${I("trash","i s")} إزالة الكل (${a.length})</button>`:""}
    </div>
    <div class="grid4" style="gap:8px">
      ${[["image","صورة","var(--grad-cyan)","attPickImages()"],
         ["clapper","فيديو","var(--grad-purple)","attPickVideo()"],
         ["camera","كاميرا","var(--grad-fire)","attPickCamera()"],
         ["file","ملف","var(--grad-gold)","attPickFile()"]]
        .map(([ic,l,g,fn])=>`<button class="col center" style="gap:6px" onclick="${fn}">
          <span class="ico-tile" style="width:46px;height:46px;border-radius:15px;background:${g};color:#fff">${I(ic,"l")}</span>
          <span class="tiny b" style="font-size:9.5px">${l}</span></button>`).join("")}
    </div>
    ${a.length?`<div class="lbl" style="margin-top:12px">المرفقات (${a.length})</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
        ${a.map(x=>attThumb(x)).join("")}</div>`:
      `<div class="tiny fnt center" style="margin-top:10px">لم تُرفق أي وسائط — المنشور سيُنشر كنص فقط</div>`}
  </div>`;
}
function attThumb(x){
  const body = x.k==="image" ? `<img src="${x.src}" alt="" style="width:100%;height:84px;object-fit:cover;display:block">`
    : x.k==="video" ? `<video src="${x.src}" muted playsinline style="width:100%;height:84px;object-fit:cover;display:block"></video>`
    : `<div class="col center" style="height:84px;gap:5px;background:var(--surface3)">${I("file","l")}<span class="tiny" style="font-size:8.5px;padding:0 5px;text-align:center;word-break:break-all">${esc((x.name||"ملف").slice(0,22))}</span></div>`;
  return `<div style="position:relative;border-radius:12px;overflow:hidden;border:1px solid var(--line2)">
    ${body}
    <span style="position:absolute;top:4px;inset-inline-start:4px;background:rgba(0,0,0,.72);border-radius:7px;padding:1px 6px;font-size:8px;font-weight:700;color:#fff">${x.k==="image"?"صورة":x.k==="video"?"فيديو":"ملف"}</span>
    <button onclick="attRemove('${x.id}')" aria-label="إزالة"
      style="position:absolute;top:4px;inset-inline-end:4px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.78);color:#fff;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer">${I("x","i s")}</button>
  </div>`;
}
function attRefresh(){
  const el=document.getElementById("attBarWrap");
  if(el){ el.innerHTML=attBar(); } else { render(); restoreCreateTxt&&restoreCreateTxt(); }
}
function attAdd(o){
  window.__att=window.__att||[];
  if(window.__att.length>=10){toast("الحد الأقصى ١٠ مرفقات","err");return}
  window.__att.push(Object.assign({id:"at"+uid()},o));
  attRefresh(); snd("success");
  toast("أُضيف المرفق ("+window.__att.length+")","ok");
}
function attRemove(id){
  window.__att=(window.__att||[]).filter(a=>a.id!==id);
  attRefresh(); toast("أُزيل المرفق","info");
}
function attClearAll(){ window.__att=[]; attRefresh(); toast("أُزيلت كل المرفقات","info"); }
function attPickImages(){
  const i=document.createElement("input"); i.type="file"; i.accept="image/*"; i.multiple=true;
  i.style.display="none"; document.body.appendChild(i);
  i.onchange=()=>{ const fs=[...(i.files||[])]; setTimeout(()=>i.remove(),120);
    if(!fs.length)return; let done=0;
    fs.slice(0,10).forEach(f=>fileDownscale(f,1600,0.82,src=>{
      if(src)attAdd({k:"image",src,name:f.name}); if(++done===fs.length)attRefresh(); })); };
  i.click();
}
function attPickCamera(){
  pickFile("image/*","environment",f=>fileDownscale(f,1600,0.82,src=>{ if(src)attAdd({k:"image",src,name:"صورة الكاميرا"}); else toast("تعذّر قراءة الصورة","err"); }));
}
function attPickVideo(){
  pickFile("video/*","",f=>fileToDataURL(f,8*1024*1024,src=>{ if(src)attAdd({k:"video",src,name:f.name}); else toast("الفيديو كبير جداً (الحد ٨ ميجا)","err"); }));
}
function attPickFile(){
  pickFile("","",f=>fileToDataURL(f,4*1024*1024,src=>{ if(src)attAdd({k:"file",src,name:f.name}); else toast("الملف كبير جداً (الحد ٤ ميجا)","err"); }));
}

PAGES.createPost=()=>{setNav(false);window.__priv=S.draftPriv||"public";
  const __ev=S.evCtx?(S.events||[]).find(e=>e.id===S.evCtx):null;
  if(__ev&&!S.draftText){S.draftText="أشارك في "+__ev.title+" "+(__ev.tag||"");save()}
  setHdr(backHdr("استوديو المنشور النصي","تنسيق غني · وسوم · معاينة حية",`<button class="btn btn-sec btn-sm" onclick="savePostDraft()">${I("save","i s")} مسودة</button>`));
  return `<div class="pad col"><div id="attBarWrap">${attBar()}</div>
    <div class="card" style="padding:12px;background:linear-gradient(135deg,rgba(34,211,238,.07),transparent)">
      <div class="row" style="gap:9px">${av(S.me,40,true)}<div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(S.me.name)}</span>${lvlBadge(S.me)}</div><div class="tiny fnt">ينشر كـ <b style="color:var(--accent)">${esc(S.me.role)}</b></div></div>
      <div class="row" style="gap:5px">${[["public","globe","عام"],["followers","users","متابعون"],["me","lock","أنا"]].map(([k,ic,l])=>`<button class="chip ${(window.__priv||"public")===k?"on":""}" onclick="window.__priv='${k}';S.draftPriv='${k}';save();render();restoreCreateTxt()">${I(ic,"i s")} ${l}</button>`).join("")}</div></div>
    ${__ev?`<div class="card" style="padding:11px;border:1px solid var(--gold);background:rgba(250,204,21,.07)"><div class="row" style="gap:9px"><span class="ico-tile" style="background:linear-gradient(135deg,${__ev.c1},${__ev.c2});color:#fff">${I(__ev.icon||"calendar","i l")}</span><div class="g1"><div class="b xs">مشاركة في فعالية: ${esc(__ev.title)}</div><div class="tiny fnt" style="color:var(--gold)">${esc(__ev.tag||"")} — سيُحوّط منشورك بالإطار المتموج</div></div><button class="btn btn-sec btn-xs" onclick="S.evCtx=null;S.draftText='';save();render()">${I("x","i s")}</button></div></div>`:""}
      <textarea class="inp" id="pub_txt" rows="5" placeholder="ماذا تريد أن تشاركه؟ جرّب **غامق** أو _مائل_ أو » اقتباس" style="min-height:110px;font-size:14px" oninput="cnt(this,500,'pub_cnt');S.draftText=this.value;livePrev()">${esc(S.draftText||"")}</textarea>
      <div class="rowb tiny" style="margin-top:5px"><span class="fnt" id="pub_cnt">0 / 500</span><span class="mono tiny">${I("wand","i s")} تنسيق غني مفعّل</span></div>
      <div class="chiprow" style="margin-top:9px">
        <button class="chip" onclick="fmtWrap('**','**')">${I("pen","i s")} غامق</button>
        <button class="chip" onclick="fmtWrap('_','_')">${I("pen","i s")} مائل</button>
        <button class="chip" onclick="fmtWrap('\\n» ','')">${I("quote","i s")} اقتباس</button>
        <button class="chip" onclick="fmtWrap('\`','\`')">${I("code","i s")} كود</button>
        <button class="chip" onclick="insertEmoji()">${I("sparkles","i s")} رموز</button>
        <button class="chip" onclick="aiText()">${I("wand","i s")} ذكاء اصطناعي</button></div>
      <div class="div"></div>
      <div class="lbl">الوسوم والمزاج والمكان</div>
      <div class="row" style="gap:7px"><input class="inp g1" id="taginp" placeholder="أضف وسماً واضغط إدخال" onkeydown="if(event.key==='Enter'){event.preventDefault();addTag()}"><button class="btn btn-sec btn-xs" onclick="addTag()">${I("hash","i s")} وسم</button></div>
      <div class="row wrap" id="tagbox" style="gap:5px;margin-top:7px">${(S.draftTags||[]).map(t=>tagChip(t)).join("")}</div>
      <div class="chiprow" style="margin-top:8px">${["متحمس","محلل","ساخر","حالم","غاضب"].map(f=>`<button class="chip ${S.draftFeeling===f?"on":""}" onclick="S.draftFeeling=S.draftFeeling==='f'?'' : '${f}';S.draftFeeling='${f}';save();render();restoreCreateTxt();snd('tap')">${f}</button>`).join("")}
        <button class="chip ${S.draftLoc?"on":""}" onclick="S.draftLoc=S.draftLoc?'':'استوديو التحرير · طوكيو';save();render();restoreCreateTxt()">${I("map","i s")} ${S.draftLoc||"مكان"}</button></div>
      <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:9px"><span class="xs b">${I("eyeoff","i s")} وسم سبويلر (يُموّى لمن فعّل الحماية)</span><span class="sw ${S.draftSpoiler?"on":""}" onclick="toggleDraftSpoiler()"></span></div>
      <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:7px"><span class="xs b">${I("lock","i s")} قفل التعليقات</span><span class="sw ${S.draftLockComments?"on":""}" onclick="S.draftLockComments=!S.draftLockComments;this.classList.toggle('on');snd('tap')"></span></div>
      <div class="div"></div>
      <div class="lbl">معاينة حية كما ستظهر في الخلاصة</div>
      <div id="lprev"></div>
      <div class="grid2" style="margin-top:12px"><button class="btn btn-sec" onclick="previewPost('post')">${I("eye","i s")} معاينة</button>
      <button class="btn btn-primary btn-lg" onclick="publishNow('post')">${I("send","i s")} نشر الآن</button></div>
    </div></div>`};
function livePrev(){clearTimeout(window.__lpt);window.__lpt=setTimeout(()=>{const el=document.getElementById("lprev");if(!el)return;const txt=($("#pub_txt")&&$("#pub_txt").value||"").trim();if(!txt){el.innerHTML="";return}
  el.innerHTML=postCard({id:"lp",authorId:"me",author:S.me,type:"text",text:txt,media:null,likes:0,comments:[],shares:0,views:1,createdAt:now(),privacy:window.__priv||"public",tags:(S.draftTags||[]).slice(),reactions:[],feeling:S.draftFeeling||"",spoiler:false,loc:S.draftLoc||""})},260)}
PAGES.createPhotos=()=>{setNav(false);window.__priv=S.draftPriv||"public";
  setHdr(backHdr("استوديو الصور","ألبوم حقيقي من جهازك"));
  return `<div class="pad col">
    <input type="file" id="phIn" accept="image/*" multiple style="display:none" onchange="phPick(this)">
    <button class="card2 center" style="padding:22px;border-style:dashed;cursor:pointer" onclick="document.getElementById('phIn').click()">
      <span style="color:var(--accent);line-height:0">${I("image","xl")}</span>
      <span class="b xs" style="display:block;margin-top:8px">اختر صوراً من معرض جهازك</span>
      <span class="tiny fnt" style="display:block;margin-top:3px">حتى ٦ صور · تُحفظ وتُعرض فعلياً</span></button>
    ${(S.cpImgs||[]).length?`<div class="secttl"><h3>${I("layers","i s")} صور الألبوم (${S.cpImgs.length})</h3><button class="more" onclick="S.cpImgs=[];save();render()">مسح الكل</button></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:7px">${S.cpImgs.map((x,i)=>`<div style="position:relative"><img src="${x.src}" style="width:100%;height:96px;object-fit:cover;border-radius:12px;border:2px solid ${i===0?"var(--accent)":"transparent"};display:block" alt="">
      <button class="iconbtn" style="position:absolute;top:4px;inset-inline-start:4px;width:24px;height:24px;background:rgba(0,0,0,.6);color:#fff;border:none" onclick="S.cpImgs.splice(${i},1);save();render()">${I("x","i s")}</button>
      ${i===0?`<span class="badge b-red" style="position:absolute;bottom:4px;inset-inline-start:4px">غلاف</span>`:""}</div>`).join("")}</div>
    <div class="lbl" style="margin-top:11px">مخطط العرض</div>
    <div class="chiprow">${[["grid","شبكة","grid"],["strip","شريط أفقي","list"],["single","صورة واحدة","max"]].map(([k,l,ic])=>`<button class="chip ${(S.cpLayout||"grid")===k?"on":""}" onclick="S.cpLayout='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>`:""}
    <div class="lbl" style="margin-top:11px">عنوان الألبوم</div>
    <textarea class="inp" id="pub_txt" rows="2" placeholder="caption للألبوم..." oninput="cnt(this,500,'pub_cnt');S.draftText=this.value">${esc(S.draftText||"")}</textarea>
    <div class="rowb tiny"><span class="fnt" id="pub_cnt">0 / 500</span><span></span></div>
    <div class="row" style="gap:7px;margin-top:8px"><input class="inp g1" id="taginp" placeholder="وسوم الألبوم" onkeydown="if(event.key==='Enter'){event.preventDefault();addTag()}"><button class="btn btn-sec btn-xs" onclick="addTag()">${I("hash","i s")}</button></div>
    <div class="row wrap" id="tagbox" style="gap:5px;margin-top:7px">${(S.draftTags||[]).map(t=>tagChip(t)).join("")}</div>
    <div class="grid2" style="margin-top:13px"><button class="btn btn-sec" onclick="document.getElementById('phIn').click()">${I("plus","i s")} إضافة صور</button>
    <button class="btn btn-primary" onclick="publishAlbum()">${I("send","i s")} نشر الألبوم</button></div></div>`};
function phPick(inp){const fs=[...(inp.files||[])];if(!fs.length)return;if((S.cpImgs||[]).length+fs.length>6){toast("الحد الأقصى ٦ صور ","err");inp.value="";return}
  let left=fs.length;fs.forEach(f=>fileDownscale(f,1280,0.8,src=>{left--;if(src){S.cpImgs=S.cpImgs||[];S.cpImgs.push({src});save();if(!left){render();snd("success");toast("أُضيفت الصور للألبوم ","ok")}}else if(!left)render()}));inp.value=""}
function publishAlbum(){const imgs=(S.cpImgs||[]).map(x=>x.src);if(!imgs.length){toast("أضف صورة واحدة على الأقل ","err");return}
  const txt=($("#pub_txt")&&$("#pub_txt").value||"").trim();
  const p = {id:"p"+uid(),authorId:"me",type:"photo",text:txt||"ألبوم صور جديد ",media:{kind:"photo",src:imgs[0],imgs:imgs,layout:S.cpLayout||"grid",c1:"#0C4A6E",c2:"#0EA5E9",emo:"image"},likes:0,liked:false,saved:false,comments:[],shares:0,views:rnd(3,30),createdAt:now(),privacy:window.__priv||"public",tags:collectTags(),reactions:[],pending:true};
  S.posts.unshift(p);
  syncPostToCloud(p);
  S.cpImgs=[];S.draftText="";S.draftTags=[];save();snd("success");celebrate("نُشر ألبومك بنجاح ");setTimeout(()=>go("home",{},false),650)}
PAGES.createPollPro=()=>{setNav(false);window.__priv=S.draftPriv||"public";
  setHdr(backHdr("استوديو الاستطلاع","خيارات ومدة ونتائج حية"));
  return `<div class="pad col">
    <div class="card" style="padding:13px"><div class="row" style="gap:9px;margin-bottom:9px">${av(S.me,36,true)}<div class="g1 b xs">سؤالك يصل لـ ${nfmt(S.me.followers||1200)} متابع</div></div>
    <textarea class="inp" id="pub_txt" rows="2" placeholder="اكتب سؤال الاستطلاع..." oninput="S.draftText=this.value">${esc(S.draftText||"")}</textarea>
    <div class="lbl" style="margin-top:10px">الخيارات (٢ إلى ٦)</div>
    <div class="col" id="pollopts" style="gap:7px">${[1,2].map(i=>`<div class="row" style="gap:7px"><span class="badge b-gray mono">${i}</span><input class="inp g1" placeholder="الخيار ${i}"></div>`).join("")}</div>
    <div class="row" style="gap:7px;margin-top:9px">
      <button class="btn btn-sec btn-xs" onclick="addPollOpt()">${I("plus","i s")} إضافة خيار</button>
      <button class="btn btn-sec btn-xs" onclick="const b=$('#pollopts');if(b&&b.children.length>2){b.lastElementChild.remove();snd('tap')}else toast('الحد الأدنى خياران ','err')">${I("trash","i s")} حذف الأخير</button></div>
    <div class="lbl" style="margin-top:11px">مدة التصويت</div>
    <div class="chiprow">${[[1,"ساعة"],[24,"٢٤ ساعة"],[72,"٣ أيام"],[168,"أسبوع"]].map(([h,l])=>`<button class="chip ${(S.draftPollHrs||24)===h?"on":""}" onclick="S.draftPollHrs=${h};save();render();restoreCreateTxt();snd('tap')">${I("clock","i s")} ${l}</button>`).join("")}</div>
    <div class="rowb" style="padding:9px 11px;background:var(--surface2);border-radius:12px;margin-top:10px"><span class="xs b">${I("lock","i s")} صوت واحد لكل عضو</span><span class="sw ${S.draftPollOnce?"on":""}" onclick="togglePollOnce()"></span></div>
    <div class="grid2" style="margin-top:13px"><button class="btn btn-sec" onclick="previewPost('poll')">${I("eye","i s")} معاينة</button>
    <button class="btn btn-primary" onclick="publishNow('poll')">${I("send","i s")} نشر الاستطلاع</button></div></div></div>`};
PAGES.createVideoPro=()=>{setNav(false);window.__priv=S.draftPriv||"public";
  setHdr(backHdr("استوديو الفيديو","فيديو حقيقي من جهازك داخل الخلاصة"));
  return `<div class="pad col">
    <input type="file" id="vidIn" accept="video/*" style="display:none" onchange="vidPick(this)">
    ${S.cpVid&&S.cpVid.src?`<div class="card" style="padding:9px;overflow:hidden"><video src="${S.cpVid.src}" controls playsinline style="width:100%;max-height:300px;border-radius:12px;background:#000;display:block"></video>
      <div class="rowb" style="margin-top:8px"><span class="tiny b">${I("film","i s")} ${esc((S.cpVid.name||"فيديو").slice(0,26))}</span><button class="btn btn-sec btn-xs" onclick="S.cpVid=null;save();render()">${I("trash","i s")} إزالة</button></div></div>`
    :`<button class="card2 center" style="padding:26px;border-style:dashed;cursor:pointer" onclick="document.getElementById('vidIn').click()">
      <span style="color:var(--purple,#A855F7);line-height:0">${I("film","xl")}</span>
      <span class="b xs" style="display:block;margin-top:8px">اختر فيديو من جهازك</span>
      <span class="tiny fnt" style="display:block;margin-top:3px">حتى ٤٫٥MB · يُشغَّل داخل المنشور</span></button>`}
    <div class="lbl" style="margin-top:11px">عنوان الفيديو</div>
    <textarea class="inp" id="pub_txt" rows="2" placeholder="عنوان جذاب للفيديو..." oninput="cnt(this,500,'pub_cnt');S.draftText=this.value">${esc(S.draftText||"")}</textarea>
    <div class="rowb tiny"><span class="fnt" id="pub_cnt">0 / 500</span><span></span></div>
    <div class="row" style="gap:7px;margin-top:8px"><input class="inp g1" id="taginp" placeholder="وسوم" onkeydown="if(event.key==='Enter'){event.preventDefault();addTag()}"><button class="btn btn-sec btn-xs" onclick="addTag()">${I("hash","i s")}</button></div>
    <div class="row wrap" id="tagbox" style="gap:5px;margin-top:7px">${(S.draftTags||[]).map(t=>tagChip(t)).join("")}</div>
    <div class="grid2" style="margin-top:13px"><button class="btn btn-sec" onclick="document.getElementById('vidIn').click()">${I("upload","i s")} ${S.cpVid?"تغيير الفيديو":"اختيار فيديو"}</button>
    <button class="btn btn-primary" onclick="publishVideoPost()">${I("send","i s")} نشر الفيديو</button></div></div>`};
function vidPick(inp){const f=inp.files&&inp.files[0];if(!f)return;fileToDataURL(f,4.5*1024*1024,src=>{if(src){S.cpVid={src,name:f.name};save();render();snd("success");toast("جهز الفيديو للنشر ","ok")}else toast("الفيديو أكبر من ٤٫٥MB ","err")});inp.value=""}
function publishVideoPost(){if(!S.cpVid||!S.cpVid.src){toast("اختر فيديو أولاً ","err");return}
  const txt=($("#pub_txt")&&$("#pub_txt").value||"").trim()||"فيديو جديد ";
  const p = {id:"p"+uid(),authorId:"me",type:"video",text:txt,media:{kind:"video",src:S.cpVid.src,c1:"#3B0764",c2:"#7C3AED",emo:"film"},likes:0,liked:false,saved:false,comments:[],shares:0,views:rnd(5,60),createdAt:now(),privacy:window.__priv||"public",tags:collectTags(),reactions:[],pending:true};
  S.posts.unshift(p);
  syncPostToCloud(p);
  S.cpVid=null;S.draftText="";S.draftTags=[];save();snd("success");celebrate("نُشر فيديوك في الخلاصة ");setTimeout(()=>go("home",{},false),650)}
PAGES.createReelStudio=()=>{setNav(false);setHdr(backHdr("استوديو الريلز","فيديو أو غلاف + موسيقى وسرعة ومؤثرات"));
  const col=S.rsCol||["#7F1D1D","#EA580C"];
  return `<div class="pad col">
    <input type="file" id="rsVidIn" accept="video/*" style="display:none" onchange="rsVid(this)">
    <input type="file" id="rsCovIn" accept="image/*" style="display:none" onchange="rsCov(this)">
    <div style="position:relative;height:330px;border-radius:22px;overflow:hidden;background:#000;border:1px solid var(--line2)">
      ${S.rsVid?`<video src="${S.rsVid.src}" autoplay loop muted playsinline style="width:100%;height:100%;object-fit:cover;${fxStyle(S.rsFx)}" oncanplay="this.playbackRate=${S.rsSpeed||1}"></video>`:S.rsCover?`<img src="${S.rsCover}" style="width:100%;height:100%;object-fit:cover;${fxStyle(S.rsFx)}" alt="">`:`<div class="art-bg" style="--c1:${col[0]};--c2:${col[1]};position:absolute;inset:0;display:flex;align-items:center;justify-content:center;${fxStyle(S.rsFx)}">${I("clapper","xxl")}</div>`}
      <div style="position:absolute;inset:auto 0 0 0;padding:12px;background:linear-gradient(to top,rgba(0,0,0,.85),transparent)">
        <div class="xs" style="color:#fff">${esc(($("#rsCap")&&$("#rsCap").value)||"معاينة الوصف...")}</div>
        <div class="row" style="gap:6px;margin-top:6px"><span style="color:#fff;line-height:0">${I("music","i s")}</span><span class="tiny" style="color:rgba(255,255,255,.85)">${esc(S.rsMusic||"صوت أصلي — أنا")}</span>${(S.rsSpeed||1)!==1?`<span class="badge b-gray mono">${S.rsSpeed}x</span>`:""}</div></div>
      <span class="badge b-red" style="position:absolute;top:10px;right:10px">REC · استوديو</span></div>
    <div class="grid2" style="margin-top:10px">
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('rsVidIn').click()">${I("video","i s")} فيديو من الجهاز</button>
      <button class="btn btn-sec btn-sm" onclick="document.getElementById('rsCovIn').click()">${I("image","i s")} غلاف من المعرض</button></div>
    <div class="lbl" style="margin-top:11px">الموسيقى</div>
    <div class="chiprow">${["صوت أصلي — أنا",...new Set(S.reels.map(r=>r.music))].slice(0,7).map(m=>`<button class="chip ${(S.rsMusic||"صوت أصلي — أنا")===m?"on":""}" onclick="S.rsMusic='${esc(m)}';save();render();snd('tap')">${I("music","i s")} ${esc(m).slice(0,16)}</button>`).join("")}</div>
    <div class="lbl" style="margin-top:10px">السرعة</div>
    <div class="chiprow">${[0.5,1,1.5,2].map(sp=>`<button class="chip ${(S.rsSpeed||1)===sp?"on":""}" onclick="S.rsSpeed=${sp};save();render();snd('tap')">${I("zap","i s")} ${sp}x</button>`).join("")}</div>
    <div class="lbl" style="margin-top:10px">المؤثرات</div>
    <div class="chiprow">${["بدون","سينمائي","نيون","أبيض/أسود","حاد"].map(f=>`<button class="chip ${(S.rsFx||"بدون")===f?"on":""}" onclick="S.rsFx='${f}';save();render();snd('tap')">${I("wand","i s")} ${f}</button>`).join("")}</div>
    ${!S.rsCover&&!S.rsVid?`<div class="lbl" style="margin-top:10px">ألوان الخلفية</div>
    <div class="chiprow">${[["#7F1D1D","#EA580C"],["#831843","#F472B6"],["#3B0764","#A855F7"],["#0C4A6E","#0EA5E9"],["#14532D","#4ADE80"]].map(([a,b2])=>`<button style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,${a},${b2});border:2px solid ${col[0]===a?"#fff":"transparent"}" onclick="S.rsCol=['${a}','${b2}'];save();render();snd('tap')"></button>`).join("")}</div>`:""}
    <div class="lbl" style="margin-top:10px">وصف الريل</div>
    <textarea class="inp" id="rsCap" rows="2" placeholder="اكتب وصف الريل + #وسوم" oninput="snd('tap')">${esc(S.rsCap||"")}</textarea>
    <button class="btn btn-primary btn-lg" style="margin-top:12px" onclick="publishReelStudio()">${I("send","i s")} نشر الريل</button></div>`};
function rsVid(inp){const f=inp.files&&inp.files[0];if(!f)return;fileToDataURL(f,4.5*1024*1024,src=>{if(src){S.rsVid={src};S.rsCover=null;save();render();snd("success");toast("جهز فيديو الريل ","ok")}else toast("الفيديو أكبر من ٤٫٥MB ","err")});inp.value=""}
function rsCov(inp){const f=inp.files&&inp.files[0];if(!f)return;fileDownscale(f,900,0.8,src=>{if(src){S.rsCover=src;S.rsVid=null;save();render();snd("tap")}});inp.value=""}
function fxStyle(f){return f==="سينمائي"?"filter:saturate(1.35) contrast(1.12);":f==="نيون"?"filter:saturate(1.9) hue-rotate(12deg) contrast(1.05);":f==="أبيض/أسود"?"filter:grayscale(1);":f==="حاد"?"filter:contrast(1.3);":""}
function publishReelStudio(){S.rsCap=($("#rsCap")&&$("#rsCap").value||"").trim();const cap=S.rsCap||"ريل جديد ";
  const rid="r"+uid();
  const myUid=window.auth&&window.auth.currentUser?window.auth.currentUser.uid:"me";
  const reelObj={id:rid,authorId:myUid,userId:myUid,userName:S.me.name||"مستخدم",userAvatar:S.me.avatar||"",text:cap,music:S.rsMusic||"صوت أصلي — أنا",speed:S.rsSpeed||1,fx:S.rsFx||"بدون",video:S.rsVid?S.rsVid.src:"",cover:S.rsCover||"",c1:(S.rsCol||["#7F1D1D","#EA580C"])[0],c2:(S.rsCol||["#7F1D1D","#EA580C"])[1],emo:"clapper",likes:0,comments:[],views:1,mine:true,createdAt:now()};
  S.reels.unshift(reelObj);
  if(window.auth&&window.auth.currentUser&&window.db){
    window.setDoc(window.doc(window.db,"reels",rid),reelObj).catch(e=>console.error(e));
  }
  S.rsVid=null;S.rsCover=null;S.rsCap="";save();snd("success");celebrate("نُشر الريل في تبويب الريلز ");go("reels")}
function createRoute(k){if(k==="post")return"go('createPost')";if(k==="poll")return"go('createPollPro')";if(k==="reel")return"go('createReelStudio')";if(k==="video")return"go('createVideoPro')";if(k==="story")return"go('createStory')";return"go('create',{type:'"+k+"'},false)"}
function fmtWrap(a,b){const i=$("#pub_txt");if(!i)return;const st=i.selectionStart||0,en=i.selectionEnd||0;const sel=i.value.slice(st,en)||"نص";i.value=i.value.slice(0,st)+a+sel+b+i.value.slice(en);i.focus();if(window.cnt)cnt(i,500,"pub_cnt");S.draftText=i.value;snd("tap");toast("طُبّق التنسيق — يظهر في المعاينة والخلاصة ","ok")}
function attachMedia(k,el){
  if(k==="image"||k==="video"){
    pickFile(k==="image"?"image/*":"video/*","",f=>{
      if(k==="image"){fileDownscale(f,1280,0.75,src=>{if(src)addAttChip("image",src,f.name);else toast("تعذّر قراءة الصورة","err")})}
      else{fileToDataURL(f,4.5*1024*1024,src=>{if(src)addAttChip("video",src,f.name)})}
    });return}
  if(k==="music"){pickFile("audio/*","",f=>fileToDataURL(f,2.5*1024*1024,src=>{if(src)addAttChip("music",src,f.name)}));return}
  if(k==="file"){pickFile("","",f=>fileToDataURL(f,2.5*1024*1024,src=>{if(src)addAttChip("file",src,f.name)}));return}
  addAttChip(k,null,"");
}
function addAttChip(k,src,name){
  const b=$("#attbox");if(!b)return;const id=uid();
  const cols={image:["#0C4A6E","#0EA5E9","image"],video:["#3B0764","#7C3AED","video"],music:["#064E3B","#10B981","music"],file:["#7C2D12","#F59E0B","file"]}[k]||["#111","#333","file"];
  const thumb=src&&k==="image"?`<img src="${src}" style="width:38px;height:38px;border-radius:11px;object-fit:cover">`:`<span class="ico-tile" style="width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,${cols[0]},${cols[1]})">${I(cols[2],"i s")}</span>`;
  b.insertAdjacentHTML("beforeend",`<div class="card2 row" style="gap:9px;padding:9px" id="att_${id}">
    ${thumb}
    <div class="g1"><div class="tiny b">${{image:"صورة",video:"فيديو",music:"ملف صوتي",file:"ملف"}[k]||"مرفق"}${name?" · "+esc(name.slice(0,22)):""}</div><div class="tiny fnt mono">${src?"من جهازك — يُعرض حقيقياً":"media_"+id.slice(0,6)+"."+k}</div></div>
    <button class="iconbtn" style="width:28px;height:28px" onclick="document.getElementById('att_${id}').remove();window.__att=(window.__att||[]).filter(a=>a.id!=='${id}');toast('أُزيل المرفق','info')">${I("x","i s")}</button>
  </div>`);
  window.__att=(window.__att||[]);window.__att.push({k,id,src:src||"",name:name||""});
  snd("tap");toast(src?"أُرفق من جهازك — سيُعرض فعلياً ":"أُرفق وسيط ","ok");
}
function aiText(){const t=$("#pub_txt");if(!t)return;const L=["راجعنا الحلقة الأخيرة: الإخراج تجاوز التوقعات والإيقاع متماسك حتى النهاية، والمشهد الختامي تحديداً سيعلق في الذاكرة طويلاً.","ترتيب الموسم حتى الآن: العمل يتصدر ترشيحات المجتمع بفضل رسم القتال والموسيقى التصويرية وأداء المؤدين الصوتيين.","نظرية اليوم: تفاصيل الشارة الافتتاحية تلمّح لتحالف غير متوقع في القوس القادم، والدليل لقطة الثواني الثلاث عند ١:١٢.","خلاصة تصويت المجتمع: ٨٧٪ يرون أن الاقتباس فاق المانجا في هذا الفصل، و١٣٪ ينتظرون حكم الحلقة المقبلة."];t.value+=(t.value?"\n\n":"")+pick(L)+"\n— بقلم مساعد أنمي بلاك الذكي";S.draftText=t.value;cnt(t,500,"pub_cnt");toast("ولّد المساعد نصاً مقترحاً — عدّله كما تشاء ","ok");snd("success")}
function insertEmoji(){openSheet('emojiInsert')}
function insToken(ic){const i=$("#pub_txt");if(!i){closeOvl();return}i.value+=(i.value?" ":"")+`[[${ic}]]`;closeOvl();cnt(i,500,"pub_cnt");i.focus();toast("أُدرج الرمز داخل النص ","ok")}
function addPollOpt(){const b=$("#pollopts");const n=b.children.length+1;if(n>6){toast("الحد الأقصى ٦ خيارات","err");return}b.insertAdjacentHTML("beforeend",`<div class="row" style="gap:7px"><span class="badge b-gray mono">${n}</span><input class="inp g1" placeholder="الخيار ${n}"></div>`);snd("tap")}
function cyclePollHrs(){const _t=$("#pub_txt");S.draftText=_t?_t.value:(S.draftText||"");S.draftPollHrs=(S.draftPollHrs||24)===24?48:(S.draftPollHrs===48?72:24);save();render();const t2=$("#pub_txt");if(t2)t2.value=S.draftText||"";snd("tap");toast("مدة التصويت: "+S.draftPollHrs+" ساعة ","info")}
function togglePollOnce(){const _t=$("#pub_txt");S.draftText=_t?_t.value:(S.draftText||"");S.draftPollOnce=!S.draftPollOnce;save();render();const t2=$("#pub_txt");if(t2)t2.value=S.draftText||"";snd("tap");toast(S.draftPollOnce?"صوت واحد لكل عضو ":"يمكن تغيير الصوت ","info")}
function savePostDraft(){const t=$("#pub_txt");const txt=t?t.value.trim():"";const tags=collectTags();if(!txt&&!tags.length&&!(window.__att||[]).length){toast("لا محتوى لحفظه ","err");return}(S.postDrafts=S.postDrafts||[]).unshift({id:uid(),txt,tags,priv:window.__priv||"public",at:now()});save();snd("success");toast("حُفظت المسودة — افتحها من أيقونة المسودات بالأعلى ","ok")}
function collectTags(){const tb=$("#tagbox");const fromDom=tb?[...tb.querySelectorAll("button")].map(b=>(b.textContent||"").replace(/^#/,"").replace(/\s*$/,"").trim()):[];return [...new Set([...fromDom,...(S.draftTags||[])])].filter(Boolean)}
function tagx(t){return String(t).replace(/^#+/,"")}
function esc2tag(t){return esc(tagx(t))}
function tagChip(t){return `<button class="badge b-cyan" onclick="this.remove();S.draftTags=(S.draftTags||[]).filter(x=>x!=='${String(t).replace(/'/g,"")}');save()">#${esc(tagx(t))} ${I("x","i s")}</button>`}
function restoreCreateTxt(){const t2=$("#pub_txt");if(t2)t2.value=S.draftText||""}
function toggleDraftSpoiler(){const _t=$("#pub_txt");S.draftText=_t?_t.value:(S.draftText||"");S.draftSpoiler=!S.draftSpoiler;save();render();restoreCreateTxt();toast(S.draftSpoiler?"سيُنشر متموّياً كسبويلر ":"أُلغي وسم السبويلر ",S.draftSpoiler?"ok":"info")}
function previewPost(t){const txt=($("#pub_txt")&&$("#pub_txt").value||"").trim()||"نص المعاينة...";const cols={post:["#1E1B4B","#6366F1","msgsq"],poll:["#0F172A","#1E3A8A","barchart"],reel:["#7F1D1D","#EA580C","clapper"],news:["#1E1B4B","#4338CA","inbox"],event:["#064E3B","#10B981","party"],announcement:["#3B0764","#8B5CF6","shield"]}[t]||["#1E1B4B","#6366F1","msgsq"];
  const tmp={id:"preview",authorId:"me",author:S.me,type:t==="announcement"?"news":t,text:txt,media:{c1:cols[0],c2:cols[1],emo:S.draftReelEmo||cols[2]},likes:0,liked:false,saved:false,comments:[],shares:0,views:1,createdAt:now(),privacy:window.__priv||"public",tags:collectTags(),reactions:[],loc:S.draftLoc||"",lockC:!!S.draftLockComments,feeling:S.draftFeeling||"",spoiler:!!S.draftSpoiler,newsMeta:t==="news"?{src:(($("#nwSrc")&&$("#nwSrc").value)||"").trim()||"أنمي بلاك",cat:window.__nwCat||"إصدار",verified:!!S.draftVerified}:null};
  if(t==="poll"){const opts=$$("#pollopts input").map(i=>i.value.trim()).filter(Boolean);tmp.poll={options:(opts.length?opts:["نعم","لا"]).map((x,i)=>({id:"o"+i,t:x,v:0})),voted:null,end:now()+(S.draftPollHrs||24)*36e5,once:!!S.draftPollOnce}}
  $("#ovl").innerHTML=modal(I("eye","i s")+" معاينة المنشور",`<div class="col">${postCard(tmp)}</div><div class="grid2" style="margin-top:12px"><button class="btn btn-primary" onclick="closeOvl();publishNow('${t}')">${I("send","i s")} نشر الآن</button><button class="btn btn-ghost" onclick="closeOvl()">رجوع</button></div>`)}
function addTag(){const i=$("#taginp");const t=i?(i.value||"").trim().replace(/^#/,""):"";if(!t){toast("اكتب الوسم في الحقل ثم إدخال ","err");return}const tb=$("#tagbox");if(tb&&!tb.innerHTML.includes("#"+t))tb.insertAdjacentHTML("beforeend",tagChip(t));(S.draftTags=S.draftTags||[]);if(!S.draftTags.includes(t))S.draftTags.push(t);save();if(i)i.value="";snd("tap")}
function publishNow(t){
  if(!$("#pub_txt")){toast("افتح محرر النشر أولاً ","err");return}
  const txt=($("#pub_txt").value||"").trim();
  if(S.editPostId){const ep=(S.posts||[]).find(x=>x.id===S.editPostId);S.editPostId=null;if(ep){ep.text=txt;ep.edited=true;const _tg=collectTags();if(_tg.length)ep.tags=_tg;ep.privacy=window.__priv||ep.privacy;S.draftText="";S.draftTags=[];window.__att=[];save();toast("تم تحديث المنشور ","ok");celebrate("عُدّل منشورك بنجاح ");setTimeout(()=>go("home",{},false),600);return}}
  if(!netOk()&&txt){(S.offQ=S.offQ||[]).push({t:"post",txt,type:t});netbar(false);closeOvl();toast(T("سيُنشر تلقائياً عند عودة الاتصال"),"info");return}
  if(t==="story"){toast("القصص تُنشر من محرر القصص ","info");setTimeout(()=>go("createStory"),400);return}
  const needName=["group","channel","guild"].includes(t);
  const nm=needName?($("#pub_name").value||"").trim():"";
  if(needName&&!nm){toast("اكتب الاسم أولاً","err");return}
  if(!needName&&!txt&&!(window.__att||[]).length){toast("اكتب محتوى أو أرفق وسيط","err");return}
  if(t==="universe"){const un=(($("#uniName")&&$("#uniName").value||"").trim());if(!un){toast("اكتب اسم العالم أولاً","err");return}const gs=$$("#page .chip.on").map(c=>(c.textContent||"").trim()).filter(x=>CATS8.includes(x));const a={id:"a"+uid(),n:un,en:un,y:2026,ep:12,rating:8.6,genres:gs.length?gs:["أكشن"],studio:(($("#uniStudio")&&$("#uniStudio").value)||"أصلي").trim(),status:"قيد العرض",c1:"#3B0764",c2:"#A855F7",emo:"zap",desc:txt||"عالم جديد أضافه المجتمع"};S.wiki.anime.unshift(a);S.draftText="";window.__att=[];save();celebrate("أضفت يونيفرس: "+un+" ");setTimeout(()=>go("animeDetail",{id:a.id}),700);return}
  const cols={post:["#1E1B4B","#6366F1","msgsq"],poll:["#0F172A","#1E3A8A","barchart"],story:["#831843","#DB2777","sakura"],reel:["#7F1D1D","#EA580C","clapper"],news:["#1E1B4B","#4338CA","inbox"],event:["#064E3B","#10B981","party"]}[t]||["#3B0764","#831843","sparkles"];
  if(needName){
    const c={id:"g"+uid(),name:nm,type:t==="group"?"group":t==="channel"?"channel":t==="guild"?"guild":"group",members:1,online:1,icon:window.__pickEm||"",c1:cols[0],c2:cols[1],desc:txt||"مجتمع جديد في أنمي بلاك",rank:"المؤسس",joined:true,unlocked:true,channels:[{id:uid(),name:"الدردشة العامة",unread:0,topic:"جديد"}],messages:[]};
    S.communities.unshift(c);toast("تم إنشاء "+nm+" ","ok");celebrate("أنشأت "+(t==="guild"?"نقابة":t==="channel"?"قناة":t==="group"?"مجموعة":"مجموعة")+" جديدة!");
    save();setTimeout(()=>go("communityDetail",{id:c.id}),700);return;
  }
  const p={id:"p"+uid(),authorId:"me",author:S.me,type:t,text:txt,media:(()=>{/* v2: لا وسيط وهمي — فقط المرفق الحقيقي. الأصل: (window.__att||[]).length||t!=="post" ? بطاقة متدرجة مولّدة : null */const wa=(window.__att||[]).find(a=>a.src);if(wa)return Object.assign({c1:cols[0],c2:cols[1],emo:cols[2]},{src:wa.src,kind:wa.k});if((window.__att||[]).length)return{c1:cols[0],c2:cols[1],emo:cols[2]};return null})(),likes:0,liked:false,saved:false,comments:[],shares:0,views:1,createdAt:now(),privacy:window.__priv||"public",tags:[],reactions:[]};
  if(t==="poll"){const opts=$$("#pollopts input").map(i=>i.value.trim()).filter(Boolean);p.poll={options:(opts.length?opts:["نعم","لا"]).map((x,i)=>({id:"o"+i,t:x,v:0})),voted:null}}
  p.loc=S.draftLoc||"";p.lockC=!!S.draftLockComments;
  p.spoiler=!!S.draftSpoiler;S.draftSpoiler=false;
  if(t==="news")p.newsMeta={src:(($("#nwSrc")&&$("#nwSrc").value)||"").trim()||"أنمي بلاك",cat:window.__nwCat||"إصدار",verified:!!S.draftVerified};
  if(t==="announcement"){p.type="news";p.official=S.draftOfficial!==false;p.pinned=!!S.draftPin;p.newsMeta={src:"إدارة أنمي بلاك",cat:"إعلان",verified:true}}
  if(t==="reel"&&S.draftReelMusic){p.music=S.draftReelMusic;if(p.media)p.media.emo=S.draftReelEmo||p.media.emo}S.draftLoc="";S.draftLockComments=false;S.draftText="";S.draftTags=[];
  p.privacy=window.__priv||"public";p.tags=collectTags();p.feeling=S.draftFeeling||"";S.draftFeeling="";
  if(p.poll){p.poll.end=now()+(S.draftPollHrs||24)*36e5;p.poll.once=!!S.draftPollOnce}
  const _ed=$("#evD"),_et=$("#evT"),_el=$("#evLoc");if(t==="event"&&_ed&&_ed.value)p.event={d:_ed.value,t:(_et&&_et.value)||"21:00",loc:(_el&&_el.value)||""};
  if(S.evCtx){p.eventId=S.evCtx;const _ev=(S.events||[]).find(e=>e.id===S.evCtx);if(_ev){if(!p.media)p.media={c1:_ev.c1,c2:_ev.c2,emo:_ev.icon};if(!(p.tags||[]).length&&_ev.tag)p.tags=[_ev.tag.replace(/^#/,"")]}S.evCtx=null}
  p.pending = true;
  S.posts.unshift(p);
  syncPostToCloud(p);
  window.__att=[];window.__priv="public";
  addXP(25,"نشر منشور");addCoins(15,"مكافأة النشر");questProgress("q1");
  celebrate("تم النشر بنجاح ");
  setTimeout(()=>go("home",{},false),700);
}
PAGES.createStory=()=>{
  setHdr(backHdr("إنشاء قصة","تختفي بعد ٢٤ ساعة",`<button class="btn btn-primary btn-sm" onclick="publishStory()">نشر ${I("send","i s")}</button>`));setNav(false);
  const c=S.storyCol||["#7F1D1D","#EA580C"];
  return `<div class="pad">
    <div class="art-bg" style="--c1:${c[0]};--c2:${c[1]};aspect-ratio:9/14;border-radius:20px;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;overflow:hidden">${S.storyImg?`<img src="${S.storyImg}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:20px">`:""}
      <div style="z-index:2;color:#fff;line-height:0">${ICONS.includes(S.storyEmo)?IF(S.storyEmo,"xxl"):IF("flame","xxl")}</div>
      <textarea id="stxt" class="inp" style="width:80%;background:rgba(0,0,0,.45);border-color:rgba(255,255,255,.2);color:${S.storyTxtCol||"#FFFFFF"};font-size:${S.storyTxtSize||16}px;text-align:center;font-weight:800;z-index:2" rows="2" placeholder="اكتب نص القصة..."></textarea>
      <div style="position:absolute;top:11px;left:11px;right:11px;display:flex;gap:5px;z-index:3">
        <div class="g1" style="height:3px;background:rgba(255,255,255,.25);border-radius:99px"><i style="display:block;height:100%;width:0;background:#fff;border-radius:99px;animation:load 5s linear forwards"></i></div>
      </div>
    </div>
    <div class="div"></div>
    <div class="lbl">الخلفية</div>
    <div class="chiprow">${[["#7F1D1D","#EA580C"],["#3B0764","#A855F7"],["#064E3B","#10B981"],["#0C4A6E","#0EA5E9"],["#831843","#DB2777"],["#111827","#374151"]].map(cc=>`
      <button style="width:44px;height:44px;border-radius:13px;flex-shrink:0;background:linear-gradient(135deg,${cc[0]},${cc[1]});border:2px solid ${JSON.stringify(cc).replace(/"/g,"'")===JSON.stringify(c).replace(/"/g,"'")?"#fff":"transparent"}" onclick="S.storyCol=${JSON.stringify(cc).replace(/"/g,"'")};save();render()"></button>`).join("")}
    </div>
    <div class="lbl">الملصق</div>
    <div class="chiprow">${["flame","swords","sakura","crown","face-love","clapper","book","heart","sparkles","eye","gamepad","music"].map(e=>`<button class="chip ${S.storyEmo===e?'on':''}" onclick="S.storyEmo='${e}';save();render()">${I(e,"i s")}</button>`).join("")}</div>
    <div class="lbl">صورة الخلفية (من هاتفك)</div>
    <input type="file" id="stImgFile" accept="image/*" style="display:none" onchange="stImgUpload(this)">
    <input type="file" id="stCamFile" accept="image/*" capture="environment" style="display:none" onchange="stImgUpload(this)">
    <div class="row" style="gap:7px"><button class="btn btn-primary btn-sm g1" onclick="document.getElementById('stImgFile').click()">${I("image","i s")} من المعرض</button><button class="btn btn-sec btn-sm g1" onclick="document.getElementById('stCamFile').click()">${I("camera","i s")} الكاميرا</button>${S.storyImg?`<button class="btn btn-sec btn-sm" onclick="S.storyImg='';save();render();toast('أُزيلت صورة الخلفية ','info')">${I("x","i s")}</button>`:""}</div>
    <div class="lbl">لون النص وحجمه</div>
    <div class="chiprow">${["#FFFFFF","#111111","#FDE68A","#4ADE80","#F472B6"].map(cc=>`<button style="width:34px;height:34px;border-radius:50%;background:${cc};border:2px solid ${(S.storyTxtCol||"#FFFFFF")===cc?"var(--accent)":"var(--line2)"}" onclick="S.storyTxtCol='${cc}';save();render()" aria-label="لون النص"></button>`).join("")}<button class="chip" onclick="stSize(-2)" aria-label="تصغير النص">${I("zoomout","i s")} أصغر</button>
      <button class="chip mono">${S.storyTxtSize||16}</button>
      <button class="chip" onclick="stSize(2)" aria-label="تكبير النص">${I("zoomin","i s")} أكبر</button></div>
    <div class="lbl">أدوات</div>
    <div class="chiprow">
      <button class="chip" onclick="addSticker('poll')">${I("barchart","i s")} استطلاع</button>
      <button class="chip" onclick="addSticker('ask')">${I("help","i s")} صندوق سؤال</button>
      <button class="chip" onclick="addSticker('count')">${I("clock","i s")} عدّاد</button>
      <button class="chip" onclick="addSticker('loc')">${I("map","i s")} موقع</button>
      <button class="chip" onclick="addSticker('music')">${I("music","i s")} موسيقى</button>
      <button class="chip" onclick="addSticker('tag')">${I("at","i s")} إشارة</button>
    </div>
    ${(S.storyStickers||[]).length?`<div class="lbl">الملصقات المضافة (${(S.storyStickers||[]).length})</div><div class="chiprow">${(S.storyStickers||[]).map((skk,si)=>`<button class="chip on" onclick="delSticker(${si})">${I(skk.t==="poll"?"barchart":skk.t==="ask"?"help":skk.t==="count"?"clock":skk.t==="loc"?"map":skk.t==="music"?"music":"at","i s")} ${skk.t==="poll"?"استطلاع":skk.t==="ask"?"سؤال":skk.t==="count"?"عدّاد":skk.t==="loc"?"موقع":skk.t==="music"?"موسيقى":"إشارة"} · حذف</button>`).join("")}</div>`:""}
    ${(S.storyDrafts||[]).length?`<div class="lbl">مسودات القصص (${(S.storyDrafts||[]).length})</div><div class="col">${(S.storyDrafts||[]).map(dd=>`<div class="rowb card2" style="padding:8px 10px"><div class="g1"><div class="tiny b">${(dd.stickers||[]).length} ملصق${dd.txt?" · "+esc(dd.txt.slice(0,20)):""}</div><div class="tiny fnt">${ago(dd.at||now())}</div></div><div class="row" style="gap:6px"><button class="btn btn-sec btn-xs" onclick="restoreDraft('${dd.id}')">استعادة</button><button class="btn btn-sec btn-xs" onclick="delDraft('${dd.id}')">حذف</button></div></div>`).join("")}</div>`:""}
    <div class="div"></div>
    <button class="rowb card2" style="padding:11px;width:100%" onclick="S.storyCloseFriends=!S.storyCloseFriends;save();render();snd('tap');toast(S.storyCloseFriends?'القصة للأصدقاء المقربين فقط ':'القصة عامة ','info')"><span class="row b xs">${I("lock","i s")} الأصدقاء المقربون فقط</span><span class="sw ${S.storyCloseFriends?'on':''}"></span></button>
    <div style="height:9px"></div>
    <div class="grid2"><button class="btn btn-sec" onclick="saveDraft()">${I("save","i s")} مسودة</button><button class="btn btn-primary" onclick="publishStory()">${I("send","i s")} نشر القصة</button></div>
  </div>`;
};
function publishStory(){
  const t=($("#stxt")&&$("#stxt").value.trim())||"قصتي الجديدة";
  const c=S.storyCol||["#7F1D1D","#EA580C"];
  const st=(S.stories||[]).find(x=>x.userId==="me");
  const item={type:"image",c1:c[0],c2:c[1],emo:S.storyEmo||"flame",text:t,createdAt:now(),stickers:(S.storyStickers||[]).slice(),img:S.storyImg||"",tc:S.storyTxtCol||"#FFFFFF",big:!!S.storyTxtBig,sz:S.storyTxtSize||16,closeFriends:!!S.storyCloseFriends};
  S.storyStickers=[];S.storyImg="";
  const seedV=S.users.filter(x=>x.id!=="me").sort(()=>Math.random()-.5).slice(0,rnd(3,9)).map(x=>({u:x.id,at:now()-rnd(2,300)*6e4}));
  const sidVal=st?st.id:("s"+uid());
  const myUid=window.auth&&window.auth.currentUser?window.auth.currentUser.uid:"me";
  if(st){st.items.unshift(item);st.views=(st.views||[]).concat(seedV)}else S.stories.unshift({id:sidVal,userId:myUid,seen:false,items:[item],views:seedV});
  addXP(15,"نشر قصة");celebrate("تم نشر قصتك ");
  if(window.auth&&window.auth.currentUser&&window.db){
    const storyDoc={id:sidVal,userId:myUid,userName:S.me.name||"مستخدم",userAvatar:S.me.avatar||"",seen:false,items:st?st.items:[item],createdAt:now()};
    window.setDoc(window.doc(window.db,"stories",sidVal),storyDoc).catch(e=>console.error(e));
  }
  save();setTimeout(()=>go("storyViewer",{i:0,sid:sidVal}),700);
}
PAGES.storyViewer=()=>{
  setHdr("");setNav(false);
  if(!S.stories||!(S.stories||[]).length)return emptyState("clock","لا قصص حالياً","شارك أول قصة في المنصة!");
  const sid=S.params.sid||(S.stories[0]&&S.stories[0].id);const si=(S.stories||[]).findIndex(x=>x.id===sid);
  const st=S.stories[si]||S.stories[0];if(!st)return emptyState("clock","لا قصص","");
  {const hh=S.me.history||[];const last=hh[0];if(!last||last.sid!==st.id||Date.now()-last.at>3e5){S.me.history=[{a:null,type:"story",sid:st.id,t:"قصة: "+u(st.userId).name,e:1,at:now()}].concat(hh).slice(0,60);save()}}
  st.seen=true;
  const ii=Math.min(S.params.i||0,(st.items||[]).length-1);const it=((st.items||[])[ii]||{});const uu=u(st.userId);
    return `<div style="height:100%;position:relative;background:#000;display:flex;flex-direction:column" onpointerdown="pauseST()" onpointerup="resumeST()" onpointercancel="resumeST()">
    ${it.img?`<img src="${it.img}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">`:`<div style="position:absolute;inset:0">${art(it.c1,it.c2,it.emo,artBg(st.id+ii))}</div>`}
    <div style="position:absolute;top:0;left:0;right:0;padding:11px;z-index:4;background:linear-gradient(to bottom,rgba(0,0,0,.7),transparent)">
      <div style="display:flex;gap:4px;margin-bottom:10px">${st.items.map((_,k)=>`<div style="flex:1;height:2.5px;background:rgba(255,255,255,.28);border-radius:99px;overflow:hidden">${k<ii?'<i style="display:block;height:100%;width:100%;background:#fff"></i>':k===ii?'<i id="stbar" style="display:block;height:100%;width:0;background:#fff;animation:load 5s linear forwards"></i>':""}</div>`).join("")}</div>
      <div class="row" style="gap:9px">
        <button onclick="openProfile('${uu.id}')">${av(uu,34,true)}</button>
        <div class="g1"><div class="row" style="gap:4px"><span class="b xs" style="color:#fff">${esc(uu.name)}</span>${vbadge(uu)}</div><div class="tiny" style="color:rgba(255,255,255,.6)">${ago(it.createdAt)}</div></div>
        ${st.userId==="me"?`<button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="openSheet('viewsSheet','${sid}')">${I("eye","i s")} ${(st.views||[]).length}</button>`:""}
        <button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="muteStory('${sid}')">${I("mute","i s")}</button>
        <button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="openSheet('storyMenu','${sid}')">${I("more","i s")}</button>
        <button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="closeStory()">${I("x","i s")}</button>
      </div>
    </div>
    <button style="position:absolute;top:80px;bottom:120px;right:0;width:35%;z-index:3" onclick="prvStory('${sid}',${ii})"></button>
    <button style="position:absolute;top:80px;bottom:120px;left:0;width:35%;z-index:3" onclick="nxtStory('${sid}',${ii},${si},${(st.items||[]).length})"></button>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:2;pointer-events:none">
      <div class="bb center" style="color:${it.tc||"#fff"};font-size:${it.sz?Math.round(it.sz*1.25)+"px":(it.big?"27px":"20px")};text-shadow:0 3px 16px rgba(0,0,0,.8);padding:0 24px">${esc(it.text||"")}</div>
    </div>
    ${(it.stickers||[]).length?`<div style="position:absolute;bottom:104px;left:12px;right:12px;z-index:3;display:flex;flex-direction:column;gap:7px">${it.stickers.map((skk,k2)=>stkView(st,sid,ii,k2,skk)).join("")}</div>`:""}
    <div style="position:absolute;bottom:0;left:0;right:0;padding:12px;z-index:4;background:linear-gradient(to top,rgba(0,0,0,.85),transparent);display:flex;gap:8px;align-items:center">
      <input class="inp g1" id="streply" placeholder="أرسل رداً..." style="background:rgba(0,0,0,.5);border-color:rgba(255,255,255,.22);color:#fff;border-radius:99px">
      ${[["heart","إعجاب"],["flame","رائع"],["star","مميز"],["face-love","أحبها"]].map(([ric,rl])=>`<button class="iconbtn" style="background:rgba(0,0,0,.5);color:#fff;border-color:rgba(255,255,255,.2)" onclick="reactStory('${sid}','${ric}')" aria-label="${rl}">${IF(ric,"i s")}</button>`).join("")}
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendStoryReply('${sid}')">${I("send","i s")}</button>
    </div>
  </div>`;
};
function startST(sid,ii,si,len){window.__stA=[sid,ii,si,len];clearTimeout(window.__stT);const bar=$("#stbar");if(bar)bar.style.animationPlayState="running";
  const st=(S.stories||[]).find(x=>x.id===sid);
  if(st&&ii===0&&st.userId!=="me"){st.views=st.views||[];if(!st.views.some(v=>v.u==="me")){st.views.push({u:"me",at:now()});save()}}
  window.__stEnd=Date.now()+5000;window.__stT=setTimeout(()=>nxtStory(sid,ii,si,len),5000)}
function pauseST(){if(!window.__stA)return;clearTimeout(window.__stT);window.__stRem=Math.max(200,(window.__stEnd||0)-Date.now());const b=$("#stbar");if(b)b.style.animationPlayState="paused"}
function resumeST(){if(!window.__stA||window.__stRem==null)return;const a=window.__stA;window.__stEnd=Date.now()+window.__stRem;window.__stT=setTimeout(()=>nxtStory(a[0],a[1],a[2],a[3]),window.__stRem);const b=$("#stbar");if(b)b.style.animationPlayState="running";window.__stRem=null}
function reactStory(sid,ic){S.storyReactions=S.storyReactions||{};S.storyReactions[sid]=S.storyReactions[sid]||[];S.storyReactions[sid].push({ic,from:"me",at:now()});save();snd("success");burst(null);toast("تفاعلت على القصة ","ok")}
function sendStoryReply(sid){const e=$("#streply");const v=e?(e.value||"").trim():"";if(!v){toast("اكتب رداً","err");return}const st=(S.stories||[]).find(x=>x.id===sid);const oid=st?st.userId:"me";let c=(S.chats||[]).find(x=>x.userId===oid);if(!c){c={id:"c"+uid(),userId:oid,messages:[],last:"",lastAt:now(),unread:0};S.chats.unshift(c)}c.messages.push({id:uid(),from:"me",text:"رد على القصة: "+v,at:now()});c.last="رد على قصة";c.lastAt=now();if(e)e.value="";save();snd("send");toast("أُرسل ردك إلى محادثة "+u(oid).name+" ","ok")}
function stImgUpload(inp){const f=inp.files&&inp.files[0];if(!f)return;fileDownscale(f,900,0.72,src=>{if(!src){toast("تعذّر قراءة الصورة","err");return}S.storyImg=src;save();render();toast("صورتك صارت خلفية القصة ","ok")})}
function addHighlight(sid,ii){const st=(S.stories||[]).find(x=>x.id===sid);const it=st&&st.items[ii||0];if(!it)return;(S.highlights=S.highlights||[]).push({id:uid(),sid,ii:ii||0,t:(it.text||"لحظة").slice(0,14),c1:it.c1,c2:it.c2});save();closeOvl();toast("أُضيفت إلى أبرز اللحظات في ملفك ","ok");render()}
function delStoryItem(sid,ii){const i2=(S.stories||[]).findIndex(x=>x.id===sid);if(i2<0)return;const st=S.stories[i2];st.items.splice(ii,1);if(!(st.items||[]).length)S.stories.splice(i2,1);save();closeOvl();render();toast("حُذف عنصر القصة ","info")}
function saveStoryPNG(sid,ii){const st=(S.stories||[]).find(x=>x.id===sid);const it=st&&st.items[ii||0];if(!it){toast("القصة غير موجودة","err");return}
  const cv=document.createElement("canvas");cv.width=720;cv.height=1280;const g=cv.getContext("2d");
  const gr=g.createLinearGradient(0,0,720,1280);gr.addColorStop(0,it.c1||"#7F1D1D");gr.addColorStop(1,it.c2||"#EA580C");g.fillStyle=gr;g.fillRect(0,0,720,1280);
  const done=()=>{try{g.fillStyle=it.tc||"#fff";g.font="700 "+(it.sz?Math.round(it.sz*2.9):(it.big?62:46))+"px system-ui,sans-serif";g.textAlign="center";g.shadowColor="rgba(0,0,0,.65)";g.shadowBlur=18;
    const words=String(it.text||"").split(" ");let y=560,line="";for(const w of words){if((line+w).length>20){g.fillText(line,360,y);y+=it.sz?Math.round(it.sz*4):(it.big?86:62);line=""}line+=w+" "}g.fillText(line,360,y);
    g.shadowBlur=0;g.font="600 30px system-ui";g.fillStyle="rgba(255,255,255,.9)";g.fillText("أنمي بلاك · "+(S.me.name||""),360,1210);
    const a=document.createElement("a");a.href=cv.toDataURL("image/png");a.download="animeblack-story.png";document.body.appendChild(a);a.click();a.remove();window.__lastPNG=(a.href||"").slice(0,26);toast("حُفظت القصة كصورة PNG حقيقية ","ok")}catch(e){toast("تعذّر الحفظ: "+String(e.message||e).slice(0,50),"err")}};
  if(it.img){const im=new Image();im.onload=()=>{try{g.drawImage(im,0,0,720,1280)}catch(e){}done()};im.onerror=done;im.src=it.img}else done()}
PAGES.myStories=()=>{setNav(false);setHdr(backHdr("قصصي وأرشيفي","مشاهدات وتفاعلات ونتائج وحذف"));
  const mine=S.stories.filter(x=>x.userId==="me");
  return `<div class="pad col">
  ${mine.length?mine.map(st=>st.items.map((it,ix)=>`<div class="card" style="padding:11px"><div class="row" style="gap:10px">
    <button style="width:52px;height:76px;border-radius:12px;overflow:hidden;flex-shrink:0;position:relative;background:linear-gradient(160deg,${it.c1},${it.c2})" onclick="go('storyViewer',{i:${ix},sid:'${st.id}'})">${it.img?`<img src="${it.img}" alt="" style="width:100%;height:100%;object-fit:cover">`:`<span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff">${I(it.emo||"flame","l")}</span>`}</button>
    <div class="g1"><div class="b xs">${esc((it.text||"قصة").slice(0,44))}</div><div class="tiny fnt" style="margin-top:5px">${I("eye","i s")} ${(st.views||[]).length} مشاهدة · ${I("heart","i s")} ${((S.storyReactions||{})[st.id]||[]).length} تفاعل · ${ago(it.createdAt)}</div></div>
    <div class="col" style="gap:5px"><button class="btn btn-sec btn-xs" onclick="openSheet('resultsSheet','${st.id}')">نتائج</button><button class="btn btn-sec btn-xs" onclick="delStoryItem('${st.id}',${ix})">حذف</button></div>
  </div></div>`).join("")).join(""):`<div class="card center" style="padding:26px">${I("clock","xl")}<div class="b sm" style="margin-top:8px">لا قصص بعد</div><button class="btn btn-primary btn-sm" style="margin-top:10px" onclick="go('createStory')">إنشاء قصة</button></div>`}
  ${(S.highlights||[]).length?`<div class="secttl"><h3>${I("star","i s")} أبرز اللحظات</h3></div>${(S.highlights||[]).map(hh=>`<div class="rowb card2" style="padding:9px 11px;margin-bottom:7px"><span class="b xs g1">${esc(hh.t||"لحظة")}</span><button class="btn btn-sec btn-xs" onclick="S.highlights=S.highlights.filter(x=>x.id!=='${hh.id}');save();render();toast('أُزيلت من أبرز اللحظات ','info')">إزالة</button></div>`).join("")}`:""}
  </div>`};
function nxtStory(sid,ii,si,len){if(ii<len-1)go("storyViewer",{i:ii+1,sid},false);else if(si<(S.stories||[]).length-1)go("storyViewer",{i:0,sid:S.stories[si+1].id},false);else{toast("انتهت القصص ","info");go("home")}}
function prvStory(sid,ii){if(ii>0)go("storyViewer",{i:ii-1,sid},false);else toast("أول عنصر","info")}
function closeStory(){go("home",{},false)}

/* ============================================================
   9) الدردشة: خاصة + مجتمعات + مكالمات
   ============================================================ */
PAGES.chat=()=>{
  S.activeTab="chat";
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('home')">${I("back")}</button>
    <div class="ttl">الرسائل<small>MESSAGES</small></div>
    <button class="iconbtn" onclick="go('gmail')">${I("mail")}</button>
    <button class="iconbtn" style="position:relative" onclick="openSheet('reqSheet')" aria-label="طلبات المراسلة">${I("usercheck")}${(S.chatReqs||[]).length?`<span class="ping"></span>`:""}</button>
    <button class="iconbtn" onclick="openSheet('newChatSheet')">${I("edit")}</button></div>`);
  setNav(true);
  const isComm = (S.chatMode === "communities");
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div style="display:flex;justify-content:center;padding:9px;border-bottom:1px solid var(--line);flex-shrink:0">
      <div style="display:flex;gap:4px;background:var(--surface3);border:1px solid var(--line2);border-radius:13px;padding:4px">
        <button class="btn btn-sm ${!isComm?'btn-primary':'btn-ghost'}" style="border:none;padding:6px 20px" onclick="S.chatMode='private';save();render();snd('tap')">الخاص والمراسلة</button>
        <button class="btn btn-sm ${isComm?'btn-primary':'btn-ghost'}" style="border:none;padding:6px 20px" onclick="S.chatMode='communities';save();render();snd('tap')">المجموعات والنقابات</button>
      </div>
    </div>
    ${isComm ? `<div class="row" style="gap:6px;padding:8px 10px;flex-shrink:0;overflow-x:auto;border-bottom:1px solid var(--line)" class="no-sb">
      <button class="chip btn-xs g1" style="justify-content:center;white-space:nowrap" onclick="go('myChannels')">${I("tv","i s")} قنواتي</button>
      <button class="chip btn-xs g1" style="justify-content:center;white-space:nowrap" onclick="go('myGroups')">${I("shield","i s")} نقاباتي</button>
      <button class="chip btn-xs g1" style="justify-content:center;white-space:nowrap" onclick="go('groups')">${I("users","i s")} قروباتي</button>
      <button class="chip btn-xs g1" style="justify-content:center;white-space:nowrap" onclick="go('worlds')">${I("globe","i s")} عوالمي</button>
      <button class="chip btn-xs g1" style="justify-content:center;white-space:nowrap" onclick="go('communityHub')">${I("users","i s")} مركز المجتمعات</button></div>` : ""}
    <div style="flex:1;overflow-y:auto" class="no-sb">${!isComm ? chatList() : communityList()}</div>
  </div>`;
};
function chatList(){
  const q=(S.chatQ||"").toLowerCase();
  const F=S.chatFilter||"all";
  const myUid = getMyUid();
  const base=S.chats.filter(c=>{
    if(c.participants && c.participants.length > 0){
      const isMine = c.participants.includes(myUid) || c.participants.includes(S.me.id) || c.participants.includes(S.me.uid) || c.id.includes(myUid);
      if(!isMine) return false;
    }
    const partner = u(c.userId);
    return !q || (partner && partner.name && partner.name.toLowerCase().includes(q));
  });
  const cnt={all:base.filter(c=>!c.archived).length,unread:base.filter(c=>c.unread&&!c.archived).length,pinned:base.filter(c=>c.pinned&&!c.archived).length,archived:base.filter(c=>c.archived).length};
  const list=base.filter(c=>F==="archived"?!!c.archived:(!c.archived&&(F==="all"||(F==="unread"&&c.unread)||(F==="pinned"&&c.pinned)))).sort((a,b)=>(b.pinned?1:0)-(a.pinned?1:0)||b.lastAt-a.lastAt);
  const ltIcon=c=>{const m=c.messages[(c.messages||[]).length-1];if(!m)return "";const k={voice:"mic",image:"image",video:"clapper",sticker:"sparkles",file:"file",contact:"user",cpoll:"barchart"}[m.type];return k?I(k,"i s")+" ":""};
  return `<div class="pad" style="padding-top:10px">
    <div class="row" style="gap:8px;margin-bottom:9px">
      <div class="row g1" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:13px;padding:9px 12px">
        <span style="color:var(--muted)">${I("search","i s")}</span>
        <input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث في المحادثات..." value="${esc(S.chatQ||"")}" oninput="S.chatQ=this.value;saveDebounced();const p=this.selectionStart;render();const n=$('input[placeholder^=\\'ابحث في المحادثات\\']');if(n){n.focus();n.setSelectionRange(p,p)}">
      </div>
      <button class="iconbtn" onclick="openSheet('newChatSheet')" aria-label="محادثة جديدة">${I("plussq")}</button>
    </div>
    <div class="chiprow" style="margin-bottom:10px">${[["all","الكل"],["unread","غير مقروء"],["pinned","مثبتة"],["archived","مؤرشفة"]].map(([k,l])=>`<button class="chip ${F===k?'on':''}" onclick="S.chatFilter='${k}';save();render();snd('tap')">${l}${cnt[k]?` <span class="mono tiny">${cnt[k]}</span>`:""}</button>`).join("")}</div>
    ${notesRow()}
    <div class="secttl"><h3>${I("chat","i s")} المحادثات ${list.reduce((a,c)=>a+c.unread,0)?`<span class="badge b-red">${list.reduce((a,c)=>a+c.unread,0)}</span>`:""}</h3>
      <button class="more" onclick="S.chats.forEach(c=>c.unread=0);save();render();toast('تم تعليم الكل كمقروء','ok')">تعليم الكل</button></div>
    <div class="col">
      ${list.length?list.map(c=>{const uu=u(c.userId);return `
        <div class="lstrow" style="cursor:pointer" onclick="openChat('${c.id}')" oncontextmenu="event.preventDefault();openSheet('chatMenu','${c.id}')">
          ${av(uu,48,true)}
          <span class="g1" style="text-align:right;min-width:0">
            <span class="rowb"><span class="row" style="gap:4px"><span class="b xs">${esc(uu.name)}</span>${vbadge(uu)}</span><span class="tiny fnt">${ago(c.lastAt)}</span></span>
            <span class="rowb" style="margin-top:2px"><span class="tiny ${c.unread?'b':'mut'}" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:160px;display:inline-block">${(S.chatDrafts||{})[c.id]?`<span class="badge" style="background:var(--gold);color:#111;margin-inline-end:4px">مسودة</span>`:""}${ltIcon(c)}${esc(c.last)}</span>
              <span class="row" style="gap:4px">${c.muted?I("mute","i s"):""}${c.vanish?I("clock","i s"):""}${c.pinned?`<span style="color:var(--accent)">${I("pin","i s")}</span>`:""}${c.archived?I("archive","i s"):""}${c.unread?`<span class="badge b-red mono" style="min-width:18px;justify-content:center">${c.unread}</span>`:""}</span></span>
          </span>
          <button class="iconbtn" style="width:30px;height:30px;flex-shrink:0" onclick="event.stopPropagation();openSheet('chatMenu','${c.id}')" aria-label="خيارات المحادثة">${I("more","i s")}</button>
        </div>`}).join(""):emptyState("chat",F==="archived"?"لا محادثات مؤرشفة":"لا محادثات","ابدأ محادثة جديدة من الزر +")}
    </div>
    <div class="secttl"><h3>${I("users","i s")} أصدقاء مقترحون</h3></div>
    <div class="col">${S.users.filter(x=>!isMe(x.id)&&!S.chats.some(c=>c.userId===x.id)).slice(0,3).map(x=>`
      <div class="lstrow">${av(x,40)}<div class="g1"><div class="b xs">${esc(x.name)}</div><div class="tiny fnt">@${esc(x.username)}</div></div>
      <button class="btn btn-primary btn-xs" onclick="startChat('${x.id}')">${I("chat","i s")} راسله</button></div>`).join("")}</div>
  </div>`;
}
function startChat(uidv){
  if(!uidv || isMe(uidv)){
    toast("لا يمكنك بدء محادثة مع حسابك الخاص", "info");
    return;
  }
  const myUid = getMyUid();
  const sortedUids = [myUid, uidv].sort();
  const cidKey = "ch_" + sortedUids.join("_");
  let c = (S.chats||[]).find(x=>x.id === cidKey || (x.userId === uidv && (!x.participants || x.participants.includes(myUid))));
  const tu=u(uidv);
  if(tu&&tu.reqGate&&!c){
    S.outReqs=S.outReqs||[];
    if(!S.outReqs.includes(uidv)){
      S.outReqs.push(uidv);save();toast("أُرسل طلب مراسلة — بانتظار قبول الطرف الآخر ","info");snd("send");
    } else toast("الطلب معلّق — لم يُقبل بعد ","info");
    return;
  }
  if(!c){
    c={
      id:cidKey,
      userId:uidv,
      type:"private",
      participants:sortedUids,
      unread:0,
      last:"محادثة جديدة",
      lastAt:now(),
      pinned:false,
      muted:false,
      messages:[]
    };
    S.chats.unshift(c);
  } else {
    c.id = cidKey;
    c.userId = uidv;
    c.participants = sortedUids;
  }
  if(window.db && window.setDoc && window.doc){
    try {
      window.setDoc(window.doc(window.db, "chats", cidKey), {
        id: cidKey,
        participants: sortedUids,
        userId: uidv,
        updatedAt: now()
      }, {merge: true}).catch(e=>console.error(e));
    } catch(e){}
  }
  save();openChat(c.id);
}
function openChat(id){
  const c=(S.chats||[]).find(x=>x.id===id);if(!c)return;
  c.unread=0;S.activeChat=id;c.messages=c.messages||[];
  if(window.db && window.collection && window.onSnapshot){
    if(window._chatMsgsSub){ window._chatMsgsSub(); window._chatMsgsSub=null; }
    try {
      const qMsgs = window.query(window.collection(window.db, "chats", id, "messages"));
      window._chatMsgsSub = window.onSnapshot(qMsgs, (snap) => {
        if(snap && !snap.empty){
          const myUid = getMyUid();
          const liveMsgs = snap.docs.map(d=>Object.assign(d.data(), { pending: d.metadata.hasPendingWrites, st: d.metadata.hasPendingWrites ? 1 : 2 })).filter(m => m && m.id);
          const msgMap = {};
          
          liveMsgs.forEach(m => {
            const isMine = (m.senderId === myUid || m.fromId === myUid || (m.senderId && (m.senderId === S.me.id || m.senderId === S.me.uid)) || (!m.senderId && m.from === "me") || (typeof isMe === "function" && isMe(m.senderId)));
            m.from = isMine ? "me" : "them";
            msgMap[m.id] = Object.assign(msgMap[m.id] || {}, m);
          });
          const merged = Object.values(msgMap);
          merged.sort((a,b)=>(a.at||0)-(b.at||0));
          c.messages = merged;
          const lastM = merged[merged.length-1];
          if(lastM){
            c.last = lastM.type === "sticker" ? "ملصق" : (lastM.text || "رسالة");
            c.lastAt = lastM.at || now();
          }
          save();
          if(S.page === "chatRoom" && S.params.id === id){
            const msgBox = document.getElementById("msgs");
            if(msgBox){
              const uu = u(c.userId);
              let rows = []; let lastDay = "";
              c.messages.forEach(m => {
                const dl = dayLbl(m.at);
                if(dl !== lastDay){
                  lastDay = dl;
                  rows.push(`<div class="center" style="margin:10px 0 8px"><span class="tiny b" style="background:var(--surface3);border:1px solid var(--line2);border-radius:99px;padding:4px 12px;color:var(--muted)">${dl}</span></div>`);
                }
                rows.push(msgBubble(m, uu, id));
              });
              msgBox.innerHTML = rows.join("");
              msgBox.scrollTop = msgBox.scrollHeight;
            }
          }
        }
      }, (e)=>console.warn("Chat sync warning:", e));
    } catch(err){}
  }
  save();go("chatRoom",{id});
}
PAGES.chatRoom=()=>{
  const c=(S.chats||[]).find(x=>x.id===S.params.id);if(!c||!c.messages){setNav(false);setHdr(backHdr("المحادثة",""));return emptyState("chat","المحادثة غير موجودة","")}
  const uu=u(c.userId);setNav(false);S.activeChat=c.id;
  if(c.vanish){const cut=now()-c.vanish*36e5;const b4=(c.messages||[]).length;c.messages=c.messages.filter(m=>!m.at||m.at>=cut||(c.pinnedMsgs||[]).includes(m.id));if((c.messages||[]).length!==b4)save()}
  const blocked=(S.blocked||[]).includes(uu.id);
  const pinned=(c.pinnedMsgs||[]).length?msgById(c.pinnedMsgs[(c.pinnedMsgs||[]).length-1]):null;
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%">
    <button class="iconbtn" onclick="go('chat')">${I("back")}</button>
    <button class="row g1" style="gap:9px;text-align:right" onclick="openProfile('${uu.id}')">
      ${av(uu,36,true)}
      <span class="g1" style="min-width:0"><span class="row" style="gap:4px"><span class="b sm">${esc(uu.name)}</span>${vbadge(uu)}${lvlBadge(uu)}</span>
      <span class="tiny ${S.typingIn&&S.typingIn[c.id]?'':'fnt'}" style="color:${S.typingIn&&S.typingIn[c.id]?'var(--accent)':uu.online?'var(--emerald)':'var(--faint)'}">${S.typingIn&&S.typingIn[c.id]?"يكتب الآن…":uu.online?"متصل الآن":"آخر ظهور "+ago(uu.lastSeen||uu.joined)}</span></span>
    </button>
    ${(c.pinnedMsgs||[]).length?`<button class="iconbtn" style="color:var(--gold)" onclick="jumpToMsg('${c.pinnedMsgs[(c.pinnedMsgs||[]).length-1]}')" aria-label="مثبتة">${I("pin","i s")}</button>`:""}
    ${c.vanish?`<button class="iconbtn" style="color:var(--emerald)" onclick="cycleVanish('${c.id}')" aria-label="رسائل مختفية">${I("clock","i s")}</button>`:""}
    ${S.selMode?`<button class="iconbtn" style="color:var(--rose)" onclick="S.selMode=false;S.selIds=[];render()" aria-label="خروج من التحديد">${I("x","i s")}</button>`:""}
    <button class="iconbtn" onclick="S.csQ='';openSheet('chatSearch','${c.id}')" aria-label="بحث في المحادثة">${I("search","i s")}</button>
    <button class="iconbtn" onclick="startCall('${c.id}','voice')" aria-label="مكالمة صوتية">${I("phone","i s")}</button>
    <button class="iconbtn" onclick="startCall('${c.id}','video')" aria-label="مكالمة فيديو">${I("video","i s")}</button>
    <button class="iconbtn" onclick="openSheet('chatRoomMenu','${c.id}')" aria-label="خيارات">${I("more","i s")}</button></div>`);
  let rows=[];let lastDay="";
  c.messages.forEach(m=>{const dl=dayLbl(m.at);if(dl!==lastDay){lastDay=dl;rows.push(`<div class="center" style="margin:10px 0 8px"><span class="tiny b" style="background:var(--surface3);border:1px solid var(--line2);border-radius:99px;padding:4px 12px;color:var(--muted)">${dl}</span></div>`)}rows.push(msgBubble(m,uu,c.id))});
  return `<div style="display:flex;flex-direction:column;height:100%;position:relative">
    ${pinned?`<div class="row" style="gap:8px;padding:7px 12px;background:linear-gradient(90deg,rgba(245,158,11,.14),transparent);border-bottom:1px solid var(--line);flex-shrink:0"><span style="color:var(--gold)">${I("pin","i s")}</span><button class="tiny g1" style="text-align:right;background:none;border:none;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" onclick="jumpToMsg('${pinned.id}')">مثبت: ${esc((pinned.text||"ملصق").slice(0,60))}</button><button class="iconbtn" style="width:26px;height:26px" onclick="pinMsg('${pinned.id}')" aria-label="إلغاء التثبيت">${I("x","i s")}</button></div>`:""}
    <div class="chatbody no-sb" id="msgs" onscroll="const f=$('#msgfab');if(f)f.style.display=(this.scrollHeight-this.scrollTop-this.clientHeight>240)?'flex':'none'"${c.wallpaperImg?` style="background:url('${c.wallpaperImg}') center/cover"`:c.wallpaper?` style="background:linear-gradient(180deg,${c.wallpaper[0]},${c.wallpaper[1]})"`:""}>
      <div class="center tiny fnt" style="margin-bottom:6px">— بداية المحادثة · ${new Date(c.lastAt).toLocaleDateString("ar")} —</div>
      ${c.vanish?`<div class="center tiny fnt" style="color:var(--emerald);margin-bottom:6px">${I("clock","i s")} الرسائل تختفي تلقائياً بعد ${c.vanish===24?"٢٤ ساعة":"٣ أيام"}</div>`:""}
      ${rows.join("")}
      ${S.typingIn&&S.typingIn[c.id]?`<div class="msg them row" style="gap:6px">${av(uu,20)}<span class="dot3"><i></i><i></i><i></i></span></div>`:""}
    </div>
    <button id="msgfab" class="iconbtn" style="display:none;position:absolute;bottom:74px;left:14px;z-index:5;width:40px;height:40px;background:var(--surface2);box-shadow:0 6px 18px rgba(0,0,0,.4)" onclick="const b=$('#msgs');if(b)b.scrollTop=b.scrollHeight" aria-label="لأسفل">${I("chevdown","i s")}</button>
    ${blocked?`<div class="pad center" style="border-top:1px solid var(--line);flex-shrink:0"><div class="tiny fnt" style="color:var(--rose)">${I("ban","i s")} هذا المستخدم محظور — لا يمكنك مراسلته</div><button class="btn btn-sec btn-sm" style="margin-top:8px" onclick="unblockUser('${uu.id}')">إلغاء الحظر للمراسلة</button></div>`:`
    ${S.editMid?`<div class="row" style="gap:8px;padding:6px 12px;background:var(--surface2);border-top:1px solid var(--line);flex-shrink:0"><span style="color:var(--gold)">${I("edit","i s")}</span><span class="tiny g1" style="text-align:right">تعديل رسالتك: ${esc(((msgById(S.editMid)||{}).text||"").slice(0,50))}</span><button class="iconbtn" style="width:26px;height:26px" onclick="S.editMid=null;const i=$('#minp');if(i)i.value='';render()">${I("x","i s")}</button></div>`:""}
    ${S.replyTo?`<div class="row" style="gap:8px;padding:6px 12px;background:var(--surface2);border-top:1px solid var(--line);flex-shrink:0"><span style="color:var(--accent)">${I("reply","i s")}</span><span class="tiny g1" style="text-align:right">رد على: ${esc((((msgById(S.replyTo)||{}).text)||"ملصق").slice(0,50))}</span><button class="iconbtn" style="width:26px;height:26px" onclick="S.replyTo=null;render()">${I("x","i s")}</button></div>`:""}
    ${S.selMode?`<div class="row" style="gap:6px;padding:7px 10px;background:var(--surface2);border-top:1px solid var(--line);flex-shrink:0"><span class="tiny b g1">${(S.selIds||[]).length} رسالة محددة</span><button class="btn btn-sec btn-xs" onclick="openSheet('fwdSheetSel')">${I("fwd","i s")} توجيه</button><button class="btn btn-sec btn-xs" onclick="starSel()">${I("star","i s")} تمييز</button><button class="btn btn-danger btn-xs" onclick="delSel()">${I("trash","i s")} حذف</button><button class="btn btn-ghost btn-xs" onclick="S.selMode=false;S.selIds=[];render()">خروج</button></div>`:""}
    <div class="composer">
      <button class="iconbtn" onclick="openSheet('attachSheet')" aria-label="إرفاق">${I("plus")}</button>
      <textarea id="minp" rows="1" placeholder="${S.editMid?'اكتب التعديل...':'اكتب رسالة...'}" oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px';S.chatDrafts=S.chatDrafts||{};S.chatDrafts['${c.id}']=this.value;saveDebounced()" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMsg('${c.id}')}">${esc((S.chatDrafts||{})[c.id]||"")}</textarea>
      <button class="iconbtn" onclick="openSheet('emojiSheet')" aria-label="ملصقات">${IF("heart","i s")}</button>
      <button class="iconbtn" id="micbtn" onclick="recVoice('${c.id}',this)" aria-label="تسجيل صوتي">${I("mic")}</button>
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendMsg('${c.id}')" aria-label="إرسال">${I("send","i s")}</button>
    </div>`}
  </div>`;
};
function metaHTML(m, cid){
  const C = cid || S.activeChat || (S.params && S.params.id) || "";
  const ticks = m.from === "me"
    ? (m.failed
        ? `<button type="button" title="تعذّر الإرسال — اضغط لإعادة المحاولة" style="background:none;border:none;padding:0;color:var(--rose);line-height:0;display:inline-flex;align-items:center;vertical-align:-2px;cursor:pointer;gap:2px" onclick="event.stopPropagation();retryPendingMsg('${C}','${m.id}')">${I("alert","i s")}<span style="font-size:9.5px;color:var(--rose)">إعادة المحاولة</span></button>`
        : m.pending
          ? `<span title="قيد الإرسال" style="color:var(--faint);line-height:0;display:inline-flex;vertical-align:-2px">${I("clock","i s")}</span>`
          : (m.st||1)===3
            ? `<span title="مقروءة" style="color:var(--cyan);line-height:0;display:inline-flex;vertical-align:-2px">${I("check","i s")}${I("check","i s")}</span>`
            : (m.st||1)===2
              ? `<span title="مستلمة" style="color:var(--faint);line-height:0;display:inline-flex;vertical-align:-2px">${I("check","i s")}${I("check","i s")}</span>`
              : `<span title="أُرسلت" style="color:var(--faint);line-height:0;display:inline-flex;vertical-align:-2px">${I("check","i s")}</span>`)
    : "";
  return `${m.edited?`<span style="opacity:.7">عُدّلت · </span>`:""}${hhmm(m.at)} ${ticks}`;
}
function dayLbl(ms){const d=new Date(ms);const t=new Date();const y=new Date(Date.now()-864e5);
  if(d.toDateString()===t.toDateString())return "اليوم";if(d.toDateString()===y.toDateString())return "أمس";return d.toLocaleDateString("ar",{day:"numeric",month:"long"})}
function shareCardHTML(m,me){const __f=(()=>{const p=(S.posts||[]).find(x=>x.id===m.ref);if(!p)return `<span class="tiny fnt">منشور محذوف</span>`;const au=u(p.authorId, p);return `<div class="card2" style="padding:9px;min-width:190px;background:${me?"rgba(0,0,0,.18)":"var(--surface2)"}"><div class="row" style="gap:7px"><span>${av(au,26)}</span><div class="g1"><div class="tiny b">${esc(au.name)}</div><div class="tiny fnt" style="opacity:.75">${ago(p.createdAt)}</div></div><span class="art-bg" style="--c1:${p.c1||"#3B0764"};--c2:${p.c2||"#831843"};width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center">${I(p.type==="image"?"image":"msgsq","i s")}</span></div><div class="tiny" style="margin-top:7px;line-height:1.5;opacity:.9">${esc((p.text||"").slice(0,90))}</div><button class="btn btn-sec btn-xs" style="margin-top:8px;width:100%" onclick="go('postView',{pid:'${p.id}'})">${I("fwd","i s")} فتح المنشور</button></div>`});return __f()}
function linkify(t){return esc(t).replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" rel="noopener" style="color:#7DD3FC;text-decoration:underline">$1</a>')}
function msgBubble(m,uu,cid){
  const me=m.from==="me";const C=cid||S.activeChat||S.params.id;
  if(m.gone)return `<div class="msg ${me?"me":"them"}" data-mid="${m.id||""}" id="m_${m.id||""}" style="opacity:.62;position:relative">${S.selMode?selBox(m.id):""}<span class="tiny fnt">${I("ban","i s")} حُذفت الرسالة</span><span class="tm">${hhmm(m.at)}</span></div>`;
  const quote=m.quote?`<div style="border-inline-start:3px solid var(--accent);background:rgba(0,0,0,.16);border-radius:8px;padding:5px 9px;margin-bottom:6px;text-align:right"><div class="tiny b" style="color:var(--accent)">${esc(m.quote.n)}</div><div class="tiny fnt" style="opacity:.85">${esc(m.quote.t)}</div></div>`:"";
  const fwd=m.fwd?`<div class="tiny fnt" style="opacity:.72;margin-bottom:4px">${I("fwd","i s")} مُعاد توجيهها</div>`:"";
  const reacts=(m.reacts&&m.reacts.length)?`<div class="row" style="gap:3px;margin-top:6px;flex-wrap:wrap">${Object.entries(m.reacts.reduce((a,r)=>{a[r]=(a[r]||0)+1;return a},{})).map(([ic,n])=>`<button style="display:inline-flex;align-items:center;gap:3px;background:${me?"rgba(0,0,0,.22)":"var(--surface3)"};border:1px solid var(--line2);border-radius:99px;padding:2px 7px;line-height:0;cursor:pointer" onclick="toggleReact('${m.id}','${ic}')"><span style="color:var(--accent);line-height:0">${I(ic,"i s")}</span><span class="tiny mono">${n}</span></button>`).join("")}</div>`:"";
  const inner=m.type==="call"?`<div class="row" style="gap:8px"><span class="ico-tile" style="width:34px;height:34px;border-radius:11px;background:${me?'rgba(0,0,0,.25)':'var(--surface3)'};color:${m.missed?'var(--rose)':me?'#fff':'var(--emerald)'}">${I(m.ctype==="video"?"video":"phone","i l")}</span><span class="g1"><span class="b xs" style="display:block">${m.missed?"مكالمة فائتة":m.ctype==="video"?"مكالمة فيديو":"مكالمة صوتية"}</span><span class="tiny fnt" style="opacity:.8">${m.dur?Math.floor(m.dur/60)+":"+String(m.dur%60).padStart(2,"0")+" د":""} · ${m.out?"صادرة":"واردة"}</span></span></div>`
   :m.type==="sticker"?`<div style="line-height:0;color:${me?"#fff":"var(--accent)"}">${IC(m.icon||"star","xl")}</div>`
   :m.type==="image"&&m.src?`<img src="${m.src}" alt="" style="max-width:100%;max-height:250px;border-radius:12px;display:block">`
   :m.type==="video"&&m.src?`<video src="${m.src}" controls style="max-width:100%;max-height:250px;border-radius:12px;display:block;background:#000"></video>`
   :m.type==="share"?shareCardHTML(m,me)
   :m.type==="voice"?`<div class="row" style="gap:8px;min-width:160px">
      <button class="iconbtn" style="width:30px;height:30px;background:${me?'rgba(255,255,255,.2)':'var(--surface3)'};border-color:transparent;color:${me?'#fff':'var(--accent)'}" onclick="playVoice(this,'${m.id}')" aria-label="تشغيل">${I("play","i s")}</button>
      <div class="g1"><div style="display:flex;gap:2px;align-items:center;height:20px">${Array.from({length:22},(_,i)=>`<i style="width:2.5px;height:${4+strHash((m.id||"v")+"w"+i)%15}px;background:${me?'rgba(255,255,255,.75)':'var(--muted)'};border-radius:99px"></i>`).join("")}</div></div>
      <span class="tiny mono" style="opacity:.7">0:${String(m.dur||14).padStart(2,"0")}</span>
    </div>`
   :m.type==="file"?`<div class="row" style="gap:9px;min-width:180px"><span class="ico-tile" style="width:38px;height:38px;border-radius:12px;background:${me?'rgba(0,0,0,.25)':'var(--surface3)'};color:${me?'#fff':'var(--gold)'}">${I("file","i l")}</span><span class="g1" style="min-width:0"><span class="b xs" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc((m.name||"ملف").slice(0,28))}</span><span class="tiny fnt" style="opacity:.75">مرفق محفوظ داخل المحادثة</span></span>${m.src?`<a class="btn btn-sec btn-xs" href="${m.src}" download="${esc(m.name||"file")}" onclick="event.stopPropagation()">${I("download","i s")}</a>`:""}</div>`
   :m.type==="contact"?(()=>{const cu=u(m.uid||"");return `<div class="row" style="gap:9px;min-width:190px">${av(cu,40)}<span class="g1"><span class="b xs" style="display:block">${esc(cu.name)}</span><span class="tiny fnt" style="opacity:.8">@${esc(cu.username)} · جهة اتصال</span></span><span class="col" style="gap:4px"><button class="btn btn-sec btn-xs" onclick="openProfile('${cu.id}')">ملفه</button><button class="btn btn-sec btn-xs" onclick="startChat('${cu.id}')">راسله</button></span></div>`})()
   :m.type==="cpoll"?(()=>{const tot=(m.votes||[]).reduce((a,b)=>a+b,0)||0;return `<div style="min-width:200px"><div class="b xs">${I("barchart","i s")} ${esc(m.q||"استطلاع")}</div>${(m.opts||[]).map((o,oi)=>{const pc=tot?Math.round(100*(m.votes[oi]||0)/tot):0;return `<button style="display:block;width:100%;margin-top:7px;background:${me?'rgba(0,0,0,.2)':'var(--surface3)'};border:1px solid ${m.me===oi?'var(--accent)':'var(--line2)'};border-radius:10px;padding:0;overflow:hidden;cursor:pointer;text-align:right" onclick="voteChatPoll('${m.id}',${oi})"><span style="display:block;position:relative;padding:7px 10px"><span style="position:absolute;inset:0;width:${pc}%;background:${me?'rgba(255,255,255,.18)':'rgba(34,211,238,.16)'}"></span><span style="position:relative" class="rowb"><span class="tiny b">${esc(o)}${m.me===oi?I("check","i s"):""}</span><span class="tiny mono">${pc}%</span></span></span></button>`}).join("")}<div class="tiny fnt" style="margin-top:6px;opacity:.8">${tot} صوت · ${m.me!=null?"صوتك مسجل":"اضغط للتصويت"}</div></div>`})()
   :m.type==="image"?`<div class="art-bg" style="--c1:#0C4A6E;--c2:#0EA5E9;width:190px;height:130px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff">${IF("image","xl")}</div><div class="xs" style="margin-top:5px">${esc(m.text||"صورة")}</div>`
   :m.type==="video"?`<div class="art-bg" style="--c1:#3B0764;--c2:#7C3AED;width:190px;height:120px;border-radius:12px;display:flex;align-items:center;justify-content:center;position:relative"><span style="color:#fff;line-height:0;display:flex">${IF("clapper","xl")}</span><button class="iconbtn" style="position:absolute;background:rgba(0,0,0,.55);color:#fff;border-color:rgba(255,255,255,.25)" onclick="togglePlay(this)">${I("play","i s")}</button></div>`
   :(m.text&&m.text.includes("http"))?linkPrev(m):esc(m.text||"");
  return `<div class="msg ${me?"me":"them"}" data-mid="${m.id||""}" id="m_${m.id||""}" data-ctx="msg:${m.id||''}" ${S.selMode?` onclick="if(event.target.closest('button,a,video'))return;toggleSel('${m.id}')"`:""} ${me?(bubbleGrad()?` style="background:${bubbleGrad()};position:relative"`:` style="position:relative"`):`style="--a:0;position:relative"`}>${S.selMode?selBox(m.id):""}${!me?`<div class="row" style="gap:5px;margin-bottom:3px"><button onclick="openProfile('${uu.id}')" style="line-height:0">${av(uu,18)}</button><button class="tiny b" style="color:var(--accent);background:none;border:none;padding:0" onclick="openProfile('${uu.id}')">${esc(uu.name)}</button></div>`:""}${fwd}${quote}${inner}<span class="tm">${metaHTML(m, C)}</span>${m.star?`<span style="color:var(--gold);line-height:0;display:inline-flex;vertical-align:-2px;margin-inline-start:3px">${I("star","i s")}</span>`:""}${reacts}</div>`;
}
function sendMsg(cid){
  const i=$("#minp");if(!i)return;
  if(S.editMid){const em=msgById(S.editMid);const t2=(i.value||"").trim();if(em&&t2){em.text=t2;em.edited=true;if(window.db&&window.setDoc&&window.doc){window.setDoc(window.doc(window.collection(window.db,"chats",cid,"messages"),em.id),{text:t2,edited:true},{merge:true}).catch(e=>console.error(e));}}S.editMid=null;i.value="";i.style.height="auto";save();snd("success");render();toast("تم تعديل الرسالة ","ok");return}
  const t=(i.value||"").trim();if(!t)return;
  const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;
  let quote=null;
  if(S.replyTo){const qm=msgById(S.replyTo);if(qm)quote={n:qm.from==="me"?"أنت":u(c.userId).name,t:(qm.text||(qm.type==="sticker"?"ملصق":qm.type||"وسائط")).slice(0,60)};S.replyTo=null}
  const mid=uid();
  const myUid = getMyUid();
  const myName = S.me.name || "أنا";
  const msgObj = {
    id: mid,
    from: "me",
    senderId: myUid,
    senderName: myName,
    text: t,
    type: "text",
    st: 1,
    pending: true,
    quote: quote || null,
    at: now()
  };
  c.messages.push(msgObj);
  c.last=t;c.lastAt=now();i.value="";i.style.height="auto";(S.chatDrafts=S.chatDrafts||{})[cid]="";
  snd("send");haptic("إرسال");questProgress("q4");save();
  const b=$("#msgs");if(b){b.insertAdjacentHTML("beforeend",msgBubble(msgObj,u(c.userId),cid));b.scrollTop=b.scrollHeight}
  if(!netOk()){
    (S.offQ=S.offQ||[]).push({t:"msg",cid,mid});save();
    netbar(false);toast("سيُرسَل تلقائياً عند عودة الاتصال","info");
    return;
  }
  syncChatMessage(cid, msgObj);
}
function playVoice(btn,mid){const m=msgById(mid);if(!m||!m.src){toast("لا مصدر صوتي محفوظ — سُجّلت هذه الرسالة قبل تفعيل التسجيل الحقيقي ","info");return}
  let a=window.__va;
  if(a&&a.__mid===mid&&!a.paused){a.pause();if(btn)btn.innerHTML=I("play","i s");return}
  if(a){try{a.pause()}catch(e){}}
  a=new Audio(m.src);a.__mid=mid;window.__va=a;if(btn)btn.innerHTML=I("pause","i s");
  a.onended=()=>{if(btn)btn.innerHTML=I("play","i s")};
  a.onerror=()=>{if(btn)btn.innerHTML=I("play","i s");toast("تعذّر تشغيل الصوت ","err")};
  a.play().catch(()=>{if(btn)btn.innerHTML=I("play","i s");toast("اضغط مطولاً ثم اختر تشغيل الصوت ","info")})}
function playMediaMid(mid){const m=msgById(mid);if(!m)return;if(m.type==="voice")playVoice(null,mid);else jumpToMsg(mid)}
let recT=null,recS=0;
let mediaRec=null,recChunks=[],recStream=null;
function recVoice(cid,btn){
  if(recT){
    clearInterval(recT);recT=null;btn.innerHTML=I("mic");btn.style.background="";btn.style.color="";
    const c=(S.chats||[]).find(x=>x.id===cid);if(!c)return;const dur=recS;recS=0;
    const finish=(src)=>{
      const mid=uid();
      const myUid=getMyUid();
      const mObj={id:mid,from:"me",senderId:myUid,senderName:S.me.name||"أنا",text:" رسالة صوتية (0:"+String(dur).padStart(2,"0")+")",type:"voice",at:now(),src:src||"",dur:dur||0,st:1,pending:true};
      c.messages.push(mObj);
      c.last=" رسالة صوتية";c.lastAt=now();save();snd("send");toast(src?"أُرسلت رسالة صوتية حقيقية ":"أُرسلت الرسالة الصوتية ","ok");render();
      syncChatMessage(cid, mObj);
    };
    if(mediaRec&&mediaRec.state==="recording"){
      mediaRec.onstop=()=>{try{const bl=new Blob(recChunks,{type:(recChunks[0]&&recChunks[0].type)||"audio/webm"});const rd=new FileReader();rd.onload=()=>finish(rd.result);rd.readAsDataURL(bl)}catch(e){finish("")}
        try{recStream.getTracks().forEach(t=>t.stop())}catch(e){}mediaRec=null;recChunks=[];recStream=null};
      mediaRec.stop()}
    else finish("");
    return}
  recS=0;btn.innerHTML=I("stop","i s");btn.style.background="var(--grad-fire)";btn.style.color="#fff";snd("tap");
  const startTimer=(real)=>{toast(real?"جارٍ تسجيل صوت حقيقي بالميكروفون... اضغط للإرسال ":"جارٍ التسجيل... اضغط مرة أخرى للإرسال ",real?"ok":"info");
    recT=setInterval(()=>{recS++;if(recS>60){clearInterval(recT);recT=null;btn.innerHTML=I("mic");btn.style.background="";btn.style.color="";toast("انتهى وقت التسجيل (٦٠ ث)","err")}},1000)};
  if(navigator.mediaDevices&&navigator.mediaDevices.getUserMedia&&typeof MediaRecorder!=="undefined"){
    navigator.mediaDevices.getUserMedia({audio:true}).then(st=>{
      recStream=st;mediaRec=new MediaRecorder(st);recChunks=[];
      mediaRec.ondataavailable=e=>{if(e.data&&e.data.size)recChunks.push(e.data)};
      mediaRec.start();S.perms=S.perms||{};S.perms.mic="ممنوح (تسجيل حقيقي)";save();startTimer(true)}).catch(()=>{mediaRec=null;startTimer(false)})}
  else startTimer(false);
}
function startCall(cid,type){
  const c=(S.chats||[]).find(x=>x.id===cid);const uu=u(c.userId);
  const html=`<div class="ov" id="callOv" style="background:${type==="video"?"linear-gradient(135deg,"+uu.name.length%2?"#1a0f2e":"#0f1a2e"+",#000)":"radial-gradient(circle at 50% 25%,#2A0A00,#000 65%)"};align-items:center;justify-content:center;gap:16px;text-align:center">
    ${type==="video"?`<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:110px;opacity:.25">${uu.online?"":""}</div>`:""}
    <div style="position:absolute;top:90px;left:16px;width:96px;height:140px;border-radius:14px;background:linear-gradient(135deg,#FF7A00,#E60000);border:2px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:34px;z-index:3"><video id="callCam" autoplay playsinline muted style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none"></video></div>
    <div class="col center" style="gap:11px;z-index:2">
      <div style="padding:4px;border-radius:50%;background:var(--grad-fire);animation:breathe 2s infinite"><img class="avatar" src="${uu.avatar}" width="104" height="104" onerror="this.style.background='#333'"></div>
      <div><div class="bb" style="font-size:19px;color:#fff">${esc(uu.name)}</div>
      <div class="tiny mono" id="callstat" style="color:rgba(255,255,255,.7)">جارٍ الاتصال...</div></div>
      <div class="row" style="gap:7px;justify-content:center">
        <span class="badge b-emerald">${type==="video"?"مكالمة فيديو":"مكالمة صوتية"}</span>
        <span class="badge b-gray mono" id="calltime">00:00</span>
        <span class="badge b-cyan">مشفّرة </span>
      </div>
    </div>
    <div class="row wrap" style="gap:13px;justify-content:center;margin-top:26px;z-index:2">
      ${[["mute","كتم",0],["video","كاميرا",0],["volume","مكبر",0],["screen","مشاركة شاشة",0]].map(([ic,l])=>`
        <button class="col center" style="gap:4px" onclick="this.querySelector('.cb').classList.toggle('on');snd('tap');toast('${l}: '+(this.querySelector('.cb').classList.contains('on')?'مفعّل':'معطّل'),'info')">
          <span class="cb iconbtn" style="width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.22)">${I(ic,"l")}</span>
          <span class="tiny" style="color:rgba(255,255,255,.75);font-weight:700">${l}</span></button>`).join("")}
      <button class="col center" style="gap:4px" onclick="endCall()">
        <span class="iconbtn" style="width:56px;height:56px;border-radius:50%;background:#E60000;color:#fff;border:none;box-shadow:0 6px 22px rgba(230,0,0,.5)">${I("phoneoff","l")}</span>
        <span class="tiny b" style="color:#FCA5A5">إنهاء</span></button>
    </div>
  </div>`;
  $("#ovl").innerHTML=html;snd("notif");window.__callStart=Date.now();window.__callCid=cid;window.__callType=type;
  if(type==="video"&&navigator.mediaDevices&&navigator.mediaDevices.getUserMedia){
    navigator.mediaDevices.getUserMedia({video:true,audio:true}).then(st=>{window.__callStream=st;const v=$("#callCam");if(v){v.srcObject=st;v.style.display="block";v.play&&v.play().catch(()=>{})}S.perms=S.perms||{};S.perms.cam="ممنوح (مكالمة حقيقية)";save()}).catch(()=>{})}
  let s=0,connected=false;
  clearInterval(window.__ct);
  setTimeout(()=>{connected=true;const e=$("#callstat");if(e)e.textContent="متصل "},rnd(2000,3800));
  window.__ct=setInterval(()=>{
    const t=$("#calltime");if(!t){clearInterval(window.__ct);return}
    if(connected){s++;t.textContent=String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")}
    else{const e=$("#callstat");if(e)e.textContent="جارٍ الاتصال"+"".padStart((s++%3)+1,".")}
  },1000);
}
function endCall(){const dur=window.__callStart?Math.max(0,Math.round((Date.now()-window.__callStart)/1000)):0;const cid=window.__callCid;const ctype=window.__callType||"voice";window.__callStart=0;clearInterval(window.__ct);try{if(window.__callStream){window.__callStream.getTracks().forEach(t=>t.stop());window.__callStream=null}}catch(e){}$("#ovl").innerHTML="";if(cid){const c=(S.chats||[]).find(x=>x.id===cid);if(c){c.messages.push({id:uid(),from:"me",type:"call",ctype:ctype,dur:dur,out:true,at:now()});c.last="مكالمة "+(ctype==="video"?"فيديو":"صوتية");c.lastAt=now();save();if(S.page==="chatRoom"&&S.params.id===cid)render()}}toast("انتهت المكالمة ("+Math.floor(dur/60)+":"+String(dur%60).padStart(2,"0")+") ","info");snd("tap")}

/* ---------- المجتمعات والنقابات ---------- */
function communityList(){
  const q=(S.comQ||"").toLowerCase();
  const types=[["all","الكل","grid"],["guild","النقابات","shield"],["group","المجموعات","users"],["channel","القنوات","tv"]];
  const f=S.communities.filter(c=>(S.comFilter==="all"||S.comFilter===""||c.type===S.comFilter)&&(!q||(c.name+c.desc).toLowerCase().includes(q)));
  return `<div class="pad" style="padding-top:10px">
    <div class="row" style="gap:8px;margin-bottom:11px">
      <div class="row g1" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:13px;padding:9px 12px">
        <span style="color:var(--muted)">${I("search","i s")}</span>
        <input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث عن نقابة أو مجموعة..." value="${esc(S.comQ||"")}" oninput="S.comQ=this.value;saveDebounced();render()">
      </div>
      <button class="btn btn-primary btn-sm" onclick="openSheet('createBottom')">${I("plus","i s")} إنشاء</button>
    </div>
    <div class="chiprow">${types.map(([k,l,ic])=>`<button class="chip ${(S.comFilter||'all')===k?'on':''}" onclick="S.comFilter='${k}';save();render();snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}</div>
    <div class="grid3" style="margin:2px 0 10px">
      <button class="btn btn-primary btn-sm" onclick="go('createGroup')">${I("users","i s")} قروب</button>
      <button class="btn btn-gold btn-sm" onclick="go('createGuild')">${I("shield","i s")} نقابة</button>
      <button class="btn btn-sec btn-sm" onclick="go('createWorld')">${I("globe","i s")} عالم</button></div>
    ${((S.comFilter||"all")==="all"||(S.comFilter||"all")==="group")?`<div class="secttl"><h3>${I("users","i s")} قروبات الدردشة</h3><button class="more" onclick="go('groups')">الكل</button></div>
    ${S.groups.filter(g2=>g2.joined&&(!q||(g2.name+g2.desc).toLowerCase().includes(q))).map(g2=>groupRow(g2)).join("")||`<div class="tiny fnt mut" style="padding:4px 0">لا قروبات منضم إليها</div>`}`:""}
    ${(S.comFilter||"all")==="all"?`<div class="secttl"><h3>${I("globe","i s")} عوالمي</h3><button class="more" onclick="go('worlds')">الكل</button></div>
    ${S.worlds.filter(w=>w.joined).map(w=>worldRow(w)).join("")||`<div class="tiny fnt mut" style="padding:4px 0">لا عوالم منضم إليها</div>`}`:""}
    <div class="secttl"><h3>${I("globe","i s")} عوالم مقترحة لك</h3><button class="more" onclick="go('worlds')">كل العوالم</button></div>
    <div style="display:flex;gap:9px;overflow-x:auto;padding-bottom:6px" class="no-sb">
      ${S.worlds.map(w=>`<button class="card2" style="min-width:150px;padding:0;overflow:hidden;text-align:right" onclick="go('worldRoom',{id:'${w.id}'})">
        <div class="art-bg" style="--c1:${w.c1};--c2:${w.c2};height:76px;display:flex;align-items:center;justify-content:center;position:relative">${I(w.icon,"xl")}
          <span class="badge b-emerald" style="position:absolute;top:6px;right:6px">${w.online} متصل</span></div>
        <div style="padding:8px"><div class="tiny b" style="line-height:1.35">${esc(w.name)}</div><div class="tiny fnt">${esc(w.theme)} · ${nfmt(w.members)} عضو</div></div></button>`).join("")}
    </div>

    <div class="secttl"><h3>${I("shield","i s")} مجتمعاتي (${f.filter(c=>c.joined).length})</h3></div>
    <div class="col">${f.map(c=>communityRow(c)).join("")}</div>

    <div class="secttl"><h3>${I("sparkles","i s")} مقترحة لك</h3></div>
    <div class="col">${S.communities.filter(c=>!c.joined).map(c=>communityRow(c)).join("")||emptyState("users","لا اقتراحات","")}</div>
  </div>`;
}
function communityRow(c){
  const tt={guild:"b-gold",group:"b-cyan",channel:"b-purple",space:"b-emerald"}[c.type];
  const tn={guild:"نقابة",group:"مجموعة",channel:"قناة",space:"مساحة"}[c.type];
  return `<button class="lstrow" onclick="go('communityDetail',{id:'${c.id}'})">
    <span class="ico-tile" style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,${c.c1},${c.c2});">${I(c.icon,"i l")}</span>
    <span class="g1" style="text-align:right;min-width:0">
      <span class="row" style="gap:5px"><span class="b xs">${esc(c.name)}</span><span class="badge ${tt}">${tn}</span>${c.joined?`<span class="badge b-emerald">${esc(c.rank)}</span>`:`<span class="badge b-gray">غير منضم</span>`}</span>
      <span class="tiny fnt" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(c.desc)}</span>
      <span class="row tiny fnt" style="gap:9px;margin-top:2px"><span>${I("users","i s")} ${nfmt(c.members)}</span><span style="color:var(--emerald)"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-left:4px;vertical-align:middle"></span> ${c.online} متصل</span>${c.channels.reduce((a,ch)=>a+ch.unread,0)?`<span class="badge b-red mono">${c.channels.reduce((a,ch)=>a+ch.unread,0)} جديد</span>`:""}</span>
    </span>${I("fwd","i s")}</button>`;
}
PAGES.communityDetail=()=>{
  const c=(S.communities||[]).find(x=>x.id===S.params.id);if(!c||!c.channels){setNav(false);setHdr(backHdr("المجتمع",""));return emptyState("users","المجتمع غير موجود","")}
  setNav(false);
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%">
    <button class="iconbtn" onclick="go('chat')">${I("back")}</button>
    <span class="ico-tile" style="width:30px;height:30px;border-radius:10px;background:linear-gradient(135deg,${c.c1},${c.c2});">${I(c.icon,"i l")}</span>
    <div class="g1" style="min-width:0"><div class="b sm" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(c.name)}</div><div class="tiny fnt">${nfmt(c.members)} عضو · ${c.online} متصل</div></div>
    <button class="iconbtn" onclick="openSheet('communityMenu','${c.id}')">${I("more")}</button></div>`);
  const sub=S.params.sub||"chat";
  return `<div style="display:flex;flex-direction:column;height:100%">
    ${!c.joined?`<div style="padding:11px;background:linear-gradient(135deg,rgba(34,211,238,.14),rgba(168,85,247,.09));border-bottom:1px solid var(--line);flex-shrink:0">
      <div class="rowb"><div class="g1"><div class="b xs">${c.unlocked?"مجتمع مفتوح — انضم الآن":"مجتمع مقفل يتطلب دعوة"}</div><div class="tiny fnt">${esc(c.desc)}</div></div>
      <button class="btn ${c.unlocked?'btn-primary':'btn-sec'} btn-sm" ${c.unlocked?"":"disabled"} onclick="${c.unlocked?`joinCommunity('${c.id}')`:`toast('تحتاج دعوة من قائد النقابة','err')`}>${c.unlocked?I("plus","i s")+" انضمام":I("lock","i s")+" مقفل"}</button></div></div>`:""}
    <div class="tabs" style="padding:9px;border-bottom:1px solid var(--line);flex-shrink:0">
      ${[["chat","الدردشة","msgsq"],["channels","القنوات","hash"],["members","الأعضاء","users"],["about","حول","info"],["events","الفعاليات","calendar"],["quests","المهام","target"],...(c.type==="guild"?[["treasury","الخزينة","wallet"]]:[])].map(([k,l,ic])=>`
        <button class="${sub===k?'on':''}" onclick="go('communityDetail',{id:'${c.id}',sub:'${k}'},false);snd('tap')">${I(ic,"i s")} ${l}</button>`).join("")}
    </div>
    <div style="flex:1;overflow-y:auto" class="no-sb">
      ${sub==="chat"?`<div class="chatbody" id="cmsgs">${c.messages.map(m=>{const mu=u(m.from);return `<div class="msg them" style="max-width:88%">
          <div class="row" style="gap:5px;margin-bottom:3px">${av(mu,18)}<span class="tiny b" style="color:var(--accent)">${m.from==="me"?"أنت":esc(mu.name)}</span>${roleBadge(mu)}</div>
          ${m.type==="share"?shareCardHTML(m,m.from==="me"):linkify(m.text)}<span class="tm">${hhmm(m.at)}</span></div>`}).join("")||`<div class="empty">${I("msgsq","l")}<div class="xs b">لا رسائل بعد</div><div class="tiny fnt">ابدأ المحادثة في ${esc(c.name)}</div></div>`}</div>
        <div class="composer">
          <button class="iconbtn" onclick="openSheet('attachSheet')">${I("plus")}</button>
          <textarea id="cinp" rows="1" placeholder="اكتب في ${esc(c.name)}..." oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px'"></textarea>
          <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendComMsg('${c.id}')">${I("send","i s")}</button>
        </div>`:""}
      ${sub==="channels"?`<div class="pad col">${c.channels.map(ch=>`
        <button class="lstrow" onclick="go('communityChannel',{id:'${c.id}',ch:'${ch.id}'})">
          <span class="ico-tile" style="background:var(--surface3);color:var(--accent)">${I("hash","i s")}</span>
          <span class="g1" style="text-align:right"><span class="b xs">${esc(ch.name)}</span><span class="tiny fnt" style="display:block">${esc(ch.topic)}</span></span>
          ${ch.unread?`<span class="badge b-red mono">${ch.unread}</span>`:""}${I("fwd","i s")}</button>`).join("")}
        <button class="btn btn-sec" onclick="const n=prompt('اسم القناة الجديدة:');if(!n)return;c.channels.push({id:uid(),name:n,unread:0,topic:'جديد'});save();render();toast('أُنشئت القناة #'+n,'ok')">${I("plus","i s")} إنشاء قناة</button></div>`:""}
      ${sub==="members"?`<div class="pad">
        <div class="chiprow">${[["all","الكل "+c.members],["online","متصل "+c.online],["admins","الإدارة"],["friends","أصدقائي"]].map(([k,l],i)=>`<button class="chip ${i===0?'on':''}" onclick="$$(this.parentNode).forEach(x=>x.classList.remove('on'));this.classList.add('on');toast('تصفية: ${l}','info')">${l}</button>`).join("")}</div>
        <div class="col">${(S.users||[]).slice(0,6).map((x,i)=>`<div class="lstrow"><button onclick="openProfile('${x.id}')">${av(x,42)}</button>
          <div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(x.name)}</span>${vbadge(x)}${i<2?`<span class="badge b-gold">${i===0?"قائد":"نائب"}</span>`:""}</div><div class="tiny fnt">${esc(x.role)} · مستوى ${x.level}</div></div>
          <button class="btn btn-primary btn-xs" onclick="startChat('${x.id}')">${I("chat","i s")}</button></div>`).join("")}
          <div class="lstrow" style="opacity:.65"><span class="ico-tile" style="background:var(--surface3)">${I("users","i s")}</span><div class="g1"><div class="b xs">+ ${nfmt(Math.max(0,c.members-6))} عضو آخر</div><div class="tiny fnt">اضغط لعرض القائمة الكاملة</div></div>
          <button class="btn btn-sec btn-xs" onclick="go('communityDetail',{id:'${c.id}',sub:'members'})">عرض الكل</button></div></div></div>`:""}
      ${sub==="about"?`<div class="pad col">
        <div class="art-bg" style="--c1:${c.c1};--c2:${c.c2};height:120px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff">${IF(c.icon,"xxl")}</div>
        <div class="card" style="padding:13px"><div class="bb">${esc(c.name)}</div><div class="xs mut" style="margin-top:6px">${esc(c.desc)}</div>
          <div class="grid4" style="margin-top:12px">${[["users",nfmt(c.members),"عضو"],["radio",c.online,"متصل"],["msgsq",(c.messages||[]).length,"رسالة"],["hash",(c.channels||[]).length,"قناة"]].map(([ic,v,l])=>`<div class="stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div></div>
        <div class="card" style="padding:13px"><div class="b sm">${I("shield","i s")} القوانين</div>
          <ol class="xs mut" style="margin:8px 18px 0"><li>الاحترام المتبادل بين الأعضاء</li><li>ممنوع السبويلر بدون تحذير</li><li>لا إعلانات خارج قناة الإعلانات</li><li>المحتوى المخالف يؤدي للحظر</li></ol></div>
        <div class="card" style="padding:13px"><div class="b sm">${I("crown","i s")} الإدارة</div>
          <div class="col" style="margin-top:8px">${(S.users||[]).slice(0,3).map(x=>`<div class="row"><span>${av(x,30)}</span><div class="g1"><div class="b tiny">${esc(x.name)}</div><div class="tiny fnt">${esc(x.role)}</div></div><button class="btn btn-sec btn-xs" onclick="startChat('${x.id}')">مراسلة</button></div>`).join("")}</div></div>
        ${c.joined?`<button class="btn btn-danger" onclick="leaveCommunity('${c.id}')">${I("logout","i s")} مغادرة المجتمع</button>`:""}</div>`:""}
      ${sub==="events"?`<div class="pad col">
        ${[{t:"مشاهدة جماعية: الحلقة ١٢",d:"الخميس ٩ مساءً",ic:"tv",n:42},{t:"مسابقة أفضل رسم",d:"ينتهي بعد ٣ أيام",ic:"palette",n:88},{t:"نقاش فصل المانجا الجديد",d:"غداً ٨ مساءً",ic:"book",n:31},{t:"ليلة أسئلة وأجوبة مع الإدارة",d:"الجمعة ١٠ مساءً",ic:"help",n:56}].map((e,i)=>`
          <div class="card" style="padding:12px"><div class="row" style="gap:10px">
            <span class="ico-tile" style="background:var(--grad-gold)">${I(e.ic,"i s")}</span>
            <div class="g1"><div class="b xs">${e.t}</div><div class="tiny fnt">${I("clock","i s")} ${e.d} · ${e.n} مهتم</div></div></div>
            <div class="row" style="gap:7px;margin-top:10px">
              <button class="btn btn-primary btn-xs g1" onclick="eventBtn(this)">${I("calendar","i s")} اهتمام</button>
              <button class="btn btn-sec btn-xs" onclick="shareEvent('${e.t}','${e.d}')">${I("share","i s")}</button></div></div>`).join("")}
        ${canMod()?`<button class="btn btn-primary" onclick="go('createEvent')">${I("plus","i s")} إنشاء فعالية</button>`:`<div class="tiny fnt mut">إنشاء الفعاليات للمشرفين فقط</div>`}</div>`:""}
      ${sub==="quests"?`<div class="pad col">
        <div class="card" style="padding:13px;background:linear-gradient(135deg,rgba(245,158,11,.12),transparent)">
          <div class="rowb"><div><div class="b sm">${I("shield","i s")} مهام النقابة الأسبوعية</div><div class="tiny fnt">تنتهي بعد ٤ أيام · ${nfmt(1240)} نقطة متاحة</div></div><span class="badge b-gold">رتبتك: ${esc(c.rank)}</span></div>
          <div class="col" style="margin-top:11px">${[["شارك في ٥ نقاشات",5,120],["ادعُ عضواً جديداً",1,300],["احضر فعالية",1,150],["انشر ميديا واحدة",3,90]].map(([t,m,r],qi)=>{const p=Math.min(m,strHash(c.id+"q"+qi)%(m+1));const done=!!(S.gqDone||{})[c.id+qi];return `
            <div class="row" style="gap:9px"><span class="ico-tile" style="width:28px;height:28px;border-radius:9px;background:var(--surface3);color:var(--gold)">${I("target","i s")}</span>
              <div class="g1"><div class="tiny b">${t}</div><div class="bar" style="height:4px;margin-top:3px"><i style="width:${p/m*100}%;background:var(--grad-gold)"></i></div></div>
              <button class="badge ${done?'b-gray':p>=m?'b-emerald':'b-gold'} mono" onclick="claimGuildQuest('${c.id}',${qi},${m},${r})">${done?"مُستلمة":p+"/"+m+" · +"+r}</button></div>`}).join("")}</div></div>
        <div class="card" style="padding:13px"><div class="b sm">${I("trophy","i s")} لوحة شرف النقابة</div>
          <div class="col" style="margin-top:9px">${(S.users||[]).slice(0,5).map((x,i)=>`<div class="row" style="gap:9px"><span class="badge ${i===0?'b-gold':i===1?'b-gray':'b-gray'} mono" style="width:24px;justify-content:center">${i+1}</span><span>${av(x,30)}</span><div class="g1"><div class="b tiny">${esc(x.name)}</div><div class="tiny fnt">${esc(x.role)}</div></div><span class="badge b-red mono">${nfmt(800+strHash(x.id+c.id)%8200)} نقطة</span></div>`).join("")}</div></div></div>`:""}
      ${sub==="treasury"?`<div class="pad col">
        <div class="card" style="padding:14px;background:linear-gradient(135deg,rgba(245,158,11,.14),transparent)">
          <div class="rowb"><div><div class="b sm">${I("wallet","i s")} خزينة النقابة</div><div class="tiny fnt">رصيد مشترك يموّل الفعاليات والمكافآت</div></div><span class="badge b-gold mono">${nfmt(c.treasury||2500)} عملة</span></div>
          <div class="grid3" style="margin-top:11px">${[100,500,1000].map(a=>`<button class="btn btn-sec btn-sm" onclick="guildDonate('${c.id}',${a})">${I("coins","i s")} تبرّع ${a}</button>`).join("")}</div></div>
        <div class="card" style="padding:13px"><div class="b sm">${I("list","i s")} سجل الخزينة</div>
          <div class="col" style="margin-top:8px">${(c.tlog||[{amt:2500,at:now()-864e5,by:"رأس المال التأسيسي"}]).slice(0,6).map(l=>`<div class="rowb" style="padding:6px 2px;border-bottom:1px solid var(--line)"><span class="tiny fnt g1" style="text-align:right">${esc(l.by||S.me.name)}</span><span class="xs b mono" style="color:var(--gold)">+${nfmt(l.amt)}</span><span class="tiny fnt">${ago(l.at)}</span></div>`).join("")}</div></div></div>`:""}
    </div>
  </div>`;
};
function joinCommunity(id){const c=(S.communities||[]).find(x=>x.id===id);
  if(c.joinMode==="بالطلب"){S.joinReqs=S.joinReqs||[];if(!S.joinReqs.some(r=>r.kind==="guild"&&r.id===id&&r.uid==="me")){S.joinReqs.push({kind:"guild",id:id,uid:"me",at:now()});save();toast("نقابة مغلقة: أُرسل طلب انضمام للقائد ","info");snd("send")}else toast("طلبك قيد المراجعة ","info");render();return}
  c.joined=true;c.rank="عضو";c.members++;celebrate("انضممت إلى "+c.name+" ");save();render()}
function sendComMsg(id){const c=(S.communities||[]).find(x=>x.id===id);const i=$("#cinp");if(!i)return;const t=(i.value||"").trim();if(!t)return;c.messages.push({id:uid(),from:"me",text:t,at:now()});i.value="";snd("send");questProgress("q4");addXP(3);save();
 const b=$("#cmsgs");if(b){b.insertAdjacentHTML("beforeend",`<div class="msg them" style="max-width:88%"><div class="row" style="gap:5px;margin-bottom:3px">${av(S.me,18)}<span class="tiny b" style="color:var(--accent)">أنت</span></div>${esc(t)}<span class="tm">${hhmm(now())}</span></div>`);b.scrollTop=b.scrollHeight}}
PAGES.communityChannel=()=>{
  const c=(S.communities||[]).find(x=>x.id===S.params.id);if(!c){setNav(false);setHdr(backHdr("القناة",""));return emptyState("users","المجتمع غير موجود","")}const ch=((c&&c.channels)||[]).find(x=>x.id===S.params.ch);if(!ch)return emptyState("hash","القناة غير موجودة","");
  ch.unread=0;
  if(!ch.messages){ch.messages=[];const mem=[];
    ch.messages.push({id:uid(),uid:mem[0].id,text:"أهلاً في #"+ch.name+" — قناة "+(ch.topic||"النقاش")+" ",at:now()-72e5});
    ch.messages.push({id:uid(),uid:mem[1].id,text:"وش أفضل أنمي هذا الموسم؟",at:now()-36e5});
    ch.messages.push({id:uid(),uid:"me",text:"فريـرن بدون منافس ",at:now()-18e5});
    ch.messages.push({id:uid(),uid:mem[2].id,text:"موافق! الرسم خيالي",at:now()-15e5})}
  save();setNav(false);
  setHdr(`<div style="display:flex;align-items:center;gap:9px;width:100%"><button class="iconbtn" onclick="go('communityDetail',{id:'${c.id}',sub:'channels'})">${I("back")}</button>
    <div class="g1"><div class="b sm">${I("hash","i s")} ${esc(ch.name)}</div><div class="tiny fnt">${esc(c.name)} · ${esc(ch.topic)} · ${(ch.messages||[]).length} رسالة</div></div>
    <button class="iconbtn" onclick="toggleChPin('${c.id}','${ch.id}')">${I("pin")}</button></div>`);
  return `<div style="display:flex;flex-direction:column;height:100%">
    <div class="chatbody no-sb" id="chbody">${(ch.messages||[]).map(m=>chRowMsg(m)).join("")}</div>
    <div class="composer"><button class="iconbtn" onclick="openSheet('attachSheet')" aria-label="إرفاق">${I("plus")}</button>
      <textarea id="chin" rows="1" placeholder="رسالة في #${esc(ch.name)}" oninput="this.style.height='auto';this.style.height=Math.min(96,this.scrollHeight)+'px'" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChMsg('${c.id}','${ch.id}')}"></textarea>
      <button class="iconbtn" style="background:var(--grad-fire);color:#fff;border:none" onclick="sendChMsg('${c.id}','${ch.id}')" aria-label="إرسال">${I("send","i s")}</button></div>
  </div>`;
};

/* ===== v3: قنوات المجتمعات كانت تعرض كل شيء كنص عادي =====
   الأصل: m.type==="share" ? shareCardHTML : linkify(m.text)
   أي استطلاع/صورة/فيديو/صوت/ملف/ملصق كان يظهر نصاً فقط. */
function chMsgBody(m,me){
  if(m.type==="share")   return shareCardHTML(m,me);
  if(m.type==="cpoll")   return chPollBox(m);
  if(m.type==="image")   return `<img src="${m.src}" alt="صورة" style="max-width:230px;border-radius:12px;display:block;cursor:zoom-in" onclick="openImg('${m.src}')">${m.cap?`<div class="tiny" style="margin-top:4px">${esc(m.cap)}</div>`:""}`;
  if(m.type==="video")   return `<video src="${m.src}" controls playsinline style="max-width:230px;border-radius:12px;display:block"></video>`;
  if(m.type==="voice")   return `<div class="row" style="gap:7px;align-items:center"><span class="ico-tile" style="width:30px;height:30px;border-radius:50%;background:var(--grad-emerald);color:#fff">${I("mic","i s")}</span><audio src="${m.src||""}" controls style="height:30px;max-width:170px"></audio></div>`;
  if(m.type==="file")    return `<button class="lstrow" style="gap:8px;width:100%;text-align:start" onclick="dlFile('${m.src||""}','${esc(m.name||"ملف")}')">${I("file","i s")}<span class="g1 tiny b">${esc(m.name||"ملف")}</span>${I("download","i s")}</button>`;
  if(m.type==="sticker") return `<span style="font-size:44px;line-height:1;display:block">${m.ic?IC(m.ic,"xl"):"🎴"}</span>`;
  if(m.type==="contact") return `<div class="card2 row" style="gap:8px;padding:8px 10px">${I("user","i s")}<span class="tiny b">${esc(m.name||"جهة اتصال")}</span></div>`;
  return linkify(m.text);
}
/* صندوق استطلاع لقنوات المجتمعات (نفس منطق التصويت في المحادثات) */
function chPollBox(m){
  const tot=(m.votes||[]).reduce((a,b)=>a+b,0)||0;
  return `<div style="min-width:210px">
    <div class="b xs" style="margin-bottom:7px">${I("barchart","i s")} ${esc(m.q||"استطلاع")}</div>
    ${(m.opts||[]).map((o,i)=>{
      const v=(m.votes||[])[i]||0, pc=tot?Math.round(v*100/tot):0, mine=m.me===i;
      return `<button class="pollopt" onclick="voteChatPoll('${m.id}',${i})" style="position:relative;width:100%;text-align:start;padding:7px 10px;margin-bottom:5px;border-radius:9px;border:1px solid ${mine?"var(--accent)":"var(--line2)"};background:var(--surface2);overflow:hidden">
        <span style="position:absolute;inset-inline-start:0;top:0;bottom:0;width:${pc}%;background:${mine?"rgba(34,211,238,.24)":"rgba(255,255,255,.07)"};transition:width .45s cubic-bezier(.4,0,.2,1)"></span>
        <span style="position:relative;display:flex;justify-content:space-between;gap:8px">
          <span class="tiny b">${mine?"● ":""}${esc(o)}</span><span class="tiny mut">${pc}%</span></span></button>`}).join("")}
    <div class="tiny mut">${tot} صوت · اضغط للتصويت</div></div>`;
}
function openImg(src){ if(typeof lightbox==="function")return lightbox(src); const w=window.open(); if(w)w.document.write('<img src="'+src+'" style="max-width:100%">'); }
function dlFile(src,name){ if(!src){toast("الملف غير متاح","err");return} const a=document.createElement("a"); a.href=src; a.download=name||"file"; a.click(); }

function chRowMsg(m){const me=m.uid==="me";const uu=me?S.me:u(m.uid);return `<div class="msg ${me?"me":"them"}" id="m_${m.id}" style="max-width:88%;position:relative"><div class="row" style="gap:5px;margin-bottom:3px">${av(uu,18)}<span class="tiny b" style="color:${me?"#fff":"var(--accent)"}">${esc(uu.name)}</span></div>${chMsgBody(m,me)}<span class="tm">${hhmm(m.at)}</span></div>`}
function sendChMsg(cid,chid){const c=(S.communities||[]).find(x=>x.id===cid);const ch=c&&(((c&&c.channels)||[]).find(x=>x.id===chid));const i=$("#chin");if(!ch||!i)return;const t=(i.value||"").trim();if(!t)return;i.value="";i.style.height="auto";ch.messages=ch.messages||[];const newMsg={id:uid(),uid:window.auth&&window.auth.currentUser?window.auth.currentUser.uid:"me",text:t,at:now()};ch.messages.push(newMsg);save();snd("send");questProgress("q4");const b=$("#chbody");if(b){b.insertAdjacentHTML("beforeend",chRowMsg(newMsg));b.scrollTop=b.scrollHeight}
  if(window.auth&&window.auth.currentUser&&window.db){
    window.setDoc(window.doc(window.db,"communities",cid),{channels:c.channels,updatedAt:now()},{merge:true}).catch(e=>console.error(e));
  }
}
function eventBtn(el){const on=el.classList.toggle("btn-sec");el.innerHTML=on?I("check","i s")+" سأحضر":I("calendar","i s")+" اهتمام";toast(on?"تم تأكيد حضورك ":"أُضيف إلى اهتماماتك","ok");snd("success")}

/* ============================================================
   10) البروفايل الشخصي + البروفايل العام
   ============================================================ */
PAGES.profile=()=>{
  S.activeTab="profile";const m=S.me;updateAchievements();
  setHdr(`<div style="display:flex;align-items:center;gap:8px;width:100%">
    <button class="iconbtn" onclick="go('home')">${I("back")}</button>
    <div class="ttl">ملفي الشخصي<small>@${esc(m.username)}</small></div>
    ${coinChip()}<button class="iconbtn" onclick="go('editProfile')">${I("edit")}</button>
    <button class="iconbtn" onclick="openSheet('settingsSheet')">${I("settings")}</button></div>`);
  setNav(true);
  const t=S.profileTab||"posts";
  const tabs=[["posts",T("منشوراتي"),"msgsq",S.posts.filter(p=>p.authorId==="me").length],["reels",T("ريلز"),"clapper",(S.reels||[]).length],["saved",T("المحفوظات"),"bookmark",(m.saved||[]).length],["guilds","نقاباتي","shield",S.communities.filter(c=>c.joined).length],["achievements","الإنجازات","trophy",S.achievements.filter(a=>a.got).length],["inventory","حقيبتي","gift",(m.inventory||[]).length],["analytics","التحليلات","chart",0]];
  return `<div style="position:relative;overflow:hidden">
    ${fxOverlay()}
    ${coverBlock()}
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(255,255,255,.05) 0 2px,transparent 2px 14px),linear-gradient(180deg,transparent 35%,rgba(10,10,10,.9))"></div>
      <div class="row" style="gap:7px;position:absolute;top:10px;left:10px;right:10px;z-index:3">
        <button class="btn btn-glass btn-xs" onclick="changeCover()">${I("camera","i s")} الغلاف</button>
        <span class="g1"></span>
        <button class="btn btn-glass btn-xs" onclick="openSheet('shareProfile')">${I("share","i s")} مشاركة</button>
        <button class="btn btn-glass btn-xs" onclick="go('qrCard')">${I("qr","i s")} بطاقتي</button>
      </div>
    </div>
    <div class="pad" style="padding-top:0;margin-top:-52px;position:relative;z-index:4">
      <div class="rowb">
        <div style="position:relative">${av(m,86,true)}
          <button class="iconbtn" style="position:absolute;bottom:0;left:0;width:28px;height:28px;background:var(--grad-fire);color:#fff;border:none" onclick="changeAvatar()">${I("camera","i s")}</button>
          <span style="position:absolute;bottom:-2px;right:-2px;width:16px;height:16px;border-radius:50%;background:var(--emerald);border:3px solid var(--bg)"></span></div>
        <div style="display:flex;gap:7px">
          <button class="btn btn-primary btn-sm" onclick="go('editProfile')">${I("edit","i s")} تعديل</button>
          <button class="btn btn-sec btn-sm" onclick="go('levels')">${I("award","i s")}</button>
          <button class="btn btn-sec btn-sm" onclick="go('myStories')">${I("clock","i s")}</button>
        </div>
      </div>
      <div class="row" style="gap:6px;margin-top:10px;flex-wrap:wrap">
        <span class="bb" style="font-size:17px">${esc(m.name)}</span>${m.isVerified?`<span class="badge b-purple">${I("check","i s")} موثّق</span>`:""}
        ${lvlBadge(m)}${roleBadge(m)}
        ${m.equippedTitle?`<span class="badge b-gold">${I("crown","i s")} ${esc(m.equippedTitle)}</span>`:""}
      </div>
      <div class="tiny fnt mono">@${esc(m.username)} · ${esc(m.email)}</div>
      <div class="xs mut" style="margin-top:7px">${esc(m.bio)}</div>
      ${(S.highlights||[]).length?`<div class="row" style="gap:10px;overflow-x:auto;margin-top:11px;padding-bottom:4px">${(S.highlights||[]).map(hh=>`<button class="col center" style="gap:4px;flex-shrink:0;width:64px" onclick="go('storyViewer',{i:${hh.ii||0},sid:'${hh.sid}'})"><span style="width:56px;height:56px;border-radius:50%;padding:2px;background:var(--grad-gold);display:flex"><span style="width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,${hh.c1||"#7F1D1D"},${hh.c2||"#EA580C"});display:flex;align-items:center;justify-content:center;color:#fff">${I("star","i s")}</span></span><span class="tiny b" style="font-size:9px">${esc((hh.t||"لحظة").slice(0,10))}</span></button>`).join("")}<button class="col center" style="gap:4px;flex-shrink:0;width:64px" onclick="go('myStories')"><span style="width:56px;height:56px;border-radius:50%;border:2px dashed var(--line2);display:flex;align-items:center;justify-content:center;color:var(--muted)">${I("plus","i s")}</span><span class="tiny b mut" style="font-size:9px">قصصي</span></button></div>`:""}
      ${(m.badges||[]).length?`<div class="row" style="gap:8px;margin-top:10px;align-items:center">${(m.badges||[]).slice(0,4).map(bid=>{const b=(S.badgesList||[]).find(x=>x.id===bid);return b?BDG(b.ic,b.r,30):""}).join("")}<button class="tiny b mut" style="background:none;border:none" onclick="go('levels',{tab:'badges'})">+${(m.badges||[]).length} شارة ${I("fwd","i s")}</button></div>`:""}
      <div class="row" style="gap:7px;margin-top:9px;flex-wrap:wrap">
        <span class="pill">${I("calendar","i s")} انضم ${new Date(m.joined).toLocaleDateString("ar")}</span>
        <span class="pill">${I("flame","i s")} سمعة <b class="mono" style="color:var(--accent)">${nfmt(m.reputation)}</b></span>
        <span class="pill" style="color:var(--emerald)"> متصل</span>
        ${m.loc?`<span class="pill">${I("map","i s")} ${esc(m.loc)}</span>`:""}${m.site?`<span class="pill">${I("link","i s")} ${esc(m.site)}</span>`:""}${m.favAnimeName?`<span class="pill">${I("film","i s")} ${esc(m.favAnimeName)}</span>`:""}
      </div>
      <div class="grid4" style="margin-top:12px">
        ${[["posts",S.posts.filter(p=>p.authorId==="me").length,"منشور"],["followers",nfmt(m.followers),"متابع"],["following",nfmt(m.following),"يتابع"],["star",m.stars,"نجمة"]].map(([k,v,l])=>`
          <button class="card2 stat" onclick="${k==='followers'||k==='following'?`go('followers',{type:'${k}',id:'me'})`:"statTap('"+l+"',"+v+")"}"><b class="mono">${v}</b><span>${l}</span></button>`).join("")}
      </div>
      <div class="card2" style="padding:11px;margin-top:11px">
        <div class="rowb"><span class="tiny b">التقدم للمستوى ${m.level+1}</span><span class="badge b-gold mono">${nfmt(m.xp)} / ${nfmt(m.xpNext)} XP</span></div>
        <div class="bar" style="margin-top:6px"><i style="width:${Math.min(100,m.xp/m.xpNext*100)}%"></i></div>
        <div class="row" style="gap:7px;margin-top:9px">
          <button class="btn btn-gold btn-xs g1" onclick="go('economy')">${I("wallet","i s")} المحفظة: ${nfmt(S.coins)}</button>
          <button class="btn btn-sec btn-xs g1" onclick="go('otakuStats')">${I("barchart","i s")} إحصائياتي</button>
        </div>
      </div>
      <div class="card2" style="padding:11px;margin-top:11px">
        <div class="b xs" style="margin-bottom:8px">${I("folder","i s")} إدارة محتواك</div>
        <div class="grid3" style="gap:7px">
          <button class="btn btn-sec btn-xs" onclick="go('myPosts')">${I("msgsq","i s")} منشوراتي</button>
          <button class="btn btn-sec btn-xs" onclick="go('hiddenPosts')">${I("eyeoff","i s")} المخفية</button>
          <button class="btn btn-sec btn-xs" onclick="go('archivedPosts')">${I("archive","i s")} المؤرشفة</button>
          <button class="btn btn-sec btn-xs" onclick="go('myReplies')">${I("chat","i s")} ردودي</button>
          <button class="btn btn-sec btn-xs" onclick="go('savedArticles')">${I("bookmark","i s")} محفوظاتي</button>
          <button class="btn btn-sec btn-xs" onclick="go('watchHistory')">${I("clock","i s")} سجل المشاهدة</button>
        </div>
        <div style="margin-top:10px">
          <button class="btn btn-primary" style="width:100%" onclick="go('workspace')">${I("lock","i s")} مساحة العمل الخاصة بالأفكار</button>
        </div>
      </div>
      <div class="seg" style="margin-top:14px">${tabs.map(([k,l,ic,n])=>`<button class="${t===k?'on':''}" onclick="S.profileTab='${k}';save();render();snd('tap')">${I(ic,"i s")}<span>${l}</span>${n?`<i class="mono">${n}</i>`:""}</button>`).join("")}</div>
      <div style="margin-top:12px">${profileTab(t)}</div>
    </div>
  </div>`;
};
function profileTab(t){
  const m=S.me;
  if(t==="posts"){const ps=S.posts.filter(p=>p.authorId==="me");return ps.length?ps.map(p=>postCard(p)).join(""):emptyState("msgsq","لا منشورات بعد","اضغط + لإنشاء أول منشور")}
  if(t==="reels")return `<div class="grid2">${(S.reels||[]).slice(0,4).map(r=>reelCard(r,"100%")).join("")}</div>`;
  if(t==="saved"){const ps=S.posts.filter(p=>m.saved.includes(p.id));return ps.length?ps.map(p=>postCard(p)).join(""):emptyState("bookmark","لا محفوظات","احفظ المنشورات بزر ")}
  if(t==="guilds")return `<div class="col">${S.communities.filter(c=>c.joined).map(c=>communityRow(c)).join("")||emptyState("shield","لست في أي نقابة","انضم من تبويب الدردشة")}</div>`;
  if(t==="achievements")return `<div class="grid2">${S.achievements.map(a=>`
    <div class="card2 center" style="padding:14px 8px;opacity:${a.got?1:.42}">
      <span style="width:46px;height:46px;border-radius:50%;background:${a.got?'var(--grad-gold)':'var(--surface3)'};display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:#fff">${I(a.ic,"l")}</span>
      <div class="b xs">${a.n}</div><div class="tiny fnt">${a.d}</div>
      ${a.got?'<span class="badge b-emerald" style="margin-top:6px">مكتمل </span>':'<span class="badge b-gray" style="margin-top:6px">مقفل</span>'}</div>`).join("")}</div>`;
  if(t==="inventory")return `<div class="col">
    ${m.inventory.map(i=>`<div class="lstrow"><span class="ico-tile" style="background:${{legendary:'var(--grad-gold)',epic:'var(--grad-purple)',rare:'var(--grad-cyan)',common:'var(--surface3)'}[i.r]};color:#fff">${I(i.ic,"i s")}</span>
      <div class="g1"><div class="row" style="gap:5px"><span class="b xs">${i.n}</span><span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[i.r]}">${i.r}</span></div><div class="tiny fnt">نوع: ${i.type}</div></div>
      <button class="btn btn-primary btn-xs" onclick="equipItem('${i.id}')">تجهيز</button>
      <button class="btn btn-sec btn-xs" onclick="openSheet('itemMenu','${i.id}')">${I("more","i s")}</button></div>`).join("")}
    <button class="btn btn-gold" onclick="go('economy')">${I("coins","i s")} اشترِ المزيد من المتجر</button></div>`;
  if(t==="analytics"){const mine=S.posts.filter(p=>p.authorId==="me");
    const views=mine.reduce((a,p)=>a+(p.views||0),0),likes=mine.reduce((a,p)=>a+(p.likes||0),0),cmts=mine.reduce((a,p)=>a+(p.comments||[]).length,0),shr=mine.reduce((a,p)=>a+(p.shares||0),0);
    const d0=new Date();d0.setHours(0,0,0,0);const b0=d0.getTime();
    const series=[...Array(7)].map((_,i)=>mine.filter(p=>p.createdAt>=b0-(6-i)*864e5&&p.createdAt<b0-(5-i)*864e5).length);
    const reach=(mine||[]).slice(0,7).reverse().map(p=>p.views||0);
    const buckets=[["٩ ص",9],["١٢ م",12],["٦ م",18],["٩ م",21]].map(([hh,hr])=>[hh,mine.filter(p=>{const hH=new Date(p.createdAt).getHours();return hH>=hr-2&&hH<=hr+1}).reduce((a,p)=>a+(p.likes||0),0)]);
    const bmx=Math.max(...buckets.map(x=>x[1]))||1;
    return `<div class="col">
    <div class="card" style="padding:13px"><div class="b sm">${I("trend","i s")} منشوراتك آخر ٧ أيام (${series.reduce((a,b)=>a+b,0)})</div>${svgChart(series)}</div>
    <div class="card" style="padding:13px"><div class="b sm">${I("eye","i s")} وصول آخر منشوراتك (مشاهدات حقيقية)</div>${svgChart(reach.length?reach:[0,0,0])}</div>
    <div class="grid2">${[["eye",nfmt(views),"مشاهدة إجمالية"],["heart",nfmt(likes),"إعجاب"],["msgsq",nfmt(cmts),"تعليق"],["share",nfmt(shr),"مشاركة"]].map(([ic,v,l])=>`<div class="card2 stat">${I(ic,"i s")}<b class="mono">${v}</b><span>${l}</span></div>`).join("")}</div>
    <div class="card" style="padding:13px"><div class="b sm">${I("clock","i s")} أفضل وقت للنشر (حسب تفاعل منشوراتك)</div>
      <div class="grid4" style="margin-top:9px">${buckets.map(([lb,v])=>`<div class="center"><div class="bar" style="height:46px;width:100%;display:flex;align-items:flex-end"><i style="height:${Math.max(8,v/bmx*100)}%;background:var(--grad-fire);width:100%;border-radius:6px"></i></div><div class="tiny fnt" style="margin-top:4px">${lb}</div><div class="tiny mono b">${v}</div></div>`).join("")}</div></div>
    ${mine.length?"":`<div class="tiny fnt center" style="padding:8px">انشر أولاً لتظهر إحصاءاتك الحقيقية هنا</div>`}
  </div>`;}
  return "";
}
function svgChart(d){
  d=(d&&d.length?d:[0]).slice();if(d.length===1)d.push(d[0]);
  const w=300,h=68,mx=Math.max(...d)||1,pts=d.map((v,i)=>[i*(w/(d.length-1)),h-(v/mx)*(h-8)-4]);
  const path=pts.map((p,i)=>(i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1)).join(" ");
  const area=path+` L ${w} ${h} L 0 ${h} Z`;
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%;height:${h}px;margin-top:8px">
    <defs><linearGradient id="cg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#22D3EE" stop-opacity=".55"/><stop offset="1" stop-color="#22D3EE" stop-opacity="0"/></linearGradient></defs>
    <path d="${area}" fill="url(#cg)"/><path d="${path}" fill="none" stroke="#FF7A00" stroke-width="2.2" stroke-linecap="round"/>
    ${pts.map(p=>`<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="2.6" fill="#22D3EE" stroke="#0A0A0A" stroke-width="1.4"/>`).join("")}</svg>`;
}
function equipItem(id){const i=((S.me&&S.me.inventory)||[]).find(x=>x.id===id);if(!i)return;
  if(i.type==="title"){equipTitle(i.n)}
  else if(i.type==="frame"){const f=(S.frames||[]).find(f2=>f2.n===i.n||f2.id===i.frameId);if(f){if(!S.ownedFrames.includes(f.id))S.ownedFrames.push(f.id);S.me.frame=f.id;toast("جهّزت إطار "+f.n+" على صورتك ","ok")}else toast("لا إطار مطابق لهذه العنصر ","err")}
  else if(i.type==="badge"){const b=(S.badgesList||[]).find(b2=>b2.n===i.n);if(b&&!S.me.badges.includes(b.id)){S.me.badges.push(b.id);toast("أُضيفت شارة "+b.n+" إلى ملفك ","ok")}else toast("الشارة مضافة مسبقاً أو غير مطابقة ","info")}
  else if(i.type==="chest"){const win=150+Math.floor(Math.random()*350);S.coins+=win;S.me.coins=S.coins;S.me.inventory=S.me.inventory.filter(x=>x.id!==id);celebrate("فتحت الصندوق وربحت "+win+" عملة ")}
  else toast("جهّزت "+i.n+" ","ok");
  save();render()}
function updateAchievements(){const m=S.me;const mine=S.posts.filter(p=>p.authorId==="me");
  const cond={ac1:mine.length>0,ac2:(m.badges||[]).length>=5,ac3:mine.reduce((a,p)=>a+(p.views||0),0)>=1e6,ac4:S.communities.some(c=>c.joined&&c.rank==="المؤسس"),ac6:S.coins>=10000};
  let nw=false;(S.achievements||[]).forEach(a=>{const c=cond[a.id];if(c===true&&!a.got){a.got=true;nw=true;setTimeout(()=>celebrate("إنجاز جديد: "+a.n+" "),50)}});
  if(nw)save()}
function archivePost(id){(S.archived=S.archived||[]);if(!S.archived.includes(id))S.archived.push(id);save();render();snd("tap");toast("أُرشف المنشور في المستودع ","ok",()=>{S.archived=S.archived.filter(x=>x!==id);save();render();toast("أُعيد من الأرشيف ","ok")})}
function unarchivePost(id){S.archived=(S.archived||[]).filter(x=>x!==id);save();render();toast("أُخرج المنشور من الأرشيف ","ok")}
function unhidePost(id){S.hidden=(S.hidden||[]).filter(x=>x!==id);save();render();toast("أُعيد إظهار المنشور ","ok")}
function pickFrame(fid){const f=(S.frames||[]).find(x=>x.id===fid);if(!f)return;
  if(S.ownedFrames.includes(fid)){S.me.frame=S.me.frame===fid?null:fid;save();render();snd("tap");toast(S.me.frame?"إطار "+f.n+" مُفعّل ":"أُزيل الإطار من صورتك ","ok")}
  else if(S.coins>=f.p){S.coins-=f.p;S.me.coins=S.coins;S.ownedFrames.push(fid);S.me.frame=fid;save();render();celebrate("اشتريت إطار «"+f.n+"» وجُهّز فوراً ")}
  else{snd("error");toast("رصيدك غير كافٍ ("+S.coins+"/"+f.p+") — افتح المتجر ","err");go("economy")}}
function scrollToPosts(){$("#page").scrollTo({top:340,behavior:"smooth"})}
function filterFollow(q){$$(".lstrow[data-nm]").forEach(r=>{r.style.display=(!q||(r.getAttribute("data-nm")||"").toLowerCase().includes(q.toLowerCase()))?"":"none"})}
function exportStats(){const ok=dl("animeblack-stats.json",JSON.stringify({app:"AnimeBlack",name:S.me.name,username:S.me.username,level:S.me.level,watchHours:S.me.watchHours,episodes:S.me.episodes,mangaChapters:S.me.mangaChapters,reputation:S.me.reputation,posts:S.posts.filter(p=>p.authorId==="me").length,followers:S.me.followers,coins:S.coins,exportedAt:new Date().toISOString()},null,2));toast(ok?"صُدّرت إحصائياتك كملف JSON حقيقي ":"تعذّر التصدير ",ok?"ok":"err")}
function saveOtakuCard(){try{const cv=document.createElement("canvas");cv.width=720;cv.height=420;const g=cv.getContext("2d");const gr=g.createLinearGradient(0,0,720,420);gr.addColorStop(0,"#1E1B4B");gr.addColorStop(1,"#7F1D1D");g.fillStyle=gr;g.fillRect(0,0,720,420);g.fillStyle="#fff";g.textAlign="center";g.font="bold 40px sans-serif";g.fillText("بطاقة الأوتاكو — أنمي بلاك",360,86);g.font="bold 36px sans-serif";g.fillText(S.me.name,360,152);g.font="24px monospace";g.fillStyle="#FFD700";g.fillText("@"+S.me.username+"  ·  LV "+S.me.level,360,196);g.fillStyle="#fff";g.font="26px sans-serif";g.fillText(S.me.episodes+" حلقة · "+S.me.watchHours+" ساعة · سمعة "+S.me.reputation,360,262);g.fillText("نجوم "+S.me.stars+" · عملة "+S.coins+" · متابعون "+S.me.followers,360,306);g.font="20px sans-serif";g.fillStyle="rgba(255,255,255,.72)";g.fillText(new Date().toLocaleDateString("ar"),360,378);const a=document.createElement("a");a.href=cv.toDataURL("image/png");a.download="animeblack-otaku-card.png";document.body.appendChild(a);a.click();a.remove();closeOvl();toast("حُفظت بطاقة الأوتاكو كصورة PNG حقيقية ","ok")}catch(e){toast("تعذّر الحفظ: "+String(e.message||e).slice(0,60),"err")}}
function shareProfileVia(net,id){const x=u(id||"me");const url="animeblack.app/@"+x.username;copyTxt("ملف "+x.name+" على أنمي بلاك: "+url);closeOvl();snd("success");toast("نُسخ رابط ملف "+x.name+" جاهزاً للصق في "+net+" ","ok")}
/* ===== v4: كان changeAvatar يمرّر capture="user" فيفتح الكاميرا الأمامية قسراً
   ولا يسمح باختيار صورة من المعرض إطلاقاً.
   الأصل: function changeAvatar(){pickFile("image/*","user",f=>{avUpload({files:[f]})})}
   الآن: نافذة تخيّرك بين المعرض والكاميرا. ===== */
function changeAvatar(){ openSheet("avatarSrcSheet"); }
function avatarFromGallery(){ closeOvl(); pickFile("image/*","",f=>{ avUpload({files:[f]}) }); }
function avatarFromCamera(){ closeOvl(); pickFile("image/*","user",f=>{ avUpload({files:[f]}) }); }

function changeCover(){window.__cv={img:S.me.cover||"",ratio:String(S.me.coverRatio||"169"),pos:(S.me.coverPos==null?50:S.me.coverPos)};openSheet("coverSheet")}


PAGES.editProfile=()=>{
  const m=S.me;setNav(false);
  setHdr(backHdr("تعديل المظهر المتقدم","الهوية الرقمية",`<button class="btn btn-primary btn-sm" onclick="saveProfile()">${I("save","i s")} حفظ</button>`));
  return `<div class="pad col">
    ${visualIdentityCard()}
    <div class="card" style="padding:14px;text-align:center">
      <div class="row center" style="justify-content:center;gap:13px">
        <div style="position:relative">${av(m,80,true)}<button class="iconbtn" style="position:absolute;bottom:0;left:0;width:28px;height:28px;background:var(--grad-fire);color:#fff;border:none" onclick="changeAvatar()">${I("camera","i s")}</button></div>
        <button class="btn btn-sec btn-sm" onclick="go('myStories')">${I("clock","i s")} قصصي</button>
        <button class="btn btn-sec btn-sm" onclick="changeCover()">${I("image","i s")} الغلاف</button>
      </div>
      ${(S.highlights||[]).length?`<div class="row" style="gap:10px;overflow-x:auto;margin-top:12px;padding-bottom:4px">${(S.highlights||[]).map(hh=>`<button class="col center" style="gap:4px;flex-shrink:0;width:64px" onclick="go('storyViewer',{i:${hh.ii||0},sid:'${hh.sid}'})"><span style="width:56px;height:56px;border-radius:50%;padding:2px;background:var(--grad-gold);display:flex"><span style="width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,${hh.c1||"#7F1D1D"},${hh.c2||"#EA580C"});display:flex;align-items:center;justify-content:center;color:#fff">${I("star","i s")}</span></span><span class="tiny b" style="font-size:9px">${esc((hh.t||"لحظة").slice(0,10))}</span></button>`).join("")}</div>`:""}
    <div class="grid3" style="margin-top:12px">${COVERS.map((c,ci)=>`<button class="chip" style="justify-content:center;padding:5px" onclick="applyCoverG(${ci})"><span style="display:block;width:100%;height:22px;border-radius:8px;background:linear-gradient(135deg,${c[0]},${c[1]})"></span><span class="tiny" style="margin-top:3px">${c[2]}</span></button>`).join("")}</div>
    </div>
    <div class="card" style="padding:14px">
      <div class="b sm" style="margin-bottom:11px">${I("user","i s")} البيانات الأساسية</div>
      <label class="lbl">الاسم الظاهر</label><input class="inp" id="ep_n" value="${esc(m.name)}">
      <div style="height:9px"></div><label class="lbl">اسم المستخدم</label>
      <div class="row" style="gap:7px"><span class="badge b-gray mono">@</span><input class="inp g1 mono" id="ep_u" value="${esc(m.username)}" oninput="checkUsername(this.value)"></div>
      <div class="tiny" id="un_chk" style="margin-top:5px"></div>
      <div style="height:9px"></div><label class="lbl">النبذة التعريفية</label><textarea class="inp" id="ep_b" rows="3">${esc(m.bio)}</textarea>
      <div style="height:9px"></div><div class="grid2">
        <div><label class="lbl">الموقع</label><input class="inp" id="ep_loc" value="${esc(m.loc||"اليمن · تعز")}"></div>
        <div><label class="lbl">الموقع الإلكتروني</label><input class="inp" dir="ltr" id="ep_web" value="${esc(m.site||"")}" placeholder="animeblack.app"></div>
        <div><label class="lbl">الأنمي المفضل</label><input class="inp" id="ep_fav" value="${esc(m.favAnimeName||"هجوم العمالقة")}"></div>
        <div><label class="lbl">الاستوديو المفضل</label><input class="inp" id="ep_stu" value="${esc(m.favStudio||"MAPPA")}"></div>
      </div>
    </div>
    <div class="card" style="padding:14px">
      <div class="rowb"><div class="b sm">${I("crown","i s")} اللقب المجهّز</div><button class="tiny b" style="color:var(--accent)" onclick="go('levels')">كل الألقاب</button></div>
      <div class="chiprow wrap" style="margin-top:9px">${m.titles.map(t=>`<button class="chip ${m.equippedTitle===t?'on':''}" onclick="S.me.equippedTitle='${t}';save();render();toast('اللقب: ${t}','ok')">${I("crown","i s")} ${t}</button>`).join("")}</div>
    </div>
    <div class="card" style="padding:14px">
      <div class="b sm">${I("palette","i s")} إطار الصورة الرمزية</div>
      <div class="grid4" style="margin-top:10px">${S.frames.map(f=>`
        <button class="card2 center" style="padding:11px 4px;border-color:${m.frame===f.id?'var(--accent)':'var(--line2)'}" onclick="pickFrame('${f.id}')">
          <span class="frame ${f.cls}" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center">${av({...m,frame:null},38)}</span>
          <span class="tiny b" style="display:block;margin-top:6px">${f.n}</span>
          <span class="badge b-${{legendary:'gold',epic:'purple',rare:'cyan',common:'gray'}[f.r]}" style="margin-top:3px">${S.ownedFrames.includes(f.id)?"مملوك ":nfmt(f.p)+" عملة"}</span></button>`).join("")}
      </div>
      <button class="btn btn-ghost btn-xs" style="margin-top:9px;width:100%" onclick="S.me.frame=null;save();render();toast('أُزيل الإطار','info')">${I("x","i s")} بدون إطار</button>
    </div>
    <div class="grid2"><button class="btn btn-primary" onclick="saveProfile()">${I("save","i s")} حفظ التغييرات</button><button class="btn btn-ghost" onclick="back()">${I("x","i s")} إلغاء</button></div>
  </div>`;
};
function saveProfile(){
  const n=$("#ep_n").value.trim(),un=$("#ep_u").value.trim(),b=$("#ep_b").value.trim();
  if(!n){toast("الاسم مطلوب","err");return}
  if(un.length<3){toast("اسم المستخدم قصير","err");return}
  S.me.name=n;S.me.username=un;S.me.bio=b;
  const _l=$("#ep_loc"),_w=$("#ep_web"),_f=$("#ep_fav"),_s=$("#ep_stu");
  if(_l)S.me.loc=_l.value.trim();if(_w)S.me.site=_w.value.trim();if(_f)S.me.favAnimeName=_f.value.trim();if(_s)S.me.favStudio=_s.value.trim();
  if(S.user)S.user={...S.me};
  if(window.auth&&window.auth.currentUser&&window.db){
    const uid=window.auth.currentUser.uid;
    const upd={name:n,username:un,bio:b};
    if(_l)upd.loc=_l.value.trim();if(_w)upd.site=_w.value.trim();if(_f)upd.favAnimeName=_f.value.trim();if(_s)upd.favStudio=_s.value.trim();
    window.setDoc(window.doc(window.db,"users",uid),upd,{merge:true}).catch(e=>console.error(e));
  }
  save();toast("تم حفظ ملفك الشخصي ","ok");snd("success");haptic("حفظ ناجح");setTimeout(()=>go("profile"),600);
}
PAGES.publicProfile=()=>{
  const tid = S.params.id;
  if(!tid || isMe(tid)){
    setTimeout(()=>go("profile",{},false),10);
    return "";
  }
  const x=u(tid);
  if(isMe(x.id) || isMe(x.uid)){
    setTimeout(()=>go("profile",{},false),10);
    return "";
  }
  setNav(false);
  setHdr(backHdr(x.name,"@"+x.username,`<button class="iconbtn" onclick="openSheet('pubProfileMenu','${x.id}')">${I("more")}</button>`));
  const ps=S.posts.filter(p=>p.authorId===x.id || (p.author && (p.author.id===x.id || p.author.uid===x.id)));
  return `<div>
    <div class="art-bg" style="--c1:${x.id==='u1'?'#7F1D1D':x.id==='u3'?'#14532D':'#1E1B4B'};--c2:${x.id==='u1'?'#EA580C':x.id==='u3'?'#4ADE80':'#6366F1'};height:126px"></div>
    <div class="pad" style="margin-top:-40px;position:relative">
      <div class="rowb"><div style="position:relative">${av(x,84,true)}${x.online?'<span style="position:absolute;bottom:2px;right:2px;width:16px;height:16px;border-radius:50%;background:var(--emerald);border:3px solid var(--bg)"></span>':""}</div>
        <div class="row" style="gap:6px">
          <button class="btn ${S.following.includes(x.id)?'btn-sec':'btn-primary'} btn-sm" onclick="follow('${x.id}')">${S.following.includes(x.id)?I("check","i s")+" يتابع":I("plus","i s")+" متابعة"}</button>
          <button class="btn btn-sec btn-sm" onclick="startChat('${x.id}')">${I("chat","i s")}</button>
        </div></div>
      <div class="row" style="gap:6px;margin-top:10px;flex-wrap:wrap"><span class="bb" style="font-size:17px">${esc(x.name)}</span>${vbadge(x)}${lvlBadge(x)}${roleBadge(x)}</div>
      <div class="tiny fnt mono">@${esc(x.username)}${x.loc?" · "+esc(x.loc):""}${x.favAnimeName?" · يحب "+esc(x.favAnimeName):""}</div>
      <div class="xs mut" style="margin-top:7px">${esc(x.bio)}</div>
      <div class="grid4" style="margin-top:12px">
        <button class="card2 stat" onclick="scrollToPosts()"><b class="mono">${ps.length}</b><span>منشور</span></button>
        <button class="card2 stat" onclick="go('followers',{type:'followers',id:'${x.id}'})"><b class="mono">${nfmt(x.followers)}</b><span>متابع</span></button>
        <button class="card2 stat" onclick="go('followers',{type:'following',id:'${x.id}'})"><b class="mono">${nfmt(x.following)}</b><span>يتابع</span></button>
        <button class="card2 stat" onclick="toast('مستوى ${esc(x.name)}: ${x.level} · سمعة ${nfmt(x.reputation)} ','info')"><b class="mono">${x.level}</b><span>المستوى</span></button>
      </div>
      ${!isMe(x.id)?`<div class="row wrap" style="gap:7px;margin-top:11px">
        <button class="chip" onclick="giftUser('${x.id}')">${I("gift","i s")} أهدِ عملة</button>
        <button class="chip" onclick="S.draftText='@${esc(x.username)} ';go('create',{type:'post'},false);setTimeout(()=>{const t=$('#pub_txt');if(t){t.value=S.draftText;cnt(t,500,'pub_cnt')}},150);toast('جُهّزت إشارة @${esc(x.username)} في المحرر ','ok')">${I("at","i s")} إشارة</button>
        <button class="chip" onclick="openSheet('shareProfile','${x.id}')">${I("share","i s")} مشاركة</button>
        <button class="chip" onclick="reportUser('${x.id}')">${I("flag","i s")} إبلاغ</button>
        <button class="chip" onclick="blockUser('${x.id}')">${I("ban","i s")} حظر</button>
      </div>`:""}
      <div class="secttl"><h3>${I("award","i s")} الشارات والإنجازات</h3><button class="more" onclick="go('levels')">الكل</button></div>
      <div class="row wrap" style="gap:8px">${(x.badges||[]).length?(x.badges||[]).slice(0,4).map(bid=>{const b=(S.badgesList||[]).find(y=>y.id===bid);return b?`<button class="card2 center" style="padding:9px 11px" onclick="go('levels')"><span style="color:var(--gold);line-height:0;display:flex">${IC(b.ic,"xl")}</span><span class="tiny b" style="display:block;margin-top:4px">${esc(b.n)}</span></button>`:""}).join(""):`<div class="tiny fnt">لا شارات معروضة على هذا الملف</div>`}</div>
      <div class="secttl"><h3>${I("msgsq","i s")} منشورات ${esc(x.name)}</h3></div>
      ${ps.length?ps.map(p=>postCard(p)).join(""):emptyState("msgsq","لا منشورات عامة","قد يكون الحساب خاصاً")}
      <div class="secttl"><h3>${I("clapper","i s")} ريلز</h3></div>
      <div class="grid2">${S.reels.filter(r=>r.userId===x.id).map(r=>reelCard(r,"100%")).join("")||`<div class="tiny fnt" style="grid-column:1/-1;padding:6px">لا ريلز منشورة من هذا العضو</div>`}</div>
    </div></div>`;
};
function giftUser(id){go("economy",{tab:"marketplace",gift:id})}
PAGES.followers=()=>{
  const typ=S.params.type||"followers";const x=u(S.params.id||"me");setNav(false);
  setHdr(backHdr(typ==="followers"?"المتابِعون":"يتابع",x.name+" · "+nfmt(typ==="followers"?x.followers:x.following)));
  const list=typ==="followers"?(S.users||[]).slice():(S.following||[]).map(id=>u(id)).filter(y=>y&&y.id&&y.id!=="me");
  return `<div class="pad">
    <div class="tabs" style="margin-bottom:12px">
      <button class="${typ==='followers'?'on':''}" onclick="go('followers',{type:'followers',id:'${x.id}'},false)">المتابِعون ${nfmt(x.followers)}</button>
      <button class="${typ==='following'?'on':''}" onclick="go('followers',{type:'following',id:'${x.id}'},false)">يتابع ${nfmt(x.following)}</button>
      <button onclick="openSheet('followRequests')">الطلبات ${(S.followReqs||[]).length?`<span class="badge b-red">${S.followReqs.length}</span>`:""}</button>
    </div>
    <div class="row" style="gap:8px;margin-bottom:11px"><div class="row g1" style="gap:8px;background:var(--surface2);border:1px solid var(--line2);border-radius:13px;padding:9px 12px">
      <span style="color:var(--muted)">${I("search","i s")}</span><input class="g1" style="background:none;border:none;font-size:12.5px" placeholder="ابحث في القائمة..." oninput="filterFollow(this.value)"></div></div>
    <div class="col">${list.map(p=>`<div class="lstrow" data-nm="${esc(p.name)} @${esc(p.username)}"><button onclick="openProfile('${p.id}')">${av(p,44)}</button>
      <div class="g1"><div class="row" style="gap:4px"><span class="b xs">${esc(p.name)}</span>${vbadge(p)}${lvlBadge(p)}</div><div class="tiny fnt">@${esc(p.username)} · ${nfmt(p.followers)} متابع</div></div>
      ${`<button class="btn ${S.following.includes(p.id)?"btn-sec":"btn-primary"} btn-xs" onclick="follow('${p.id}')">${S.following.includes(p.id)?"يتابع":"متابعة"}</button>`}
      <button class="iconbtn" style="width:28px;height:28px" onclick="startChat('${p.id}')">${I("chat","i s")}</button></div>`).join("")}

    </div></div>`;
};

