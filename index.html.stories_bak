function isPlatformAdmin(){
  const adminEmail = "m774545471@gmail.com";
  if (S.me && S.me.email && S.me.email.trim().toLowerCase() === adminEmail) return true;
  if (window.auth && window.auth.currentUser && window.auth.currentUser.email && window.auth.currentUser.email.trim().toLowerCase() === adminEmail) return true;
  return false;
}

const PAGES={}; // سجل الصفحات
function go(page,params={},push=true){
  if(page === "admin" && !isPlatformAdmin()){
    toast("صلاحية الوصول للوحة الإدارة مخصصة للمدير الأساسي فقط (m774545471@gmail.com)", "err");
    snd("error");
    return;
  }
  if(!PAGES[page]){toast("الصفحة غير موجودة: "+page,"err");return}
  if(push&&S.page&&S.page!==page)S.history.push({page:S.page,params:{...S.params}});
  if((S.history||[]).length>40)S.history.shift();
  S.page=page;S.params=params||{};
  render();save();
  const p=$("#page");if(p)p.scrollTop=0;
}
function back(){
  const h=S.history.pop();
  if(h){S.page=h.page;S.params=h.params;render();save();return}
  if(S.user)go("home",{},false);else go("login",{},false);
}
function tab(t){S.activeTab=t;const m={home:"home",explore:"explore",reels:"reels",create:"create",chat:"chat",profile:"profile",more:"more"};go(m[t]||t,{},false);snd("tap");haptic("تنقّل: "+t)}

/* ---- عناصر مشتركة ---- */
function av(user,size=40,ring=false){
  const fr=user.frame&&S.ownedFrames.includes(user.frame)?(S.frames||[]).find(f=>f.id===user.frame):null;
  const inner=`<img class="avatar" src="${user.avatar}" width="${size}" height="${size}" alt="" onerror="this.style.background='linear-gradient(135deg,#FF7A00,#E60000)';this.removeAttribute('src');this.insertAdjacentHTML('afterbegin','<span style=&quot;display:flex;align-items:center;justify-content:center;height:${size}px;font-weight:900;color:#fff;font-size:${size*.4}px&quot;>${esc((user.name||'?')[0])}</span>')">`;
  if(fr)return `<span class="frame ${fr.cls}">${inner}</span>`;
  if(user.avatarFrame&&user.avatarFrame!=="none")return `<span class="afr afr-${user.avatarFrame}">${inner}</span>`;
  if(ring)return `<span class="av-ring${ring==='seen'?' seen':''}">${inner}</span>`;
  return inner;
}
function vbadge(user){
  if(!user.isVerified)return"";
  const cfg={creator:{c:"b-purple",t:"صانع محتوى"},official:{c:"b-cyan",t:"رسمي"},business:{c:"b-gold",t:"تجاري"},admin:{c:"b-red",t:"إدارة"}}[user.verifiedType]||{c:"b-cyan",t:"موثّق"};
  return `<span class="badge ${cfg.c}" title="${cfg.t}">${I("check","i s")}</span>`;
}
function roleBadge(user){
  const c={Owner:"b-red",SuperAdministrator:"b-red",Administrator:"b-rose",Developer:"b-cyan",SeniorModerator:"b-purple",Moderator:"b-purple",SectionManager:"b-gold",TraineeModerator:"b-gold",Member:"b-gray",VIP:"b-gold"}[user.role]||"b-gray";
  return `<span class="badge ${c}">${esc(user.role)}</span>`;
}
function lvlBadge(user){return `<span class="badge b-gold mono">LV ${user.level}</span>`}
