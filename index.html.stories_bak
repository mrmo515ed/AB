function starChip(){return `<button class="coinchip" style="background:rgba(168,85,247,.1);border-color:rgba(168,85,247,.3);color:#C084FC" onclick="go('economy',{tab:'marketplace'});snd('coin')">${IF("star","i s")}<span class="mono">${S.stars}</span></button>`}
function emptyState(icon,txt,sub){return `<div class="empty" style="position:relative;background:var(--surface2);border-radius:var(--r);padding:40px 20px;border:1px solid var(--line2);box-shadow:0 4px 15px rgba(0,0,0,0.05)"><svg viewBox="0 0 120 120" style="position:absolute;width:160px;height:160px;opacity:.14;color:var(--accent)" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="60" cy="60" r="46" stroke-dasharray="5 7"/><circle cx="60" cy="60" r="32" stroke-dasharray="3 6"/><path d="M60 6v10M60 104v10M6 60h10M104 60h10"/><circle cx="94" cy="26" r="2.4"/><circle cx="24" cy="92" r="2.4"/><path d="M88 88l6 6M32 26l-6-6"/></svg>${I(icon,"xl")}<div class="b sm">${esc(txt)}</div><div class="tiny fnt">${esc(sub||"")}</div></div>`}
