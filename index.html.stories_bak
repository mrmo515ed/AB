<div id="splash">
  <img class="logo logoimg" src="data:image/jpeg;base64," alt="أنمي بلاك">
  <h1>ANIME BLACK</h1>
  <div class="tiny mut" style="letter-spacing:3px">أنمي بلاك · منصة الأوتاكو الفاخرة</div>
  <div class="ld"><i></i></div>
  <div class="tiny fnt mono" id="splashtxt">جاري تحميل الأنظمة...</div>
    <div class="tiny mono" style="opacity:.55;margin-top:6px">الإصدار ٢٥٫٠ · إتقان النشر والمجتمعات · استوديوهات نشر لكل نوع، غرف كاملة الميزات، فعاليات بأغلفة ومشاركات مموجة</div>
</div>

<div id="app">
  <header class="hdr" id="hdr"></header>
  <main class="page no-sb" id="page"></main>
  <button id="homeFab" class="home-fab" onclick="openSheet('createBottom')" aria-label="إنشاء منشور" title="إنشاء منشور جديد">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
  </button>
  <nav class="nav" id="nav"></nav>
</div>

<div id="ovl"></div>
<div id="mview" class="hidden"></div>
<div id="toasts"></div>
<div id="ptr"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg> اسحب للتحديث</div>
<div id="haptic"><span class="dot"></span><span id="haptxt">لمسة</span></div>
<div id="confetti"></div>

<script>
/* ============================================================
   0) أدوات أساسية
   ============================================================ */
const $=(s,r=document)=>typeof s==="string"?r.querySelector(s):s, $$=(s,r=document)=>typeof s==="string"?[...r.querySelectorAll(s)]:[...((s&&s.children)||[])];
const ICONS=["home","compass","plus","plussq","chat","user","users","more","heart","share","send","search","bell","trash","edit","check","x","menu","back","fwd","alert","filter","globe","refresh","file","bookmark","thumbup","chevdown","chevup","tv","eye","eyeoff","lock","unlock","usercheck","help","trend","db","phone","checksq","max","download","upload","zoomin","zoomout","play","pause","stop","flame","mail","sun","moon","sparkles","film","clapper","book","quote","coins","star","crown","shield","settings","calendar","code","clock","archive","msgsq","fingerprint","barchart","mic","video","image","music","gift","trophy","zap","map","link","copy","logout","qr","camera","layers","radio","wallet","tag","flag","ban","terminal","bot","key","palette","info","save","pin","hash","at","headphones","award","target","chart","cloud","wifi","volume","mute","phoneoff","screen","wand","rocket","grid","list","inbox","folder","pen","reply","fwd2","swords","fire2","bookmark2","sakura","snow","gem","gamepad","wave","party","face-love","face-laugh","face-rofl","face-wow","face-shock","face-sad","face-angry","face-cry","face-think","face-plead","face-mind","heartcrack"];
const POSTERS={"a1":"data:image/webp;base64,","a2":"data:image/webp;base64,","a3":"data:image/webp;base64,","a4":"data:image/webp;base64,","a5":"data:image/webp;base64,","a6":"data:image/webp;base64,","a7":"data:image/webp;base64,","a8":"data:image/webp;base64,","a9":"data:image/webp;base64,","a10":"data:image/webp;base64,","m1":"data:image/webp;base64,","m3":"data:image/webp;base64,","m4":"data:image/webp;base64,","art1":"data:image/webp;base64,","art2":"data:image/webp;base64,","art3":"data:image/webp;base64,","m2":"data:image/webp;base64,"};
function tileImg(x,w,hh,r){const p=POSTERS[x.id];return p?`<span style="width:${w}px;height:${hh}px;border-radius:${r}px;overflow:hidden;flex-shrink:0;display:block"><img src="${p}" alt="" style="width:100%;height:100%;object-fit:cover;display:block"></span>`:`<span class="ico-tile" style="width:${w}px;height:${hh}px;border-radius:${r}px;background:linear-gradient(135deg,${x.c1},${x.c2});">${IC(x.emo,"i l")}</span>`}
function bgImg(x){const p=POSTERS[x.id];return p?`background-image:linear-gradient(180deg,rgba(0,0,0,.25),rgba(0,0,0,.62)),url('${p}');background-size:cover;background-position:center;`:""}
const ARTS=[POSTERS.art1,POSTERS.art2,POSTERS.art3];
function artBg(seed){const s=String(seed);let hh=0;for(let i=0;i<s.length;i++)hh+=s.charCodeAt(i);return ARTS[hh%ARTS.length]}
function I(n,cls="i"){return `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><use href="#I-${n}"/></svg>`}
function IF(n,cls="i"){return `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor"><use href="#I-${n}"/></svg>`}
const IC_STROKE=new Set(["face-love","face-laugh","face-rofl","face-wow","face-shock","face-sad","face-angry","face-cry","face-think","face-plead","face-mind","wave","music","snow","swords","gamepad","rocket","shield","thumbup","mic","sakura"]);
function IC(n,cls="i"){return IC_STROKE.has(n)?I(n,cls):IF(n,cls)}
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
const rnd=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const pick=a=>a[Math.floor(Math.random()*a.length)];
const nfmt=n=>n>=1e6?(n/1e6).toFixed(1)+"M":n>=1e3?(n/1e3).toFixed(1)+"K":""+n;
function ago(ms){const s=(Date.now()-ms)/1000;if(s<60)return"الآن";const m=s/60;if(m<60)return Math.floor(m)+" د";const h=m/60;if(h<24)return Math.floor(h)+" س";const d=h/24;if(d<30)return Math.floor(d)+" ي";return new Date(ms).toLocaleDateString("ar")}
const now=()=>Date.now();
const hhmm=ms=>new Date(ms).toLocaleTimeString("ar",{hour:"2-digit",minute:"2-digit"});

/* ---- أصوات اصطناعية (WebAudio) ---- */
let AC=null;
function snd(kind="tap"){
  if(!S.sound)return;
  try{
    AC=AC||new (window.AudioContext||window.webkitAudioContext)();
    if(AC.state==="suspended")AC.resume();
    const o=AC.createOscillator(),g=AC.createGain(),t=AC.currentTime;
    const P={tap:[520,.06,"sine"],success:[880,.16,"triangle"],error:[180,.22,"sawtooth"],notif:[660,.2,"sine"],coin:[1180,.14,"square"],send:[740,.09,"sine"]}[kind]||[520,.06,"sine"];
    o.type=P[2];o.frequency.setValueAtTime(P[0],t);
    if(kind==="success"||kind==="coin")o.frequency.exponentialRampToValueAtTime(P[0]*1.7,t+P[1]);
    if(kind==="error")o.frequency.exponentialRampToValueAtTime(P[0]*.5,t+P[1]);
    g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.09,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+P[1]);
    o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+P[1]+.02);
  }catch(e){}
}
function haptic(txt){
  if(S.haptic&&navigator.vibrate)try{navigator.vibrate(12)}catch(e){}
  if(!S.hapticToast)return;
  const h=$("#haptic");$("#haptxt").textContent=txt||"استجابة لمسية";
  h.classList.add("show");clearTimeout(h._t);h._t=setTimeout(()=>h.classList.remove("show"),1100);
}
function toast(msg,type="",undoFn){
  const t=document.createElement("div");t.className="toast "+type;t.innerHTML=`${I(type==="err"?"alert":type==="ok"?"check":"info","i s")}<span>${esc(msg)}</span>${undoFn?'<button class="btn btn-ghost btn-xs" style="margin-inline-start:9px;padding:3px 10px;color:#fff;border-color:rgba(255,255,255,.35)">تراجع</button>':""}`;
  if(undoFn){const b=t.querySelector("button");if(b)b.onclick=()=>{try{undoFn()}catch(e){}t.remove()}}
  const _tb=$("#toasts");_tb.appendChild(t);while(_tb.children.length>3)_tb.removeChild(_tb.firstChild);snd(type==="err"?"error":type==="ok"?"success":"notif");
  try{if(typeof Notification!=="undefined"&&Notification.permission==="granted"&&(type==="err"||type==="ok")){const _nw=Date.now();if(!window.__lastNotif||_nw-window.__lastNotif>4000){window.__lastNotif=_nw;new Notification("أنمي بلاك",{body:msg})}}}catch(e){}
  setTimeout(()=>{t.style.transition=".3s";t.style.opacity="0";t.style.transform="translateY(14px)";setTimeout(()=>t.remove(),300)},undoFn?4200:2300);
}
function celebrate(msg){
  const c=$("#confetti"),cols=["#22D3EE","#FF7A00","#F59E0B","#A855F7","#06B6D4","#10B981","#F43F5E"];
  for(let i=0;i<70;i++){const p=document.createElement("i");p.className="cf";
    p.style.cssText=`left:${rnd(0,100)}%;top:-14px;background:${pick(cols)};animation-duration:${(rnd(14,30)/10)}s;animation-delay:${rnd(0,400)}ms;transform:rotate(${rnd(0,360)}deg)`;
    c.appendChild(p);setTimeout(()=>p.remove(),3600)}
  snd("success");if(msg)toast(msg,"ok");haptic("احتفال ");
}

