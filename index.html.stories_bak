function art(c1,c2,emoji,img){
  const bg=img?`background-image:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.55)),url('${img}');background-size:cover;background-position:center;`:"";
  return `<div class="art-bg" style="--c1:${c1};--c2:${c2};position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;${bg}">${img?"":(ICONS.includes(emoji)?IF(emoji,"xxl"):esc(emoji||""))}</div>`;
}
