<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnimeBlack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ab_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.AnimeBlack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ab_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AnimeBlack</item>
    </style>
</resources>
