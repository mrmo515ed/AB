# Anime Black server — environment variables
# Copy to `.env` (or set them in your hosting dashboard) and fill in the values.
# NEVER commit a real .env file.

# ---------------------------------------------------------------------------- required
# Google AI Studio key used by the AI search agent (/api/gemini/search-agent).
# Without it the app still works; the agent answers with a clear "unavailable" message.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------- optional
# Port the server listens on (hosting platforms set this for you).
PORT=3000

# Set to 1 when the server runs behind a proxy/load balancer (Render, Railway, Fly, Nginx),
# so rate limiting sees the real client IP.
ANIMEBLACK_TRUST_PROXY=1

# Require this token on the search agent (sent by the app as the `x-ab-token` header).
# Leave empty to keep the endpoint open (as before). Recommended on a public server.
ANIMEBLACK_AGENT_TOKEN=

# Require this token for /api/admin/metrics (?token=... or the x-ab-token header).
ANIMEBLACK_ADMIN_TOKEN=

# Requests per minute per IP for the search agent (default 20).
ANIMEBLACK_AGENT_RPM=20
